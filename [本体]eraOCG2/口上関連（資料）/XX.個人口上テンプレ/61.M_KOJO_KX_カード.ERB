;※※※※※※※※※※※※※※※※※※※※※※※※※
;CARD用口上
;※※※※※※※※※※※※※※※※※※※※※※※※※
;直接カードのIDを使える。
;キャラが無くても動く
;存在証明
@M_KOJO_CARD_KX
RETURN 1
;==================================================
;0,モンスター召喚時
;==================================================
@M_KOJO_CARD_KX_0(ARG,ARG:1)
#DIM DYNAMIC 好感度修正
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 
ENDIF

;==================================================
;1,攻撃時
;==================================================
@M_KOJO_CARD_KX_1(ARG,ARG:1)
#DIM DYNAMIC 好感度修正
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 
ENDIF

;==================================================
;2,効果発動
;==================================================
;効果別で鳴らしたいなら、直接カードのデータを見て、設定する必要がある
;面倒、分からないであれば分岐はせず
;失敗判定は、いわゆる効果を無効にされたとかそういうやつ
@M_KOJO_CARD_KX_2(種類,失敗判定)
#DIM DYNAMIC 好感度修正
#DIM DYNAMIC 種類
#DIM DYNAMIC 失敗判定
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 失敗判定 == 0
		PRINTFORMW 
	ELSE
		PRINTFORMW 
	ENDIF
ENDIF

;==================================================
;3,除去時
;==================================================
;いちいちなんでも除去で話すとやかましいため、デフォでは破壊にのみ反応するように設定
@M_KOJO_CARD_KX_3(除去種類,ARG:1)
#DIM DYNAMIC 好感度修正
#DIM DYNAMIC 除去種類
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種

;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 除去種類
	CASE 破壊行き
		PRINTFORMW 
	ENDSELECT
ENDIF

