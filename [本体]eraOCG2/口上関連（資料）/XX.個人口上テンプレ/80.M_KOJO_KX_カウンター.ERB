;色っぽい仕草
;==================================================
@M_KOJO_MESSAGE_COUNTER_KX_10
#DIM DYNAMIC CTおさわり確認
#DIM DYNAMIC 好感度修正
CALL EVENT_COUNTER_MESSAGE(CTおさわり確認)
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;ここを記入した場合、これより下は流れない
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1
		PRINTFORML 
		RETURN 1
	ENDIF

	;基本セット
	好感度修正 = 1
	SIF TALENT:TARGET:愛妻
		好感度修正 += 0
	SIF TALENT:TARGET:恋慕 == 2
		好感度修正 += 1
	SIF TALENT:TARGET:恋慕 >= 1
		好感度修正 += 1
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORML 
		CASE 2
			PRINTFORML 
		CASE 3
			PRINTFORML 
	ENDSELECT
ENDIF
RETURN 1


