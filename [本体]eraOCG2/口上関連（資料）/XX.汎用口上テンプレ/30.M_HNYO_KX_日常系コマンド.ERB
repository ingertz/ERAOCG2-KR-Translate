;==================================================
;480,デュエル
;勝敗はプレイヤーから見てのもの
;TFLAG:SELECTCOM分岐(1=通常勝利 2=通常敗北 3=引き分け
;10=通常決闘前 11=パック賭け決闘前 12=デート賭け決闘前 13=パンツ賭け決闘前 14=お持ち帰り決闘前 15=お前モンスターじゃないか？ 16=スケベ要求決闘前 20=闇のゲーム
;31=パック賭け勝利 32=デート賭け勝利 33=パンツ賭け勝利 34=お持ち帰り成功 35=カード化勝利（牝以外） 36=スケベ要求事後 40=罰ゲーム！
;135=カード化見逃す 235=穏便カード化 335=凌辱後カード化 435=凌辱後見逃す
;50=賭け決闘敗北怒られた 51=パック賭け敗北 52=デート敗北デート 55=カード化敗北 56=スケベ要求敗北 156=スケベ要求弱味削除 256=スケベ要求敗北負け癖付きおねだり)
;==================================================
@M_HNYO_MESSAGE_COM_KX_480
;デュエルにTRAIN_MESSAGEはない
CALL M_HNYO_MESSAGE_COM_KX_480_1
RETURN RESULT

@M_HNYO_MESSAGE_COM_KX_480_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;これが０の時はデュエルしない時なのでおわり
	SIF TFLAG:SELECTCOM分岐 == 0
		RETURN 1

	;デュエル前
	IF INRANGE(TFLAG:SELECTCOM分岐,10,21)
		SELECTCASE TFLAG:SELECTCOM分岐
			;通常決闘
			CASE 10
				PRINTFORMW 
			
			;ここから賭け決闘
			;パック賭け
			CASE 11
				PRINTFORMW 
			;デート賭け
			CASE 12
				PRINTFORMW 
			;パンツ賭け
			CASE 13
				PRINTFORMW 
			;お持ち帰り
			CASE 14
				PRINTFORMW 
			;モンスターか問い詰める（人間は不可）
			CASE 15
				PRINTFORMW 
			;スケベ強要
			CASE 16
				PRINTFORMW 
			;闇のゲーム
			CASE 20
				PRINTFORMW 
		ENDSELECT

	;デュエル後
	ELSE
		SELECTCASE TFLAG:SELECTCOM分岐
			;通常勝利
			CASE 1
				PRINTFORMW 
			;通常敗北
			CASE 2
				PRINTFORMW 
			;通常引き分け
			CASE 3
				PRINTFORMW 

			;ここから賭け勝利
			;パック賭け
			CASE 31
				PRINTFORMW 
			;デート賭け
			CASE 32
				PRINTFORMW 
			;パンツ賭け
			CASE 33
				PRINTFORMW 
			;お持ち帰り
			CASE 34
				PRINTFORMW 
			;下二桁３５は"モンスターか問い詰める"の分岐
			;カード化（牝以外、選択肢無し）
			CASE 35
				PRINTFORMW 
			;カード化を見逃す（元気でな！）
			CASE 135
				PRINTFORMW 
			;穏便に話してカード化（怖くないよ～痛くないよ～）
			CASE 235
				PRINTFORMW 
			;身体を対価に見逃す（見逃すとは言ってない）
			CASE 335
				PRINTFORMW 
			;身体を対価に見逃す（見逃す）（負け癖付いたり弱み握られたりする）
			CASE 435
				PRINTFORMW 
			;身体要求事後
			CASE 36
				PRINTFORMW 
			;闇のゲーム
			CASE 40
				PRINTFORMW 

			;ここから賭け敗北
			;怒られた
			CASE 50
				PRINTFORMW 
			;パック賭け（パックを手渡す）
			CASE 51
				PRINTFORMW 
			;デート賭け（デートはしてくれる）
			CASE 52
				PRINTFORMW 
			;カード化敗北（逃げられた）
			CASE 55
				PRINTFORMW 
			;身体要求敗北（金払う）
			CASE 56
				PRINTFORMW 
			;身体要求敗北（弱味削除）
			CASE 156
				PRINTFORMW 
			;身体要求敗北（負け癖付いてる時限定凌辱おねだり）（ラブホ直行）
			CASE 256
				PRINTFORMW 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

