;300,会話
;TFLAG:SELECTCOM分岐(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより教養が4以上高い)
;TCVAR:302(0=会話可能 1=非恋慕時会話不能)
;MARK:反発刻印(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;CFLAG:うふふ(調教中の会話)
;CFLAG:便器化(肉便器の時の会話)
;==================================================
@M_HNYO_SUCCESS_COM_KX_300
;成否判定
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_HNYO_MESSAGE_COM_KX_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で口上色が付きません。
CALL TRAIN_MESSAGE
;口上メイン呼出
CALL M_HNYO_MESSAGE_COM_KX_300_1
RETURN RESULT

@M_HNYO_MESSAGE_COM_KX_300_1
#DIM DYNAMIC 好感度修正
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;好感度修正、通常（恋慕系陥落なし）で５
	好感度修正 = 5
	;TARGETが【愛妻】だったら好感度修正に＋２
	SIF TALENT:TARGET:愛妻
		好感度修正 += 2
	;TARGETが【親愛】だったら好感度修正に＋２
	SIF TALENT:TARGET:恋慕 == 2
		好感度修正 += 2
	;TARGETが【恋慕】を得ていたら好感度修正に＋１
	SIF TALENT:TARGET:恋慕 >= 1
		好感度修正 += 1
	;「RAND:n」n面ダイスを振る
	;うふふ中の会話
	IF CFLAG:TARGET:うふふ
		SELECTCASE RAND:3 + 1
			CASE 1
				PRINTFORMW 
			CASE 2
				PRINTFORMW 
			CASE 3
				PRINTFORMW 
		ENDSELECT
	;日常会話
	ELSE
		SELECTCASE RAND:好感度修正 + 1
			CASE 1
				PRINTFORMW 
			CASE 2
				PRINTFORMW 
			CASE 3
				PRINTFORMW 
			CASE 4
				PRINTFORMW 
			CASE 5
				PRINTFORMW 
			;恋慕
			CASE 6
				PRINTFORMW 
			;親愛
			CASE 7
				PRINTFORMW 
			CASE 8
				PRINTFORMW 
			;愛妻
			CASE 9
				PRINTFORMW 
			CASE 10
				PRINTFORMW 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
