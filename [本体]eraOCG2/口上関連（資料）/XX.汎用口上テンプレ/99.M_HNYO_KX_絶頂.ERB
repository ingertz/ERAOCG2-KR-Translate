;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;分岐作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:絶頂
;4以上で昇天、3で超強絶頂、2で強絶頂、1で絶頂

;NOWEX:Ｃ絶頂 NOWEX:Ｖ絶頂 NOWEX:Ｂ絶頂 NOWEX:Ａ絶頂 NOWEX:Ｍ絶頂
;各部位の絶頂

;NOWEX:二重絶頂、NOWEX:三重絶頂、NOWEX:四重絶頂、NOWEX:五重絶頂
;同時に絶頂した時の状態
;上記五つに加えてNOWEX:Ｅ絶頂でも判定

;TOTALEX
;地の文の判定に使われているもの
;5以上で潮を吹き、4以下で背中を反らせて絶頂する
;詳しくはEVENT_MESSAAGE_ORGASMを参照

;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが挿入中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが挿入中となる。
;NOWEX:射精
;射精量、最大3。たとえばIF NOWEX:MASTER:射精 > 1だと、あなたが大量射精以上した場合となる。

;-------------------------------------------------
;絶頂時の口上
;-------------------------------------------------
@M_HNYO_MESSAGE_PALAMCNG_B_KX(ARG)
#DIM TOTALEX
#DIM DYNAMIC 好感度修正
CALL PALAM_MESSAGE_B(ARG)
TOTALEX =  NOWEX:ARG:Ｃ絶頂 + NOWEX:ARG:Ｖ絶頂 + NOWEX:ARG:Ａ絶頂 + NOWEX:ARG:Ｂ絶頂+ NOWEX:ARG:Ｍ絶頂 + NOWEX:ARG:Ｅ絶頂 + NOWEX:ARG:噴乳 + NOWEX:ARG:射精
SIF !(TOTALEX + NOWEX:ARG:放尿)
	RETURN 0
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;噴乳
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:噴乳
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;射精した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:射精
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;放尿
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:放尿
		PRINTFORMW 
		RETURN 1
	ENDIF

	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;ここを記入した場合、これより下は流れない
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1
		RETURN 1
	ENDIF
	;口上の色の変更　この状態だとピンク色　必要ない場合はこことRESETCOLORを消す
	SETCOLOR C_H_PINK
	;基本セット
	SELECTCASE NOWEX:ARG:絶頂
		;絶頂
		CASE 1
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖセックス == MASTER
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ENDIF
		;強絶頂
		CASE 2
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖセックス == MASTER
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ENDIF
		;超強絶頂
		CASE 3
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖセックス == MASTER
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ENDIF
		;昇天
		CASE 4 TO 5
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖセックス == MASTER
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ENDIF
	ENDSELECT
	RESETCOLOR
ENDIF
RETURN 1


