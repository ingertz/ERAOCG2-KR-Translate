;101,턴 종료
;==================================================
@M_KOJO_DUEL_K2030_101(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;LP 4000~6000 사이
	IF INRANGE(ライフ_상대,4000,6000)
		PRINTFORMW 「……아직, 괜찮아. 턴 엔드.」
	;LP 2000 이하
	ELSEIF ライフ_상대 <= 2000
		PRINTFORMW 「으으, 이 정도로 포기할쏘냐……! 턴, 엔드……!」
	;그 외
	ELSE
		PRINTFORMW 「내 차례는 이걸로 끝, 다음은 당신 차례야.」
	ENDIF
ENDIF



