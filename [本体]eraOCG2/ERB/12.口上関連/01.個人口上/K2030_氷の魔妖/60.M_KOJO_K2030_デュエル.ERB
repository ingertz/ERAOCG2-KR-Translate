;50,몬스터 공격
;==================================================
@M_KOJO_DUEL_K2030_50(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF GROUPMATCH(カードID,51020,51021,51022)
		PRINTFORMW 「자, 저승의 힘에 두려워 떨어라……!」
	ELSEIF GROUPMATCH(カードID,2030,12030,42030)
		PRINTFORMW 「얼어붙어라, '나'의 일격에.」
	ELSEIF GROUPMATCH(カードID,2032,12032)
		PRINTFORMW 「……%カード名%(으)로 공격, 부탁할게.」
	ENDIF
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「%カード名%(으)로 공격.」
		CASE 2
			PRINTFORMW 「자, 가라, %カード名%.」
		CASE 3
			PRINTFORMW 「승부야. %カード名%, 공격.」
	ENDSELECT
ENDIF



;==================================================
;51,몬스터 공격 결과
;==================================================
@M_KOJO_DUEL_K2030_51(상황판정,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 상황판정
#DIMS DYNAMIC カード名
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;마무리 일격
	SIF ARG:1 == 1
		PRINTFORMW 「당연하지. ……후훗, 해냈다.」

	SELECTCASE 상황판정
		;상대 몬스터 격파
		CASE 1
			PRINTFORMW 「자, 이쪽의 승리.」
		;자신에게 데미지
		CASE 2
			PRINTFORMW 「윽……!? 아 정말, 저항하지 말라니까.」
		;동귀어진
		CASE 3
			PRINTFORMW 「큭, 괜찮아……. 동귀어진이라면 진 건 아니야……!」
		;효과로 전투 전에 제거됨
		CASE 4
			PRINTFORMW 「뭐!? ……후우, 괜찮아, 일이 잘 안 풀리는 것엔 익숙하니까……!」
		;직접 공격
		CASE 5
			PRINTFORMW 「직접 공격, 아플 거야.」
	ENDSELECT
ENDIF



