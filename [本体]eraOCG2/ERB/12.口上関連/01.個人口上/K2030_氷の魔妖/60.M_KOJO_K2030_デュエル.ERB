;==================================================
;0, 듀얼 스타트!
;==================================================
@M_KOJO_DUEL_K2030_0(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「저승에서 마요가 행차하시겠다. 저항하지 말라고.」
		CASE 2
			PRINTFORMW 「뼛속까지 얼려주지……」
		CASE 3
			PRINTFORMW 「지금부터는 나의 시간…… 울부짖는 것만큼은 허락해 줄게.」
	ENDSELECT
ENDIF

;==================================================
;1,몬스터 소환
;例：%カード名%を소환！
;==================================================
@M_KOJO_DUEL_K2030_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF GROUPMATCH(カードID,22031,22032,22033)
		PRINTFORMW 「마요, 납신다. %カード名%를 소환.」
	ELSEIF カードID == 22030
		PRINTFORMW 「언제나 믿음직스럽다니까…….%カード名%、등장.」
	ELSE
		PRINTFORMW 「패에서 %カード名%을 소환하겠어.」
	ENDIF
ENDIF


;==================================================
;2,몬스터 특수소환
;==================================================
@M_KOJO_DUEL_K2030_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 소환出処
		;패에서 
		CASE 召種손패
			IF カードID == 2031
				PRINTFORMW 「백귀야행을 시작해 볼까. 패에서 『나』를 특수소환」
			ELSEIF カードID == 22032
				PRINTFORMW 「네가 그렇게 우수했던가……. %カード名%、가도록 해.」
			ELSE 
				PRINTFORMW 「패에서 %カード名%을 특수소환, 자, 일하도록 해.」
			ENDIF
		;마법함정 존에서. 키리반/셰이프시스터 등을 낼 경우
		CASE 召種마함
			PRINTFORMW 「홀연히 나타나라. 마법함정 존에서, %カード名%을 불러내겠어.」
		;덱에서 
		CASE 召種덱
			PRINTFORMW 「자, 나설 차례라고. 덱에서 %カード名%、특수소환」
		;EX덱에서 
		CASE 召種EX덱
			PRINTFORMW 「EX 덱에서 %カード名%을 특수소환。통과시켜 줄래?」
		;묘지에서
		CASE 召種묘지
			IF GROUPMATCH(カードID,51020,51021,51022,51023)
			PRINTFORMW 「자, 저승에서부터 복수할 시간이다……! %カード名%, 묘지에서 깨어나라!」
			ELSEIF カードID == 2032
			PRINTFORMW 「……우리 마요의 '공주님' 행차시다.」
			ELSEIF カードID == 2031
			PRINTFORMW 「백귀야행을 시작해 볼까. 묘지에서 '나'를 특수 소환.」
			ELSEIF カードID == 12032
			PRINTFORMW 「……마요의 수괴가 지닌 힘, 지금이야말로 보여주시죠. %カード名%, 지금 다시 태어나라.」
			ELSE
			PRINTFORMW 「묘지에 있는 정도로 쉴 수 있을 거라 생각했어? %カード名%, 일어나.」
			ENDIF
		;제외 상태에서
		CASE 召種제외
			IF GROUPMATCH(カードID,51020,51021,51022,51023)
			PRINTFORMW 「같잖은 등불 따위는 꺼져줘야겠어……! %カード名%, 봉인에서 깨어나라!」
			ELSEIF カードID == 12032
			PRINTFORMW 「……마요의 수괴가 지닌 힘, 지금이야말로 보여주시죠. %カード名%, 지금 다시 태어나라, ……부탁드립니다.」
			ELSE
			PRINTFORMW 「후후, 게임에서 제외하면 손도 못 쓸 줄 알았나? %カード名%, 나타나라.」
			ENDIF
		;주로 토큰 생성
		CASE 10
			PRINTFORMW 「오너라, %カード名%」
	ENDSELECT
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K2030_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORMW 「자, 이건 무슨 의식일까? %カード名%, 가르쳐 주렴.」
		CASE 융합
			PRINTFORMW 「녹고 섞여서 다시 태어나라. %カード名%, 융합 소환.」
		CASE 싱크로
			IF GROUPMATCH(カードID,51020,51021,51022,51023)
			PRINTFORMW 「마요변생, %カード名%, 날뛸 시간이다!」
			ELSEIF カードID == 12032
			PRINTFORMW 「……마요변생, 나라를 기울게 한 공주, %カード名%, ……부디, 와주시옵소서.」
			ELSE
			PRINTFORMW 「싱크로 소환. %カード名%, 그 힘, 마음껏 펼쳐봐라.」
			ENDIF
		CASE 엑시즈
			PRINTFORMW 「……어디 보자, 오버레이 네트워크를 구축, 엑시즈 소환. %カード名%. ……좋아, 말했다.」
		CASE 링크
		IF GROUPMATCH(カードID,2030,12030)
			PRINTFORML 「열려라, 삭풍이 휘몰아치는 세계의 서킷……!
			PRINTFORMW 　링크 소환! 이것이 바로 나, %カード名%의 힘이다!」
			ELSEIF カードID == 42030
			PRINTFORMW 「……아하하하핫! 드디어 내가 '나' 자신이 된다! 링크 소환! 그래, 나야말로 마요의 비장의 패! %カード名%!!」
			ELSE
			PRINTFORMW 「몬스터를 링크 마커에 세트, 링크 소환. 가라, %カード名%.」
			ENDIF
		;초차원 몬스터 (듀얼마스터즈)
		CASE 초차원
			PRINTFORMW 「설령 이 세상의 것이 아닌 힘이라 할지라도, 손아귀에 들어온다면 써 보이겠어. ……%カード名%. 그 힘, 어디 한번 보여봐라.」
	ENDSELECT
ENDIF

;==================================================
;4,효과 사용 선언
;==================================================
@M_KOJO_DUEL_K2030_4(カードID,발동出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC 발동出処
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 발동出処
		CASE 1
			;손패발동
			IF GROUPMATCH(カードID,79840,79841,79842,79843,79844,79845,79846,79847,79848,79853,79854,79855,79857)
			;아마도, 본인의 인식은 '봉화요려담-마요괴시라누이이야기' 같은 걸 쥐고 있다고 생각하는 듯. MC로 보면 꼴사납네❤
				SELECTCASE RAND:5
					CASE 0
						PRINTFORM 「
						SETCOLOR C_PINK
						PRINTFORM ──√￣……알겠, 습니다❤
						SETCOLOR 0xffeeff
						PRINTFORM 　……？
						RESETCOLOR
						PRINTFORML 　……마요의 금지된 주술, 사용하도록 할게.
						PRINTFORM 　%カード名% 발동. ……후
						SETCOLOR 0xffeeff
						PRINTFORM 훗, %CSTR:TARGET:MASCALL%
						SETCOLOR C_PINK
						PRINTFORMW 도 끝이네……❤」
						RESETCOLOR
					CASE 1
						PRINTFORM 「
						SETCOLOR C_PINK
						PRINTFORM ──√￣……명령, 수령했습니다❤
						SETCOLOR 0xffeeff
						PRINTFORM　……？
						RESETCOLOR
						PRINTFORML 　……%カード名%을 발동하겠어……
						SETCOLOR 0xffeeff						
						PRINTFORM !
						PRINTFORM 　후훗……! 공포에
						SETCOLOR C_PINK
						PRINTFORMW 떨도록 해……!❤」
						RESETCOLOR
					CASE 2
						PRINTFORM 「
						SETCOLOR C_PINK
						PRINTFORM ──√￣……따르, 겠어요❤
						SETCOLOR 0xffeeff
						PRINTFORM　……？
						RESETCOLOR
						PRINTFORML 　……후후훗, 아무리 %CSTR:TARGET:MASCALL%라도 예상하지 못했겠지……?
						PRINTFORM 　……내가 %カード名%을 쥐고
						SETCOLOR 0xffeeff						
						PRINTFORM 있었다는 것을! 자, 각
						SETCOLOR C_PINK
						PRINTFORMW 오는 되어 있으려나……❤」
						RESETCOLOR
					CASE 3
						PRINTFORM 「
						SETCOLOR C_PINK
						PRINTFORM ──√￣……알겠습니다❤
						SETCOLOR 0xffeeff
						PRINTFORM　……？
						RESETCOLOR
						PRINTFORM 　……시라누이에게서 빼앗은 힘, 지금이야
						SETCOLOR 0xffeeff						
						PRINTFORML 말로 사용해주겠어……!
						PRINTFORM 　……%カード名%, 지금
						SETCOLOR C_PINK
						PRINTFORMW ! ……간다앗❤」
						RESETCOLOR
					CASE 4
						PRINTFORM 「
						SETCOLOR C_PINK
						PRINTFORM ──√￣……핫, 하앙❤
						SETCOLOR 0xffeeff
						PRINTFORM　……？
						RESETCOLOR
						PRINTFORML 　……이것이야말로 궁극의 힘!
						PRINTFORM 　발
						SETCOLOR 0xffeeff						
						PRINTFORM 동, %カード名%! 후후
						SETCOLOR C_PINK
						PRINTFORMW 훗…… 이걸로, 결판이야❤」
						RESETCOLOR
				ENDSELECT
			ELSE
			PRINTFORMW 「패에서, %カード名%을 사용하겠어.」
			ENDIF
		CASE 2
			;필드 발동
			PRINTFORMW 「자, 여기선 이 녀석이 나설 차례네. %カード名%, 발동.」
		CASE 3
			;마법/함정 발동
			PRINTFORMW 「마법/함정 존의 %カード名%, 간다.」
		CASE 4
			;묘지 발동
			PRINTFORMW 「묘지 활용은 언데드의 십팔번이지. %カード名%을 사용하도록 할게.」
	ENDSELECT
ENDIF



