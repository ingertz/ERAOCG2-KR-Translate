@M_KOJO_DUEL_K2030_100(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE RAND:2 + 1
		CASE 1
			PRINTFORMW 「메인 페이즈에 들어가도록 할게.」
		CASE 2
			PRINTFORMW 「아무것도 없다면 메인 페이즈, 괜찮지?」
	ENDSELECT
ENDIF


