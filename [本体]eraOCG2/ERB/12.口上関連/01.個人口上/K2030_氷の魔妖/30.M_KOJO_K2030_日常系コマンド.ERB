LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;끌어안기 초회
	IF FIRSTTIME(TOSTR(350),1)
		IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨 || TALENT:TARGET:애처
			PRINTFORMW 「……후훗. 남자답게, 덮쳐줘…… 알았지?」
		ELSE
			PRINTFORMW 「……자. 마음대로 하면 되잖아?」
		ENDIF
	;그 외
	ELSE
		;통상 덮치기
		IF CFLAG:MASTER:우후후 == 1
			IF CFLAG:TARGET:아르바이트 == 3 && CFLAG:MASTER:현재위치 == 場所_神社 || CFLAG:TARGET:아르바이트 == 8 && CFLAG:MASTER:현재위치 == 場所_教会
				IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨 || TALENT:TARGET:애처
					PRINTFORMW 「……어머, 달아올라 버렸잖아❤」
					PRINTFORMW 「후훗, 신이란 놈에게 과시해주자고, 우리의 사이를, 응……❤」
				ELSE
					PRINTFORMW 「……헤에, 재밌는 생각을 하는구나……!」
					PRINTFORMW 「평소라면 야외 같은 건 망측해서 싫지만, 신을 폄하하기 위해서라면 받아주겠어……!」
				ENDIF	
			ELSEIF CFLAG:TARGET:아르바이트 == 433 && CFLAG:MASTER:현재위치 == 場所_教会
				PRINTFORMW 「네……❤ 천한 요괴의 몸이오나, 저의 모든 것을 위대하신 분께 바치겠습니다……❤」
				PRINTFORMW 「부디 영혼의 한 조각까지 패배의 증표를 새겨주세요……❤」
			ELSEIF CFLAG:TARGET:아르바이트 == 100 && CFLAG:MASTER:현재위치 == 場所_裏通り
				PRINTFORMW 「……촬영 중에 만지는 건 금지야.」
				PRINTFORMW 「농~담…… 어차피 %CSTR:TARGET:MASCALL%는 그런 거에 흥분하지…… 후훗, 못 말리는 사람❤」
			ELSEIF CFLAG:TARGET:아르바이트 == 304 && CFLAG:MASTER:현재위치 == 場所_牧場
				PRINTFORMW 「……❤ 음머, 음머어……❤ 음머❤ 음머, 음머어❤」
				PRINTFORMW 「음머어, 안돼애, 나쁜 늑대 씨에게 잡아먹혀버려❤ ……음머어❤」			
			ELSE
				SELECTCASE RAND:3
					CASE 0
						IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨 || TALENT:TARGET:애처
							PRINTFORMW 「……눈이 짐승 같네?」
							PRINTFORMW 「후훗, 나도, 이런 눈을 하고 있으려나……❤」
						ELSE
							PRINTFORMW 「……강압적인 남자는 미움받는다고.」
						ENDIF
					CASE 1
						IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨 || TALENT:TARGET:애처
							PRINTFORMW 「……자, 이리 온.」
							PRINTFORMW %CALLNAME:TARGET%는 껴안으려는 듯 양팔을 이쪽으로 내밀었다……
						ELSE
							PRINTFORMW 「너무 쳐다보지 마, 바보……」
						ENDIF
					CASE 2
						IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨 || TALENT:TARGET:애처
							PRINTFORMW 「%CSTR:TARGET:MASCALL%(와)과 함께라면 언제든지 괜찮아……」
							PRINTFORMW 「나를 그저 여자일 뿐이라고, 그렇게 가르쳐줘……❤」
						ELSE
							PRINTFORMW 「자, 마음대로 하라구……」
						ENDIF
				ENDSELECT
			ENDIF
		;攻守反転（MASTERが受け）
		ELSEIF CFLAG:MASTER:우후후 == 2
			IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨 || TALENT:TARGET:애처
				PRINTFORMW 「어머어머, 괜찮겠어……❤」
				PRINTFORMW 「각오해. 나쁜 요괴에게 잡아먹힐 테니……❤」
			ELSE
				PRINTFORMW 「……후, 후훗! 그렇지, 얕보이기만 하는 건 좋지 않지……!」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
