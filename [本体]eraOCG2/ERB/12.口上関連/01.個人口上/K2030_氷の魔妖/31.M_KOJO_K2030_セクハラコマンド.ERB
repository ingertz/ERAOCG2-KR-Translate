;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;310, 엉덩이를 쓰다듬는다
;ABL:친밀(2 이하=불쾌(TALENT:겁쟁이라면 울먹임) 3 이상=부끄러워함(TALENT:남성혐오 및 MASTER가 남자라면, 몸을 움츠림) 6 이상=되는 대로 맡김)
;CFLAG:우후후==2&&TCVAR:TARGET:CT행동(31=뒤에서 껴안기 32=앞에서 껴안기 50=수음 51=펠라 52=스마타 53=파이즈리 59=유두 빨기
;60=답례 키스 61=역강간 70=커닐링구스 강제 72=애널 봉사 강제
;CFLAG:우후후==2&&TEQUIP:69(팬티 있음 TCVAR:TARGET:20(70~72)는 이쪽)
;PREVCOM(305=무릎베개)
;TFLAG:400(1=데이트 장소 or 지하의 몹이 반응한다)
;==================================================
@M_KOJO_SUCCESS_COM_K2030_310
;성패 판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K2030_310
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2030_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2030_310_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;친밀。여기를 기입했을 경우, 이 아래는 나오지 않음
	;기입 체크（=0, 비표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1

		;６以上
		IF ABL:TARGET:친밀 >= 6
			PRINTFORMW 
		;３以上
		ELSEIF ABL:TARGET:친밀 >= 3
			PRINTFORMW 
		;２以下
		ELSEIF ABL:TARGET:친밀 <= 2
				PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF

	;첫 엉덩이 쓰다듬기
	IF FIRSTTIME(SELECTCOM)
		PRINTFORMW 「잠깐, 이봐. ……기다려. 설교 타임.」
		PRINTFORMW 「우선 첫째, 아무리 미소녀를 상대로 참을 수 없다고 해서 멋대로 엉덩이를 만지지 마. 둘째, 혼난다고 그만둘 거면 처음부터 하지 마.」
		PRINTFORMW 「……그렇다고 당당하게 만져도 된다는 말은 아니야. 아, 정말, 일일이 음흉하게 굴지 마……!」
		RETURN 1
	ENDIF

	;기본 세트
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
		IF TALENT:TARGET:굴복됨 
			PRINTFORMW 「네에❤ %CSTR:TARGET:MASCALL% 마음대로 하세요❤」
		ELSE
			PRINTFORMW 「……하아, 최소한 사양하는 척이라도 하라고.」
		ENDIF
		CASE 2
			IF TALENT:TARGET:굴복됨  
				PRINTFORMW 「후훗, 저항할 리가 없잖아❤」
				PRINTFORMW %CALLNAME:TARGET%는 엉덩이를 살랑살랑 흔들며 도발해왔다.
			ELSE
				PRINTFORMW 「별로 저항 안 하지 않냐고? ……뭐, 남자란 건 미소녀 앞에서 이성을 유지하는 건 무리일 테고, 어쩔 수 없지.」
			ENDIF
		CASE 3
			IF TALENT:TARGET:굴복됨  
			PRINTFORMW 「만족할 때까지 만져줘❤ %CSTR:TARGET:MASCALL%를 위해서 동그랗게 유지하고 있으니까❤」
			ELSE
			PRINTFORMW 「으음, 좀 더 저항했어야 했나. 점점 사양하는 법이 없어지네.」
			ENDIF
		;연모
		CASE 4
			PRINTFORMW 「응, ……이렇게 몇 번이고 만져지면, 역시 이쪽도 느끼는 게 있다고.」
		;친애
		CASE 5
			PRINTFORML 「정말, 이 변태. 좋아, 당신이 만족할 때까지 쓰다듬어.」
			PRINTFORMW 「%CSTR:TARGET:MASCALL%가 원해주는 한, 나도 어울려 줄게.」
	ENDSELECT
ENDIF
RETURN 1
;==================================================
;311, 껴안는다
;ABL:친밀(3 이하=부끄러워하는 듯 4 이상=싫지 않은 눈치 8 이상=마주 껴안아 옴)
;CFLAG:우후후==2&&TCVAR:TARGET:CT행동(31=뒤에서 껴안기 32=앞에서 껴안기 50=수음 52=스마타 59=유두 빨기 60=답례 키스 61=역강간
;TFLAG:400(1=데이트 장소 or 지하의 몹이 반응한다)
;==================================================
@M_KOJO_SUCCESS_COM_K2030_311
;성패 판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K2030_311
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2030_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2030_311_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;친밀。ここを記入した場合、これより下は流れない
	;기입 체크（=0, 비표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1
		;８以上
		IF ABL:TARGET:친밀 >= 8
			PRINTFORMW 
		;４以上
		ELSEIF ABL:TARGET:친밀 >= 4
			PRINTFORMW 
		;３以下
		ELSEIF ABL:TARGET:친밀 <= 3
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF

	;첫 껴안기
	IF FIRSTTIME(SELECTCOM)
		PRINTFORMW 「꺅!? 이, 이봐!」
		PRINTFORMW 「갑자기 껴안다니 못 써먹겠네. 갑자기 껴안기면 곤혹과 혐오밖에 안 생긴다고.」
		PRINTFORMW 「……자, 다시 할 기회를 줄게. 좀 더 상냥하게, ……할 수 있지?」
		RETURN 1
	ENDIF

	;기본 세트
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「제법, 따뜻한 몸을 하고 있네.」
			PRINTFORMW 「딱히 괜찮아. 이 정도 열로 녹거나 하진 않아. 그러니까 좀 더 달라붙어도 괜찮아
			IF TALENT:TARGET:굴복됨 
			PRINT ❤
			ENDIF
			PRINTL 」
		CASE 2
			IF TALENT:TARGET:굴복됨 
			PRINTFORMW 「어때요❤ 더욱더, 껴안아도 괜찮아요❤」
			ELSE
			PRINTFORMW 「언제나 하는 말이지만, 당신 한 번 허락해주면 끝을 모르고 하는구나.」
			PRINTFORMW 「……하아, 나란 애, 의외로 쉬웠던 걸까?」
			ENDIF
		CASE 3
			PRINTFORMW 「……어때, 춥지 않아?」
			PRINTFORMW 「딱히, 괜찮다면 상관없어.」
			IF TALENT:TARGET:연모
				PRINTFORMW 「자, 만났을 때 험한 꼴을 겪게 했잖아? 역시 반성 정도는 한다고.」
			ENDIF
		;연모
		CASE 4
			PRINTFORMW 「응, ……들려? 심장 소리. ……언데드족이라고들 하지만, 나도, 이렇게 살아있다고.」
		;친애
		CASE 5
			PRINTFORMW 「후훗, 들려? 내 심장 소리. 나는 들리는데, %CSTR:TARGET:MASCALL%의 고동이.」
			PRINTFORMW 「내 고동과 %CSTR:TARGET:MASCALL%의 심장 소리, 점점 빨라져서 하나로 겹쳐지면 좋겠다, 라던가. ……거짓말 아니야.」
	ENDSELECT
ENDIF
RETURN 1
;==================================================
;312, 키스한다
;ABL:친밀(4 이하=갑작스러운 일에 놀람 5 이상=뺨을 붉게 물들임)
;ABL:욕망(4 이하=갑작스러운 일에 놀람 5 이상=억지로 열고 혀를 섞음)
;CFLAG:우후후==2&&TCVAR:TARGET:CT행동(31=뒤에서 껴안기 32=앞에서 껴안기 33=가슴을 주무르게 하기 50=수음 60=답례 키스 61=역강간
