;TFLAG:400(1=데이트 장소 or 지하의 몹이 반응한다)
;==================================================
@M_KOJO_SUCCESS_COM_K2030_312
;성패 판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K2030_312
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2030_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2030_312_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;初めて
	;기입 체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;첫 키스
		IF EXP:TARGET:Ｍ경험 == 1 && EXP:TARGET:펠라경험 == 0 && CFLAG:TARGET:키스상실상대 == MASTER
			PRINTFORMW 「으읍!? ……푸핫, %CSTR:TARGET:MASCALL% 정말!?」
			PRINTFORMW 「나, 입맞춤 같은 건 처음이었단 말이야!? 언젠가 어딘가에서 멋진 누군가와……라니! 그래, 꿈꿨다고, 소녀인데 뭐가 나빠!?」
			PRINTFORMW 「……하아, 뭐 됐어. 소중히 여겼는데도 빼앗기는 나도 잘못이지. ……다음엔 더 멋진 걸로, 요구할 테니.」
		;그 외
		ELSE
			PRINTFORMW 「알고 있으려나. 나, 키스하는 거 처음이야. 그런데 말이지, 나, 이게 처음은 아니야.」
			PRINTFORMW 「……응, 원망하고 있어. 대대손손, 아니 %CSTR:TARGET:MASCALL%의 대를 끊어버릴 정도로. 웬만큼 미소녀를 괴롭히는 걸 좋아하나 보네.」
			PRINTFORMW 「……읍!? 이, 이봐! 기습이라니 비겁해! ……하아, %CSTR:TARGET:MASCALL%한테 소녀의 미묘한 감정을 알아달라고 한 내가 바보였지.」
		ENDIF
		RETURN 1
	ENDIF

	;기본 세트
	호감도修正 = 5
	SIF TALENT:TARGET:애처
		호감도修正 += 1
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「츄릅…… 입술이란 거 따뜻하구나.」
		CASE 2
			PRINTFORMW 「응! ……후훗, 이번엔 내가 빼앗아버렸네.」
		CASE 3
			PRINTFORMW 「응, 츄……읍. 푸하……. 제법, 버릇이 될 것 같네.」
		CASE 4
			PRINTFORMW 「음, 훗…… 으응!? ……갑자기 혀 넣지 마, 놀라니까.」
		CASE 5
			PRINTFORMW 「으흥……. ……기뻐 보여? 뭐 그렇지, 비교적 좋아해, %CSTR:TARGET:MASCALL%(와)과의 키스.」
		;연모
		CASE 6
			PRINTFORMW 「으음…… 츄릅…… 쥬웁……. 어때, 혀 넣는 것도 익숙해졌어.」
		CASE 7
			PRINTFORMW 「훗, 후훗……❤ ……안되겠네, 녹아버릴 것 같아.」
		;친애
		CASE 8
			PRINTFORML 「이렇게 입맞춤을 나눌 때마다 느껴져, %CSTR:TARGET:MASCALL%의 열기가.」
			PRINTFORMW 「자, 더 해줘. 더욱더 느끼게 해줘, %CSTR:TARGET:MASCALL%가 여기에 있다고.」
		CASE 9
			PRINTFORMW 「쪽, 쪽, 쪽❤…… 가끔은 이렇게 쪼는 것만 하는 것도 나쁘지 않네.」
			PRINTFORMW 「응!? 츕❤ 우물……❤ 웁……❤ ……왜, 참을 수 없게 됐어? 후훗.」
		;애처
		CASE 10
			PRINTFORMW 「응❤ ……후훗. 더, 나를 원해줘❤ %CSTR:TARGET:MASCALL%의 열기를 계속 쏟아부어줘❤ ……알았지.」
	ENDSELECT
ENDIF
RETURN 1
