;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;분기作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:절정
;4以上で昇天、3で超強절정、2で強절정、1で절정

;NOWEX:Ｃ절정 NOWEX:Ｖ절정 NOWEX:Ｂ절정 NOWEX:Ａ절정 NOWEX:Ｍ절정
;各部位の절정

;NOWEX:二重절정、NOWEX:三重절정、NOWEX:四重절정、NOWEX:五重절정
;同時に절정した時の状態
;上記五つに加えてNOWEX:Ｅ절정でも판정

;TOTALEX
;地の文の판정に使われているもの
;5以上で潮を吹き、4以下で背中を反らせて절정する
;詳しくはEVENT_MESSAAGE_ORGASMを参照

;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが삽입中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが삽입中となる。
;NOWEX:사정
;사정量、最大3。たとえばIF NOWEX:MASTER:사정 > 1だと、あなたが大量사정以上した場合となる。

;-------------------------------------------------
;절정時の구상
;-------------------------------------------------
@M_KOJO_MESSAGE_PALAMCNG_B_K1920(ARG)
#DIM TOTALEX
#DIM DYNAMIC 호감도修正
CALL PALAM_MESSAGE_B(ARG)
TOTALEX =  NOWEX:ARG:Ｃ절정 + NOWEX:ARG:Ｖ절정 + NOWEX:ARG:Ａ절정 + NOWEX:ARG:Ｂ절정+ NOWEX:ARG:Ｍ절정 + NOWEX:ARG:Ｅ절정 + NOWEX:ARG:분유 + NOWEX:ARG:사정
SIF !(TOTALEX + NOWEX:ARG:방뇨)
	RETURN 0
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;분유
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:분유
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;사정した
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:사정
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;방뇨
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:방뇨
		PRINTFORMW 
		RETURN 1
	ENDIF

	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;ここを記入した場合、これより下は流れない
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1
		RETURN 1
	ENDIF
	SETCOLOR C_H_PINK
	;基本セット
	SELECTCASE NOWEX:ARG:절정
		;절정
		CASE 1
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖ섹스 == MASTER
					PRINTFORML 「ああっ❤　抑えられねぇ♥　くぅぅっ❤　なんでこんなもの吹き出して……❤　%CSTR:TARGET:MASCALL%にもかかってんじゃねぇか……❤」
					PRINTFORMW 「嬉しそうな顔する所じゃないだろ……❤　止まれぇ❤　止まれぇ……❤　だめだっ❤❤　止まらないぃ……❤」
				ELSE
					PRINTFORMW 「ああっ❤　抑えられねぇ♥　くぅぅっ❤　なんでこんなもの吹き出して……❤　止まれっ❤❤　と、止まらないぃ……❤❤」
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 「くうっ……❤　あうっ……❤　別になんでもねぇ……❤　イッてなんか……ひゃあっ❤❤　あ、くうぅ❤❤　触るんじゃねぇ❤❤　今敏感なんだから……❤」
				ELSE
					PRINTFORMW 「くうっ……❤　あうっ……❤　別になんでもねぇ……❤　イッてなんかねぇよ……❤」
				ENDIF
			ENDIF
		;強절정
		CASE 2
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖ섹스 == MASTER
					PRINTFORML 「くうっ❤❤　止まらねぇ❤❤　潮なんて吹きたくないのにぃ……❤　ああっ……❤　%CSTR:TARGET:MASCALL%にもかかって……❤」
					PRINTFORMW 「ううっ……❤❤　にやにやすんな……❤❤　こっちは恥ずかしいんだぞ……❤❤　お前が嬉しそうでも……❤❤　%CSTR:TARGET:SELFCALL%は気になるんだよ……❤❤
				ELSE
					PRINTFORMW 「くうっ❤❤　止まらねぇ❤❤　潮なんて吹きたくねぇのにぃ……❤　あんまり見るな……❤❤　恥ずかしいだろ……❤❤」
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 「くうっ……❤　ふーっ……❤　あーっ……❤　うっ……❤　あんまり見るな……❤　体震えて……❤❤　はあーっ……❤　だらしない顔してるから……❤❤」
				ELSE
					PRINTFORMW 「くうっ……❤　ふーっ……❤　別になんでもねぇ……❤　ちょっと震えただけ……❤　だからあんまり見るな……❤❤」
				ENDIF
			ENDIF
		;超強절정
		CASE 3
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖ섹스 == MASTER
					PRINTFORML 「おごっ！？❤　ああっ❤❤　潮が止まらない……❤❤　ああっ❤❤　%CSTR:TARGET:MASCALL%にもかかってる……❤❤」
					PRINTFORMW 「嬉しそうな顔しやがって……❤❤　オラッ……❤　ならもっと浴びろ…❤　お前のお陰で気持ち良くさせられたんだ……❤　責任取って潮浴びてろ……❤❤」
				ELSE
					PRINTFORMW 「おごっ！？❤　ああっ❤❤　潮が止まらない……❤❤　あがっ❤❤　なんて震えだ……❤　ちきしょう……❤❤　こんな顔見せたくないのに……❤❤」
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 「お゛っ！？❤　おごっ！？❤　くそっ❤　クソっ❤　震え止まらないっ……❤❤　あーっ❤　だめぇ❤❤　こんなの……❤❤　だめぇ……❤❤」
				ELSE
					PRINTFORMW 「お゛っ！？❤　おごっ！？❤　体……❤❤　震えたぁ……❤❤　あ、ううっ……❤❤　見てんじゃねぇ……❤❤」
				ENDIF
			ENDIF
		;昇天
		CASE 4 TO 5
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖ섹스 == MASTER
					PRINTFORML 「お゛っ！？❤　おごっ！？❤　ううっ❤❤　ううっ……❤❤　しお❤❤　とまらにゃい……❤❤　%CSTR:TARGET:MASCALL%にもかかってる……❤❤」
					PRINTFORMW 「……ははっ❤　ならもっとかけてやる……❤❤　気持ち良くした責任取って浴びろっ❤❤　アタシのしおで……❤❤　溺れさせてやりゅう……❤❤」
				ELSE
					PRINTFORML 「お゛っ！？❤　おごっ！？　ううっ❤❤　ううっ……❤❤　しお❤❤　とまらにゃい……❤❤」
					PRINTFORMW 「……ははっ❤　震えすごい……❤❤　イクの終わらない……❤❤　ずっとぶるんって……❤❤　あはっ❤❤」
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 「おごっ！？❤　うっ❤❤　ううっ……❤❤　これ……❤ しゅご……❤❤　ああっ……❤❤　見るなぁ……❤❤　イッってる顔……❤❤　見ないでぇ……❤❤」
				ELSE
					PRINTFORMW 「おごっ！？❤　うっ❤❤　ううっ……❤❤　これ……❤ しゅご……❤❤　ああっ……❤❤　見るなぁ……❤❤　イッってる顔……❤❤　見ないでぇ……❤❤」
				ENDIF
			ENDIF
	ENDSELECT
	RESETCOLOR
ENDIF
RETURN 1


