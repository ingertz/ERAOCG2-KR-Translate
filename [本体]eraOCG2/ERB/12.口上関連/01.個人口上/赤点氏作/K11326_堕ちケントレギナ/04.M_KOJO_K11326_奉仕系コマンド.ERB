;80,수음
;==================================================
@M_KOJO_MESSAGE_COM_K11326_80
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K11326_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K11326_80_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「ふーん、手でシて欲しいんだぁ～？❤　初めてだから間違えて握りつぶしちゃってもごめんねぇ？❤
		PRINTFORMW 　……冗談だからそんなに怖がらないでよ❤　頑張って優しくするから、気持ちよくなってね❤❤❤」
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「ふふふ、私の手でたぁ～っぷりご奉仕して上げるからねぇ❤」
		CASE 2
			PRINTFORMW 「ふーっ❤　私の手でビクビクって反応しちゃって、なんか可愛い❤」
		CASE 3
			PRINTFORMW 「こんな凶悪なモノが私に出たり入ったりって思うと❤　身体が火照ってきちゃうよ……❤」
		CASE 4
			PRINTFORMW 「どう？気持ちいい？　私の手でもっと気持ちよくなってくれたら嬉しいなぁ❤❤」
		CASE 5
			PRINTFORMW 「気持ちいい？　出そう？　いいよ❤　いっぱい出して❤　私を정액で白く染め上げてぇ❤❤」
	ENDSELECT
ENDIF
RETURN 1

;==================================================
;81,펠라치오
;==================================================
@M_KOJO_MESSAGE_COM_K11326_81
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K11326_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K11326_81_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;ファースト키스
		IF EXP:TARGET:Ｍ경험 == 0 && EXP:TARGET:펠라경험 == 1 && CALLNAME:(CFLAG:TARGET:키스상실상대) == CALLNAME:MASTER
			PRINTFORMW 「んちゅっ❤❤　ふふ、私のファースト키스をちんぽにさせたいだなんて、マスターって相当な変態だね……？❤❤❤」
		;それ以外
		ELSE
			PRINTFORMW 「えっと、これを舐めればいいんだね……？❤　ん……っ❤　ちゅ……っ❤
			PRINTFORMW 　初めてだから、上手く出来てるか分かんないんだけど……　その顔を見れば、大丈夫そうだね❤❤」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
		
	;お掃除펠라
	IF STAIN:MASTER:2 & 4 && ABL:TARGET:기교 >= 3
		PRINTFORMW 「ふふ、たくさん出したねぇ❤　今から、きれーにしてあげるよ……っ❤❤」

	;通常
	ELSE
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「ぺろっ❤　ぺろっ❤　こんな凶悪なモノが私に出たり入ったりするんだよね……❤」
		CASE 2
			PRINTFORMW 「じゅる、じゅるるっ❤　この味、子宮にくるぅ……❤」
		CASE 3
			PRINTFORMW 「いつでも出していいよっ❤　全部飲み込んであげるからぁっ❤❤」
		CASE 4
			PRINTFORMW 「れろっ、んむっ……❤　やばい、これぇ❤　舐めてるだけで濡れてきちゃったぁ……❤」
		CASE 5
			PRINTFORMW 「じゅるじゅるっ❤　頂戴っ❤　濃ぉい정액、私にたっぷり出してぇっ❤❤❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

