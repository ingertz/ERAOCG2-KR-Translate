;==================================================
;10,ダメージ反応！（ダメージ）
;==================================================
@M_KOJO_DUEL_K11326_10(ダメージ量,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC ダメージ量
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE ダメージ量
		;ダメージなし
		CASE 0
			PRINTFORMW 「～～～っ！　……ってあれ？　ダメージないの？」
		;１～１９９９の時、小ダメージ
		CASE 1 TO 1999
			PRINTFORMW 「いてて……　こんなのかすり傷程度だけどね！」
		;２０００～３９９９の時、結構なダメージ
		CASE 2000 TO 3999
			PRINTFORMW 「痛ったぁ……っ！　後で覚えてなよ！」
		;４０００～７９９９の時、超大ダメージ
		CASE 4000 TO 7999
			PRINTFORMW 「ぐえええええっ！？」
		;８０００以上、基本即死
		CASEELSE
			PRINTFORMW 「ちょっと待ったぁー！　そんなの耐えられ……っ！！　ぎゃああああああっ！！！」
	ENDSELECT
ENDIF


