;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 実行コマンド
		CASE "Ｃ単発"
			PRINTFORMW 「ひゃあんっ❤　そこ、ダメぇっ❤」
		CASE "묘상捕縛"
			PRINTFORMW 「あっ、ダメぇっ❤　いまはデュエル中なのにぃっ❤❤」
		CASE "全身愛撫"
			PRINTFORMW 「ん……っ❤　も、もぉ……っ❤　今、デュエル中だよ……っ❤」
		CASE "前穴凌辱"
			PRINTFORMW 「あっ、待ってぇっ❤❤　それ、ダメだからぁっ❤❤❤」
		CASE "全身凌辱"
			PRINTFORMW 「ひゃうっ❤　ちょ、ちょっとぉっ❤❤　今、こんなことしてる場合じゃ……っ❤❤❤」
		CASE "疑似출산"
			PRINTFORMW 「ふーっ、ふーっ❤❤　こ、こんなこと、させてぇ……っ❤」
		;その他全部
