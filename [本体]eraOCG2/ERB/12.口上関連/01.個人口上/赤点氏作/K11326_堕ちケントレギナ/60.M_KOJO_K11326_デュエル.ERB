;==================================================
;0,デュエルスタート！
;==================================================
@M_KOJO_DUEL_K11326_0(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「よーし、いくらマスターだからって手加減はしないからねぇ！」
		CASE 2
			PRINTFORMW 「やるからには全力だからね？」
		CASE 3
			PRINTFORMW 「へっへっへっ、そろそろ私がいかに凶暴だったかを思い出させてあげようかなぁっ！」
	ENDSELECT
ENDIF

;==================================================
;1,モンスター소환
;例：%カード名%を소환！
;==================================================
@M_KOJO_DUEL_K11326_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「よし、%カード名%소환！」
		CASE 2
			PRINTFORMW 「さぁ、%カード名%の登場！」
		CASE 3
			PRINTFORMW 「現れろ、%カード名%！」
	ENDSELECT
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_KOJO_DUEL_K11326_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 소환出処
		;손패から
		CASE 召種손패
			PRINTFORMW 「손패から%カード名%、특수소환！」
		;마법함정ゾーンから。　キリ番・シェイプシスターなどを出す場合
		CASE 召種마함
			PRINTFORMW 「起動せよ、%カード名%！」
		;덱から
		CASE 召種덱
			PRINTFORMW 「덱から%カード名%を특수소환するよ！」
		;EX덱から
		CASE 召種EX덱
			PRINTFORMW %カード名%「EX덱から、%カード名%특수소환！」
		;묘지から
		CASE 召種묘지
			PRINTFORMW 「甦れぇ、%カード名%っ！」
		;제외状態から
		CASE 召種제외
			PRINTFORMW 「戻ってこい、%カード名%！」
		;主にトークン生成
		CASE 10
			PRINTFORMW 「%カード名%、出現！」
	ENDSELECT
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K11326_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORMW 「의식소환！　いっけぇ、%カード名%！」
		CASE 융합
			PRINTFORMW 「융합소환、いでよ%カード名%！」
		CASE 싱크로
			PRINTFORMW 「싱크로소환、%カード名%、いざ出陣！」
		CASE 엑시즈
			PRINTFORMW 「엑시즈소환！　顕現せよ、%カード名%！」
		CASE 링크
			PRINTFORMW 「링크소환！　%カード名%、到着ぅっ！」
		;초차원モンスター（デュエマ）
		CASE 초차원
			PRINTFORMW 「초차원展開！　%カード名%、ここに降臨ッ！」
	ENDSELECT
ENDIF

