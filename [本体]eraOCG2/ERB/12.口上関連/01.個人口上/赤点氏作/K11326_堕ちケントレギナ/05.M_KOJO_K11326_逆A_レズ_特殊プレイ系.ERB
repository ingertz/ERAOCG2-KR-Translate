		PRINTFORMW 「やぁん❤　裸にされちゃったぁ❤　一体これから何をされちゃうんだろうっ❤❤」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		PRINTFORMW 「あぁんダメだよマスターっ❤　裸にされちゃったぁ❤　」
	
	;それ以外
	ELSE
		PRINTFORMW 「ひゃあん❤　裸に剥かれたぁっ❤　マスターのえっちぃ❤」
	ENDIF
ENDIF
RETURN 1
[SKIPEND]

