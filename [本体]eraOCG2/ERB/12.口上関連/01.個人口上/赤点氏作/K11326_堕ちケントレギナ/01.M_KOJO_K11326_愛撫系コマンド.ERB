@M_KOJO_MESSAGE_COM_K11326_0_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「んっ……❤　こらぁ、もっと優しくしてよぉ……❤
		PRINTFORMW 　濡れてるって、そんな訳ないでしょ❤　……触って確かめてみる？❤」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;삽입中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V삽입
	IF LOCAL:1 && TEQUIP:50 == MASTER
		;사정した
		IF NOWEX:PLAYER:11
			PRINTFORMW 「いっぱい、出したね……❤
			PRINTFORMW 　お腹、熱くてやけどしちゃいそう❤」
			RETURN 1
		ELSE
			PRINTFORMW 「んっ、はっ、ふーっ❤」
			RETURN 1
		ENDIF
	;A삽입
	ELSEIF LOCAL:1 && TEQUIP:51 == PLAYER
		;사정した
		IF NOWEX:PLAYER:11
			PRINTFORMW 「お゛っ！？　ま、待ってぇ……っ❤　そっちは違……っ❤
			PRINTFORMW 　あ゛っ❤　あ゛あ゛っ❤❤　頭、おかしくなっちゃう……❤」
			RETURN 1
		ELSE
			PRINTFORMW 「ヤバ、これ……　癖になりそう……❤」
			RETURN 1
		ENDIF
	ENDIF

	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 1
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「んあっ……　おっぱい触りすぎぃ……❤」
		CASE 2
			PRINTFORMW 「だめぇ……❤　触り方がいやらしいよぉ❤」
		CASE 3
			PRINTFORMW 「ちょっとぉ……っ❤　そんなに気に入ったの？❤」
		;연모
		CASE 4
			PRINTFORMW 「あ……っ❤　これ、やばいぃ……っ❤　頭、バカになるぅ❤」
		CASE 5
			PRINTFORMW 「やだぁ❤　これ以上されたら、胸だけでイっちゃうからぁ❤」
		;親愛
		CASE 6
			PRINTFORMW 「お゛っ❤　ごめんなさいぃ❤　ちょっと揉まれてイグっ❤　雑魚乳許してぇ❤❤」
		CASE 7
			PRINTFORMW 「もっとぉ❤　もっと揉んでぇ❤　徹底的に躾けてくださいぃ❤❤」
		;애처
		CASE 8
			PRINTFORMW 「マスターっ❤　好き、好きぃっ❤　もっとたくさん触ってぇっ❤❤❤」
	ENDSELECT
ENDIF
RETURN 1
