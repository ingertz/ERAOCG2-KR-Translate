CALL M_KOJO_MESSAGE_COM_K11326_340_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K11326_340_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「んもぉ❤　おチンポ嗅げだなんて、私以外にしたら絶対ダメからね❤」
		CASE 2
			PRINTFORMW 「効くぅ❤　マスターのイケメンチンポの臭い最高っ❤❤　このままオナニーして良いかなぁ！？❤」
		CASE 3
			PRINTFORMW 「ねぇ❤　本当に嗅ぐだけなの？　舐めていい？❤　いいよねっ！？❤」
		;연모
		CASE 4
			PRINTFORMW 「分かったからぁ❤　私はマスターのおチンポの臭いだけで興奮するダメな雌ですっ❤　たっぷり躾けてくださいっ❤❤」
		;親愛
		CASE 5
			PRINTFORMW 「ワンワンっ❤　私は待てが出来ない変態雑魚雌펫ですっ❤　イケメンチンポでお仕置きレイプしてくださいっ❤❤」
	ENDSELECT
ENDIF
RETURN 1

