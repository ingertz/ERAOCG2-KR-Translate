@M_KOJO_MESSAGE_COM_K11326_310_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;친밀。ここを記入した場合、これより下は流れない
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1
		;６以上
		IF ABL:TARGET:친밀 >= 6
			PRINTFORMW 
		;３以上
		ELSEIF ABL:TARGET:친밀 >= 3
			PRINTFORMW 
		;２以下
		ELSEIF ABL:TARGET:친밀 <= 2
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「ひゃんっ！？　急に触ったらびっくりするじゃん❤」
		CASE 2
			PRINTFORMW 「んっ❤　撫で方がいやらしいなぁ……❤」
		CASE 3
			PRINTFORMW 「～っ❤　ちょっとぉ❤　急に触るなんてエッチだねぇ❤」
		;연모
		CASE 4
			PRINTFORMW 「ん……っ❤　触るの、ダメぇ……っ❤　発情スイッチ入って❤　愛液垂れてきちゃうからぁ……❤」
