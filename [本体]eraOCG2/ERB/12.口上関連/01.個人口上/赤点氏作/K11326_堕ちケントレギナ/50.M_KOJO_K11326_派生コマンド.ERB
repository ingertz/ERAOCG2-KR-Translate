;1,식스나인
;==================================================
@M_KOJO_MESSAGE_SCOM_K11326_1
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K11326_1_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K11326_1_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「んっ❤　はぁ……っ❤　マスターの舐めながら……っ❤　舐められるの、気持ちいいね……っ❤❤」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		PRINTFORMW 「んっ❤　そこぉ……っ❤　あっ、待ってぇ❤　マスターのが良すぎてぇっ❤　ご奉仕できないからぁっ❤❤」
		RETURN 1

	;それ以外
	ELSE
		PRINTFORMW 「はぁ……っ❤　これ、好きぃ……っ❤　マスターにイジメてもらいながらぁ……❤　マスターのおちんぽ舐めれるぅっ❤❤」
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K11326_{SELECTCOM}_1
RETURN 1

