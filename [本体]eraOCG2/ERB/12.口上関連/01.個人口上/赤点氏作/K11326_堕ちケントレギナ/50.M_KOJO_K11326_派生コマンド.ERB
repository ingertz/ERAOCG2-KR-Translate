;==================================================
;12,파이즈리펠라
;==================================================
@M_KOJO_MESSAGE_SCOM_K11326_12
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K11326_12_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K11326_12_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「えーと、胸でしながら口でも……？❤　良いけど、難しいこと注文するなぁ……❤」
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「ほーら❤　挟んだまま舐めてあげるよ❤　れろっれろぉ……❤　贅沢だねぇ❤」
		CASE 2
			PRINTFORMW 「んっ、んちゅ❤　れろぉ❤　どう？気持ちいい？❤　精一杯ご奉仕するからご褒美ちょーだいっ❤」
		CASE 3
			PRINTFORMW 「んっ❤　……っしょ❤　どう？　マスターっ❤　気持ちいい？❤❤」
		CASE 4
			PRINTFORMW 「じゅるるっ❤　イキそう？❤　いいよ、いっぱい정액ちょうだいっ❤❤」
		CASE 5
			PRINTFORMW 「れろぉ❤　んちゅっ❤　いっぱい出してぇ❤　雑魚雌口まんこ孕ませてぇっ❤❤」
	ENDSELECT
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K11326_{SELECTCOM}_1
RETURN 1

