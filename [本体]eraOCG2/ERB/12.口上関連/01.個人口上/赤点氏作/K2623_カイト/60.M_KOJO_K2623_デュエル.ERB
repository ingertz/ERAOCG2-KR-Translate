;==================================================
;10,ダメージ反応！（ダメージ）
;==================================================
@M_KOJO_DUEL_K2623_10(ダメージ量,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC ダメージ量
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE ダメージ量
		;ダメージが０の時
		CASE 0
			PRINTFORMW 「ふっ、ダメージは無効となっている。」
		;１～１４９９の時、小ダメージ
		CASE 1 TO 1499
			PRINTFORMW 「この程度、かすり傷だ……」
		;１５００～３９９９の時、結構なダメージ
		CASE 1500 TO 3999
			PRINTFORMW 「く……っ！　まだだ、まだ俺にはやるべきことがある……ッ！」
		;４０００～７９９９の時、超大ダメージ
		CASE 4000 TO 7999
			PRINTFORM 「ぐぅぅぅっ！！」
		;８０００以上、基本即死
		CASEELSE
			PRINTFORMW 「ぐあああああああああっ！！」
	ENDSELECT
ENDIF


