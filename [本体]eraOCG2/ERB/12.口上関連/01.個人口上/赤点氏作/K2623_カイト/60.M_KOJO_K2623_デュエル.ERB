;### 구상存在판정 ###################################
@M_KOJO_K2623(ARG)
;別人版を作成する際はこのテンプレではなく別人版用구상テンプレをご利用ください
;他の処理は一切行わないように
RETURN 1

;※※※※※※※※※※※※※※※※※※※※※※※※※
;DUEL用구상
;※※※※※※※※※※※※※※※※※※※※※※※※※

;カードID == (カードの番号)　でそのカード専用の구상が流せる
;カード番号は 10.デュエル関連/02.CARDS 内に入っているため、必要に応じて参照するように
;例：	IF カードID == 1000
;			PRINTFORMW 「ブラックマジシャンガールを소환！」
;		ENDIF

;==================================================
;0,デュエルスタート！
;==================================================
@M_KOJO_DUEL_K2623_0(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「この俺にデュエルを挑むとは……　良いだろう！
			PRINTFORMW 　全力で貴様を叩き潰してやる、掛かってくるが良い！」
		CASE 2
			PRINTFORMW 「ふっ……　眠れる獅子を起こしたこと、後悔させてやるぞ！」	
		CASE 3
			PRINTFORMW 「狩らせてもらうぞ、お前のナンバーズを！」
	ENDSELECT
ENDIF

;==================================================
;1,モンスター소환
;例：%カード名%を소환！
;==================================================
@M_KOJO_DUEL_K2623_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF カードID == 23170
		PRINTFORMW 「%カード名%を攻撃표시で소환！」
	ELSEIF カードID == 23191
		PRINTFORMW 「来い、%カード名%！　さぁ、俺のために働いてもらうぞ。」
	ELSE
		SELECTCASE RAND:2 + 1
			CASE 1
				PRINTFORMW 「こい、%カード名%を소환！」
			CASE 2
				PRINTFORMW 「%カード名%を攻撃표시で소환する！」
		ENDSELECT
	ENDIF
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_KOJO_DUEL_K2623_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF カードID == 23170
		PRINTFORMW 「闇に輝く銀河よ、希望の光になりて我が僕に宿れ！
		PRINTFORMW 　光の化身、ここに降臨！　現れろ、%カード名%！」
	ELSE
		SELECTCASE 소환出処
			;손패から
			CASE 召種손패
				PRINTFORMW 「손패からモンスターを특수소환！　来い、%カード名%！」
			;마법함정ゾーンから。　キリ番・シェイプシスターなどを出す場合
			CASE 召種마함
				PRINTFORMW 「마법함정ゾーンより、%カード名%を특수소환する！」
			;덱から
			CASE 召種덱
				PRINTFORMW 「덱に眠る%カード名%よ、我が元に現れよ！」
			;EX덱から
			CASE 召種EX덱
				PRINTFORMW 「ＥＸ덱から%カード名%を특수소환する！」
			;묘지から
			CASE 召種묘지
				PRINTFORMW 「묘지からモンスターを특수소환する！　甦れ、%カード名%！」
			;제외状態から
			CASE 召種제외
				PRINTFORMW 「제외されている%カード名%よ、我がフィールドに舞い戻れ！」
			;主にトークン生成
			CASE 10
				PRINTFORMW 「現れろ、%カード名%！」
		ENDSELECT
	ENDIF
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K2623_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF カードID == 50535
		PRINTFORMW 「逆巻く銀河よ、今こそ怒涛の光となりてその姿を現すが良い！
		PRINTFORMW 　降臨せよ、我が魂！　%カード名%！」
	ELSEIF カードID == 50536
		PRINTFORMW 「銀河の光の導くところ新たな世界がひらかれる！！　天孫降臨！
		PRINTFORMW 　アーマード엑시즈소환！！　現れろ新たなる光の化身！　%カード名%！」
	ELSEIF カードID == 58038
		PRINTFORMW 「我が記憶に眠る二つの希望！その希望を隔てし闇の大河を貫き今その力が一つとなる！
		PRINTFORMW 　엑시즈소환！！　現れろＮｏ.３８！　希望魁竜タイタニック・ギャラクシー！！」
	ELSEIF カードID == 58046
		PRINTFORMW 「現れろ、Ｎｏ.４６！　雷鳴よ、とどろけ。　稲光よ、きらめけ。
		PRINTFORMW 　顕現せよ、金色の龍！　神影龍ドラッグルーオン！」
	ELSEIF カードID == 58062
		PRINTFORMW 「現れろ！　銀河究極龍、Ｎｏ.６２！ 宇宙にさまよう光と闇、その狭間に眠りし哀しきドラゴンたちよ。
		PRINTFORMW 　その力を集わせ、真実の扉を開け！　銀河眼の光子竜皇！！」
	ELSEIF カードID == 58162
		PRINTFORMW 「カオス・엑시즈・チェンジ！　逆巻く銀河の混沌よ、真実の光となりて希望の扉を開け！！
		PRINTFORMW 　降臨せよ、%カード名%！！」
	ELSEIF カードID == 58090
		PRINTFORMW 「銀河創生のビッグバン！！その波動こそが俺を導く覇道となる！！
		PRINTFORMW 　降臨せよ、%カード名%！」
	ELSEIF カードID == 58107
		PRINTFORMW 「宇宙を貫く雄叫びよ。遥かなる時をさかのぼり、銀河の源よりよみがえれ！
		PRINTFORMW 　顕現せよ、そして俺を승리へと導け！　%カード名%！」
	ELSEIF カードID == 58207
		PRINTFORMW 「逆巻く銀河を貫いて、時の生ずる前より蘇れ！　永遠を超える竜の星！
		PRINTFORMW 　顕現せよ、%カード名%！」
	ELSEIF カードID == 58100
		PRINTFORMW 「宇宙創造の鍵、今こそ闇の扉を開き、未来を、その咆哮とともに導け！
		PRINTFORMW 　降臨せよ、Ｎｏ.１００！　ヌメロン・ドラゴン！」
	ELSE
		SELECTCASE カード種
			;의식소환
			CASE 의식
				PRINTFORMW 「モンスターを의식소환！」
			;융합소환
			CASE 융합
				PRINTFORMW 「モンスターを융합소환！」
			;싱크로소환
			CASE 싱크로
				PRINTFORMW 「モンスターを싱크로소환！」
			;엑시즈소환
			CASE 엑시즈
				PRINTFORMW 「엑시즈소환！　来い、%カード名%！」
			;링크소환
			CASE 링크
				PRINTFORMW 「링크소환！　現れろ、%カード名%！」
			;遊戯王作品以外のEXのモンスター
			CASE 초차원
				PRINTFORMW 「%カード名%を초차원소환！」
		ENDSELECT
	ENDIF
ENDIF

;==================================================
;4,효과仕様宣言
;==================================================
@M_KOJO_DUEL_K2623_4(カードID,발동出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC 발동出処
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 발동出処
		;손패발동
		CASE 1
			IF カードID == 23170
				PRINTFORMW 「손패の銀河眼は、自身の場の攻撃力２０００以上のモンスター２体をリリースすることで、손패から특수소환できる！」
			ELSEIF カードID == 23199
				PRINTFORMW 「손패の残光竜は、自身の場に銀河眼の光子竜が存在する場合、손패から특수소환することが出来る！」
			ELSEIF カードID == 23193
				PRINTFORMW 「손패から%カード名%を묘지に送り、ＬＰを半分払い효과を발동！」
			ELSEIF カードID == 23172
				PRINTFORMW 「その攻撃宣言時、손패から%カード名%の효과を발동する！」
			ELSE	
				PRINTFORMW 「손패の%カード名%の효과を발동！」
			ENDIF	
		;필드발동
		CASE 2
			IF カードID == 23170
				PRINTFORMW 「銀河眼の恐ろしさをその身に刻むが良い！　효과발동！」
			ELSEIF カードID == 23191
				PRINTFORMW 「オービタル！　何をすべきか、分かっているなッ！？　효과を발동だ！」
			ELSE
				PRINTFORMW 「%カード名%の효과、발동!」
			ENDIF
		;마함발동
		CASE 3
			IF カード種 == 速攻마법
				PRINTFORMW 「速攻마법、%カード名%を발동！」
			ELSEIF カード種 == 지속마법
				PRINTFORMW 「지속마법、%カード名%を발동！」
			ELSEIF カード種 == フィールド
				PRINTFORMW 「フィールド마법발동、%カード名%！」
			ELSEIF カード種 == 通常함정
				PRINTFORMW 「함정カード、%カード名%を발동する！」
			ELSE
				PRINTFORMW 「この瞬間、%カード名%を발동する！」
			ENDIF
		;묘지발동
		CASE 4
			PRINTFORMW 「묘지の%カード名%の효과を발동！」
	ENDSELECT
ENDIF



;==================================================
;5,효과발동
;==================================================
@M_KOJO_DUEL_K2623_5(カードID,효과종류)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC 발동出処
#DIM DYNAMIC 효과종류
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	;無効にされた場合
	IF 효과종류 == -1
		PRINTFORMW 「何ッ！？」
	;それ以外
	ELSEIF カードID == 23170 && 효과종류 == 攻撃時誘発
		PRINTFORMW 「バトル終了時までお互いを제외する！　この際、제외された貴様のモンスターがＸなら更に銀河眼の攻撃力をアップさせる！」
	ELSEIF カードID == 50535 && 효과종류 == EX소환時
		PRINTFORMW 「このカードが銀河眼の光子龍を素材としてＸ소환したとき、フィールドの他のカードの효과を全て無効にする！　フォトン・ハウリング！」
	ELSEIF カードID == 50536 && 효과종류 == 필드起動
		PRINTFORMW 「貴様の場の表側のカード１枚を破壊させてもらう！　ギャラクシー・サイドワインダー！」
	ELSEIF カードID == 58038 && 효과종류 == 발동誘発
		PRINTFORMW 「今발동した마법カードの발동を無効にする！　소멸のスケイルズ・ストーム！」
	ELSEIF カードID == 58062 && 효과종류 == 攻撃時誘発
		PRINTFORMW 「攻撃宣言時、素材を一つ使う事で自身の攻撃力を場のＸモンスターのランクの合計×２００アップする！」」
	ELSEIF カードID == 58107 && 효과종류 == 필드起動
		PRINTFORMW 「このカード以外の全てのモンスター효과を無効にし、攻撃力と守備力を元に戻す！　タキオン・トランスミグレイション！」
	ELSEIF カードID == 58207 && 효과종류 == 필드起動
		PRINTFORMW 「このカード以外の全てのカード효과を無効にし、更にこのターンフィールドにあるカードは효과を발동できない！　タイム・タイラント！」
	ELSE
		PRINTFORMW
	ENDIF
ENDIF

