;==================================================
;51,モンスター攻撃結果
;==================================================
@M_KOJO_DUEL_K2623_51(상황판정,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 상황판정
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SIF ARG:1 == 1
		PRINTFORMW 「これならどうだ？」
	SELECTCASE 상황판정
		;상대モンスター撃破
		CASE 1
			PRINTFORMW 「よし、モンスターを破壊したか。」
		;자신にダメージ
		CASE 2
			PRINTFORMW 「く……っ！　これは想定外だな……」
		;相打ち
		CASE 3
			PRINTFORMW 「相打ちか、まぁいい。　よくやってくれた。」
		;ミラフォとかで戦闘前に除去？
		CASE 4
			PRINTFORMW 「な、何ッ！？」
		;ダイレクトアタック
		CASE 5
			PRINTFORMW 「ダイレクトアタック！」
	ENDSELECT
ENDIF



