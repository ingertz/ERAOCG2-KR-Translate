;==================================================
;10,ダメージ反応！（ダメージ）
;==================================================
@M_KOJO_DUEL_K2614_10(ダメージ量,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC ダメージ量
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE ダメージ量
		;ダメージが０の時
		CASE 0
			PRINTFORMW 「ぐ……っ！　ってあれ？　ダメージ受けてないじゃん！？」
			IF CFLAG:MASTER:듀얼레이트 >= 6000
				SETCOLOR C_AQUA
				PRINTFORMW 「油断するな遊馬、何か考えがあるのかもしれない。」
				RESETCOLOR
			ENDIF
		;１～１９９９の時、小ダメージ
		CASE 1 TO 1999
			PRINTFORMW 「く……っ！　まだまだかすり傷だぜ！」
		;２０００～３９９９の時、結構なダメージ
		CASE 2000 TO 3999
			PRINTFORMW 「ぐうううっ！」
		;４０００～７９９９の時、超大ダメージ
		CASE 4000 TO 7999
			PRINTFORMW 「うわああ～～～っ！！」
			IF ライフ_상대 >= 0
				PRINTFORMW 「まだだ、まだ俺のライフは残っているぜ……！」
			ELSE
				PRINTFORMW 「だぁー！　ライフが無くなっちまったぁ！」
			ENDIF
		;８０００以上、基本即死
		CASEELSE
			PRINTFORMW 「うわああ～～～っ！！！」
	ENDSELECT
ENDIF


