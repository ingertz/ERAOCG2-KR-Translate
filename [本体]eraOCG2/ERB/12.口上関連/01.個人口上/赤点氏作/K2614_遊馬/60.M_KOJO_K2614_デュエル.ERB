;カードID == (カードの番号)　でそのカード専用の구상が流せる
;カード番号は 10.デュエル関連/02.CARDS 内に入っているため、必要に応じて参照するように
;例：	IF カードID == 1000
;			PRINTFORMW 「ブラックマジシャンガールを소환！」
;		ENDIF

;==================================================
;0,デュエルスタート！
;==================================================
@M_KOJO_DUEL_K2614_0(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「よーし、絶対負けないからな！」
			IF CFLAG:MASTER:듀얼레이트 >= 6000
				SETCOLOR C_AQUA
				PRINTFORMW 「ふっ……　キミに勝てるかな？」
				RESETCOLOR
			ENDIF
		CASE 2
			IF CFLAG:MASTER:듀얼레이트 >= 6000
				SETCOLOR C_AQUA
				PRINTFORMW 「気を付けろ遊馬、상대は相当な手練れの様だ。」
				RESETCOLOR
			ENDIF
			PRINTFORMW 「へへ、ここは俺に任せろって！」
		CASE 3
			IF CFLAG:MASTER:듀얼레이트 >= 6000
				SETCOLOR C_AQUA
				PRINTFORMW 「成長したキミのデュエルタクティクス、見せてもらおうか。」
				RESETCOLOR
			ENDIF
			PRINTFORMW 「ああ！　油断なんてしないから安心しな！」
	ENDSELECT
ENDIF

;==================================================
;1,モンスター소환
;例：%カード名%を소환！
;==================================================
@M_KOJO_DUEL_K2614_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF カードID == 23550
		PRINTFORMW 「行くぜ！　俺は패에서 %カード名%を소환！」
	ELSEIF カードID == 31550
		PRINTFORMW 「%カード名%を소환するぜ！」
		IF CFLAG:MASTER:듀얼레이트 >= 6000
			SETCOLOR C_AQUA
			PRINTFORMW 「%カード名%を攻撃표시で……？　何か考えがあるのか……？」
			RESETCOLOR
		ENDIF
	ELSEIF カードID == 23554
		PRINTFORMW 「行っけぇ！%カード名%ォ！」
	ELSEIF カードID == 23556
		PRINTFORMW 「来い、%カード名%！　へへ、ちっさいホープみたいだぜ！」
	ELSEIF カードID == 51539
		PRINTFORMW 「来い、希望皇ホープ！　……ってなんか違うぅ！？」
		IF CFLAG:MASTER:듀얼레이트 >= 6000
			SETCOLOR C_AQUA
			PRINTFORMW 「これが野球というモノか……？　実に興味深い……」
			RESETCOLOR
		ENDIF
	ELSE
		SELECTCASE RAND:3 + 1
			CASE 1
				PRINTFORMW 「%カード名%を소환するぜ！」
			CASE 2
				PRINTFORMW 「行っけぇ！　%カード名%！」
			CASE 3
				PRINTFORMW 「来い、%カード名%を소환だ！」
		ENDSELECT
	ENDIF
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_KOJO_DUEL_K2614_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF カードID == 23550
		PRINTFORMW 「行くぜ！　%カード名%を특수소환！」
	ELSEIF カードID == 1110
		PRINTFORMW 「よっしゃあ！　来い、%カード名%！」
	ELSE
		SELECTCASE 소환出処
			;패에서 
			CASE 召種손패
				PRINTFORMW 「패에서 ！　%カード名%を특수소환！」
			;마법함정ゾーンから。　キリ番・シェイプシスターなどを出す場合
			CASE 召種마함
				PRINTFORMW 「마법함정の%カード名%を특수소환だ！」
			;덱에서 
			CASE 召種덱
				PRINTFORMW 「덱에서 %カード名%を특수 소환한다ぜ！」
			;EX덱에서 
			CASE 召種EX덱
				PRINTFORMW 「EX덱에서 %カード名%を특수소환！」
			;묘지から
			CASE 召種묘지
				PRINTFORMW 「蘇れ、%カード名%！」
			;제외状態から
			CASE 召種제외
				PRINTFORMW 「제외されている%カード名%を특수소환！」
			;主にトークン生成
			CASE 10
				PRINTFORMW 「現れろ、%カード名%！」
		ENDSELECT
	ENDIF
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K2614_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE カード種
		;의식소환
		CASE 의식
			PRINTFORMW 「モンスターを의식소환！　行くぜ、%カード名%！」
		;융합소환
		CASE 융합
			PRINTFORMW 「%カード名%を융합소환！」
		;싱크로소환
		CASE 싱크로
			PRINTFORMW 「%カード名%を싱크로소환！」
		;엑시즈소환
		CASE 엑시즈
			IF カードID == 58039
				PRINTFORMW 「よっしゃあ！　俺は２体のモンスターでオーバーレイネットワークを構築！　엑시즈소환！
				PRINTFORMW 　俺達の戦いはここから始まる、白き翼に望みを託せ！　現れろＮｏ.３９！　光の使者、希望皇ホープ！」
				IF CFLAG:MASTER:듀얼레이트 >= 6000
					SETCOLOR C_AQUA
					PRINTFORMW 「ふっ、ホープを出すとは……　どうやらやる気は十分の様だな。」
					RESETCOLOR
				ENDIF
			ELSEIF カードID == 58139
