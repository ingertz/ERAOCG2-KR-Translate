;==================================================
;4,효과仕様宣言
;==================================================
@M_KOJO_DUEL_K2614_4(カードID,발동出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC 발동出処
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 발동出処
		;손패발동
		CASE 1
			IF カードID == 70556
				IF CFLAG:MASTER:듀얼레이트 >= 6000
					SETCOLOR C_AQUA
					PRINTFORMW 「そのカードだ！　行け、遊馬！」
					RESETCOLOR
				ENDIF
				PRINTFORMW 「俺は！　패에서 %カード名%を발동！」
				IF CFLAG:MASTER:듀얼레이트 >= 6000
					SETCOLOR C_AQUA
					PRINTFORMW 「이 카드는 자신の場の希望皇ホープを進化させる！」
					RESETCOLOR
				ENDIF
			ELSEIF カードID == 75550
				IF CFLAG:MASTER:듀얼레이트 >= 6000
					SETCOLOR C_AQUA
					PRINTFORMW 「よし、今だ遊馬！」
					RESETCOLOR
				ENDIF
				PRINTFORMW 「モンスターの攻撃が無効になったこの瞬間、패에서 %カード名%を발동！」
				IF CFLAG:MASTER:듀얼레이트 >= 6000
					SETCOLOR C_AQUA
					PRINTFORMW 「이 카드는 モンスターの攻撃が無効になったとき、その몬스터의 공격력을 倍にしてもう一度攻撃ができる！」
					RESETCOLOR
				ENDIF
			ELSE
				PRINTFORMW 「패에서 %カード名%の효과を발동するぜ！」
			ENDIF
		;필드발동
		CASE 2
				PRINTFORMW 「場の%カード名%の효과を발동！」
		;마함발동
		CASE 3
			IF カード種 == 速攻마법
				PRINTFORMW 「速攻마법！　%カード名%！」
			ELSEIF カード種 == 지속마법
				PRINTFORMW 「지속마법、%カード名%を발동！」
			ELSEIF カード種 == フィールド
				PRINTFORMW 「フィールド마법、%カード名%だ！」
			ELSEIF カード種 == 通常함정
				PRINTFORMW 「リバースカードオープン！　%カード名%！」
			ELSE
				PRINTFORMW 「%カード名%の효과を발동！」
			ENDIF
		;묘지발동
		CASE 4
				PRINTFORMW 「묘지の%カード名%の효과を발동！」
	ENDSELECT
ENDIF



;==================================================
;5,효과발동
;==================================================
@M_KOJO_DUEL_K2614_5(カードID,효과종류)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC 발동出処
#DIM DYNAMIC 효과종류
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;無効にされた場合
	IF 효과종류 == -1
		PRINTFORMW 「何っ！？」
	;それ以外
	ELSEIF カードID == 58039
		PRINTFORMW 「モンスターの攻撃宣言時、自身の素材を一つ使用し、その攻撃を無効にする！」
	ELSEIF カードID == 58139 && 효과종류 == 필드起動
		PRINTFORMW 「自身の素材を一つ使い、攻撃力を５００ポイントアップさせ、更に상대の場のモンスター１体の攻撃力を１０００下げる！
		PRINTFORMW 　オーバーレイ・チャージ！」
	ELSEIF カードID == 58244 && 효과종류 == 필드起動
		PRINTFORMW 「상대の場の몬스터 １장을 破壊し、その攻撃力分のダメージを与える！　Ｖブレードシュート！」

	ELSEIF カードID == 58247
		IF  효과종류 == EX소환時
			PRINTFORMW 「묘지にＲＵＭが存在する상황で이 카드가 Ｘ소환されたとき、フィールドのカード효과は無効となる！」
		ELSEIF 효과종류 ==攻撃時誘発
			PRINTFORMW 「이 카드가 戦闘を行う時、自身の素材を一つ使うことで턴 종료시 까지 、이 카드의 공격력은 その상대モンスターの攻撃分アップする！
			PRINTFORMW 　更に！　ホープを素材としている場合は손패、덱、묘지からＺＷ１장을 装備出来る！　ヴィクトリー・チャージ！」
		ENDIF

	ELSEIF カードID == 582399 && GROUPMATCH(효과종류,필드起動,フリー誘発)
		PRINTFORMW 「자신の場の몬스터 １장을 제외し、묘지のホープを특수소환！　更に、ライフを１２５０회복する！」
	ELSEIF カードID == 58240 && 효과종류 == 攻撃時誘発
		PRINTFORMW 「バトル終了時まで自身の攻撃力を５０００にする！　ライトニング・チャージ！」
	ELSEIF カードID == 58000
		PRINTFORMW 「バトルフェイズ終了時まで戦った상대のコントロールを得る！」
	ELSEIF カードID == 58100 && 효과종류 == 攻撃時誘発
		PRINTFORMW 「そうだ、このカードだ！」
		IF CFLAG:MASTER:듀얼레이트 >= 6000
			SETCOLOR C_AQUA
			PRINTFORMW 「이 카드는 자신の손패とフィールドにカードがない場合、상대の攻撃時にＥＸ덱か묘지より現れる奇跡の龍！」
			RESETCOLOR
		ENDIF
		PRINTFORMW 「宇宙創造の鍵、今こそ闇の扉を開き、未来を、その咆哮とともに導け！
		PRINTFORMW 　降臨せよ、Ｎｏ.１００ ヌメロン・ドラゴン！」
	ELSEIF カードID == 51620 && 효과종류 == 필드起動
		PRINTFORMW 「自身の攻撃力を、상대턴 종료시 까지 倍にする！」

	ELSE
		SELECTCASE RAND:2 + 1
			CASE 2			
				PRINTFORMW 「いっけぇ！！　%カード名%！」
			CASE 1
				PRINTFORMW 「これでどうだぁ！！」
		ENDSELECT
	ENDIF
ENDIF

