;カードID == (カードの番号)　でそのカード専用の구상が流せる
;カード番号は 10.デュエル関連/02.CARDS 内に入っているため、必要に応じて参照するように
;例：
;		IF カードID == 1000
;			PRINTFORMW 「ブラックマジシャンガールを소환！」
;		ENDIF

;==================================================
;0,デュエルスタート！
;==================================================
@M_KOJO_DUEL_K2236_0(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「それではデュエル開始です」
		CASE 2
			PRINTFORMW 「僭越ながらお상대させていただきます」
		CASE 3
			PRINTFORMW 「星辰の力をお見せしましょう」
	ENDSELECT
ENDIF

;==================================================
;1,モンスター소환
;例：%カード名%を소환！
;==================================================
@M_KOJO_DUEL_K2236_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF カードID == 2236
		PRINTFORMW 「星辰よ我が道を導け！」
		PRINTFORMW 「私自身を소환！」
	ELSEIF カードID == 2235
		PRINTFORMW 「星辰よ我らの道を導け！」
		PRINTFORMW 「星辰槍手ルキアスを소환！」
		PRINTFORMW 「貴方の力を見せてあげなさいルキアス」
	ELSEIF カードID == 2236
		PRINTFORMW 「星辰よ我らの道を導け！」
		PRINTFORMW 「星辰篭手プリクルを소환！」
		PRINTFORMW 「プリクル今回も頼むわね」
	ELSE
		SELECTCASE RAND:2 + 1
		CASE 1
			PRINTFORMW 「それでは%カード名%を소환」
		CASE 2
			PRINTFORMW 「我が元へ現れよ！」
			PRINTFORMW 「%カード名%소환！」
		ENDSELECT
	ENDIF
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_KOJO_DUEL_K2236_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF カードID == 2236
		PRINTFORMW 「星辰よ我が道を導け！」
		PRINTFORMW 「私自身を소환！」
	ELSEIF カードID == 2235
		PRINTFORMW 「星辰よ我らの道を導け！」
		PRINTFORMW 「星辰槍手ルキアスを소환！」
		PRINTFORMW 「貴方の力を見せてあげなさいルキアス」
	ELSEIF カードID == 2236
		PRINTFORMW 「星辰よ我らの道を導け！」
		PRINTFORMW 「星辰篭手プリクルを소환！」
		PRINTFORMW 「プリクル今回も頼むわね」
	ELSE
		SELECTCASE 소환出処
			;손패から
			CASE 召種손패
				PRINTFORMW 「では、손패から%カード名%を특수소환！」
			;마법함정ゾーンから。　キリ番・シェイプシスターなどを出す場合
			CASE 召種마함
				PRINTFORMW 「こちらからも소환できるのですよ」
				PRINTFORMW 「%カード名%を특수소환です」
			;덱から
			CASE 召種덱
				PRINTFORMW 「덱に眠る者を呼び起こしましょう」
				PRINTFORMW 「%カード名%を특수소환です」
			;EX덱から
			CASE 召種EX덱
				PRINTFORMW 「それではゲストをお呼びしましょう」
				PRINTFORMW 「%カード名%を특수소환です」
			;묘지から
			CASE 召種묘지
				PRINTFORMW 「묘지を活用するのも当然ですね」
				PRINTFORMW 「%カード名%を특수소환です」
			;제외状態から
			CASE 召種제외
				PRINTFORMW 「제외されたからといっても安心できませんよ」
				PRINTFORMW 「%カード名%を특수소환です」
			;主にトークン生成
			CASE 10
				PRINTFORMW 「トークンを生成しましょう」
		ENDSELECT
	ENDIF
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K2236_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORMW 「我が의식をお見せしましょう」
			PRINTFORMW 「의식소환！　貫け%カード名%！」
		CASE 융합
			IF GROUPMATCH(カードID,42335,42336,42337)
			PRINTFORMW 「星辰が導くは、交わりし竜魔の煌めき！」
			PRINTFORMW 「今ここに降臨せよ！　%カード名%」
			ELSE
			PRINTFORMW 「융합소환！　力を見せつけよ%カード名%！」
			ENDIF
		CASE 싱크로
			PRINTFORMW 「星辰が導く道を疾走せよ！」
			PRINTFORMW 「싱크로소환！　轟け%カード名%！」
		CASE 엑시즈
			PRINTFORMW 「オーバレイネットワークを構築　星辰交わりて現れよ！」
			PRINTFORMW 「엑시즈소환！　唸れ%カード名%！」
		CASE 링크
			PRINTFORMW 「現れよ　星辰が導くサーキット！」
			PRINTFORMW 「モンスターを링크マーカーにセット」
			PRINTFORMW 「링크소환！　輝け%カード名%！」
		;초차원モンスター（デュエマ）
		CASE 초차원
			PRINTFORMW 
	ENDSELECT
ENDIF

;==================================================
;4,효과使用宣言
;==================================================
@M_KOJO_DUEL_K2236_4(カードID,발동出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC 발동出処
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 발동出処
		CASE 1
			;손패발동
			IF カードID == 2236
				PRINTFORMW 「손패の私を묘지へ置く효과を발동」
				PRINTFORMW 「それでは我らの真価お見せしましょう！」
			ELSE
				PRINTFORMW 「손패から%カード名%の효과を발동」
			ENDIF
		CASE 2
			;필드발동
			IF カードID == 2235
				PRINTFORMW 「フィールドのルキアスの효과を발동」
				PRINTFORMW 「덱から我らの仲間を손패に加えます」
			ELSEIF カードID == 2237
				PRINTFORMW 「フィールドのプリクルの효과を발동」
				PRINTFORMW 「묘지の我らの仲間を再びフィールドに呼び戻します」
			ELSE
				PRINTFORMW 「フィールドの%カード名%の효과を발동」
			ENDIF
		CASE 3
			;마함발동
			IF カードID == 62235
				PRINTFORMW 「我が魔術お見せしましょう！」
				PRINTFORMW 「발동せよ！計都星辰」
			ELSEIF カードID == 62236
				PRINTFORMW 「我が魔術お見せしましょう！」
				PRINTFORMW 「羅睺星辰　竜魔の煌めきをその目に焼きつけよ！」
			ELSE
				PRINTFORMW 「それでは%カード名%발동です」
			ENDIF
		CASE 4
			;묘지발동
			IF GROUPMATCH(カードID,2235,2236,2237,21175,21176,21177)
				PRINTFORMW 「我らドラゴンテイルが융합素材として묘지へ送られたときの효과を발동」
			ELSE
				PRINTFORMW 「묘지の%カード名%の효과を발동」
			ENDIF
	ENDSELECT
ENDIF



