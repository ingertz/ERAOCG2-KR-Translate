LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE ダメージ量
		;ダメージなし
		CASE 0
			PRINTFORMW 「ダメージはなしですね」
		;１～１９９９の時、小ダメージ
		CASE 1 TO 1999
			PRINTFORMW 「この程度なら！」
		;２０００～３９９９の時、結構なダメージ
		CASE 2000 TO 3999
			PRINTFORMW 「くっ！　中々に重い攻撃！」
		;４０００～７９９９の時、超大ダメージ
		CASE 4000 TO 7999
			PRINTFORMW 「くぅぅ！　諦めるわけには…」
		;８０００以上、基本即死
		CASEELSE
			PRINTFORMW 「きゃあぁぁぁ！」
	ENDSELECT
ENDIF


