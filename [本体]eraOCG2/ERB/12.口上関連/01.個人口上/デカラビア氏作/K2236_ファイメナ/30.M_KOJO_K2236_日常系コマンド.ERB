;==================================================
;300,会話
;TFLAG:SELECTCOM분기(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより교양が4以上高い)
;TCVAR:302(0=会話可能 1=非연모時会話不能)
;MARK:반발각인(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;CFLAG:우후후(조교中の会話)
;CFLAG:변기화(肉便器の時の会話)
;==================================================
@M_KOJO_SUCCESS_COM_K2236_300
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K2236_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で구상色が付きません。
CALL TRAIN_MESSAGE
;구상メイン呼出
CALL M_KOJO_MESSAGE_COM_K2236_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2236_300_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;호감도修正、通常（연모系陥落なし）で５
	호감도修正 = 5
	;TARGETが【애처】だったら호감도修正に＋２
	SIF TALENT:TARGET:애처
		호감도修正 += 2
	;TARGETが【親愛】だったら호감도修正に＋２
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	;TARGETが【연모】を得ていたら호감도修正に＋１
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	;「RAND:n」n面ダイスを振る
	;우후후中の会話
	IF CFLAG:TARGET:우후후
		SELECTCASE RAND:3 + 1
			CASE 1
				PRINTFORMW 「ふふ❤気持ちいいですかマスター❤」
			CASE 2
				PRINTFORMW 「マスター　愛してます」
			CASE 3
				PRINTFORMW 「ん❤もっとしたいですか❤」
		ENDSELECT
	;日常会話
	ELSE
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORMW ファイメナは難しそうな本を読んでいる
			CASE 2
				PRINTFORMW 「マスターどうかされましたか」
			CASE 3
				PRINTFORMW 「尻尾気になりますか？」
			CASE 4
				PRINTFORMW 「先日ルキアスと模擬戦をしたのですが動きが直線的ですぐに終わってしまいました」
				PRINTFORMW 「もちろん、私の勝ちです」
			CASE 5
				PRINTFORMW 「よろしければマスターも魔術学んでみませんか」
				PRINTFORMW 「覚えていれば何かの役に立つと思います」
			CASE 6
				PRINTFORMW 「デュエルするのもいいですが、日常生活を疎かにしないでください」
			CASE 7
				PRINTFORMW 「先日、マギストスの方たちと話す機会があったのですが彼らの魔術と私たちの魔術は色々と違うようです」
			;연모
			CASE 8
				PRINTFORMW 「マスター　ふふ、呼んだだけですよ」
			CASE 9
				PRINTFORMW 「マスター今日の予定は大丈夫ですか　はい、言っていただければいつでもお手伝いさせていただきます」
			;親愛
			CASE 10
				PRINTFORMW 「わたしはいつまでも貴方に尽くします　貴方のその命が尽きる時まで…」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
