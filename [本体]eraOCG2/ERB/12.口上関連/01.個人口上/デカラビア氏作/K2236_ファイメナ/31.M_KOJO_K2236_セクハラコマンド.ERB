			호감도修正 += 1
		SIF TALENT:TARGET:연모 == 2
			호감도修正 += 1
		SIF TALENT:TARGET:연모 >= 1
			호감도修正 += 0
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORMW 
			CASE 2
				PRINTFORMW 
			CASE 3
				PRINTFORMW 
			;연모
			CASE 4
				PRINTFORMW 
			;親愛
			CASE 5
				PRINTFORMW 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
