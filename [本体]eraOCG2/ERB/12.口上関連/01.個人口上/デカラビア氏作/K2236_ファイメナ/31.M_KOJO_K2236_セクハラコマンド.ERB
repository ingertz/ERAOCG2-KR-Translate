#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;ファースト키스
		IF EXP:TARGET:Ｍ경험 == 1 && EXP:TARGET:펠라경험 == 0 && NAME:(CFLAG:TARGET:키스상실상대) == NAME:MASTER
			PRINTFORMW 
		;それ以外
		ELSE
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 5
	SIF TALENT:TARGET:애처
		호감도修正 += 1
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	;ファースト키스
	IF EXP:TARGET:키스경험 == 1 && EXP:TARGET:펠라경험 == 0
		PRINTFORMW 「……」
		PRINTFORMW 
		PRINTFORMW 唇が離れてからファイメナがしばらく微動だにしない
		PRINTFORMW 
		PRINTFORMW 「いえ、その嬉しすぎて固まってしまっただけです」
		PRINTFORMW 「その…もう一度してもらってもいいですか」
		PRINTFORMW 
		PRINTFORMW 心配したが大丈夫なようだ
		PRINTFORMW ファイメナの希望通りにもう一度深く키스をした
	ELSE
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORMW 「マスター突然どうしたのですか」
			CASE 2
				PRINTFORMW 「ん…いえ、拒みはしませんよ」
			CASE 3
				PRINTFORMW 「マスター❤…いえ、なんでもありません」
			CASE 4
				PRINTFORMW 「ん…あまりからかわないでください」
			CASE 5
				PRINTFORMW 「もっとしてもいいですよ❤」
			;연모
			CASE 6
				PRINTFORMW 「マスター❤…足りませんもっとしてください」
			CASE 7
				PRINTFORMW 「ちゅっ…ちゅっ…もっとしましょ❤」
			;親愛
			CASE 8
				PRINTFORMW 「好き❤好き❤好きです❤」
			CASE 9
				PRINTFORMW 「マスター❤マスター❤…愛しています❤」
			;애처
			CASE 10
				PRINTFORMW 「ちゅっ❤ちゅっ❤…ふふ、貴方と키스をするだけで幸せが溢れてきます❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
