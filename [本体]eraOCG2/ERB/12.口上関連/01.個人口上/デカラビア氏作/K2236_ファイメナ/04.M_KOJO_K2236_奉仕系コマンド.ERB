;==================================================
;80,수음
;==================================================
@M_KOJO_MESSAGE_COM_K2236_80
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2236_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2236_80_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「手でのご奉仕ですね　わかりました」
		PRINTFORMW 「痛かったら言ってくださいね」
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「ふむ、結構難しいものですね」
		CASE 2
			PRINTFORMW 「マスター気持ちいいですか？」
		CASE 3
			PRINTFORMW 「あっいまびくってしましたね　ならこのまま続けますね」
		CASE 4
			PRINTFORMW 「しーこ❤しーこ❤いいですよ❤いっぱい사정してください❤」
		CASE 5
			PRINTFORMW 「しこ❤しこ❤いっぱいピュッピュッしていいですよ❤」
	ENDSELECT
ENDIF
RETURN 1

;==================================================
;81,펠라치오
;==================================================
@M_KOJO_MESSAGE_COM_K2236_81
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2236_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2236_81_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;ファースト키스
		IF EXP:TARGET:Ｍ경험 == 0 && EXP:TARGET:펠라경험 == 1 && CALLNAME:(CFLAG:TARGET:키스상실상대) == CALLNAME:MASTER
			PRINTFORMW 「はぁまさか唇ではなくこちらにファースト키스をするとは思いませんでした」
		;それ以外
		ELSE
			PRINTFORMW 「口でのご奉仕　いわゆるオーラル섹스ですね」
			PRINTFORMW 「大丈夫です　初めてですが知識はありますので」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
		
	;お掃除펠라
	IF STAIN:MASTER:2 & 4 && ABL:TARGET:기교 >= 3
		PRINTFORMW 「それでは綺麗にしますね」
		PRINTFORMW 「れる❤れる❤ちゅっ❤…ふふ、綺麗になりましたね」

	;通常
	ELSE
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORMW 「んっ❤どうですか気持ちいいですか❤」
			CASE 2
				PRINTFORMW 「ちゅっ❤ちゅぱ❤マスターのものはご立派ですね」
			CASE 3
				PRINTFORMW 「んっ❤れろ❤れろ❤もっと気持ちよくなってください」
			CASE 4
				PRINTFORMW 「ちゅっ❤れる❤れろ❤いいですよ❤いっぱい사정して❤」
			CASE 5
				PRINTFORMW 「じゅるるぅ❤じゅっぽ❤じゅっぽ❤マスターのおちんぽ❤美味しい❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

