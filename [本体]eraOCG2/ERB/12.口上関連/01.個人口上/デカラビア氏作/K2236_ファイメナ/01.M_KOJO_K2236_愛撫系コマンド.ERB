@M_KOJO_MESSAGE_COM_K2236_0_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「マスターの手が私に…」
		PRINTFORMW 「いえ、嫌ではないですむしろマスターに弄ってもらえて嬉しいのです」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;삽입中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V삽입
	IF LOCAL:1 && TEQUIP:50 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			PRINTFORMW 「ん❤　ふふ、イッてしまいましたか」
			RETURN 1
		ELSE
			PRINTFORMW 「삽입しながら同時なんて❤　ダメぇ❤」
			RETURN 1
		ENDIF
	;A삽입
	ELSEIF LOCAL:1 && TEQUIP:51 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			PRINTFORMW 「ん❤　ふふ、イッてしまいましたか」
			RETURN 1
		ELSE
			PRINTFORMW 「お尻に入れたまま弄るのは刺激が❤」
			RETURN 1
		ENDIF
	ENDIF

	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 1
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「あまり強くしないでくださいね」
		CASE 2
			PRINTFORMW 「そこ気持ちいいです」
		CASE 3
			PRINTFORMW 「ん❤　もっとしてください❤」
		;연모
		CASE 4
			PRINTFORMW 「あぁ❤マスター上手いです❤」
		CASE 5
			PRINTFORMW 「あっ❤そこ❤もっとお願いします」
		;親愛
		CASE 6
			PRINTFORMW 「んん❤すごい❤イッてしまいそう❤」
		CASE 7
			PRINTFORMW 「はぁ❤もうだめぇ❤マスター❤イかせてください❤」
		;애처
		CASE 8
			PRINTFORMW 「旦那様❤もっと欲しいです❤」
			PRINTFORMW 「愛しい貴方にもっと❤もっと❤愛してもらいたいです❤」
	ENDSELECT
ENDIF
RETURN 1
