	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
	;만족したところを押し倒された
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
	;壊れるまでしてあげる
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1


