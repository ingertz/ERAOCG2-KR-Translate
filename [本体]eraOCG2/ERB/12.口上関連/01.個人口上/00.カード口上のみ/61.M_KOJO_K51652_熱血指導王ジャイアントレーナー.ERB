;※※※※※※※※※※※※※※※※※※※※※※※※※
;CARD用구상
;※※※※※※※※※※※※※※※※※※※※※※※※※
;直接カードのIDを使える。
;캐릭터が無くても動く
;存在証明
@M_KOJO_CARD_K51652
RETURN 1
;==================================================
;0,モンスター소환時
;==================================================
@M_KOJO_CARD_K51652_0(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORM "흥핫!!	
	SETCOLOR C_RED
	PRINT 여을혈지도
	SETCOLOR C_YELLOW
	PRINTFORMW 다아!!!"
ENDIF

;==================================================
;1,攻撃時
;==================================================
@M_KOJO_CARD_K51652_1(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORM "먹어라앗! 나의	
	SETCOLOR C_RED
	PRINT 여을혈지도
	SETCOLOR C_YELLOW
	PRINTFORMW 를읏!!"
ENDIF

;==================================================
;2,효과발동
;==================================================
;효과別で鳴らしたいなら、直接カードのデータを見て、설정する必要がある
;面倒、分からないであれば분기はせず
;失敗판정は、いわゆる효과를 無効にされたとかそういうやつ
@M_KOJO_CARD_K51652_2(종류,失敗판정)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 종류
#DIM DYNAMIC 失敗판정
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 失敗판정 == 0
		IF 종류 == 필드起動
			SELECTCASE RAND:3
			CASE 0
				PRINTFORM "자아
				SETCOLOR C_RED
				PRINT 여을혈지도
				SETCOLOR C_YELLOW
				PRINTFORMW 의 시작이다아! 먹어라 800의 데미지를!!"
			CASE 1
				PRINTFORM "나의				
				SETCOLOR C_RED
				PRINT 여을혈
				SETCOLOR C_YELLOW
				PRINTFORMW 효과발동으! 자아 먹어라 800의 데미지를!!"
			CASE 2
				PRINTFORM "
				SETCOLOR C_RED
				PRINT 여을혈지도
				SETCOLOR C_YELLOW
				PRINTFORMW 다아아!! 먹어라앗! 800의 데미지잇!!"
			ENDSELECT
		ELSE
		ENDIF
	ELSE
	ENDIF
ENDIF

;==================================================
;3,除去時
;==================================================
;いちいちなんでも除去で話すとやかましいため、デフォでは破壊にのみ反応するように설정
@M_KOJO_CARD_K51652_3(除去종류,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 除去종류
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 除去종류
		CASE 破壊行き,戦闘破壊行き
			PRINTFORM "모처럼의 나의……	
			SETCOLOR C_RED
			PRINT 여을혈지도
			SETCOLOR C_YELLOW
			PRINTFORMW 를……"
	ENDSELECT
ENDIF

