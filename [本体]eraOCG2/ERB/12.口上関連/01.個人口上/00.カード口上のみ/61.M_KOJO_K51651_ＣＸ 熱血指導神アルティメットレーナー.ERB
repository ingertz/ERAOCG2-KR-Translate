;※※※※※※※※※※※※※※※※※※※※※※※※※
;CARD用구상
;※※※※※※※※※※※※※※※※※※※※※※※※※
;直接カードのIDを使える。
;캐릭터が無くても動く
;存在証明
@M_KOJO_CARD_K51651
RETURN 1
;==================================================
;0,モンスター소환時
;==================================================
@M_KOJO_CARD_K51651_0(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORM "진정한
	SETCOLOR C_RED
	PRINT 여을혈지도
	SETCOLOR C_YELLOW
	PRINTFORMW 의 시작이다아아!!"
ENDIF

;==================================================
;1,攻撃時
;==================================================
@M_KOJO_CARD_K51651_1(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORM "
	SETCOLOR C_RED
	PRINT 여을혈
	SETCOLOR C_YELLOW
	PRINTFORM 읏!!
	SETCOLOR C_RED
	PRINT 지도
	SETCOLOR C_YELLOW
	PRINTFORMW 다아앗!!!"
ENDIF

;==================================================
;2,효과발동
;==================================================
;효과別で鳴らしたいなら、直接カードのデータを見て、설정する必要がある
;面倒、分からないであれば분기はせず
;失敗판정は、いわゆる효과를 無効にされたとかそういうやつ
@M_KOJO_CARD_K51651_2(종류,失敗판정)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 종류
#DIM DYNAMIC 失敗판정
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 失敗판정 == 0
		IF 종류 == 필드起動
				PRINTFORM "받아라 진정한
				SETCOLOR C_RED
				PRINT 여을혈지도
				SETCOLOR C_YELLOW
				PRINTFORMW 를! 800의 데미지다앗!!"
		ELSE
		ENDIF
	ELSE
	ENDIF
ENDIF

;==================================================
;3,除去時
;==================================================
;いちいちなんでも除去で話すとやかましいため、デフォでは破壊にのみ反応するように설정
@M_KOJO_CARD_K51651_3(除去종류,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 除去종류
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 除去종류
		CASE 破壊行き,戦闘破壊行き
			PRINTFORM "훌륭해……
			SETCOLOR C_RED
			PRINT 여을혈
			SETCOLOR C_YELLOW
			PRINTFORMW 이다아아아!!!"
	ENDSELECT
ENDIF

