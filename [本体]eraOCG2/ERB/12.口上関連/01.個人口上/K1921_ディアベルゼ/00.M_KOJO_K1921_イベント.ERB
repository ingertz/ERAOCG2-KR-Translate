;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT"系이벤트
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================
@M_KOJO_EVENT_K1921_1(ARG,ARG:1)
;구상主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------
IF LOCAL
	;空行
	PRINTFORML
	;-------------------------------------------------
	;一日初めての挨拶분기（MAIN/お外どちらも）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG,1,2,6) && CFLAG:TARGET:인사했음 == 0
		PRINTFORMW 「おはよう、%CSTR:TARGET:MASCALL%」
		RETURN 1
	ENDIF

	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「あら、%CSTR:TARGET:MASCALL%」
		IF CFLAG:TARGET:현재위치 == CFLAG:(CFLAG:TARGET:1000):현재위치 && !CFLAG:TARGET:1010
			PRINTFORMW 「んん～？ ああ、少しびっくりしていたのよ～ こっちにディアベルスターがいたものだから…」
			PRINTFORMW 「あの子も呼ばれているなんてね～ あはっ♥ やっぱり%CSTR:TARGET:SELFCALL%達は運命の赤い糸で結ばれているのかしら～」
			CFLAG:TARGET:1010 = 1
			CFLAG:(CFLAG:TARGET:1000):1011 = 1
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;eraOCG2_V0.40_BT_240518時点では流れないため注意
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「あら、%CSTR:TARGET:MASCALL%」
		IF CFLAG:TARGET:현재위치 == CFLAG:(CFLAG:TARGET:1000):현재위치 && !CFLAG:TARGET:1010
			PRINTFORMW 「あら？ あらあらあら～？ そこにいるのは…ディアベルスターじゃな～い」
			PRINTFORMW 「ふ～ん？ あなたもこっちに呼ばれていたのね？ あはっ！ ふふっ～ なんだか思ったよりも楽しいことになりそうじゃな～い」
			CFLAG:TARGET:1010 = 1
			CFLAG:(CFLAG:TARGET:1000):1011 = 1
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;eraOCG2_V0.40_BT_240518時点では流れないため注意
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「あら、%CSTR:TARGET:MASCALL%が入っていたのね…」
		PRINTFORMW 「ふふっ…せっかくだし、背中でも洗ってもらおうかしら？」
		IF CFLAG:TARGET:현재위치 == CFLAG:(CFLAG:TARGET:1000):현재위치 && !CFLAG:TARGET:1010
			PRINTFORMW 「あら？ あらあらあら～？ そこにいるのは…ディアベルスターじゃな～い」
			PRINTFORMW 「ふ～ん？ あなたもこっちに呼ばれていたのね？ …え？ どうしてあなたが%CSTR:TARGET:MASCALL%と一緒にお風呂に？ ん～？ んんっ…？」
			CFLAG:TARGET:1010 = 1
			CFLAG:(CFLAG:TARGET:1000):1011 = 1
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;eraOCG2_V0.40_BT_240518時点では流れないため注意
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 「あら、%CSTR:TARGET:MASCALL%が入っていたのね…」
		IF CFLAG:TARGET:현재위치 == CFLAG:(CFLAG:TARGET:1000):현재위치 && !CFLAG:TARGET:1010
			PRINTFORMW 「あら？ あらあらあら～？ そこにいるのは…ディアベルスターじゃな～い」
			PRINTFORMW 「ふ～ん？ あなたもこっちに呼ばれていたのね？ …え？ どうしてあなたが%CSTR:TARGET:MASCALL%と一緒にお風呂に？ ん～？ んんっ…？」
			CFLAG:TARGET:1010 = 1
			CFLAG:(CFLAG:TARGET:1000):1011 = 1
		ELSE
			PRINTFORMW 「それなら%CSTR:TARGET:SELFCALL%はまた後で入るとしましょうか」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;未確認
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;eraOCG2_V0.40_BT_240522時点では流れないため注意
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORMW  
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他캐릭터と데이트중に遭遇した
	;eraOCG2_V0.40_BT_240522時点では流れないため注意
	;ARG:1にデート상대
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		PRINTFORMW  
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;朝起きたとき（おはよう구상）
;==================================================
@M_KOJO_EVENT_K1921_2(ARG,ARG:1)
;구상主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------
IF LOCAL
	;空行
	PRINTFORML
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;MASTERが起きていて、상대가 起きてきた（いつでも）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORMW 「ふふっ…%CSTR:TARGET:MASCALL%の顔を寝起きでみられるなんてね…」
		IF CFLAG:TARGET:시작위치 == CFLAG:(CFLAG:TARGET:1000):시작위치 && CFLAG:TARGET:1010
			PRINTFORMW 「つ、い、で、に…♥ ディアベルスターの顔を見られたのも、悪くはないかも～？」
		ENDIF
		PRINTFORMW 「まあ、少しは良い目覚めになったかしら…」
		RETURN 1
	ENDIF
	;非同棲かつ상대가 先に起きてる
	;20250310現在、流れる상황は無い
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「ふふっ…♥ おはよう、%CSTR:TARGET:MASCALL%…♥ 朝から元気そうで何よりだわ…♥」
		IF CFLAG:TARGET:시작위치 == CFLAG:(CFLAG:TARGET:1000):시작위치 && CFLAG:TARGET:1010
			PRINTFORMW 「ディアベルスター、あなたはどうかしら～？ ま、あなたは감기なんて引かないかも～？」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;朝に성교
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「んん～♥ 朝の目覚めは良好そうかしら～？ それで…続きはどうするのかしら？ なんて聞くまでもないわよね…♥」
		IF CFLAG:TARGET:시작위치 == CFLAG:(CFLAG:TARGET:1000):시작위치 && CFLAG:TARGET:1010
			PRINTFORMW 「ディアベルスター？ あなたも準備はいいわよね～？ あはっ♥ 一緒にいくわよ～♥」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;상대가 寝ている
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「すー…すー…」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが起きていて、상대가 起きてきた（朝のみ）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 「おはよう、%CSTR:TARGET:MASCALL%」
		PRINTFORMW 「朝は弱いのよね…ふわぁ…%CSTR:TARGET:MASCALL%は元気かしら？」
		IF CFLAG:TARGET:시작위치 == CFLAG:(CFLAG:TARGET:1000):시작위치 && CFLAG:TARGET:1010
			PRINTFORMW 「ディアベルスター、あなたはどうかしら～？ ま、あなたは감기なんて引かないかも～？」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;상대가 起きてきて、MASTERが감기気味（朝のみ）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORMW 「あら、%CSTR:TARGET:MASCALL%…顔色が悪いわね」
		PRINTFORMW 「감기には気を付けなければ駄目よ…しばらく横になっていなさい」
		IF CFLAG:TARGET:시작위치 == CFLAG:(CFLAG:TARGET:1000):시작위치 && CFLAG:TARGET:1010
			PRINTFORMW 「ディアベルスター？ あなたも看病を手伝いなさ～い」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;夜寝るとき（おやすみ구상）
;==================================================
@M_KOJO_EVENT_K1921_3(ARG,ARG:1)
;구상主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;自室に帰って寝る（～は【現在地】から【캐릭터の自室】に戻りました）
