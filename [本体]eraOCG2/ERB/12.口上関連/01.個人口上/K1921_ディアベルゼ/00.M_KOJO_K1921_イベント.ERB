		ELSE
			PRINTFORMW 「そろそろ帰ろうかしら…おやすみなさい、%CSTR:TARGET:MASCALL%」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;수면中（～は眠っている）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「すー…すー…」
		RETURN 1
