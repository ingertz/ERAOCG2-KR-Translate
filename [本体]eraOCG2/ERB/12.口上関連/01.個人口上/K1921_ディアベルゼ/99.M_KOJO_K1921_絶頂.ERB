;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;분기作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:절정
;4以上で昇天、3で超強절정、2で強절정、1で절정

;NOWEX:Ｃ절정 NOWEX:Ｖ절정 NOWEX:Ｂ절정 NOWEX:Ａ절정 NOWEX:Ｍ절정
;各部位の절정

;NOWEX:二重절정、NOWEX:三重절정、NOWEX:四重절정、NOWEX:五重절정
;同時に절정した時の状態
;上記五つに加えてNOWEX:Ｅ절정でも판정

;TOTALEX
;地の文の판정に使われているもの
;5以上で潮を吹き、4以下で背中を反らせて절정する
;詳しくはEVENT_MESSAAGE_ORGASMを参照

;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが삽입中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが삽입中となる。
;NOWEX:사정
;사정量、最大3。たとえばIF NOWEX:MASTER:사정 > 1だと、あなたが大量사정以上した場合となる。

;-------------------------------------------------
;절정時の구상
;-------------------------------------------------
@M_KOJO_MESSAGE_PALAMCNG_B_K1921(ARG)
#DIM TOTALEX
#DIM DYNAMIC 호감도修正
CALL PALAM_MESSAGE_B(ARG)
TOTALEX =  NOWEX:ARG:Ｃ절정 + NOWEX:ARG:Ｖ절정 + NOWEX:ARG:Ａ절정 + NOWEX:ARG:Ｂ절정+ NOWEX:ARG:Ｍ절정 + NOWEX:ARG:Ｅ절정 + NOWEX:ARG:분유 + NOWEX:ARG:사정
SIF !(TOTALEX + NOWEX:ARG:방뇨)
	RETURN 0
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;분유
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:분유
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;사정した
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:사정
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;방뇨
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:방뇨
		PRINTFORMW 
		RETURN 1
	ENDIF

	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;ここを記入した場合、これより下は流れない
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1
		RETURN 1
	ENDIF
	SETCOLOR C_H_PINK
	;基本セット
	SELECTCASE NOWEX:ARG:절정
		;절정
		CASE 1
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖ섹스 == MASTER
					PRINTFORML 「んあっ…♥ うんっ…♥ あはっ…♥ 吹き出しちゃってる…♥  んんっ～♥ %CSTR:ARG:MASCALL%にもかかちゃってるわね…♥」
					PRINTFORMW 「ごめんなさい…♥ でも止まらないの…♥ あはっ…♥ おまんこ…♥ 反応しちゃってる…♥ あははっ…♥」
				ELSE
					PRINTFORMW 「んあっ…♥ うんっ…♥ あはっ…♥ 吹き出しちゃってる…♥  んんっ～♥ だめぇ♥ 止まらない…♥ イくの…♥ 止まらないぃ…♥」
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 「んあっ…♥ うんっ…♥ あはっ…♥ イっちゃったじゃな～い…♥ んんっ～♥ なんだか少し恥ずかしいかも～♥ あはっ…♥ はあっ…♥」
				ELSE
					PRINTFORMW 「んあっ…♥ うんっ…♥ あはっ…♥ イっちゃったじゃな～い…♥ んんっ～♥ なんだか少し恥ずかしいかも～♥」
				ENDIF
			ENDIF
		;強절정
		CASE 2
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖ섹스 == MASTER
					PRINTFORML 「んんっ…♥ んんっ～…♥ ああっ…♥ あんっ…♥ あはっ…♥ 吹き出してる…♥ あはっ…♥ %CSTR:ARG:MASCALL%に…♥ しお…♥ かけちゃってる…♥」
					PRINTFORMW 「んふっ…♥ 止まらにゃい…♥ でも…♥ %CSTR:ARG:MASCALL%のせいだし…♥ 許して頂戴ね…♥ あはっ…♥ あはははっ♥」
				ELSE
					PRINTFORMW 「んんっ…♥ んんっ～…♥ ああっ…♥ あんっ…♥ あはっ…♥ 吹き出してる…♥ あはっ…♥ 止まらにゃい…♥ 震えて潮吹く…♥ 吹いちゃってるぅ…♥」
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 「んんっ…♥ んんっ～…♥ ああっ…♥ あんっ…♥ あはっ…♥ 今のは…♥ 少しきいたかも…♥ あはっ…♥ 体震えたぁ…♥ んんっ…♥ あはっ…♥」
				ELSE
					PRINTFORMW 「んんっ…♥ んんっ～…♥ ああっ…♥ あんっ…♥ あはっ…♥ 今のは…♥ 少しきいたかも…♥ あはっ…♥ 体震えちゃったわ～…♥」
				ENDIF
			ENDIF
		;超強절정
		CASE 3
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖ섹스 == MASTER
					PRINTFORML 「んはっ…♥ あうっ…♥ あがっ…♥ おごっ…♥ ふふっ…♥ 潮止まらにゃい…♥ あはっ…♥ %CSTR:ARG:MASCALL%…♥ かかちゃってるわね～♥」
					PRINTFORMW 「あひゃっ…♥ もっと浴びなしゃい…♥ %CSTR:ARG:SELFCALL%の潮…♥ %CSTR:ARG:MASCALL%に愛された証…♥ あはっ…♥ あはははっ♥」
				ELSE
					PRINTFORMW 「んはっ…♥ あうっ…♥ あがっ…♥ おごっ…♥ ふふっ…♥ 潮止まらにゃい…♥ あはっ…♥ 震えしゅごしゅぎっ…♥ イくの終わらにゃい…♥」
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 「んはっ…♥ あうっ…♥ あがっ…♥ おごっ…♥ ふふっ…♥ これしゅごい…♥ しゅごしゅぎ…♥ あはっ…♥ 体…♥ 震えしゅごしゅぎ…♥ あはっ…♥ はぁ…♥」
				ELSE
					PRINTFORMW 「んはっ…♥ あうっ…♥ あがっ…♥ おごっ…♥ ふふっ…♥ これしゅごい…♥ しゅごしゅぎ…♥ あはっ…♥ 体…♥ すごい震えちゃったぁ…♥」
				ENDIF
			ENDIF
		;昇天
		CASE 4 TO 5
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖ섹스 == MASTER
					PRINTFORML 「あがっ…♥ うふっ…♥ おごっ…♥ あははっ…♥ これ…♥ しゅごしゅぎ…♥ あはぁぁうっ♥ しお…♥ びゅっ♥ びゅって…♥」
					PRINTFORMW 「あひゃっ…♥ %CSTR:ARG:MASCALL%に潮…♥ かけるのぉ…♥ 繋がったまま…♥ しおふいてイくの…♥ 幸せ…♥ あひゃっ…♥」
				ELSE
					PRINTFORML 「あがっ…♥ うふっ…♥ おごっ…♥ あははっ…♥ これ…♥ しゅごしゅぎ…♥ あはぁぁうっ♥ しお…♥ びゅっ♥ びゅって…♥」
					PRINTFORMW 「あひゃっ…♥ 震えしゅご…♥ じゅっとイってりゅ…♥ あはっ…♥  幸せ…♥ しゅごい…♥ イくの終わらにゃい…♥」
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 「あがっ…♥ うふっ…♥ おごっ…♥ あははっ…♥ これ…♥ しゅごしゅぎ…♥ あはぁぁうっ♥ あはははっ…♥ ふるえ…♥ ぶるんって…♥ あひゃ…♥ はあ…♥」
				ELSE
					PRINTFORMW 「あがっ…♥ うふっ…♥ おごっ…♥ あははっ…♥ これ…♥ しゅごしゅぎ…♥ あはぁぁうっ♥ あはははっ…♥ ふるえ…♥ ぶるんって…♥」
				ENDIF
			ENDIF
	ENDSELECT
	RESETCOLOR
ENDIF
RETURN 1

