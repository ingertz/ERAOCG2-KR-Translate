;300,会話
;TFLAG:SELECTCOM분기(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより교양が4以上高い)
;TCVAR:302(0=会話可能 1=非연모時会話不能)
;MARK:반발각인(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;CFLAG:우후후(조교中の会話)
;CFLAG:변기화(肉便器の時の会話)
;==================================================
@M_KOJO_SUCCESS_COM_K1921_300
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K1921_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で구상色が付きません。
CALL TRAIN_MESSAGE
;구상メイン呼出
CALL M_KOJO_MESSAGE_COM_K1921_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1921_300_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;호감도修正、通常（연모系陥落なし）で５
	호감도修正 = 5
	;TARGETが【애처】だったら호감도修正に＋２
	SIF TALENT:TARGET:애처
		호감도修正 += 2
	;TARGETが【親愛】だったら호감도修正に＋２
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	;TARGETが【연모】を得ていたら호감도修正に＋１
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	;「RAND:n」n面ダイスを振る
	;우후후中の会話
	IF CFLAG:TARGET:우후후
		SELECTCASE RAND:3 + 1
			CASE 1
				PRINTFORMW 「%CSTR:TARGET:MASCALL%…♥ %CSTR:TARGET:MASCALL%…♥ ふふっ…♥」
			CASE 2
				PRINTFORMW 「ふふっ…♥ こんな時でも…♥ まったりするのは悪くないものね～♥」
			CASE 3
				PRINTFORMW 「あはっ…♥ こんな時に何を話しているのかしらね%CSTR:TARGET:SELFCALL%達は…♥」
		ENDSELECT
	;日常会話
	ELSE
		SELECTCASE TFLAG:SELECTCOM분기
			CASE -1,-2
				PRINTFORMW 「ふぅん…ああ、ごめんなさい 少し考えごとをしていたわ～」
			CASEELSE
				SELECTCASE RAND:8 + 1
				CASE 1
					PRINTFORMW 「%CSTR:TARGET:MASCALL%…暇だわ～ 何か面白いことでもないかしら？」
				CASE 2
					PRINTFORMW 「アステーリャ、懐かしい名前だわ～ もうあの子をそう呼ぶこともないのかしらね～？」
				CASE 3
					PRINTFORMW 「リゼット…昔の%CSTR:TARGET:SELFCALL%ね 今考えると、幼稚だったものだわ…」
				CASE 4
					IF CFLAG:TARGET:현재위치 == CFLAG:(CFLAG:TARGET:1000):현재위치 && CFLAG:TARGET:1010
						PRINTFORMW 「ディアベルスターと%CSTR:TARGET:SELFCALL%は…♥ 運命の赤い糸で結ばれているのよ～♥ あはっ♥ こっちの世界でも一緒なのだからそうよね～♥」
						PRINTFORMW 「ふふっ～♥ 本人は不服そうにしているけれど～あれは、素直じゃないからよ～？ もう、あの子は本当に子供よね～♥ あはっ♥ あははっ♥」
					ELSE
						PRINTFORMW 「ディアベルスターとの関係は、あまり聞かないで頂戴 複雑なものなのよ」
					ENDIF
				CASE 5
					PRINTFORMW 「シルヴィはいつも狼たちを連れていたわね～ ふふっ…本人も少し狼ぽかったかしら？」
				CASE 6
					PRINTFORMW 「ルシア…口うるさい子だったわね～ 今では少し懐かしく思えるけれど」
				CASE 7
					PRINTFORMW 「先生は、優しい人だったわ ちょっと抜けてる所もあったけれど」
				CASE 8
					PRINTFORMW 「%CSTR:TARGET:SELFCALL%に隠しごとなんてしない方がいいわよ？ 別に浮気していたって、咎めはしないから…ふふっ、本当よ？」
					IF 호감도修正 >= 7
						PRINTFORMW 「%CSTR:TARGET:SELFCALL%のことを見捨てないならいいわよ～♥ でももし見捨てたら…」
						SETCOLOR C_H_PINK
						PRINTFORMW 「殺しちゃうかも～♥」
						RESETCOLOR
						PRINTFORMW 「…な～んて♥ 冗談よ～♥」
					ENDIF
				ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
