;1,식스나인
;==================================================
@M_KOJO_MESSAGE_SCOM_K1921_1
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K1921_1_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K1921_1_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF

	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;ここを記入した場合、これより下は流れない
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1
		IF SELECTCOM == 3
			IF TEQUIP:TARGET:바이브
			ELSE
			ENDIF
		ELSEIF SELECTCOM == 5
			IF TEQUIP:TARGET:애널바이브
			ELSEIF TEQUIP:TARGET:애널비즈
			ELSEIF TEQUIP:TARGET:관장
			ELSEIF TEQUIP:TARGET:확장벌룬
			ELSEIF TEQUIP:TARGET:애널전극
			ELSE
				IF PALAM:TARGET:욕정 >= PALAMLV:3 && EXP:TARGET:Ａ경험 >= EXPLV:3
				ELSE
				ENDIF
			ENDIF
		ELSE
			IF NOWEX:MASTER:사정
				IF ABL:TARGET:기교 > 2 
					IF ABL:TARGET:정액중독 > 2
						PRINTFORMW 「ふふっ…♥ %CSTR:TARGET:MASCALL%…♥ お口でイきたいの～？ おまんこ味わないながら…♥ 存分に사정しなさい…♥ あはっ…♥ れろっ♥ れろっ♥ んふっ～…♥ んんっ…んぐっ♥」
					ELSE
						PRINTFORMW 「ふふっ…♥ %CSTR:TARGET:MASCALL%…♥ お口でイきたいの～？ おまんこ味わないながら…♥ 存分に사정しなさい…♥ あはっ…♥ れろっ♥ れろっ♥ んふっ～…♥」
					ENDIF
				ELSE
					PRINTFORMW 「ふふっ…♥ %CSTR:TARGET:MASCALL%…♥ お口でイきたいのかしら～？ おまんこ味わないながら…♥ 存分に사정しなさい…♥ あはっ…♥ れろっ♥ れろっ♥ んふっ～…♥」
				ENDIF
			ELSE
				PRINTFORMW 「れろっ…♥ れろっ…♥ んんっ…♥ ふふっ…♥ お互いに気持ち良くさせ合うなんて…♥ なんだか少し気恥しいわね～♥」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF

	;基本セット
	;연모
	IF TALENT:연모
		PRINTFORMW 
		RETURN 1

	;それ以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K1921_{SELECTCOM}_1
RETURN 1

