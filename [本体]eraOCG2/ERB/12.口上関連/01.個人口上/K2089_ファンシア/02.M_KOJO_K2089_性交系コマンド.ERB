;※※※※※※※※※※※※※※※※※※※※※※※※※
;성교系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;全て *삽입をする時* の구상のため、気持ちいい所を抉ったり、子宮を潰したい時は派生コマンドへ
;Ａ系は派生しないため、삽입継続で喘がせるといい感じになる
;==================================================
;60,정상위
;==================================================
@M_KOJO_MESSAGE_COM_K2089_60
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2089_60_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2089_60_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;정상위
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;처녀
		IF TCVAR:파과 == 1
			CALL M_KOJO_MESSAGE_COM_K2089_SHOJO_BREAK
			RETURN 1
		ELSE
			IF LOCAL:1 && FIRSTTIME(SELECTCOM)
				IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
					PRINTFORMW 「ん、……ちゃんと僕を、気持ちよくしてね？」
				ELSE
					PRINTFORMW 「……うん、顔が見えるとまだ、安心できるね……」
				ENDIF
				RETURN 1
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;삽입継続
	;삽입したままこの体位に切り替える
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:V삽입관리플래그 == MASTER
		;前回사정した
		IF TCVAR:질내사정플래그 
			CALL M_KOJO_MESSAGE_COM_K2089_SEXCHANGE_2
			RETURN 1
		ELSE
			CALL M_KOJO_MESSAGE_COM_K2089_SEXCHANGE_1
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 0
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 0
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「にひっ♪　%CSTR:TARGET:MASCALL%の顔、気持ちよさそうだよ……？　僕も、おんなじ顔、してるのかな……❤」
			ELSE
				PRINTFORMW 「……こっちの顔、みないでよぉ。その、恥ずかしいんだって……！」
			ENDIF
		CASE 2
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「うん♪　手、ぎゅってしてよ❤　離れられないぐらい、強くして……❤」
			ELSE
				PRINTFORMW 「……やっ、手、握られたら、僕、逃げれな……！」
				PRINTFORMW 「……ごめん、動揺した。うん、いいよ、どうぞ……！」
			ENDIF
		CASE 3
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「……顔、みないでほしいな……僕、ぜったいヘンな顔、してるから……❤」
			ELSE
				PRINTFORMW 「……くぅ、だらしのない顔して……！　そ、そんなに僕のナカ、いいの……？」
			ENDIF
	ENDSELECT
ENDIF
RETURN 1

