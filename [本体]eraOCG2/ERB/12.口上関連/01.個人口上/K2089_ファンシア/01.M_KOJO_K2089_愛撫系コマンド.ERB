@M_KOJO_MESSAGE_COM_K2089_0_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
			PRINTFORMW 「ん、……ちゃんと僕を、気持ちよくしてね？」
		ELSE
			PRINTFORMW 「……あははっ、くすぐったいよっ♪」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;삽입中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V삽입
	IF LOCAL:1 && TEQUIP:50 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「もう、そんなに触らなくても感じてるよ……僕の、中に。君の、精子……❤」
					CASE 1
						PRINTFORMW 「ニシシ、もう……そんなに僕を火照らせて、どうしたいのさ……❤」
					CASE 2
						PRINTFORMW 「あ、こらっ、イジらないでよっ。%CSTR:TARGET:MASCALL%だって僕に사정して、お疲れなんじゃないの？　……にひっ❤」
				ENDSELECT
			ELSE
				PRINTFORMW 「そんなに、たしかめたいのかな……？　僕にだしたコト……」
			ENDIF
			RETURN 1
		ELSE
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「ちょ、まって……！　かお、近づけないでよ、汗臭いでしょ……？」
						PRINTFORMW 「こ、こら！　そこは汚くないよって気遣うところでしょうよぉ！？　……ぷっ、あははっ、もう❤」
					CASE 1
						PRINTFORMW 「んあっ❤　……あれ、どうしたのさ……？」
						PRINTFORMW 「あ、ひょっとして……腰振るのに疲れたんでしょ～。だから僕を触るふりして休憩して……きゃうん❤　こ、こら！　急につまむなぁ……！」
					CASE 2
						PRINTFORMW 「ダメだって……❤　腰振りながらさわんないで……❤　%CSTR:TARGET:MASCALL%に全身、むさぼられてるみたい、だからぁ……♪」
				ENDSELECT
			ELSE
				PRINTFORMW 「あ、ちょ……！　挿れながら、さわるなぁ……！」
			ENDIF
			RETURN 1
		ENDIF
	;A삽입
	ELSEIF LOCAL:1 && TEQUIP:51 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「もう、そんなに触らなくても感じてるよ……僕の、お腹に。君の、精子……❤」
					CASE 1
						PRINTFORMW 「にひっ、もう……もっと触ってよ、애널섹스、好きにさせてよ……❤」
					CASE 2
						PRINTFORMW 「あはは、いっぱいお尻にだすじゃん♪　もう、タプタプだよ……❤」
				ENDSELECT
			ELSE
				PRINTFORMW 「あんまり体、ゆすらないで……お尻の違和感、すごいから」
			ENDIF
			RETURN 1
		ELSE
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「へへ、%CSTR:TARGET:MASCALL%もずいぶん、汗だくだ……♪」
						PRINTFORMW 「ニシシ、お互いのニオイが混ざって、ヤバいねコレ……❤」
					CASE 1
						PRINTFORMW 「ふぅ……はぁ……ごめ、ちょっと休憩……。水、のませて……。うん、ありがと」
						PRINTFORMW 「……ねぇ%CSTR:TARGET:MASCALL%、애널でズコバコしてるのにこうして日常なやりとりするの、なんだか背徳的じゃない❤？　ん゛ぁっ！？　こら、興奮してまさぐるなぁ……❤」
					CASE 2
						PRINTFORMW 「ダメだって……♪　お尻ほじくりながら、手でもさわるの禁止ぃ……❤　全身性感帯にされちゃう……❤」
				ENDSELECT
			ELSE
				PRINTFORMW 「あ゛、ちょ……！　挿れながら、さわるなぁ……！」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF

	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 1
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「こらこら、興奮してどんどん手つきがいやらしくなってない？　……もう❤」
			ELSE
				PRINTFORMW 「……もう、手つきがいやらしいなぁ……。そんなに僕をさわりたかったの？」
			ENDIF
		CASE 2
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「好きにさわりなよっ。僕、君にムチャクチャにされるの興奮するからさ……❤」
			ELSE
				PRINTFORMW 「……もう、くすぐったいだけだって……♪」
			ENDIF
		CASE 3
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「そんなに僕のからだ、興奮する？　にひっ、正直でよろしい……❤」
			ELSE
				PRINTFORMW 「……んん、ムズムズする……。ごめん、ちょっと恥ずかしい……」
			ENDIF
		;연모
		CASE 4
			PRINTFORMW 「も、もう僕の弱点、しりつくされちゃってるなぁ……❤」
		CASE 5
			PRINTFORMW 「こ、こらぁ……クリトリスばっか、せめるなぁ……僕がよわいの、しってるくせにぃ……❤」
		;親愛
		CASE 6
			PRINTFORMW 「にひっ♪　こうやって僕の気持ちいいとこばっか責められてるのってさぁ……、つまり君が僕に奉仕してるようなものだよね？」
			PRINTFORMW 「い～っぱい、僕に奉仕してね♪　……後でその分、返してあげる……❤」
		CASE 7
			PRINTFORMW 「えへへ、こうやって触られてるとさ……体の芯から、燃え上がっちゃいそうだよ……❤」
			PRINTFORMW 「ほら、僕、화염속성のオンナだからさ……❤　一度火がついたら、もう、止められないよ……❤」
		;애처
		CASE 8
			PRINTFORMW 「あ～なたっ♪　僕のからだはどうかな～♪　あなた好みなら嬉しいなぁ……❤」
			PRINTFORMW 「いつまでもいつまでも、夢中でいてね……❤　いつでも僕を、好きにしてね……❤」
	ENDSELECT
ENDIF
RETURN 1
