	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「ちょ！？　ちょっと、汚いよ、そんなトコ！？」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;질내사정直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:V삽입관리플래그 == MASTER
		IF TCVAR:질내사정플래그 
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「なぁに？　きれいにしてくれんの？　ニシシ、僕、愛されてるなぁ……❤」
				PRINTFORMW 「次、だしたら今度は僕が、%CSTR:TARGET:MASCALL%のをキレイにしてあげるね……❤」
			ELSE
				PRINTFORMW 「……えぇ、な、なにしてんのさ……？　よく、舐めれるね……？」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;절정した（この구상の後に절정）
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		PRINTFORMW 「ひっ、ダメ、そんなっ、クル、きちゃう、きちゃうぅぅ……❤」
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「そーだよ、クリトリスは大事なところなんだから❤　丁寧に扱ってねー……♪」
			ELSE
				PRINTFORMW 「そ、そこは女の子の大事なトコなんだよ！？　安易に舐めちゃ……ひぅぅん！？」
			ENDIF
		CASE 2
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「あっ❤　だめっ❤　僕❤　弱いからっ❤　そこ❤　弱点だからっ❤」
			ELSE
				PRINTFORMW 「……あっ！？　ダメ！　僕、そこ、弱いから……っ！？」
			ENDIF
		CASE 3
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「にひっ♪　そんなに舐めて……ワンちゃんみたい♪　おーよちよち、いい子でちゅね～♪」
				PRINTFORMW 「あ゛っ❤　ごめ❤　ごめんなさい❤　調子のりました❤　やめっ❤　あまがみしないでぇ❤」
			ELSE
				PRINTFORMW 「あっ、ヤダっ、そんなっ、舐めるなぁ……！」
				PRINTFORM 「ち、違うもん！？　僕、濡れてない……っ！　
				IF TALENT:TARGET:처녀
					PRINTFORMW だって僕、처녀だよ！　……あ、わ、忘れろっ！？　いい！？　忘れろぉ……！」
				ELSE
					PRINTFORMW そ、そう！　%CSTR:TARGET:MASCALL%の唾液でしょ！？　うん、そうだよ、そうだって！」
				ENDIF
			ENDIF
		;연모
		CASE 4
			PRINTFORMW 「濡れてきた？　……そうだねぇ、きもち、いーからねー……❤」
			PRINTFORMW 「あっ❤　だめだってぇ❤　そんな、しつようにぃ❤　オマンコ、ドバドバでちゃうぅ❤」
		;親愛
		CASE 5
			PRINTFORMW 「ぼ、僕うれしいんだっ❤　%CSTR:TARGET:MASCALL%が奉仕❤　してくれて❤」
			PRINTFORMW 「いいよっ❤　僕っ❤　君に舐められるの❤　うれしいっ❤　あとで舐め合いっこ❤　しよーね❤」
	ENDSELECT
ENDIF
RETURN 1

