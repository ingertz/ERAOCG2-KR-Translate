		;자위の声が聞こえる（オナバレ直前）
		CASE 1
			PRINTFORMW 「앙❤ 읏흥❤ %CALLNAME:MASTER%❤ 좋아❤」
	;一般
		;オナバレ
		CASE 2
			PRINTFORMW 
		;上目遣いで訴える
		CASE 3
			PRINTFORMW 
		;期待に答えて押し倒す
		CASE 4
			PRINTFORMW 
		;断られた（部屋の掃除を始める）
		CASE 5
			PRINTFORMW 「에이…… 한심해라……」
		;ノックしてから中に入る（オナバレ無し）
		CASE 6
			PRINTFORMW 「…………쳇ー……」
	
	;雑魚雌のみ
		;オナバレ（縋りついてくる）
		CASE 10
			PRINTFORMW 「응❤응❤ %CALLNAME:MASTER%❤ 하자❤」
		;見せ槍자위
		CASE 11
			;おしべだいすきカズーラちゃん
			PRINTFORMW 「앗……❤ 헷…… 헤헷❤」
	
	;포식자のみ
		;問答無用逆レイプ
		CASE 15
			PRINTFORMW 「네ー이❤ 한 분 안내해 드릴게요ー❤」
	ENDSELECT
ENDIF
RETURN 1

