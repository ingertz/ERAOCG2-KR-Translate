;==================================================
;帰宅時/外出時
;==================================================
@M_KOJO_EVENT_K1373_11(ARG,ARG:1)
;구상主はLOCALS or RESULT
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;--------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;MASTER通常帰宅
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		SIF CFLAG:TARGET:현재위치 != 場所_玄関
			SETCOLOR C_D_GRAY
		PRINTFORMW 「어서 와~」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTER仕事・学校終わり帰宅
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		SIF CFLAG:TARGET:현재위치 != 場所_玄関
			SETCOLOR C_D_GRAY
		PRINTFORMW 「어서 와~」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;一緒に데이트중帰宅
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:TARGET:연모
			PRINTFORMW 「재미있었지~, 다음엔 뭐 할까?❤」
		ELSE
			PRINTFORMW 「재미있었어~. %CALLNAME:MASTER%, 침대까지 데려다줘~」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;캐릭터が外出から帰宅する
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「다녀왔어~. %CALLNAME:MASTER%, 살려줘~」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;캐릭터がバイトから帰宅する
	;（来訪캐릭터のみ,自宅が無い캐릭터でも発生します）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 「꾸엑~…… %CALLNAME:MASTER%~……」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;家に訪問してくる
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	;訪問してくる
	IF LOCAL:1 && ARG == 5 && ARG:1 == 0
		PRINTFORMW 「%CALLNAME:MASTER%~, 열어줘~」
		RETURN 1
	;「はい」を選択
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 1
		IF TALENT:TARGET:연모
			PRINTFORMW 「에헤헤…… 와 버렸어❤」
		ELSE
			PRINTFORMW 「물하고 간식 줘~」
		ENDIF
		RETURN 1
	;「いいえ」を選択
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 2
		PRINTFORMW 「흥……」
		RETURN 1
	;手が離せない状態で、帰ってくれる
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 3
		PRINTFORMW 「…………」
		RETURN 1
	;手が離せない状態で、入ってきた
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 4
		PRINTFORMW 「들어갈게~」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠いのでカード/家へ帰る
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6 && ARG:1 == 0
		RETURN 1
	ELSEIF LOCAL:1 && ARG == 6 && ARG:1 == 1
		RETURN 1
	ENDIF
