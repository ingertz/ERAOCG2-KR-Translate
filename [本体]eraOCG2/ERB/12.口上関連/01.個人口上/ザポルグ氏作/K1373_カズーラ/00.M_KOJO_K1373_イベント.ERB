			PRINTFORMW 「えへへ……来ちゃった❤」
		ELSE
			PRINTFORMW 「お水とおやつちょーだーい」
		ENDIF
		RETURN 1
	;「いいえ」を選択
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 2
		PRINTFORMW 「ぶー……」
		RETURN 1
	;手が離せない状態で、帰ってくれる
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 3
		PRINTFORMW 「…………」
		RETURN 1
	;手が離せない状態で、入ってきた
