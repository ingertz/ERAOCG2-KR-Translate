@M_KOJO_EVENT_K1373_36(ARG,ARG:1)
;구상主はARG
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;--------------------------------------------------
IF LOCAL
	SELECTCASE ARG
		;フリースペース、地の文でも何でも好きに書いていい
		CASE 0
			PRINTFORML %CALLNAME:TARGET%는 무릎에 팔꿈치를 괴고 빤히 이쪽을 바라보고 있다.
			PRINTFORMW 풀이 죽은 듯, 기운이 없는 듯…… 적어도 즐거워 보이지는 않는다.
		;汗を拭いて額に冷たいもの
		CASE 1
			PRINTFORMW 「어때? 조금은 움직일 수 있게 됐어?」
		;療養食食べさせる
		CASE 2
			PRINTFORMW 「영양은 챙겨야지ー, 금방 죽어버린단 말이야ー」
		;薬を飲ませる
		CASE 3
			PRINTFORMW 「이런 걸로 정말 낫는 거야? 고기 같은 걸 먹는 편이 낫지 않아?」
		;子守唄を歌う
		CASE 4
			PRINTFORML 「잘ーーーーーー자라ーーーーー……」
			PRINTFORMW 건성으로 부르는 노랫소리가 머릿속에 울린다……
		;密着して傍にいる
		CASE 5
			PRINTFORMW 「아ー…… 평소보다 좀 뜨겁네」
		;話し상대에게 なる
		CASE 22
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「흐음ー, 감기라는 건 그렇게 힘든 거구나ー」
				CASE 1
					PRINTFORMW 「……평소보다 엉망진창이네, 좀 더 쉬는 편이 좋지 않아?」
				CASE 2
					PRINTFORMW 「……힘들면 그냥 자고 있어도 돼?」
			ENDSELECT
		;薬を補充する
		CASE 23
			PRINTFORMW 「다녀왔어ー, 빨리 기운 차려ー」
	ENDSELECT
ENDIF
RETURN 1
