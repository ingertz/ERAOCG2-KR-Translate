@M_KOJO_MESSAGE_COM_K1373_312_1
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 条件달성,2
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;ファースト키스
		SIF EXP:TARGET:Ｍ경험 == 1 && EXP:TARGET:펠라경험 == 0 && CFLAG:TARGET:키스상실상대 == MASTER
			条件달성:0 = 1
		SIF EXP:MASTER:Ｍ경험 == 1 && EXP:MASTER:펠라경험 == 0 && CFLAG:MASTER:키스상실상대 == TARGET
			条件달성:1 = 1
		PRINTFORMW 「으응…… 쪽……❤ 쭈릅……❤」
		IF 条件달성:0 == 1 || 条件달성:1 == 1
			IF 条件달성:0 == 1 && 条件달성:1 == 1
				PRINTFORMW 「뿌우…… 뽀뽀는 즐겁네❤ 입술을 맞대고 있을 뿐인데 말이야……❤」
				PRINTFORMW 「%CALLNAME:MASTER%는 어때? 첫 뽀뽀, 즐거웠어?❤」
			ELSEIF 条件달성:0 == 1
				PRINTFORMW 「뿌우…… 뽀뽀는 즐겁네❤ %CALLNAME:MASTER%~ 더 하자~❤」
			ELSEIF 条件달성:1 == 1
				PRINTFORMW 「으헤헤❤ 어때~ %CALLNAME:MASTER%~? 첫 뽀뽀, 기분 좋았어~?❤」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 5
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 3
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「쪽…… 응쪽……♪」
		CASE 2
			PRINTFORMW 「응훗……♪ 음…… 쪽……♪」
		CASE 3
			PRINTFORMW 「뽀뽀하는 거 즐겁네~♪ 더 할래~?」
		CASE 4
			PRINTFORMW 「쪽……♪ 으응…… 쪽……♪」
		CASE 5
			PRINTFORMW 「으응…… 꺄아~♪ 그렇게 바라보면, 부끄럽잖아~♪」
		;연모
		CASE 6
			PRINTFORMW 「으응…… 쪽…… 으읍……❤」
		CASE 7
			PRINTFORMW 「함…… 쭈릅……❤ 으음……❤」
		;親愛
		CASE 8
			PRINTFORMW 「응아……❤ %CALLNAME:MASTER%~, 더~❤」
		CASE 9
			PRINTFORMW 「쭈릅…… 레로오……❤ 음…… 쪼옥……❤」
		CASE 10
			PRINTFORMW 「쪼옥…… 쭈르륵……❤ 으헤에…… 으응……❤」
	ENDSELECT
ENDIF
RETURN 1
