	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「どんどん奥まで入ってくねー♪」
		CASE 2
			PRINTFORMW 「おー♪　ぐちゅぐちゅいってるねー♪」
		CASE 3
			PRINTFORMW 「もうちょっと大きくても大丈夫だよー♪」
		;연모
		CASE 4
			PRINTFORMW 「えへへー❤　%CALLNAME:MASTER%の指すきー❤」
		;親愛
		CASE 5
			PRINTFORMW 「%CALLNAME:MASTER%の指、ドロドロになっちゃったねー❤　キレイにしてあげよっか？❤」
	ENDSELECT
ENDIF
RETURN 1

