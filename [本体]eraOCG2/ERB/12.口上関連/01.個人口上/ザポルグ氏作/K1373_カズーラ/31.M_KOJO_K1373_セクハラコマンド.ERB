#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 条件달성,2
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;ファースト키스
		SIF EXP:TARGET:Ｍ경험 == 1 && EXP:TARGET:펠라경험 == 0 && CFLAG:TARGET:키스상실상대 == MASTER
			条件달성:0 = 1
		SIF EXP:MASTER:Ｍ경험 == 1 && EXP:MASTER:펠라경험 == 0 && CFLAG:MASTER:키스상실상대 == TARGET
			条件달성:1 = 1
		PRINTFORMW 「ん……ちゅ……❤　ちゅる……❤」
		IF 条件달성:0 == 1 || 条件달성:1 == 1
			IF 条件달성:0 == 1 && 条件달성:1 == 1
				PRINTFORMW 「ぷぅ……ちゅーって楽しいね❤　唇をくっつけてるだけなのに……❤」
				PRINTFORMW 「%CALLNAME:MASTER%はどう？　初めてのちゅー、楽しかった？❤」
			ELSEIF 条件달성:0 == 1
				PRINTFORMW 「ぷぅ……ちゅーって楽しいね❤　%CALLNAME:MASTER%ー、もっとシよー❤」
			ELSEIF 条件달성:1 == 1
				PRINTFORMW 「えへへ❤　どおー、%CALLNAME:MASTER%ー？　はじめてのちゅー、気持ちよかったー？❤」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 5
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 3
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「ちゅ……んちゅ……♪」
		CASE 2
			PRINTFORMW 「んふ……♪　んむ……ちゅ……♪」
		CASE 3
			PRINTFORMW 「ちゅーするの楽しいねー♪　もっとするー？」
		CASE 4
			PRINTFORMW 「ちゅ……♪　ん……ちゅー……♪」
		CASE 5
			PRINTFORMW 「ん……やーん♪　そんなに見つめられたら、照れちゃうー♪」
		;연모
		CASE 6
			PRINTFORMW 「ん……ちゅ……れぇ……❤」
		CASE 7
			PRINTFORMW 「はむ……じゅる……❤　んー……❤」
		;親愛
		CASE 8
			PRINTFORMW 「んぁ……❤　%CALLNAME:MASTER%ー、もっとー❤」
		CASE 9
			PRINTFORMW 「じゅる……れろぉ……❤　んむ……ちゅぅ……❤」
		CASE 10
			PRINTFORMW 「ちゅぅ……じゅるる……❤　んへぇ……ん……❤」
	ENDSELECT
ENDIF
RETURN 1
