CALL M_KOJO_MESSAGE_COM_K1373_316_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_316_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;Ｖ감각。ここを記入した場合、これより下は流れない
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1
		;５以上
		IF ABL:TARGET:Ｖ감각 >= 5
			PRINTFORMW 
		;１未満
		ELSEIF ABL:TARGET:Ｖ감각 < 1
			PRINTFORMW 
		;５未満
		ELSEIF ABL:TARGET:Ｖ감각 < 5
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「점점 더 안쪽까지 들어가네~♪」
		CASE 2
			PRINTFORMW 「오~♪ 꾸물꾸물 거리고 있네~♪」
		CASE 3
			PRINTFORMW 「조금 더 커도 괜찮아~♪」
		;연모
		CASE 4
			PRINTFORMW 「에헤헤~❤ %CALLNAME:MASTER%의 손가락 좋아~❤」
		;親愛
		CASE 5
			PRINTFORMW 「%CALLNAME:MASTER%의 손가락, 끈적끈적해졌네~❤ 깨끗하게 해줄까?❤」
	ENDSELECT
ENDIF
RETURN 1

;==================================================
;317,로터삽입
;道具系コマンドに同じ名前のコマンドがあるが、こちらはリモート로터に繋がる
;==================================================
@M_KOJO_MESSAGE_COM_K1373_317
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1373_317_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_317_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:로터
		PRINTFORMW 「우웩, 토할 것 같아~...」
	;解除
	ELSE
		PRINTFORMW 「아~, 개운하다~」
	ENDIF
ENDIF
RETURN 1

