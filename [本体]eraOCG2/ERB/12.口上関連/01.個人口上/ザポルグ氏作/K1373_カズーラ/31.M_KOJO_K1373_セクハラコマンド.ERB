;==================================================
;341,体を舐めさせる
;==================================================
@M_KOJO_MESSAGE_COM_K1373_341
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1373_341_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_341_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;足舐め
	IF TCVAR:TARGET:도게자중
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「음붑... 츕... 쭈르륵... 츕...❤」
			CASE 1
				PRINTFORMW 「낼름... 낼름... 냠... 츄르릅...❤」
			CASE 2
				PRINTFORMW 「쭈르륵... 으음... 쫍쫍... 하아...❤」
		ENDSELECT

	;耳舐め
	ELSE
		호감도修正 = 3
		SIF TALENT:TARGET:애처
			호감도修正 += 1
		SIF TALENT:TARGET:연모 == 2
			호감도修正 += 1
		SIF TALENT:TARGET:연모 >= 1
			호감도修正 += 0
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORMW 「하아... 흐읍...❤ 후우~...❤」
			CASE 2
				PRINTFORMW 「후우~❤ 아하❤ 숨결만 닿았는데도, 몸이 으스스해졌네~❤」
			CASE 3
				PRINTFORMW 「으음... 쭈압... 웁... 츄르릅...❤」
			;연모
			CASE 4
				PRINTFORMW 「츄르릅……츄르르……❤ 후으……음, 츄르르르……❤」
			;親愛
			CASE 5
				PRINTFORMW 「%CALLNAME:MASTER%~, 사랑해~……쪽❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
