;310,尻を撫でる
;ABL:친밀(2以下=不快(TALENT:臆病なら涙目) 3以上=恥ずかしがる(TALENT:남성혐오兼MASTERが男なら、身をすくめる) 6以上=されるがまま)
;CFLAG:우후후==2&&TCVAR:TARGET:전CT행동(31=後ろから抱きつく 32=前から抱きつく 50=수음 51=펠라 52=스마타 53=파이즈리 59=乳首吸われる
;60=딥키스 61=逆レイプ 70=クンニ強制 72=애널奉仕強制
;CFLAG:우후후==2&&TEQUIP:식스나인(パンツありTCVAR:TARGET:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=데이트先or地底のモブが反応する)
;==================================================
@M_KOJO_SUCCESS_COM_K1373_310
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K1373_310
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1373_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_310_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;친밀。ここを記入した場合、これより下は流れない
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1
		;６以上
		IF ABL:TARGET:친밀 >= 6
			PRINTFORMW 
		;３以上
		ELSEIF ABL:TARGET:친밀 >= 3
			PRINTFORMW 
		;２以下
		ELSEIF ABL:TARGET:친밀 <= 2
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「응~? 엉덩이 모양 신경 쓰여~?」
		CASE 2
			PRINTFORM 「아잉~, 너무 만지면 떨어져 나가 버려~
			SIF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
				PRINTFORM ♪
			PRINTFORMW 」
		CASE 3
			PRINTFORMW 「더 확실하게 만져도 돼~♪」
		;연모
		CASE 4
			PRINTFORMW 「왜 그래~? 야하게 하고 싶어졌어~?❤」
		CASE 5
			PRINTFORMW 「더 만져도 돼~❤ 아래쪽이라든지 말이야~❤」
		;親愛
		CASE 6
			PRINTFORMW 「아아❤ %CALLNAME:MASTER%가 만지니까 즙이 흘러내리잖아앙❤」
		CASE 7
			PRINTFORMW 「%CALLNAME:MASTER%~, 나 배고파졌네~❤」
	ENDSELECT
ENDIF
RETURN 1
