CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1373_318_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_318_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;알바중
	IF CFLAG:TARGET:알바중
		SELECTCASE RAND:3 + 1
			CASE 1
				PRINTFORMW 「네~네~, 지금 갈게~」
			CASE 2
				PRINTFORMW 「...심심하네~」
			CASE 3
				PRINTFORMW 「.........」
		ENDSELECT
	;それ以外
	ELSE
		SELECTCASE RAND:3 + 1
			CASE 0
				PRINTFORMW 「움직이네~...」
			CASE 1
				PRINTFORMW 「...아흐으...」
			CASE 2
				PRINTFORMW 「.........」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

