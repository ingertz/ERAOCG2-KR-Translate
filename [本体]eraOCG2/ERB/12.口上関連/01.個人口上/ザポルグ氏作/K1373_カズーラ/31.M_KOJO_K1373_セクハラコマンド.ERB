CALL M_KOJO_MESSAGE_COM_K1373_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_310_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;친밀。ここを記入した場合、これより下は流れない
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1
		;６以上
		IF ABL:TARGET:친밀 >= 6
			PRINTFORMW 
		;３以上
		ELSEIF ABL:TARGET:친밀 >= 3
			PRINTFORMW 
		;２以下
		ELSEIF ABL:TARGET:친밀 <= 2
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「んー？　おしりの形、気になるー？」
		CASE 2
			PRINTFORM 「もー、あんまり触ると千切れちゃうよー
			SIF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
				PRINTFORM ♪
			PRINTFORMW 」
		CASE 3
			PRINTFORMW 「もっとガッツリ触ってもいーよー♪」
		;연모
		CASE 4
			PRINTFORMW 「どうしたのー？　エッチしたくなっちゃったー？❤」
		CASE 5
			PRINTFORMW 「もっと触ってもいいよー❤　下の方とかさー❤」
		;親愛
		CASE 6
			PRINTFORMW 「あーあ❤　%CALLNAME:MASTER%が触るからお汁垂れてきちゃったじゃーん❤」
		CASE 7
			PRINTFORMW 「%CALLNAME:MASTER%ー、わたし、お腹空いてきちゃったなー❤」
	ENDSELECT
ENDIF
RETURN 1
