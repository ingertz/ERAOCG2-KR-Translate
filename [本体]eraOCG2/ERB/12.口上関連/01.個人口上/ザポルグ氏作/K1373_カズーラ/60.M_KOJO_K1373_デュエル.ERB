	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	;LP４０００～６０００間
	IF INRANGE(ライフ_상대,4000,6000)
		PRINTFORMW 「んー、ちょっと危ないかもねー……わたしのターン」
	;LP２０００以下
	ELSEIF ライフ_상대 <= 2000
		PRINTFORMW 「わたしのターンかー、何とかしないとなー……」
	ELSEIF ライフ_자신 <= 2000
		PRINTFORMW 「わたしのターンでいいんだねー？　それじゃあ、そろそろ終わりにしてあげるー♪」
	;それ以外
	ELSE
		PRINTFORMW 「もういいの？　それじゃあわたしのターンだねー」
	ENDIF
ENDIF

