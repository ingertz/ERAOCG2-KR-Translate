;==================================================
;10,ダメージ反応！（ダメージ）
;==================================================
@M_KOJO_DUEL_K1373_10(ダメージ量,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC ダメージ量
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF ライフ_상대
		PRINTFORMW 「あー……ダメだこりゃ。　ぐえー」
	ELSE
		SELECTCASE ダメージ量
			;ダメージなし
			CASE 0
				PRINTFORMW 「ぜーんぜん、効いてませーん♪」
			;１～１９９９の時、小ダメージ
			CASE 1 TO 1999
				PRINTFORMW 「わわわ、ちょっと痛いねー」
			;２０００～３９９９の時、結構なダメージ
			CASE 2000 TO 3999
				PRINTFORMW 「きゃー！　ちょっとは手加減してよー」
			;４０００～７９９９の時、超大ダメージ
			CASE 4000 TO 7999
				PRINTFORMW 「あ、あば、あばば……そろそろ、ヤバい、かも」
			;８０００以上、基本即死
			CASEELSE
				PRINTFORMW 「…………あ……まだ、生きてる……？」
		ENDSELECT
	ENDIF
ENDIF


