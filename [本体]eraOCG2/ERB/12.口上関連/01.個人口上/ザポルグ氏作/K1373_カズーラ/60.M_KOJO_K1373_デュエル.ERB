;==================================================
;1,モンスター소환
;例：《%カード名%》を소환！
;==================================================
@M_KOJO_DUEL_K1373_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	TRYCALLFORM CARDNAME_{カードID}("カテゴリ")
	IF MATCH(RESULTS,"충혹마")
		TRYCALLFORM CARD_{カードID},"連動ID"
		IF カードID == 1373 || RESULT == 1373
			PRINTFORMW 「わたしを소환するねー」
		ELSE
			IF RESULT != 0
				TRYCALLFORM CARDNAME_{RESULT}("略称")
			ELSE
				TRYCALLFORM CARDNAME_{カードID}("略称")
			ENDIF
			PRINTFORMW 「おいでー、%RESULTS%ー」
		ENDIF
	ELSE
		SELECTCASE RAND:3 + 1
			CASE 1
				PRINTFORMW 「《%カード名%》をしょーかーん」
			CASE 2
				PRINTFORMW 「行ってこーい、《%カード名%》を소환ー」
			CASE 3
				PRINTFORMW 「《%カード名%》を소환するよー」
		ENDSELECT
	ENDIF
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_KOJO_DUEL_K1373_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	TRYCALLFORM CARDNAME_{カードID}("カテゴリ")
	IF MATCH(RESULTS,"충혹마")
		TRYCALLFORM CARD_{カードID},"連動ID"
		IF カードID == 1373 || RESULT == 1373
			PRINTFORMW 「わたしを특수 소환한다よー」
		ELSE
			IF RESULT != 0
				TRYCALLFORM CARDNAME_{RESULT}("略称")
			ELSE
				TRYCALLFORM CARDNAME_{カードID}("略称")
			ENDIF
			PRINTFORMW 「がんばれー、%RESULTS%ー」
		ENDIF
	ELSE
		SELECTCASE 소환出処
			;패에서 
			CASE 召種손패
				PRINTFORMW 「패에서 《%カード名%》を특수 소환한다よー」
			;마법함정ゾーンから。　キリ番・シェイプシスターなどを出す場合
			CASE 召種마함
				TRYCALLFORM CARD_{カードID}("分割")
				IF RESULT == 효과なし
					PRINTFORMW 「そのまま특수소환だー」
				ELSE
					PRINTFORMW 「마법＆함정 존에 いる《%カード名%》を특수しょうかーん」
				ENDIF
			;덱에서 
			CASE 召種덱
				PRINTFORMW 「덱에서 《%カード名%》を특수 소환한다ねー」
			;EX덱에서 
			CASE 召種EX덱
				PRINTFORMW 「ＥＸから《%カード名%》をそーい」
			;묘지에서 
			CASE 召種묘지
				PRINTFORMW 「起きろー、《%カード名%》ー」
			;제외状態から
			CASE 召種제외
				PRINTFORMW 「제외されてる《%カード名%》を특수 소환한다よー」
			;主にトークン生成
			CASE 10
				PRINTFORMW 「《%カード名%》を出すねー」
		ENDSELECT
	ENDIF
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K1373_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORMW 「의식しょうかーん。　《%カード名%》、こうりーん」
		CASE 융합
			IF カードID == 59812
				PRINTFORMW 「えっちなフレシアを융합しょうかーん❤」
			ELSEIF カードID == 59812
				PRINTFORMW 「えっちなシトリスを융합しょうかーん❤」
			ELSE
				PRINTFORMW 「《%カード名%》を융합소환するねー」
			ENDIF
		CASE 싱크로
			PRINTFORMW 「《%カード名%》を싱크로소환だー」
		CASE 엑시즈
			IF GROUPMATCH(カードID,1371,1377,1385)
				TRYCALLFORM CARDNAME_{カードID}("略称")
				PRINTFORMW 「엑시즈しょうかーん。　%RESULTS%、おいでー」
			ELSE
				PRINTFORMW 「엑시즈소환ー。　やっちゃえ《%カード名%》ー」
			ENDIF
		CASE 링크
			IF GROUPMATCH(カードID,1370,1380,1384)
				TRYCALLFORM CARDNAME_{カードID}("略称")
				PRINTFORMW 「링크しょうかーん。　がんばれー、%RESULTS%ー」
			ELSEIF カードID == 59810
				PRINTFORMW 「えっちなセラを링크しょうかーん❤」
			ELSEIF カードID == 59811
				PRINTFORMW 「えっちなクラリアを링크しょうかーん❤」
			ELSE
				PRINTFORMW 「《%カード名%》を링크소환するねー」
			ENDIF
		;초차원モンスター（デュエマ）
		CASE 초차원
			PRINTFORMW 「《%カード名%》を초차원から소환するねー」
	ENDSELECT
ENDIF

;==================================================
;4,효과使用宣言
;==================================================
@M_KOJO_DUEL_K1373_4(カードID,발동出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
#DIM DYNAMIC 발동出処
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	TRYCALLFORM CARDNAME_{カードID}("カテゴリ")
	IF MATCH(RESULTS,"충혹마")
		TRYCALLFORM CARD_{カードID},"連動ID"
		IF カードID == 1373 || RESULT == 1373
			PRINTFORMW 「わたしの효과、はっつどー♪」
		ELSE
			IF RESULT != 0
				TRYCALLFORM CARDNAME_{RESULT}("略称")
			ELSE
				TRYCALLFORM CARDNAME_{カードID}("略称")
			ENDIF
			IF カード種 < モン全般
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「%RESULTS%의 효과를 발동するねー」
					CASE 1
						PRINTFORMW 「%RESULTS%의 효과를 くらえー♪」
					CASE 2
						PRINTFORMW 「%RESULTS%の효과、対処できるかなー♪」
				ENDSELECT
			ELSE
				PRINTFORMW 「《%カード名%》を발동するよー」
			ENDIF
		ENDIF
	ELSE
		SELECTCASE 발동出処
			CASE 1
				;손패발동
				IF GROUPMATCH(カード種,通常마법,速攻마법,지속마법)
					PRINTFORMW 「《%カード名%》を발동するよー」
				ELSE
					PRINTFORMW 「패의 《%カード名%》의 효과를 발동するねー」
				ENDIF
			CASE 2
				;필드발동
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「《%カード名%》의 효과를 使うよー」
					CASE 1
						PRINTFORMW 「それじゃあ、《%カード名%》の효과、はっつどー♪」
					CASE 2
						PRINTFORMW 「《%カード名%》の효과使うよー、何かあるー？」
				ENDSELECT
			CASE 3
				;마함발동
				TRYCALLFORM CARDNAME_{カードID}("カテゴリ")
				IF MATCH(RESULTS,"함정 속으로")
					PRINTFORMW 「はい、ざんねーん♪　リバースカードオープン、《%カード名%》でーす❤」
				ELSE
					IF カード種 == 通常함정
						PRINTFORMW 「油断しちゃったー？　リバースカードオープン、《%カード名%》だよー♪」
					ELSE
						PRINTFORMW 「《%カード名%》의 효과를 발동するよー」
					ENDIF
				ENDIF
			CASE 4
				;묘지발동
				IF カード種 < モン全般
					PRINTFORMW 「묘지의 《%カード名%》의 효과를 발동するねー」
				ELSE
					PRINTFORMW 「使って終わりじゃないんだよねー。　《%カード名%》の효과、はっつどー」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF



