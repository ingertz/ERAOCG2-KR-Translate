		CASE 3
			PRINTFORMW 「발밑은 조심하는 게 좋을 거야~♪」
	ENDSELECT
ENDIF

;==================================================
;1,モンスター소환
;例：《%カード名%》を소환！
;==================================================
@M_KOJO_DUEL_K1373_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	TRYCALLFORM CARDNAME_{カードID}("カテゴリ")
	IF MATCH(RESULTS,"충혹마")
		TRYCALLFORM CARD_{カードID},"連動ID"
		IF カードID == 1373 || RESULT == 1373
			PRINTFORMW 「나를 소환할게~」
		ELSE
			IF RESULT != 0
				TRYCALLFORM CARDNAME_{RESULT}("略称")
			ELSE
				TRYCALLFORM CARDNAME_{カードID}("略称")
			ENDIF
			PRINTFORMW 「이리 와~, %RESULTS%~」
		ENDIF
	ELSE
		SELECTCASE RAND:3 + 1
			CASE 1
				PRINTFORMW 「《%カード名%》을 소환~」
			CASE 2
				PRINTFORMW 「가라~, 《%カード名%》 소환~」
			CASE 3
				PRINTFORMW 「《%カード名%》을 소환할게~」
		ENDSELECT
	ENDIF
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_KOJO_DUEL_K1373_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	TRYCALLFORM CARDNAME_{カードID}("カテゴリ")
	IF MATCH(RESULTS,"충혹마")
		TRYCALLFORM CARD_{カードID},"連動ID"
		IF カードID == 1373 || RESULT == 1373
			PRINTFORMW 「나를 특수 소환한다~」
		ELSE
			IF RESULT != 0
				TRYCALLFORM CARDNAME_{RESULT}("略称")
			ELSE
				TRYCALLFORM CARDNAME_{カードID}("略称")
			ENDIF
			PRINTFORMW 「힘내~, %RESULTS%~」
		ENDIF
	ELSE
		SELECTCASE 소환出処
			;패에서 
			CASE 召種손패
				PRINTFORMW 「패에서 《%カード名%》을 특수 소환한다~」
			;마법함정ゾーンから。　キリ番・シェイプシスターなどを出す場合
			CASE 召種마함
				TRYCALLFORM CARD_{カードID}("分割")
				IF RESULT == 효과なし
					PRINTFORMW 「그대로 특수 소환이다~」
				ELSE
					PRINTFORMW 「마법＆함정 존에 있는 《%カード名%》을 특수 소환~」
				ENDIF
			;덱에서 
			CASE 召種덱
				PRINTFORMW 「덱에서 《%カード名%》을 특수 소환할게~」
			;EX덱에서 
			CASE 召種EX덱
				PRINTFORMW 「EX에서 《%カード名%》을 소환~」
			;묘지에서 
			CASE 召種묘지
				PRINTFORMW 「일어나~, 《%カード名%》~」
			;제외状態から
			CASE 召種제외
				PRINTFORMW 「제외되어 있는 《%カード名%》을 특수 소환한다~」
			;主にトークン生成
			CASE 10
				PRINTFORMW 「《%カード名%》을 낼게~」
		ENDSELECT
	ENDIF
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K1373_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORMW 「의식 소환~.　《%カード名%》, 강림~」
		CASE 융합
			IF カードID == 59812
				PRINTFORMW 「야한 프레시아를 융합 소환할게❤」
			ELSEIF カードID == 59812
				PRINTFORMW 「야한 시트리스를 융합 소환할게❤」
			ELSE
				PRINTFORMW 「《%カード名%》을 융합 소환할게~」
			ENDIF
		CASE 싱크로
			PRINTFORMW 「《%カード名%》을 싱크로 소환이다~」
		CASE 엑시즈
			IF GROUPMATCH(カードID,1371,1377,1385)
				TRYCALLFORM CARDNAME_{カードID}("略称")
				PRINTFORMW 「엑시즈 소환~.　%RESULTS%, 이리 와~」
			ELSE
				PRINTFORMW 「엑시즈 소환~.　해치워라 《%カード名%》~」
			ENDIF
		CASE 링크
			IF GROUPMATCH(カードID,1370,1380,1384)
				TRYCALLFORM CARDNAME_{カードID}("略称")
				PRINTFORMW 「링크 소환~.　힘내라~, %RESULTS%~」
			ELSEIF カードID == 59810
				PRINTFORMW 「야한 세라를 링크 소환할게❤」
			ELSEIF カードID == 59811
				PRINTFORMW 「야한 클라리아를 링크 소환할게❤」
			ELSE
				PRINTFORMW 「《%カード名%》을 링크 소환할게~」
			ENDIF
		;초차원モンスター（デュエマ）
		CASE 초차원
			PRINTFORMW 「《%カード名%》을 초차원에서 소환할게~」
	ENDSELECT
ENDIF

;==================================================
;4,효과使用宣言
;==================================================
@M_KOJO_DUEL_K1373_4(カードID,발동出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
#DIM DYNAMIC 발동出処
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	TRYCALLFORM CARDNAME_{カードID}("カテゴリ")
	IF MATCH(RESULTS,"충혹마")
		TRYCALLFORM CARD_{カードID},"連動ID"
		IF カードID == 1373 || RESULT == 1373
			PRINTFORMW 「내 효과, 발동~♪」
		ELSE
			IF RESULT != 0
				TRYCALLFORM CARDNAME_{RESULT}("略称")
			ELSE
				TRYCALLFORM CARDNAME_{カードID}("略称")
			ENDIF
			IF カード種 < モン全般
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「%RESULTS%의 효과를 발동할게~」
					CASE 1
						PRINTFORMW 「%RESULTS%의 효과를 받아라~♪」
					CASE 2
						PRINTFORMW 「%RESULTS%의 효과, 대처할 수 있을까~♪」
				ENDSELECT
			ELSE
				PRINTFORMW 「《%カード名%》을 발동할게~」
			ENDIF
		ENDIF
	ELSE
		SELECTCASE 발동出処
			CASE 1
				;손패발동
				IF GROUPMATCH(カード種,通常마법,速攻마법,지속마법)
					PRINTFORMW 「《%カード名%》을 발동할게~」
				ELSE
					PRINTFORMW 「패의 《%カード名%》의 효과를 발동할게~」
				ENDIF
			CASE 2
				;필드발동
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「《%カード名%》의 효과를 사용할게~」
					CASE 1
						PRINTFORMW 「그럼, 《%カード名%》의 효과, 발동이다~♪」
					CASE 2
						PRINTFORMW 「《%カード名%》의 효과 사용할게~, 뭔가 있어~?」
				ENDSELECT
			CASE 3
				;마함발동
				TRYCALLFORM CARDNAME_{カードID}("カテゴリ")
				IF MATCH(RESULTS,"함정 속으로")
					PRINTFORMW 「네, 아쉽지~♪ 리버스 카드 오픈, 《%カード名%》이야❤」
				ELSE
					IF カード種 == 通常함정
						PRINTFORMW 「방심했지~? 리버스 카드 오픈, 《%カード名%》이야~♪」
					ELSE
						PRINTFORMW 「《%カード名%》의 효과를 발동할게~」
					ENDIF
				ENDIF
			CASE 4
				;묘지발동
				IF カード種 < モン全般
					PRINTFORMW 「묘지의 《%カード名%》의 효과를 발동할게~」
				ELSE
					PRINTFORMW 「쓰고 끝이 아니지~. 《%カード名%》의 효과, 발동~」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF



