@M_KOJO_MESSAGE_COM_K1373_80
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1373_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_80_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「どおー？　きもちいいー？」
		CASE 2
			PRINTFORMW 「すごい熱いねー……水ぶくれできちゃいそー♪」
		CASE 3
			PRINTFORMW 「しこしこー、しこしこー……❤　すごい熱くなってるねー❤」
		CASE 4
			PRINTFORML 「ふふふー……❤　もどかしいねー……❤」
			PRINTFORMW %CALLNAME:TARGET%は陰茎をさわさわと擽っている……
		CASE 5
			PRINTFORMW 「だーして❤　あつくて濃いの、わたしの手にいっぱいだーして❤」
	ENDSELECT
ENDIF
RETURN 1

