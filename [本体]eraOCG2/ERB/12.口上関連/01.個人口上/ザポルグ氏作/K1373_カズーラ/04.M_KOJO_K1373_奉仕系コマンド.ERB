;80,수음
;==================================================
@M_KOJO_MESSAGE_COM_K1373_80
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1373_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_80_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「어때~? 기분 좋아~?」
		CASE 2
			PRINTFORMW 「엄청 뜨겁네~... 물집 잡히겠어~♪」
		CASE 3
			PRINTFORMW 「스륵스륵~, 스륵스륵~...❤ 엄청 뜨거워지고 있네~❤」
		CASE 4
			PRINTFORML 「후후후~...❤ 애타지~...❤」
			PRINTFORMW %CALLNAME:TARGET%은/는 음경을 스르륵스륵 간지럽히고 있다...
		CASE 5
			PRINTFORMW 「내줘❤ 뜨겁고 진한 거, 내 손에 잔뜩 내줘❤」
	ENDSELECT
ENDIF
RETURN 1

;==================================================
;81,펠라치오
;==================================================
@M_KOJO_MESSAGE_COM_K1373_81
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1373_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_81_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;ファースト키스
		IF EXP:TARGET:Ｍ경험 == 0 && EXP:TARGET:펠라경험 == 1 && CALLNAME:(CFLAG:TARGET:키스상실상대) == CALLNAME:MASTER
			PRINTFORMW 
		;それ以外
		ELSE
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
		
	;お掃除펠라
	IF STAIN:MASTER:2 & 4 && ABL:TARGET:기교 >= 3
		PRINTFORMW 「응 츄릅... 츄릅... 츄르르릅...❤」
		PRINTFORMW 「푸하아... 에헤헤~❤ 맛있었어~❤」

	;通常
	ELSE
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORMW 「응헤헤~♪ 야한 액체 잔뜩 나오고 있네~♪」
			CASE 2
				PRINTFORMW 「응읍... 읍... 츄르릅... 낼름...❤」
			CASE 3
				PRINTFORMW 「츄릅... 꿀꺽... 낼름...❤」
			CASE 4
				PRINTFORMW 「츕❤ 낼름... 함... 츄르르르륵❤」
			CASE 5
				PRINTFORMW 「응~... 쪽❤ 츕❤츕❤ %CALLNAME:MASTER%한테 잔뜩 흔적 남겨야지~❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

