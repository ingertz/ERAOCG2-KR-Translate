@M_KOJO_MESSAGE_COM_K1373_0_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;삽입中
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	;V삽입
	IF LOCAL:1 && TEQUIP:50 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	;A삽입
	ELSEIF LOCAL:1 && TEQUIP:51 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF

	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「야하네~, 더 만져도 돼~♪」
		CASE 2
			PRINTFORMW 「잘한다 잘한다~♪ 여자 다루는 데 익숙하네~♪」
		CASE 3
			PRINTFORMW 「그래 그래~, 부드럽게 만져 줘~♪」
		;연모
		CASE 4
			PRINTFORMW 「기분 좋아~❤ %CALLNAME:MASTER%~, 더 해 줘~❤」
		CASE 5
			PRINTFORMW 「그렇게 만지는 거 좋아~❤ 온몸이 간질간질해~❤」
		;親愛
		CASE 6
			PRINTFORMW 「앙❤ 으앙❤ 몸이 녹아버릴 것 같아~❤」
		CASE 7
			PRINTFORMW 「아하❤ 아하하하❤ 즐겁네~, %CALLNAME:MASTER%~❤」
	ENDSELECT
ENDIF
RETURN 1
