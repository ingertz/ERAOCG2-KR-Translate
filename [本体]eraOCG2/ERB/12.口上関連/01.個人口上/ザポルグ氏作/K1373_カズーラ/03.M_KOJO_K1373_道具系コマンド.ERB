;40,로터
;クリトリスに当てる
;==================================================
@M_KOJO_MESSAGE_COM_K1373_40
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1373_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_40_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 0
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 0
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「이거 별로 안 좋아해……」
		CASE 2
			PRINTFORMW 「……재미없어~」
		CASE 3
			PRINTFORML 「…………」
			PRINTFORMW %CALLNAME:TARGET%는 음핵에서 떨리는 로터를 따분하게 보고 있다……
	ENDSELECT
ENDIF
RETURN 1

