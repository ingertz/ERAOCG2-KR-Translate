;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;便器開始
	IF CFLAG:TARGET:변기화
		PRINTFORMW 「えへへへー❤　いっぱい使ってねー❤」
	;終了
	ELSE
		PRINTFORMW 「あはは❤　すっごく楽しかったー❤」
	ENDIF
ENDIF

