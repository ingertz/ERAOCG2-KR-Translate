@M_KOJO_MESSAGE_COM_K1373_154_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	SELECTCASE TALENT:TARGET:가슴사이즈 
		;ひんぬー
		CASE -2,-1,0
			PRINTFORMW 「おおー、シトリスと同じくらいあるねー♪」
		;普通と爆乳
		CASE 1,2
			PRINTFORMW 「わー、ばいんばいんだー。　おもーい……」
		;泣いていいよ
		CASE -3
			PRINTFORMW 「……変わらないねー」
		;ウシ
		CASE 3
			PRINTFORMW 「うへー、つらいよー……たすけて%CALLNAME:MASTER%－……」
	ENDSELECT
ENDIF
RETURN 1
