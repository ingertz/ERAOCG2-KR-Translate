RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_205_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 0
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		PRINTFORMW 
	
	;それ以外
	ELSE
		PRINTFORMW 
	ENDIF
ENDIF
RETURN 1
[SKIPEND]

