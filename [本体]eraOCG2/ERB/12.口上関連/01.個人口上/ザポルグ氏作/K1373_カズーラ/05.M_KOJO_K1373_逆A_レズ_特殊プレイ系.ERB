;고통や쾌락のSOURCEをトリガーとして汎用あえぎ구상を作るとか
;いろいろ利用方法は考えられますが適当にやってください




;-------------------------------------------
;조교後の텍스트
;TFLAG:8 (1=TARGETがお掃除 2=ASSIがお掃除 3=TARGETとASSIがお掃除)
;-------------------------------------------
@M_KOJO_MESSAGE_PALAMCNG_C_K1373
CALL PALAM_MESSAGE_C
;처녀상실
IF TCVAR:파과
	;正真正銘처녀상실
	IF TCVAR:파과 == 1
	;再生처녀상실
	ELSEIF TCVAR:파과 == 2
	;無自覚非처녀상실
	ELSEIF TCVAR:파과 == -1
	ENDIF
ENDIF

;Ａ처녀상실
IF TCVAR:Ａ파과
	;正真正銘Ａ처녀상실
	IF TCVAR:Ａ파과 == 1
	;無自覚Ａ처녀상실
	ELSEIF TCVAR:Ａ파과 == -1
	ENDIF
ENDIF

;펠라で사정後のお掃除
IF (TCVAR:MASTER:112 == 1 || TCVAR:MASTER:112 == 2) && SELECTCOM == 81
	PRINTFORMW 
ENDIF
