LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:SELECTCOM분기
		CASE 1
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 「그렇게 만지는 거 좋아~, 더 해 줘~❤」
				CASE 1
					PRINTFORMW 「%CALLNAME:MASTER%, 좋아해~...❤」
				CASE 2
					PRINTFORMW 「꺄악~. 야해~, 변태~♪」
				CASE 3
					PRINTFORMW 「으음~, 볼이 늘어난다~」
				CASE 4
					PRINTFORMW 「아하하하~, 겨드랑이 간지럽히지 마~♪」
			ENDSELECT
		CASE 0
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「만지는 느낌 좋지~? 꼼꼼히 조절해 뒀으니까 말이야~♪」
				CASE 1
					PRINTFORMW 「너무 달려드네~, 그렇게 초조해하지 않아도 어디 안 가~♪」
				CASE 2
					PRINTFORMW 「아앙~, 뜨거워~. 화상 입을 것 같으니까 좀 떨어져 줘~」
			ENDSELECT
		CASE -1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「그렇게 힘주면 부러져 버려~, 고치기 힘드니까 살살 해 줘~」
				CASE 1
					PRINTFORMW 「꺄아~ 난폭해~. 그러면 암컷한테 미움받을 거야~」
				CASE 2
					PRINTFORMW 「거긴 안 돼~, 소중한 곳이니까~」
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1
