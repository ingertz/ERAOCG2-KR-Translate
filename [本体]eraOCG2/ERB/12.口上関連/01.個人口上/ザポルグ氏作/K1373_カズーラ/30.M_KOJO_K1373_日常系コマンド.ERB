;==================================================
;300,会話
;TFLAG:SELECTCOM분기(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより교양が4以上高い)
;TCVAR:302(0=会話可能 1=非연모時会話不能)
;MARK:반발각인(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;CFLAG:우후후(조교中の会話)
;CFLAG:변기화(肉便器の時の会話)
;==================================================
@M_KOJO_SUCCESS_COM_K1373_300
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K1373_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で구상色が付きません。
CALL TRAIN_MESSAGE
;구상メイン呼出
CALL M_KOJO_MESSAGE_COM_K1373_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_300_1
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 호감도修正２
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;「RAND:n」n面ダイスを振る
	;우후후中の会話
	IF CFLAG:TARGET:우후후
		IF TEQUIP:Ｖ섹스
			IF TEQUIP:체위 == 3
				SELECTCASE RAND:5
					CASE 0
						PRINTFORMW 「動きをゆるくして欲しいの？　どうしよっかなー♪」
					CASE 1
						PRINTFORMW 「中でびくびくしてるねー、上に乗られるのがそんなに好きなんだー❤」
					CASE 2
						PRINTFORMW 「お汁足りてるー？　欲しかったら言ってねー❤」
					CASE 3
						PRINTFORMW 「結構余裕そうだねー、じゃあもっと強めにしよっか❤」
					CASE 4
						PRINTFORML 「ふーん……大事な所、どろどろになってもいいんだー……」
						PRINTFORMW %CALLNAME:TARGET%に必死に言い訳した……
				ENDSELECT
			ELSE
				SELECTCASE RAND:5
					CASE 0
						PRINTFORMW 「どおー？　気持ちよくできてるー？」
					CASE 1
						IF TALENT:MASTER:형태 >= 6
							PRINTFORMW 「%CALLNAME:MASTER%のって結構大きいよねー、おいしそうでイイと思うよー♪」
						ELSEIF TALENT:MASTER:형태 <= 3
							PRINTFORMW 「%CALLNAME:MASTER%のって好きだよー、わたしに丁度いい大きさでさー❤」
						ELSE
							IF TALENT:TARGET:연모 == 2
								PRINTFORMW 「この大きさが好きだなー、%CALLNAME:MASTER%に愛されてるって感じがするしー❤」
							ELSE
								PRINTFORMW 「うんうん、気持ちいいよー♪　頭おかしくなりそー♪」
							ENDIF
						ENDIF
					CASE 2
						PRINTFORMW 「お汁足りてるー？　欲しかったら言ってねー❤」
					CASE 3
						PRINTFORM 「子供が欲しいー？　
						IF TALENT:TARGET:연모 == 2
							PRINTFORMW んー……考えとく……」
						ELSE
							PRINTFORMW わたしも欲しいなー❤」
						ENDIF
					CASE 4
						PRINTFORML 「ふーん……大事な所、どろどろになってもいいんだー……」
						PRINTFORMW %CALLNAME:TARGET%に必死に言い訳した……
				ENDSELECT
			ENDIF

		ELSE
			호감도修正２ = 4
			SIF TALENT:TARGET:연모 >= 1
				호감도修正２ += 2
			SELECTCASE RAND:호감도修正２ + 1
				CASE 1
					PRINTFORMW 「わたし、あんまり動きたくないからさー、%CALLNAME:MASTER%が動いてくれなーい？」
				CASE 2
					PRINTFORMW 「嫌いってわけじゃないけど、別に好きってわけじゃないかなー。　楽しませるのって結構疲れるしー」
				CASE 3
					PRINTFORMW 「くっつくのは好きかなー、자신で動かなくてもいーしー」
				CASE 4
					PRINTFORMW 「道具とかあんまり使わないでね？　あれ硬いから身体が削れちゃうんだよねー」
				CASE 5
					PRINTFORMW 「なんかして欲しいこととかあるー？　人間にできそうなことなら大体出来るよー♪」
				CASE 6
					PRINTFORMW 「%CALLNAME:MASTER%もさー、物好きだよねー。　人間じゃないのは分かってるのにさー♪」
			ENDSELECT
		ENDIF
	
	ELSEIF CFLAG:TARGET:데이트중
		IF CFLAG:MASTER:현재위치 == 場所_ラブホ
			IF ABL:TARGET:교양 >= 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「今日はここでするの？　ふーん……」
					CASE 1
						PRINTFORMW 「隣がちょっとうるさいねー……見に行ってみる？」
					CASE 2
						PRINTFORMW 「この部屋の入口に穴掘ったらさー、毎日二人くらい釣れると思うんだけど、どう？」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「日当たりも風通しも悪いなー、%CALLNAME:MASTER%の家の方がいいよー」
					CASE 1
						PRINTFORMW 「『휴식』とか言ってたけどさー、わたしは一晩くらいいてもいーよー？」
					CASE 2
						PRINTFORMW 「%CALLNAME:MASTER%ー……お水持ってきてー……」
				ENDSELECT
			ENDIF
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「歩くの疲れたー、%CALLNAME:MASTER%ーおんぶー」
				CASE 1
					PRINTFORMW 「変なの寄って来たらなんとかしてよねー、%CALLNAME:MASTER%が連れ出したんだからさー」
				CASE 2
					PRINTFORML 「あー……うんー……そうだねー……」
					PRINTFORMW %CALLNAME:TARGET%は雑に相槌を打っている……
				CASE 3
					PRINTFORMW 「あれ、おいしそーだねー」
			ENDSELECT
		ENDIF

	;日常会話
	ELSE
		;호감도修正、通常（연모系陥落なし）で８
		호감도修正 = 10
		;TARGETが【애처】だったら호감도修正に＋３
		SIF TALENT:TARGET:애처
			호감도修正 += 3
		;TARGETが【親愛】だったら호감도修正に＋３
		SIF TALENT:TARGET:연모 == 2
			호감도修正 += 3
		;TARGETが【연모】を得ていたら호감도修正に＋３
		SIF TALENT:TARGET:연모 >= 1
			호감도修正 += 3
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORMW 「話すのは嫌いじゃないよー、警戒解きやすくなるからねー♪」
			CASE 2
				PRINTFORMW 「お肉とか好きだねー、栄養いっぱいあるやつー」
			CASE 3
				PRINTFORMW 「動くのは好きじゃないかなー、そういう타입でもないしねー」
			CASE 4
				IF CFLAG:TARGET:지금복장 == 115
					PRINTFORMW 「服ー？　別にこのままでいいかなー、こういうの好きな人間多いしー」
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「%CALLNAME:MASTER%はさー、こういうのが好きなのー？」
							PRINTFORMW %CALLNAME:TARGET%は服をひらひらさせている……
						CASE 1
							PRINTFORMW 「前から思ってたけどさー、人間の服って종류多いよねー」
						CASE 2
							PRINTFORMW 「うえー……変な感じするー……」
					ENDSELECT
				ENDIF
			CASE 5
				PRINTFORMW 「あははー、おもしろーい♪」
			CASE 6
				PRINTFORMW 「仲良い子ー？　ティオとかプティカとかかなー。　あとアトラとフレシアとー……」
			CASE 7
				IF TALENT:TARGET:연모 == 2
					PRINTFORMW 「他の仲間に会ってみたいー？　食べられちゃうからダメー」
				ELSE
					PRINTFORMW 「今度森に行ってみなーい？　友達とか紹介したいしさー♪」
				ENDIF
			CASE 8
				PRINTFORMW 「いい匂いでしょー、みんなこれが大好きなんだよねー♪」
			CASE 9
				SELECTCASE GET_MONTH()
					CASE "春の月"
						PRINTFORMW 「すごしやすくていいねー、ずっとこうならいいのに」
					CASE "夏の月"
						PRINTFORMW 「最近ちょーしいいんだー、おやつがいっぱい取れてるからかなー？」
					CASE "秋の月"
						PRINTFORMW 「そろそろマズイねー……%CALLNAME:MASTER%ー、お部屋あったかくしといてねー」
					CASE "冬の月"
						PRINTFORMW 「もうむりー、お外出たくなーい、かれちゃうー」
				ENDSELECT
			CASE 10
				PRINTFORMW 「プティカは妹みたいなものかなー、ちょっと見た目が似てるんだよねー」
			;연모
			CASE 11
				PRINTFORMW 「んー？　近くないよー、いつもこのくらいじゃなーい？」
			CASE 12
				PRINTFORML 「%CALLNAME:MASTER%ー、ちょっとわたしの中入ってみなーい？　
				PRINTFORMW 　だいじょーぶ、溶かさないように気を付けるからさー❤」
			CASE 13
				PRINTFORMW 「蜜を飲みたいの？　……後で埋め合わせしてくれるならいーよー♪」
			;親愛
			CASE 14
				PRINTFORMW 「たまには家でだらだらしよーよー、わたしのお世話も大事でしょー？」
			CASE 15
				IF GETBIT(CFLAG:TARGET:기정사실,1)
					PRINTFORML 「えっちしようよー❤　%CALLNAME:MASTER%も我慢できないでしょー？」
					PRINTFORMW %CALLNAME:TARGET%は身体を押し付け、%CALLNAME:MASTER%の胸の上で指を躍らせている……
				ELSE
					PRINTFORMW 「もっとベタベタしてもいーよー❤　%CALLNAME:MASTER%の体温、好きだからさー❤」
				ENDIF
			CASE 16
				PRINTFORML 「この前他の女の子見てたよね？　別に、ダメとは言わないけどさー……」
				PRINTFORMW %CALLNAME:TARGET%は軽く足で小突いてきた……
			;애처
			CASE 17
				IF EXP:TARGET:출산경험 >= 1
					PRINTFORML 「オスっていっぱい子供欲しいんでしょー？
					PRINTFORMW 　もっと欲しくなったらいつでもいいよー❤」
				ELSE
					PRINTFORML 「ねーねー、人間って結婚したら子供を作るんでしょー？
					PRINTFORMW 　%CALLNAME:MASTER%が欲しいならわたしも欲しいなー」
				ENDIF
			CASE 18
				PRINTFORMW 「他の仲間ならまだ我慢できるけどさー。　他のメスが덱にいるの、あんまり好きじゃないんだよねー」
			CASE 19
				PRINTFORMW 「たまにはわたしの中に入ってみなーい？　怖いなら一緒に入ってあげるからさー……ね❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
