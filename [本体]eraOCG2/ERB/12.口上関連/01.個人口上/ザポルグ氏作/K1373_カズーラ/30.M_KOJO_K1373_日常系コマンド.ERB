@M_KOJO_MESSAGE_COM_K1373_305
SIF ABL:TARGET:친밀 >= 3
	CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1373_305_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_305_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF ABL:TARGET:친밀 >= 3
		호감도修正 = 3
		SIF ABL:TARGET:친밀 >= 6
			호감도修正 += 3
		SELECTCASE RAND:호감도修正
			CASE 0
				PRINTFORMW 「이상한 감촉이야~. 꺼끌꺼끌?하네~」
			CASE 1
				PRINTFORMW 「어때~? 너무 딱딱하진 않아~?」
			CASE 2
				PRINTFORMW 「착하다 착해~, 적당히 힘내~♪」
			CASE 3
				PRINTFORMW 「슬슬 눈을 감네~……♪」
			CASE 4
