;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;300,会話
;TFLAG:SELECTCOM분기(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより교양が4以上高い)
;TCVAR:302(0=会話可能 1=非연모時会話不能)
;MARK:반발각인(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;CFLAG:우후후(조교中の会話)
;CFLAG:변기화(肉便器の時の会話)
;==================================================
@M_KOJO_SUCCESS_COM_K1373_300
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K1373_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で구상色が付きません。
CALL TRAIN_MESSAGE
;구상メイン呼出
CALL M_KOJO_MESSAGE_COM_K1373_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_300_1
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 호감도修正２
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;「RAND:n」n面ダイスを振る
	;우후후中の会話
	IF CFLAG:TARGET:우후후
		IF TEQUIP:Ｖ섹스
			IF TEQUIP:체위 == 3
				SELECTCASE RAND:5
					CASE 0
						PRINTFORMW 「움직임을 느슨하게 해줬으면 좋겠어? 어떻게 할까나~♪」
					CASE 1
						PRINTFORMW 「안에서 옴찔옴찔하네~ 위에 올라타는 게 그렇게 좋아~?❤」
					CASE 2
						PRINTFORMW 「국물은 충분해~? 더 원하면 말해줘~❤」
					CASE 3
						PRINTFORMW 「꽤 여유로워 보이네~ 그럼 좀 더 세게 해볼까❤」
					CASE 4
						PRINTFORML 「흐음…… 중요한 곳, 질척질척해져도 괜찮은 거구나~……」
						PRINTFORMW %CALLNAME:TARGET%에게 필사적으로 변명했다……
				ENDSELECT
			ELSE
				SELECTCASE RAND:5
					CASE 0
						PRINTFORMW 「어때~? 기분 좋아~?」
					CASE 1
						IF TALENT:MASTER:형태 >= 6
							PRINTFORMW 「%CALLNAME:MASTER% 거 꽤 크네~ 맛있어 보여서 좋다고 생각해~♪」
						ELSEIF TALENT:MASTER:형태 <= 3
							PRINTFORMW 「%CALLNAME:MASTER% 거 좋아~ 나한테 딱 좋은 크기라서 말이야~❤」
						ELSE
							IF TALENT:TARGET:연모 == 2
								PRINTFORMW 「이 크기가 좋네~ %CALLNAME:MASTER%에게 사랑받고 있다는 느낌이 들고 말이야~❤」
							ELSE
								PRINTFORMW 「응응, 기분 좋아~♪ 머리가 이상해질 것 같아~♪」
							ENDIF
						ENDIF
					CASE 2
						PRINTFORMW 「국물은 충분해~? 더 원하면 말해줘~❤」
					CASE 3
						PRINTFORM 「아이가 갖고 싶어~? 
						IF TALENT:TARGET:연모 == 2
							PRINTFORMW 음~…… 생각해볼게……」
						ELSE
							PRINTFORMW 나도 갖고 싶네~❤」
						ENDIF
					CASE 4
						PRINTFORML 「흐음…… 중요한 곳, 질척질척해져도 괜찮은 거구나~……」
						PRINTFORMW %CALLNAME:TARGET%에게 필사적으로 변명했다……
				ENDSELECT
			ENDIF

		ELSE
			호감도修正２ = 4
			SIF TALENT:TARGET:연모 >= 1
				호감도修正２ += 2
			SELECTCASE RAND:호감도修正２ + 1
				CASE 1
					PRINTFORMW 「나, 별로 움직이고 싶지 않으니까 말이야~, %CALLNAME:MASTER%가 움직여주지 않을래~?」
				CASE 2
					PRINTFORMW 「싫어하는 건 아니지만, 딱히 좋아하는 건 아닌 것 같아~. 즐겁게 해주는 게 꽤 피곤하기도 하고~」
				CASE 3
					PRINTFORMW 「달라붙는 건 좋을지도~, 스스로 움직이지 않아도 되니까 말이야~」
				CASE 4
					PRINTFORMW 「도구 같은 건 너무 쓰지 마? 그거 딱딱하니까 몸이 깎여나가 버린단 말이야~」
				CASE 5
					PRINTFORMW 「뭐 해줬으면 하는 거 있어~? 인간이 할 수 있는 일이라면 대체로 다 할 수 있어~♪」
				CASE 6
					PRINTFORMW 「%CALLNAME:MASTER%도 참, 별난 취향이네~. 인간이 아니라는 건 알고 있으면서~♪」
			ENDSELECT
		ENDIF
	
	ELSEIF CFLAG:TARGET:데이트중
		IF CFLAG:MASTER:현재위치 == 場所_ラブホ
			IF ABL:TARGET:교양 >= 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「오늘은 여기서 하는 거야? 흐음……」
					CASE 1
						PRINTFORMW 「옆집이 좀 시끄럽네~……구경 가볼까?」
					CASE 2
						PRINTFORMW 「이 방 입구에 구멍 파면 말이야~, 매일 두 명 정도 낚일 것 같은데, 어때?」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「햇볕도 잘 안 들고 바람도 잘 안 통하네~, %CALLNAME:MASTER% 집이 더 좋아~」
					CASE 1
						PRINTFORMW 「『휴식』이라고 말했지만 말이야~, 나는 하룻밤 정도 있어도 괜찮아~?」
					CASE 2
						PRINTFORMW 「%CALLNAME:MASTER%~……물 가져다줘~……」
				ENDSELECT
			ENDIF
		ELSE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「걷는 거 지쳤어~, %CALLNAME:MASTER%~ 업어줘~」
				CASE 1
					PRINTFORMW 「이상한 놈이 다가오면 어떻게든 해 줘~, %CALLNAME:MASTER%가 데리고 나왔으니까 말이야~」
				CASE 2
					PRINTFORML 「아~……응~……그렇네~……」
					PRINTFORMW %CALLNAME:TARGET%는 대충 맞장구를 치고 있다……
				CASE 3
					PRINTFORMW 「어라, 맛있어 보이네~」
			ENDSELECT
		ENDIF

	;日常会話
	ELSE
		;호감도修正、通常（연모系陥落なし）で８
		호감도修正 = 10
		;TARGETが【애처】だったら호감도修正に＋３
		SIF TALENT:TARGET:애처
			호감도修正 += 3
		;TARGETが【親愛】だったら호감도修正に＋３
		SIF TALENT:TARGET:연모 == 2
			호감도修正 += 3
		;TARGETが【연모】を得ていたら호감도修正に＋３
		SIF TALENT:TARGET:연모 >= 1
			호감도修正 += 3
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORMW 「말하는 건 싫어하지 않아~, 경계를 풀기 쉬워지니까 말이야~♪」
			CASE 2
				PRINTFORMW 「고기 같은 거 좋아해~, 영양 잔뜩 있는 거~」
			CASE 3
				PRINTFORMW 「움직이는 건 별로 안 좋아해~, 그런 타입도 아니고 말이야~」
			CASE 4
				IF CFLAG:TARGET:지금복장 == 115
					PRINTFORMW 「옷~? 딱히 이대로도 괜찮을까~, 이런 거 좋아하는 인간 많고 말이야~」
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「%CALLNAME:MASTER%는 말이야~, 이런 걸 좋아하는 거야~?」
							PRINTFORMW %CALLNAME:TARGET%는 옷을 팔랑거리고 있다……
						CASE 1
							PRINTFORMW 「전부터 생각했는데 말이야~, 인간 옷은 종류가 많더라~」
						CASE 2
							PRINTFORMW 「으으~... 뭔가 이상한 느낌이야~...」
					ENDSELECT
				ENDIF
			CASE 5
				PRINTFORMW 「아하하~, 재밌다~♪」
			CASE 6
				PRINTFORMW 「친한 애 말이야~? 티오나 푸티카 같은 애들일까~. 그리고 아트라랑 플레시아랑~...」
			CASE 7
				IF TALENT:TARGET:연모 == 2
					PRINTFORMW 「다른 동료들 만나보고 싶어~? 잡아먹힐 테니까 안 돼~」
				ELSE
					PRINTFORMW 「다음에 숲에 가볼래~? 친구들 소개해 주고 싶기도 하고 말이야~♪」
				ENDIF
			CASE 8
				PRINTFORMW 「좋은 냄새 나지~? 다들 이거 엄청 좋아하거든~♪」
			CASE 9
				SELECTCASE GET_MONTH()
					CASE "봄의 달"
						PRINTFORMW 「지내기 편하고 좋네~, 계속 이랬으면 좋겠다~」
					CASE "여름의 달"
						PRINTFORMW 「요즘 컨디션 완전 좋아~, 간식을 많이 얻어서 그런 걸까~?」
					CASE "가을의 달"
						PRINTFORMW 「슬슬 위험하네~... %CALLNAME:MASTER%~, 방 따뜻하게 해 둬~」
					CASE "겨울의 달"
						PRINTFORMW 「이제 무리야~, 밖에 나가기 싫어~, 말라 죽을 것 같아~」
				ENDSELECT
			CASE 10
				PRINTFORMW 「푸티카는 여동생 같은 걸까~, 살짝 모습이 닮았거든~」
			;연모
			CASE 11
				PRINTFORMW 「으음~? 안 가까운데~, 늘 이 정도 아니었어~?」
			CASE 12
				PRINTFORML 「%CALLNAME:MASTER%~, 잠깐 내 안으로 들어와 볼래~?
				PRINTFORMW　괜찮아, 안 녹게 조심할 테니까 말이야~❤」
			CASE 13
				PRINTFORMW 「꿀을 마시고 싶어? ...나중에 보상해 준다면 좋아~♪」
			;親愛
			CASE 14
				PRINTFORMW 「가끔은 집에서 빈둥거리자~, 날 돌보는 것도 중요하잖아~?」
			CASE 15
				IF GETBIT(CFLAG:TARGET:기정사실,1)
					PRINTFORML 「야한 짓 하자~❤ %CALLNAME:MASTER%도 참을 수 없잖아~?」
					PRINTFORML %CALLNAME:TARGET%은/는 몸을 밀착시키고, %CALLNAME:MASTER%의 가슴 위에서 손가락을 춤추게 하고 있다……
				ELSE
					PRINTFORMW 「더 끈적끈적해도 좋아~❤ %CALLNAME:MASTER%의 체온, 좋으니까 말이야~❤」
				ENDIF
			CASE 16
				PRINTFORML 「저번에 다른 여자애 보고 있었잖아? 딱히 안 된다곤 안 하는데 말이지~...」
				PRINTFORMW %CALLNAME:TARGET%은 가볍게 발로 툭 쳤다...
			;애처
			CASE 17
				IF EXP:TARGET:출산경험 >= 1
					PRINTFORML 「수컷들은 애 많이 갖고 싶어 하잖아~?
					PRINTFORMW 　더 갖고 싶어지면 언제든지 좋아~❤」
				ELSE
					PRINTFORML 「저기저기~, 사람은 결혼하면 아이를 갖는 거잖아~?
					PRINTFORMW 　%CALLNAME:MASTER%이 원한다면 나도 원해~」
				ENDIF
			CASE 18
				PRINTFORMW 「다른 동료라면 아직 참을 수 있지만 말이야~. 다른 암컷이 덱에 있는 건 별로 안 좋아해~」
			CASE 19
				PRINTFORMW 「가끔은 내 안에 들어와 보지 않을래~? 무섭다면 같이 들어가 줄 테니까 말이야~... 응?❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
