;==================================================
;480,デュエル
;勝敗はプレイヤーから見てのもの
;TFLAG:SELECTCOM분기(1=通常승리 2=通常패배 3=引き分け
;10=通常듀얼前 11=パック賭け듀얼前 12=데이트賭け듀얼前 13=パンツ賭け듀얼前 14=お持ち帰り듀얼前 15=お前モンスターじゃないか？ 16=スケベ要求듀얼前 20=闇のゲーム
;31=パック賭け승리 32=데이트賭け승리 33=パンツ賭け승리 34=お持ち帰り成功 35=カード化승리（牝以外） 36=スケベ要求事後 40=罰ゲーム！
;135=カード化見逃す 235=穏便カード化 335=凌辱後カード化 435=凌辱後見逃す
;50=賭け듀얼패배怒られた 51=パック賭け패배 52=데이트패배데이트 55=カード化패배 56=スケベ要求패배 156=スケベ要求弱味削除 256=スケベ要求패배패배버릇付きおねだり)
;==================================================
@M_KOJO_MESSAGE_COM_K1373_480
;デュエルにTRAIN_MESSAGEはない
CALL M_KOJO_MESSAGE_COM_K1373_480_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_480_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;これが０の時はデュエルしない時なのでおわり
	SIF TFLAG:SELECTCOM분기 == 0
		RETURN 1

	;デュエル前
	IF INRANGE(TFLAG:SELECTCOM분기,10,21)
		SELECTCASE TFLAG:SELECTCOM분기
			;通常듀얼
			CASE 10
				PRINTFORMW 「듀얼~? 좋아~♪」
			
			;ここから賭け듀얼
			;パック賭け
			CASE 11
				PRINTFORMW 「이겼으면 팩이네~, 좋아~♪」
			;데이트賭け
			CASE 12
				PRINTFORMW 「듀얼 같은 거 안 해도, 부탁하면 해줄 텐데~」
			;パンツ賭け
			CASE 13
				PRINTFORMW 「팬티 같은 게 갖고 싶어~? 괜찮긴 한데~」
			;お持ち帰り
			CASE 14
				PRINTFORMW 「요즘 막 뿌리내린 참이라, 아직 움직이고 싶지 않아~」
			;モンスターか問い詰める（人間は불가）
			CASE 15
				PRINTFORMW 「들켜버렸으면 어쩔 수 없네~, 듀얼로 입막음할게~」
			;スケベ強要
			CASE 16
				PRINTFORMW 「야한 짓 할 거야~? 나한테 이기고 나서야~♪」
			;闇のゲーム
			CASE 20
				PRINTFORMW 「우와, 뭐야 이거~?」
		ENDSELECT

	;デュエル後
	ELSE
		SELECTCASE TFLAG:SELECTCOM분기
			;通常승리
			CASE 1
				PRINTFORMW 「져버렸어~, 강하네~%CALLNAME:MASTER%~♪」
			;通常패배
			CASE 2
				PRINTFORMW 「내 승리~, 다시 도전하러 와~♪」
			;通常引き分け
			CASE 3
				PRINTFORMW 「오~ 무승부네~, 희귀하다~♪」

			;ここから賭け승리
			;パック賭け
			CASE 31
				PRINTFORMW 「좋은 거 나왔어~? 좋은 거 있으면 줘~❤」
			;데이트賭け
			CASE 32
				PRINTFORMW 「와~, 데이트다~. 어디로 데려가 줄 거야~?」
			;パンツ賭け
			CASE 33
				IF PALAM:윤활 >= PALAMLV:3
					PRINTFORMW 「축축하네~, 어때? 기뻐?」
				ELSE
					PRINTFORMW 「음~, 좀 더 국물을 묻혀 놓는 게 좋을까~?」
				ENDIF
			;お持ち帰り
			CASE 34
				PRINTFORMW 「꺄~, %CALLNAME:MASTER%의 집에 끌려가 버려~❤」
			;下二桁３５は"モンスターか問い詰める"の분기
			;カード化（牝以外、選択肢無し）
			CASE 35
				PRINTFORMW 
			;カード化を見逃す（元気でな！）
			CASE 135
				PRINTFORMW 「바이바이~, 고마워~♪」
			;穏便に話してカード化（怖くないよ～痛くないよ～）
			CASE 235
				PRINTFORMW 「카드 속도 나쁘지 않네~, 그래도 가끔은 밖으로 꺼내 줬으면 좋겠어~」
			;身体を対価に見逃す（見逃すとは言ってない）
			CASE 335
				PRINTFORMW 「으, 거짓말쟁이~……」
			;身体を対価に見逃す（見逃す）（패배버릇付いたり弱み握られたりする）
			CASE 435
				PRINTFORMW 「으~…… 다음엔 안 질 거야~」
			;身体要求事後
			CASE 36
				PRINTFORMW 「즐거웠어~, 또 하자~♪」
			;闇のゲーム
			CASE 40

			;ここから賭け패배
			;怒られた
			CASE 50
				PRINTFORMW 「아무것도 안 뺏겠지만~, 좀 생각하는 게 좋을걸~?」
			;パック賭け（パックを手渡す）
			CASE 51
				PRINTFORMW 「와~이, 팩 잘 먹었다~♪」
			;데이트賭け（데이트はしてくれる）
			CASE 52
				PRINTFORMW 「어쩔 수 없네~, 조금만 놀아줄게~♪」
			;カード化패배（逃げられた）
			CASE 55
				PRINTFORMW 「바이바이~, %CALLNAME:MASTER%가 약해서 좋았어~♪」
			;身体要求패배（金払う）
			CASE 56
				PRINTFORMW 「응후후~, 이걸로 비료나 고기 같은 거 사러 갈 수 있겠네~♪」
			;身体要求패배（弱味削除）
			CASE 156
				PRINTFORMW 「미안해~.　뭔가, 남겨두면 안 좋다더라~」
			;身体要求패배（패배버릇付いてる時限定凌辱おねだり）（ラブホ直行）
			CASE 256
				PRINTFORMW 「에헤헤~, 내가 이겼으니까 됐지~❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

;==================================================
;600,散策する
;데이트중の場合、CFLAG:현재위치に이동先の場所が既に入ってる
;==================================================
;流れるタイミングは이동後
;場所の名前は ERB/05.コマンド関連/이동関連（이동コマンド、COMF 400含む）/COMMON_PLACE に書いてある
@M_KOJO_MESSAGE_COM_K1373_600
;散策するにはTRAIN_MESSAGEが無い
CALL M_KOJO_MESSAGE_COM_K1373_600_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_600_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:MASTER:현재위치 == 場所_森
		PRINTFORMW 「편안하다~, 잠시 여기 있자~?」
	ELSEIF GROUPMATCH(CFLAG:MASTER:현재위치,場所_釣り堀,場所_砂浜)
		PRINTFORMW 「너무 짜~.　%CALLNAME:MASTER%~, 얼른 떨어지자~?」
	ELSE
		PRINTFORMW 「여기서 뭐 하는 거야~?」
	ENDIF
ENDIF
RETURN 1
;==================================================
;605,家に誘う
;TFLAG:SELECTCOM분기(1=大成功 0=成功 -1=失敗)(地の文無し
;==================================================
@M_KOJO_SUCCESS_COM_K1373_605
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K1373_605
;家に誘うにはTRAIN_MESSAGEが無い
CALL M_KOJO_MESSAGE_COM_K1373_605_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_605_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TFLAG:SELECTCOM분기 == 1 || TFLAG:SELECTCOM분기 == 0
		PRINTFORMW 「좋아~, 가자 가자~.　데려가 줘~♪」
	ELSE
		PRINTFORMW 「으음~, 다음에 하자~」
	ENDIF
ENDIF
RETURN 1

;==================================================
;617,甘味処に誘う
;TFLAG:SELECTCOM분기(1=大成功 0=成功 -1=失敗)(地の文분기は大成功のみ추가
;==================================================
@M_KOJO_SUCCESS_COM_K1373_617
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K1373_617
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1373_617_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_617_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:SELECTCOM분기
		CASE 1,0
			PRINTFORMW 「이거 좋네~, 한 10개 정도 더 갖고 싶네~♪」
		CASE -1
			PRINTFORMW 「우웩~, 설탕 너무 많아서 못 먹겠어~」
	ENDSELECT
ENDIF
RETURN 1
