;==================================================
;480,デュエル
;勝敗はプレイヤーから見てのもの
;TFLAG:SELECTCOM분기(1=通常승리 2=通常패배 3=引き分け
;10=通常듀얼前 11=パック賭け듀얼前 12=데이트賭け듀얼前 13=パンツ賭け듀얼前 14=お持ち帰り듀얼前 15=お前モンスターじゃないか？ 16=スケベ要求듀얼前 20=闇のゲーム
;31=パック賭け승리 32=데이트賭け승리 33=パンツ賭け승리 34=お持ち帰り成功 35=カード化승리（牝以外） 36=スケベ要求事後 40=罰ゲーム！
;135=カード化見逃す 235=穏便カード化 335=凌辱後カード化 435=凌辱後見逃す
;50=賭け듀얼패배怒られた 51=パック賭け패배 52=데이트패배데이트 55=カード化패배 56=スケベ要求패배 156=スケベ要求弱味削除 256=スケベ要求패배패배버릇付きおねだり)
;==================================================
@M_KOJO_MESSAGE_COM_K1373_480
;デュエルにTRAIN_MESSAGEはない
CALL M_KOJO_MESSAGE_COM_K1373_480_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_480_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;これが０の時はデュエルしない時なのでおわり
	SIF TFLAG:SELECTCOM분기 == 0
		RETURN 1

	;デュエル前
	IF INRANGE(TFLAG:SELECTCOM분기,10,21)
		SELECTCASE TFLAG:SELECTCOM분기
			;通常듀얼
			CASE 10
				PRINTFORMW 「듀얼ー？　いいよー♪」
			
			;ここから賭け듀얼
			;パック賭け
			CASE 11
				PRINTFORMW 「勝ったらパックだねー、いいよー♪」
			;데이트賭け
			CASE 12
				PRINTFORMW 「듀얼なんてしなくても、お願いすればしてあげるのになー」
			;パンツ賭け
			CASE 13
				PRINTFORMW 「パンツなんかが欲しいのー？　いいけどさー」
			;お持ち帰り
			CASE 14
				PRINTFORMW 「最近根っこ付いたばっかだから、まだ動きたくないんだよねー」
			;モンスターか問い詰める（人間は불가）
			CASE 15
				PRINTFORMW 「バレちゃったらしかたないねー、듀얼で口封じするよー」
			;スケベ強要
			CASE 16
				PRINTFORMW 「えっちするのー？　わたしに勝ってからねー♪」
			;闇のゲーム
			CASE 20
				PRINTFORMW 「うわ、なにこれー？」
		ENDSELECT

	;デュエル後
	ELSE
		SELECTCASE TFLAG:SELECTCOM분기
			;通常승리
			CASE 1
				PRINTFORMW 「負けちゃったー、強いねー%CALLNAME:MASTER%ー♪」
			;通常패배
			CASE 2
				PRINTFORMW 「わたしの勝ちー、でなおして来てねー♪」
			;通常引き分け
			CASE 3
				PRINTFORMW 「おー引き分けだー、珍しいねー♪」

			;ここから賭け승리
			;パック賭け
			CASE 31
				PRINTFORMW 「いいの出たー？　いいのあったらちょーだーい❤」
			;데이트賭け
			CASE 32
				PRINTFORMW 「わーい、데이트だー。　どこに連れてってくれるのー？」
			;パンツ賭け
			CASE 33
				IF PALAM:윤활 >= PALAMLV:3
					PRINTFORMW 「びちょびちょだねー、どう？　うれしい？」
				ELSE
					PRINTFORMW 「んー、もうちょっとお汁付けといた方がいいかなー？」
				ENDIF
			;お持ち帰り
			CASE 34
				PRINTFORMW 「きゃー、%CALLNAME:MASTER%のおうちに連れていかれちゃうー❤」
			;下二桁３５は"モンスターか問い詰める"の분기
			;カード化（牝以外、選択肢無し）
			CASE 35
				PRINTFORMW 
			;カード化を見逃す（元気でな！）
			CASE 135
				PRINTFORMW 「ばいばーい、ありがとねー♪」
			;穏便に話してカード化（怖くないよ～痛くないよ～）
			CASE 235
				PRINTFORMW 「カードの中も悪くないねー、でもたまには外に出してほしいなー」
			;身体を対価に見逃す（見逃すとは言ってない）
			CASE 335
				PRINTFORMW 「う、うそつきー……」
			;身体を対価に見逃す（見逃す）（패배버릇付いたり弱み握られたりする）
			CASE 435
				PRINTFORMW 「うー……今度は負けないからねー」
			;身体要求事後
			CASE 36
				PRINTFORMW 「楽しかったよー、またしようねー♪」
			;闇のゲーム
			CASE 40

			;ここから賭け패배
			;怒られた
			CASE 50
				PRINTFORMW 「何も取らないけどさー、ちょっとは考えた方がいいよー？」
			;パック賭け（パックを手渡す）
			CASE 51
				PRINTFORMW 「わーい、パックごちそうさまー♪」
			;데이트賭け（데이트はしてくれる）
			CASE 52
				PRINTFORMW 「しょーがないなー、ちょっとだけ遊んであげるー♪」
			;カード化패배（逃げられた）
			CASE 55
				PRINTFORMW 「ばいばーい、%CALLNAME:MASTER%がよわよわでよかったー♪」
			;身体要求패배（金払う）
			CASE 56
				PRINTFORMW 「んふふー、これで肥料とかおにくとか買いにいけるねー♪」
			;身体要求패배（弱味削除）
			CASE 156
				PRINTFORMW 「ごめんねー。　なんか、残しとくとよくないらしいんだよねー」
			;身体要求패배（패배버릇付いてる時限定凌辱おねだり）（ラブホ直行）
			CASE 256
				PRINTFORMW 「えへへー、わたしが勝ったんだからいいよねー❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

