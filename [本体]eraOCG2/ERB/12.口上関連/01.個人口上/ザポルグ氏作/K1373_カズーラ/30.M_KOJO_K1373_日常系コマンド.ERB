IF LOCAL
	;-------------------------------------------------
	;記入チェック（=0, 非표시、1, 표시）
	;질내사정횟수분기
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:TARGET:질내사정횟수 > 0
		SELECTCASE TCVAR:TARGET:질내사정횟수
			CASE 1 TO 5
				PRINTFORMW 「나온 게 신경 쓰여~? 제대로 소중히 받아줄 테니까~❤」
			CASE 6 TO 15
				PRINTFORMW 「후후훗~, 이것만 있으면 꽤 오래가겠네~♪」
			CASE 16 TO 50
				PRINTFORMW 「가득 들어있으니까 부드럽게 만져 줘~, 새 버리니까 말이야~」
			CASEELSE
				PRINTFORMW 「케픗……%CALLNAME:MASTER%은(는) 끝도 없으니까~❤」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	SELECTCASE TFLAG:SELECTCOM분기
		CASE 1
			IF CFLAG:TARGET:임신경과 >= 10
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「커지고 있네~, 어때? 기대돼?」
					CASE 1
						PRINTFORMW 「오, 움직였다. %CALLNAME:MASTER%가 쓰다듬어줘서 기쁜 걸까~♪」
					CASE 2
						PRINTFORMW 「신기하다 그치~, 내 몸이 이렇게 되어버리다니 말이야~♪」
				ENDSELECT
			ELSEIF CFLAG:TARGET:임신경과
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「몸 안에 뭐가 있는 건 이상한 느낌이야~, 벌레하고도 좀 다르고 말이야~」
					CASE 1
						IF EXP:TARGET:출산경험 >= 1
							PRINTFORMW 「아직은 작네~, 금방 커지겠지만 말이야~♪」
						ELSE
							PRINTFORMW 「자라고 있는 감각은 있는데 말이야~, 정말 나만큼 커질까~」
						ENDIF
					CASE 2
						PRINTFORMW 「요즘은 영양분 소모가 심해지고 있네~. %CALLNAME:MASTER%~, 영양 듬뿍 담긴 밥 부탁해~❤」
				ENDSELECT
			ENDIF
		CASEELSE
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 「으음~? 배가 신경 쓰여~?」
				CASE 1
					PRINTFORMW 「말랑말랑하고 부드럽지~, 쓸데없는 부분 같은 건 없으니까 말이야~♪」
				CASE 2
					PRINTFORMW 「배꼽만 계속 만지네~, 좋아해?」
				CASE 3
					PRINTFORMW 「그러고 보니 개한테 이거 해주는 거 본 적 있는데~, 나도 눕는 게 나으려나~?」
				CASE 4
					PRINTFORMW 「『가늘다』~? 사람 배는 대개 이 정도 아니었어~?」
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1
