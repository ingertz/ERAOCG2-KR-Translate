;TCVAR:질내사정횟수(1to5=子種入り 6to15=たっぷり 16to50=どっぷり 51以上=ぽってり)
;==================================================
@M_KOJO_MESSAGE_COM_K1373_306
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1373_306_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1373_306_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;記入チェック（=0, 非표시、1, 표시）
	;질내사정횟수분기
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:TARGET:질내사정횟수 > 0
		SELECTCASE TCVAR:TARGET:질내사정횟수
			CASE 1 TO 5
				PRINTFORMW 「出したのが気になるー？　ちゃんと大事にいただくからねー❤」
			CASE 6 TO 15
				PRINTFORMW 「ふふふーん、これだけあれば結構もつねー♪」
			CASE 16 TO 50
				PRINTFORMW 「いっぱい入ってるから優しく触ってねー、漏れちゃうからさー」
			CASEELSE
				PRINTFORMW 「けぷ……%CALLNAME:MASTER%ったら底なしなんだからー❤」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	SELECTCASE TFLAG:SELECTCOM분기
		CASE 1
			IF CFLAG:TARGET:임신경과 >= 10
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「大きくなってきたねー、どう？　楽しみ？」
					CASE 1
						PRINTFORMW 「お、動いた。　%CALLNAME:MASTER%に撫でられてうれしいのかなー♪」
					CASE 2
						PRINTFORMW 「不思議だよねー、わたしの身体がこんなになっちゃうなんてさー♪」
				ENDSELECT
			ELSEIF CFLAG:TARGET:임신경과
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「身体の中になにかあるのって変な感じー、虫ともちょっと違うしさー」
					CASE 1
						IF EXP:TARGET:출산경험 >= 1
							PRINTFORMW 「まだまだ小さいねー、すぐに大きくなるんだけどさー♪」
						ELSE
							PRINTFORMW 「育ってる감각はあるんだけどさー、ホントにわたしくらい大きくなるのかなー」
						ENDIF
					CASE 2
						PRINTFORMW 「最近は養分の消費が激しくなってきてるねー。　%CALLNAME:MASTER%ー、栄養たっぷりのごはんお願いねー❤」
				ENDSELECT
			ENDIF
		CASEELSE
			SELECTCASE RAND:5
				CASE 0
