;※※※※※※※※※※※※※※※※※※※※※※※※※
;CARD用구상
;※※※※※※※※※※※※※※※※※※※※※※※※※
;直接カードのIDを使える。
;캐릭터が無くても動く
;存在証明
@M_KOJO_CARD_K39570
RETURN 1
;==================================================
;0,モンスター소환時
;==================================================
@M_KOJO_CARD_K39570_0(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「이히히❤ 간다~❤」
ENDIF

;==================================================
;1,攻撃時
;==================================================
@M_KOJO_CARD_K39570_1(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「에잇❤」
ENDIF

;==================================================
;2,효과발동
;==================================================
;효과別で鳴らしたいなら、直接カードのデータを見て、설정する必要がある
;面倒、分からないであれば분기はせず
;失敗판정は、いわゆる효과를 無効にされたとかそういうやつ
@M_KOJO_CARD_K39570_2(종류,失敗판정)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 종류
#DIM DYNAMIC 失敗판정
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 失敗판정 == 0
		PRINTFORMW 「에이, 너무해~」
	ELSE
		IF 종류 == 소환時 || 종류 == 특수소환時
			PRINTFORMW 「이리와~❤」
		ELSEIF 종류 == 필드起動
			PRINTFORMW 「이히히❤ 모여라~❤」
		ELSEIF 종류 == 효과後誘発
			PRINTFORMW 「자, 퐁당❤」
		ELSEIF 종류 == 攻撃時誘発
			PRINTFORMW 「어서와~❤」
		ENDIF
	ENDIF
ENDIF

;==================================================
;3,除去時
;==================================================
;いちいちなんでも除去で話すとやかましいため、デフォでは破壊にのみ反応するように설정
@M_KOJO_CARD_K39570_3(除去종류,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 除去종류
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 除去종류
		CASE 破壊行き,戦闘破壊行き
			PRINTFORMW 「또 봐~❤」
	ENDSELECT
ENDIF

