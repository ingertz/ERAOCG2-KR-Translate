					PRINTFORML 「손패とかフィールドから묘지へ送られても융합できるようにならないかしら・・・」
				CASE 2
					PRINTFORML 「あの男 이외의 初動が欲しい・・・！」
			ENDSELECT
		;덱のアドバイス要求
		CASE 6
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「サンボルも羽箒もいらないわよ、패에 ある時しか役に立たないし」
				CASE 1
					PRINTFORML 「何でそんな変なカード知ってるのよ・・・？」
				CASE 2
					PRINTFORML 「『現世と冥界』はあんまり相性よくないのよね・・・素材にできないし」
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1

