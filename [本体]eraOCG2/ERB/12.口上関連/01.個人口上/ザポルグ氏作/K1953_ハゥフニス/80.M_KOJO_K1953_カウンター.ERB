;==================================================
;파이즈리
;==================================================
@M_KOJO_MESSAGE_COUNTER_K1953_504
#DIM DYNAMIC CTおさわり確認
#DIM DYNAMIC 호감도修正
CALL EVENT_COUNTER_MESSAGE(CTおさわり確認)
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;MASTERが절정
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:MASTER:전턴절정
		SELECTCASE RAND:3 + 1
			CASE 1
				PRINTFORML 「うわ・・・胸が真っ白じゃない・・・❤」
			CASE 2
				PRINTFORML 「あっつ・・・❤　ヤケドしそう・・・❤」
			CASE 3
				PRINTFORML 「はぁ・・・❤　すごい臭い・・・❤」
		ENDSELECT
		RETURN 1
	ENDIF

	;基本セット
	SELECTCASE TCVAR:TARGET:전CT파생
		CASE 1
			;胸で挟む
			IF BUST_SIZE(TARGET) > 0
				SELECTCASE RAND:3 + 1
					CASE 1
						PRINTFORML 「ほら、動かないでジッとしてなさい❤」
					CASE 2
						PRINTFORML 「顔、とろけて来てるわよ❤」
					CASE 3
						PRINTFORML 「ふふ・・・胸の中でビクビクしてる・・・❤」
				ENDSELECT
			;乳首擦り付け
			ELSE
				SELECTCASE RAND:2 + 1
					CASE 1
						PRINTFORML 「ふぅ・・・ふぅ・・・んっ❤」
					CASE 2
						PRINTFORML 「はぁ・・・んっ❤　・・・どう？」
				ENDSELECT
			ENDIF
		;縦파이즈리、乳ファック（MASTER主導）（豊満前提）
		CASE 2
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「そんなに必死にならなくても、最後までシてあげるわよ❤」
				CASE 1
					PRINTFORML 「んっ・・・❤　もう少し、強めに叩きつけてもいいわよ？❤」
				CASE 2
					PRINTFORML 「まったく・・・ホント男っておっぱい好きよね❤」
			ENDSELECT
		;谷間を作る
		CASE 3
			;なんとか挟もうとする（並未満）
			IF BUST_SIZE(TARGET) < 0
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「ん・・・しょ・・・難しいわね・・・」
					CASE 1
						PRINTFORML 「・・・ねえ、もうちょっと大きくできない？」
					CASE 2
						PRINTFORML 「ん・・・今、ちょっとビクってなった？❤」
				ENDSELECT
			;上半身を激しく動かす
			ELSE
				SELECTCASE RAND:3 + 1
					CASE 1
						PRINTFORML 「ほら、動かないでジッとしてなさい❤」
					CASE 2
						PRINTFORML 「顔、とろけて来てるわよ❤」
					CASE 3
						PRINTFORML 「ふふ・・・胸の中でビクビクしてる・・・❤」
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF
RETURN 1

