;-------------------------------------------------
;==================================================
;色っぽい仕草
;==================================================
@M_KOJO_MESSAGE_COUNTER_K1953_10
#DIM DYNAMIC CTおさわり確認
#DIM DYNAMIC 호감도修正
CALL EVENT_COUNTER_MESSAGE(CTおさわり確認)
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;基本セット
	호감도修正 = 1
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORML 「ちょっと暑いわね・・・❤」
			PRINTFORML %CALLNAME:TARGET%は服をぱたぱたとさせている・・・
		CASE 2
			PRINTFORML 「んん・・・ふぅ・・・❤」
			PRINTFORML %CALLNAME:TARGET%は腋を見せつけるように伸びをした・・・
		CASE 3
			PRINTFORML 「ねえ、ヒマなんだけど・・・」
			PRINTFORML %CALLNAME:TARGET%は%CALLNAME:MASTER%の腕を指先でくすぐっている・・・
	ENDSELECT
ENDIF
RETURN 1


