;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;분기作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:절정
;4以上で昇天、3で超強절정、2で強절정、1で절정

;NOWEX:Ｃ절정 NOWEX:Ｖ절정 NOWEX:Ｂ절정 NOWEX:Ａ절정 NOWEX:Ｍ절정
;各部位の절정

;NOWEX:二重절정、NOWEX:三重절정、NOWEX:四重절정、NOWEX:五重절정
;同時に절정した時の状態
;上記五つに加えてNOWEX:Ｅ절정でも판정

;TOTALEX
;地の文の판정に使われているもの
;5以上で潮を吹き、4以下で背中を反らせて절정する
;詳しくはEVENT_MESSAAGE_ORGASMを参照

;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが삽입中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが삽입中となる。

;NOWEX:사정
;사정量、最大3。たとえばIF NOWEX:MASTER:사정 > 1だと、あなたが大量사정以上した場合となる。

;==================================================
;절정時の구상
;==================================================
@M_KOJO_MESSAGE_PALAMCNG_B_K1953(ARG)
#DIM TOTALEX
#DIM DYNAMIC 호감도修正
CALL PALAM_MESSAGE_B(ARG)
TOTALEX =  NOWEX:ARG:Ｃ절정 + NOWEX:ARG:Ｖ절정 + NOWEX:ARG:Ａ절정 + NOWEX:ARG:Ｂ절정+ NOWEX:ARG:Ｍ절정 + NOWEX:ARG:Ｅ절정 + NOWEX:ARG:분유 + NOWEX:ARG:사정
SIF !(TOTALEX + NOWEX:ARG:방뇨)
	RETURN 0
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;분유
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:분유 && NOWEX:ARG:절정 <= 2 && !TCVAR:ARG:전턴절정
		PRINTFORMW 「はっ・・・あっ・・・❤　母乳、出ちゃってる・・・❤」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;사정した
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:2 = 1
	;-------------------------------------------------
	IF LOCAL:2 && NOWEX:ARG:사정 && NOWEX:ARG:절정 <= 2
		PRINTFORMW 「あっ❤　ああっ！？❤　出っ、イっ❤　あぁぁっ──❤❤❤」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;방뇨
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:3 = 0
	;-------------------------------------------------
	IF LOCAL:3 && NOWEX:ARG:방뇨
		PRINTFORMW 
		RETURN 1
	ENDIF

	;구상の色の변경　この状態だとピンク色　必要ない場合はこことRESETCOLORを消す
	SETCOLOR C_H_PINK
	;基本セット
	;限界を超えた、조교のその先
	IF BASE:ARG:체력 < 300
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「ぁっ──❤　ぁぁぁ・・・❤」
			CASE 1
				PRINTFORML 「ぁっ・・・❤　ぁ・・・❤」
			CASE 2
				PRINTFORML 「ぅっ・・・は・・・ぁぁ・・・❤」
			CASE 3
				PRINTFORML 「ひゅ──ぁ──ぇぁ──❤」
		ENDSELECT
	;通常
	ELSE
		IF TCVAR:ARG:전턴절정
			;１０回も連続で절정けば何も言えないでしょう！
			;さすがに１０なんてやるのは面倒なのでは？６以上にしよう。
			IF TCVAR:ARG:연속절정기록 >= 6
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「あっ❤　ああっ❤❤❤　ああああっ❤❤❤❤❤」
					CASE 1
						PRINTFORMW 「こ゛われるっ❤❤❤　あたまっ❤　おかしくなるっ❤❤❤❤❤」
					CASE 2
						PRINTFORMW 「お゛っ❤　あ゛っ❤❤❤　イっ❤❤　あ゛あ゛あ゛あ゛あ゛っ❤❤❤❤」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「あっ❤　やっ❤　まだっ❤　イったばかりっ❤❤❤」
					CASE 1
						PRINTFORMW 「やっ❤　まってっ❤　うぁっ❤　あっ❤❤❤」
					CASE 2
						PRINTFORMW 「むりっ❤　あああっ❤　またっ❤　イっ──❤❤❤」
				ENDSELECT
			ENDIF
		ELSE
			SELECTCASE NOWEX:ARG:절정
				;절정
				CASE 1,2,3
					SELECTCASE RAND:4
						CASE 0
							PRINTFORMW 「あっ❤　イっ❤　あああっ──❤❤❤」
						CASE 1
							PRINTFORMW 「もっ❤　もうっ❤　イク──っ❤❤❤」
						CASE 2
							PRINTFORMW 「ふぁっ❤　あっ❤　%CALLNAME:MASTER%っ❤　%CALLNAME:MASTER%っ❤❤❤」
						CASE 3
							PRINTFORMW 「やっ❤　まだっ❤　あっ❤　あああっ❤❤❤」
					ENDSELECT
				;昇天
				CASE IS >= 4
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「はっ──ぁ──ああっ──あっ❤❤❤❤❤」
						CASE 1
							PRINTFORMW 「あっ❤　これっ❤　やばっ❤❤❤　イ──あああっ──❤❤❤❤❤」
						CASE 2
							PRINTFORMW 「だめっ❤　あたまっ❤　まっしろにっ❤　ぅぁあっ──❤❤❤」
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1


