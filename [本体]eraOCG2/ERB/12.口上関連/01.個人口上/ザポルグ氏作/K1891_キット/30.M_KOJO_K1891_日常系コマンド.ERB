;350,押し倒す（時姦時イタズラする
;TFLAG:194 (0=成功 1=人目がある　2=野外は嫌でござりまする　3=多人数プレイは勘弁　4=合意があっても무드が足りぬ　100=合意はあるが구상内특수판정によって失敗）
;TCVAR:抱き寄せ初回　1=普通に合意ゲット　2=先に키스ぐらいしろよ　3=媚薬or発情には勝てなかったよお…　4=悔しい…각인さえなければﾋﾞｸﾋﾞｸﾝ
;5=強引に迫られると断れぬ(素質臆病持ち専用) 6=まんざらでもない　7=駄目　8=論外 98=구상内특수판정による失敗 99=구상内특수판정による成功
;구상内특수판정は該当するCFLAGが0だと無効
;CFLAG:MASTER:우후후 (1=通常時　2=攻守反転)

;押し倒せるタイミングでないとコマンドが出ないため、TFLAG:194 == 0 以外は書く必要は無い
;上記の抱き寄せ初回は使えないため注意すること
;==================================================
@M_KOJO_MESSAGE_COM_K1891_350
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1891_350_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1891_350_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;通常押し倒し
	IF TFLAG:SELECTCOM분기 == 0
		;抱き寄せ初回
		IF FIRSTTIME(TOSTR(350),1)
			IF CFLAG:TARGET:만취강간
				PRINTFORMW 「ほえ？　あー、うん……いいよー……❤」
			ELSE
				PRINTFORMW 「あ……えっと、スるん……だよね？」
				PRINTFORMW 「……いいよ。　私も、%CALLNAME:MASTER%のことは好きだし……❤」
			ENDIF
		ELSE
			IF CFLAG:TARGET:만취강간
				PRINTFORMW 「えへへ……%CALLNAME:MASTER%とえっちだー……❤」
			ELSE
				IF TIME < KANTAN_TIME(18,00)
					PRINTFORMW 「しょうがないにゃあ……ちょっとだけだよ？」
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORMW 「まったくもー……優しくしてね？❤」
						CASE 1
							PRINTFORMW 「今日は何するー？　おもちゃとか、色々使ってみる？❤」
						CASE 2
							PRINTFORMW 「%CALLNAME:MASTER%とのえっちってすごい気持ちいいから、実は毎回楽しみなんだよねー❤」
					ENDSELECT
				ENDIF
			ENDIF
		ENDIF
		
	;攻守反転（MASTERが受け）
	ELSEIF TFLAG:SELECTCOM분기 == 1
		PRINTFORMW 「よーし、それじゃあ好き勝手やらせてもらうねー❤」

	;攻守反転（MASTERが攻め）
	ELSEIF TFLAG:SELECTCOM분기 == 2
		PRINTFORMW 「わわっ❤　その気になっちゃった？❤」
		
	;攻守反転失敗
	ELSEIF TFLAG:SELECTCOM분기 == -2
		PRINTFORMW 
	ENDIF
ENDIF
RETURN 1
