;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;300,会話
;TFLAG:SELECTCOM분기(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより교양が4以上高い)
;TCVAR:302(0=会話可能 1=非연모時会話不能)
;MARK:반발각인(3以上=会話不能)(4以上はバグ
;TCVAR:만취강간(1=通常成功or大失敗)
;CFLAG:우후후(조교中の会話)
;CFLAG:변기화(肉便器の時の会話)
;==================================================
@M_KOJO_SUCCESS_COM_K1891_300
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K1891_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で구상色が付きません。
CALL TRAIN_MESSAGE
;구상メイン呼出
CALL M_KOJO_MESSAGE_COM_K1891_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1891_300_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;「RAND:n」n面ダイスを振る
	;우후후中の会話
	IF CFLAG:TARGET:우후후
		SELECTCASE RAND:3 + 1
			CASE 1
				PRINTFORMW 「ふっふっふっ、キットちゃんの熟練の技に震えるがいいわ！」
			CASE 2
				PRINTFORMW 「結構ガッシリしてるよねー、かっこいー❤」
			CASE 3
				PRINTFORMW 「なんかさ……改まってこう向き合うと、ちょっと照れるね……❤」
		ENDSELECT
	;알바중
	ELSEIF CFLAG:TARGET:알바중
		SELECTCASE CFLAG:TARGET:아르바이트
			CASE PT_바니,PT_ファミレス,PT_메이드
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「接客って大変だねー……忙しい時は目が回っちゃうよ」
					CASE 1
						PRINTFORMW 「注文は何にする？　決まってないならコレとかおすすめだよ！」
					CASE 2
						PRINTFORMW 「あ、はーい！　ちょっと行ってくるね！」
				ENDSELECT
			CASE PT_巫女,PT_教会
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「ヒマだねぇ……あんまり人が来ないから、掃除くらいしかすることないよー」
					CASE 1
						PRINTFORMW 「%CALLNAME:MASTER%って神様とか信じてたりする？　私は知らない人より仲間の方が信じられるかなー」
					CASE 2
						PRINTFORMW 「あ、やべっ……サボってるのバレそうだから一旦離れるね！」
				ENDSELECT
			CASE PT_편의점,PT_スーパー
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「結構やること多いから、話すのは휴식中か終わってからにしてね！」
					CASE 1
						PRINTFORMW 「%CALLNAME:MASTER%邪魔！　ちょっと退いてて！」
					CASE 2
						PRINTFORMW 「すごい忙しいね！　気を抜いたらお客さんに潰されちゃうよ！」
				ENDSELECT
			CASE PT_ジム
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「ほら！　もうちょっと！　……よし、ラスト一回！」
					CASE 1
						PRINTFORMW 「ストレッチはしっかりしようねー、ケガしたら鍛えるどころの話じゃないもん」
					CASE 2
						PRINTFORMW 「更衣室の臭いがね、すごいの。　気を付けないと扉を開けた瞬間に固まっちゃうんだよねー……」
				ENDSELECT
			CASE PT_使用人
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「へへーん、似合ってるでしょ？　私、美少女だから何着ても似合っちゃうんだなーコレが」
					CASE 1
						PRINTFORMW 「あー！　掃除したところにゴミこぼさないでよー！」
					CASE 2
						PRINTFORMW 「%CALLNAME:MASTER%もさー、汚さない努力とかしてねー？」
				ENDSELECT
			CASE PT_グラビア
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「リズ姉には及ばずともナイスバデーなのでね、写真撮影には引っ張りだこなのだよ」
					CASE 1
						PRINTFORMW 「ぶるる……ちょっと冷えるねー。　%CALLNAME:MASTER%ー、上着貸してー」
					CASE 2
						PRINTFORMW 「うわ、見てよあれ……すっごいばるんばるん……」
				ENDSELECT
			CASE PT_착유
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「寝てるだけでいいって言うけどさー、地味にジッとしてるのって疲れるんだよねー……」
					CASE 1
						PRINTFORMW 「ここの착유기、もうちょっと効率できそうなんだけどなー」
					CASE 2
						PRINTFORMW 「搾乳のタイミングとかすごいよ。　そこら中の女の子たちが一斉にモーモー鳴き出して、すごいうるさいの」
				ENDSELECT
			CASE PT_エロ配信者
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW %CALLNAME:TARGET%は人差し指に口を当ててきた。
					CASE 1
						PRINTFORMW 「とりあえずはここまでねー❤　続きが見たかったらスパチャよろしくー❤」
					CASE 2
						PRINTFORML 「にゃはは……ちょっと待ってねー」
						SETCOLOR C_GRAY
						PRINTFORMW 「%CALLNAME:MASTER%！　今配信中だから、話なら後にして！」
						RESETCOLOR
				ENDSELECT
		ENDSELECT
	;데이트중
	ELSEIF CFLAG:TARGET:데이트중
		IF GET_MONTH() == "겨울의 달"
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「うー、さぶさぶ……%CALLNAME:MASTER%ー、早くどっか入ろうよー」
				CASE 1
					PRINTFORMW 「%CALLNAME:MASTER%の体あったかいねー、もっとぎゅってしようよ♪」
				CASE 2
					PRINTFORMW 「冷えるねぇ……夜のゴルゴンダみたいだ」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「あ、見て%CALLNAME:MASTER%！　あっちに面白そうなのがあるよ！」
				CASE 1
					PRINTFORMW 「こうして歩いてるだけでも結構楽しいね！　なんかこう……いいよね！」
				CASE 2
					PRINTFORMW 「そういえば、あの部品切らしてたな……ちょっと後で買ってきていい？」
			ENDSELECT
		ENDIF
	;日常会話
	ELSE
		;호감도修正、通常（연모系陥落なし）で５
		호감도修正 = 5
		;TARGETが【애처】だったら호감도修正に＋２
		SIF TALENT:TARGET:애처
			호감도修正 += 5
		;TARGETが【親愛】だったら호감도修正に＋２
		SIF TALENT:TARGET:연모 == 2
			호감도修正 += 5
		;TARGETが【연모】を得ていたら호감도修正に＋１
		SIF TALENT:TARGET:연모 >= 1
			호감도修正 += 5
		SIF CFLAG:TARGET:소유함
			호감도修正 += 11
		SELECTCASE RAND:호감도修正 + 1
			;デフォルト
			CASE IS <= 5
				SELECTCASE RAND:5
					CASE 0
						PRINTFORMW 「なんか壊れた物があったら教えてね！　私がバッチリ改造してあげるから！」
					CASE 1
						PRINTFORMW 「こっちは涼しくていいねー、元いた場所は砂漠ですごい暑くてさー」
					CASE 2
						PRINTFORMW 「おっきい重機っていいよね……こう、ぐわーっ！って動き回る感じがさ……」
					CASE 3
						PRINTFORMW 「なんかいい物件とか無いかなー、大きめの機械弄ると結構大きい音出るんだよねー」
					CASE 4
						PRINTFORMW 「%CALLNAME:MASTER%ってＤホイール持ってるんだよね？　今度만족辺りにツーリングに行こうよ！」
				ENDSELECT

			;正体バレ
			CASE 6 TO 16
				SELECTCASE RAND:11
					CASE 0
						IF TALENT:NO_TO_CHARANUM(1880):연모 == 2
							PRINTFORM 「てっきりエクレシアはアルバスとくっ付くと思ってたんだけどなー。
							IF TALENT:TARGET:연모 == 2
								PRINTFORMW 　この浮気者めー」
							ELSE
								PRINTL
								PRINTFORMW 　まさか%CALLNAME:MASTER%とくっ付いちゃうとはねえ……」
							ENDIF
						ELSEIF TALENT:NO_TO_CHARANUM(1880):굴복됨
							IF TALENT:TARGET:굴복됨
								PRINTFORMW 「エクレシアも幸せ者だよねー、こんなに素敵なご主人様に愛されちゃってさー❤」
							ELSEIF TALENT:TARGET:연모 == 2
								PRINTFORML 「%CALLNAME:MASTER%の趣味も否定しないし、番としても強いオスは好きだけどさー……
								PRINTFORMW 　あんまりエクレシアばっか상대에게 してるたら、拗ねちゃうからね？」
							ELSE
								PRINTFORMW 「最近のエクレシアはなんかちょっと変なんだよねー、楽しそうではあるんだけどさー」
							ENDIF
						ELSE
							PRINTFORML 「くっくっくっ、かわいいかわいいエクレシアは私の妹分であるぞ。
							PRINTFORMW 　お近づきになりたくば、このキットちゃんを倒してからにしてもらおうかぁ」
						ENDIF
					CASE 1
						IF TALENT:NO_TO_CHARANUM(1881):연모 == 2
							PRINTFORM 「ドリスさんがまさか、あんな女の顔するとはねえ……
							IF TALENT:TARGET:연모 == 2
								PRINTFORMW この女たらしー」
							ELSE
								PRINTL
								PRINTFORMW んまあ、あのままだとエクレシアより後どころか、一生独り身まであったからよかったね！」
							ENDIF
						ELSEIF TALENT:NO_TO_CHARANUM(1881):굴복됨
							IF TALENT:TARGET:굴복됨
								PRINTFORMW 「ドリスさんってちょっと独占欲強いよねー、%CALLNAME:MASTER%のペットは他にもいるのにさー」
							ELSEIF TALENT:TARGET:연모 == 2
								PRINTFORMW 「むぅ……やっぱり、ドリスさんぐらい起伏があった方がいいのかな……」
							ELSE
								PRINTFORMW 「最近のドリスさん、ちょっと楽しそうなんだよね。　好きな人でも出来たのかな？」
							ENDIF
						ELSE
							PRINTFORMW 「ドリスさんはちょっと苦手なんだよね……冗談が通じないっていうか……」
						ENDIF
					CASE 2
						PRINTFORMW 「アルバスはまだまだだね！　シュー兄くらいのタッパと漢気が無いとエクレシアはやれんよ！」
					CASE 3
						IF TALENT:NO_TO_CHARANUM(1890):연모 == 2
							PRINTFORMW 「もう%CALLNAME:MASTER%とくっ付いちゃったからいいけどさー……シュー兄はもうちょい人の機微に敏感になるべきだと思うんだよね」
						ELSE
							PRINTFORMW 「シュー兄はすっごいアホボケだよ！　さっさとリズ姉とくっ付いちまえ！」
						ENDIF
					CASE 4
						IF TALENT:NO_TO_CHARANUM(1890):연모 == 2
							IF TALENT:TARGET:연모 == 2
								PRINTFORML 「リズ姉には出来ればシュー兄とくっ付いて欲しかったんだけど……
								PRINTFORMW 　今も十分幸せそうだし、私もずっとリズ姉と一緒にいられるからいっか！」
							ELSE
								PRINTFORMW 「リズ姉を幸せにしなかったら承知しないからねー？」
							ENDIF
						ELSEIF TALENT:NO_TO_CHARANUM(1890):굴복됨
							IF TALENT:TARGET:굴복됨
								PRINTFORML 「えっちの時のリズ姉ってかわいいよねー❤
								PRINTFORMW 　最初は美人さんなのに、すぐに汗とか涎でベトベトになっちゃうんだもん❤」
							ELSEIF TALENT:TARGET:연모 == 2
								PRINTFORMW 「幸せそうだからいいけど、リズ姉のあんな姿を見るのはちょっとフクザツな気持ち……」
							ELSE
								PRINTFORMW 「最近のリズ姉、なんか変なんだよねー……体重でも増えたのかな？」
							ENDIF
						ELSE
							IF TALENT:TARGET:연모 == 2 || TALENT:TARGET:굴복됨
								PRINTFORMW 「リズ姉には手を出さないでね？　%CALLNAME:MASTER%には私がいるんだからさ❤」
							ELSE
								PRINTFORMW 「リズ姉は絶対もっとぐいぐい行った方がいいよ！　あのアホボケには기정사실作るくらいじゃないと伝わんないって！」
							ENDIF
						ENDIF
					CASE 5
						PRINTFORMW 「今度こっちの世界にも来てみるー？　安全はどうにかするからさー」
					CASE 6
						PRINTFORMW 「スプリガンズは気のいいやつらだぜ！　%CALLNAME:MASTER%もきっと気に入るよ！」
					CASE 7
						PRINTFORMW 「『コスプレ』って便利な言葉だよねー、耳とか尻尾見られてもそれで誤魔化せるもん」
					CASE 8
						PRINTFORMW 「一回ちゃんとした学校とかに行ってみたいんだよねー、結構独学だからさー」
					CASE 9
						PRINTFORMW 「トライブリゲードの皆はいいやつらだよ、ちょっと警戒心強いし、臭いけど」
					CASE 10
						PRINTFORMW 「あー……あっちみたいにバカデカいマシンを爆走させたーい……」
				ENDSELECT
			
			;연모
			CASE 17 TO 21
				SELECTCASE RAND:5
					CASE 0
						PRINTFORMW 「ちょっと買い物に付き合ってくれない？　ちゃんとお礼はするからさ……ね？」
					CASE 1
						PRINTFORMW 「あ、そうだ。　ちょっと寸法測らせて……オッケー！　ありがとね！」
					CASE 2
						PRINTFORM 「%CALLNAME:MASTER%って気になる人とかいるの？
						IF TALENT:TARGET:애처
							PRINTFORMW 　……だよねー❤　聞いてみただけー❤」
						ELSE
							PRINTFORMW 　……んーん、聞いてみただけー」
						ENDIF
					CASE 3
						PRINTFORMW 「こっちはかわいい服多いよねー……%CALLNAME:MASTER%ー、今度デート行こうよ！」
					CASE 4
						IF GET_MONTH() == "봄의 달"
							PRINTFORMW 「んん～っ！　あったかいねー……眠くなってきちゃった……」
						ELSEIF GET_MONTH() == "여름의 달"
							PRINTFORMW 「うえー、あついよー……%CALLNAME:MASTER%ー、アイス買ってきてー……」
						ELSEIF GET_MONTH() == "가을의 달"
							PRINTFORMW 「落ち葉すごいねー、倉庫にある送風機、改造してあげよっか？」
						ELSEIF GET_MONTH() == "겨울의 달"
							IF TALENT:TARGET:연모 == 2
								PRINTFORMW 「寒いよー……%CALLNAME:MASTER%ー、あっためてー」
							ELSE
								PRINTFORMW 「コタツが欲しい……このままじゃ冬眠しちゃう……」
							ENDIF
						ENDIF
				ENDSELECT
			
			;親愛
			CASE 22 TO 26
				SELECTCASE RAND:5
					CASE 0
						PRINTFORMW 「どーよこの服！　本とかで勉強したからすごい似合ってるでしょ！」
					CASE 1
						PRINTFORMW 「%CALLNAME:MASTER%の匂いって好きだなー……なんていうか、安心？するっていうか……❤」
					CASE 2
						PRINTFORMW 「スプリガンズの機体は大きくて一見複雑そうに見えるけど実際の操作は簡単で学んですぐの素人でも──」
					CASE 3
						PRINTFORMW 「%CALLNAME:MASTER%の家っていいよねー、狭くは無いんだけど、広すぎないのが落ち着くー」
					CASE 4
						PRINTFORMW 「ゴロゴロゴロ……ん？　何か言った？」
				ENDSELECT
			
			;애처
			CASE 27 TO 31
				SELECTCASE RAND:5
					CASE 0
						PRINTFORMW 「%CALLNAME:MASTER%❤　……んーん、呼んでみただけー❤」
					CASE 1
						PRINTFORML 「トライブリゲードの皆にはいつ挨拶に行くー？　
						PRINTFORMW 　……いっそのこと２、３人くらいこさえてから行く？❤」
					CASE 2
						PRINTFORMW 「……%CALLNAME:MASTER%、ぎゅってしたい……❤」
					CASE 3
						PRINTFORMW 「他の女の子が気になっちゃうのはしょーがないけどさー……私も嫉妬くらいするんだからね？」
					CASE 4
						PRINTFORMW 「子供の名前とかって考えてる？　私はもう２０くらい思いついてるよ！　まずはー……」
				ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
