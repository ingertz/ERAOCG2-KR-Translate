LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;記入チェック（=0, 非표시、1, 표시）
	;질내사정횟수분기
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:TARGET:질내사정횟수 > 0
		SELECTCASE TCVAR:TARGET:질내사정횟수
			CASE 1 TO 5
				PRINTFORMW 「なーにー？　자신が出したのが気になるのー？❤」
			CASE 6 TO 15
				PRINTFORMW 「いやー、出したねえ……❤」
			CASE 16 TO 50
				PRINTFORMW 「だしすぎー❤　お腹パンパンだよー❤」
			CASEELSE
				PRINTFORMW 「あんま力入れないで……漏れちゃう……」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	SELECTCASE TFLAG:SELECTCOM분기
		CASE 1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「気になるー？　もうちょっと待ってねー❤」
				CASE 1
					PRINTFORMW 「ん……お腹の中で喜んでるねー❤」
				CASE 2
					PRINTFORMW 「しばらくしたら、私もお母さんかあ……なんか実感湧かないなー」
			ENDSELECT
		CASE 0,-1
			SELECTCASE RAND:5
				CASE 0
					PRINTFORMW 「おー……なんか、変な感じー……」
				CASE 1
					IF TALENT:TARGET:몸두께 == 0
						PRINTFORMW 「余計なお肉なんてないよ！　鍛えてますから！」
					ELSEIF TALENT:TARGET:몸두께 <= 3
						PRINTFORMW 「ちょっと油断したなぁ……そのうち走り込みとかしないと……」
					ELSE
						PRINTFORMW 「うぎ、うぎぎぎぎ……！　脂肪吸引器を作ってやる……！」
					ENDIF
				CASE 2
					PRINTFORMW 「ちょっ……！　ヘソに指入れるのはダメだって！」
				CASE 3
					PRINTFORMW 「……なーんか、ねちっこいなー」
				CASE 4
					PRINTFORMW 「んー……もうちょい上……そう、そこそこ……♪」
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1
