;==================================================
;480,デュエル
;勝敗はプレイヤーから見てのもの
;TFLAG:SELECTCOM분기(1=通常승리 2=通常패배 3=引き分け
;10=通常듀얼前 11=パック賭け듀얼前 12=デート賭け듀얼前 13=パンツ賭け듀얼前 14=お持ち帰り듀얼前 15=お前モンスターじゃないか？ 16=スケベ要求듀얼前 20=闇のゲーム
;31=パック賭け승리 32=デート賭け승리 33=パンツ賭け승리 34=お持ち帰り成功 35=カード化승리（牝以外） 36=スケベ要求事後 40=罰ゲーム！
;135=カード化見逃す 235=穏便カード化 335=凌辱後カード化 435=凌辱後見逃す
;50=賭け듀얼패배怒られた 51=パック賭け패배 52=デート패배デート 55=カード化패배 56=スケベ要求패배 156=スケベ要求弱味削除 256=スケベ要求패배負け癖付きおねだり)
;==================================================
@M_KOJO_MESSAGE_COM_K1891_480
;デュエルにTRAIN_MESSAGEはない
CALL M_KOJO_MESSAGE_COM_K1891_480_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1891_480_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;これが０の時はデュエルしない時なのでおわり
	SIF TFLAG:SELECTCOM분기 == 0
		RETURN 1

	;デュエル前
	IF INRANGE(TFLAG:SELECTCOM분기,10,21)
		SELECTCASE TFLAG:SELECTCOM분기
			;通常듀얼
			CASE 10
				PRINTFORMW 「よーし、負けないぞー！」
			
			;ここから賭け듀얼
			;パック賭け
			CASE 11
				PRINTFORMW 「やっぱ何か賭けるとモチベが違うね！　勝つぞ勝つぞー！」
			;デート賭け
			CASE 12
				PRINTFORMW 「別に、言えば普通にデートするんだけどなぁ……」
			;パンツ賭け
			CASE 13
				PRINTFORMW 「キットちゃんのプリティーパンツが欲しくば、私を倒していくがいい！」
			;お持ち帰り
			CASE 14
				PRINTFORMW 「あのさー……듀얼で女の子を好き勝手しようとするとか、クズのすることだからね？」
			;モンスターか問い詰める（人間は불가）
			CASE 15
				PRINTFORMW 「くっ、バレてしまっては仕方がない！　듀얼で口封じじゃー！」
			;スケベ強要
			CASE 16
				IF TALENT:TARGET:패배버릇 == 1
					PRINTFORMW 「きょ、今日は負けないもん……❤」
				ELSEIF CFLAG:TARGET:약점장악 == 1
					PRINTFORMW 「わ、私が勝ったらそれ、捨ててもらうから！」
				ELSE
					PRINTFORMW 「……しょーがないなー、ちゃんとお金は払ってね？」
				ENDIF
			;闇のゲーム
			CASE 20
				PRINTFORMW 「わ、な、なにこれ！？」
		ENDSELECT

	;デュエル後
	ELSE
		SELECTCASE TFLAG:SELECTCOM분기
			;通常승리
			CASE 1
				PRINTFORMW 「ちぇー、もうちょっとで勝てそうだったのになー。　ね、もう一回やろうよ！」
			;通常패배
			CASE 2
				PRINTFORMW 「いえーい！　私の勝ち！　なんで負けたか、次までに考えておいてね！」
			;通常引き分け
			CASE 3
				PRINTFORMW 「引き分けかー、珍しいもの見れたなぁ……」

			;ここから賭け승리
			;パック賭け
			CASE 31
				PRINTFORMW 「負けたから仕方ないよねー……あー、お小遣いが減ってくー……」
			;デート賭け
			CASE 32
				PRINTFORMW 「負けちゃったからしょうがないよねー❤　ね、何処に行くの？」
			;パンツ賭け
			CASE 33
				PRINTFORMW 「ちょっ！　臭い嗅がないでよ！　いやフローラルな香りだけどさ！」
			;お持ち帰り
			CASE 34
				PRINTFORMW 「ん……それで、家に連れ込んで何するの？」
			;下二桁３５は"モンスターか問い詰める"の분기
			;カード化（牝以外、選択肢無し）
			CASE 35
				PRINTFORMW 
			;カード化を見逃す（元気でな！）
			CASE 135
				PRINTFORMW 「ありがとー！　また今度遊ぼうねー！」
			;穏便に話してカード化（怖くないよ～痛くないよ～）
			CASE 235
				PRINTFORMW 「……結構落ち着くね、コレ」
			;身体を対価に見逃す（見逃すとは言ってない）
			CASE 335
				PRINTFORMW 「う、うそつきぃ……❤」
			;身体を対価に見逃す（見逃す）（負け癖付いたり弱み握られたりする）
			CASE 435
				PRINTFORMW 「うう……❤　つ、次は、負けないから……❤」
			;身体要求事後
			CASE 36
				IF TALENT:TARGET:패배버릇 == 1
					PRINTFORMW 「ま、また負けちゃったぁ……❤」
				ELSE
					PRINTFORMW 「はぁ……はぁ……❤　やっと、おわった……❤」
				ENDIF
			;闇のゲーム
			CASE 40

			;ここから賭け패배
			;怒られた
			CASE 50
				PRINTFORMW 「賭けるのが楽しいのはわかるけど、ほどほどにした方がいいよ？」
			;パック賭け（パックを手渡す）
			CASE 51
				PRINTFORMW 「ゴチになりまーす！　……お、これいいかも」
			;デート賭け（デートはしてくれる）
			CASE 52
				PRINTFORMW 「それじゃあ行こっか！　負けた%CALLNAME:MASTER%には拒否権ないからねー♪」
			;カード化패배（逃げられた）
			CASE 55
				PRINTFORMW 「さらばっ！」
			;身体要求패배（金払う）
			CASE 56
				PRINTFORMW 「ひいふうみい……よし、ちゃんと全部あるね」
			;身体要求패배（弱味削除）
			CASE 156
				;PRINTFORMW 「」
			;身体要求패배（負け癖付いてる時限定凌辱おねだり）（ラブホ直行）
			CASE 256
				PRINTFORMW 「えへへ……❤　また、賭け듀얼しようね❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

;==================================================
;600,散策する
;데이트중の場合、CFLAG:현재위치に이동先の場所が既に入ってる
;==================================================
;流れるタイミングは이동後
;場所の名前は ERB/05.コマンド関連/이동関連（이동コマンド、COMF 400含む）/COMMON_PLACE に書いてある
@M_KOJO_MESSAGE_COM_K1891_600
;散策するにはTRAIN_MESSAGEが無い
CALL M_KOJO_MESSAGE_COM_K1891_600_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1891_600_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE CFLAG:MASTER:현재위치
		CASE 場所_ラブホ
			IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
				PRINTFORMW 「……今日はここでスるの？❤」
			ELSE
				PRINTFORMW 「わ、私にはまだちょーっとココは早いかなーって……」
			ENDIF
		CASE 場所_繁華街
			PRINTFORMW 「おー……おー……！　面白そうなのがいっぱいあって目移りしちゃうね！」
		CASE 場所_식사通り
			PRINTFORMW 「いい匂いだねー♪　何から食べよっか！」
		CASE 場所_森,場所_Re森林
			PRINTFORMW 「はー……落ち着くねぇ……」
		CASE 場所_モール,場所_Reモール
			PRINTFORMW 「何処から回ろっか！　早くしないとお店が閉まっちゃうよ！」
		CASE 場所_工場,場所_ゴミ処理場
			PRINTFORMW 「はぇーおっきい……見学とかさせてもらえないかな？」
		CASE 場所_釣り堀,場所_Re釣り堀
			PRINTFORMW 「結構釣れてるみたいだねー、私たちもちょっと垂らして行こーよ！」
		CASE 場所_Re墓場
			IF TIME < KANTAN_TIME(19,00)
				PRINTFORMW 「昼間でもちょっと不気味だねー……」
			ELSE
				PRINTFORMW 「うぇー不気味ー……別のトコ行こーよー……」
			ENDIF
		CASE 場所_Re温泉
			PRINTFORMW 「ほー……効能もいい感じだし、ちょっと入ってみようよ！」
		CASE 場所_Re玩具屋
			PRINTFORMW 「面白そうなのがいっぱいだね……どれ使ってみる？❤」
		CASE 場所_Reマッサージ
			PRINTFORMW 「最近座ってばかりだからなぁ……ちょっと診てもらいたいね」
		CASEELSE
			;変な事言わせるくらいなら何もしない方がマシなのでは？
	ENDSELECT
ENDIF
RETURN 1
