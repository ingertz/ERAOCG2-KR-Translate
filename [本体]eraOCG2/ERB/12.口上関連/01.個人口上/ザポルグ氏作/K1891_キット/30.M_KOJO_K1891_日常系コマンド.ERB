				PRINTFORMW 「……早めに帰ってきてねー」
			ELSE
				PRINTFORMW 「いってらっしゃーい」
			ENDIF
		;お出かけお見送り
		ELSE
			PRINTFORMW 「いってらっしゃーい」
		ENDIF
	ENDIF
ENDIF
RETURN 1

