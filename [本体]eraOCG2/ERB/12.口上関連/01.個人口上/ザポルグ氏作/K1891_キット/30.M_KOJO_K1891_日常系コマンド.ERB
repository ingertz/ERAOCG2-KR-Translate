@M_KOJO_MESSAGE_COM_K1891_301
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1891_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1891_301_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:SELECTCOM분기
		CASE 1,0
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「んー……%CALLNAME:MASTER%ー、おかわりー」
				CASE 1
					PRINTFORMW 「ん、ありがと。　ここがこうなってー……」
				CASE 2
					PRINTFORMW 「ずずず……お、甘い。　ハチミツとか入ってる？」
			ENDSELECT
		CASE -1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「うえー……まっず……」
				CASE 1
					PRINTFORMW 「あっっっづ！！！　ひー、ひたがひゃけどするー……」
				CASE 2
					PRINTFORMW 「うげっ……ゴミみたいな味……」
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1
