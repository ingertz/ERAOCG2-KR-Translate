;==================================================
@M_KOJO_MESSAGE_COM_K1891_100
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1891_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1891_100_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	IF ABL:TARGET:마조끼 >= 3
		SELECTCASE RAND:5
			CASE 0
				PRINTFORMW 「ふぁああっ❤　はぁ……はぁ……❤」
			CASE 1
				PRINTFORMW 「いっ❤　あっ❤　やぁっ❤　いぃっんっ❤」
			CASE 2
				PRINTFORML 「はっ……ふぁっ……ひんっ……❤」
				PRINTFORMW %CALLNAME:TARGET%は余韻に腰をビクつかせている……
			CASE 3
				PRINTFORMW 「はー……はー……❤　おしり、ヒリヒリする……❤」
			CASE 4
				PRINTFORMW 「お゛っ❤　あ゛っ❤　ん゛ん゛っ❤❤❤」
		ENDSELECT
	ELSE
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORMW 「びっ！？　いきなり何すんのさ！」
			CASE 2
				PRINTFORMW 「痛いっ！　痛いってばぁっ！」
			CASE 3
				PRINTFORMW 「何もしてないっ！　まだ何もしてないよぉっ！」
			CASE 4
				PRINTFORMW 「うぇぇ……お尻がまっかっかだよぉ……」
			CASE 5
				PRINTFORMW 「うぅぅ……これじゃ、かわいいパンツ履けないじゃん……」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

