;※※※※※※※※※※※※※※※※※※※※※※※※※
;CARD用구상
;※※※※※※※※※※※※※※※※※※※※※※※※※
;直接カードのIDを使える。
;캐릭터が無くても動く
;存在証明
@M_KOJO_CARD_K39634
RETURN 1
;==================================================
;0,モンスター소환時
;==================================================
@M_KOJO_CARD_K39634_0(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「へっ❤　えへへへへっ❤」
ENDIF

;==================================================
;1,攻撃時
;==================================================
@M_KOJO_CARD_K39634_1(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「ぐるるるる……シャーッ！」
ENDIF

;==================================================
;2,효과발동
;==================================================
;효과別で鳴らしたいなら、直接カードのデータを見て、설정する必要がある
;面倒、分からないであれば분기はせず
;失敗판정は、いわゆる효과を無効にされたとかそういうやつ
@M_KOJO_CARD_K39634_2(종류,失敗판정)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 종류
#DIM DYNAMIC 失敗판정
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 失敗판정 == 0
		IF 종류 == 손패起動 || 종류 == 필드起動
			PRINTFORMW 「ナーオ──❤　ンニャーオ──❤❤❤」
		ELSEIF 종류 == 마함起動
			PRINTFORMW 「あああっ❤❤❤　あ゛あ゛あ゛あ゛あ゛あ゛あ゛っ❤❤❤❤❤」
		ELSE
			PRINTFORMW 「ちんぽっ❤　ちんぽっ❤」
		ENDIF
	ELSE
	ENDIF
ENDIF

;==================================================
;3,除去時
;==================================================
;いちいちなんでも除去で話すとやかましいため、デフォでは破壊にのみ反応するように설정
@M_KOJO_CARD_K39634_3(除去종류,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 除去종류
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 除去종류
		CASE 破壊行き,戦闘破壊行き
			PRINTFORMW 「ぶぇっ──❤」
	ENDSELECT
ENDIF

