@M_KOJO_DUEL_K1891_TRIBRIGADE(カードID,소환出処)
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処

;抗戦で특수소환する時
IF GROUPMATCH(소환出処,召種묘지,召種제외) && 処理中_효과ID == 81890
	IF GROUPMATCH(カードID,1891,11891,26521)
		PRINTFORMW 「私！」
	ELSEIF カードID == 26520
		PRINTFORMW 「フラクトール！」
	ELSEIF カードID == 26521
		PRINTFORMW 「ナーベル！」
	ELSEIF カードID == 26522
		PRINTFORMW 「ケラス！」
	ELSEIF カードID == 26893
		PRINTFORMW 「メルクーリエ！」
	ELSEIF カードID == 53100 || カードID == 53101
		PRINTFORMW 「シュー兄！」
	ELSEIF カードID == 1890 || カードID == 11890
		PRINTFORMW 「リズ姉！」
	ELSEIF カードID == 53102
		PRINTFORMW 「ルガル！」
	ELSEIF カードID == 53103
		PRINTFORMW 「ベアブルム！」
	ENDIF
ELSE
	IF GROUPMATCH(カードID,1891,11891,26521)
		PRINTFORMW 「私を특수소환！」
	ELSEIF カードID == 26520
		PRINTFORMW 「フラクトールを특수소환！」
	ELSEIF カードID == 26521
		PRINTFORMW 「ナーベルを특수소환！」
	ELSEIF カードID == 26522
		PRINTFORMW 「ケラスを특수소환！」
	ELSEIF カードID == 26893
		PRINTFORMW 「メルクーリエ！　飛んでけー！」
	ELSEIF カードID == 53100 || カードID == 53101
		PRINTFORMW 「シュー兄を특수소환！」
	ELSEIF カードID == 1890 || カードID == 11890
		PRINTFORMW 「リズ姉を특수소환！」
	ELSEIF カードID == 53102
		PRINTFORMW 「ルガルを특수소환！」
	ELSEIF カードID == 53103
		PRINTFORMW 「ベアブルム復活！」
	ENDIF
ENDIF

RETURN 1
