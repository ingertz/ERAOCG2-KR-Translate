	ELSE
		IF ライフ_자신 <= 2000
			PRINTFORMW 「私のターン！　全然歯ごたえ無いねー、このターンで終わっちゃうよ？」
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「ふむふむ……とりあえず、ドローしてから考えよっと！　私のターン！」
				CASE 1
					PRINTFORMW 「よーし回ってきた！　私のターン！」
				CASE 2
					PRINTFORMW 「私のターン！　さてさて、どうしてくれようか……」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF

