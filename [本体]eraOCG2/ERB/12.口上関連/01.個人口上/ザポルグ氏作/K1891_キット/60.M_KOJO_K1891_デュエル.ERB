;==================================================
;10,ダメージ反応！（ダメージ）
;==================================================
@M_KOJO_DUEL_K1891_10(ダメージ量,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC ダメージ量
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE ダメージ量
		;ダメージなし
		CASE 0
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「効かないねえ！」
				CASE 1
					PRINTFORMW 「わーははは！　ムダムダぁ！」
			ENDSELECT
		;１～１９９９の時、小ダメージ
		CASE 1 TO 1999
			IF ライフ_상대 <= 0
				PRINTFORMW 「何とか……何とか……！」
				PRINTFORMW 「何ともならないや！　ぐわーっ！！！」
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「くうっ……！　このくらい、全然へっちゃらだもんね！」
					CASE 1
						PRINTFORMW 「うわあっ！　イテテテ……まだまだやれるよ！」
				ENDSELECT
			ENDIF
		;２０００～３９９９の時、結構なダメージ
		CASE 2000 TO 3999
			IF ライフ_상대 <= 0
				PRINTFORMW 「んー……ダメだこりゃ！　ぐわーっ！！！」
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「うわあああっ！　ま、まだ、やれる……！」
					CASE 1
						PRINTFORMW 「ぎゃああっ！？　結構クるなあ……！」
				ENDSELECT
			ENDIF
		;４０００～７９９９の時、超大ダメージ
		CASE 4000 TO 7999
			IF ライフ_상대 <= 0
				PRINTFORMW 「あ、待ってやばっ……！　あばーっ！！！」
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「ぐわーっ！！！　せ、セーフ……っ！」
					CASE 1
						PRINTFORMW 「ぎゃあああああっ！？！？　や、やっばぁ……！」
				ENDSELECT
			ENDIF
		;８０００以上、基本即死
		CASEELSE
			IF ライフ_상대 <= 0
				PRINTFORMW 「すーっ……さらばっ！　　のわーっ！！！！！」
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「む、ムリム……ぎゃあああああああ！！！！！」
					CASE 1
						PRINTFORMW 「待って！ストップ！し、死ぬ……っ！　どわーっ！！！！！」
				ENDSELECT
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「お、おおお……い、生きてる……」
					CASE 1
						PRINTFORMW 「おごご……し、死ぬ……っ！」
				ENDSELECT
			ENDIF
	ENDSELECT
ENDIF


