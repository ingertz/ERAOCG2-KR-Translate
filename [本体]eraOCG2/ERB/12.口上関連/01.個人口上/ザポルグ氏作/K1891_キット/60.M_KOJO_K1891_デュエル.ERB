;		IF カードID == 1000
;			PRINTFORMW 「ブラックマジシャンガールを소환！」
;		ENDIF

;==================================================
;0,デュエルスタート！
;==================================================
@M_KOJO_DUEL_K1891_0(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「ふっふっふっ、キットちゃんの卓越したデュエルタクティクスをご覧あれ！」
		CASE 2
			PRINTFORMW 「よーしデュエルだ！　負けないからね！」
		CASE 3
			PRINTFORMW 「手加減なし！　最初から全力で行くよー！」
	ENDSELECT
ENDIF

;==================================================
;1,モンスター소환
;例：%カード名%を소환！
;==================================================
@M_KOJO_DUEL_K1891_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF GROUPMATCH(カードID,1891,11891,16891)
		PRINTFORMW 「私を소환だー！」
	ELSEIF GROUPMATCH(カードID,1880,11880)
		PRINTFORMW 「いっけーエクレシアー！」
	ELSEIF GROUPMATCH(カードID,1884,11884,16884)
		PRINTFORMW 「おらっ！　行ってこいアルバス！」
	ELSEIF カードID == 26520
		PRINTFORMW 「フラクトールを소환！」
	ELSEIF カードID == 26521
		PRINTFORMW 「ナーベルを소환！」
	ELSEIF カードID == 26522
		PRINTFORMW 「ケラスを소환！」
	ELSEIF カードID == 26893
		PRINTFORMW 「行ってこいメルクーリエ！」
	ELSEIF カードID == 24700
		PRINTFORMW 「ロッキーを소환！」
	ELSEIF カードID == 24701
		PRINTFORMW 「ピードを소환！」
	ELSEIF カードID == 24702
		PRINTFORMW 「カモン！　ブラザーズ！」
	ELSEIF カードID == 24703
		PRINTFORMW 「バンカーを소환！」
	ELSEIF カードID == 24704
		PRINTFORMW 「うおー！行けー！　おかしらー！」
	ELSE
		SELECTCASE RAND:3 + 1
			CASE 1
				PRINTFORMW 「%カード名%を소환！」
			CASE 2
				PRINTFORMW 「行っけー！　%カード名%を소환！」
			CASE 3
				PRINTFORMW 「お願い通って！　%カード名%を소환！」
		ENDSELECT
	ENDIF
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_KOJO_DUEL_K1891_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF GROUPMATCH(カードID,1880,11880)
		PRINTFORMW 「いっけーエクレシアー！」
	ELSEIF GROUPMATCH(カードID,1884,11884,16884)
		PRINTFORMW 「おらっ！　行ってこいアルバス！」
	ELSEIF カードID == 24700
		PRINTFORMW 「ロッキーを특수소환！」
	ELSEIF カードID == 24701
		PRINTFORMW 「ピードを특수소환！」
	ELSEIF カードID == 24702
		PRINTFORMW 「カモン！　ブラザーズ！」
	ELSEIF カードID == 24703
		PRINTFORMW 「バンカーを특수소환！」
	ELSEIF カードID == 24704
		PRINTFORMW 「うおー！行けー！　おかしらー！」
	ELSE
		SELECTCASE 소환出処
			;EX덱에서 
			CASE 召種EX덱
				IF カードID == 1890
					PRINTFORMW 「仲間の補佐はおまかせ！　링크２、リズ姉！」
				ELSEIF カードID == 11890
					PRINTFORMW 「システム・スプライト搭載！　링크２、%カード名%！」
				ELSEIF カードID == 53100
					PRINTFORMW 「鋼の翼、響く銃砲、頭上羽ばたくは不吉の怪鳥！」
					PRINTFORMW 「全員まとめて吹っ飛ばせー！　링크４、%カード名%！」
				ELSEIF カードID == 53101
					PRINTFORMW 「黒鋼の大翼、轟く鎧砲、前を征くは不死身の吉鳥！」
					PRINTFORMW 「スプライトパワー全力全開！　링크５、%カード名%！」
				ELSEIF カードID == 53102
					PRINTFORMW 「ナメてたら痛い見るぜ！　링크３、%カード名%！」
				ELSEIF カードID == 53102
					PRINTFORMW 「行くぞ行くぞー！　링크２、ベアブルム！　発進！」
				ELSEIF カードID == 52400
					PRINTFORMW 「イヤッホー！　%カード名%！」
				ELSEIF カードID == 52401
					PRINTFORMW 「%カード名%！　発艦！」
				ELSE
					SELECTCASE RAND:3 + 1
						CASE 1
							PRINTFORMW 「%カード名%を특수소환！」
						CASE 2
							PRINTFORMW 「行っけー！　%カード名%を소환！」
						CASE 3
							PRINTFORMW 「カモーン！　%カード名%を특수소환！」
					ENDSELECT
				ENDIF
			;それ以外
			CASEELSE
				TRYCALLFORM CARDNAME_{カードID},"カテゴリ"
				IF MATCH(RESULTS,"鉄獣")
					CALL M_KOJO_DUEL_K1891_TRIBRIGADE(カードID,소환出処)
				ELSE
					SELECTCASE RAND:3 + 1
						CASE 1
							PRINTFORMW 「%カード名%を특수소환！」
						CASE 2
							PRINTFORMW 「行っけー！　%カード名%を소환！」
						CASE 3
							PRINTFORMW 「カモーン！　%カード名%を특수소환！」
					ENDSELECT
				ENDIF
		ENDSELECT
	ENDIF
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K1891_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
#DIMS DYNAMIC 全角レベル
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORMW 「%カード名%を의식소환！」
		CASE 융합
			CALL CARD_EROTICS(カードID)
			IF NO:RESULT == 1884 || 処理中_효과ID == 1884
				PRINTFORMW 「これぞアルバスの本領！　융합소환！%カード名%！」
			ELSE
				PRINTFORMW 「%カード名%を융합소환！」
			ENDIF
		CASE 싱크로
			PRINTFORMW 「싱크로소환！　%カード名%！」
		CASE 엑시즈
			IF カードID == 52400
				PRINTFORMW 「レベル４モンスター２体でオーバーレイネットワークを構築！」
				PRINTFORMW 「엑시즈소환！　イヤッホー！　%カード名%だ！」
			ELSEIF カードID == 52401
				PRINTFORMW 「レベル８モンスター２体でオーバーレイネットワークを構築！」
				PRINTFORMW 「엑시즈소환！　発艦準備完了！　%カード名%！」
			ELSEIF カードID == 52402
				IF 処理中_효과ID == 52402
					PRINTFORMW 「『スプリガンズ』몬스터 １장でオーバーレイネットワークを再構築！」
				ELSE
					PRINTFORMW 「レベル８モンスター２体でオーバーレイネットワークを構築！」
				ENDIF
				PRINTFORMW 「엑시즈소환！　これがセリオンズ・リングの“チャンピオン”だ！　%カード名%！」
			ELSE
				PRINTFORMW 「オーバーレイネットワークを構築！　엑시즈소환！%カード名%！」
			ENDIF
		CASE 링크
			IF カードID == 1890
				PRINTFORMW 「링크소환！　仲間の補佐はおまかせ！　링크２、リズ姉！」
			ELSEIF カードID == 11890
				PRINTFORMW 「링크소환！　システム・スプライト搭載！　링크２、%カード名%！」
			ELSEIF カードID == 53100
				PRINTFORMW 「鋼の翼、響く銃砲、頭上羽ばたくは不吉の怪鳥！」
				PRINTFORMW 「링크소환！　全員まとめて吹っ飛ばせー！　링크４、%カード名%！」
			ELSEIF カードID == 53101
				PRINTFORMW 「黒鋼の大翼、轟く鎧砲、前を征くは不死身の吉鳥！」
				PRINTFORMW 「링크소환！　スプライトパワー全力全開！　링크５、%カード名%！」
			ELSEIF カードID == 53102
				PRINTFORMW 「링크소환！　ナメてたら痛い見るぜ！　링크３、%カード名%！」
			ELSEIF カードID == 53102
				PRINTFORMW 「링크소환！　링크２、ベアブルム！　発進！」
			ELSE
				TRYCALLFORM CARD_{カードID},"レベル"
				SELECTCASE RESULT
					CASE 1
						全角レベル = １
					CASE 2
						全角レベル = ２
					CASE 3
						全角レベル = ３
					CASE 4
						全角レベル = ４
					CASE 5
						全角レベル = ５
					CASE 6
						全角レベル = ６
					CASE 7
						全角レベル = ７
					CASE 8
						全角レベル = ８
				ENDSELECT
				PRINTFORMW 「링크소환！　링크%全角レベル%！　%カード名%！」
			ENDIF
		;초차원モンスター（デュエマ）
		CASE 초차원
			TRYCALLFORM CARDNAME_{処理中_효과ID},"カテゴリ"
			IF MATCH(RESULTS,"초차원呪文")
				PRINTFORMW 「초차원ホールに接続！　出てこい！　%カード名%」
			ELSE
				PRINTFORMW 「초차원소환！　出てこい！　%カード名%！」
			ENDIF
	ENDSELECT
ENDIF

;==================================================
;4,효과使用宣言
;==================================================
@M_KOJO_DUEL_K1891_4(カードID,발동出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC 발동出処
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF GROUPMATCH(カードID,1880,11880)
		PRINTFORMW 「エクレシアの효과발동！」
	ELSEIF GROUPMATCH(カードID,1884,11884,16884)
		PRINTFORMW 「アルバスの효과를 발동！」
	ELSEIF カードID == 24700
		PRINTFORMW 「ロッキーの효과발동！」
	ELSEIF カードID == 24701
		PRINTFORMW 「ピードの효과발동！」
	ELSEIF カードID == 24702
		PRINTFORMW 「ブラザーズの효과발동！」
	ELSEIF カードID == 24703
		PRINTFORMW 「バンカーの효과발동！」
	ELSEIF カードID == 24703
		PRINTFORMW 「おかしらの효과발동！」
	ELSEIF GROUPMATCH(カードID,1890,11890)
		PRINTFORMW 「リズ姉の효과발동！」
	ELSEIF GROUPMATCH(カードID,11891,16891)
		PRINTFORMW 「私の효과！」
	ELSEIF カードID == 53102
		PRINTFORMW 「ルガルの효과를 발동！」
	ELSE
		SELECTCASE 발동出処
			CASE 1
				;손패발동
				IF カードID == 26520
					PRINTFORMW 「패의 フラクトールの효과발동！」
				ELSEIF カードID == 26522
					PRINTFORMW 「패의 ケラスの효과발동！」
				ELSEIF カードID == 26893
					PRINTFORMW 「読んでたよ！　メルクーリエの효과！」
				ELSE
					TRYCALLFORM CARD_{カードID},"종류"
					IF RESULT == 通常마법
						PRINTFORMW 「마법발동！　%カード名%！」
					ELSEIF RESULT == 速攻마법
						PRINTFORMW 「速攻마법발동！　%カード名%！」
					ELSEIF RESULT == 지속마법
						PRINTFORMW 「지속마법、%カード名%を발동！」
					ELSEIF RESULT == フィールド
						PRINTFORMW 「フィールド마법、%カード名%を발동！」
					ELSEIF RESULT == 速攻마법
						PRINTFORMW 「装備마법、%カード名%を발동！」
					ELSE
						PRINTFORMW 「패의 %カード名%の효과를 발동するよ！」
					ENDIF
				ENDIF
			CASE 2
				;필드발동
				IF カードID == 1891
					PRINTFORMW 「覚悟はよろしいかな？　私の효과！」
				ELSEIF カードID == 26520
					PRINTFORMW 「リソースは十分！　フラクトールの효과발동！」
				ELSEIF カードID == 26521
					PRINTFORMW 「行くぞ行くぞー！　ナーベルの효과발동！」
				ELSEIF カードID == 26522
					PRINTFORMW 「これがトライブリゲードの戦い方！　ケラスの효과발동！」
				ELSEIF カードID == 53100
					PRINTFORMW 「いっけー！　シュー兄の효과！」
				ELSEIF カードID == 53101
					PRINTFORMW 「モンスターが攻撃した時！　“BucephalusⅡ”が起動する！」
				ELSEIF カードID == 53101
					PRINTFORMW 「“チャンピオン”の효과발동！」
				ELSE
					PRINTFORMW 「%カード名%の효과를 발동するよ！」
				ENDIF
			CASE 3
				;마함발동
				IF カードID == 81890
					PRINTFORMW 「トライブリゲード最強カードの力、とくと見よ！　リバースカードオープン！　%カード名%！」
				ELSE
					TRYCALLFORM CARD_{カードID},"종류"
					IF GROUPMATCH(RESULT,지속마법,フィールド,지속함정)
						PRINTFORMW 「%カード名%の효과를 발동！」
					ELSEIF RESULT == 通常함정
						PRINTFORMW 「ここだ！　リバースカードオープン！　%カード名%！」
					ELSE
						PRINTFORMW 「마법＆함정 존의 %カード名%の효과를 발동するよ！」
					ENDIF
				ENDIF
			CASE 4
				;묘지발동
				IF カードID == 1891
					PRINTFORMW 「묘지に送られた私の효과！」
				ELSEIF カードID == 26521
					PRINTFORMW 「묘지に送られたナーベルの효과！」
				ELSEIF カードID == 53100 || カードID == 53101
					PRINTFORMW 「タダでは終わらんよ！　묘지に送られたシュー兄の효과！」
				ELSE
					PRINTFORMW 「묘지의 %カード名%の효과발동！」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF



;==================================================
;5,효과발동
;==================================================
@M_KOJO_DUEL_K1891_5(カードID,효과종류)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC 효과종류
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	;無効にされた場合
	IF 효과종류 == -1
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「なっ、なにーっ！？」
			CASE 1
				PRINTFORMW 「ぐえー！　やっぱりダメだった！」
			CASE 2
				PRINTFORMW 「ちょっとは大目に見てよー！」
		ENDSELECT
	;それ以外
	ELSE
		IF カードID == 1891
			IF 효과종류 == 필드起動
				PRINTFORMW 「何にしようかなー……よし、コレだー！」
			ELSE
				PRINTFORMW 「덱에서 『トライブリゲード』카드를 묘지へ送る！」
			ENDIF
		ELSEIF カードID == 11891
			IF 효과종류 == 손패起動
				PRINTFORMW 「융합状態のアルバスがいる時、패에서 특수소환できる！」
			ELSE
				PRINTFORMW 「덱에서 『烙印』마법 / 함정 카드를 손패に加える！」
			ENDIF
		ELSEIF カードID == 16891
			IF 효과종류 == 손패起動
				PRINTFORMW 「『トライブリゲード』か『スプリガンズ』がいる時、패에서 특수소환できる！」
			ELSE
				PRINTFORMW 「묘지의 『トライブリゲード』か『スプリガンズ』か『アルバス』を守備표시で특수소환する！」
			ENDIF
		ELSEIF カードID == 1890
			IF 효과종류 == 필드起動
				PRINTFORMW 「패에서 레벨４ 이하인 獣か비행야수족を특수소환する！」
			ELSE
				PRINTFORMW 「덱에서 １枚引いて、１枚戻す！　頼むよリズ姉ー……！」
			ENDIF
		ELSEIF カードID == 11890
			IF 효과종류 == 필드起動
				PRINTFORMW 「덱とＥＸ덱에서 カード名の異なる『トライブリゲード』２장 を묘지へ送る！」
			ELSE
				PRINTFORMW 「상대 필드의 몬스터 １장을 裏側표시にする！」
			ENDIF
		ELSEIF カードID == 26520
			IF 효과종류 == 필드起動
				PRINTFORMW 「묘지의 몬스터를 素材にして링크소환する！」
			ELSE
				PRINTFORMW 「덱에서 レベル３以下の獣か비행야수족を묘지へ送る！」
			ENDIF
		ELSEIF カードID == 26521
			IF 효과종류 == 필드起動
				PRINTFORMW 「묘지의 モンスターで링크소환するよ！」
			ELSE
				PRINTFORMW 「덱에서 『トライブリゲード』몬스터를 손패に加える！」
			ENDIF
		ELSEIF カードID == 26522
			IF 효과종류 == 필드起動
