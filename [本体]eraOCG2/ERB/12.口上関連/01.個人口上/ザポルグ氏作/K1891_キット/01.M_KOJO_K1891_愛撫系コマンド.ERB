;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「いやー……結構恥ずかしいね！これ！」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;질내出し直後
	;記入チェック
	LOCAL:2 = 1
	;-------------------------------------------------
	IF LOCAL:2 && TCVAR:질내사정플래그
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「うひゃー……いっぱい出したねぇ❤」
			CASE 1
				PRINTFORMW 「なんか、もったいないなぁ……せっかく%CALLNAME:MASTER%が出してくれたのに……」
			CASE 2
				PRINTFORMW 「んー……奥の方に出したねぇ……❤」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;노출증분기。ここを記入した場合、これより下は流れない
	;記入チェック
	LOCAL:3 = 1
	;-------------------------------------------------
	IF LOCAL:3
		SELECTCASE ABL:TARGET:노출증
			CASE 0,1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「どうかな？　特に人間と違うところは無いと思うんだけど・・」
					CASE 1
						PRINTFORMW 「あはは……そうマジマジ見られると、ちょっと照れるね……」
					CASE 2
						PRINTFORMW 「……そ、そろそろいいよね！　これ以上続けたら顔から火ぃ吹いちゃう！」
				ENDSELECT
			CASE IS >= 2
				SELECTCASE RAND:6
					CASE 0
						PRINTFORMW 「ほらほら～❤　%CALLNAME:MASTER%のをずっぽり飲み込んじゃうトコ、ちゃんと見ておいてね～❤」
					CASE 1
						PRINTFORMW 「ね、舐めてみたり、臭いも嗅いでみる？❤　見てるだけじゃつまんないでしょ❤」
					CASE 2
						PRINTFORMW 「ふっ……ふっ……❤　%CALLNAME:MASTER%……シよ？❤」
					CASE 3
						IF TALENT:MASTER:성별 == 1
							PRINTFORMW 「ねえ%CALLNAME:MASTER%、今度はどんなことをシてくれるの？❤」
						ELSE
							PRINTFORMW 「%CALLNAME:MASTER%の熱くてカチカチのやつ、ココに欲しいな～❤」
						ENDIF
					CASE 4
						PRINTFORMW 「えへへ……どんどん溢れてきちゃうね……❤」
					CASE 5
						PRINTFORMW 「ん……どう？　私とえっち、したくなってきた？❤」
				ENDSELECT
		ENDSELECT
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 2
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 
		CASE 2
			PRINTFORMW 
		;연모
		CASE 3
			PRINTFORMW 
		;親愛
		CASE 4
			PRINTFORMW 
	ENDSELECT
ENDIF
RETURN 1

