@M_KOJO_MESSAGE_COM_K1891_0_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;삽입中
	;記入チェック
	LOCAL:2 = 0
	;-------------------------------------------------
	;V삽입
	IF LOCAL:2 && TEQUIP:50 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	;A삽입
	ELSEIF LOCAL:2 && TEQUIP:51 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			PRINTFORMW 
			RETURN 1
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	ENDIF

	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 1
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「んっ……❤　そこそこー、いい感じー❤」
		CASE 2
			PRINTFORMW 「やん❤　%CALLNAME:MASTER%のえっちー❤」
		CASE 3
			PRINTFORMW 「んんっ❤　そこは敏感だから、やさしくして欲しいなー……❤」
		;연모
		CASE 4
			PRINTFORMW 「ふぅ……ふぅ……❤　%CALLNAME:MASTER%、もっとシて……❤」
		CASE 5
			PRINTFORMW 「ふっ❤んんっ❤はぁんっ❤　……いじわる❤」
		;親愛
		CASE 6
			PRINTFORMW 「えへへ❤　%CALLNAME:MASTER%に触られるのって好きだなー❤　愛されてる感じがするもん❤」
		CASE 7
			IF TALENT:MASTER:성별 == 2
				PRINTFORMW 「実は%CALLNAME:MASTER%の手って好きなんだよねー♪　こう、男らしくてさー❤」
			ELSE
				PRINTFORMW 「%CALLNAME:MASTER%の手つきって優しいよねー、やっぱ同性だとやりやすかったりする？」
			ENDIF
		;애처
		CASE 8
			PRINTFORMW 「%CALLNAME:MASTER%も女の子の扱いに慣れてきたねー❤　私も鼻が高いよ❤」
	ENDSELECT
ENDIF
RETURN 1
