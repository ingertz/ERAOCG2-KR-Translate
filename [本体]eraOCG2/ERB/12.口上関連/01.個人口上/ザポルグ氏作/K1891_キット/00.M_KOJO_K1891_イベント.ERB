;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT"系이벤트
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================
@M_KOJO_EVENT_K1891_1(ARG,ARG:1)
;구상主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------
IF LOCAL
	;空行
	PRINTFORML
	;-------------------------------------------------
	;一日初めての挨拶분기（MAIN/お外どちらも）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG,1,2,6) && CFLAG:TARGET:인사했음 == 0
		PRINTFORMW 「あ、%CALLNAME:MASTER%じゃん！　やっほー！」
		RETURN 1
	ENDIF

	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;MASTERIN
		IF CFLAG:TARGET:전턴위치 == CFLAG:MASTER:현재위치
			IF TALENT:TARGET:연모
				PRINTFORMW 「……あっ！　%CALLNAME:MASTER%ー！こっちこっち！」
			ELSE
				PRINTFORML 「むむむ……ここがこうなって、じゃあこっちは……」
				PRINTFORMW %CALLNAME:TARGET%は手元に集中しているようだ。
			ENDIF
		;TARGETIN
		ELSE
			IF TALENT:TARGET:연모
				PRINTFORML 「あっ！　%CALLNAME:MASTER%！ここにいたんだ！」
				PRINTFORMW %CALLNAME:TARGET%は%CALLNAME:MASTER%の近くに腰を下ろしてきた。
			ELSE
				PRINTFORMW 「あっ、%CALLNAME:MASTER%！　やっほー！」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;eraOCG2_V0.40_BT_240518時点では流れないため注意
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:TARGET:연모
			PRINTFORML 「あっ！　%CALLNAME:MASTER%！ここにいたんだ！」
			PRINTFORMW %CALLNAME:TARGET%は%CALLNAME:MASTER%の近くに腰を下ろしてきた。
		ELSE
			PRINTFORMW 「あっ、%CALLNAME:MASTER%！　やっほー！」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF TALENT:TARGET:연모 == 2 || TALENT:TARGET:굴복됨 || TALENT:TARGET:음란
			PRINTFORMW 「おー%CALLNAME:MASTER%ー、お先いただいてるよー♪」
		ELSE
			PRINTFORMW 「みょわっ！？　……%CALLNAME:MASTER%かー、あんまりジロジロ見ないでね？」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;eraOCG2_V0.40_BT_240518時点では流れないため注意
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが風呂に入ってきて追い出した
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML 「の、ノックもせずに入って来るんじゃなーい！　出ていけーっ！」
		PRINTFORMW %CALLNAME:TARGET%は超中圧実弾入り水鉄砲を乱射してきた！
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;eraOCG2_V0.40_BT_240522時点では流れないため注意
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORMW  
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他캐릭터と데이트중に遭遇した
	;eraOCG2_V0.40_BT_240522時点では流れないため注意
	;ARG:1にデート상대
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		PRINTFORMW  
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;朝起きたとき（おはよう구상）
;==================================================
@M_KOJO_EVENT_K1891_2(ARG,ARG:1)
;구상主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------
IF LOCAL
	;空行
	PRINTFORML
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;MASTERが起きていて、상대가 起きてきた（いつでも）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORMW 「んんん～！　あー、よく寝たー！」
		RETURN 1
	ENDIF
	[SKIPSTART]
	;非同棲かつ상대가 先に起きてる
	;20250310現在、流れる상황は無い
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		RETURN 1
	ENDIF
	[SKIPEND]
	;-------------------------------------------------
	;朝に성교
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「ふーっ……❤　おはよー、%CALLNAME:MASTER%❤」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;상대가 寝ている
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「にゅ～ん……あと３０分……」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが起きていて、상대가 起きてきた（朝のみ）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 「ふぁ～ぁ……%CALLNAME:MASTER%、おはよー……」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;상대가 起きてきて、MASTERが감기気味（朝のみ）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORMW 「んんー？ちょっと顔色悪いねー？　休んだ方がいいんじゃなーい？」
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;夜寝るとき（おやすみ구상）
;==================================================
@M_KOJO_EVENT_K1891_3(ARG,ARG:1)
;구상主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;自室に帰って寝る（～は【現在地】から【캐릭터の自室】に戻りました）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:우후후
			;우후후ダウン後に何も言わせない場合はここに何も書かない
			PRINTFORML
		ELSE
			PRINTFORMW 「そろそろ帰るね！　ばいばーい！」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;수면中（～は眠っている）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「ボルトが……ボルトが足りない……」
			CASE 1
				PRINTFORML 「すぴー……くかー……」
			CASE 2
				PRINTFORML 「むにゃむにゃ……まだイケる……」
		ENDSELECT
		RETURN 1
	ENDIF

	;-------------------------------------------------
	;쇠약して寝る（체력500以下,우후후時は우후후強制終了）
	;（캐릭터の自室以外：～を【現在地】から【캐릭터の自室】に運びました）
	;（캐릭터の自室　　：～は疲れたと言って、横になりました）
	;この後ARG == 1 が流れる
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF CFLAG:우후후
			;우후후中にダウン
			PRINTFORMW 「ひ……へへ……❤　さいこー……❤」
		ELSE
			PRINTFORMW 「うにゃ～……もうだめ～……」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（연모のみ,そのまま一日が終了）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF CFLAG:우후후
			;우후후中にダウン
			PRINTFORMW 「ありゃりゃ、バテちゃった？　……しょーがないなー❤」
		ELSE
			PRINTFORMW 「うぉわっ！？　ちょ、%CALLNAME:MASTER%！？　大丈夫！？」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1

