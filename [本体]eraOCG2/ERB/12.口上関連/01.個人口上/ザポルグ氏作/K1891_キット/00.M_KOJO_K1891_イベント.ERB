			PRINTFORMW 「ね❤　お願い、%CALLNAME:MASTER%っ❤　えっち❤えっちしたいっ❤」
		;見せ槍オナニー
		CASE 11
			PRINTFORMW 「あっ……❤　すーっ❤ふーっ❤すー……っ❤❤❤」
	
	;포식자のみ
		;問答無用逆レイプ
		CASE 15
			PRINTFORMW 「あは❤　つーかまえた❤」
	ENDSELECT
ENDIF
RETURN 1

;==================================================
;MASTERを看病する
;==================================================
@M_KOJO_EVENT_K1891_36(ARG,ARG:1)
;구상主はARG
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;--------------------------------------------------
IF LOCAL
	SELECTCASE ARG
		;フリースペース、地の文でも何でも好きに書いていい
		CASE 0
			PRINTFORMW 「これはね、おまじない。　身体の悪い所にするといいって、昔リズ姉に聞いたんだ」
		;汗を拭いて額に冷たいもの
		CASE 1
			PRINTFORMW 「どおー？　少しは楽になったー？」
		;療養食食べさせる
		CASE 2
			PRINTFORMW 「ふー、ふー…………ふー、ふー……」
		;薬を飲ませる
		CASE 3
			PRINTFORMW 「ほら！　勢いよく！　がーっと飲んじゃえ！」
		;子守唄を歌う
		CASE 4
			PRINTFORMW 「ねむれー、ねむれー……あたたかい夢の中へー……」
		;密着して傍にいる
		CASE 5
			PRINTFORMW 「んー……いつもより体温高いねー」
		;話し상대에게 なる
		CASE 22
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「看護用のロボットとか作ろっかなー」
				CASE 1
					PRINTFORMW 「辛そうだねー、寝てた方がいいんじゃなーい？」
				CASE 2
					PRINTFORMW 「病気ってかかった事ないから、どうすればいいとか分かんないだよねー……」
			ENDSELECT
		;薬を補充する
		CASE 23
			PRINTFORMW 「薬買ってきたよー、この辺に置いとくねー」
	ENDSELECT
ENDIF
RETURN 1
