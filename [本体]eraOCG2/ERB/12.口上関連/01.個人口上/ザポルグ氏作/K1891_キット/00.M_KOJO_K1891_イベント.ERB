;==================================================
;帰宅時/外出時
;==================================================
@M_KOJO_EVENT_K1891_11(ARG,ARG:1)
;구상主はLOCALS or RESULT
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;--------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;MASTER通常帰宅
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORMW 「お帰りー、%CALLNAME:MASTER%ー」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTER仕事・学校終わり帰宅
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:2 = 1
	;-------------------------------------------------
	IF LOCAL:2 && ARG == 1
		IF TALENT:TARGET:애처
			PRINTFORMW 「お帰りー、ご飯にするー？　お風呂にするー？」
		ELSE
			PRINTFORMW 「あ、%CALLNAME:MASTER%ー、お疲れー」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;一緒に데이트중帰宅
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:3 = 1
	;-------------------------------------------------
	IF LOCAL:3 && ARG == 2
		IF TALENT:TARGET:연모
			PRINTFORMW 「ふふふーん♪　また遊びに行こうねー♪」
		ELSE
			PRINTFORMW 「いやー、楽しかったねー！　またそのうち行こっか！」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;캐릭터が外出から帰宅する
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:4 = 1
	;-------------------------------------------------
	IF LOCAL:4 && ARG == 3
		PRINTFORMW 「ただいまー！　%CALLNAME:MASTER%ー、荷物運ぶの手伝ってー！」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;캐릭터がバイトから帰宅する
	;（来訪캐릭터のみ,自宅が無い캐릭터でも発生します）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:5 = 1
	;-------------------------------------------------
	IF LOCAL:5 && ARG == 4
		IF TALENT:TARGET:연모
			PRINTFORMW 「うへー！つかれたー！　%CALLNAME:MASTER%ー！　ねぎらってー！」
		ELSE
			PRINTFORMW 「ただいまー……」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;家に訪問してくる
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:6 = 1
	;-------------------------------------------------
	IF LOCAL:6 == 1 && ARG == 5
		;訪問してくる
		IF ARG:1 == 0
			PRINTFORMW 「%CALLNAME:MASTER%ー、いるー？」
		;「はい」を選択
		ELSEIF ARG:1 == 1
			PRINTFORMW 「おじゃましまーす！」
		;「いいえ」を選択
		ELSEIF ARG:1 == 2
			PRINTFORMW 「えー！　面白そうなおもちゃいっぱい持ってきたのにー！」
		;手が離せない状態で、帰ってくれる
		ELSEIF ARG:1 == 3
			PRINTFORMW 「……なーんだ、留守かー」
		;手が離せない状態で、入ってきた
		ELSEIF ARG:1 == 4
			PRINTFORMW 「……よし、開いた。　おじゃましまーす！」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠いのでカード/家へ帰る
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:7 = 1
	;-------------------------------------------------
	IF LOCAL:7 == 1 && ARG == 6
		PRINTFORMW 「ふぁ～あ……眠いから、もう帰るねー……」
	ENDIF
	;-------------------------------------------------
	;一人で外出をする
	;（来訪캐릭터の帰宅時に欲求不満と욕망が高いと発生）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:8 = 1
	;-------------------------------------------------
	IF LOCAL:8 == 1 && ARG == 7
		;通常外出
		IF ARG:1 == 0
			PRINTFORMW 「%CALLNAME:MASTER%ー！　ちょっと出かけてくるー！」
		;バイト外出
		ELSEIF ARG:1 == 1
			PRINTFORMW 「うえー、めんどくさいよー。　いってきまーす……」
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1

;==================================================
;自室暮らしを承認して貰う
;==================================================
@M_KOJO_EVENT_K1891_19(ARG,ARG:1)
;구상主はARG
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;--------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;이벤트発生
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORMW 「ねー、%CALLNAME:MASTER%ー。　ちょっといいー？」
		PRINTFORML ベッドにシーツを着せたり剥がしたりしていると、%CALLNAME:TARGET%が話しかけてきた。
		PRINTFORMW %CALLNAME:TARGET%にしては珍しく大人しいというか、しおらしい雰囲気だ。
		PRINTFORML 「えっとね……あ……うん、今って%CALLNAME:MASTER%の部屋にいっぱい私の私物が置いてあるじゃん？
		PRINTFORMW 　それの整備とか、新しい道具の開発とかに便利だから、%CALLNAME:MASTER%の家で寝泊まりしたいなーって……」
		PRINTFORMW つまりは同棲の提案のようだ。
		PRINTFORML それよりも私物というのが気になる。
		PRINTFORMW 家の中には%CALLNAME:TARGET%の物らしき道具は散乱していないのだが。
		PRINTFORMW 「電気ケトルとか電子レンジとかリモコンとか、ちょこーっと弄ってるから大体私のものかなーって」
		PRINTFORML いつの間にそんなことを……
		PRINTFORMW ところで改造の内容って？
		PRINTFORMW 「基本的にはボタンの접촉の解消だったり、性能の向上だったり……全体としてはビームが出るね」
		PRINTFORMW なんでビームが？？？？？
		PRINTFORMW 「だってカッコイイし……%CALLNAME:MASTER%の家の防衛力上げたかったし……」
		PRINTFORML 指を突きつけ合いながら、%CALLNAME:TARGET%はイタズラがバレた猫のように答えた。
		PRINTFORMW さて、どうしようか……
		RETURN 1
	ENDIF

	;-------------------------------------------------
	;認められる
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 同棲を了承した瞬間、%CALLNAME:TARGET%の顔がぱぁぁぁっと明るくなった。
		PRINTFORMW 「ほんと！？　本当に本当！？　クーリングオフは効かないよ！？」
		PRINTFORML %CALLNAME:TARGET%はグイグイくっつく勢いで迫ってきて肩を掴んできた。
		PRINTFORMW 二言は無い、やると言ったらやる。
		PRINTFORMW 「わーい！やったー！　よーし、今日はこの家中のもの全部からビームが出るようにするぞー！」
		PRINTFORML まずい、このままでは수면の質３０％オフセールが始まってしまう。
		PRINTFORMW 寝室から出ていこうとする%CALLNAME:TARGET%をコタツの如くベッドに引きずり込む。
		PRINTFORMW 「わっ……ちょっ、えっ、なぁ……！？」
		PRINTFORML なんということでしょう。
		PRINTFORMW 先ほどまで挙動万々歳だった%CALLNAME:TARGET%が、まるで借りてきた猫のように大人しくなったではありませんか。
		PRINTFORMW 「…………❤」
		PRINTFORML 潤んだ目でこちらを見つめる%CALLNAME:TARGET%。
		PRINTFORMW 中々いい抱き心地だし、このまま眠ってしまおう……
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;認められない
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「えー！　なんでー！？」
		PRINTFORML なんでも何もありません！
		PRINTFORML 家のそこら中からビームを出せるようにしちゃって！
		PRINTFORMW そういう事はちゃんと片付けてから言いなさい！
		PRINTFORMW 「うわーん！　%CALLNAME:MASTER%のケチー！　赤外線センサー！」
		PRINTFORML そう叫んで%CALLNAME:TARGET%はカードの中へと帰っていった。
		PRINTFORMW ……赤外線センサーは軽くライン越えではないだろうか。
		RETURN 1
	ENDIF
ENDIF
RETURN 1

