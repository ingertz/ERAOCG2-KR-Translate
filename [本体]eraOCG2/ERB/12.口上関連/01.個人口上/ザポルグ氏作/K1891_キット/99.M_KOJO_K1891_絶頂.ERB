	IF EXP_UP(15,TARGET) == NOWEX:MASTER:사정 * 3
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「んっ❤　んんんっ……・ごくん❤　ふー……❤」
			CASE 1
				PRINTFORMW 「ぐちゅ……ぎちゅ……ごくんっ❤　はー……❤」
		ENDSELECT
	;顔射
	ELSEIF !EXP_UP(15,TARGET) == NOWEX:MASTER:사정 * 3
		PRINTFORMW 「あっ……もったいないなぁ……」
	ENDIF
ENDIF
RETURN 1

