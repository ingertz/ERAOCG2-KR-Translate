;TARGETが구상主である場合
LOCAL =  MASTER_POSE(4,1,1)
CALL M_KOJO_MESSAGE_PALAMCNG_A_K1891_30_1(LOCAL)
;戻り値とTARGETを보존、TARGETを二人目に一時的に交代して二人目구상を呼び出した後、TARGETをもどして보존した戻り値でRETURNする
;二人目はいらない場合はここで処理
;二人目
LOCAL = MASTER_POSE(4,1,1)
LOCAL:1 = RESULT
LOCAL:2 = TARGET
TARGET = LOCAL
TRYCALLFORM M_KOJO_MESSAGE_PALAMCNG_A_K{NO:TARGET}_30_2(LOCAL:2)
TARGET = LOCAL:2
RETURN LOCAL:1

