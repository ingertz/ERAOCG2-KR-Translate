;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;분기作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:절정
;4以上で昇天、3で超強절정、2で強절정、1で절정

;NOWEX:Ｃ절정 NOWEX:Ｖ절정 NOWEX:Ｂ절정 NOWEX:Ａ절정 NOWEX:Ｍ절정
;各部位の절정

;NOWEX:二重절정、NOWEX:三重절정、NOWEX:四重절정、NOWEX:五重절정
;同時に절정した時の状態
;上記五つに加えてNOWEX:Ｅ절정でも판정

;TOTALEX
;地の文の판정に使われているもの
;5以上で潮を吹き、4以下で背中を反らせて절정する
;詳しくはEVENT_MESSAAGE_ORGASMを参照

;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが삽입中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが삽입中となる。

;NOWEX:사정
;사정量、最大3。たとえばIF NOWEX:MASTER:사정 > 1だと、あなたが大量사정以上した場合となる。

;==================================================
;절정時の구상
;==================================================
@M_KOJO_MESSAGE_PALAMCNG_B_K1891(ARG)
#DIM TOTALEX
#DIM DYNAMIC 호감도修正
CALL PALAM_MESSAGE_B(ARG)
TOTALEX =  NOWEX:ARG:Ｃ절정 + NOWEX:ARG:Ｖ절정 + NOWEX:ARG:Ａ절정 + NOWEX:ARG:Ｂ절정+ NOWEX:ARG:Ｍ절정 + NOWEX:ARG:Ｅ절정 + NOWEX:ARG:분유 + NOWEX:ARG:사정
SIF !(TOTALEX + NOWEX:ARG:방뇨)
	RETURN 0
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;분유
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:분유 && NOWEX:ARG:절정 <= 2 && !TCVAR:ARG:전턴절정
		PRINTFORMW 「あっ❤　イっ❤　ああっ❤　でるぅっ❤❤」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;사정した
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:2 = 0
	;-------------------------------------------------
	IF LOCAL:2 && NOWEX:ARG:사정 && NOWEX:ARG:절정 <= 2
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;방뇨
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:3 = 0
	;-------------------------------------------------
	IF LOCAL:3 && NOWEX:ARG:방뇨
		PRINTFORMW 
		RETURN 1
	ENDIF

	;구상の色の변경　この状態だとピンク色　必要ない場合はこことRESETCOLORを消す
	SETCOLOR C_H_PINK
	;基本セット
	;限界突破조교中
	IF BASE:ARG:체력 < 300
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「あぁっ！？❤　ぁ……ぁぁぁ……❤❤❤」
			CASE 1
				PRINTFORMW 「ぃ……っ❤　ぃっ……ぐぅっ❤❤❤」
			CASE 2
				PRINTFORMW 「ぁ゛……？　ぁぁ……❤　お゛ぁ゛……っ❤❤❤」
		ENDSELECT
	;通常
	ELSE
		SELECTCASE NOWEX:ARG:절정
			;절정
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「あっ❤　イっ、イクっ❤」
					CASE 1
						PRINTFORMW 「んっ❤　んんんんっ❤　──はぁぁっ❤❤❤」
					CASE 2
						PRINTFORMW 「イっ❤　イっ、イイっ……イクっ❤❤❤」
				ENDSELECT
			;強절정,超強절정
			CASE 2,3
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「はっ❤　あっ❤　あああっ❤」
					CASE 1
						PRINTFORMW 「ふぁっ❤　あっ❤❤❤　イグっっ❤❤❤」
					CASE 2
						PRINTFORMW 「ふぉっ❤　う゛っ❤　ああああっ❤　あ゛っっっ❤❤❤」
				ENDSELECT
			;昇天
			CASE IS >= 4
				PRINTFORMW 「だめっ❤❤❤　これだめっ❤❤❤　トぶっ──❤❤❤❤❤」
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1


