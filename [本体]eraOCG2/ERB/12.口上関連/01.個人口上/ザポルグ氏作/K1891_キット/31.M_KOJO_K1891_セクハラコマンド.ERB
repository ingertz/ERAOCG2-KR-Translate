CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1891_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1891_310_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;押し倒され中
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:2 = 1
	;-------------------------------------------------
	IF LOCAL:2 && CFLAG:TARGET:우후후 == 2
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「やん❤　えへへっ❤　ちゃんと揉んでねー❤」
			CASE 1
				PRINTFORMW 「ふーん、ふーん♪　ふふふふーん❤」
			CASE 2
				PRINTFORMW 「んふふー❤　%CALLNAME:MASTER%も楽しそうだねー❤」
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;친밀。ここを記入した場合、これより下は流れない
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1
		IF ABL:TARGET:친밀 >= 6
			SELECTCASE RAND:4
				CASE 0
					PRINTFORMW 「もー……他の子に、こういうことしちゃダメだよ？❤」
				CASE 1
					PRINTFORMW 「ふふふーん♪　キットちゃんのお尻の触り心地はいかがかな？❤」
				CASE 2
					PRINTFORMW 「私だけ触られるのは不公平じゃなーい？　%CALLNAME:MASTER%のも触らせてよー❤」
				CASE 3
					PRINTFORMW 「ひゃっ……んん……❤　尻尾は、あんまり触んないで欲しいかなー……❤」
			ENDSELECT
		;３以上
		ELSEIF ABL:TARGET:친밀 >= 3
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「も、もー！　触りたいのはわかるけど、こう好き勝手触られるのはさぁ……」
				CASE 1
					PRINTFORMW 「むっ…………むぅぅ……」
				CASE 2
					PRINTFORMW 「む～……あんま楽しくないと思うけどなぁ……」
			ENDSELECT
		;２以下
		ELSEIF ABL:TARGET:친밀 <= 2
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「いに゛ゃあっ！？　いきなりレディーのお尻を触るなんて、何考えてんの！？」
				CASE 1
					PRINTFORMW 「み゛っ！？　ちょっと！　急に尻尾に触らないでよ！あとお尻も！」
				CASE 2
					PRINTFORMW 「びゃあっ！？　なに、何か付けた！？」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 
		CASE 2
			PRINTFORMW 
		CASE 3
			PRINTFORMW 
		;연모
		CASE 4
			PRINTFORMW 
		;親愛
		CASE 5
			PRINTFORMW 
	ENDSELECT
ENDIF
RETURN 1
