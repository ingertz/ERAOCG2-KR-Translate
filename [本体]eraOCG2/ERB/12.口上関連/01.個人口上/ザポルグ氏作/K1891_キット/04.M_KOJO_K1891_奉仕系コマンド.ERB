@M_KOJO_MESSAGE_COM_K1891_80_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「ふん、ふん♪　ふふふーん♪」
		CASE 2
			PRINTFORMW 「すごい熱いねー❤　手がやけどしちゃいそう❤」
		CASE 3
			PRINTFORMW 「ガッチガチだねぇ……コーフンし過ぎじゃなーい？❤」
		CASE 4
			PRINTFORMW 「すんすん……❤　んふふ❤　えっちな匂いがぷんぷんしてるよー❤」
		CASE 5
			PRINTFORMW 「ビクビクしてきたねぇ❤　出ちゃう？❤出しちゃう？❤」
	ENDSELECT
ENDIF
RETURN 1

;==================================================
;81,펠라치오
;==================================================
@M_KOJO_MESSAGE_COM_K1891_81
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1891_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1891_81_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;ファースト키스
		IF EXP:TARGET:Ｍ경험 == 0 && EXP:TARGET:펠라경험 == 1 && CFLAG:TARGET:키스상실상대 == MASTER
			PRINTFORMW 「んちゅ……！？」
			PRINTFORM 「ちょっと！　ファースト키스がその……ち、
			SETCOLOR C_D_GRAY
				PRINTFORM ちんちん
			RESETCOLOR
			PRINTFORMW ……とか言わないでよ！❤」
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
		
	;お掃除펠라
	IF STAIN:MASTER:2 & 4 && ABL:TARGET:기교 >= 3
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「ん……じゅるる……ごくん❤」
			CASE 1
				PRINTFORMW 「れろ……むちゅ……んれぇ～……❤」
		ENDSELECT
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「ふー……❤　はい、キレイになったよ！❤」
			CASE 1
				PRINTFORMW 「んへへ……ごちそうさまー❤」
		ENDSELECT

	;通常
	ELSE
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORMW 「ちゅ……すん……臭いすっご……❤」
			CASE 2
				PRINTFORMW 「はむ……んむ……ちゅぅぅぅ……❤」
			CASE 3
				PRINTFORMW 「ちゅる……ん……しょっぱいの、どんどん溢れてくる……❤」
			CASE 4
				PRINTFORMW 「ちゅ……はむっ❤　じゅぷ……んふふっ❤」
			CASE 5
				PRINTFORMW 「ぐぷっ❤　じゅるっ❤　ふーっ❤　じゅるるるっ❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

