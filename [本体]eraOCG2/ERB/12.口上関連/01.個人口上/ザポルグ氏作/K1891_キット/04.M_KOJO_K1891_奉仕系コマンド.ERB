;==================================================
;86,スクワット
;TEQUIP:TARGET:Ｖ섹스 == MASTER (男性器を軸にする
;TEQUIP:딜도（딜도を軸にする
;==================================================
@M_KOJO_MESSAGE_COM_K1891_86
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1891_86_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1891_86_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;파생
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;기승위スクワット
	IF LOCAL:1 && TEQUIP:TARGET:Ｖ섹스 == MASTER
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「ふーっ❤ふーっ❤　ちょ、ちょっと一旦、휴식させてっ❤」
			CASE 1
				PRINTFORMW 「くっ……んんっ❤　気持ちいいのと、キツイのが、交互にっ……❤」
			CASE 2
				PRINTFORMW 「軸がブレてるって、しょうがないでしょっ❤　%CALLNAME:MASTER%のちんちん、気持ちいいんだからっ❤」
		ENDSELECT
		RETURN 1
	;딜도軸スクワット
	ELSEIF LOCAL:1 && TEQUIP:딜도
		SELECTCASE RAND:3
			CASE 0
				IF TALENT:MASTER:형태 >= 6
					PRINTFORMW 「ふっ……くうっ❤　%CALLNAME:MASTER%との練習に、丁度いいねっ……❤」
				ELSE
					PRINTFORMW 「ぐっ……きっつ……❤　%CALLNAME:MASTER%のより、ぶっとい……！❤」
				ENDIF
			CASE 1
				PRINTFORMW 「ふーっ❤ふーっ❤　腰、持ってかれそう……っ❤」
			CASE 2
				PRINTFORMW 「うっ……やばっ……❤　腰が、震えっ……ん゛ん゛っ❤」
		ENDSELECT
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 0
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 0
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「ふんっ！ふんっ！　ゴルゴンダを走り回るんだから、これくらいはねっ！」
		CASE 2
			PRINTFORMW 「ふーっ！　ちゃんとやると、結構キツイね！」
		CASE 3
			PRINTFORMW 「ふっ……ふっ……見てるだけじゃなくて、%CALLNAME:MASTER%もやったら？」
	ENDSELECT
ENDIF
RETURN 1
