		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	IF TALENT:TARGET:몸두께 >= 2
		PRINTFORMW 「ちょ、ちょーっと油断しちゃったから……あんまり見ないで❤」
	ELSE
		PRINTFORMW 「天才整備士はプロポーションもカンペキ！　恥じる所なんてありませーん！」
	ENDIF
ENDIF
RETURN 1

