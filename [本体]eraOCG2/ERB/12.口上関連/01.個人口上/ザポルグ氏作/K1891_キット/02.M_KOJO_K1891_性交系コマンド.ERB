;※※※※※※※※※※※※※※※※※※※※※※※※※
;성교系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;全て *삽입をする時* の구상のため、気持ちいい所を抉ったり、子宮を潰したい時は파생コマンドへ
;Ａ系は파생しないため、삽입継続で喘がせるといい感じになる
;==================================================
;60,정상위
;==================================================
@M_KOJO_MESSAGE_COM_K1891_60
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1891_60_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1891_60_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;정상위
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;처녀
		IF TCVAR:파과 == 1
			PRINTFORMW 「……うん、わかった。　いつかは、しなきゃならないもんね……」
			PRINTFORMW 「イヤってわけじゃないし、楽しみだけど……ちょーっとだけ、怖いかな！」
			PRINTFORML
			IF TFLAG:SELECTCOM분기
				PRINTFORMW %CALLNAME:TARGET%は壁に寄り掛かると、脚を持ち上げ、湿り気を帯びた女性器をこちらに見せつけてきた。
			ELSE
				PRINTFORMW %CALLNAME:TARGET%は床に寝そべると、脚を開いて湿り気を帯びた女性器をこちらに見せつけてきた。
			ENDIF
			PRINTFORML
			PRINTFORMW 「よし……いいよ！%CALLNAME:MASTER%！　ひと思いにやっちゃって！」
			PRINTFORMW 「痛くても大丈夫！　私、強いから！」
			PRINTFORML
			PRINTFORMW 微かに震える%CALLNAME:TARGET%の足を持ち上げながら、질내に陰茎をゆっくりと삽입した……
			PRINTFORML
			CALL M_KOJO_MESSAGE_COM_K1891_SHOJO_BREAK
			RETURN 1
		ELSE
			PRINTFORMW 「んっ❤　えへへ……❤　%CALLNAME:MASTER%ー、ぎゅってしよー❤」
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;삽입継続
	;삽입したままこの체위に切り替える
	;記入チェック
	LOCAL:2 = 1
	;-------------------------------------------------
	IF LOCAL:2 && TCVAR:V삽입관리플래그 == MASTER
		;前回사정した
		IF TCVAR:질내사정플래그 
			CALL M_KOJO_MESSAGE_COM_K1891_SEXCHANGE_2
			RETURN 1
		ELSE
			CALL M_KOJO_MESSAGE_COM_K1891_SEXCHANGE_1
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 0
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 0
	;立位
	IF TFLAG:SELECTCOM분기
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORMW 「あはは……❤　なんかこの体勢、すごいえっちだね❤」
			CASE 2
				PRINTFORMW 「んっ……えへへ❤　端から見たら、エッチしてるの丸わかりだね❤」
			CASE 3
				PRINTFORMW 「ふぅ……❤　なんか、安心するねぇー……❤」
		ENDSELECT
	;座位
	ELSE
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORMW 「%CALLNAME:MASTER%の顔が見えるから好きなんだけど、こっちの顔も見られるのがちょっと恥ずかしいね……❤」
			CASE 2
				PRINTFORMW 「んっ……えへへ❤　%CALLNAME:MASTER%ー❤　手、ぎゅってしよ❤」
			CASE 3
				PRINTFORMW 「ふぅ……❤　なんか、安心するねぇー……❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

