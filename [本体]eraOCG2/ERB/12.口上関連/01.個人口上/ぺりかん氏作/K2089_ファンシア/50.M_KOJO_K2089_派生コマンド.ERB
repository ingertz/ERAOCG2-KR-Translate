;==================================================
;1,シックスナイン
;==================================================
@M_KOJO_MESSAGE_SCOM_K2089_1
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2089_1_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2089_1_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「き、聞いたことぐらいあるってばぁ！　……お、お互いのお、……性器を舐め合うんだよね？」
		PRINTFORMW 「……さ、さぁやろうか！？　……きゃん！？　こ、こぉら！　黙って急に、舐めるなぁ……！」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		IF ABL:TARGET:봉사정신 >= 2
			PRINTFORMW 「ひぃん❤　こ、このぉ……！　れろっ♪　ぴちゃっ♪　んんっ❤　ちゅっ♪　ぐちゅっ♪　ひぅっ❤」
			PRINTFORMW 「へ、へへ……このまま、どっちが果てるか勝負だ……♪　ぢゅっ♪　ちゅぷっ♪　んあっ❤　ひぅぅ❤　んぢゅっ♪　んひぃ❤　……」
		ELSE
			PRINTFORMW 「ひゃん❤　だ、だめだってぇ❤　ようしゃ❤　してよっ❤」
			PRINTFORMW 「こ、これじゃ❤　僕、だけぇ❤　気持ちよくなってばっかりじゃん❤　だめ、ダメだよ……っ❤」
		ENDIF
		RETURN 1

	;それ以外
	ELSE
		PRINTFORMW 「あっ、あっ、だ、だめだって……！　このままじゃ、舐めるのに集中できない……っ！」
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K2089_{SELECTCOM}_1
RETURN 1

;==================================================
;2,岩清水
;クンニ。男が寝そべり、女が男の顔に跨る
;==================================================
@M_KOJO_MESSAGE_SCOM_K2089_2
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2089_2_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2089_2_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「うぇ？　ぼ、僕が%CSTR:TARGET:MASCALL%の顔にまたがるのぉ……？」
		PRINTFORMW 「うぅん……どう？　僕の、クサくないよね……？　重く、ないよね……？」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		PRINTFORMW 「あひっ❤　やめっ❤　や、やばいんだってぇ……❤」
		PRINTFORMW 「ふえ？　前をみろって……❤　あは……っ❤　ぼく、こんな❤　とろけてぇ……❤」
		RETURN 1

	;それ以外
	ELSE
		PRINTFORMW 「やっ、ヤダァ！？　そんな、つよく、舐めないでよぉ……！？」
		PRINTFORMW 「だ、だって、これでも顔を押しつぶさないよう力いれてるんだよ！？　腰砕けに、なっちゃうってぇ……！」
		RETURN 1
	ENDIF
ENDIF
