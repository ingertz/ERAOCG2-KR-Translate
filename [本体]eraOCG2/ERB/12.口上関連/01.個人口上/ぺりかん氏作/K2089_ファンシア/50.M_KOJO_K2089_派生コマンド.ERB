;1,식스나인
;==================================================
@M_KOJO_MESSAGE_SCOM_K2089_1
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2089_1_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2089_1_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「き、聞いたことぐらいあるってばぁ！　……お、서로의 お、……性器を舐め合うんだよね？」
		PRINTFORMW 「……さ、さぁやろうか！？　……きゃん！？　こ、こぉら！　黙って急に、舐めるなぁ……！」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		IF ABL:TARGET:봉사정신 >= 2
			PRINTFORMW 「ひぃん❤　こ、このぉ……！　れろっ♪　ぴちゃっ♪　んんっ❤　ちゅっ♪　ぐちゅっ♪　ひぅっ❤」
			PRINTFORMW 「へ、へへ……このまま、どっちが果てるか勝負だ……♪　ぢゅっ♪　ちゅぷっ♪　んあっ❤　ひぅぅ❤　んぢゅっ♪　んひぃ❤　……」
		ELSE
			PRINTFORMW 「ひゃん❤　だ、だめだってぇ❤　ようしゃ❤　してよっ❤」
			PRINTFORMW 「こ、これじゃ❤　僕、だけぇ❤　気持ちよくなってばっかりじゃん❤　だめ、ダメだよ……っ❤」
		ENDIF
		RETURN 1

	;それ以外
	ELSE
		PRINTFORMW 「あっ、あっ、だ、だめだって……！　このままじゃ、舐めるのに集中できない……っ！」
		RETURN 1
	ENDIF
ENDIF
