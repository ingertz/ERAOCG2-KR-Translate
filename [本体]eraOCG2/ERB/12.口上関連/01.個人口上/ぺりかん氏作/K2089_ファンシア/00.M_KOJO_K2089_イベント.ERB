;==================================================
;帰宅時/外出時
;==================================================
@M_KOJO_EVENT_K2089_11(ARG,ARG:1)
;구상主はLOCALS or RESULT
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;MASTER通常帰宅
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORMW 「おかえり～　お土産は『ただいま』でいいよ♪」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTER仕事・学校終わり帰宅
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:TARGET:연모 > 0
			PRINTFORMW 「おっつかれさま！　今日も一日、がんばったねっ♪」
		ELSE
			PRINTFORMW 「おつかれさま！　大変だったね」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;一緒に데이트중帰宅
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:TARGET:연모 > 0
			PRINTFORMW 「えっへへ、一緒にただいま、だね♪」
		ELSE
			PRINTFORMW 「%CALLNAME:TARGET%、たっだいま～！」
			PRINTFORMW 「そして%CSTR:TARGET:MASCALL%、おっかえり～！」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;캐릭터が外出から帰宅する
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「%CALLNAME:TARGET%ちゃんが帰ってきたよ！」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;캐릭터がバイトから帰宅する
	;（来訪캐릭터のみ,自宅が無い캐릭터でも発生します）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 「ふぃ～ヘトヘト……がんばってきたよ～……！」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;家に訪問してくる
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	;訪問してくる
	IF LOCAL:1 && ARG == 5 && ARG:1 == 0
		PRINTFORMW 「やっほ～♪　%CALLNAME:TARGET%がきたよ～♪」
		RETURN 1
	;「はい」を選択
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 1
		PRINTFORMW 「今日はお招きいただき感謝します……なんてね！」
		RETURN 1
	;「いいえ」を選択
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 2
		PRINTFORMW 「おおっと、ごめん！　じゃ、次の機会に！」
		RETURN 1
	;手が離せない状態で、帰ってくれる
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 3
		PRINTFORMW 「……あれっ？　返事がない、どうしたのかな？」
		PRINTFORMW 「……ま、アポ無しできたのは僕だしね。うん、今日は帰ろう！」
		RETURN 1
	;手が離せない状態で、入ってきた
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 4
		PRINTFORMW 「おやぁ、返事がない？　でも家にいるはずだよね……」
		PRINTFORMW 「……あ～もう！？　僕が悩んでもしょうがない！　とっつげき～……！」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠いのでカード/家へ帰る
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6 && ARG:1 == 0
		RETURN 1
	ELSEIF LOCAL:1 && ARG == 6 && ARG:1 == 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;一人で外出をする
	;（来訪캐릭터の帰宅時に欲求不満と욕망が高いと発生）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	;通常外出
	IF LOCAL:1 && ARG == 7 && ARG:1 == 0
		RETURN 1
	;バイト外出
	ELSEIF LOCAL:1 && ARG == 7 && ARG:1 == 1
		RETURN 1
	ENDIF
ENDIF
RETURN 1

