;310,尻を撫でる
;ABL:친밀(2以下=不快(TALENT:臆病なら涙目) 3以上=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 6以上=されるがまま)
;CFLAG:우후후==2&&TCVAR:TARGET:CT행동(31=後ろから抱きつく 32=前から抱きつく 50=수음 51=펠라 52=스마타 53=파이즈리 59=乳首吸われる
;60=딥키스 61=逆レイプ 70=クンニ強制 72=애널奉仕強制
;CFLAG:우후후==2&&TEQUIP:シックスナイン(パンツありTCVAR:TARGET:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================
@M_KOJO_SUCCESS_COM_K2089_310
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K2089_310
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2089_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2089_310_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;친밀。ここを記入した場合、これより下は流れない
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1
		;６以上
		IF ABL:TARGET:친밀 >= 6
			PRINTFORMW 
		;３以上
		ELSEIF ABL:TARGET:친밀 >= 3
			PRINTFORMW 
		;２以下
		ELSEIF ABL:TARGET:친밀 <= 2
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF
	;始めて尻さわる
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:TARGET:연모 >= 1
			PRINTFORMW 「こ、こらぁ……！　撫で回すなぁ……！　……どうせ僕のお尻が大きいってバカにしてるんでしょ……」
			PRINTFORMW 「……は！？　『おおきいことはいいことだ』って……も、もう！　……バカ♪」
		ELSE
			PRINTFORMW 「……ちょっと、やめてよ！？　お尻が大きいこと、気にしてるんだからね！！」
		ENDIF
		RETURN 1
	ENDIF	

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 1
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			IF TALENT:TARGET:연모 >= 1
				PRINTFORMW 「よ、よくもまぁ乙女のお尻をどうどうと撫で回せるね……！」
				PRINTFORMW 「……はぁ……なんでここで怒れないんだろうね、僕」
			ELSE
				PRINTFORMW 「……セクハラって言葉しってるかな」
			ENDIF
		CASE 2
			IF TALENT:TARGET:연모 >= 1
				PRINTFORMW 「ひ、ひとが気にしているところをよくもまぁ、どうどうと……！」
				PRINTFORMW 「……ね、ねぇ、ほんとにお尻が大きくていいと思ってるの？」
			ELSE
				PRINTFORMW 「……尻を撫で回すとかおっさんの痴漢みたいだよ？」
			ENDIF
		CASE 3
			IF TALENT:TARGET:연모 >= 1
				PRINTFORMW 「……えいっ♪」
				PRINTFORMW 「……わ、わ～！？　忘れてっ！　つい魔が差してお尻ふってみただけだからっ！　に、ニヤニヤするな、グーで殴るよ！？」
			ELSE
				PRINTFORMW 「……あんまりしつこいと、グー、だよっ♪」
			ENDIF
		;연모
		CASE 4
			IF TALENT:TARGET:연모 >= 2
				PRINTFORMW 「んっ♪　……ニシシ、%CSTR:TARGET:MASCALL%ってほんとに僕のお尻好きだよねぇ……♪」
				PRINTFORMW 「こ～んなに求めてくれるならおっきいお尻のままでよかったのかもねっ❤」
			ELSE
				PRINTFORMW 「……前ほど嫌がらなくなった？　ま、まぁそうだね……」
				PRINTFORMW 「ほ、ほら、実はあんまりコンプレックスに感じる必要なかったのかな～……な、なーんてねっ」
			ENDIF
		;親愛
		CASE 5
			PRINTFORMW 「……撫でてもあんまりぎゃーぎゃー言わなくなった？　まぁね」
			PRINTFORMW 「その、……%CSTR:TARGET:MASCALL%にお尻撫でられてると、『あぁ僕、君のモノにされちゃったんだなぁ』って気持ちになって、ね……❤」
		;애처
		CASE 6
			PRINTFORMW 「その、さ、ずっと僕のお尻さわってる%CSTR:TARGET:MASCALL%なら気づいてると思うんだけど、さ」
			PRINTFORMW 「……僕、もう産めるんだよ？　いつでも……♪」
	ENDSELECT
ENDIF
RETURN 1
