@M_KOJO_MESSAGE_COM_K2089_205_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
			PRINTFORMW 「……服を脱げって、意味わかってる？　この制服こそドレミコードとしての証」
			PRINTFORMW 「……つまりここからの僕は、『ドレミコード・ファンシア』さえも脱ぎ捨てた僕、だよ……❤」
		ELSE
			PRINTFORMW 「……ど、どうしよう……。この服、脱いじゃったら、僕、僕じゃなくなっちゃうよ……！」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모 || TALENT:TARGET:섹프
		PRINTFORMW 「……いいよ❤　ここからはただのオトコとオンナ……ただ愛し合おっか、ねっ……❤」
	
	;それ以外
	ELSE
		PRINTFORMW 「……ごめん、あっちむいてて？　いやその、ど、どうせ見られるってわかってるけどさぁ！　恥ずかしいものは恥ずかしいの！？」
	ENDIF
ENDIF
RETURN 1