;300,会話
;TFLAG:SELECTCOM분기(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより교양が4以上高い)
;TCVAR:302(0=会話可能 1=非연모時会話不能)
;MARK:반발각인(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;CFLAG:우후후(조교中の会話)
;CFLAG:변기화(肉便器の時の会話)
;==================================================
@M_KOJO_SUCCESS_COM_K2089_300
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K2089_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で구상色が付きません。
CALL TRAIN_MESSAGE
;구상メイン呼出
CALL M_KOJO_MESSAGE_COM_K2089_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2089_300_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
