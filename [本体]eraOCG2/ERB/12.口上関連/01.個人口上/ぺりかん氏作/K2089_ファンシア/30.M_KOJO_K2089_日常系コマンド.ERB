;480,デュエル
;勝敗はプレイヤーから見てのもの
;TFLAG:SELECTCOM분기(1=通常승리 -1=通常패배 -2=引き分け
;10=通常듀얼前 11=パック賭け듀얼前 12=デート賭け듀얼前 13=パンツ賭け듀얼前 14=お持ち帰り듀얼前 15=お前モンスターじゃないか？ 16=スケベ要求듀얼前 20=闇のゲーム
;31=パック賭け승리 32=デート賭け승리 33=パンツ賭け승리 34=お持ち帰り成功 35=カード化승리（牝以外） 36=スケベ要求事後 40=罰ゲーム！
;135=カード化見逃す 235=穏便カード化 335=凌辱後カード化 435=凌辱後見逃す
;50=賭け듀얼패배怒られた 51=パック賭け패배 52=デート패배デート 55=カード化패배 56=スケベ要求패배 156=スケベ要求弱味削除 256=スケベ要求패배負け癖付きおねだり)
;==================================================
@M_KOJO_MESSAGE_COM_K2089_480
;デュエルにTRAIN_MESSAGEはない
CALL M_KOJO_MESSAGE_COM_K2089_480_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2089_480_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;これが０の時はデュエルしない時なのでおわり
	SIF TFLAG:SELECTCOM분기 == 0
		RETURN 1

	;デュエル前
	IF INRANGE(TFLAG:SELECTCOM분기,10,21)
		SELECTCASE TFLAG:SELECTCOM분기
			;通常듀얼
			CASE 10
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「デュエルだね！　よしやろうか！」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORMW 「ちょっとはデュエルにも慣れてきたからね！　退屈はさせないよっ♪」
						ELSE
							PRINTFORML 「デュエルはまだまだ不慣れだけど……手加減なんて頼んだりしないよ！」
							PRINTFORMW 「むしろ胸を借りるつもりでドーンといく！　さぁ勝負っ♪」
						ENDIF
					CASE 2
						IF EXP:MASTER:듀얼경험 >= 50 || TALENT:MASTER:수라
							PRINTFORML 「あ、あはは……%CSTR:TARGET:MASCALL%ってデュエルになると強者のオーラがあるよね……」
							PRINTFORMW 「お、臆してないよ……！？　……女は배짱！　いざ勝負っ！！」
						ELSE
							PRINTFORMW 「ダメで元々、当たって砕けろ！　デュエルしようか！」
						ENDIF
					ENDSELECT
			;ここから賭け듀얼
			;パック賭け
			CASE 11
				PRINTFORMW 「へへ♪　勝負なんてちょっとした賭けがあったほうが燃えるよね！　よしのった♪」
			;デート賭け
			CASE 12
				IF TALENT:TARGET:연모 >= 1
					PRINTFORMW 「へ？　で、デートを賭けてデュエル？　な、なんで……？」
				ELSE
					PRINTFORMW 「へ？　で、デート、を賭けてデュエル……？　え？　え？　え、あ、デュエル！　……え、あれぇ？」
				ENDIF 
			;パンツ賭け
			CASE 13
				IF TALENT:TARGET:연모 >= 1
					PRINTFORMW 「へ？　勝ったら僕のパンツをもらう……？　……へぇ、そういう、プレイ……？」
					PRINTFORMW 「すぅ……『こ、この卑劣漢め！？　ぼ、僕が成敗してやる！』……ニシシ、雰囲気でたかなっ♪」
				ELSE
					PRINTFORMW 「へあ！？　デュエルに勝ったらパンツをよこせ！？　え？　え？　えぇぇ！？　へ、あ、でゅ、デュエル！　……いや、ちょっと待って！？」
				ENDIF 
			;お持ち帰り
			CASE 14
				PRINTFORMW 
			;モンスターか問い詰める（人間は불가）
			CASE 15
				PRINTFORMW 
			;スケベ強要
			CASE 16
				PRINTFORMW 
			;闇のゲーム
			CASE 20
				PRINTFORMW 
		ENDSELECT

	;デュエル後
	ELSE
		SELECTCASE TFLAG:SELECTCOM분기
			;通常승리
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「まーけーたー！　……うう、どこが悪かったのかなぁ。もしよければ教えてよ」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORMW 「あ～れ～！？　ちょ、ちょっとは食い下がれるようになったと思ったんだけどなぁ……！？」
						ELSE
							PRINTFORML 「うが～！　負けた～！　……ねね、僕、どこがダメだったと思う？」
							PRINTFORMW 「僕だって負けっぱなしは嫌だからね！　もっと強くなって、次は絶対勝つからね……！」
						ENDIF
					CASE 2
						IF EXP:MASTER:듀얼경험 >= 50 || TALENT:MASTER:수라
							PRINTFORML 「ひえ～！？　や、やっぱ無理だった～！？」
							PRINTFORMW 「うぅ、動揺が顔に出てたかも……。%CSTR:TARGET:MASCALL%、プレッシャーがヤバいんだもん」
						ELSE
							PRINTFORMW 「くぅぅ……！　ダメだったか～……。あそこであぁしとけばよかったのかなぁ……？」
						ENDIF
					ENDSELECT
			;通常패배
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「よしっ！　僕の勝ち～♪」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORMW 「ニシシっ、どうよっ♪　僕だってやればできる子なんだからね～♪」
						ELSE
							PRINTFORML 「……！　やったっ、勝てた～！！」
							PRINTFORMW 「ねねねっ！　僕、強かった！？　強くなってるよね！！　やったぁ～♪」
						ENDIF
					CASE 2
						IF EXP:MASTER:듀얼경험 >= 50 || TALENT:MASTER:수라
							PRINTFORML 「……え？　ぼく、かてたの……？」
							PRINTFORMW 「……～！　やっ、やったぁ～！！　ぼ、僕、%CSTR:TARGET:MASCALL%に勝てたよぉ～！！」
						ELSE
							PRINTFORMW 「にひっ♪　僕のほうが一枚上手だったみたいだね～♪」
						ENDIF
					ENDSELECT
			;通常引き分け
			CASE 3
				SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「……えええっ！？　ひ、引き分けぇ～？」
					CASE 1
						IF EXP:MASTER:듀얼경험 >= 50 || TALENT:MASTER:수라
							PRINTFORML 「……ふぅ～……っし！」
							PRINTFORMW 「%CSTR:TARGET:MASCALL%のような歴戦の듀얼리스트상대に引き分けに持ち込めた……うん、僕、強くなってる！」
						ELSE
							PRINTFORMW 「へ？　このゲームに引き分けってあるの？　な、納得いかない、もう一戦しようよ～！？」
						ENDIF
					ENDSELECT
			;ここから賭け승리
			;パック賭け
			CASE 31
				SELECTCASE RAND:2
					CASE 0
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORML 「くっそぉ……！　いけると思ったのになぁ……！」
							PRINTFORMW 「……わかってるよ、僕は約束を違えない、ほら、あげるよっ」
						ELSE
							PRINTFORML 「こ、この初心者狩りめ……！　ここは僕に花を持たせてくれたっていいじゃん！？」
							PRINTFORMW 「……いやまぁ、手加減されたほうが嫌だけどさぁ……。あ、あとで덱相談、付き合ってよ」
						ENDIF
					CASE 1
						IF EXP:MASTER:듀얼경험 >= 50 || TALENT:MASTER:수라
							PRINTFORML 「あっちゃぁ……やっぱダメだったかぁ……。ワンチャン、狙いにいったんだけどなぁ……」
							PRINTFORMW 「しっかし、まだパック欲しいの？　強くなることに貪欲だねー……」
						ELSE
							PRINTFORMW 「だーめーでーしーたー！？　……うん、わかってるよ。約束のパックをどうぞ」
						ENDIF
					ENDSELECT
			;デート賭け
			CASE 32
				PRINTFORMW 「……もう、回りくどいなぁ。別に直接言ってくれれば付き合ったのに」
					SIF TALENT:TARGET:연모 >= 1
					PRINTFORMW 「……それとも何？　僕をトロフィー대신에 したかったの？　へへ……悪い気はしないね❤」
			;パンツ賭け
			CASE 33
				IF TALENT:TARGET:연모 >= 1
					PRINTFORMW 「う、うん、僕、まけちゃった、ね……❤　じゃ、約束だから、パンツ、あげるよ……❤」
					PRINTFORMW 「……ほら♪　もちろん僕がスパッツを脱いで、君にパンツを渡すところ、じっくり見てていいんだよ……❤」
				ELSE
					PRINTFORMW 「う、うぅぅ……わかってるよ、賭けは賭け……。……なぁんで僕、勢いで受けちゃったかなぁ……」
				ENDIF 
			;お持ち帰り
			CASE 34
				PRINTFORMW 
			;下二桁３５は"モンスターか問い詰める"の분기
			;カード化（牝以外、選択肢無し）
			CASE 35
				PRINTFORMW 
			;カード化を見逃す（元気でな！）
			CASE 135
				PRINTFORMW 
			;穏便に話してカード化（怖くないよ～痛くないよ～）
			CASE 235
				PRINTFORMW 
			;身体を対価に見逃す（見逃すとは言ってない）
			CASE 335
				PRINTFORMW 
			;身体を対価に見逃す（見逃す）（負け癖付いたり弱み握られたりする）
			CASE 435
				PRINTFORMW 
			;身体要求事後
			CASE 36
				PRINTFORMW 
			;闇のゲーム
			CASE 40
				PRINTFORMW 

			;ここから賭け패배
			;怒られた
			CASE 50
				PRINTFORMW 「バカッ！　な、なんてモノ賭けさせるんだよ！？」
			;パック賭け（パックを手渡す）
			CASE 51
				SELECTCASE RAND:2
					CASE 0
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORML 「へへ、僕の勝ちぃ～♪」
							PRINTFORMW 「ささっ、パックを頂戴♪　ニシシ、いいカード出るといいなぁ～♪」
						ELSE
							PRINTFORML 「やたっ♪　僕でも勝てたよ！」
							PRINTFORMW 「いえ～い、パックゲット～♪　へへ、これで덱をさらに強くするぞ……！」
						ENDIF
					CASE 1
						IF EXP:MASTER:듀얼경험 >= 50 || TALENT:MASTER:수라
							PRINTFORML 「か、かてた……！？　え、あれ、%CSTR:TARGET:MASCALL%調子悪いの！？」
							PRINTFORMW 「……あ、パックありがと……。へへ、嬉しいな……♪」
						ELSE
							PRINTFORMW 「しゃいっ♪　じゃ、パックちょ～だいっ♪　ほらほらっ、早く早くぅ♪」
						ENDIF
					ENDSELECT
			;デート賭け（デートはしてくれる）
			CASE 52
				IF TALENT:TARGET:연모 >= 1
					PRINTFORMW 「……ちょ、何負けてるのさ！？　ぼ、僕のこの期待に満ちた心をどうしろと……！」
					PRINTFORMW 「ああもう……！　……ほら！　手！　……デュエルで賭けてでも一緒に行きたかったんでしょ？　だったら諦めないでよ」
				ELSE
					PRINTFORMW 「……あのさぁ、こういうコトは直接頼みなよ。次は、ちゃんと待ってあげるから……」
					PRINTFORMW 「……ほら、いくよ。こっちは詳しくないから、……エスコート、おねがい」
				ENDIF 
			;カード化패배（逃げられた）
			CASE 55
				PRINTFORMW 
			;身体要求패배（金払う）
			CASE 56
				PRINTFORMW 
			;身体要求패배（弱味削除）
			CASE 156
				PRINTFORMW 
			;身体要求패배（負け癖付いてる時限定凌辱おねだり）（ラブホ直行）
			CASE 256
				PRINTFORMW 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

