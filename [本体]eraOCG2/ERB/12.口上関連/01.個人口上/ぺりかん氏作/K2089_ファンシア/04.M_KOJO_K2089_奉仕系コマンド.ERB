	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「ど、どーよっ♪　きもち、いーでしょ♪　ニシシッ♪」
				PRINTFORMW 「ほらほら♪　いつでもだしていーんだからねっ♪」
			ELSE
				PRINTFORMW 「……ど、どうかな？　……えっ、単調……！？　ちょ、それは聞き捨てならないなぁ……！」
				PRINTFORMW 「よ、よりにもよってドレミコードの僕が、リズムが単調……！？　ぜ、絶対ヒンヒン言わせてやるぅ……！」
			ENDIF
		CASE 2
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「ど、どうかなっ♪　なかなかどうして、上手になってきたんじゃないのっ♪」
