@M_KOJO_MESSAGE_COM_K2089_80_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「こ、こう……？　でいいのかな……？」
		PRINTFORMW 「あっ！？　ご、ごめん痛かった！？　う、うん。もうちょっと落ち着いてするよ……」
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「どう、気持ちいい？　リクエストがあったら言ってね♪」
			ELSE
				PRINTFORMW 「……ど、どうかな……？　うまく、できてる……？」
			ENDIF
		CASE 2
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「立派だねぇ、%CSTR:TARGET:MASCALL%のおチンチン……♪　僕もしごきがいがあるよ……❤」
			ELSE
				PRINTFORMW 「……うぇ、硬いのになんか妙に生暖かくて、あまり触りたい感じじゃないね……」
			ENDIF
		CASE 3
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「%CSTR:TARGET:MASCALL%はココが気持ちいいのかな♪　それともココかな♪　ふふ、わかってるよ、……ココ、でしょ……❤」
			ELSE
				PRINTFORMW 「……こ、ここが気持ちいいのかな？　それともここ……？　うぅん、あんまりビクビクさせないでよ、気持ち悪いなぁ……」
			ENDIF
		CASE 4
			PRINTFORMW 「……ん？　どうしたのかな♪　なにって、ちゃんと気持ちいいでしょ♪　ほぉら、%CSTR:TARGET:MASCALL%のおチンチンを僕の指が這って、ビクビクしてるじゃない♪」
			PRINTFORMW 「……にひっ♪　ごめんねイジワルして♪　ほら、ちゃんとしごいてあげるから……❤　僕の手で、天国までつれてってあげる……❤」
		CASE 5
			PRINTFORMW 「いつでもいいからね……❤　いっぱいだしてあげるからね……❤　僕の指、すきなだけ汚してね……❤　」
	ENDSELECT
ENDIF
RETURN 1

