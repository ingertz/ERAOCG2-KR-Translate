@M_KOJO_MESSAGE_COM_K2089_81_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;ファースト키스
		IF EXP:TARGET:Ｍ경험 == 0 && EXP:TARGET:펠라경험 == 1 && CALLNAME:(CFLAG:TARGET:키스상실상대) == CALLNAME:MASTER
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
				PRINTFORMW 「唇より先におチンチンにさせたいなんて……このへーんたいっ♪　ちゅっ♪」
			ELSE
				PRINTFORMW 「……ちゅっ……。うぇぇ、おチンチンに키스、しちゃった……」
				PRINTFORMW 「うぅ……こんなことなら体、差し出さなきゃよかった……。僕だって、乙女なんだよ……？」
			ENDIF
		;それ以外
		ELSE
			PRINTFORMW 「咥えるんだよね……？　や、やってみる、……あむっ！」
			PRINTFORMW 「あ゛っ！？　ご、ごめん、つい勢いでいっちゃって！　その、……だいじょうぶ？」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
		
	;お掃除펠라
	IF STAIN:MASTER:2 & 4 && ABL:TARGET:기교 >= 3
			PRINTFORMW 「いっぱいでたね、エライエライ……♪」
			PRINTFORMW 「にひっ♪　それじゃお掃除、しましょーね……❤」
	;通常
	ELSE
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
					PRINTFORMW 「んひっ♪　これ、けっこう顎がつかれるんだよ？　感謝しながら奉仕うけてよねっ❤」
				ELSE
					PRINTFORMW 「……んえ？　……歯が、あたってる？　ご、ごめん……」
				ENDIF
			CASE 2
				IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
					PRINTFORMW 「ニシシ♪　今の僕なら管楽器とかもイケちゃうかもね❤　%CSTR:TARGET:MASCALL%に仕込まれちゃったからなぁ……❤」
				ELSE
					PRINTFORMW 「……うぅん……ミアとか、先輩とかならもっと上手なのかなぁ」
				ENDIF
			CASE 3
				IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:섹프
					PRINTFORMW 「れろっ♪　ちゅぶっ♪　んちゅっ♪　……にひっ♪　ここ、舐められるの好きでしょ……❤」
				ELSE
					PRINTFORMW 「……ちゅっ……、んええ、クサイぃ……」
				ENDIF
			CASE 4
				PRINTFORMW 「れろっ♪　ちゅっ♪　んちゅっ♪　れろ、れろぉぉっ♪　……ん、なぁにかなっ♪　はいはいわかってるよ、今から咥えるからね❤」
				PRINTFORMW 「じゃ、僕のおくちでたっぷり気持ちよくなって、たっぷり、だしてね❤　あぁぁ……むっ❤」
			CASE 5
				PRINTFORMW 「いやぁ、びっくりだよ……❤　僕、音楽だけじゃなくてご奉仕にも才能あったんだねぇ……❤」
				PRINTFORMW 「にひっ♪　そうだよ❤　僕は%CSTR:TARGET:MASCALL%専用の娼婦だ……❤　いつでも好きにつかって、ね♪」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

