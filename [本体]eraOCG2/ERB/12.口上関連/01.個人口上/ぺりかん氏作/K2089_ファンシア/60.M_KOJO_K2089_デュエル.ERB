;カードID == (カードの番号)　でそのカード専用の구상が流せる
;カード番号は 10.デュエル関連/02.CARDS 内に入っているため、必要に応じて参照するように
;例：
;		IF カードID == 1000
;			PRINTFORMW 「ブラックマジシャンガールを소환！」
;		ENDIF

;==================================================
;0,デュエルスタート！
;==================================================
@M_KOJO_DUEL_K2089_0(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「さぁ、今日は僕だけのオンステージ！　だけど退屈はさせないよっ♪」
		CASE 2
			PRINTFORMW 「例え僕しかいなくても、덱のみんながついている！　ドレミコード、開演の時間だよっ♪」
		CASE 3
			PRINTFORMW 「始めようか、君と僕のアンサンブル！　お代は熱いデュエルでけっこう、だよっ♪」
	ENDSELECT
ENDIF

;==================================================
;1,モンスター소환
;例：%カード名%を소환！
;==================================================
@M_KOJO_DUEL_K2089_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF カードID == 2086
		PRINTFORMW 「一生懸命なみんなの妹！　%カード名%出番だよっ♪」
	ELSEIF カードID == 2087
		PRINTFORMW 「練習の成果、見せるときだよ！！　メアちゃんこと、%カード名%の登場！　拍手をどうぞ～♪」
	ELSEIF カードID == 2088
		PRINTFORMW 「僕しってるよ、エリーはすごいんだって！　%カード名%、今日もがんばろう！」
	ELSEIF カードID == 2089
		PRINTFORML 「ああこら、僕の言うこと聞けってば～！？
		PRINTFORMW 　……コホン。%カード名%、そう僕自身が상대だ！！」	
	ELSEIF カードID == 2094
		PRINTFORMW 「見習いだからって甘く見るなよっ！　%カード名%はすごいって、教えてやろう♪」			
	ELSE
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「%カード名%、出番だよっ♪」
		CASE 2
			PRINTFORMW 「いっけ～！　%カード名%소환♪」
		CASE 3
			PRINTFORMW 「GoGo!　%カード名%のお通りだ～♪」
	ENDSELECT
	ENDIF
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_KOJO_DUEL_K2089_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 소환出処
		;패에서 
		CASE 召種손패
			IF GROUPMATCH(カードID,2085,2086,2087,2088,2089,2090,2091,2092,2094,12085)		
				PRINTFORM 「
				SETCOLOR C_FIRE_T
				PRINTFORM 揺れろ、魂震わすタクト！　奏でよ、
				SETCOLOR C_M_GREEN
				PRINTFORM 光のシンフォニー！　펜듈럼소환！
				SETCOLOR C_L_RED
				PRINTFORMW 」
				IF カードID == 2086
					PRINTFORMW 「一生懸命なみんなの妹分！　%カード名%出番だよっ♪」
				ELSEIF カードID == 2087
					PRINTFORMW 「メアちゃん、ファイトだよ！！　さぁ皆さん、%カード名%の登場だ！　拍手をどうぞ～♪」
				ELSEIF カードID == 2088
					PRINTFORMW 「僕しってるよ、エリーはすごいんだって！　%カード名%、今日もがんばろう！」
				ELSEIF カードID == 2089
					PRINTFORML 「ああこら、僕の言うこと聞けってば～！？
					PRINTFORMW 　……コホン。%カード名%、そう僕自身が상대だ！！」	
				ELSEIF カードID == 2094
					PRINTFORMW 「見習いだからって甘く見るなよっ！　%カード名%はすごいって、教えてやろう♪」			
				ELSEIF カードID == 2090
					PRINTFORMW 「いこう、%カード名%さん！　今日も頼りにさせてもらいますっ♪」
				ELSEIF カードID == 2091
					PRINTFORMW 「ふっふっふ♪　僕の憧れ、%カード名%先輩がきてくれたぁ！！」
				ELSEIF カードID == 2092
					PRINTFORMW 「頼みます、先輩♪　さぁ驚きたまへ、%カード名%先輩の美しさに！！」
				ELSEIF カードID == 2085
					PRINTFORMW 「僕らの頼れる大先輩！！　%カード名%先輩の花道をあけよ～♪」
				ELSEIF カードID == 12085
					PRINTFORMW 「ふふっ♪　ただの妖精さんと、油断しないでね♪　%カード名%、いこう！」
				ELSE
					PRINTFORMW 「패에서 、%カード名%を특수소환！　さぁいくよっ♪」
				ENDIF
			ENDIF
		;마법함정ゾーンから。　キリ番・シェイプシスターなどを出す場合
		CASE 召種마함
			IF GROUPMATCH(カードID,2085,2086,2087,2088,2089,2090,2091,2092,2094,12085)		
				PRINTFORMW 「ドレミコード、Show must go on! 마법함정ゾーンからサプライズ登場っ♪」
			ELSE
				PRINTFORMW 「마법함정ゾーンから%カード名%、특수소환！　へへっ、驚いたっ？」
			ENDIF
		;덱에서 
		CASE 召種덱
			IF GROUPMATCH(カードID,2085,2086,2087,2088,2089,2090,2091,2092,2094,12085)		
				PRINTFORMW 「呼ばれて飛び出て～♪　ドレミコードはとまらないっ！」
			ELSE
				PRINTFORMW 「덱에서 %カード名%が来てくれたぞ～♪」
			ENDIF
		;EX덱에서 
		CASE 召種EX덱
			IF GROUPMATCH(カードID,2085,2086,2087,2088,2089,2090,2091,2092,2094,12085)		
				PRINTFORM 「
				SETCOLOR C_FIRE_T
				PRINTFORM 揺れろ、魂震わすタクト！　奏でよ、
				SETCOLOR C_M_GREEN
				PRINTFORM 光のシンフォニー！　펜듈럼소환！
				SETCOLOR C_L_RED
				PRINTFORMW 」
				IF カードID == 2086
					PRINTFORMW 「『ド』はドーナツのド！　%カード名%っ♪」
				ELSEIF カードID == 2087
					PRINTFORMW 「『レ』はレモンのレ！　%カード名%～♪」
				ELSEIF カードID == 2088
					PRINTFORMW 「『ミ』はみんなのミ！　%カード名%～♪」
				ELSEIF カードID == 2089
					PRINTFORMW 「『ファ』はファンシーのファ！　%カード名%、いくよっ♪」	
				ELSEIF カードID == 2090
					PRINTFORMW 「『ソ』は青い空～♪　%カード名%、頼みますっ♪」			
				ELSEIF カードID == 2091
					PRINTFORMW 「『ラ』はラッパのラ～♪　%カード名%先輩、今日もステキっ♪」
				ELSEIF カードID == 2092
					PRINTFORMW 「『シ』はしあわせ八重奏♪　%カード名%先輩に見惚れなさいっ！」
				ELSEIF カードID == 2085
					PRINTFORMW 「そして『C』はCoolのC！　我らが主役、%カード名%先輩！！」
				ELSEIF カードID == 2094
					PRINTFORMW 「大丈夫っ！　僕たちがついてるからね♪　%カード名%、一緒にいこう♪」
				ELSEIF カードID == 12085
					PRINTFORMW 「グランドレミコード様の御使いたちっ♪　%カード名%と共に奏でるよっ♪」
				ENDIF
			ELSEIF GROUPMATCH(カードID,2093,42085)
				PRINTFORML 「ドレミ界を突き抜けてどこまでも！　響け僕たちのシンフォニー！！」
				PRINTFORMW 「さぁ、おいで下さいませ、%カード名%！！」
			ELSE		
			PRINTFORMW 「EX덱より、%カード名%、특수소환っ♪」
			ENDIF
		;묘지から
		CASE 召種묘지
			PRINTFORMW 「묘지からでも특수소환～♪　%カード名%、出番だよっ♪」
		;제외状態から
		CASE 召種제외
			PRINTFORMW 「제외されたって、歌は届く！　%カード名%、帰還せよっ♪」
		;主にトークン生成
		CASE 10
			PRINTFORMW 「僕らの歌に誘われて、%カード名%がきてくれたぞ～♪　やったね！」
	ENDSELECT
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K2089_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORMW 「ニシシっ♪　僕らの音楽に呼ばれたのかなっ？　의식소환、%カード名%！」
		CASE 융합
			PRINTFORMW 「幻奏のみんな直伝っ♪　%カード名%、융합소환！」
		CASE 싱크로
			PRINTFORMW 「ゴキゲンなGROOVE、奏でてみよう♪　싱크로소환、響け！　%カード名%！」
		CASE 엑시즈
			PRINTFORMW 「音を重ねるのは得意だよ♪　엑시즈소환！　いこう、%カード名%！」
		CASE 링크
			IF カードID == 2093
				PRINTFORMW 「かくも麗しき女神様、僕たちの交響楽団に素晴らしき伴奏をお添えください……。링크소환！　%カード名%、光臨！」
			ELSEIF カードID == 42085
				PRINTFORMW 「装いも新たに、僕たちの女神様が光臨だ♪　링크소환！　さぁ行きましょう、%カード名%先輩！！」
			ELSEIF カードID == 1131
				PRINTFORMW 「本日のスペシャルゲストに来てもらったよっ♪　링크소환、%カード名%！　さぁ皆様拍手をどうぞ！！」
			ELSE
			PRINTFORMW 「音と音とを링크して、紡ぎ出すは新たなハーモニー！　링크소환♪　いくよ、%カード名%！」
			ENDIF
		;초차원モンスター（デュエマ）
		CASE 초차원
			PRINTFORMW 「君たちも僕たちと一緒に歌いたいんだねっ♪　초차원よりきたれ！　%カード名%っ♪」
	ENDSELECT
ENDIF

;==================================================
;4,효과使用宣言
;==================================================
@M_KOJO_DUEL_K2089_4(カードID,발동出処)
