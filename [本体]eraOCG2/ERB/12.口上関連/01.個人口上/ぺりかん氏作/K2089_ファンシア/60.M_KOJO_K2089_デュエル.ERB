						SETCOLOR 0xffaa8c
						PRINTFORM へっ♪　これなら%CSTR:TARGET:MASCALL%に
						SETCOLOR 0xffb8c9
						PRINTFORM も勝てるでしょ
						CALL XON_FONTL("♪　残念だったねっ……,！❤",C_PINK)
						RESETCOLOR						
					CASE 1
						PRINTFORM 「
						CALL XON_FONT("──√￣……まかせて、よ,壊❤",C_PINK)
						PRINTFORML 　……これが僕のとっておきっ！
						PRINTFORM 마법발동、%カード名%！　
						SETCOLOR 0xffaa8c
						PRINTFORM ニシシっ
						SETCOLOR 0xffb8c9
						PRINTFORM 、残念だっ
						CALL XON_FONTL("たね……,溶❤1",C_PINK)
						RESETCOLOR
					CASE 2
						PRINTFORM 「
						CALL XON_FONT("──√￣……めいれい、じゅだく,壊❤",C_PINK)
						PRINTFORML 　……くらえ、必殺のぉ、
						PRINTFORM 　%カード名%！　ど
						SETCOLOR 0xffaa8c
						PRINTFORM う、チェーンある
						SETCOLOR 0xffb8c9
						PRINTFORM ？　なければ효과処
						CALL XON_FONTL("理にうつるね……,❤❤❤",C_PINK)
						RESETCOLOR
				ENDSELECT
			ELSEIF GROUPMATCH(カードID,79853,79854,79855,79857)
				SELECTCASE RAND:3
					CASE 0
						PRINTFORM 「
						CALL XON_FONT("──√￣……りょうかい、したよ,壊❤",C_PINK)
						PRINTFORML ……きたっ♪　これが僕の最強の切り札っ
						PRINTFORM 　くらえ、%カード名%！！　この
						SETCOLOR 0xffaa8c
						PRINTFORM 효과により、僕は%CSTR:TARGET:MASCALL%にご奉
						SETCOLOR 0xffb8c9
						PRINTFORM 仕しなければならない！　覚
						CALL XON_FONTL("悟するんだねっ……,❤❤",C_PINK)
						RESETCOLOR
					CASE 1
						PRINTFORM 「
						CALL XON_FONT("──√￣……おおせの、ままに,壊❤",C_PINK)
						PRINTFORML 　……これならどうかなっ♪
						PRINTFORM 　%カード名%の효과발동！　ふ
						SETCOLOR 0xffaa8c
						PRINTFORM っふっふ♪　君は僕の奉仕攻
						SETCOLOR 0xffb8c9
						PRINTFORM 撃をうけなけれ
						CALL XON_FONTL("ばならない……,❤！",C_PINK)
						RESETCOLOR
					CASE 2
						PRINTFORM 「
						CALL XON_FONT("──√￣……チキチキチキ……,壊❤",C_PINK)
						PRINTFORML 　……%カード名%を손패から발동！
						SETCOLOR 0xffaa8c
						PRINTFORM 　효과により、%CSTR:TARGET:MASCALL%ち
						SETCOLOR 0xffb8c9
						PRINTFORM ゃんは僕の奉仕からは逃げられな
						CALL XON_FONTL("い♪　覚悟するんだね……,群❤",C_PINK)
						RESETCOLOR
				ENDSELECT
			ELSEIF カードID == 62086
				PRINTFORMW 「天まで響け、僕たちの交響曲！　%カード名%、발동っ♪」
			ELSEIF カードID == 62087
				PRINTFORMW 「このイラスト、懐かしいなぁ……♪　%カード名%발동するよっ♪」
			ELSEIF カードID == 62088
				PRINTFORMW 「僕たちが奏でる、幸せの多重奏っ！　響け！　%カード名%！！」
			ELSE
			PRINTFORMW 「패에서 ！　%カード名%を발동するよっ♪」
			ENDIF
