;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;분기作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:절정
;4以上で昇天、3で超強절정、2で強절정、1で절정

;NOWEX:Ｃ절정 NOWEX:Ｖ절정 NOWEX:Ｂ절정 NOWEX:Ａ절정 NOWEX:Ｍ절정
;各部位の절정

;NOWEX:二重절정、NOWEX:三重절정、NOWEX:四重절정、NOWEX:五重절정
;同時に절정した時の状態
;上記五つに加えてNOWEX:Ｅ절정でも판정

;TOTALEX
;地の文の판정に使われているもの
;5以上で潮を吹き、4以下で背中を反らせて절정する
;詳しくはEVENT_MESSAAGE_ORGASMを参照

;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが삽입中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが삽입中となる。

;NOWEX:사정
;사정量、最大3。たとえばIF NOWEX:MASTER:사정 > 1だと、あなたが大量사정以上した場合となる。

;==================================================
;절정時の구상
;==================================================
@M_KOJO_MESSAGE_PALAMCNG_B_K2035(ARG)
#DIM TOTALEX
#DIM DYNAMIC 호감도修正
CALL PALAM_MESSAGE_B(ARG)
TOTALEX =  NOWEX:ARG:Ｃ절정 + NOWEX:ARG:Ｖ절정 + NOWEX:ARG:Ａ절정 + NOWEX:ARG:Ｂ절정+ NOWEX:ARG:Ｍ절정 + NOWEX:ARG:Ｅ절정 + NOWEX:ARG:분유 + NOWEX:ARG:사정
SIF !(TOTALEX + NOWEX:ARG:방뇨)
	RETURN 0
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;분유
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:분유 && NOWEX:ARG:절정 <= 2 && !TCVAR:ARG:전턴절정
		IF EXP:TARGET:분유경험 < 2
			PRINTFORML 「なっ、何！？　わたしの、ナカから、何かが……っ！？」
			PRINTFORMDW %CALLNAME:TARGET%は自身の乳首から滲み出る母乳に、戸惑いを隠せないでいる……
		ELSEIF EXP:TARGET:분유경험 > 200
			IF TALENT:TARGET:연모
				PRINTFORML 「えへへ……❤　いっぱい、だしてもらいました……❤　いつも、ありがとう、ございます……❤」
				PRINTFORMW 「……でも、まだ……残ってる、みたいです……❤　%CALLNAME:MASTER%さん、もっと絞って、くださいますよね……❤」
			ELSE
				PRINTFORMW 「ああ……❤　おちちぃ……❤　しぼってぇ……❤　もっとしぼってぇ……❤」
			ENDIF
		ELSEIF EXP:TARGET:분유경험 > 50
			IF TALENT:TARGET:연모
				PRINTFORMW 「いいですっ❤　%CALLNAME:MASTER%さんに絞られるの、イイっ❤　もっとぉ❤　もっと%CALLNAME:TARGET%のお乳、だしてぇ……っ❤」
			ELSE
				PRINTFORMW 「んあっ❤　ち、ちがっ……！？　ああっ❤　か、感じ、感じてっ❤　あ゛あああっ❤」
			ENDIF
		ELSE
			IF TALENT:TARGET:연모
				PRINTFORMW 「とまらないっ❤　わたしのお乳、止まりませんっ❤　止めてぇ❤　%CALLNAME:MASTER%さん止めてぇ❤」
			ELSE
				PRINTFORMW 「どうしてっ！？　どうしてお乳が……っ！？　っあああ……っ！？」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;사정した
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:2 = 1
	;-------------------------------------------------
	IF LOCAL:2 && NOWEX:ARG:사정 && NOWEX:ARG:절정 <= 2
		IF EXP:TARGET:사정경험 < 2
			PRINTFORMW 「な、なんですかコレっ！？　ダメ、でるっ、사정るぅぅ……っ❤」
		ELSEIF EXP:TARGET:사정경험 > 200
			IF TALENT:TARGET:연모
				PRINTFORML 「%CALLNAME:MASTER%さんっ❤　%CALLNAME:MASTER%さぁんっ❤」
				PRINTFORMDW %CALLNAME:TARGET%は사정が終わったあとも無様に腰をヘコヘコしている……
			ELSE
				PRINTFORML 「あへぇ……❤　こんにゃの、ズルいですよぉ……❤」
				PRINTFORMDW %CALLNAME:TARGET%はふにゃふにゃの男性器を床ズリして愉しんでいる……
			ENDIF
		ELSE
			IF TALENT:TARGET:연모
				PRINTFORML 「ふああああっ❤　で、사정るぅ❤　せーし、사정るぅぅ……❤」
				IF TALENT:MASTER:성별 == 2
					PRINTFORMW 「……男の、ひとって……こんなに、気持ちいいんですね……っ❤」
				ELSE
					PRINTFORMW 「……えへへ❤　%CALLNAME:MASTER%、さぁん……❤　わたしの赤ちゃん……産んでぇ……❤」
				ENDIF
			ELSE
				PRINTFORML 「と、止まらないっ！？　あああっ、見ないでぇ！？」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;방뇨
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:3 = 0
	;-------------------------------------------------
	IF LOCAL:3 && NOWEX:ARG:방뇨
		PRINTFORMW 
		RETURN 1
	ENDIF

	;구상の色の변경　この状態だとピンク色　必要ない場合はこことRESETCOLORを消す
	SETCOLOR C_H_PINK
	;基本セット
	;限界突破조교中
	IF BASE:ARG:체력 < 300
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「……あっ❤　あー……❤　ああ……っ❤　あーー…………❤」
			CASE 1
				PRINTFORMW 「……ぃ❤　い、ぐぅ……っ❤」
			CASE 2
				CALL XON_FONT("お゛ー……,？❤,　お゛おぅ……っ,❤❤,　お゛ぉ゛,塵❤1,塵❤2,❤❤❤",C_H_PINK)
				PRINTFORMW 」
		ENDSELECT
	;通常
	ELSE
			SELECTCASE NOWEX:ARG:절정
				;절정
				CASE 1
					PRINTFORMW 「な、なんですかっ！？　あっ、ダメッ！　あああ……っ❤」
				;強절정
				CASE 1
					CALL XON_FONT("「ダメぇ,！❤,❤？,　がまん、できません……っ,❤！,？❤,　まってっ,！❤,　まってっ,❤❤,　イキますッ,！❤,　イクぅぅ……っ,❤❤",C_H_PINK)
					PRINTFORMW 」
				;超強절정
				CASE 1
					CALL XON_FONT("「ん゛ん～っ,❤！,？❤,　ん、ん゛ん～っ,❤！,❤？,　ああっ,！❤,　気持ちい,❤❤,　あぁぁぁあぁぁっ,塵❤1,塵❤2,❤❤❤",C_H_PINK)
					PRINTFORMW 」
				;昇天
				CASE IS >= 4
					CALL XON_FONT("「も゛っどぉ,❤❤,　も゛っと゛く゛ださ゛いっ,❤❤,❤❤,　だ゛め゛ぇ゛,❤❤❤,　あーっ,❤❤❤,　あ゛あ゛ーーっ,塵❤1,塵❤2,群❤",C_H_PINK)
					PRINTFORMW 」
			ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1


;==================================================
;あなたが사정したときに関する구상の표시
;一時的にTARGETを구상主に설정している
