;※※※※※※※※※※※※※※※※※※※※※※※※※
;CARD用구상
;※※※※※※※※※※※※※※※※※※※※※※※※※
;直接カードのIDを使える。
;캐릭터が無くても動く
;存在証明
@M_KOJO_CARD_K12035
RETURN 1
;==================================================
;0,モンスター소환時
;==================================================
@M_KOJO_CARD_K12035_0(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「……はいっ、『祈り手』がんばりますっ」	
ENDIF

;==================================================
;1,攻撃時
;==================================================
@M_KOJO_CARD_K12035_1(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「わ、わたしだって……っ」
ENDIF

;==================================================
;2,효과발동
;==================================================
;효과別で鳴らしたいなら、直接カードのデータを見て、설정する必要がある
;面倒、分からないであれば분기はせず
;失敗판정は、いわゆる효과を無効にされたとかそういうやつ
@M_KOJO_CARD_K12035_2(종류,失敗판정)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 종류
#DIM DYNAMIC 失敗판정
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 失敗판정 == 0
		IF 종류 == 필드起動
			PRINTFORMW 「……祈りよ、届いて……っ」
		ELSEIF 종류 == 破壊→묘지
			PRINTFORMW 「おねえさま……『かみさま』……後は、おまかせします……」
		ENDIF
	ELSE
		PRINTFORMW 「……わたしの祈りは、届かないの……？」
	ENDIF
ENDIF

;==================================================
;3,除去時
;==================================================
;いちいちなんでも除去で話すとやかましいため、デフォでは破壊にのみ反応するように설정
@M_KOJO_CARD_K12035_3(除去종류,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 除去종류
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 除去종류
	CASE 戦闘破壊行き
		PRINTFORMW 「きゃあっ！？」
	CASE 破壊行き
		PRINTFORMW 「せめて、この灯火だけでも……っ」
	CASE 제외行き
		PRINTFORMW 「……ああ、目の前が闇に……」
	ENDSELECT
ENDIF

