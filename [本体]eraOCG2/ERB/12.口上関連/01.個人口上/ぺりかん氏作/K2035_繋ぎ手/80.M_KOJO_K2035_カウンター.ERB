@M_KOJO_MESSAGE_COUNTER_K2035_10
#DIM DYNAMIC CTおさわり確認
#DIM DYNAMIC 호감도修正
CALL EVENT_COUNTER_MESSAGE(CTおさわり確認)
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;基本セット
	호감도修正 = 1
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORML 「ちょっと……暑くない、ですかねっ……❤」
			PRINTFORMDL %CALLNAME:TARGET%は服をパタパタと扇いでいる
		CASE 2
			PRINTFORML 「んんっ❤　ちょっとカラダがこっちゃいましたかねっ❤」
			PRINTFORMDL %CALLNAME:TARGET%は立ち上がると、ググーっと背を伸ばした……속옷が見えそうだ
		CASE 3
			PRINTFORML 「うーん……❤　カード、落ちてませんかねぇ……❤」
			PRINTFORMDL %CALLNAME:TARGET%は屈んでカードを探している……こちらに突き出された可愛らしいお尻をフリフリと揺らしながら……
	ENDSELECT
ENDIF
RETURN 1


