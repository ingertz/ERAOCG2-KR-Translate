;==================================================
;スカートめくり
;==================================================
@M_KOJO_MESSAGE_COUNTER_K2035_13
#DIM DYNAMIC CTおさわり確認
#DIM DYNAMIC 호감도修正
CALL EVENT_COUNTER_MESSAGE(CTおさわり確認)
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;基本セット
	;ノーパンMASTER
	IF !EQUIP:MASTER:하반신속옷２ && !EQUIP:MASTER:바지
		PRINTFORML 「……何もつけていないなんて、準備万端と見ますよっ❤」
	ELSE
		IF EQUIP:MASTER:하반신속옷２ == EQUIP:TARGET:하반신속옷２
			PRINTFORML 「あっ……❤　えへへ、%CALLNAME:MASTER%さん見てくださいっ❤」
			PRINTFORML 「パンツ、おそろいですねっ❤　うれしいなっ❤」
		ELSEIF GROUPMATCH(EQUIP:MASTER:하반신속옷２,2,3,6)
			PRINTFORML 「%CALLNAME:MASTER%さんもこういうパンツがお好きなのですかっ❤　ふふ、意外です❤」
		ELSEIF EQUIP:MASTER:하반신속옷２ == 50
			PRINTFORML 「知っています、こちら、伝統的なパンツなのですよね？」
			PRINTFORML 「伝統を大事にする%CALLNAME:MASTER%さん……ますますステキですっ❤」
		ELSEIF EQUIP:MASTER:하반신속옷２ == 70
			PRINTFORML 「わっ！？　こ、こんなのでパンツ代わりになるとおもってるんですか！？」
		ELSEIF EQUIP:MASTER:하반신속옷２ == 71
			PRINTFORML 「……！？　えへへ……❤　%CALLNAME:MASTER%さんったらオムツなんて履いて……❤」
			PRINTFORML 「わたしですらもう卒業しましたよ？　……わたしよりお子様ですねっ❤　よちよち、ですっ❤」
		ELSEIF GROUPMATCH(EQUIP:MASTER:하반신속옷２,12,15,16,17)
			PRINTFORML 「お、オトナですっ！？　オトナのパンツです……っ❤」
		ELSEIF GROUPMATCH(EQUIP:MASTER:하반신속옷２,22,23)
			PRINTFORML 「か、カゲキな……っ！？　む、ムラムラしちゃいました……っ❤」
		ELSE
			PRINTFORML 「えいっ❤　えへへ、子供のイタズラですっ❤」
		ENDIF
	ENDIF
ENDIF
RETURN 1

