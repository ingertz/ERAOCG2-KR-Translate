@M_KOJO_MESSAGE_COM_K2035_421_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	CALLFORM FASHION_TYPE(TARGET)
		IF RESULTS == "메이드"
			IF TALENT:TARGET:연모 >= 1
				PRINTFORML 「はいっ！　%CALLNAME:MASTER%さんにお仕えしますよ♪」
				PRINTFORMW 「それで、なんて呼ばれたいですか？　……わかりました、ごしゅじんさまっ❤」
			ELSE
				PRINTFORMW 「家事手伝い用の服ですねっ」
			ENDIF
		ELSEIF RESULTS == "바니"
			IF TALENT:TARGET:연모 >= 1
				PRINTFORMW 「ぴょーんぴょん♪　ウサギさんの服装ですねっ♪　えへへ、ウサギに見えますかね？」
				PRINTFORMW 「ぴょんぴょんっ♪　褐色ウサギさんだぴょん♪　……%CALLNAME:MASTER%さんに食べられたいぴょん❤」
			ELSE
				PRINTFORMW 「えへへ、ウサギさんの服です　……でもこれ、布面積が小さいですね？」
			ENDIF
		ELSEIF RESULTS == "サンタ"
			PRINTFORMW 「……%CALLNAME:MASTER%さん、良い子にしてますかっ？　どんな%CALLNAME:MASTER%さんでも……ちゃーんとプレゼント、用意してありますからねっ❤」
		ELSEIF RESULTS == "수영복" || RESULTS == "소수영복" || RESULTS == "금수영복"
			IF GET_MONTH() == "冬の月"
			;冬に水着なんてそりゃ怒られろ
				PRINTFORMW 「ふ、冬に水着なんておかしいですよっ！？」
			ELSEIF RESULTS == "수영복"
				IF TALENT:TARGET:연모 >= 1
					PRINTFORML 「……どうでしょうか、わたしの水着……その、店員さんに似合うものを見繕ってもらったのですが……子供っぽい、ですよね？」
					PRINTFORMW 「……えへへ、嬉しいですっ♪　その……もっと見てくださいっ❤　……子供のわたしを、オトナにしてくださいっ❤」
				ELSE
					PRINTFORMW 「……どうでしょうか、わたしの水着……その、店員さんに似合うものを見繕ってもらったのですが……子供っぽい、ですよね？」
				ENDIF
				SIF GET_MONTH() == "夏の月"
				PRINTFORMW 「……その、折角ですし……海に、行きたいなぁ……なんて」
			ELSEIF RESULTS == "금수영복"
				IF GET_MONTH() == "春の月"
					PRINTFORML 「大型連休にはコチラの水着を……？　よく、わかりませんが……%CALLNAME:MASTER%さんが言うなら……」
					PRINTFORMW 「着て見ましたが……えっ！？　撮影会！？　そういう習わし！？　……わ、わかりました、信じます……っ」
					IF TALENT:TARGET:연모 >= 1
						PRINTFORML 「こう……でしょうかっ……♪　も、もっと大胆に……？　で、では……こうっ❤」
						PRINTFORMW 「え、えへへ……❤　大股開きなんて、恥ずかしいですねっ❤　片手を紐に引っ掛けて欲しい？　……ええ、%CALLNAME:MASTER%さんの言う通りにっ……❤」
					ENDIF
				ELSE
					IF TALENT:TARGET:연모 >= 1
						PRINTFORMW 「金色は『かみさま』の色なんですっ♪　……そして『かみさま』に捧げられるモノも金色が多いんですっ❤」
						PRINTFORMW 「こんな防御力もない小さい布では……カラダを護ることもできませんねっ❤　……%CALLNAME:TARGET%は%CALLNAME:MASTER%さんへの捧げ物、ということですね……っ❤」
					ELSE
						PRINTFORMW 「金色は『かみさま』の色なんですっ♪　その、ちょっと布地が小さいことが気になりますが……この水着、気に入りましたっ♪」
					ENDIF
				ENDIF
			ELSEIF RESULTS == "소수영복"
				IF 依頼_完了횟수:304 != 0
					IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨
						IF TALENT:TARGET:모유체질
							PRINTFORMW 「もう……❤　折角牧場を持っているのに、わたしのことはお家で飼いたいんですか……❤　あっ、お乳が……❤」
							PRINTFORMW 「ご、ごめんなさい%CALLNAME:MASTER%さん……❤　わたし、もう……お乳をガマンできません……っ❤　その手で絞ってくださいませんか……っ❤」						
						ELSE
							PRINTFORMW 「モーゥ❤　えへへ、褐色のメスウシさんですっ❤　……ねぇ、%CALLNAME:MASTER%さん。お願い、聞いてくれますか……❤」
							PRINTFORMW 「わたし、あの牧場で飼われたいです……❤　だから、その……立派なメスウシに、してくださいませんか……っ❤」
						ENDIF
					ELSE
						PRINTFORMW 「えへへ、褐色のウシさんですっ♪　は、恥ずかしいですけど……牧場の宣伝ですよね？　わたし、がんばりますっ」
					ENDIF
				ELSE
					IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨
						IF TALENT:TARGET:모유체질
							PRINTFORMW 「もう……❤　%CALLNAME:MASTER%さん、わたしのことをウシさんだと思ってたんですか？　ヒドいですっ……❤」
							PRINTFORMW 「……こちらの世界の本で勉強したんですが、捧げ物にウシが選ばれることもあるそうですね……わたし、%CALLNAME:MASTER%さんに捧げられるんでしょうか……❤」
						ELSE
							PRINTFORMW 「可愛い柄ですねっ❤　……その、布地が小さいのが気になりますが……えへへ、ウシさんですっ♪」
							PRINTFORMW 「……%CALLNAME:MASTER%さん？　目つきがこわいですよ？　やだ、%CALLNAME:MASTER%さんに食べられちゃいますっ❤」
						ENDIF
					ELSE
						PRINTFORMW 「かわいい柄ですねっ♪　えへへ、ウシさんですっ♪　……その、布地が小さいのが気になりますが……」
					ENDIF
				ENDIF
			ENDIF
		ELSEIF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 
			IF GROUPMATCH(EQUIP:TARGET:하반신속옷２,2,3,6)
				PRINTFORML 「わたしのこと、お子様とおもってませんか？」
				PRINTFORMW 「……そういう風に振る舞って差し上げましょうか、”おにいちゃん”っ❤　……ふふ、冗談ですっ❤　恥ずかしいですからっ❤」
			ELSEIF GROUPMATCH(EQUIP:TARGET:하반신속옷２,4,5,10)
				PRINTFORML 「どうでしょうっ♪　わたしとしてはお尻がくっきりしていていいと思うのですがっ♪」
				PRINTFORMW 「……もう❤　手があたってますよう……❤」
			ELSEIF GROUPMATCH(EQUIP:TARGET:하반신속옷２,11,12,13,14)
				PRINTFORML 「これで、わたしも……オトナ、ですかねっ……❤　ふふっ、パンツに着られてるだけで終わっちゃダメですよね」
				PRINTFORMW 「……でも、わたし……%CALLNAME:MASTER%さんに襲ってもらえるなら、背伸びした子供のままで構いませんっ❤　ええ、%CALLNAME:TARGET%は%CALLNAME:MASTER%さんを挑発、していますっ❤」
			ELSEIF GROUPMATCH(EQUIP:TARGET:하반신속옷２,15,16,17)
				PRINTFORML 「……大胆、ですねっ❤　こんなの、パンツじゃないですよう……❤」
				PRINTFORMW 「……そんなにわたしの、お尻が気になりますか……？　えへへ、どうせなら……押し倒されたいなぁ、なんて……❤　ええ、いっぱい子作り、したいですっ……❤」
			ELSEIF GROUPMATCH(EQUIP:TARGET:하반신속옷２,22,23)
				PRINTFORML 「……%CALLNAME:MASTER%、さんっ❤　こんな、エッチな속옷を着せられて……❤　わたし、もうガマンできないですっ……❤」
				PRINTFORMW 「赤ちゃん、ほしいですっ❤　寝室へ……いえ、もうこのままこのクローゼットの中で構いませんっ❤　いますぐ、押し倒してっ……❤　わたしをたくさん、孕ませてください……っ❤」
			ELSEIF EQUIP:TARGET:하반신속옷２ == 50
				PRINTFORMW 「これがこの世界の伝統的なパンツ……ですか。ふふ、ゴムと違って締付を自由にできるのはいいですねっ♪」
				PRINTFORMW 「……どうしましたかっ❤　わたしのふんどし姿、興奮しましたかっ❤　えへへ、嬉しいなぁ……❤」
			ELSEIF EQUIP:TARGET:하반신속옷２ == 70
				PRINTFORMW 「……❤　これを、속옷と……言い張るのですね……っ❤　わかり、ましたっ……❤」
				PRINTFORMW 「でも、わたし……❤　かさぶたを剥がすように、これを……%CALLNAME:MASTER%さんに、剥がしてほしいです……っ❤」
			ELSEIF EQUIP:TARGET:하반신속옷２ == 71
				IF EXP:TARGET:방뇨경험 > 0
					PRINTFORMW 「ええ……❤　いつまた、%CALLNAME:MASTER%さんにおしっこをさせられるかわかりませんから……❤　オムツ、履かないとですね……❤」
				ELSE
					PRINTFORMW 「……わたし、そんなに子供じゃないです。お、オムツだなんて……」
					PRINTFORMW 「……それとも、そんなわたしを押し倒したいんですか？　なら、わたし……いくらでも、子供になりますねっ……❤」
				ENDIF
			ELSE
				PRINTFORMW 「ふふっ♪　似合ってますかねっ♪」
				PRINTFORMW 「……スカートの中見せてはしたない？　えへへ……❤　……挑発、してるんですよっ❤」
			ENDIF 
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%さん？　もうお着替えはおわりましたかね？」
		ENDIF
ENDIF
RETURN 1

