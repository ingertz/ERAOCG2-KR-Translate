;==================================================
;1,식스나인
;==================================================
@M_KOJO_MESSAGE_SCOM_K2035_1
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2035_1_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2035_1_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「서、서로 핥아주는 건가요、어쩐지 그거、엣치한데요……」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
				SELECTCASE RAND:3
			CASE 0
					PRINTFORML 「응！　꿀꺽♪　푸하……♪ 구후훗❤」
					;애널바이브
				IF TEQUIP:애널바이브
					PRINTFORMW 「んああっ❤　お、おしりの바이브、動かすのは……っ❤　はんそく、です……っ❤」
				;애널비즈
				ELSEIF TEQUIP:애널비즈
					PRINTFORMW 「んっ！？　び、ビースを、ひっぱら、ないでぇ……っ❤」
				;관장器＋プラグ
				ELSEIF TEQUIP:관장
					PRINTFORMW 「ぴぃっ❤　せ、栓がぬけちゃい、ますよう……っ❤　いや、です……っ❤　%CALLNAME:MASTER%さんを、よごしたくないぃ……っ❤」
				;확장벌룬
				ELSEIF TEQUIP:확장벌룬
					PRINTFORMW 「ごっ❤　ごぉぉっ❤　お、しりのぉ、あっぱく、感が……っ❤」
				;애널전극
				ELSEIF TEQUIP:애널전극
					PRINTFORML 「き゛い゛いぃぃっ❤　ダメっ❤　電流ダメッ❤　おしりっ❤　バカになっちゃうっ❤」
				ELSE
					PRINTFORMDW %CALLNAME:TARGET%는 클리토리스를 핥을 때마다 몸을 떨면서도、그보다 더 눈 앞의 자지를 맛보는 데 열중한다
				ENDIF
			CASE 1
					PRINTFORML 「아윽、…… 응후훗❤ 쭈웁、쿠쭈웁……ッ❤」
					PRINTFORMW 「……후하아、에헤헤♪…… 서로 갈망하는 느낌이 들어서、좋아하게 될지도、이거❤」
				;애널바이브
				IF TEQUIP:애널바이브
					PRINTFORMW 「んああっ❤　お、おしりの바이브、動かすのは……っ❤　はんそく、です……っ❤」
				;애널비즈
				ELSEIF TEQUIP:애널비즈
					PRINTFORMW 「んっ！？　び、ビースを、ひっぱら、ないでぇ……っ❤」
				;관장器＋プラグ
				ELSEIF TEQUIP:관장
					PRINTFORMW 「ぴぃっ❤　せ、栓がぬけちゃい、ますよう……っ❤　いや、です……っ❤　%CALLNAME:MASTER%さんを、よごしたくないぃ……っ❤」
				;확장벌룬
				ELSEIF TEQUIP:확장벌룬
					PRINTFORMW 「ごっ❤　ごぉぉっ❤　お、しりのぉ、あっぱく、感が……っ❤」
				;애널전극
				ELSEIF TEQUIP:애널전극
					PRINTFORML 「き゛い゛いぃぃっ❤　ダメっ❤　電流ダメッ❤　おしりっ❤　バカになっちゃうっ❤」
				ENDIF
			CASE 2
				PRINTFORML 「あああっ❤　そんな、しつこく、舐めないでぇ……っ❤」
				PRINTFORMW 「わたしが……%CALLNAME:MASTER%さんをぉ❤　きもち、よくぅ……っ❤」
				;애널바이브
				IF TEQUIP:애널바이브
					PRINTFORMW 「んああっ❤　お、おしりの바이브、動かさないで……っ❤　まけ、です……っ❤　わたしの、負けぇ……っ❤」
				;애널비즈
				ELSEIF TEQUIP:애널비즈
					PRINTFORMW 「んっ！？　び、ビースを、ひっぱら、ないでぇ……っ❤　まけ、です……っ❤　わたしの、負けぇ……っ❤」
				;관장器＋プラグ
				ELSEIF TEQUIP:관장
					PRINTFORMW 「ぴぃっ❤　せ、栓がぬけちゃい、ますよう……っ❤　いや、です……っ❤　まけ、ましたぁ……っ❤　わたしの、負けぇ……っ❤」
				;확장벌룬
				ELSEIF TEQUIP:확장벌룬
					PRINTFORMW 「ごっ❤　ごぉぉっ❤　お、しりのぉ、あっぱく、感が……っ❤　……まけ、です……っ❤　わたしの、負けぇ……っ❤」
				;애널전극
				ELSEIF TEQUIP:애널전극
					PRINTFORML 「き゛い゛いぃぃっ❤　ダメっ❤　電流ダメッ❤　おしりっ❤　バカになっちゃうっ❤　まけ、です……っ❤　わたしの、負けぇ……っ❤」
				ENDIF
		ENDSELECT
		RETURN 1

	;それ以外
	ELSE
		PRINTFORMW 「응음……、저기、자극이、너무 강해서、제대로 못하겠어── 요！？」
			IF TEQUIP:애널바이브 || TEQUIP:애널비즈
				PRINTFORMW 「やぁ──！？　お、おしりまで、グリグリってしないで……っ！？」
			ELSEIF TEQUIP:관장
				PRINTFORMW 「だ、ダメですっ！？　抜けちゃいますっ！？　おしりの栓、動かさないでぇ……っ！？」
			ELSEIF TEQUIP:확장벌룬
				PRINTFORMW 「お゛っ！？　おし、りぃ……げんかい、です……っ」
			ELSEIF TEQUIP:애널전극
				PRINTFORMW 「があっ！？　お、しりぃ……やめ、てぇ……っ」
			ENDIF
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K2035_{SELECTCOM}_1
RETURN 1

;==================================================
;2,岩清水
;クンニ。男が寝そべり、女が男の顔に跨る
;==================================================
@M_KOJO_MESSAGE_SCOM_K2035_2
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2035_2_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2035_2_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORML 「%CALLNAME:MASTER% 씨의 얼굴에 올라타다니요！？　그런 실례되는 일은 못 해요！」
		PRINTFORMW 「……우으、꼭 해야 한다면 하겠지만。……저기、무겁진 않으세요？」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		SELECTCASE RAND:3
			CASE 0
				IF ABL:TARGET:Ｃ감각 >= 2
					PRINTFORML 「후훗♪ 기분 좋게 해 주시는 게 기뻐서、슥、부비부비 비비게 돼버려요❤」
					PRINTFORMW 「히양！？　어、어랏	！？　아、기분 좋았어！？　용서해줘요……❤」
				ELSE
					PRINTFORML 「응、…… 후훗❤ 거기、좋아요……앙❤」
					PRINTFORMW 「왠지 이거、비도덕적인 기분이 드네요……♪」
				ENDIF
			CASE 1
				PRINTFORML 「……まえ……？　あっ❤　か、かがみに、わたしのすがたが……っ❤　ひゃあっ❤」
				PRINTFORMW 「ご、ごめんなさいっ❤　こうふん、しちゃいましたっ❤　%CALLNAME:MASTER%さんの顔に跨がってる姿にぃ❤　ゾクゾクしちゃいましたぁ❤」
			CASE 2
				PRINTFORMW 「どうして、でしょうか……っ❤　はずかしい、のに……❤　興奮、しちゃうわたしがいますっ……❤」
				PRINTFORMW 「これが、オトナになるってこと、なのでしょうか……っ❤　ああっ❤　%CALLNAME:MASTER%さんの舌があっ❤」
		ENDSELECT
	RETURN 1

	;それ以外
	ELSE
		IF ABL:TARGET:Ｃ감각 >= 2
			PRINTFORML 「응！？　아、아 아 아아아아──！？」
			PRINTFORMW 「안 돼！？　너무 좋아서、눌러버릴 것 같아──！？　이히익♪」
		ELSE
			PRINTFORML 「아 앗、아앗…… 으응 으……응」
			PRINTFORMW 「……우으、허리가 내려가지 않게 힘을 주고 싶은데、너무 의식해서 느껴버려……」
		ENDIF
	RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K2035_{SELECTCOM}_1
RETURN 1

;==================================================
;3,Gスポット刺激
;==================================================
@M_KOJO_MESSAGE_SCOM_K2035_3
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2035_3_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2035_3_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1

;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		;처녀膜ぶち抜き
		IF TCVAR:파과 == 1
			PRINTFORMW 「……わかりました、ひとおもいにやっちゃって、ください」
			PRINTFORMW 「……ふっ！？　がっ、ぎぃ……っ！　……～っ」
			PRINTFORMW 「ふっ、ふっ、ふっ、ふっ……おわり、ましたか……？」
			PRINTFORMW 「ふ、ふっ、すみま、せん……%CALLNAME:MASTER%さんもおちんちんで처녀、つらぬきたかったですよね……？」
			PRINTFORMW 「でも……そのぶん、がんばりますから……わたしのおまんこ、好きにして、ください……」
		;それ以外
		ELSE
			PRINTFORMW 「ぎゅっ！？　ちょ、ゆび、そんな、ふかくぅ……」
			PRINTFORMW 「ア゛ッ！？　な、なにこれっ、ザラザラ、触られてぇ……！？」
		ENDIF
		RETURN 1
	ENDIF

	IF TEQUIP:바이브
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「むり、やりぃ……っ❤　바이브で、拡げられてます……っ❤」
			CASE 1
				PRINTFORMW 「あああっ❤　ソコ、ダメです……っ❤」
			CASE 2
				PRINTFORMW 「바이브、なんかで……イキたく、ないのにぃ……っ❤」
		ENDSELECT
	ELSE
	;基本セット
	;Ｖ경험が120より多い
		IF EXP:Ｖ경험 > 120
			PRINTFORMW 「ゆびちんぽっ❤　%CALLNAME:MASTER%さんのゆびちんぽっ❤　グリグリしてくれるゆびちんぽぉ❤」
		;Ｖ경험が80より多い
		ELSEIF EXP:Ｖ경험 > 80
			PRINTFORMW 「ダメっ❤　呼吸がぁ❤　ひうっ❤　あはぁ❤　ソコっ❤　イイっ❤　アッ❤　ア゛アアッ❤」
		;Ｖ경험が50より多い
		ELSEIF EXP:Ｖ경험 > 50
			PRINTFORMW 「アアッ❤　そこ、いいですっ❤　もっと、イジメてほしい……ですっ❤」
		;Ｖ경험が30より多い
		ELSEIF EXP:Ｖ경험 > 30
			PRINTFORMW 「ぎゅっ！？　ちょ、ゆび、そんな、ふかくぅ……」
			PRINTFORMW 「ア゛ッ❤　な、なにこれっ、ザラザラ、触られてぇ……っ❤」
		;Ｖ경험が0より多い
		ELSEIF EXP:Ｖ경험 > 0
			PRINTFORMW 「この、指の、감각……まだ、なれない、ですね……っ」
		ENDIF
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K2035_{SELECTCOM}_1
RETURN 1

;==================================================
;4,乱れ牡丹
;背面座位。男が女を持ち上げる、女が男に完全に身体を任せる
;==================================================
@M_KOJO_MESSAGE_SCOM_K2035_4
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2035_4_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2035_4_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「か、鏡の前で、ですか……うぅ、恥ずかしい……です……」
		PRINTFORMW 「……えっ！？　ちょ、ちょっとまってくださいっ！？　わたしのカラダ、持ち上がって……！？」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF ABL:노출증 >= 5
	PRINTFORML 「あはっ❤　あははっ❤　わたしって、こぉんなに気持ちいい顔してたんだぁ……❤　当然ですよねっ❤　%CALLNAME:MASTER%さんに挿れてもらってるんですもんっ❤」
	PRINTFORMW 「えへへっ❤　わたしのカラダ、丸見えですねっ❤　見えてますかっ❤　おまんこなんて、だらだらヨダレを垂らして……❤　鏡を前に、ヨガっちゃってますよう……❤」
ELSEIF ABL:노출증 >= 4
	PRINTFORML 「あはっ……❤　誰ですか、これぇ……❤　鏡の前で、大股開きで……❤　されるがままおまんこ挿れられて……❤」
	PRINTFORMW 「見てくださいよ、%CALLNAME:MASTER%さぁん……❤　鏡の娘、ぜぇんぶ見えてるのに……❤　こぉんな気持ちよさそうな顔してますよう……❤　恥知らず、ですねぇ……❤」
ELSEIF ABL:노출증 >= 2
	PRINTFORML 「ああっ❤　や、やめて……っ！？　感じてる、だなんて……いわないでぇ……」
	PRINTFORMW 「삽입いってるトコロが丸見え、だなんて言わないでぇ……っ。や、やだぁ、突いちゃダメぇ……っ❤」
ELSEIF ABL:노출증 >= 1
	PRINTFORML 「や、やめましょうよ……っ！？　こんな、無理な姿勢……！？」
	PRINTFORMW 「きゃあっ！？　あ、足をひらかせないでぇ……っ！　か、鏡を意識させないでぇ……っ！？」
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K2035_{SELECTCOM}_1
RETURN 1

;==================================================
;5,수음펠라
;==================================================
@M_KOJO_MESSAGE_SCOM_K2035_5
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2035_5_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2035_5_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「手と、口で……こう、ですかね……？」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「츄……❤ 흐읍♪ 쭈읍❤ 쭈업❤ 쭙❤」
				PRINTFORMW 「손과 입으로 받아낼 테니까、잔ー 뜩 쏟아내 주세요❤」
				SIF ABL:TARGET:기교 > 3
				PRINTFORMW 「えへへっ❤　たくさん、せーし作ってくださいねっ❤　金玉さんっ❤」
			CASE 1
				PRINTFORML 「쭈웁、쭈우웁……응❤　우훗♪ 타ー악타ー악……❤」
				PRINTFORMW 「……에헤헤、조금은 실력이 늘었나요❤」
				SIF ABL:TARGET:기교 > 3
				PRINTFORMW 「……っと❤　金玉さんもマッサージ、必要ですよねっ❤　えへへ……❤」
			CASE 2
				PRINTFORML 「チロチロ……❤　えへへ、手と、口と……❤　両方でおちんちんに尽くせること、嬉しく思いますっ❤」
				PRINTFORMW 「それで、%CALLNAME:MASTER%さん……❤　どちらにしゃせーしたいですかっ❤　わたしは、どちらでも……❤」
				SIF ABL:TARGET:기교 > 3
				PRINTFORMW 「んっ……❤　ふふっ、金玉さんがグツグツいってるのが伝わってきます……❤　がんばれ、がんばれ……❤」
		ENDSELECT
		RETURN 1

	;それ以外
	ELSE
				IF ABL:TARGET:정액중독 >= 2
					PRINTFORML 「음！　음츄♪　푸하……っ♪ 후후훗❤」
					PRINTFORMW 「잔뜩 손과 입으로 봉사할 수 있어서、기뻐요」
			SIF ABL:TARGET:기교 > 3
			PRINTFORMW 「……っと❤　いっぱい、元気なせーしを作ってくださいねっ❤」
				ELSE
					PRINTFORML 「으읍！　츄、날름…… 후우」
					PRINTFORMW 「저、입은 작지만、손은 꽤 잘하는 편 아닌가요？」
				ENDIF
		RETURN 1
	ENDIF
ENDIF
