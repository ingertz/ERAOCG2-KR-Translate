			ELSE
				PRINTFORMW 「마법함정ゾーンから%カード名%さんを특수소환します……っ」
			ENDIF
		;덱에서 
		CASE 召種덱
			IF GROUPMATCH(カードID,2085,2086,2087,2088,2089,2090,2091,2092,2094,12085)		
				PRINTFORMW 「さぁいきましょう……！　덱에서 頼れる仲間を특수소환します……♪」
			ELSE
				PRINTFORMW 「덱에서 %カード名%さんを특수소환します……っ」
			ENDIF
		;EX덱에서 
		CASE 召種EX덱
			IF GROUPMATCH(カードID,2085,2086,2087,2088,2089,2090,2091,2092,2094,12085)		
				PRINTFORM 「
				SETCOLOR C_FIRE_T
				PRINTFORM 揺れて、魂震わすタクト！　奏でましょう、
				SETCOLOR C_M_GREEN
				PRINTFORM 光のシンフォニー！　펜듈럼소환！
				SETCOLOR C_AQUA
				PRINTFORMW 」
				IF カードID == 2086
					PRINTFORMW 「『ド』はドーナツのド、です……！　%カード名%ちゃん♪」
				ELSEIF カードID == 2087
					PRINTFORMW 「『レ』はレモンのレ、です……！　%カード名%ちゃん♪」
				ELSEIF カードID == 2088
					PRINTFORMW 「『ミ』はみんなのミ、です……！　わ、私、いきます……！」
				ELSEIF カードID == 2089
					PRINTFORMW 「『ファ』はファイトのファ、です……！　%カード名%先輩♪」	
				ELSEIF カードID == 2094
					PRINTFORMW 「共にオーバーチュアを奏でましょう……！　%カード名%ちゃん、いきますよ……♪」			
				ELSEIF カードID == 2090
					PRINTFORMW 「『ソ』は青い空、です……！　%カード名%先輩、今日もお願いします……♪」
				ELSEIF カードID == 2091
					PRINTFORMW 「『ラ』はラッパのラ、ですね……！　%カード名%先輩……♪」
				ELSEIF カードID == 2092
					PRINTFORMW 「『シ』は幸せのメロディ、です……！　%カード名%先輩、託します……♪」
				ELSEIF カードID == 2085
					PRINTFORMW 「『Ｃ』はクールのＣ、ですね……！　我らが主役、%カード名%先輩のご出演です……♪」
				ELSEIF カードID == 12085
					PRINTFORMW 「グランドレミコードより託されし妖精さん……！　%カード名%ちゃん、いきましょう……♪」
			ELSEIF GROUPMATCH(カードID,2093,42085)
				PRINTFORML 「天上より響き渡れ、世界を癒すシンフォニー！」
				PRINTFORMW 「さぁ、おいで下さいませ、%カード名%！！」				
				ELSE
					PRINTFORMW 「EX덱에서 、%カード名%さんを특수소환、します……っ」
				ENDIF
			ENDIF
		;묘지에서 
		CASE 召種묘지
			PRINTFORMW 「묘지より蘇れ、%カード名%さんを특수소환……っ」
		;제외状態から
		CASE 召種제외
			PRINTFORMW 「世界のハザマでも、私達の音が響くなら……っ。%カード名%さん、특수소환っ」
		;主にトークン生成
		CASE 10
			PRINTFORMW 「わっ、トークンが특수소환されました！？」
	ENDSELECT
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K2088_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORMW 「ぎ、의식소환……、%カード名%さん、おいで下さいませ……っ」
		CASE 융합
			PRINTFORMW 「ゆ、융합소환……っ、%カード名%さん、出番です……っ」
		CASE 싱크로
			PRINTFORMW 「チューニングなら、得意分野です……っ。%カード名%さん、싱크로소환ですっ」
		CASE 엑시즈
			PRINTFORMW 「重ねて、奏でる……。엑시즈소환、%カード名%さん、お願い……っ」
		CASE 링크
			IF カードID == 2093
				PRINTFORMW 「かくも麗しき女神様、私たちの交響楽団に素晴らしき伴奏をお添えください……。링크소환！　%カード名%、光臨！」
			ELSEIF カードID == 42085
				PRINTFORMW 「링크소환！　先輩……、素晴らしい装いです……！　%カード名%先輩、お願いしますっ！」
			ELSEIF カードID == 1131
				PRINTFORMW 「今日もお出でいただき、ありがとうございます……　링크소환、%カード名%！」
			ELSE
			PRINTFORMW 「音と音とを링크して、紡ぎ出すは新たなハーモニー！　링크소환！　%カード名%さん、共にいきましょう……！」
			ENDIF
		;초차원モンスター（デュエマ）
		CASE 초차원
			PRINTFORMW 「わ、私なんかの声に応えてくれた、あなたを信じます……！　초차원より、%カード名%さんを呼び出します……っ」
	ENDSELECT
ENDIF

