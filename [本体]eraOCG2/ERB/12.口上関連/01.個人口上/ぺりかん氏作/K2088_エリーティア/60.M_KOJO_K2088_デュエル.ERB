;==================================================
;0,デュエルスタート！
;==================================================
@M_KOJO_DUEL_K2088_0(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「は、はい。デュエルを、始めましょう……！」
		CASE 2
			PRINTFORMW 「こ、交響楽団『ドレミコード』、開演いたします……！」
		CASE 3
			PRINTFORMW 「大丈夫、私だってできる……デュエル、いきます……！」
	ENDSELECT
ENDIF

;==================================================
;1,モンスター소환
;例：%カード名%を소환！
;==================================================
@M_KOJO_DUEL_K2088_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF カードID == 2086
		PRINTFORMW 「いきましょう、%カード名%ちゃん」
	ELSEIF カードID == 2087
		PRINTFORMW 「%カード名%ちゃん、出番です」
	ELSEIF カードID == 2088
		PRINTFORMW 「こ、ここで！　私、%カード名%の登場です。……うぅ、恥ずかしい」
	ELSEIF カードID == 2089
		PRINTFORMW 「今日もよろしくお願いしますね？　%カード名%先輩」	
	ELSEIF カードID == 2094
		PRINTFORMW 「開演の挨拶、お願いしますね？　%カード名%ちゃん、出番です」			
	ELSE
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「%カード名%さん、お願いします」
		CASE 2
			PRINTFORMW 「소환します、%カード名%さん……！」
		CASE 3
			PRINTFORMW 「任せます、%カード名%さんを소환……！」
	ENDSELECT
	ENDIF
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_KOJO_DUEL_K2088_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 소환出処
		;패에서 
		CASE 召種손패
			IF GROUPMATCH(カードID,2085,2086,2087,2088,2089,2090,2091,2092,2094,12085)		
