;==================================================
;44,바이브
;==================================================
@M_KOJO_MESSAGE_COM_K2088_44
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2088_44_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2088_44_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TCVAR:파과 == 1
			PRINTFORMW 「な、なんでしょうコレ……？　ば、바이브……？　そ、それで、そんなモノを私のオマンコにあてがって、なにを……──ッ！？」
			PRINTFORMW 「づぁぁ……っ！？　い゛っ！　いた゛いぃぃ……。な、なにを……突然、ヒドいですよぉ、%CALLNAME:MASTER%さ──ひぅ！？」
			PRINTFORMW 「あ゛っ！？　わ、私のナカぁぁ……っ！？　う、動いてぇ……っ！　%CALLNAME:MASTER%さまぁ！　と、とめてぇ、とめて、くださいぃぃ！？」
			RETURN 1
		ELSE
			PRINTFORMW 「あ、あれ？　おチンポさん、挿れないんですか……？　今回はかわりにコレを挿れる？　は、はぁ……」
			PRINTFORMW 「ぐぅ……っ！　……は、삽입りました、か……？　え、えへへ……頑張りました、褒めてください……♪」
			PRINTFORMW 「で、ですが……コレで、終わりで──ひぅん！？　な、なに……？　急にぃ、ナカでぇ、動いてぇぇ……❤」
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;装着
	IF TEQUIP:바이브
		IF TALENT:TARGET:연모 >= 1 || ABL:TARGET:Ｖ감각 > 2
			PRINTFORML 「%CSTR:TARGET:MASCALL%のおチンポさんのほうがいいのに……❤」
			PRINTFORMW 「……そんな顔、しないでください。……終わったらご褒美、くださいね……❤」
		ELSE
		PRINTFORMW 「ま、また……！？　や、イヤです！　いや、ですぅぅ……っ」
		ENDIF
	;解除
	ELSE
		IF TALENT:TARGET:연모 >= 1 || ABL:TARGET:Ｖ감각 > 2
			PRINTFORML 「えへへぇ❤　やっと、解放してもらえたぁ……❤」
			PRINTFORMW 「……ねぇ、%CSTR:TARGET:MASCALL%ぁ❤　次は、おチンポさん、ほしいなぁ……❤」
		ELSE
		PRINTFORMW 「はぁ……、はぁ……、やっと、解放、されました……」
		ENDIF
	ENDIF
ENDIF
RETURN 1

