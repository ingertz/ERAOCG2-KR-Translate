;40,로터
;クリトリスに当てる
;==================================================
@M_KOJO_MESSAGE_COM_K2088_40
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2088_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2088_40_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「これ、何かの道具ですか？　わっ！？　きゅ、急に震えてビックリしました……」
		PRINTFORMW 「それで、これは何に使われるのでしょう？　あ、教えてくださるんですね、ありがと……？　%CSTR:TARGET:MASCALL%？　悪い顔、してますよ……？」
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 0
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 0
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「ひゃああっ！？　く、クリに当たってぇ……！」
		CASE 2
			PRINTFORMW 「%CSTR:TARGET:MASCALL%ぁっ！　や、やめてっ、ください……ぃ」
		CASE 3
			PRINTFORM 「し、振動がっ、クリ、トリスにぃ……っ、し、しびれ、そうな……っ
		IF TALENT:TARGET:연모 >= 1
		PRINT ❤
		ENDIF
		PRINTW 」
	ENDSELECT
ENDIF
RETURN 1

