;311,抱き付く
;ABL:친밀(3以下=恥ずかしそう 4以上=満更でもない 8以上=抱き返してくる)
;CFLAG:우후후==2&&TCVAR:TARGET:CT행동(31=後ろから抱きつく 32=前から抱きつく 50=수음 52=스마타 59=乳首吸われる 60=딥키스 61=逆レイプ
;TFLAG:400(1=데이트先or地底のモブが反応する)
;==================================================
@M_KOJO_SUCCESS_COM_K2088_311
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K2088_311
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2088_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2088_311_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL

	;初めて抱きつき
	IF FIRSTTIME(SELECTCOM)
		PRINTFORML 「え！？　あ、あの……？　は、ハグ……ですか？　きゃあっ、そんな強く、しないでください……」
		PRINTFORMW 「……あ、상대への好意を示すために強く抱きつく……？　な、なるほど？　勉強に、なります……！」
		RETURN 1
	ENDIF
	IF CFLAG:우후후 == 2
		SELECTCASE TCVAR:TARGET:전CT행동
			CASE 32
				PRINTFORML 「わ、私……！　こ、言葉で伝えるのは苦手ですけど、%CSTR:TARGET:MASCALL%へは常に感謝の気持ちでいっぱいです……！」
				PRINTFORMW 「で、ですから……っ、行動で、示します……！　ぎゅ、ぎゅ～、ですよ……❤」
			CASE 50
				PRINTFORMW 「あっ❤　おチンポさんが当たってますよぉ❤　ヤダァ❤　수음ご奉仕に集中したいのにぃ……❤」
			CASE 60
				SIF EXP:TARGET:Ｍ경험 == 1 && CFLAG:TARGET:키스상실상대 == MASTER
					PRINTFORMW 「えへへ♪　私ハジメテなんです……❤　忘れられない키스に、したいなぁ……❤」
					PRINTFORMW 「ちゅぅ……♪　んじゅるっ❤　ちゅっ❤　んぢゅっ❤　……！？　んんんっ❤　……あはっ♪　密着、してますねぇ……❤」
					PRINTFORMW 「じゅるっ♪　んぢゅっ❤　ぢゅる❤　ぐちゅっ❤　ぢゅぽ❤　んぢゅぷっ❤　やぁんもっとぉ……❤」
			CASE 61
				IF EXP:TARGET:Ｖ성교경험 == 1 && CFLAG:TARGET:처녀버린상대 == MASTER
					PRINTFORM 「いづっ
					CALL XON_FONT("❤！",C_AQUA)
					PRINTFORM 　……えへへ♪　痛いです……
					CALL XON_FONT("❤❤",C_AQUA)
					PRINTFORMW 　でも、この痛みが처녀を捧げられたって……ひゃっ！？
					PRINTFORM 　あ……❤　えへへ、抱きしめてくれるんですかぁ……
					CALL XON_FONT(" ❤？",C_AQUA)
					PRINTFORM 　やっぱり、優しいです……
					CALL XON_FONT("群❤",C_AQUA)
					PRINTFORMW 」
				ELSE
					PRINTFORML 「ひゃあん❤　きゅ、急に抱きつかないでぇ……❤　い、今私が%CSTR:TARGET:MASCALL%をレイプしてるんですっ❤」
					PRINTFORMW 「だっ、ダメですってぇ……❤　ギュッてされたらぁ❤　ご、合法……❤　合意ありラブラブ섹스にぃ❤　なっちゃいますよぉ……❤」
				ENDIF
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「えへへ♪　%CSTR:TARGET:MASCALL%の体温、あったかぁい……❤」
					CASE 1
						PRINTFORMW 「私をギュッと……壊して、ほしいな……
						CALL XON_FONT("？❤",C_AQUA)
						PRINTFORMW 」
					CASE 2
						PRINTFORMW 「スンスン……♪　%CSTR:TARGET:MASCALL%のニオイが、いぃっぱい……❤」
				ENDSELECT
		ENDSELECT
	ELSE
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「……え、ええと、こ、これぐらい……？　い、痛くないですか……%CSTR:TARGET:MASCALL%……？」
			SIF TALENT:TARGET:연모 >= 1
				PRINTFORMW 「だ、抱きしめるだけでは%CSTR:TARGET:MASCALL%への好きは示せません……！　だ、だから……！　すきに、してください……」
		CASE 2
			PRINTFORMW 「……あったかい、ですね、%CSTR:TARGET:MASCALL%は……落ち着きます……♪」
		CASE 3
			PRINTFORMW 「きゃあ……！　え、ええっと、こんなに強く抱きしめてくれるぐらい、私が、好き、なんですか……？」
			SIF TALENT:TARGET:연모 >= 1
				PRINTFORMW 「わ、私も、です……っ♪　力がなくて、上手く伝わらないかもですけど、……大事な人だと、そう想ってます……♪」
		;연모
		CASE 4
			PRINTFORML 「えへへ……♪　聞こえてきます、%CSTR:TARGET:MASCALL%の心臓の鼓動……❤」
			PRINTFORMW 「知ってますか？　赤ちゃんはお母さんの胎内で、心臓の音を聞きながら寝ているそうですよ？　だから人は、心音でおちつく、らしいです……❤」
		;親愛
		CASE 5
			PRINTFORM 「ねぇ、%CSTR:TARGET:MASCALL%♪　抱きしめるだけで、いいんですか
			CALL XON_FONT("？❤",C_AQUA)
			PRINTFORML 」
			PRINTFORMW 「……私はワガママですから、もっともぉっと❤　ヒドいことされたい、です……❤」
	ENDSELECT
	ENDIF
ENDIF
RETURN 1
;==================================================
;312,키스する
;ABL:친밀(4以下=突然のことに驚く 5以上=頬を赤く染める)
;ABL:욕망(4以下=突然のことに驚く 5以上=こじ開けて혀を絡める)
;CFLAG:우후후==2&&TCVAR:TARGET:CT행동(31=後ろから抱きつく 32=前から抱きつく 33=가슴を揉ませる 50=수음 60=딥키스 61=逆レイプ
;PREVCOM(305=膝枕
;TFLAG:400(1=데이트先or地底のモブが反応する)
;==================================================
@M_KOJO_SUCCESS_COM_K2088_312
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K2088_312
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2088_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2088_312_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;ファースト키스
		IF EXP:TARGET:Ｍ경험 == 1 && EXP:TARGET:펠라경험 == 0 && CFLAG:TARGET:키스상실상대 == MASTER
			PRINTFORML 「……流石にしってますよ？　ファースト키스は大事にとっておくもの、です……！」
			PRINTFORMW 「……え？　その価値観はもう古い……？　最近のトレンドは強引に奪われるコト……！？　へ、へー……、じ、時代は進んでいくんですね……」
			PRINTFORMW 「んんっ！？　……ぷは、はぁ、はぁ……、た、たしかに、悪く、ないのかも……？」
		;それ以外
		ELSE
			IF TALENT:TARGET:연모 >= 1
				PRINTFORML 「ビューティア先輩が言ってました……❤　唇への키스は『深い愛情』だって……❤」
				PRINTFORMW 「%CSTR:TARGET:MASCALL%はどうですか……？　私からの키스は、すべて、そうですよ……❤」
			ELSE
				IF EXP:TARGET:Ｍ경험 != 0
					PRINTFORMW 「その、流石に키스はやりすぎでは……？　え？　もっといやらしいこともしてる？　そ、そうかも知れませんが……んむっ！？」
					PRINTFORMDW グチグチうるさい%CALLNAME:TARGET%の唇を強引に塞いだ……。%CALLNAME:TARGET%は저항することもなくただただ키스に夢中のようだ……
				ELSE
					PRINTFORMW 「ふふ、こんな雰囲気で키스をするのは初めてですかね？　いつでもどうぞ……♪」
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	ENDIF

		IF CFLAG:우후후 == 2
		SELECTCASE TCVAR:TARGET:전CT행동
			CASE 33
				PRINTFORML 「んっ❤　うれしい……❤　%CSTR:TARGET:MASCALL%が私に夢中です……❤　おっぱい揉んでくれて❤　키스もしてくれてぇ……❤」
				PRINTFORMW 「えへへ♪　いっぱい揉んでくださいねっ❤　私、%CSTR:TARGET:MASCALL%にメチャクチャにされたいですぅ……❤　んっ、ちゅっ❤」
			CASE 50
				PRINTFORMW 「あっ❤　ちゅっ♪　……えへへ、수음を頑張る私への、ご褒美ですかね……❤」
			CASE 60
				SIF EXP:TARGET:Ｍ경험 == 1 && EXP:TARGET:펠라경험 == 0 && CFLAG:TARGET:키스상실상대 == MASTER
					PRINTFORMW 「襲ってくれないんですもん……私からファースト키스、捧げちゃいます……！　んんっ！？」
					PRINTFORMW 「ちゅ……っ、ちゅっ、ちゅぅ……♪　んじゅるっ❤　ちゅっ❤　んぢゅっ❤　……！？　んんんっ❤　……あはっ♪　%CSTR:TARGET:MASCALL%から来てくれた……❤」
					PRINTFORM 「『唇へ深い愛情』の키스……❤　%CSTR:TARGET:MASCALL%の愛情、感じます❤　はじゅるっ♪　んぢゅっ❤　ぢゅる❤　ぐちゅっ❤　ぢゅぽ❤　んぢゅぷっ
					CALL XON_FONT("塵❤1,塵❤2",C_AQUA)
					PRINTFORMW 」
			CASE 61
				IF EXP:TARGET:Ｖ성교경험 == 1 && CFLAG:TARGET:처녀버린상대 == MASTER
					PRINTFORM 「いづっ
					CALL XON_FONT("❤！",C_AQUA)
					PRINTFORM 　……えへへ♪　痛いです……
					CALL XON_FONT("❤❤",C_AQUA)
					PRINTFORMW 　でも、この痛みが처녀を捧げられたって……ひゃっ！？
					PRINTFORM 　あ……❤　えへへ、ちゅぅ……ちゅっ♪
					PRINTFORM 　키스、しちゃいましたね……❤　これじゃあレイプ、失敗、ですね
					CALL XON_FONT("塵❤1,塵❤2",C_AQUA)
					PRINTFORMW 」
				ELSE
					PRINTFORM 「あっ❤　深いぃ❤　%CSTR:TARGET:MASCALL%のおチンポさんがぁ❤　気持ちいいぃ……❤　えへへ、レイプ、しちゃいましたぁ……
					CALL XON_FONT("塵❤1,塵❤2",C_AQUA)
					PRINTFORML 」
					PRINTFORM 「んっ
					CALL XON_FONT("❤！",C_AQUA)
					PRINTFORM 　もう……❤　ちゅーしちゃったらぁ❤　ラブラブ和姦じゃないですかぁ❤　あはっ❤　ラブラブ섹스、しましょーか……
					CALL XON_FONT("塵❤1,塵❤2",C_AQUA)
					PRINTFORMW 」
				ENDIF
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「ちゅっ♪　……ダメですね……키스されると、そっちばっかり欲しくなります……❤」
					CASE 1
						PRINTFORMW 「んちゅっ❤　……えへへ、やっと%CSTR:TARGET:MASCALL%から来てくれた……❤」
					CASE 2
						PRINTFORML 「だ、ダメですよぉ❤　今は私がっ❤　責めるのっ❤」
						PRINTFORMW 「ちゅっ❤　んぢゅっ❤　ダメですぅ❤　키스、するだけでぇ❤　フニャフニャになっちゃうぅ……❤」
				ENDSELECT
		ENDSELECT
	ELSE

	;基本セット
	호감도修正 = 5
	SIF TALENT:TARGET:애처
