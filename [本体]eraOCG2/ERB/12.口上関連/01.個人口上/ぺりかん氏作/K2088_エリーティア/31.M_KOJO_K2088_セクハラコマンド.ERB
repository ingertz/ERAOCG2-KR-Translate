;==================================================
;310,尻を撫でる
;ABL:친밀(2以下=不快(TALENT:臆病なら涙目) 3以上=恥ずかしがる(TALENT:남성혐오兼MASTERが男なら、身をすくめる) 6以上=されるがまま)
;CFLAG:우후후==2&&TCVAR:TARGET:CT행동(31=後ろから抱きつく 32=前から抱きつく 50=수음 51=펠라 52=스마타 53=파이즈리 59=乳首吸われる
;60=딥키스 61=逆レイプ 70=クンニ強制 72=애널奉仕強制
;CFLAG:우후후==2&&TEQUIP:식스나인(パンツありTCVAR:TARGET:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=데이트先or地底のモブが反応する)
;==================================================
@M_KOJO_SUCCESS_COM_K2088_310
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K2088_310
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2088_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2088_310_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL

	;初めて尻撫で
	IF FIRSTTIME(SELECTCOM)
		PRINTFORML 「ひゃん！？　お、おし、お尻、撫でました！？」
		PRINTFORMW 「……え？　仲のいい男女なら挨拶대신에 するもの、なんですか？　そ、そうなんですね……」
		RETURN 1
	ENDIF
		IF CFLAG:우후후 == 2
		SELECTCASE TCVAR:TARGET:전CT행동
			CASE 31
				PRINTFORMW 「やん♪　えへへ、%CSTR:TARGET:MASCALL%に카운터、食らっちゃいました……❤」
			CASE 32
				PRINTFORMW 「えへへ♪　私も、お尻撫でちゃいますっ❤」
			CASE 50
				PRINTFORMW 「もうっ♪　えらいえらいって褒めるならお尻じゃなくて頭ですよぉ❤」
			CASE 51
				PRINTFORMW 「んじゅっ❤　もうっ❤　そんな撫で回されたら、펠라치오に集中できません❤」
			CASE 52
				PRINTFORM 「ひゃんっ
			CALL XON_FONT("❤！",C_AQUA)	
				PRINTFORM 　스마타じゃご不満ですかぁ
				CALL XON_FONT("？❤",C_AQUA)
				PRINTFORMW 　お尻がっちりホールドして♪　挿れる体勢じゃないですかぁ❤」
			CASE 53
				PRINTFORMW 「もう❤　파이즈리じゃ飽き足らず、お尻も要求ですかぁ❤　ワガママさんですね……♪」
			CASE 59
				PRINTFORMW 「ひぃん❤　ち、乳首イジったからって、仕返しはダメですっ❤」
			CASE 60
				IF EXP:TARGET:Ｍ경험 == 1 && CFLAG:TARGET:키스상실상대 == MASTER
					PRINTFORML 「んんっ……♪　ハジメテの키스がお尻揉まれながらなんて、私ぐらいでしょうね……❤」
					PRINTFORMW 「じゅるっ♪　んぢゅっ❤　ぢゅる❤　ぐちゅっ❤　ぢゅぽ❤　んぢゅぷっ❤　やぁんもっとぉ……❤」
				ELSE
					PRINTFORMW 「ちゅっ♪　んちゅっ♪　……키스の時ぐらい撫で回さないでくださいよ……❤　こうなったら止めてくれるまで키스、しちゃいます……❤」
					PRINTFORMW 「じゅるっ♪　んぢゅっ❤　ぢゅる❤　ぐちゅっ❤　ぢゅぽ❤　んぢゅぷっ❤　えへへ、息が詰まりそう、です……❤」
				ENDIF
			CASE 61
				IF EXP:TARGET:Ｖ성교경험 == 1 && CFLAG:TARGET:처녀버린상대 == MASTER
					PRINTFORMW 「えへへぇ……❤　자신で처녀捧げられてえらいってお尻撫でてくれてるんですかぁ……❤　やっぱり%CSTR:TARGET:MASCALL%、優しいです……❤」
				ELSE
					PRINTFORML 「見えますかぁ❤　私のオマンコ、%CSTR:TARGET:MASCALL%のおチンポさんを呑み込んでますよぉ❤」
					PRINTFORMW 「あっ❤　やめてくださぁい❤　お、お尻撫でられたら❤　嬉しくてぇ❤　腰、ぬけちゃいます……❤」
				ENDIF
			CASE 72
				PRINTFORMW 「ひぃ❤　お、お尻をガッチリぃ❤　あ、애널に逃げるなって❤　命令されちゃってるぅ❤」
			CASEELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「만족ですかぁ❤　私は만족ですぅ❤」
					CASE 1
						PRINTFORMW 「えへへ♪　好きなだけ揉んでくださいね❤」
					CASE 2
						PRINTFORMW 「あぁん❤　私が、責めてるのにぃ❤」
				ENDSELECT
		ENDSELECT

	ELSE
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「んんっ……、へ、変な気持ちになります……」
			SIF MARK:TARGET:굴복각인 >= 1
			PRINTFORMW 「つ、続きは寝室で、お願い、します……❤」
		CASE 2
			PRINTFORMW 「は、恥ずかしい……。で、でも撫でられるのが、挨拶みたいなものなんですよね？　が、ガマン、します」
			SIF ABL:TARGET:노출증 >= 2
			PRINTFORMW 「……も、もちろん挨拶だけでは終わらないですよね、%CSTR:TARGET:MASCALL%ぁ……❤」
		CASE 3
			PRINTFORMW 「ひゃぁん！？　きゅ、急に撫でられると、ビックリします……」
			SIF TALENT:TARGET:연모 >= 1
			PRINTFORMW 「も、もう一回……！　心の準備ができたので、次はへんな声、だしませんから……っ❤」
		;연모
		CASE 4
			PRINTFORM 「そ、そういえば私からはお尻、撫で返さなくていいんでしょうか……きゃんっ！
			CALL XON_FONT("？❤",C_AQUA)
			PRINTFORMW 」
			PRINTFORMW 「わ、わかりましたぁ！　だ、黙って撫でられてますから、揉みしだかないでくださいぃ……ひぃん❤」
		;親愛
		CASE 5
				IF TIME >= KANTAN_TIME(05,00) && TIME <= KANTAN_TIME(10,00)
					PRINTFORML 「えへへ♪　挨拶は大事、ですよねっ♪　どうぞっ、私のお尻、好きなだけ撫でてくださぁい……❤」
					PRINTFORMW 「やぁん❤　もう……❤　朝からがっつきすぎですよぉ❤　……もう一回、寝室に行きましょうかぁ」
				ELSEIF TIME >= KANTAN_TIME(10,00) && TIME <= KANTAN_TIME(16,00)
					PRINTFORMW 「んうっ❤　もう❤　まだお外も明るいですよぉ❤　私のお尻、そんなに撫でたいんですかぁ……❤」
				ELSE
					PRINTFORML 「……きゃあっ❤　んふふ♪　もう暗くなりましたねぇ……？」
					PRINTFORMW 「……もう待ち切れない、ですぅ❤」
				ENDIF
	ENDSELECT	
	ENDIF
ENDIF
RETURN 1
