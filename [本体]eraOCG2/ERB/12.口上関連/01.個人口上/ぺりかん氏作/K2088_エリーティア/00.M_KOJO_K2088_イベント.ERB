;==================================================
;帰宅時/外出時
;==================================================
@M_KOJO_EVENT_K2088_11(ARG,ARG:1)
;구상主はLOCALS or RESULT
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;MASTER通常帰宅
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORMW 「あ……。お、おかえりなさいませっ」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTER仕事・学校終わり帰宅
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:TARGET:연모 > 0
			PRINTFORML 「お疲れ様です。お風呂、沸かしてきましょうか」
			PRINTFORMW 「私にできることならなんでも言ってください。%CSTR:TARGET:MASCALL%のためならなんでもしますっ」
		ELSE
			PRINTFORMW 「おかえりなさい、あの……お疲れですか……？」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;一緒に데이트중帰宅
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:TARGET:연모 > 0
			PRINTFORMW 「ふふっ、ただいま、ですね……♪」
		ELSE
			PRINTFORMW 「た、ただいま、ですっ」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;캐릭터が外出から帰宅する
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「すみません%CALLNAME:TARGET%、今帰りました……っ」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;캐릭터がバイトから帰宅する
	;（来訪캐릭터のみ,自宅が無い캐릭터でも発生します）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;家に訪問してくる
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	;訪問してくる
	IF LOCAL:1 && ARG == 5 && ARG:1 == 0
		PRINTFORML 「あ、あの……っ、すみません。訪ねてきちゃいました」
		PRINTFORMW 「……迷惑、でしたかね……？」
		RETURN 1
	;「はい」を選択
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 1
		PRINTFORMW 「……ふふっ♪　%CSTR:TARGET:MASCALL%は優しいですね……すみませんが、甘えちゃいます」
		RETURN 1
	;「いいえ」を選択
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 2
		PRINTFORMW 「ご、ごめんなさい……やっぱりアポなしはまずかったですね……」
		RETURN 1
	;手が離せない状態で、帰ってくれる
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 3
		PRINTFORML 「……お忙しいのかな？　また今度にしましょう……」
		PRINTFORMW 「あ、そうだ。一応来たことだけでもわかるようにメモを投函しときましょうか……」
		RETURN 1
	;手が離せない状態で、入ってきた
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 4
		PRINTFORML 「……返事がないですね……？　で、でも何か聞こえるような……？」
		PRINTFORMW 「ちょ、ちょぉっと勇気、だしてみようかな……？　……%CSTR:TARGET:MASCALL%、失礼しまぁす……」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠いのでカード/家へ帰る
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6 && ARG:1 == 0
		RETURN 1
	ELSEIF LOCAL:1 && ARG == 6 && ARG:1 == 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;一人で外出をする
	;（来訪캐릭터の帰宅時に欲求不満と욕망が高いと発生）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	;通常外出
	IF LOCAL:1 && ARG == 7 && ARG:1 == 0
		RETURN 1
	;バイト外出
	ELSEIF LOCAL:1 && ARG == 7 && ARG:1 == 1
		RETURN 1
	ENDIF
ENDIF
RETURN 1

