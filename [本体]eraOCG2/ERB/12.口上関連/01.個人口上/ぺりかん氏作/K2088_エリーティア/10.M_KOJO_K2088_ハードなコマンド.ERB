;111,踏む
;TFLAG:193（1=身体,2=절정가슴,3=절정クリトリス,4=정액腹,5=土下座頭）
;==================================================
@M_KOJO_MESSAGE_COM_K2088_111
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2088_111_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2088_111_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「え！？　ど、どうして踏むなんてことを……！？　り、理由を教えて下さい……っ」
		PRINTFORMW 「じ、자신의 가슴に手を当てて考えてみろ、って……わ、私がなにか、したんでしょうか……？　ひっ、わ、私が、わるい、んですね……？　ど、どうぞ……っ」
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 0
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 0
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「……ど、どうして……ですかぁ……」
			SIF TALENT:TARGET:연모 >= 1 || ABL:TARGET:마조끼 > 2 || TALENT:TARGET:음란 || TALENT:TARGET:굴복됨
			PRINTFORMW 「わ、私、なんでもしますから……❤　%CSTR:TARGET:MASCALL%に許してもらえるまで……❤　なぁんでも、しますからぁ……❤」
		CASE 2
			PRINTFORMW 「ぐっ！？　……ご、ごめんなさい……ゆ、ゆるして、ください……っ」
			SIF TALENT:TARGET:연모 >= 1 || ABL:TARGET:마조끼 > 2 || TALENT:TARGET:음란 || TALENT:TARGET:굴복됨
			PRINTFORMW 「ぜ、ぜぇんぶ、私が悪いん、です……❤　私がぁ……❤　%CSTR:TARGET:MASCALL%をぉ……❤　만족、させられないからぁ……❤」
		CASE 3
			PRINTFORMDW %CALLNAME:TARGET%はどれだけ強く踏まれても、まるで嵐が過ぎ去るのを待つようにただじっと耐えている
			SIF TALENT:TARGET:연모 >= 1 || ABL:TARGET:마조끼 > 2 || TALENT:TARGET:음란 || TALENT:TARGET:굴복됨
			PRINTFORMDW ……だが、よく見るときっちりと揃えられた両脚、その間にポタポタとシミができている。どうやらこの異常な상황を愉しんでいるようだ。……お仕置きが必要だろうか
	ENDSELECT
ENDIF
RETURN 1

