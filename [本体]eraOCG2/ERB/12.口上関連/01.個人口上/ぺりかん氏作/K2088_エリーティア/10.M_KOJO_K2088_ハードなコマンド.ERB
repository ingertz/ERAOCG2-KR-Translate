;==================================================
;140,イラマチオ
;==================================================
@M_KOJO_MESSAGE_COM_K2088_140
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2088_140_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2088_140_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF EXP:TARGET:펠라경험 == 0
		PRINTFORML 「きゃ……！？　きゅ、急に男性器を노출しないでください……！　……あ、いえ、おチンポさん、でしたね……すみません」
		PRINTFORMW 「それでこの、おチンポさんをどうすれば……？　口で、ですか……これも男女にとって当たり前の行為、なのですね。わかりました……では……ん゛んっ！？」
		PRINTFORMDL 呑気に口を空けてきた%CALLNAME:TARGET%の喉元めがけ、おもいっきり剛直を突っ込んだ……。苦しそうに涙を浮かべる%CALLNAME:TARGET%だったが、
		PRINTFORMD 後で、『これもまた、女性が男性へ示す信頼の証なんだよ』と教えると
		CALL XON_FONT("「そう、なのですね……では少しでも慣れるよう、努力します……」",C_AQUA)
		PRINTFORMDW と、いじらしい答えが返ってきた……
		ELSE
		PRINTFORMW 「あ、はい。それでは펠라치오でおチンポさんをご奉仕しますね……がっ！？」
		PRINTFORMW 「ん゛ん……っ！？　ごぉ……っ！？　がぁ……っ！？　%CALLNAME:MASTER%、さ、まぁ……っ！？　や゛めっ、やめ゛て゛……っ！」
		PRINTFORMDL 呑気に口を空けてきた%CALLNAME:TARGET%の喉元めがけ、おもいっきり剛直を突っ込んだ……。苦しそうに涙を浮かべる%CALLNAME:TARGET%だったが、
		PRINTFORMD 後で、『今の%CALLNAME:TARGET%になら一段上の펠라がいけると思った』と言い訳すると
		CALL XON_FONT("「信頼、してくれてるんですね……応えられるよう、頑張ります……」",C_AQUA)
		PRINTFORMDW と、いじらしい答えが返ってきた……
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			IF ABL:TARGET:봉사정신 >= 3 || ABL:TARGET:마조끼 >= 3
				PRINTFORM 「ぐぽっ❤　ごぽっ❤　ごぉ……っ❤　んじゅっ
				CALL XON_FONT("！❤",C_AQUA)
				PRINTFORMW 」
				PRINTFORM （あぁ、嬉しい……❤　私、喉さえも%CSTR:TARGET:MASCALL%に捧げられてます……
				CALL XON_FONT("❤❤",C_AQUA)
				PRINTFORMW ）
			ELSE
				PRINTFORML 「ごほっ、ごほっ……！　く、うぅ……まだ、慣れません、ね……」
				PRINTFORMW 「だい、じょうぶです、%CSTR:TARGET:MASCALL%……私、%CSTR:TARGET:MASCALL%の信頼に応えてみせます……！」
			ENDIF
		CASE 2
			IF ABL:TARGET:봉사정신 >= 3 || ABL:TARGET:마조끼 >= 3
				PRINTFORMW 「ぐっ、ごほっ、がほっ……！　……え、涙、ですか……。いえ、たしかに苦しくは、あるのですが……」
				PRINTFORM 「それ以上に、嬉しいんです……❤　私が喉奥を突かれえずくたび、おチンポさんが、%CSTR:TARGET:MASCALL%が悦んでくれるのが……
				CALL XON_FONT("❤❤",C_AQUA)
				PRINTFORM 　嬉しくて嬉しくて、つい涙がポロポロ、流れちゃったんです……
				CALL XON_FONT("❤❤❤",C_AQUA)
				PRINTFORMW 」
			ELSE
				PRINTFORML 「ぐっ……！？　お、ぇぇぇ……っ。……すみません、お見苦しいところをお見せしました……」
				PRINTFORMW 「だ、大丈夫、です……。ちょっと、胃液が、逆流しただけ、ですので……」
			ENDIF
		CASE 3
			IF ABL:TARGET:봉사정신 >= 3 || ABL:TARGET:마조끼 >= 3
				PRINTFORM 「どうぞ……❤　%CALLNAME:TARGET%のお口オナホを存分に使ってくださいね、%CSTR:TARGET:MASCALL%……
				CALL XON_FONT("❤❤",C_AQUA)
				PRINTFORMW 」
				PRINTFORM （苦しい……❤　カッコいいです、%CSTR:TARGET:MASCALL%……
				CALL XON_FONT("❤❤",C_AQUA)
				PRINTFORMW 　私の都合も考えない一方的な腰振り……
				CALL XON_FONT("❤❤",C_AQUA)
				PRINTFORM 　%CALLNAME:TARGET%は幸せです……
				CALL XON_FONT("❤❤❤",C_AQUA)
				PRINTFORMW ）
			ELSE
				PRINTFORML 「ごめんなさい……やっぱりまだ私にはレベルが高かったようです……ここは普通の펠라奉仕で……こ゛ぉ゛っ！？」
				PRINTFORMDW グチグチと言い訳を重ねる%CALLNAME:TARGET%へのお仕置きとして、いつもより激しく『使って』やった……。衝撃に、%CALLNAME:TARGET%は鼻水を垂れ流していることにすら気づいていない
			ENDIF
		CASE 4
			PRINTFORML 「……苦しいなら普通の펠라でもいい……？　や、イヤです！？　わ、私だってやれる、はずなんです……っ」
			PRINTFORMW 「ど、どうぞ……！　口を空けたままにしておきます、%CSTR:TARGET:MASCALL%の自由にしてください……！　……んごっ！？　き、きたぁ……❤」
		CASE 5
			PRINTFORML 「んごっ……❤　んぐっ……❤　も、もっとです❤　もっと、突いてぇ……❤」
			PRINTFORMW 「%CSTR:TARGET:MASCALL%に求められたい……❤　%CSTR:TARGET:MASCALL%の期待に応えたい……❤　そのためなら、私はぁ……❤」
		CASE 6
			PRINTFORM 「……%CSTR:TARGET:MASCALL%？　どっちがお好みですか？　……はい❤　イラマチオ、ですね……❤　では、お好きに……あぁぁ……ん
			CALL XON_FONT("❤❤",C_AQUA)
			PRINTFORML 」
			PRINTFORM 「んほっ……
			CALL XON_FONT("！❤",C_AQUA)
			PRINTFORM 　んふっ……
			CALL XON_FONT("❤！",C_AQUA)
			PRINTFORM 　……もっと遠慮しないで……
			CALL XON_FONT("❤❤",C_AQUA)
			PRINTFORM 　もっと私をブザマな顔にして……
			CALL XON_FONT("❤❤❤",C_AQUA)
			PRINTFORM 　もっと%CALLNAME:TARGET%を%CSTR:TARGET:MASCALL%色に染め上げて……
			CALL XON_FONT("群❤",C_AQUA)
			PRINTFORMW 」
	ENDSELECT
ENDIF
RETURN 1

