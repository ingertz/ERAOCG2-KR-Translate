	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「こ、これがこの世界の謝罪のしかた、なのですね……勉強になります……」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		PRINTFORMW 「……何について謝罪、しましょうか……❤　%TEXTR("おチンポさんを만족させられなくてイライラさせたこと/いつも私だけ勝手にイッてしまうこと/いつもオドオドしてしまうこと/デュエルで만족させられないこと")%、でしょうか……❤」
		PRINTFORMW 「……申し訳、ありません……❤　お詫びにこの%CALLNAME:TARGET%を……❤　%CSTR:TARGET:MASCALL%の好きなように御使い、くださぁい……❤」
		RETURN 1

	;それ以外
	ELSE
		PRINTFORML 「……え、えっと？　わ、私、なにか%CSTR:TARGET:MASCALL%の気に障ることをしましたか……？」
		PRINTFORMW 「……あ、あの、その、ええと……な、なにかわかりませんが、私のせいで機嫌を損ねてしまって……もうしわけ、ありません……！」
		RETURN 1
	ENDIF
ENDIF
RETURN 1
