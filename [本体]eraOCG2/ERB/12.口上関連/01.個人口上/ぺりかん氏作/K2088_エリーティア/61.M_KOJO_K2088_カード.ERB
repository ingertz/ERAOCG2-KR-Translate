;※※※※※※※※※※※※※※※※※※※※※※※※※
;CARD用구상
;※※※※※※※※※※※※※※※※※※※※※※※※※
;直接カードのIDを使える。
;캐릭터が無くても動く
;存在証明
@M_KOJO_CARD_K2088
RETURN 1
;==================================================
;0,モンスター소환時
;==================================================
@M_KOJO_CARD_K2088_0(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「『ミドレミコード・%CALLNAME:TARGET%』、い、いきます……！」
ENDIF

;==================================================
;1,攻撃時
;==================================================
@M_KOJO_CARD_K2088_1(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「少しでも、ダメージを……っ」
ENDIF

;==================================================
;2,효과발동
;==================================================
;효과別で鳴らしたいなら、直接カードのデータを見て、설정する必要がある
;面倒、分からないであれば분기はせず
;失敗판정は、いわゆる효과を無効にされたとかそういうやつ
@M_KOJO_CARD_K2088_2(종류,失敗판정)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 종류
#DIM DYNAMIC 失敗판정
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 失敗판정 == 0
		IF 종류 == 마함起動
			PRINTFORMW 「……さぁ！　皆さん、舞台袖より壇上へ、どうぞ……！」
		ELSEIF GROUPMATCH(종류,소환時 ,특수소환時)
			PRINTFORMW 「……ご退場、ねがいます……！」
		ENDIF
	ELSE
		PRINTFORMW 「あぅっ！　や、やっぱり私じゃダメ、なの……？」
	ENDIF
ENDIF

;==================================================
;3,除去時
;==================================================
;いちいちなんでも除去で話すとやかましいため、デフォでは破壊にのみ反応するように설정
@M_KOJO_CARD_K2088_3(除去종류,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 除去종류
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 除去종류
	CASE 戦闘破壊行き
		PRINTFORMW 「きゃあ！？　い、痛いです……！」
	CASE 破壊行き
		PRINTFORMW 「次こそ、もっと上手くやってみせます、から……っ」
	CASE 제외行き
		PRINTFORMW 「……そんな、私に未来はもう、ないの……？」
	ENDSELECT
ENDIF

