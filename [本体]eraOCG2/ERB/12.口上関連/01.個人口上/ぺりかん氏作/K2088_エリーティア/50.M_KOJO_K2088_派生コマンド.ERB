;==================================================
;12,파이즈리펠라
;==================================================
@M_KOJO_MESSAGE_SCOM_K2088_12
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2088_12_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2088_12_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「んしょ……っ、파이즈리、いかがですか……？　少しはうまく、なりましたかね……？」
		PRINTFORMW 「……そうだ♪　……ちゅっ♪　あん❤　えへへ、ビクってなりましたねっ♪　お口も使っちゃいます……」
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 1
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	IF BASE:MASTER:발기 >= 1350
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				IF TALENT:TARGET:연모 >= 1
				PRINTFORM 「ふふっ……❤　カッコいい、おチンポさん……❤　私の
					IF BUST_SIZE(TARGET) >= 3
						PRINTFORM だれも見たことないぐらいおっきく育てられた%CALLNAME:TARGET%っぱい
					ELSEIF BUST_SIZE(TARGET) >= 1
						PRINTFORM 憧れのグレーシア先輩と比べられるぐらい実った巨乳っぱい
					ELSEIF BUST_SIZE(TARGET) <= 0
						PRINTFORM 大きさではまだまだだけど、감도なら良好なおっぱい
					ENDIF
				PRINTFORMW でもちゃんと挟めるでしょうか……❤」
				PRINTFORMW 「あっ、大丈夫ですよぉ……❤　おっぱいじゃ만족できなくても……❤　ちゅっ♪　ずもももも……❤　こうやって、お口もつかいますから……❤　いっぱい喉マンコにお사정しましょうね……❤」
				ELSE
				PRINTFORML 「そ、そそり勃って、ます、ね……！？　こ、これならおっぱいでも、挟めるはず……？　よいしょ……っと……」
				PRINTFORMW 「き、気持ちいい、ですか……？　さらに、気持ちよく、してあげますからね……ちゅぶっ♪　ちゅぼぼっ……」
				ENDIF
			CASE 2
				PRINTFORML 「えへへ❤　私のおっぱい、오나홀にされちゃいました……❤　さっきから腰、とまらないですね……❤」
				PRINTFORMW 「ですけど……❤　れろっ❤　ふふ、舐めてくれるオナホなんてありませんからね……❤　このまま顔に、口に、おっぱいに……❤　いっぱいだして、くださいね……❤」
			CASE 3
				PRINTFORML 「だ、ダメですっ❤　私がぁ❤　파이즈리してるのにぃ❤　私のほうがぁ❤　興奮、しちゃいましたぁ……❤」
				PRINTFORMW 「ガマンできません、いただきまぁす……❤　じゅるっ❤　じゅぽっ❤　ぢゅるるるっ❤　じゅぽぽ……っ❤」
		ENDSELECT
	ELSEIF BASE:MASTER:발기 >= 600 && BASE:MASTER:발기 < 1350 
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				IF TALENT:TARGET:연모 >= 1
				PRINTFORM 「ふふっ……❤　元気になってきましたね、おチンポさん……❤　私の、
					IF BUST_SIZE(TARGET) >= 3
						PRINTFORM 規格外の超乳
					ELSEIF BUST_SIZE(TARGET) >= 1
						PRINTFORM ふわとろ巨乳
					ELSEIF BUST_SIZE(TARGET) <= 0
						PRINTFORM おっぱい
					ENDIF
				PRINTFORMW 、気に入りましたか……❤」
				PRINTFORM 「ふふ……っ❤　ちゃあんと발기できたおチンポさんにはご褒美ですっ
				CALL XON_FONT("！❤",C_AQUA)
				PRINTFORMW 　あむっ♪　ぢゅるっ❤　ちゅぽっ❤　ぢゅるるるっ……❤」
				ELSE
				PRINTFORM 「あっ、大きく、なってきましたね……そんなに、いいですか、私の
					IF BUST_SIZE(TARGET) >= 3
						PRINTFORMW ふわふわの超乳……」
					ELSEIF BUST_SIZE(TARGET) >= 1
						PRINTFORMW たわわな巨乳……」
					ELSEIF BUST_SIZE(TARGET) <= 0
						PRINTFORMW お子様おっぱい……」
					ENDIF
				PRINTFORMW 「……はい、お口でも、ですね……？　ちゅっ……」
				ENDIF
			CASE 2
				PRINTFORM 「ふふっ♪　さっきから腰がパン、パンって私のおっぱいに打ち付けてますよ……
				CALL XON_FONT("？❤",C_AQUA)
				PRINTFORMW 　そんなにいいんですか？　私のおっぱい오나홀……❤」
				PRINTFORMW 「ですけど、まだガマン、できますよね……❤　あぁ……んっ❤　はいっ❤　お口오나홀もできましたよ❤　こっちも使ってください、ね……❤」
			CASE 3
				PRINTFORMW 「ふ～……っ❤　ふ～……っ❤　立派な、おチンポさんです……❤　ご奉仕できること、嬉しく思います……❤」
				PRINTFORMW 「ずりっ、ずり……っ❤　ぴちゃっ♪　ちゅぶっ……❤　えへへ❤　%CSTR:TARGET:MASCALL%のがビクビクしてますね❤　いつでもザーメン、お사정ください……❤」
		ENDSELECT
	ELSEIF BASE:MASTER:발기 < 600 
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				IF TALENT:TARGET:연모 >= 1
				PRINTFORMW 「ふふっ……❤　元気ない、ですね、おチンポさん……❤　大丈夫、そんな時はわたしのおっぱい、です……❤」
				PRINTFORM 「えへへ、どうでしょう……
				CALL XON_FONT("❤？",C_AQUA)
					IF BUST_SIZE(TARGET) >= 3
						PRINTFORM だぁいすきな規格外おっぱいに包まれて……❤　
					ELSEIF BUST_SIZE(TARGET) >= 1
						PRINTFORM 先輩のようなふわふわおっぱいに包まれて……❤　
					ELSEIF BUST_SIZE(TARGET) <= 0
						PRINTFORM おっぱいで元気になるまで、しごいてあげますね……❤
					ENDIF				
				PRINTFORMW 　元気、でてきましたか……❤　口でも、気持ちよくしてあげますからね……❤」
				ELSE
					PRINTFORMW 「元気ない、ですね、おチンポさん……。
					IF BUST_SIZE(TARGET) >= 3
						PRINTFORMW 私の自慢のおっぱいで包んでさしあげます……」
					ELSEIF BUST_SIZE(TARGET) >= 1
						PRINTFORMW グレーシア先輩にも負けないおっぱいで癒やされてください……」
					ELSEIF BUST_SIZE(TARGET) <= 0
						PRINTFORMW 物足りないかもしれないですが、おっぱいに甘えてくださいね……」
					ENDIF
					PRINTFORMW 「ど、どうでしょうか……っ。お、お口でも奉仕しますね……？　ちゅっ……」
				ENDIF
			CASE 2
				PRINTFORMW 「ずーりっ♪　ずーりっ♪　ふふっ♪　おチンポさん、まだまだ元気がありませんね……❤」
				PRINTFORM 「それでは失礼しまして……❤　ちゅっ❤　れろぉ……❤　ふふ、亀頭から生臭ぁいニオイがしますよ❤　だんだん、元気がでてきましたか……
				CALL XON_FONT("❤？",C_AQUA)
				PRINTFORMW 」
			CASE 3
				PRINTFORMW 「ふ～……っ❤　ふ～……っ❤　まだ、발기されてないのに、すっごく매력的、ですよぉ……❤」
				PRINTFORMW 「おっぱいの中で暴れ始めてます……❤　そんな元気な子には、키스のご褒美❤　あげますからね……❤」
		ENDSELECT
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K2088_{SELECTCOM}_1
RETURN 1

