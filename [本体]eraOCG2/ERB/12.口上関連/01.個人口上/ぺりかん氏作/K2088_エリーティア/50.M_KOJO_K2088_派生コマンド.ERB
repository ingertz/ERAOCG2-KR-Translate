TARGET = LOCAL
;TARGETが구상主でない場合
TRYCALLFORM M_KOJO_MESSAGE_SCOM_K{NO:TARGET}_9_2
TARGET = LOCAL:2
RETURN LOCAL:1

;一人目구상
;TARGETが先に喋る時の구상
@M_KOJO_MESSAGE_SCOM_K2088_9_1
LOCAL:101 = MASTER_POSE(4,1,1)
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;연모
	SETCOLOR C_AQUA
	IF TALENT:연모
		IF NAME:(LOCAL:101) == "도도레미코드 큐티아"
			PRINTFORMW 「えへへ……❤　キューティアちゃん、見えてますかぁ……❤　こうやって舐めるとほら❤　%CSTR:TARGET:MASCALL%のおチンポさんは大喜び、でしょう……❤　れろっ❤　じゅぱっ❤」
		ELSEIF NAME:(LOCAL:101) == "레도레미코드 드리미아"
			PRINTFORMW 「우후후、なにをビックリしてるんですかぁドリーミアちゃん……❤　大人のオンナはこうしておチンポさんにご奉仕するもの、なんですよぉ❤　ぐちゅっ❤　れろっ❤」
		ELSEIF NAME:(LOCAL:101) == "파도레미코드 팬시아"
			PRINTFORMW 「どうして驚いてるんですかぁファンシア先輩……❤　大人のオンナはこうしてお口でおチンポさんを咥えるのが常識、なんですよぉ……❤　あむっ❤　ぢゅぽっ❤」
		ELSEIF NAME:(LOCAL:101) == "솔도레미코드 그레이시아"
			PRINTFORMW 「グレーシア先輩、見ててください……❤　%CALLNAME:TARGET%はこんなに立派におチンポさんにご奉仕できるようになりましたよぉ……❤　ちゅっ❤　ちゅぱっ❤」
		ELSEIF NAME:(LOCAL:101) == "라도레미코드 엔제리아"
			PRINTFORMW 「あれぇ……❤　エンジェリア先輩も混ざりたいんですかぁ……❤　ふふ、一緒に%CSTR:TARGET:MASCALL%のおチンポさんを咥えてあげましょう……❤　はむっ❤　ぢゅるっ❤」
		ELSEIF NAME:(LOCAL:101) == "시도레미코드 뷰티아"
			PRINTFORMW 「ビューティア先輩、見てくださいよぉ……❤　%CALLNAME:TARGET%、ちゃんと勉強したんですよぉ……❤　こうすればおチンポさんは悦んでくれるって……❤　れろっ❤　ちゅるっ❤」
		ELSEIF NAME:(LOCAL:101) == "그랜도레미코드 쿨리아"
			PRINTFORMW 「どうでしょうかクーリア先輩ぃ……❤　私の펠라치오、ちゃんとできていますかぁ……❤　顔を赤くしてないでご指導、お願いしまぁす……❤　ずぽっ❤　ぐちゅちゅ❤」
		ELSEIF NAME:(LOCAL:101) == "그랜도레미코드 뮤제시아"
			PRINTFORMW 「えへへ❤　どうでしょうか女神様……❤　%CALLNAME:TARGET%のお口奉仕はちゃんとできてますかね……❤　できればお手本を見せてくれると嬉しいですぅ……❤　ちゅぅ❤　ちゅばっ❤」
		ELSE
			PRINTFORMW 「ちゅぅ❤　ちゅるっ❤　ぢゅるるっ❤　……あ、ごめんなさぁい❤　私ばっかりおチンポさんを独り占めするのは良くないですよねぇ……❤　どうぞ一緒にやりましょう……❤」
		ENDIF
		RETURN 1

	;それ以外
	ELSE
		PRINTFORMW 「まだまだ펠라は不慣れなんです……お、お手本みせてもらえませんか……？」
		RETURN 1
	ENDIF
ENDIF
