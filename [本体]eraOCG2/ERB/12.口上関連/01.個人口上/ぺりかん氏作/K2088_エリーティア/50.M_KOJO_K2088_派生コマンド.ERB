;1,식스나인
;==================================================
@M_KOJO_MESSAGE_SCOM_K2088_1
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2088_1_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2088_1_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「きゃ……！？　な、なんでしょうか……？　こ、これも奉仕の練習です、か……？」
		PRINTFORMW 「『お互いがお互いを大事にする関係性が重要』……たしかに、そうですね……。では、その……お互いに、ご奉仕する、ということで……」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		PRINTFORMW 「あぁん❤　ま、負けませんよ……れろぉ……❤」
		IF BASE:MASTER:발기 >= 1350
			PRINTFORML 「ちゅっ❤　ちゅぷっ❤　もごぅ❤　じゅるっ❤　ぢゅるるる……っ❤　ぷはぁ❤　えへ❤　我慢汁ぅ❤　にがぁいぃ❤　ですねぇ……ぇ❤」
			PRINTFORMW 「このままお사정に……あぁんっ❤　ちょ、そこ弱い……ひぃんっ❤　ほ、本気出しすぎですよ……おぉんっ❤　ひぃ……❤」
		ELSEIF BASE:MASTER:발기 >= 600 && BASE:MASTER:발기 < 1350
			PRINTFORML 「ぴちゃぁ♪　ちゃぷっ❤　えへへぇ❤　元気ぃ❤　でたっ❤　みたいでぇ❤　す、ねぇ、おチンポぉ❤　……さんっ❤」
			PRINTFORMW 「もっとぉ❤　ムクムク、させますよぉ❤　ちゅっ♪　れろ……ぉ❤　ちゅるっ❤」
		ELSEIF BASE:MASTER:발기 <600
			PRINTFORMW 「……ふふ、まだまだ元気がぁ❤　ない……っ❤　みたいで、す、ねぇ……❤　れろっ♪　ぴちゃっ❤　んん……❤　あぁぁん❤」 
		ENDIF 
		RETURN 1

	;それ以外
	ELSE
		PRINTFORML 「あっ！？　……くぅ……っ！　お、お願いします、手加減……っ、して、ください……っ」
		PRINTFORMW 「オマンコっ、刺激……ぃ、つよ、すぎてぇ……うまく、ご奉仕がぁ……、でき、ません……っ」
		RETURN 1
	ENDIF
ENDIF
