;==================================================
;3,Gスポット刺激
;==================================================
@M_KOJO_MESSAGE_SCOM_K2088_3
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2088_3_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2088_3_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		;처녀膜ぶち抜き
		IF TCVAR:파과 == 1
			PRINTFORMW 「んっ、んんっ……づぅ！？　あ゛っ……あっ……？　な、なんです、かぁ……？　今の、いたみぃ……」
			PRINTFORMW 「……ひぅ！？　わ、わ、私の、股から……っ、ち、ち、血がっ！？　せ、生理……？　い、今……？　あ゛っ！？」
			PRINTFORMW 「ひぃ！？　お゛ぅ！？　%CALLNAME:MASTER%、さまぁ……っ、や、やめてぇ……い、いたいのとぉ、きもち、いいのとでぇ……く、狂っちゃい、そうです……」
		;それ以外
		ELSE
			PRINTFORMW 「あ゛ぅ！？　な、なんでしょう……？　い、今ゾクゾク！　ってぇ……。お゛んっ！？」
			PRINTFORM 「な、やめ、ひぃん゛っ❤　お、お願いします……ぅひぃっ❤　そ、ソコばっかり、イ゛ィン❤　せ、せめない、でぇ……
			CALL XON_FONT("塵❤1,塵❤2",C_AQUA)
			PRINTFORMW 」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		PRINTFORM 「ひぃっ❤　や、やだぁ……❤　ゆびっ、指だけでイッちゃうぅ……❤　お、おチンポさん、ほしいのにぃ❤　指で、弱点、コリコリ❤　って、イッちゃうぅぅ
		CALL XON_FONT("！❤",C_AQUA)
		PRINTFORMW 」
		RETURN 1

	;それ以外
	ELSE
		PRINTFORM 「っ……くぅ……ふぅ……うっ……あぅ❤　……くぅ❤　……あ、あああ❤　あぁ～っ❤　あぁ～っ❤　あぁぁぁ……っ
		CALL XON_FONT("❤！",C_AQUA)
		PRINTFORMW 」
		RETURN 1
	ENDIF
ENDIF
