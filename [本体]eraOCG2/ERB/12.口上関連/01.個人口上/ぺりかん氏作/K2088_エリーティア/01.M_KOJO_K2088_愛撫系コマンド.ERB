@M_KOJO_MESSAGE_COM_K2088_1_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORM 「な、何を！？　ど、どこに顔を突っ込んでいるんですか！？　きゃ……！　
		IF EXP:TARGET:Ｃ경험 == 0
		PRINTFORM と、突起
		ELSE
		PRINTFORM く、クリトリス
		ENDIF
		PRINTFORMW を、舐めないでぇ……！」
		PRINTFORM 「……ぇ？　『
		SIF EXP:TARGET:Ｃ경험 == 0
		PRINTFORM 突起、
		PRINTFORMW クリトリスを舐めるコトは愛情表現の一つ』……？　そ、そんな文化が……？　す、すみません驚いたりして……」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;질내사정直後
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:V삽입관리플래그 == MASTER
		IF TCVAR:질내사정플래그 
			IF TALENT:TARGET:연모 >= 1
				PRINTFORMW 「あ……❤　きたない、ですよぉ……❤　えへへ……♪　キレイにしてもらって、すみませぇん……❤」
			ELSE
				PRINTFORMW 「ひゃ……！？　き、きたない、ですよぉ……！？」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;절정した（この구상の後に절정）
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:0
		IF TALENT:TARGET:연모 >= 1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORM 「いっ、イキますっ❤　%CALLNAME:TARGET%、イッちゃいますっ❤　あっ、イク❤　イク❤　イクぅぅぅぅ……っ
					CALL XON_FONTL("❤！,❤❤,」",C_AQUA)
					PRINTFORMW 「はぁ……❤　はぁ……❤　クリトリス、気持ちよかったですよ……❤」
				CASE 1
					PRINTFORM 「く、クリトリス、イッちゃうぅ❤　わ、私のクリトリス、%CSTR:TARGET:MASCALL%に舐められてっ❤　甘噛みされてっ❤　い、い、イッちゃいますぅぅぅぅ
					CALL XON_FONT("！❤,群❤",C_AQUA)
					PRINTFORMW 」
				CASE 2
					PRINTFORM 「ひぃ❤　く、クリトリスからぁ❤　のぼってくるぅ❤　ゾクゾクっ❤　ゾクゾクって❤　やだ❤　ヤダっ❤　굴복、しちゃううぅぅ
					CALL XON_FONT("！❤,塵❤1,塵❤2",C_AQUA)
					PRINTFORMW 」
			ENDSELECT
		ELSE
			PRINTFORMW 「あっ……！？　な、なに……？　く、くる、なにか、くる……！　%CSTR:TARGET:MASCALL%、やめっ、あっ、あっ、あーーっ！？　あぁぁぁぁ……っ！？」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			IF TALENT:TARGET:연모 >= 1
				PRINTFORMW 「あっ❤　あぅ❤　く、クリトリスぅ❤　いじ、イジメ、ないでぇ……❤」
			ELSE
				PRINTFORML 「……っ！　……ひぃ！？　……くっ、……んんっ！　……っう……っ！？」
				PRINTFORMDW %CALLNAME:TARGET%はクリトリスへの刺激に違和感を感じているようだが、拒否しない。クンニが愛情表現の文化と本気で信じているようだ……
			ENDIF
		CASE 2
			PRINTFORMW 「はっ……うぅ……ムズムズ、します……っ」
		CASE 3
			IF TALENT:TARGET:연모 >= 1
				PRINTFORMW 「や、ヤダぁ❤　濡れてきた、なんて言わないでくださぁい❤　し、仕方ないじゃないですかぁ❤　%CSTR:TARGET:MASCALL%のクンニ、気持ちいいんですもん……❤」
			ELSE
				PRINTFORML 「……えっ！？　濡れて、きた……？　や、やだぁ……、私、お漏らしなんて、してません……っ」
				PRINTFORMW 「……こ、これはお漏らしとはちがうんですか？　私の体が気持ちよくなってる証拠？　そ、それなら、安心しました……」
			ENDIF
		;연모
		CASE 4
			PRINTFORMW 「ひゃ……❤　ふぅ……❤　く、クリトリスぅ……❤　%CSTR:TARGET:MASCALL%にぃ❤　躾けられ、ちゃいましたぁ……❤」
		;親愛
		CASE 5
			PRINTFORML 「%CSTR:TARGET:MASCALL%……？　わ、私がご奉仕しますから、%CSTR:TARGET:MASCALL%が気遣って、うぅん❤　くれる必要はぁ❤　な、ないんですよ……❤」
			PRINTFORMW 「……❤　わ、私を気持ちよくしたい、ですかぁ❤　えへへ❤　嬉しいです❤　じゃあ……もっとクンニ、して……❤」
	ENDSELECT
ENDIF
RETURN 1

