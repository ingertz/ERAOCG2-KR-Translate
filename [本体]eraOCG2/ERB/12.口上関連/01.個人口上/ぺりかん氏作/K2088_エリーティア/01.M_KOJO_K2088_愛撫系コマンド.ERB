@M_KOJO_MESSAGE_COM_K2088_0_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「そ、その……触られるん、ですよね……？　私の、からだ……」
		PRINTFORMW 「『자신だけ楽しむんじゃなくて、%CALLNAME:TARGET%にも楽しんでほしいから』……？　そ、そんな風に思ってくださったんですか……。で、では……私も楽しめるように、触って、ください……！」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;삽입中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V삽입
	IF LOCAL:1 && TEQUIP:50 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			SELECTCASE RAND:3
			CASE 0
				PRINTFORM 「んあぁっ
				CALL XON_FONT("❤❤❤",C_AQUA)
				PRINTFORML 　……ふふ♪　%CSTR:TARGET:MASCALL%、イッちゃいましたね……❤　あったかいのがドクドク私のナカにきてます……❤」
				PRINTFORMW 「……きゃあ❤　もう❤　사정なさったばっかりなのに元気ですね、%CSTR:TARGET:MASCALL%……❤　手がいやらしいですよ……❤」
			CASE 1
				PRINTFORM 「あぁ❤　%CSTR:TARGET:MASCALL%のが、子宮にビュービューきてますぅ……
				CALL XON_FONT("❤❤",C_AQUA)
				PRINTFORMW 　……えへへ、お疲れ様でした❤　あんっ❤　……もう、%CSTR:TARGET:MASCALL%は疲れ知らず、ですねぇ……❤」
			CASE 2
				PRINTFORM 「ふぅ……
				CALL XON_FONT("❤❤❤",C_AQUA)
				PRINTFORMW 　……はぁ、はぁ……、私のナカ、あっつい、です……❤　ひぃん❤　えへへ、もう次の準備、始めちゃいますかぁ……❤」
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「お腹が、あっついです……❤　ドクドク、いってるのが伝わってきます……❤」
				PRINTFORMW 「あぁん❤　も、もう❤　これ以上、私をたかぶらせないでぇ……❤」
			CASE 1
				PRINTFORMW 「えへへ❤　私のナカにおチンポさん、おさまっちゃって、ますねぇ……❤　ひゃああ❤　お、お腹ぁ❤　スリスリ、しないでぇ……❤　お、おっぱいも、敏感なんですぅ……❤」
			CASE 2
				PRINTFORML 「……はぁ、はぁ……、%CSTR:TARGET:MASCALL%のが、早く사정したい～って訴えてきてますよ……❤」
				PRINTFORMW 「ひぃんっ❤　け、結合部をサワサワするのはぁ❤　反則、ですよぉ❤　あっ❤　あっ❤　お、お사정、される前にイカされちゃうぅぅ……❤」
			ENDSELECT
			RETURN 1
		ENDIF
	;A삽입
	ELSEIF LOCAL:1 && TEQUIP:51 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			SELECTCASE RAND:2
			CASE 0
				PRINTFORM 「んあぁっ
				CALL XON_FONT("❤！,群❤,",C_AQUA)
				PRINTFORML 　……ふふ♪　%CSTR:TARGET:MASCALL%、イッちゃいましたね……❤　……直腸があっつくて、溶けちゃいそうです……❤」
				PRINTFORMW 「……ひぃんっ❤　も、もう元気なんですかぁ……❤　わ、私としてはもう少し、余韻をぉおんっ❤　も、もうっ……❤」
			CASE 1
				PRINTFORM 「か、感じますぅ……
				CALL XON_FONT("塵❤1,塵❤2",C_AQUA)
				PRINTFORML 　%CSTR:TARGET:MASCALL%の정액がぁ❤　私のお腹のナカ、グルグルしてます……❤」
				PRINTFORMW 「あっ……❤　えへへどうぞ❤　おっぱいも、オマンコも、好きにしてくださぁい……❤」
			ENDSELECT
			RETURN 1
		ELSE
			SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「うぅ❤　애널の違和感がぁ❤　すっごぉい……❤　お腹が圧迫されて、辛いのに幸せでぇ……❤」
				PRINTFORMW 「……ひゃああん❤　わ、私のことはいいじゃないですかぁ❤　ぴぃ❤　わ、私だってもうっ、限界なのにぃ……❤」
			CASE 1
				PRINTFORM 「……はぁ、はぁ……❤　%CSTR:TARGET:MASCALL%のが、私の애널のナカで、早く사정したい～って訴えてきてますよ……❤」
				PRINTFORMW 「ああっ❤　さ、さわらない、でぇ……❤　さ、先に%CSTR:TARGET:MASCALL%の手で、イカされ、ちゃううぅぅ……❤」
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF

	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 1
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORML 「て、手つきがやらしくないですか……？　も、もうちょっと優しく……」
			PRINTFORMW 「『%CALLNAME:TARGET%がかわいいからつい』……？　も、もう……❤　……続きを、どうぞ……❤」
		CASE 2
			IF TALENT:TARGET:연모 >= 1
				PRINTFORMW 「あっ❤　もう❤　そんな❤　執拗にぃ❤　やめてくださぁい❤　んあぁ❤　そ、そこぉ❤　弱いって、しってますよねぇ……❤」
			ELSE
				PRINTFORML 「……ふ、ふっ……、ん……、くぅ……。……え、声をガマンしなくていい？　いやその……恥ずかしくて……」
				PRINTFORMW 「『声はどこが気持ちいいかわかりやすくなるから出してくれたほうがいい』……？　わ、わかりました……。できるだけ、ガマン、しないようにします……」
			ENDIF
		CASE 3
			PRINTFORMW 「そ、その、%CSTR:TARGET:MASCALL%は楽しめていますか……？　私の体ばかり、触って……」
			SIF TALENT:TARGET:연모 >= 1
				PRINTFORMW 「……私ですか？　ふふ……、言わなくても、わかってますよね……❤　えへへぇ❤　メロメロ、ですよぉ❤」
		;연모
		CASE 4
			PRINTFORML 「あっ❤　そ、そこイイっ❤　んあっ❤　き、気持ちいいですぅ……❤　ひゃあぁっ❤　い、今ゾクゾクっ❤　ってぇ……❤」
			PRINTFORMW 「こ、怖いです、%CSTR:TARGET:MASCALL%❤　わ、私が私でなくなりそうでぇ❤　やぁ❤　やめないでっ❤　もっと、続けてぇ……❤」
		CASE 5
			PRINTFORMW 「……私、いやらしい子になっちゃいました❤　%CSTR:TARGET:MASCALL%に触られるたびに体が甘えん坊になるんです……❤　もっと、もっとぉ……って❤」
		;親愛
		CASE 6
			PRINTFORML 「ふふ……♪　嬉しいなぁ……❤　今日も%CSTR:TARGET:MASCALL%に愛してもらえるんだ……❤」
			PRINTFORMW 「もぅ……❤　いつもそうやっていやらしく触ってこられるから、私の体もスイッチ、入るようになっちゃいました……❤　いっぱいエッチ、しましょうね……❤」
		CASE 7
			PRINTFORML 「んあぁ❤　弄ばれてるぅ❤　%CSTR:TARGET:MASCALL%の手で❤　転がされてるぅ❤　%CALLNAME:TARGET%、イかされちゃうぅ❤」
			PRINTFORMW 「……はぁ❤　……はぁ❤　も、もう……終わりですかぁ❤　も、もっと%CALLNAME:TARGET%の体、触ってもいいんですよぉ……❤　それとも……❤　もっとヒドいコト、されちゃうんでしょうか……❤」
		;애처
		CASE 8
			PRINTFORMW 「……えへへぇ❤　ねぇ、%CSTR:TARGET:MASCALL%？　あなたに触れられるだけで子作りしたくなる、そんなエッチな奥さんはお好きですか……❤」
	ENDSELECT
ENDIF
RETURN 1
