		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		PRINTFORMW 「はいっ♪　%CALLNAME:TARGET%、%CSTR:TARGET:MASCALL%をキレイにさせてもらいますね……❤」
