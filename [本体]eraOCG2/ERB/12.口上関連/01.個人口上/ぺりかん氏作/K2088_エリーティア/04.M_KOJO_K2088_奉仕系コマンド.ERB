@M_KOJO_MESSAGE_COM_K2088_82_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「お、おっぱいでおチンポさんを挟む……ですか？　……あの、もしかして今まで色々されてたのって、コレを私にさせるため……だったりするのでしょうか……？」
		PRINTFORMW 「……わ、わかりましたっ。また、おっぱいに甘えたいんですよね……っ！　で、ですからそんな、悲しそうな顔、しないでください……っ」
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「よ、よいしょ……ど、どうでしょうか……？」
			IF BUST_SIZE(TARGET) <= 0
			PRINTFORMW 「せ、せめてグレーシア先輩ぐらい大きければ、もっとちゃんと挟めるのに……」
			ELSEIF BUST_SIZE(TARGET) >= 3
			PRINTFORMW 「ふふ♪　聞くまでもなさそう、ですね……❤」
			ELSE
			PRINTFORMW 「お、大きくてもちゃんと挟めるかは別問題、なのですね……よいしょ……」
			ENDIF
		CASE 2
			PRINTFORMW 「……%CSTR:TARGET:MASCALL%、そんなに私のおっぱい、いいんですか……？」
			SIF TALENT:TARGET:연모 >= 1
			PRINTFORMW 「……❤　もぅ……♪　ただおっぱいを求めるだけなら他にもいい人がいるでしょうに……❤　それでも私のおっぱいがいいんですね……❤」
		CASE 3
			PRINTFORML 「ちゃ、ちゃんと気持ちよくなってますか？　ちゃんと甘えられてますか……？」
			IF BASE:MASTER:발기 >= 1350
				PRINTFORMW 「……聞くまでもなかった、ですね……。おチンポさん、とっても元気です
				IF TALENT:TARGET:연모 >= 1
				PRINT ❤
				ENDIF
				PRINTW 」
			ELSEIF BASE:MASTER:발기 >= 600 && BASE:MASTER:발기 < 1350
				PRINTFORMW 「あっ……♪　だんだん私のおっぱいの中で、ムクムクっ……って……
				IF TALENT:TARGET:연모 >= 1
				PRINT 嬉しい……❤
				ENDIF
				PRINTW 」
			ELSEIF BASE:MASTER:발기 <600
				IF TALENT:TARGET:연모 >= 1
				PRINTFORMW 「まだまだ元気がないですね……。大丈夫、私のおっぱいが%CSTR:TARGET:MASCALL%を癒やしますからね……❤」
				ELSE
				PRINTFORMW 「うぅ……全然元気がありません。ほんとに気持ちいいですか……？」 
				ENDIF
			ENDIF
		CASE 4
			PRINTFORM 「でそう、ですか%CSTR:TARGET:MASCALL%ぁ……❤　ふふ、どちらにだされますか……❤　このままおっぱいのナカに……
			CALL XON_FONT("❤？",C_AQUA)
			PRINTFORML 」
			PRINTFORM 「それとも私の顔に……
			CALL XON_FONT("？❤",C_AQUA)
			PRINTFORM 　そうしたら私のメガネが汚れて정액しか見えなくなってしまいます……❤　悩ましいですか
			CALL XON_FONT("❤？",C_AQUA)
			PRINTFORM 　ならば……両方なんていかがですか……
			CALL XON_FONT("群❤",C_AQUA)
			PRINTFORMW 」
		CASE 5
			PRINTFORM 「甘えん坊のおチンポさん❤　私の
			IF BUST_SIZE(TARGET) >= 3
			PRINTFORM 規格外に実った%CALLNAME:TARGET%っぱいズリ❤　
			ELSEIF BUST_SIZE(TARGET) >= 2
			PRINTFORM ビューティア先輩ゆずりの爆乳っぱいズリ❤　
			ELSEIF BUST_SIZE(TARGET) >= 1
			PRINTFORM グレーシア先輩にも負けない爆乳っぱいズリ❤　
			ELSEIF BUST_SIZE(TARGET) >= 0
			PRINTFORM いつまでも変わらぬおっぱいズリ❤　
			ELSE
			PRINTFORM %CSTR:TARGET:MASCALL%の趣味にあわせたロリコンっぱいズリ❤　
			ENDIF
			PRINTFORMW はいかがですかぁ❤　大丈夫、私のおっぱいは、いつでもお사정されることを待ちわびていますから……❤」
	ENDSELECT
ENDIF
RETURN 1

