		RETURN 1

	;それ以外
	ELSE
		PRINTFORML 「んっしょ……ど、どうでしょうか……？　ちゃんと、キレイにできてます、か……？」
		PRINTFORMW 「ん……っ、ちょ、ちょっと私には刺激がつよい、ですね……っ。集中、しないと……っ」
		RETURN 1
	ENDIF
ENDIF
RETURN 1

