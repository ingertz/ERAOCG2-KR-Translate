;350,押し倒す（時姦時イタズラする
;TFLAG:194 (0=成功 1=人目がある　2=野外は嫌でござりまする　3=多人数プレイは勘弁　4=合意があっても무드が足りぬ　100=合意はあるが구상内특수판정によって失敗）
;TCVAR:抱き寄せ初回　1=普通に合意ゲット　2=先に키스ぐらいしろよ　3=媚薬or発情には勝てなかったよお…　4=悔しい…각인さえなければﾋﾞｸﾋﾞｸﾝ
;5=強引に迫られると断れぬ(素質臆病持ち専用) 6=まんざらでもない　7=駄目　8=論外 98=구상内특수판정による失敗 99=구상内특수판정による成功
;구상内특수판정は該当するCFLAGが0だと無効
;CFLAG:MASTER:우후후 (1=通常時　2=攻守反転)

;押し倒せるタイミングでないとコマンドが出ないため、TFLAG:194 == 0 以外は書く必要は無い
;上記の抱き寄せ初回は使えないため注意すること
;==================================================
@M_KOJO_MESSAGE_COM_K2088_350
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2088_350_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2088_350_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;抱き寄せ初回
	IF FIRSTTIME(TOSTR(350),1)
		PRINTFORML 「……%CSTR:TARGET:MASCALL%？　何を……きゃあ！？」
		IF TALENT:TARGET:연모 >= 1
			PRINTFORMW 「も、もうっ。もうすこしロマンチックにできなかったんですかっ」
			PRINTFORMW 「……え、えっと……この世界の男女の、その、アレコレについて、教えて下さい、ね……❤」
		ELSE
			PRINTFORMW 「え、えっと……？　ど、どうされましたか……？　目が、こわいですよ……？」
			PRINTFORMW 「……あ、はい。実践形式でもっと色々教えてくださるんですね。で、できる限り、がんばりますっ」
		ENDIF
	;それ以外
	ELSE
		CALLFORM FASHION_TYPE(TARGET)	
		;通常押し倒し
		IF CFLAG:MASTER:우후후 == 1
			IF TALENT:TARGET:연모 >= 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「ふぁぁ……❤　また、するんですね……❤」
					CASE 1
						PRINTFORML 「えへへ♪　%CALLNAME:MASTER%先生、今日も授業、よろしくお願いします」
						PRINTFORMW 「……もちろん授業料は%CALLNAME:TARGET%のカラダで、ですね……❤」
					CASE 2
						PRINTFORMW 「私に%CSTR:TARGET:MASCALL%のこと、教えて下さいね♪　手取り足取り……❤」
				ENDSELECT
			ELSE
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「今日もいっぱい、お勉強します……❤」
					CASE 1
						PRINTFORMW 「は、はい……っ。%CALLNAME:TARGET%にもっともっと、この世界の常識を教えて下さい……❤」
				ENDSELECT
			ENDIF
		;攻守反転（MASTERが受け）
		ELSEIF CFLAG:MASTER:우후후 == 2
			IF RESULTS == "バニー"
				PRINTFORMW 「い、いまの私はウサギさんなので……っ、は、は、発情……しちゃいましたぁ……❤」
			ELSE
				PRINTFORMW 「えい……っ。い、今こそ勉強の成果をお見せします……っ」
			ENDIF
		ENDIF
	ENDIF
ENDIF
RETURN 1
