;480,デュエル
;勝敗はプレイヤーから見てのもの
;TFLAG:SELECTCOM분기(1=通常승리 2=通常패배 3=引き分け
;10=通常듀얼前 11=パック賭け듀얼前 12=데이트賭け듀얼前 13=パンツ賭け듀얼前 14=お持ち帰り듀얼前 15=お前モンスターじゃないか？ 16=スケベ要求듀얼前 20=闇のゲーム
;31=パック賭け승리 32=데이트賭け승리 33=パンツ賭け승리 34=お持ち帰り成功 35=カード化승리（牝以外） 36=スケベ要求事後 40=罰ゲーム！
;135=カード化見逃す 235=穏便カード化 335=凌辱後カード化 435=凌辱後見逃す
;50=賭け듀얼패배怒られた 51=パック賭け패배 52=데이트패배데이트 55=カード化패배 56=スケベ要求패배 156=スケベ要求弱味削除 256=スケベ要求패배패배버릇付きおねだり)
;==================================================
@M_KOJO_MESSAGE_COM_K2088_480
;デュエルにTRAIN_MESSAGEはない
CALL M_KOJO_MESSAGE_COM_K2088_480_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2088_480_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;これが０の時はデュエルしない時なのでおわり
	SIF TFLAG:SELECTCOM분기 == 0
		RETURN 1

	;デュエル前
	IF INRANGE(TFLAG:SELECTCOM분기,10,21)
		SELECTCASE TFLAG:SELECTCOM분기
			;通常듀얼
			CASE 10
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「デュエル、ですか？　あ、はい！　わ、私でよければ……」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORMW 「はい、デュエルですね。%CALLNAME:TARGET%がお상대、いたします」
						ELSE
							PRINTFORMW 「も、もしかしたら、プレイミス、するかもしれませんが……お目汚しいただくと幸い、です……」
						ENDIF
					CASE 2
						IF EXP:MASTER:듀얼경험 >= 50 || TALENT:MASTER:수라
							PRINTFORML 「へぁ……！？　%CSTR:TARGET:MASCALL%から、プレッシャー、がぁ……！」
							PRINTFORMW 「こ、怖いです……で、でも戦う前から負けたく、ないです……！」
						ELSE
							PRINTFORMW 「は、はい！　%CSTR:TARGET:MASCALL%상대でも、戦って、みせます……！」
						ENDIF
				ENDSELECT
			;ここから賭け듀얼
			;パック賭け
			CASE 11
				PRINTFORMW 「か、賭け……ですか？　ま、まぁパックぐらいなら……」
			;데이트賭け
			CASE 12
				IF TALENT:TARGET:연모 >= 1
					PRINTFORMW 「데이트……ですね？　わかりました。でも……わざと負ける気は、ないです……！」
				ELSE
					PRINTFORMW 「で、데이트、ですか……！？　え、あ、ふ、深く考えなくていい……？　遊びに行くぐらいで考えればいい……？　そ、そうなん、ですね……？」
				ENDIF 
			;パンツ賭け
			CASE 13
				IF TALENT:TARGET:연모 >= 1
					PRINTFORMW 「……❤　そういう、プレイですかね……わかりました……❤」
				ELSE
					PRINTFORMW 「へぁ……！？　な、なんで私のショーツが賭けの대상なんですかぁ……！」
				ENDIF 
			;お持ち帰り
			CASE 14
				PRINTFORMW 
			;モンスターか問い詰める（人間は불가）
			CASE 15
				PRINTFORMW 「……！　ば、バレてしまいましたか……！？　こ、こうなったら力付くでも逃げて……！」
			;スケベ強要
			CASE 16
				PRINTFORMW 
			;闇のゲーム
			CASE 20
				PRINTFORMW 「……え？　な、なんですか、この雰囲気……っ」
		ENDSELECT

	;デュエル後
	ELSE
		SELECTCASE TFLAG:SELECTCOM분기
			;通常승리
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「わ、私では상대にもなりませんでしたか……お強いのですね……」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORML 「け、경험を積めば積むほど、実感します……%CSTR:TARGET:MASCALL%さんのプレイングのすごさに……！」
							PRINTFORMW 「で、でも……次は、勝ちます……！」
						ELSE
							PRINTFORMW 「うぅ……焦っちゃった……あそこは、あのカードだったのに……」
						ENDIF
					CASE 2
						IF EXP:MASTER:듀얼경험 >= 50 || TALENT:MASTER:수라
							PRINTFORML 「うぅ……怯えて、ちゃんと戦えませんでした……！」
							PRINTFORMW 「……こ、今度はちゃんと！　でゅ、デュエルしてみせます……！」
						ELSE
							PRINTFORMW 「うぅ……負けちゃいましたぁ……」
						ENDIF
				ENDSELECT
			;通常패배
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「か、勝てました……う、嬉しい……♪」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORML 「ありがとう、ございました……いい、デュエルでした」
							PRINTFORMW 「えへへ♪　目標としてた%CSTR:TARGET:MASCALL%に勝てて嬉しい、です……♪」
						ELSE
							PRINTFORMW 「えっ……？　う、うそ、勝てた……？　あっ、い、今の間に勝因をメモ、しないと……！」
						ENDIF
					CASE 2
						IF EXP:MASTER:듀얼경험 >= 50 || TALENT:MASTER:수라
							PRINTFORML 「うぅ……怯えて、ちゃんと戦えませんでした……！」
							PRINTFORMW 「……こ、今度はちゃんと！　でゅ、デュエルしてみせます……！」
						ELSE
							PRINTFORMW 「よ、よかった……勝てた……♪」
						ENDIF
				ENDSELECT				
			;通常引き分け
			CASE 3
				PRINTFORMW 「あ、あれ……？　引き分け、ですか……？」
			;ここから賭け승리
			;パック賭け
			CASE 31
				PRINTFORML 「ま、負けましたぁ……流石、ですね」
				PRINTFORMW 「……あ、そうでしたね。パックを賭けて、でした。……ふふっ、そんな目を輝かせなくても……」
			;데이트賭け
			CASE 32
				IF TALENT:TARGET:연모 >= 1
					PRINTFORMW 「……えへへ♪　%CSTR:TARGET:MASCALL%なら絶対勝てると、……えぇ、信頼しています」
				ELSE
					PRINTFORMW 「……は、はい！　ど、동행させて……いただきます」
				ENDIF
			;パンツ賭け
			CASE 33
				IF TALENT:TARGET:연모 >= 1
					PRINTFORML 「……はい、私のショーツ、ですよぉ……❤」
					PRINTFORM 「……その、それで……ショーツだけで、いいんですか……
					CALL XON_FONT("❤？",C_AQUA)
					PRINTFORMW 」
				ELSE
					PRINTFORML 「……う、うぅ……。なんでこんな賭け、しちゃったんだろう……」
					PRINTFORMW 「ど、どうぞ……。あの、それで、いつ返していただけますか……？　……か、返していただけるんですよね！？」
				ENDIF
			;お持ち帰り
			CASE 34
				PRINTFORMW 
			;下二桁３５は"モンスターか問い詰める"の분기
			;カード化（牝以外、選択肢無し）
			CASE 35
				PRINTFORMW 
			;カード化を見逃す（元気でな！）
			CASE 135
				PRINTFORMW 「あ……、いいん、ですか？　……感謝します。%CSTR:TARGET:MASCALL%っていい人、だったんですね」
			;穏便に話してカード化（怖くないよ～痛くないよ～）
			CASE 235
				PRINTFORML 「……は、はい。そうですよね……よくはないと、자신もわかってはいたんです……」
				PRINTFORMW 「おねがいします……私をカードにしてください」
			;身体を対価に見逃す（見逃すとは言ってない）
			CASE 335
				PRINTFORMW 「……えっ？　そ、そんな！？　は、話がちが──」
			;身体を対価に見逃す（見逃す）（패배버릇付いたり弱み握られたりする）
			CASE 435
				PRINTFORML 「……ぐすっ……あ、ありがとう、ございま、す……わ、私を……みのがして、もらえて……ありがとう、ござい……ます……」
				PRINTFORMW 「ぐすっ……うぅ……せんぱい……たすけて……ひっく……うぅ……」
			;身体要求事後
			CASE 36
				IF TALENT:TARGET:패배버릇
					PRINTFORMW 「……は、はい……❤　%CALLNAME:TARGET%は%CSTR:TARGET:MASCALL%に負けましたぁ……❤　好きにしてくださぁい……❤」
				ELSE
					PRINTFORMW 「……あ、……ぐすっ……ひっく……うぅ……」
				ENDIF
			;闇のゲーム
			CASE 40
				PRINTFORMW 

			;ここから賭け패배
			;怒られた
			CASE 50
				PRINTFORMW 「%CSTR:TARGET:MASCALL%……。こ、これに懲りたら、もうこんなこと、しないでくださいね……！」
			;パック賭け（パックを手渡す）
			CASE 51
				PRINTFORMW 「わぁ……♪　あ、ありがとうございます、%CSTR:TARGET:MASCALL%っ！」
			;데이트賭け（데이트はしてくれる）
			CASE 52
				IF TALENT:TARGET:연모 >= 1
					PRINTFORML 「か、勝てちゃいました……？　え、えっと、その……」
					PRINTFORMW 「わ、私が勝ったから、%CSTR:TARGET:MASCALL%にはで、で、데이트に付き合ってもらいます！　……エスコート、おねがいしますね……♪」
				ELSE
					PRINTFORMW 「え、っと……デュエルで賭けにするぐらい、私に동행を頼みたかったんですよね？　な、なら一緒にいきます」
				ENDIF
			;カード化패배（逃げられた）
