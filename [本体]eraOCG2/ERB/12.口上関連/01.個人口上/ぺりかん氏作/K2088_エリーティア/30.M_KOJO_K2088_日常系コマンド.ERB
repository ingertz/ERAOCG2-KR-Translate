	;TARGETが【親愛】だったら호감도修正に＋1
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	;TARGETが【연모】を得ていたら호감도修正に＋１
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
		IF ABL:MASTER:교양 < ABL:TARGET:교양
			SELECTCASE RAND:2
			CASE 0
				PRINTFORML 「そ、そうですね……ええと、では%CSTR:TARGET:MASCALL%でも興味がもてるようにお好きな曲を耳コピして演奏してみましょうか？」
