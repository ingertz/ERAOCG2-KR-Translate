RETURN RESULT

@M_KOJO_MESSAGE_COM_K2088_600_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
CALLFORM FASHION_TYPE(TARGET)
	IF CFLAG:MASTER:현재위치 == 場所_ラブホ
		IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨
			PRINTFORMW 「……はい❤」
		ELSE
			PRINTFORMW 「わ、立派な施設ですね……」
		ENDIF
	ELSEIF CFLAG:MASTER:현재위치 == 場所_裏通り
		IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨
			PRINTFORMW 「……%CSTR:TARGET:MASCALL%のそばなら、安心ですね……❤」
		ELSE
			PRINTFORMW 「ひっ……！　%CSTR:TARGET:MASCALL%、ぜ、絶対離れないで、くださいね……っ」
		ENDIF 
	ELSEIF CFLAG:MASTER:현재위치 == 場所_砂浜
		IF GET_MONTH() == "冬の月"
			PRINTFORMW 「なんだか……寂しいですね……」
		ELSEIF GET_MONTH() == "夏の月"
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨
				IF	RESULTS == "水着"
					PRINTFORMW 「……勉強してきました❤　海ってちょうどいい岩陰で、隠れながらエッチなことをするんですよね……❤」
				ELSEIF RESULTS == "金水着"
					PRINTFORMW 「……やん❤　私みたいなお子様でもギラギラといやらしい目で見られちゃいそう……❤　%CSTR:TARGET:MASCALL%、離さないでくださいね……❤」
				ELSEIF RESULTS == "牛水着"
					PRINTFORMW 「ダメですよぉ……❤　牛さんを放牧するなら海じゃなくて草原ですよ、も～❤」
				ELSE
					PRINTFORMW 「えへへ❤　一夏の思い出、いっぱい作りましょうね……❤」
				ENDIF
			ELSE
				PRINTFORMW 「ひ、人が多くて……お、泳げ、ますかね……？」
			ENDIF
		ELSE
			PRINTFORMW 「……流石に、夏のように人はいませんね……」
			SIF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨
				PRINTFORMW 「次の夏になったら、また今日のように連れ出してくれますか？　……今度は水着を着て、です♪」
		ENDIF 
	ELSEIF CFLAG:MASTER:현재위치 == 場所_カフェ
		IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨
			IF RESULTS == "メイド"
				PRINTFORMW 「……ふふっ♪　お店の人に間違えられちゃったらどうしましょうか？　私は%CSTR:TARGET:MASCALL%専用のメイドさん、ですのに……❤」
			ELSE
				PRINTFORMW 「いい香り……！　えへへ、連れてきてもらえて、とっても嬉しいです❤」
			ENDIF
		ELSE
			PRINTFORMW 「あ、いい香り……。落ち着き、ますね……♪」
		ENDIF
	ELSEIF CFLAG:MASTER:현재위치 == 場所_川沿い
		IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨
			PRINTFORMW 「うーん、あまり綺麗ではないですが……でも二人きりなら別に気にならない、かも……❤」
		ELSE
			PRINTFORMW 「そ、その……あまり綺麗では、ありませんね……」
		ENDIF 
	ELSEIF CFLAG:MASTER:현재위치 == 場所_ジャングル || CFLAG:TARGET:현재위치 == 場所_スリルゾーン || CFLAG:TARGET:현재위치 == 場所_お城 || CFLAG:TARGET:현재위치 == 場所_観覧車 || CFLAG:TARGET:현재위치 == 場所_KCスタジアム || CFLAG:TARGET:현재위치 == 場所_KL入口 || CFLAG:TARGET:현재위치 == 場所_KL広場 || CFLAG:TARGET:현재위치 == 場所_KC売店 || CFLAG:TARGET:현재위치 == 場所_KCステージ
		PRINTFORMW 「わぁぁ……！　す、すごいですよ%CSTR:TARGET:MASCALL%！　連れてきてくれてありがとうございます……！」
		SIF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨
		PRINTFORMW 「困りました……また、%CSTR:TARGET:MASCALL%のこと、好きになっちゃいました……❤」
	ELSEIF 依頼_完了횟수:304 != 0
		IF CFLAG:MASTER:현재위치 == 場所_牧場
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨
				IF TALENT:TARGET:모유체질
					PRINTFORMW 「いつか私も……ここで飼われてるお姉様方のように、%CSTR:TARGET:MASCALL%の牛さんになっちゃう、のでしょうね……❤」
				ELSE
					PRINTFORMW 「ここがウワサの……%CSTR:TARGET:MASCALL%の牧場ですね。……メスウシさんたちを飼ってる、という……❤」
					SIF RESULTS == "牛水着"
					PRINTFORMW 「……ふふ❤　今日の目的は、将来働く직장の、見学、ですかね……❤」
				ENDIF
			ELSE
				PRINTFORMW 「あ、こちらが%CSTR:TARGET:MASCALL%の所有されてるという牧場、なんですね……っ」
			ENDIF
		ENDIF
	ELSE
		IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨
			PRINTFORMW 「今日はこちらですね……ふふ、楽しみです❤」
		ELSE
			PRINTFORMW 「は、はい……お供、します」
		ENDIF
	ENDIF
ENDIF
RETURN 1
