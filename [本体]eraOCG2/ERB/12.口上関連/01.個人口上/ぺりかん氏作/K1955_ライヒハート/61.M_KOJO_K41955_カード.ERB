;※※※※※※※※※※※※※※※※※※※※※※※※※
;CARD用구상
;※※※※※※※※※※※※※※※※※※※※※※※※※
;直接カードのIDを使える。
;캐릭터が無くても動く
;存在証明
@M_KOJO_CARD_K41955
RETURN 1
;==================================================
;0,モンスター소환時
;==================================================
@M_KOJO_CARD_K41955_0(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「オラオラオラァ！！　オレ様こそが『スケアクロー・トライヒハート』様よォ！！」
ENDIF

;==================================================
;1,攻撃時
;==================================================
@M_KOJO_CARD_K41955_1(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE RAND:4
		CASE 0
			PRINTFORMW 「さァ、泣き叫べェ！！　『恐怖の大王』様のお通りだァ！！！」
		CASE 1
			PRINTFORMW 「何立ってやがる……？　テメェは恐怖でガタガタ震えてやがれェ！！」
		CASE 2
			PRINTFORMW 「……ッハ！　オレ様の前でいくら守りを固めたって、……無駄なんだよォ！！」
		CASE 3
			PRINTFORMW 「覚悟はいいんだなァ……？　オレ様の一撃は、ハンパじゃねェぞォ！！」
	ENDSELECT
ENDIF

;==================================================
;2,효과발동
;==================================================
;효과別で鳴らしたいなら、直接カードのデータを見て、설정する必要がある
;面倒、分からないであれば분기はせず
;失敗판정は、いわゆる효과를 無効にされたとかそういうやつ
@M_KOJO_CARD_K41955_2(종류,失敗판정)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 종류
#DIM DYNAMIC 失敗판정
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 失敗판정 == 0
		PRINTFORMW 「ハッハァ！　こいよ下僕共！　喧嘩の時間だァ！！」
	ELSE
		PRINTFORMW 「テメェ……！　ぜってェ後悔させてやるぜェ……！」
	ENDIF
ENDIF

;==================================================
;3,除去時
;==================================================
;いちいちなんでも除去で話すとやかましいため、デフォでは破壊にのみ反応するように설정
@M_KOJO_CARD_K41955_3(除去종류,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 除去종류
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 除去종류
	CASE 破壊行き
		PRINTFORMW 「ガハッ……！？　く、ソがぁ……！」
	ENDSELECT
ENDIF

