;==================================================
;10,ダメージ反応！（ダメージ）
;==================================================
@M_KOJO_DUEL_K1955_10(ダメージ量,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC ダメージ量
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE ダメージ量
		;ダメージなし
		CASE 0
			PRINTFORMW 「ハッ、ビビってんのかァ！？」
		;１～１９９９の時、小ダメージ
		CASE 1 TO 1999
			IF ライフ_상대 < 0
				PRINTFORMW 「チィ、カスリ傷でも死は死、だな……」
			ELSEIF ライフ_상대 < 4000
				PRINTFORMW 「ハッ！　蜂の一刺しでもここまで迫れるか！」
			ELSE
				PRINTFORMW 「オイオイ……随分と涙ぐましいダメージだなァ！　そんなんじゃ日が暮れちまうぞォ？」
			ENDIF
		;２０００～３９９９の時、結構なダメージ
		CASE 2000 TO 3999
			IF ライフ_상대 < 0
				PRINTFORMW 「くぁあ！　オレ様の負け、かぁ！？」
			ELSEIF ライフ_상대 < 4000
				PRINTFORMW 「チィ、油断してたか……？　もう半分切ってやがる……！」
			ELSE
				PRINTFORMW 「ヘェ、そこそこいいパンチじゃネェか」
			ENDIF
		;４０００～７９９９の時、超大ダメージ
		CASE 4000 TO 7999
			IF ライフ_상대 < 0
				PRINTFORMW 「……ハ！　見事だよ、テメェはなァ！！」
			ELSE
				PRINTFORMW 「……コレがァ、どうしたァ！？　オレ様はまだ、立っているぞォ！！」
			ENDIF
		;８０００以上、基本即死
		CASEELSE
			PRINTFORMW 「……へ、渾身の一撃……、真正面から受けてやったぜ……！　流石、だなァ兄弟……！！」
	ENDSELECT
ENDIF


