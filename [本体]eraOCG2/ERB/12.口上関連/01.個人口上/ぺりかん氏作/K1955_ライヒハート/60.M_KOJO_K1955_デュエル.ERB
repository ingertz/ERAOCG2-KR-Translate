;==================================================
;0,デュエルスタート！
;==================================================
@M_KOJO_DUEL_K1955_0(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「ヒャッハァ、殺し合いの時間だァ！！」
		CASE 2
			PRINTFORMW 「オイオイオイオイ、頭が高いぜ？　『恐怖の大王』様に傅けよ？」
		CASE 3
			PRINTFORMW 「ハッ！　殺意は充分かよ？　……いいねェ、いい目をしてるじゃねェか兄弟！！」
	ENDSELECT
ENDIF

;==================================================
;1,モンスター소환
;例：%カード名%を소환！
;==================================================
@M_KOJO_DUEL_K1955_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF カードID == 1955
		PRINTFORM 「先鋒は当然オレ様！　
		SETCOLOR C_WOODS_G
		PRINTFORM 『%カード名%』
		SETCOLOR C_FUSE_PUR
		PRINTFORMW のお通りだァ！！」
	ELSEIF GROUPMATCH(カードID,25600,25601,25602)
		PRINTFORM 「下僕共、喧嘩の時間だァ！　こいよ『%カード名%』！」
	ELSEIF カードID == 31031
		PRINTFORM 「背中に気をつけなナヨ野郎！　また刺されるんじゃねェぞ！　
		SETCOLOR C_WATER_T
		PRINTFORM 『%カード名%』
		SETCOLOR C_FUSE_PUR
		PRINTFORMW 소환だァ!」
	ELSEIF カードID == 33333
		PRINTFORM 「よくもやってくれたな분노の大将！　今度はオレ様がこき使ってやらァ！　
		SETCOLOR C_D_RED
		PRINTFORM 『%カード名%』
		SETCOLOR C_FUSE_PUR
		PRINTFORMW 소환だァ!」
	ELSEIF カードID == 29250
		PRINTFORM 「……オウ、涼しい顔して中々やるじゃねェの！　その実力、見せてみろやァ！　
		SETCOLOR C_YELLOW_2
		PRINTFORM 『%カード名%』
		SETCOLOR C_FUSE_PUR
		PRINTFORMW 소환だァ!」
	ELSE
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「まずはコイツだァ！　%カード名%소환！」
		CASE 2
			PRINTFORMW 「おらいけェ！　%カード名%！！」
		CASE 3
			PRINTFORMW 「손패から소환！　%カード名%！！」
	ENDSELECT
	ENDIF
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_KOJO_DUEL_K1955_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 소환出処
		;손패から
		CASE 召種손패
			IF カードID == 1955
				PRINTFORM 「オレ様の出番だァ！　道を空けな！
				SETCOLOR C_WOODS_G
				PRINTFORM 『%カード名%』
				SETCOLOR C_FUSE_PUR
				PRINTFORMW 특수소환！！」
			ELSEIF GROUPMATCH(カードID,25600,25601,25602)
				PRINTFORM 「下僕共、喧嘩の時間だァ！　こいよ『%カード名%』！」
			ELSEIF カードID == 33335
				PRINTFORMW 「ハッ！　侵略者共、便利なもん作ってんじゃねェか！　『%カード名%』、オレ様が使い倒してやるよォ！」
		ELSEIF カードID == 31031
			PRINTFORM 「背中に気をつけなナヨ野郎！　また刺されるんじゃねェぞ！　
			SETCOLOR C_WATER_T
			PRINTFORM 『%カード名%』
			SETCOLOR C_FUSE_PUR
			PRINTFORMW 소환だァ!」
		ELSEIF カードID == 33333
			PRINTFORM 「よくもやってくれたな분노の大将！　今度はオレ様がこき使ってやらァ！　
			SETCOLOR C_D_RED
			PRINTFORM 『%カード名%』
			SETCOLOR C_FUSE_PUR
			PRINTFORMW 소환だァ!」
		ELSEIF カードID == 29250
			PRINTFORM 「……オウ、涼しい顔して中々やるじゃねェの！　その実力、見せてみろやァ！　
			SETCOLOR C_YELLOW_2
			PRINTFORM 『%カード名%』
			SETCOLOR C_FUSE_PUR
			PRINTFORMW 소환だァ!」
		ELSEIF カードID == 1949
			PRINTFORM 「来いよ、相棒……！　トチるんじゃねェぞォ！　
			SETCOLOR C_SILVER
			PRINTFORM 『%カード名%』
			SETCOLOR C_FUSE_PUR
			PRINTFORMW 共闘の時間だァ！！」
		ELSE
			SELECTCASE RAND:3 + 1
				CASE 1
					PRINTFORMW 「まずはコイツだァ！　%カード名%소환！」
				CASE 2
					PRINTFORMW 「おらいけェ！　%カード名%！！」
				CASE 3
					PRINTFORMW 「손패から소환！　%カード名%！！」
			ENDSELECT
			ENDIF
		;마법함정ゾーンから。　キリ番・シェイプシスターなどを出す場合
		CASE 召種마함
			PRINTFORMW 「伏兵ドォーン！　마법함정ゾーンから%カード名%소환だァ！」
		;덱から
		CASE 召種덱
			PRINTFORMW 「サッサと来な！　덱から%カード名%を소환！」
		;EX덱から
		CASE 召種EX덱
			IF カードID == 1949
			PRINTFORML 「……今度はオレ様もいるんだ、呑まれるんじゃねェぞ相棒ォ！！」
			PRINTFORM 「いくぜ！　 
			SETCOLOR C_SILVER
			PRINTFORM 『%カード名%』
			SETCOLOR C_FUSE_PUR
			PRINTFORM 敵に目にもの、
			SETCOLOR C_WOODS_G
			PRINTFORM 見せて
			SETCOLOR C_SILVER
			PRINTFORM やんよォ！！
			SETCOLOR C_FUSE_PUR
			PRINTFORMW 」
			ELSE
			PRINTFORMW 「ハッ！　EX덱から%カード名%を소환するぜェ！」
			ENDIF
		;묘지から
		CASE 召種묘지
			IF カードID == 1955
				PRINTFORM 「オレ様、再登場ォ！　
				SETCOLOR C_WOODS_G
				PRINTFORM 『%カード名%』
				SETCOLOR C_FUSE_PUR
				PRINTFORMW が来てやったぜェ！！」
			ELSEIF GROUPMATCH(カードID,25600,25601,25602,33335)
				PRINTFORM 「ネボスケ共、サッサと起きやがれ！　『%カード名%』묘지から来なァ！」
			ELSE
			PRINTFORMW 「묘지から来いよォ！　%カード名%！」
			ENDIF
		;제외状態から
		CASE 召種제외
			PRINTFORMW 「제외ィ……？　知るかよサッサときやがれ%カード名%！！」
		;主にトークン生成
		CASE 10
			PRINTFORMW 「おゥ！　トークン소환だァ！」
	ENDSELECT
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K1955_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
