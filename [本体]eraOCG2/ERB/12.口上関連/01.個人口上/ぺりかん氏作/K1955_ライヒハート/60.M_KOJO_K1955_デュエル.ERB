				PRINTFORMW 「……へへ、なんでェ、いい顔になりやがったじゃねェか嬢ちゃんよォ！」
			ELSEIF カードID == 54013
				PRINTFORM 「いい加減本気になりやがれよナヨナヨタコスケ！　융합소환、
				SETCOLOR C_WATER_T
				PRINTFORM 『%カード名%』
				SETCOLOR C_FUSE_PUR
				PRINTFORMW ！！」
				PRINTFORMW 「……ハン！　頼りにさせてもらおうかねェ……！」
			ELSEIF カードID == 41951
				PRINTFORMW 「……ップ！　ダァッハッハッハ！！　レイノハートの野郎、力取られてやがるじゃねェか！！」
				PRINTFORM 「っとォ、笑って悪かったな嬢ちゃん！　융합소환、
				SETCOLOR C_WATER_T
				PRINTFORM 『%カード名%』
				SETCOLOR C_FUSE_PUR
				PRINTFORMW ！！」
			ELSEIF カードID == 1949
				PRINTFORML 「……今度はオレ様もいるんだ、呑まれるんじゃねェぞ相棒ォ！！」
				PRINTFORM 「いくぜ！　 
				SETCOLOR C_SILVER
				PRINTFORM 『%カード名%』
				SETCOLOR C_FUSE_PUR
				PRINTFORM 敵に目にもの、
				SETCOLOR C_WOODS_G
				PRINTFORM 見せて
				SETCOLOR C_SILVER
				PRINTFORM やんよォ！！
				SETCOLOR C_FUSE_PUR
				PRINTFORMW 」
			ELSE
				PRINTFORMW 「융합소환！　起きやがれ、%カード名%！！」
			ENDIF
		CASE 싱크로
			IF カードID == 54555
				PRINTFORM 「ソイツがテメェの本気の姿か……！　当然ハッタリじゃあねェだろうなァ！　싱크로소환！
				SETCOLOR C_YELLOW_2
				PRINTFORM 『%カード名%』
				SETCOLOR C_FUSE_PUR
				PRINTFORMW ！！」
				PRINTFORMW 「……さァ、ぶちかましてやりなァ！」
			ELSEIF カードID == 41949
				PRINTFORM 「オレ様の知らねェ相棒……か。……싱크로소환！！
				SETCOLOR C_SILVER
				PRINTFORM 『%カード名%』
				SETCOLOR C_FUSE_PUR
				PRINTFORMW ！！」
				PRINTFORMW 「……見せてくれよ、相棒！　オレ様に、オマエの本気をよォ……！！！」
			ELSE
				PRINTFORMW 「集いしナンチャラがナンチャラナンチャラ！　싱크로소환！　%カード名%！！」
			ENDIF
		CASE 엑시즈
			IF カードID == 52071
				PRINTFORM 「オレ様を吸収したっていうその姿！　コケオドシだったら承知しねェぞ！　엑시즈소환！
				SETCOLOR C_D_RED
				PRINTFORM 『%カード名%』
				SETCOLOR C_FUSE_PUR
				PRINTFORMW ！！」
				PRINTFORMW 「……クックック、相変わらずブチギレてやがんなァ……！」
			ELSE
				PRINTFORMW	「엑시즈소환！　現れろ%カード名%！！」
			ENDIF 
		CASE 링크
			IF カードID == 11955
				PRINTFORM 「今から此処は
				SETCOLOR C_WOODS_G
				PRINTFORM 『ライフォビア』
				SETCOLOR C_FUSE_PUR
				PRINTFORM だァ！！　링크소환、
				SETCOLOR C_WOODS_G
				PRINTFORM 『%カード名%』
				SETCOLOR C_FUSE_PUR
				PRINTFORMW ！！」
				PRINTFORMW 「……へっへ、見た目で判断するんじゃねェぞォ……！」
			ELSEIF カードID == 41955
				PRINTFORM 「링크소환！　……三ツ首揃えた恐怖の王が、雁首揃えて落としにきたぜェ……！　
				SETCOLOR C_WOODS_G
				PRINTFORM 『%カード名%』
				SETCOLOR C_FUSE_PUR
				PRINTFORMW 堂々登場！！」
				PRINTFORMW 「……さァて、恐怖に震えて怯えてなァ……！！」
			ELSE
				PRINTFORMW 「링크소환！　%カード名%！　まァオレ様より弱えだろうが、せいぜい気張りなァ！！」
			ENDIF
		;초차원モンスター（デュエマ）
		CASE 초차원
			PRINTFORMW 「お、おう……？　まァオレ様の味方するなら환영するぜェ！　こいよ%カード名%！！」
	ENDSELECT
ENDIF

;==================================================
;4,효과使用宣言
;==================================================
@M_KOJO_DUEL_K1955_4(カードID,발동出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
