@M_KOJO_MESSAGE_COM_K1955_302_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME(SELECTCOM)
		PRINTFORMW 「ハッ、オレ様に触りたい、たァクソ배짱じゃねェか……！！」
		PRINTFORMW 「……いいぜ！　そのかわりオレ様の機嫌を損ねたら、ズバン！　だ気をつけなァ！！」
		RETURN 1
	ENDIF
	SELECTCASE TFLAG:SELECTCOM분기
		CASE 1
			SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「……意外と落ち着くなァ、おい」
			CASE 1
				PRINTFORMW 「……やめろよ普段水洗いぐらいなんだよ、髪を櫛でとごうとすんなよ……」
			CASE 2
				PRINTFORML 「オメェの手はやわらけェなァ……殺し合いをしたことない手だ……
				PRINTFORMW 　オレ様の手なんか触っても楽しくないだろうが、ったくよォ……」
			ENDSELECT
		CASE 0
			SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「髪にさわりたいィ？　なんでだよ
				PRINTFORMW 　……手入れ？　たまに水で洗うぐらいだなァ」
			CASE 1
