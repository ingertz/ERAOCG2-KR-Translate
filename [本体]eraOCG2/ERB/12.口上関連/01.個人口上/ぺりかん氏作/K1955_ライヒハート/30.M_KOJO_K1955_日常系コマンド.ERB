@M_KOJO_SUCCESS_COM_K1955_301
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K1955_301
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K1955_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1955_301_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME(SELECTCOM)
		PRINTFORMW 「おゥ、飲みもんかサンキュ」
		PRINTFORMW 「……ンだこりャァ！？　み、水に味ついてんぞ！？　こ、この世壊すげェな……」
		RETURN 1
	ENDIF
	SELECTCASE TFLAG:SELECTCOM분기
		CASE 1
			SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「下僕どもにも飲ませてやりてェなァ……犬はダメ？　アイツラもかわいそうだなァ……」
			CASE 1
				PRINTFORMW 「……オメェ、デュエルしかできないわけじゃなかったんだな」
			CASE 2
				PRINTFORML 「へへ、飽きないように味を変える気遣い、気に入ったぜ！　今なら召使に……！
				PRINTFORMW 　……そういうのはいい？　そうかよ」
			ENDSELECT
		CASE 0
			SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「おゥ、ありがとな……
				PRINTFORMW 　……オメェ、どっから出したんだ……？」
			CASE 1
				PRINTFORMW 「オレ様、ついつい大声でちまうからなァ！　よく喉が乾くんだよ、サンキュな！」
			CASE 2
				PRINTFORML 「あっついのも冷たいのもいいなァ！　おかわりくれねェか！？」
			ENDSELECT
		CASE -1
			PRINTFORMW 「んだこりャ、マズイぞ！？　次は飲めるもん、持って来いやァ！」
	ENDSELECT
ENDIF
RETURN 1
