;==================================================
;300,会話
;TFLAG:SELECTCOM분기(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより교양が4以上高い)
;TCVAR:302(0=会話可能 1=非연모時会話不能)
;MARK:반발각인(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;CFLAG:우후후(조교中の会話)
;CFLAG:변기화(肉便器の時の会話)
;==================================================
@M_KOJO_SUCCESS_COM_K1955_300
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K1955_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で구상色が付きません。
CALL TRAIN_MESSAGE
;구상メイン呼出
CALL M_KOJO_MESSAGE_COM_K1955_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1955_300_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME(SELECTCOM)
		PRINTFORMW 「오우、%CALLNAME:TARGET%다。……아앙？　너무 짧다고？　그렇다고 해도……」
		PRINTFORMW 「이 몸으로서는、강한 녀석과 싸울 수만 있다면 그만이라는 생각이다。……싸울수만 있다면 말 따위는 필요없잖아、안그래？」
		RETURN 1
	ENDIF
	;호감도修正、通常（연모系陥落なし）で５
	호감도修正 = 5
	;TARGETが【애처】だったら호감도修正に＋２
	SIF TALENT:TARGET:애처
		호감도修正 += 2
	;TARGETが【親愛】だったら호감도修正に＋２
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	;TARGETが【연모】を得ていたら호감도修正に＋１
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	;「RAND:n」n面ダイスを振る
	;우후후中の会話
	IF CFLAG:TARGET:우후후
		SELECTCASE RAND:3 + 1
			CASE 1
				PRINTFORMW 
			CASE 2
				PRINTFORMW 
			CASE 3
				PRINTFORMW 
		ENDSELECT
	;日常会話
	ELSE
		SELECTCASE RAND:7 + 1
			CASE 1
				IF TIME >= KANTAN_TIME(05,00) && TIME <= KANTAN_TIME(10,00)
					PRINTFORML 「좋은 아침이다。너 의외로、아침에 잘 일어나는 구만？」
					PRINTFORMW 「앙？　이 몸？　흥、강아지 놈들이 아침 잠이 없어서 말이야、이 몸도 자연스럽게 아침형 인간이 됐을 뿐이다.」
				ELSEIF TIME >= KANTAN_TIME(10,00) && TIME <= KANTAN_TIME(16,00)
					IF GET_WEATHER() == "쾌청" || GET_WEATHER() == "맑음" 
						PRINTFORML 「날씨 좋구만 형씨！　듀얼하기에 딱 좋다고 생각하지 않냐！！」
						PRINTFORMW 「오、아니면 달릴까！？　카드샵에 가서 무사 수행 하는 것도 좋겠네！　두근거리지 않냐고 형씨！！」
					ELSEIF GET_WEATHER() == "흐림"
						PRINTFORML 「……헷、라이포비아에선 대개 흐린 날씨지。오히려 이 불온함이 부추기는 공기가 좋지않냐」
						PRINTFORMW 「케케케、이왕 이렇게 된 거 길거리 듀얼이라도 나가볼까？　『공포의 대왕』여기 있노라고 말이야！」
					ELSEIF GET_WEATHER() == "우천"
						PRINTFORML 「……참나、너무 젖는 건 좋지 않는데……。그 녀석들도 비가 오면 금방 나무 그늘로 숨으려고 한단 말이지」
						PRINTFORMW 「애초에、카드가 젖으면 듀얼을 못 하잖아！　……아ー、슬리브나、갈아끼울까……」
					ELSEIF GET_WEATHER() == "호우"
						PRINTFORML 「하하하！　어차피 내릴 거라면 이 정도로 호쾌하게 내려줘야지！　기습을 위해、폭우를 틈타 행군했던 기억이 되살아나는구만！！」
						PRINTFORMW 「……뭐냐？　설마 천둥이 무서운 거냐？　핫！　네 옆에 있는 게 누구라고 생각하는 거야？　이 몸보다 무서운 건 없으니까 안심하라고！」
					ELSEIF GET_WEATHER() == "강설" || GET_WEATHER() == "눈보라"
						PRINTFORML 「어이어이어이어이……！　춥다 했더니 눈이 내리고 있잖아……！　좋아、눈싸움 하자고！！」
						PRINTFORMW 「……뭐냐 그 이상한 표정은、자 간다……제설？　그럼 누가 더 눈을 많이 치우나 승부할까！！」
					ENDIF
				ELSEIF TIME >= KANTAN_TIME(16,00) && TIME <= KANTAN_TIME(23,00)
					PRINTFORML 「헤헤헤……、밤은 생물들이 공포에 떠는 시간이지。즉 이 몸의 시간이라는 소리라고！？」
					PRINTFORMW 「……뭐、듀얼할 상대가 없다면 어쩔 수 없지。그럼 덱 레시피나 짜볼까。어이、뭐 좋은 아이디어 좀 내놔봐」
				ENDIF
			CASE 2
				PRINTFORMW 「호오、이 몸의 위대한 테마、스케어클로에 대해 듣고 싶은 거냐？　좋아, 가르쳐 주마！」
				PRINTFORMW 「……라고는 해도 지루하게 길게 떠드는 건 성미에 안 맞아서 말이야……？　어이、뭐에 대해 듣고 싶은 건데？」
				PRINTL
				PRINTFORMDL [0] - ……스케어클로란 어떤 테마야？
				PRINTFORMDL [1] - 라이포비아란 어떤 세계야？
				PRINTFORMDL [2] - 왜%CALLNAME:TARGET%말고는 멍멍이들밖에 없어？
				PRINTFORMDL [3] - 어째서 라이트하트가 되면 갑자기 쪼그라드는 거야？
				BINPUT
				PRINTL
				IF RESULT == 0
					PRINTFORML 「하아！？　이 몸을 불러내 놓고 스케어클로를 모른다니 실화냐！？　그건 이 몸이 다 공포로 떨릴 지경이구만……」
					PRINTFORMW 「잘 들어라、스케어클로는、이 몸의！　이 몸에 의한！　이 몸을 위한！　끝내주는 테마라고！！　링크소환、이라는 걸로 싸우는 테마지！」
					PRINTFORML 「우선은 이 몸、
					SETCOLOR C_WOODS_G
					PRINTFORMW 『스케어클로・라이히하트』
					SETCOLOR C_FUSE_PUR
					PRINTFORM 로 필요한 마법/함정을 긁어모은다！　그다음 링크 1인 이 몸、
					SETCOLOR C_WOODS_G
					PRINTFORM 『라이트하트』
					SETCOLOR C_FUSE_PUR
					PRINTFORM 로 세괴를
					SETCOLOR C_WOODS_G
					PRINTFORM 『라이포비아』
					SETCOLOR C_FUSE_PUR
					PRINTFORMW 로 만들 수 있지！！」
					PRINTFORM 「『라이포비아』로 세괴가 되면、그때 원하는 스케어클로를 가져올 수 있지！　거기서 이러쿵저러쿵해서 필살기인 링크３、
					SETCOLOR C_WOODS_G
					PRINTFORM 『트라이히하트』
					SETCOLOR C_FUSE_PUR
					PRINTFORML 로 두들겨 패는 거다！！」
					PRINTFORMW 「하수인인 강아지 놈들은 싸우지 못하지만、이 몸에게 힘을 보태줌으로써 무적의『트라이히하트』님이 완성되는 거다！　어떠냐！　재미있을 것 같지！？」
				ELSEIF RESULT == 1
					PRINTFORM 「
					SETCOLOR C_WOODS_G
					PRINTFORM 『사세괴-라이포비아』
					SETCOLOR C_FUSE_PUR
					PRINTFORML 인가……일세괴가 그 나약한 녀석인 게 짜증 나지만、사세괴≒死라는 건 마음에 드는군！　이 몸은『공포의 대왕』이니까 말이야！！」
					PRINTFORMW 「뭐、이 세괴와는 정반대로、평화니 평온이니 하는 것과는 거리가 먼 세계지……。애초에 이성있는 생물이라고는 이 몸과 내가 길들인 하수인인 강아지 놈들 정도일 테니까！！」
					PRINTFORM 「게다가 빌어먹을 붉은 침략자……
					SETCOLOR C_D_RED
					PRINTFORM 『크샤트리라』
					SETCOLOR C_FUSE_PUR
					PRINTFORMW 녀석들이 주기적으로 쳐들어온단 말이지……。뭐、관광 목적으로 오는 건 추천하지 않는다고！！」
				ELSEIF RESULT == 2
					PRINTFORML 「애초에 라이포비아에 제대로 된 동물이 없어！　이성이 있는 건 간신히 이 몸 정도지……。나머지는 폭력과 공포로 굴복시켰다는 느낌이다」
					PRINTFORMW 「그중에서도 마지막까지 대들었던 세 마리를 하수인으로 삼아 부리고 있는 게 실정이지！　조심하라고？　그 녀석들 의외로 집념이 강하니까 말이야！！」				
				ELSEIF RESULT == 3
					PRINTFORM 「아ー……。이 몸은 파트너……
					SETCOLOR C_SILVER
					PRINTFORM 『비서스・스타프로스트』
					SETCOLOR C_FUSE_PUR
					PRINTFORML 에게서 갈라져 나온 존재라는 건 알고 있나？」
					PRINTFORML 「파트너에게 처참하게 깨진 이 몸은 약육강식、즉 패자로서 모든 것을 빼앗긴 셈이지……。그런데 말이야！　파트너에게도 첫 포식이었던 터라 먹다 남은 찌꺼기가 생겨버렸단 말이지、이게」
					PRINTFORM 「즉 그것이 이
					SETCOLOR C_WOODS_G
					PRINTFORM 『스케어클로・라이트하트』
					SETCOLOR C_FUSE_PUR
					PRINTFORMW 라는 거다！　뭐 이 몸이 없었으면 그 멍청한 녀석은 어디선가 발이 꼬였을 테고、결론은 이 몸 최강！　유능！　하다는 소리지！！」
				ENDIF
			CASE 3
				PRINTFORMW 「앙？　다른 세괴에 대해서도 알고 싶다고？　어쩔 수 없구만、어이、나중에 맛있는 밥이나 한턱 쏴라？」
				PRINTFORMW 「……그럼 신경 쓰이는 녀석 이름이나 대봐。한 번에 한 명씩만 하라고？　남에 대해 주절주절 떠드는 건 이 몸의 캐릭터가 아니니까 말이야！」
				PRINTL
				PRINTFORMDL [0] - 스케어클로・라이히하트
				PRINTFORMDL [1] - 티아라멘츠・레이노하트
				PRINTFORMDL [2] - 크샤트리라・라이즈하트
				PRINTFORMDL [3] - 마나둠・리움하트
				PRINTFORMDL [4] - ……비서스・스타프로스트
				BINPUT
				PRINTL
				IF RESULT == 0
					PRINTFORML 「뭐냐, 이 몸의 이야기냐！　너、이 몸을 너무 좋아하는 거 아니냐！　좋아、가르쳐 주마！！」
					PRINTFORM 「이 몸은
					SETCOLOR C_WOODS_G
					PRINTFORM 『%CALLNAME:TARGET%』
					SETCOLOR C_FUSE_PUR
					PRINTFORM ！　『공포』의 구현！　
					SETCOLOR C_WOODS_G
					PRINTFORM 『라이포비아』
					SETCOLOR C_FUSE_PUR
					PRINTFORM 의 위대한 대왕！　그리고 파트너인
					SETCOLOR C_SILVER
					PRINTFORM 『비서스』
					SETCOLOR C_FUSE_PUR
					PRINTFORMW 를 몇 번이나 구해준 믿음직한 사나이다！！」
					PRINTFORMW 「좋아하는 건 폭력！　싸움도 좋아한다고！ 반대로 우물쭈물하는 녀석은 딱 질색이지！　화끈하게 패버리고 이 몸 최강！　이게 최고 아니냐？　뭐、보디가드 정도는 해줄 테니까、잘 부탁한다고！」
				ELSEIF RESULT == 1
					PRINTFORM 「아아、그 나약한 녀석인가……욕하는 게 아니라고！？　그놈 본모습인
					SETCOLOR C_WATER_T
					PRINTFORM 『티아라멘츠・카레이도하트』
					SETCOLOR C_FUSE_PUR
					PRINTFORML 를 보라고 아무리 봐도 문어처럼 흐물흐물 나약하게 생겼잖아！」
					PRINTFORMW 「생각해 보니 그놈이 진주를 모으던 이유도 잘 모르겠단 말이지……？　뭐 어차피 별거 아닌 이유였겠지！　여자를 울리고 조종해서 싸우게 만드는 쓰레기니까 말이야！！」
					PRINTFORMW 「……그나저나 어떻게 된 거지？　내가 아는 한 그놈의 힘을
					SETCOLOR C_WATER_T
					PRINTFORM 키토칼로스 아가씨
					SETCOLOR C_FUSE_PUR
					PRINTFORM 나
					SETCOLOR C_WATER_T
					PRINTFORM 눈매 사나운 아가씨
					SETCOLOR C_FUSE_PUR
					PRINTFORMW 가 빼앗았다는、소리는 못 들었는데……뭐、어디서 실수라도 했겠지！」
				ELSEIF RESULT == 2
					PRINTFORM 「……아아、그 빌어먹을 침략자 놈들의 우두머리……
					SETCOLOR C_D_RED
					PRINTFORM 『크샤트리라・라이즈하트』
					SETCOLOR C_FUSE_PUR
					PRINTFORM 인가……。그놈은 절대 용서 못 해……！　멋대로 이 몸의 세괴를
					SETCOLOR C_D_RED
					PRINTFORM 『파라이조스』
					SETCOLOR C_FUSE_PUR
					PRINTFORML 로 개조해버리고 말이야……！」
					PRINTFORM 「……뭐 그렇다 해도、그 마음은 이해가 간단 말이지 짜증 나게도。그 자식은『분노』니까 말이야、자신이
					SETCOLOR C_SILVER
					PRINTFORM 『비서스』
					SETCOLOR C_FUSE_PUR
					PRINTFORMW 의 짝퉁이라는 사실을 인정할 수 없는 거겠지……。수완이나 집념도 뭐, 적이지만 훌륭하다」
					PRINTFORMW 「하지만！！　어디까지나 이 몸은『라이트하트』였을 때 기습을 당했을 뿐이다！！　다음에 만나면 아주 가루로 만들어 주마！！」
				ELSEIF RESULT == 3
					PRINTFORM 「
					SETCOLOR C_YELLOW_2
					PRINTFORM 『마나둠・리움하트』
					SETCOLOR C_FUSE_PUR
					PRINTFORM ……이 몸、이 녀석이랑만 접점이 없단 말이지……。애초에
					SETCOLOR C_YELLOW_2
					PRINTFORM 『칼라리움』
					SETCOLOR C_FUSE_PUR
					PRINTFORML 같은 세괴、들어본 적도 없다고」
					PRINTFORMW 「그렇다 해도、이 녀석이 파트너의 폭주를 막아준 건 사실이다……。헤、이런 온화한 얼굴을 하고선、제법 하잖아……！」
					PRINTFORMW 「이왕이면 이 몸도 한 판 붙어보고 싶었지만 말이야……。이런 부류는 요리조리 피해버린단 말이지……。참、아깝구만……」
				ELSEIF RESULT == 4
					PRINTFORM 「……핫！　이 몸의 파트너、
					SETCOLOR C_SILVER
					PRINTFORM 『비서스・스타프로스트』
					SETCOLOR C_FUSE_PUR
					PRINTFORMW 에 대해서는 네놈이 훨씬 더 잘 알 거다！　어차피 난 그 녀석 여정의 전반부밖에 함께하지 못했으니까 말이야……」
					PRINTFORML 「뭐、그래도……그 녀석은 처음부터 도무지 알 수 없는 남자였다고……。이 몸을 갑자기 한 방에 박살 내더니、『티아라멘츠』아가씨들에게 의리도 없으면서 편을 들어주고……」
					PRINTFORMW 「생각해 보면 그 녀석은 멍청해 보이는 주제에 고집불통이었지……그런 녀석과의 여행은、그래……나쁘지 않았어。아아、그래！　꽤 즐거웠다고！！！」
				ENDIF
			CASE 4
				PRINTFORML 「오우、한가하냐？　한가하면 듀얼이나 하자고！　헤헤、목숨이 걸리지 않은 싸움 따위 지루할 줄 알았는데、이거 의외로 재미있잖아！」
