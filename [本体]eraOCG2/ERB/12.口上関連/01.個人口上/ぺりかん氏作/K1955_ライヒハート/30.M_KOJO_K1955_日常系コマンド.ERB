;==================================================
;480,デュエル
;勝敗はプレイヤーから見てのもの
;TFLAG:SELECTCOM분기(1=通常승리 2=通常패배 3=引き分け
;10=通常듀얼前 11=パック賭け듀얼前 12=데이트賭け듀얼前 13=パンツ賭け듀얼前 14=お持ち帰り듀얼前 15=お前モンスターじゃないか？ 16=スケベ要求듀얼前 20=闇のゲーム
;31=パック賭け승리 32=데이트賭け승리 33=パンツ賭け승리 34=お持ち帰り成功 35=カード化승리（牝以外） 36=スケベ要求事後 40=罰ゲーム！
;135=カード化見逃す 235=穏便カード化 335=凌辱後カード化 435=凌辱後見逃す
;50=賭け듀얼패배怒られた 51=パック賭け패배 52=데이트패배데이트 55=カード化패배 56=スケベ要求패배 156=スケベ要求弱味削除 256=スケベ要求패배패배버릇付きおねだり)
;==================================================
@M_KOJO_MESSAGE_COM_K1955_480
;デュエルにTRAIN_MESSAGEはない
CALL M_KOJO_MESSAGE_COM_K1955_480_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1955_480_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;これが０の時はデュエルしない時なのでおわり
	SIF TFLAG:SELECTCOM분기 == 0
		RETURN 1

	;デュエル前
	IF INRANGE(TFLAG:SELECTCOM분기,10,21)
		SELECTCASE TFLAG:SELECTCOM분기
			;通常듀얼
			CASE 10
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「팃하하！　듀얼이다！！」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORMW 「핫！　이쪽도 그동안 실컷 맞붙어 왔다고、슬슬 그 목을 따주마……！？」
						ELSE
							PRINTFORMW 「헷、확실히 듀얼은 익숙지 않지만 말이야……배짱만큼은 질 생각 없다고！　간다！！」
						ENDIF
					CASE 2
						IF EXP:MASTER:듀얼경험 >= 50 || TALENT:MASTER:수라
							PRINTFORML 「……너는 정말 재미있단 말이지……。평소엔 약해 보이는데、덱을 잡으면 풍기는 기세가 달라져……」
							PRINTFORMW 「좋다……！　강자를 정면에서 물어뜯어야말로『공포의 대왕』！　이 몸의 힘、보여주마！！！」
						ELSE
							PRINTFORMW 「헷,、듀얼이라면 지지 않겠다는 표정이구만……？　재미있군、한판 붙어보자고！！」
						ENDIF
					ENDSELECT
			
			;ここから賭け듀얼
			;パック賭け
			CASE 11
				PRINTFORMW 「팃하하！　좋다、네놈에게 이기고 이 몸의 덱은 더욱 강해질 거다！！」
			;데이트賭け
			CASE 12
				PRINTFORMW 「……핫！　이 몸을 밖으로 끌어내고 싶다면 실력부터 증명해 보시지！！」
			;パンツ賭け
			CASE 13
				PRINTFORMW 
			;お持ち帰り
			CASE 14
				PRINTFORMW 
			;モンスターか問い詰める（人間は불가）
			CASE 15
				PRINTFORMW 「……그래서？　그게 어쨌다는 거냐？」
				PRINTFORMW 「모르겠냐？　여기서 네놈을 패버리면 모든 게 없던 일이 된다는 말씀이야！！」
			;スケベ強要
			CASE 16
				PRINTFORMW 
			;闇のゲーム
			CASE 20
				PRINTFORMW 
		ENDSELECT

	;デュエル後
	ELSE
		SELECTCASE TFLAG:SELECTCOM분기
			;通常승리
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「아～！　젠장、패배다 패배」
						PRINTFORMW 「……슬슬 짜증 나는데、어이、한 판 더 해」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORMW 「카아～！？　진짜냐고 아직도 부족한 거냐！」
							PRINTFORMW 「아～！　젠장、다음 리벤지 매치에선 이 몸이 이긴다！　기억해 두라고！！」
						ELSE
							PRINTFORML 「치잇……！　운이 나빴어、패가 꼬였다고、네놈 손패가 너무 좋았어……」
							PRINTFORMW 「흥！ 자신의 부족함을 남 탓으로 돌리는 건 쉬운 일이지！　인정하마、이 몸이 약했던 것뿐이라고！」
						ENDIF
					CASE 2
						IF EXP:MASTER:듀얼경험 >= 50 || TALENT:MASTER:수라
							PRINTFORML 「어이어이어이어이、적어도 이겼으면 좀 기뻐해라、형씨。안 그러면 진 이 몸이 비참해지잖아」
							PRINTFORMW 「뭐、이 몸은 패배자로 끝날 생각 따위 손톱만큼도 없으니까 말이야……！　방심하면 확！　물어뜯어 줄 테니까！！」
						ELSE
							PRINTFORMW 「크으으윽～！？　살육전이라면 이 몸이 최강！　하지만、듀얼이라면 네놈이 간발의 차로 위라는 거냐……！」
						ENDIF
					ENDSELECT
			;通常패배
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「팃하하！　이 몸이 최강이다！！」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORMW 「헷、봤냐！？　이 몸、지고 나서 찌그러져 있을 사나이가 아니라고……！！」
						ELSE
							PRINTFORMW 「흥！　방심했냐？　미안하지만、파고들 틈만 보이면 확！　물어뜯는 게『스케어클로』다！」
						ENDIF
					CASE 2
						IF EXP:MASTER:듀얼경험 >= 50 || TALENT:MASTER:수라
							PRINTFORML 「……하하！　어이어이어이어이！　졌으면 적어도 분해하기라도 하라고 어이！！」
							PRINTFORMW 「지고 나서！　기쁜 듯이 웃는 거냐고 어이！　네놈 생각보다 더한 듀얼 바보구만、형씨……！！」
						ELSE
							PRINTFORMW 「헷、듀얼에서도 위를 달린다！　그게 이 몸%CALLNAME:TARGET%의 진면목이지！」
						ENDIF
					ENDSELECT
			;通常引き分け
			CASE 3
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「……하아？　뭐야 그게、살육전에 무승부 같은 게 어딨어！？」
				CASE 1
					PRINTFORMW 「헷、서로 전력을 다한 결과가 딱 맞아떨어졌다는 건가？　이번만큼은 받아들여 주마」
				ENDSELECT
			;ここから賭け승리
			;パック賭け
			CASE 31
				PRINTFORMW 「제기랄……！　자、가져가라 이 도둑놈아！」
			;데이트賭け
			CASE 32
				PRINTFORMW 「핫！　『공포의 대왕』님을 시종으로 부리다니、아주 호강에 겨운 팔자로구만 형씨！」
			;パンツ賭け
			CASE 33
				PRINTFORMW 
			;お持ち帰り
			CASE 34
				PRINTFORMW 
			;下二桁３５は"モンスターか問い詰める"の분기
			;カード化（牝以外、選択肢無し）
			CASE 35
				PRINTFORMW 
			;カード化を見逃す（元気でな！）
			CASE 135
				PRINTFORMW 
			;穏便に話してカード化（怖くないよ～痛くないよ～）
			CASE 235
				PRINTFORMW 
			;身体を対価に見逃す（見逃すとは言ってない）
			CASE 335
				PRINTFORMW 
			;身体を対価に見逃す（見逃す）（패배버릇付いたり弱み握られたりする）
			CASE 435
				PRINTFORMW 
			;身体要求事後
			CASE 36
				PRINTFORMW 
			;闇のゲーム
			CASE 40
				PRINTFORMW 

			;ここから賭け패배
			;怒られた
			CASE 50
				PRINTFORMW 「흥！　네놈이 이 몸에게서 뭔가를 뺏으려 들다니 일억 광년은 빠르다고！！」
			;パック賭け（パックを手渡す）
			CASE 51
				PRINTFORMW 「좋아！　……어디 보자、레어 카드는 들어 있으려나……♪」
			;데이트賭け（데이트はしてくれる）
			CASE 52
				PRINTFORML 「핫！　아쉽게 됐구만！　
				PRINTFORMW 　이 몸을 수하로 부리겠다는 그 무모한 야망을 가상히 여겨서、오늘만큼은 어울려 주마 형씨！」
			;カード化패배（逃げられた）
			CASE 55
				PRINTFORMW 
			;身体要求패배（金払う）
			CASE 56
				PRINTFORMW 
			;身体要求패배（弱味削除）
			CASE 156
				PRINTFORMW 
			;身体要求패배（패배버릇付いてる時限定凌辱おねだり）（ラブホ直行）
			CASE 256
				PRINTFORMW 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

