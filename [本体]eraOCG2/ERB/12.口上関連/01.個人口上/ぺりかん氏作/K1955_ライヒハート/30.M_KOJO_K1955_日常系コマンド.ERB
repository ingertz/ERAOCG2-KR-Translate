;==================================================
;480,デュエル
;勝敗はプレイヤーから見てのもの
;TFLAG:SELECTCOM분기(1=通常승리 2=通常패배 3=引き分け
;10=通常듀얼前 11=パック賭け듀얼前 12=데이트賭け듀얼前 13=パンツ賭け듀얼前 14=お持ち帰り듀얼前 15=お前モンスターじゃないか？ 16=スケベ要求듀얼前 20=闇のゲーム
;31=パック賭け승리 32=데이트賭け승리 33=パンツ賭け승리 34=お持ち帰り成功 35=カード化승리（牝以外） 36=スケベ要求事後 40=罰ゲーム！
;135=カード化見逃す 235=穏便カード化 335=凌辱後カード化 435=凌辱後見逃す
;50=賭け듀얼패배怒られた 51=パック賭け패배 52=데이트패배데이트 55=カード化패배 56=スケベ要求패배 156=スケベ要求弱味削除 256=スケベ要求패배패배버릇付きおねだり)
;==================================================
@M_KOJO_MESSAGE_COM_K1955_480
;デュエルにTRAIN_MESSAGEはない
CALL M_KOJO_MESSAGE_COM_K1955_480_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1955_480_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;これが０の時はデュエルしない時なのでおわり
	SIF TFLAG:SELECTCOM분기 == 0
		RETURN 1

	;デュエル前
	IF INRANGE(TFLAG:SELECTCOM분기,10,21)
		SELECTCASE TFLAG:SELECTCOM분기
			;通常듀얼
			CASE 10
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「ヒャッハァ！　デュエルだァ！！」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORMW 「ハッ！　こっちも散々やり合ってきたんだ、いい加減その首とらせてもらうぜェ……！？」
						ELSE
							PRINTFORMW 「へっ、たしかにデュエルは慣れてないけどよ……배짱だけなら負けてるつもりはねェ！　さぁいくぜェ！！」
						ENDIF
					CASE 2
						IF EXP:MASTER:듀얼경험 >= 50 || TALENT:MASTER:수라
							PRINTFORML 「……オメェはほんとにおもしれェよなァ……。普段は弱そうなのに、덱を構えると風格が出やがる……」
							PRINTFORMW 「いいぜェ……！　強者を真っ向から食いちぎってこそ『恐怖の大王』！　オレ様の力、見せてやらァ！！！」
						ELSE
							PRINTFORMW 「へッ、デュエルなら負けねェってツラだなァ……？　おもしれェ、やりあうかァ！！」
						ENDIF
					ENDSELECT
			
			;ここから賭け듀얼
			;パック賭け
			CASE 11
				PRINTFORMW 「ヒャッハァ！　いいぜェ、テメェに勝ってオレ様の덱はもっと強くなる！！」
			;데이트賭け
			CASE 12
				PRINTFORMW 「……ハッ！　オレ様を連れ出したいんなら力を見せてもらおうじゃねェかよォ！！」
			;パンツ賭け
			CASE 13
				PRINTFORMW 
			;お持ち帰り
			CASE 14
				PRINTFORMW 
			;モンスターか問い詰める（人間は불가）
			CASE 15
				PRINTFORMW 「……で？　それがどうしたよ？」
				PRINTFORMW 「わからねェのか？　ここでテメェをぶちのめせば何もかも帳消しってワケよォ！！」
			;スケベ強要
			CASE 16
				PRINTFORMW 
			;闇のゲーム
			CASE 20
				PRINTFORMW 
		ENDSELECT

	;デュエル後
	ELSE
		SELECTCASE TFLAG:SELECTCOM분기
			;通常승리
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「あ～！　クソ、負けだ負け」
						PRINTFORMW 「……ムカついてきたな、オイ、もう一戦させろや」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORMW 「カァ～！？　マジかよまだ足んねェのかよ！」
							PRINTFORMW 「あ～！　クソ、次のリベンジマッチじゃあオレ様が勝つ！　覚えとけよ！！」
						ELSE
							PRINTFORML 「チィ……！　運が悪かった、噛み合いが悪かった、オメェの손패がよかった……」
							PRINTFORMW 「ハン！　자신の足りなさを他のせいにするのは簡単だわな！　認めてやる、オレ様が弱かっただけってなァ！」
						ENDIF
					CASE 2
						IF EXP:MASTER:듀얼경험 >= 50 || TALENT:MASTER:수라
							PRINTFORML 「オイオイオイオイ、せめて勝ったなら喜べよ、兄弟。そうじゃなきゃ負けたこっちがミジメだろうが」
							PRINTFORMW 「ま、オレ様は負け犬で終わるつもりなんてサラサラねェ……！　油断したらガブリ！　っていくからよォ！！」
						ELSE
							PRINTFORMW 「クッソォ～！？　殺し合いならオレ様最強！　だが、デュエルならテメェのほうがかろうじて上手かよォ……！」
						ENDIF
					ENDSELECT
			;通常패배
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「ヒャハッ！　オレ様最強！！」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORMW 「ヘッ、見たかよ！？　オレ様、負けてくすぶるような漢じゃあねェんだよォ……！！」
						ELSE
							PRINTFORMW 「ハン！　油断してたか？　悪いな、付け入る隙があればガブリ！　なのが『スケアクロー』よ！」
						ENDIF
					CASE 2
						IF EXP:MASTER:듀얼경험 >= 50 || TALENT:MASTER:수라
							PRINTFORML 「……ハハッ！　オイオイオイオイ！　負けたならせめて悔しがれよオイ！！」
							PRINTFORMW 「負けて！　嬉しそうに笑うかよオイ！　テメェ思った以上のデュエルバカだなァ、兄弟……！！」
						ELSE
							PRINTFORMW 「ヘッ、デュエルでも上をいく！　それがオレ様%CALLNAME:TARGET%の真骨頂よ！」
						ENDIF
					ENDSELECT
			;通常引き分け
			CASE 3
			SELECTCASE RAND:2
				CASE 0
					PRINTFORMW 「……ハァ？　んだよソレ、殺し合いに引き分けなんかあるかよ！？」
				CASE 1
					PRINTFORMW 「ヘッ、お互い全力出し合った結果の噛み合わせってかァ？　まァ今回は受け入れてやるよ」
				ENDSELECT
			;ここから賭け승리
			;パック賭け
			CASE 31
				PRINTFORMW 「クッソがぁ……！　オラ、持ってけドロボー！」
			;데이트賭け
			CASE 32
				PRINTFORMW 「ハッ！　『恐怖の大王』様を供回りとは、贅沢なご身分だなァ兄弟！」
			;パンツ賭け
			CASE 33
				PRINTFORMW 
			;お持ち帰り
			CASE 34
				PRINTFORMW 
			;下二桁３５は"モンスターか問い詰める"の분기
			;カード化（牝以外、選択肢無し）
			CASE 35
				PRINTFORMW 
			;カード化を見逃す（元気でな！）
			CASE 135
				PRINTFORMW 
			;穏便に話してカード化（怖くないよ～痛くないよ～）
			CASE 235
				PRINTFORMW 
			;身体を対価に見逃す（見逃すとは言ってない）
			CASE 335
				PRINTFORMW 
			;身体を対価に見逃す（見逃す）（패배버릇付いたり弱み握られたりする）
			CASE 435
				PRINTFORMW 
			;身体要求事後
			CASE 36
				PRINTFORMW 
			;闇のゲーム
			CASE 40
				PRINTFORMW 

			;ここから賭け패배
			;怒られた
			CASE 50
				PRINTFORMW 「ハン！　テメェがオレ様から何かを奪おうなんざ一億光年早いんだよォ！！」
			;パック賭け（パックを手渡す）
			CASE 51
				PRINTFORMW 「シャア！　……さぁて、レアカードは入ってるかねェ……っと♪」
			;데이트賭け（데이트はしてくれる）
			CASE 52
				PRINTFORML 「ハッ！　残念だったなァ！　
				PRINTFORMW 　まァオレ様を従えたいなんて無茶な野望に免じて、今日だけは付き合ってやるよ兄弟！」
			;カード化패배（逃げられた）
			CASE 55
				PRINTFORMW 
			;身体要求패배（金払う）
			CASE 56
				PRINTFORMW 
			;身体要求패배（弱味削除）
			CASE 156
				PRINTFORMW 
			;身体要求패배（패배버릇付いてる時限定凌辱おねだり）（ラブホ直行）
			CASE 256
				PRINTFORMW 
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

