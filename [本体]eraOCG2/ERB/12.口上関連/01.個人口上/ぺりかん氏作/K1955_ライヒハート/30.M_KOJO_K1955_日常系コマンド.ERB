;日常系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;300,会話
;TFLAG:SELECTCOM분기(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより교양が4以上高い)
;TCVAR:302(0=会話可能 1=非연모時会話不能)
;MARK:반발각인(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;CFLAG:우후후(조교中の会話)
;CFLAG:변기화(肉便器の時の会話)
;==================================================
@M_KOJO_SUCCESS_COM_K1955_300
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K1955_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で구상色が付きません。
CALL TRAIN_MESSAGE
;구상メイン呼出
CALL M_KOJO_MESSAGE_COM_K1955_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1955_300_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FIRSTTIME(SELECTCOM)
		PRINTFORMW 「おゥ、%CALLNAME:TARGET%だ。……アン？　短すぎる？　ってもよォ……」
		PRINTFORMW 「オレ様としちゃあ、強いヤツと戦えればいい、って気持ちだ。……戦えれば言葉なんていらねェ、だろ？」
		RETURN 1
	ENDIF
	;호감도修正、通常（연모系陥落なし）で５
	호감도修正 = 5
	;TARGETが【애처】だったら호감도修正に＋２
	SIF TALENT:TARGET:애처
		호감도修正 += 2
	;TARGETが【親愛】だったら호감도修正に＋２
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	;TARGETが【연모】を得ていたら호감도修正に＋１
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	;「RAND:n」n面ダイスを振る
	;우후후中の会話
	IF CFLAG:TARGET:우후후
		SELECTCASE RAND:3 + 1
			CASE 1
				PRINTFORMW 
			CASE 2
				PRINTFORMW 
			CASE 3
				PRINTFORMW 
		ENDSELECT
	;日常会話
	ELSE
		SELECTCASE RAND:7 + 1
			CASE 1
				IF TIME >= KANTAN_TIME(05,00) && TIME <= KANTAN_TIME(10,00)
					PRINTFORML 「おはようさん。意外とオメェ、朝起きれるんだな？」
					PRINTFORMW 「アン？　オレ様？　ハン、犬っころ共は早起きなんでね、オレ様も自然と早起きになっただけだ」
				ELSEIF TIME >= KANTAN_TIME(10,00) && TIME <= KANTAN_TIME(16,00)
					IF GET_WEATHER() == "快晴" || GET_WEATHER() == "晴れ" 
						PRINTFORML 「いい天気だなァ兄弟！　デュエルにはちょうどいいと思わねぇか！！」
						PRINTFORMW 「お、それとも走るか！？　カドショに行って武者修行もいいなァ！　ワクワクしねェか兄弟！！」
					ELSEIF GET_WEATHER() == "曇り"
						PRINTFORML 「……へっ、ライフォビアじゃ大体が曇天よ。むしろこの不穏を煽る空気がいいじゃねェか」
						PRINTFORMW 「ケケケ、どうせなら辻デュエルとでも行くかねェ？　『恐怖の大王』ココにあり、ってなァ！」
					ELSEIF GET_WEATHER() == "雨天"
						PRINTFORML 「……ったく、あんま濡れるのはよくねェな……。アイツらも雨が降るとすぐ木の陰に隠れようとしやがるんだ」
						PRINTFORMW 「第一、カードが濡れたらデュエルができねェ！　……アー、スリーブ、替えるか……」
					ELSEIF GET_WEATHER() == "豪雨" 
						PRINTFORML 「はっはァ！　どうせ降るならこれぐらい豪快に降ってくれねェとな！　不意打ちのため、豪雨に紛れて行軍した記憶が蘇るなァ！！」
						PRINTFORMW 「……んだよ？　なんだ雷がこえェのか？　ハッ！　お前隣にいるのは俺だぞ？　オレ様以上に怖いモノはねェから安心しろよォ！」
					ELSEIF GET_WEATHER() == "降雪" || GET_WEATHER() == "吹雪"
						PRINTFORML 「オイオイオイオイ……！　寒いとおもったら雪降ってるじゃねぇか……！　よっしゃ、雪合戦すんぞ！！」
						PRINTFORMW 「……なァに変な顔してやがんだよ、オラ行くぞー……雪かき？　んじゃあどっちが多く雪を除去るか勝負すッか！！」
					ENDIF
				ELSEIF TIME >= KANTAN_TIME(16,00) && TIME <= KANTAN_TIME(23,00)
					PRINTFORML 「へっへっへ……、夜は生き物が恐怖に怯える時間だぜ。つまりオレ様の時間ってコトだよなぁ！？」
					PRINTFORMW 「……ま、デュエルする상대がいないならしょうがねぇな。んじゃ덱構築考えるか。おい、何かアイディアよこせよ」
				ENDIF
			CASE 2
				PRINTFORMW 「おっ、オレ様の偉大なテーマ、スケアクローについて聞きてェのか？　よっしゃ教えてやるよ！」
				PRINTFORMW 「……つってもダラダラ話すのも性に合わねェな……？　オイ、何について聞きてェんだよ？」
				PRINTL
				PRINTFORMDL [0] - ……スケアクローってどんなテーマ？
				PRINTFORMDL [1] - ライフォビアってどんな世界？
				PRINTFORMDL [2] - なんで%CALLNAME:TARGET%以外はわんこしかいないの？
				PRINTFORMDL [3] - どうしてライトハートで急に縮んだの？
				BINPUT
				PRINTL
				IF RESULT == 0
					PRINTFORML 「ハァ！？　オレ様呼び出しといてスケアクロー知らねェってマジかよ！？　オレ様が恐怖に震えるぞソレ……」
					PRINTFORMW 「あのなァ、スケアクローは、オレ様の！　オレ様による！　オレ様のための！　イカしたテーマだ！！　링크소환、ってヤツで戦うテーマだな！」
					PRINTFORML 「まずはオレ様、
					SETCOLOR C_WOODS_G
					PRINTFORMW 『スケアクロー・ライヒハート』
					SETCOLOR C_FUSE_PUR
					PRINTFORM で必要な마법함정をかき集める！　んで링크１のオレ様、
					SETCOLOR C_WOODS_G
					PRINTFORM 『ライトハート』
					SETCOLOR C_FUSE_PUR
					PRINTFORM で世壊は
					SETCOLOR C_WOODS_G
					PRINTFORM 『ライフォビア』
					SETCOLOR C_FUSE_PUR
					PRINTFORMW に出来る！！」
					PRINTFORM 「『ライフォビア』に世壊がなったら、その時に好きなスケアクローを持ってこれる！　そこからなんやかんやして切り札の링크３、
					SETCOLOR C_WOODS_G
					PRINTFORM 『トライヒハート』
					SETCOLOR C_FUSE_PUR
					PRINTFORML でぶん殴る！！」
					PRINTFORMW 「下僕の犬っころ共は戦えないが、オレ様に力を差し出すことで無敵の『トライヒハート』サマが完成するってわけだ！　どうだ！　面白そうだろ！？」
				ELSEIF RESULT == 1
					PRINTFORM 「
					SETCOLOR C_WOODS_G
					PRINTFORM 『肆世壊-ライフォビア』
					SETCOLOR C_FUSE_PUR
					PRINTFORML か……壱があのナヨ野郎なのがムカつくが、肆≒死ってのはいいな！　オレ様は『恐怖の大王』だからな！！」
					PRINTFORMW 「ま、この世壊とは真逆の、平和とか平穏とかとは程遠い世壊だわなァ……。そもそも이성ある生き物がオレ様と躾けた下僕の犬っころぐらいだろうからなァ！！」
					PRINTFORM 「しかもクソ赤侵略者……
					SETCOLOR C_D_RED
					PRINTFORM 『クシャトリラ』
					SETCOLOR C_FUSE_PUR
					PRINTFORMW の奴らが定期的に襲ってきやがる……。ま、観光目的で来るのはオススメしねェなァ！！」
				ELSEIF RESULT == 2
					PRINTFORML 「そもそもライフォビアにまともな動物がいねェよ！　이성があるのがかろうじてオレ様ぐらいだなァ……。あとは暴力と恐怖で굴복させたってトコだァ」
					PRINTFORMW 「そん中でも最後まで噛みついてきやがった三匹を下僕にして従えてるってのが実情だわな！　おっと気をつけろよ？　アイツラ意外と執念深いからなァ！！」				
				ELSEIF RESULT == 3
					PRINTFORM 「あー……。オレ様は相棒……
					SETCOLOR C_SILVER
					PRINTFORM 『ヴィサス・スタフロスト』
					SETCOLOR C_FUSE_PUR
					PRINTFORML から分かたれた存在、ってのは知ってるか？」
					PRINTFORML 「相棒にブチのめされたオレ様は弱肉強食、つまり敗者として総取りされたわけだ……。ところがよ！　相棒にとっても初めての捕食だったから食い残しが出ちまったんだなァ、これが」
					PRINTFORM 「つまりそれがこの
					SETCOLOR C_WOODS_G
					PRINTFORM 『スケアクロー・ライトハート』
					SETCOLOR C_FUSE_PUR
					PRINTFORMW ってわけだァ！　まァオレ様がいなけりゃあのポヤポヤはどっかで躓いていただろうし、つまりオレ様最強！　有能！　ってコトだな！！」
				ENDIF
			CASE 3
				PRINTFORMW 「アン？　他の世壊についても知りたい？　しゃーねェなァ、オイ、こんど上手い飯奢れよ？」
				PRINTFORMW 「……んじゃあ気になるヤツの名前あげろや。おっと一人だけにしてくれよ？　他人についてくっちゃべるなんてオレ様の캐릭터じゃねェからよォ！」
				PRINTL
				PRINTFORMDL [0] - スケアクロー・ライヒハート
				PRINTFORMDL [1] - ティアラメンツ・レイノハート
				PRINTFORMDL [2] - クシャトリラ・ライズハート
				PRINTFORMDL [3] - マナドゥム・リウムハート
				PRINTFORMDL [4] - ……ヴィサス・スタフロスト
				BINPUT
				PRINTL
				IF RESULT == 0
					PRINTFORML 「ンだよオレ様の話かよ！　オマエ、オレ様のこと好きすぎるんじゃねェのかァ！　いいぜ、教えてやるよ！！」
					PRINTFORM 「オレ様は
					SETCOLOR C_WOODS_G
					PRINTFORM 『%CALLNAME:TARGET%』
					SETCOLOR C_FUSE_PUR
					PRINTFORM ！　『恐怖』の具現化！　
					SETCOLOR C_WOODS_G
					PRINTFORM 『ライフォビア』
					SETCOLOR C_FUSE_PUR
					PRINTFORM の偉大なる大王！　そして相棒の
					SETCOLOR C_SILVER
					PRINTFORM 『ヴィサス』
					SETCOLOR C_FUSE_PUR
					PRINTFORMW を何度も助けた頼れる漢よォ！！」
					PRINTFORMW 「好きなモノは暴力！　喧嘩も好きだぜ！　逆に煮え切らないヤツは嫌いだな！　スカッと殴ってオレ様最強！　これが一番だろォ？　ま、ボディガードぐらいはやってやるぜ、ヨロシクなァ！」
				ELSEIF RESULT == 1
					PRINTFORM 「あぁ、ナヨ野郎か……悪口じゃねェよ！？　アイツの本性
					SETCOLOR C_WATER_T
					PRINTFORM 『ティアラメンツ・カレイドハート』
					SETCOLOR C_FUSE_PUR
					PRINTFORML を見ろよどう見てもタコみてェにブヨブヨナヨナヨしてんだろォが！」
					PRINTFORMW 「よく考えたらアイツも真珠を集めてた理由よくわかんねェなァ……？　まァどうせロクでもねェ理由だったんだろ！　オンナを泣かせて操って戦わせるクソだしなァ！！」
					PRINTFORMW 「……しっかしどういうコトだ？　オレ様が知る限りアイツの力を
					SETCOLOR C_WATER_T
					PRINTFORM キトカロスの嬢ちゃん
					SETCOLOR C_FUSE_PUR
					PRINTFORM や
					SETCOLOR C_WATER_T
					PRINTFORM キツい目の嬢ちゃん
					SETCOLOR C_FUSE_PUR
					PRINTFORMW が奪った、なんてコト知らねェんだが……ま、どっかでヘマしたんだろうな！」
				ELSEIF RESULT == 2
					PRINTFORM 「……あァ、あのクソ忌々しい侵略者どもの元締め……
					SETCOLOR C_D_RED
					PRINTFORM 『クシャトリラ・ライズハート』
					SETCOLOR C_FUSE_PUR
					PRINTFORM か……。アイツぜッてェ許さねェ……！　勝手にオレ様の世壊を
					SETCOLOR C_D_RED
					PRINTFORM 『パライゾス』
					SETCOLOR C_FUSE_PUR
					PRINTFORML に改造しやがって……！」
					PRINTFORM 「……とはいえ、気持ちは分かるんだよな忌々しいことに。あいつは『분노』だからな、자신が
					SETCOLOR C_SILVER
					PRINTFORM 『ヴィサス』
					SETCOLOR C_FUSE_PUR
					PRINTFORMW のパチモンだなんて、ンな事実を認められねェ……。手腕も執念もまァ、敵ながらアッパレ、だ」
					PRINTFORMW 「だがしかァし！！　あくまでオレ様は『ライトハート』だった時に不意をつかれただけだ！！　次あったらギッタンギッタンにしてやるよォ！！」
				ELSEIF RESULT == 3
					PRINTFORM 「
					SETCOLOR C_YELLOW_2
					PRINTFORM 『マナドゥム・リウムハート』
					SETCOLOR C_FUSE_PUR
					PRINTFORM ……オレ様、コイツとだけは関わりがねェんだよなァ……。そもそも
					SETCOLOR C_YELLOW_2
					PRINTFORM 『カラリウム』
					SETCOLOR C_FUSE_PUR
					PRINTFORML なんて世壊、聞いたこともねェよ」
					PRINTFORMW 「とはいえ、コイツが相棒の暴走を止めてくれたことは事実だ……。へッ、こんな穏やかな顔しといて、中々どうしてやるじゃねェか……！」
					PRINTFORMW 「どうせならオレ様も殺りあいたかったがなァ……。こういう手合はノラリクラリと避けられちまうんだよなァ……。いやしかし、惜しいぜ……」
				ELSEIF RESULT == 4
					PRINTFORM 「……ハッ！　オレ様の相棒、
					SETCOLOR C_SILVER
					PRINTFORM 『ヴィサス・スタフロスト』
					SETCOLOR C_FUSE_PUR
					PRINTFORMW についてはオメェのほうがよっぽど詳しいだろうさ！　何せオレ様はアイツの旅の前半しか付き合えなかったからなァ……」
					PRINTFORML 「まァ、でも……アイツは最初から、よくわからねェ男だったよ……。オレ様を突然ワンパンでぶっ潰したと思ったら、『ティアラメンツ』の嬢ちゃん達に義理もないのに味方して……」
					PRINTFORMW 「思えばアイツはポヤポヤしてる割に頑固だったなァ……そんなヤツとの旅は、そうだな……悪くなかった。あァ、そうだな！　結構楽しかったなァ！！！」
				ENDIF
			CASE 4
				PRINTFORML 「おう、暇か？　暇ならデュエルしようぜ！　へへ、命が絡まない殺り合いなんて退屈かと思ったけどよ、中々どうして楽しいじゃねェか！」
				PRINTFORMW 「何せ体格とかじゃどいつが強者かわからねェ！　つまりこの世壊全員が強者になりうる可能性があるってこった！！　へへ、こりゃあいつまでも飽きるこたァねェや……！」
			CASE 5
				PRINTFORML 「……アン？　なにしてるって、……スリーブがボロボロだからなァ、交換してんだよ」
				PRINTFORMW 「意外か？　オレ様は言葉も通じねェ犬っころを、순종な兵士になるまで鍛え上げた漢だぜ？　それに武器の手入れは基本だろうがァ？」
			CASE 6
				PRINTFORMW 「なんかオレ様の덱を強くするカードとかねェかなァ……。オイ、テメェ、なんか相談のれよ？」
			CASE 7
				PRINTFORML 「この世壊、飯もうめぇし、いつでもデュエルできるし最高だな！」
				PRINTFORMW 「ただなァ……たまに本気の命のやり取りが恋しくなるんだよなァ……」
			CASE 8
				PRINTFORML 「……オレ様たちがこの先どうなったか？　知らねェよ。オレ様が相棒の旅路を全部知らねェように、オメェも知らねェオレ様たちの物語があんだよ」
				PRINTFORMW 「へへ、気になるか？　気になるならちからづくで話させて見ろやァ！！」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
