;※※※※※※※※※※※※※※※※※※※※※※※※※
;CARD用구상
;※※※※※※※※※※※※※※※※※※※※※※※※※
;直接カードのIDを使える。
;캐릭터が無くても動く
;存在証明
@M_KOJO_CARD_K1955
RETURN 1
;==================================================
;0,モンスター소환時
;==================================================
@M_KOJO_CARD_K1955_0(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「이 몸、필드에 등장！！」
ENDIF

;==================================================
;1,攻撃時
;==================================================
@M_KOJO_CARD_K1955_1(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「핫！　이 몸을 너무 얕본 거 아니냐！」
ENDIF

;==================================================
;2,효과발동
;==================================================
;효과別で鳴らしたいなら、直接カードのデータを見て、설정する必要がある
;面倒、分からないであれば분기はせず
;失敗판정は、いわゆる효과를 無効にされたとかそういうやつ
@M_KOJO_CARD_K1955_2(종류,失敗판정)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 종류
#DIM DYNAMIC 失敗판정
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 失敗판정 == 0
		IF GROUPMATCH(종류,소환時 ,특수소환時)
			PRINTFORMW 「이걸로 승리를 거머쥐어 주마！」
		ELSE
			PRINTFORMW 「헤헷、이 몸이 간다！」
		ENDIF
	ELSE
		PRINTFORMW 「제길……！」
	ENDIF
ENDIF

;==================================================
;3,除去時
;==================================================
;いちいちなんでも除去で話すとやかましいため、デフォでは破壊にのみ反応するように설정
@M_KOJO_CARD_K1955_3(除去종류,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 除去종류
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 除去종류
	CASE 破壊行き
		PRINTFORMW 
	ENDSELECT
ENDIF

