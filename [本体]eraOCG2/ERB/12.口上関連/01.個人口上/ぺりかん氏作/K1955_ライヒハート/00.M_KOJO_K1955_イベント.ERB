;==================================================
;帰宅時/外出時
;==================================================
@M_KOJO_EVENT_K1955_11(ARG,ARG:1)
;구상主はLOCALS or RESULT
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 0
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;MASTER通常帰宅
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTER仕事・学校終わり帰宅
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:TARGET:연모 > 0
			PRINTFORMW 
		ELSE
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;一緒に데이트중帰宅
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:TARGET:연모 > 0
			PRINTFORMW 
		ELSE
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;캐릭터が外出から帰宅する
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;캐릭터がバイトから帰宅する
	;（来訪캐릭터のみ,自宅が無い캐릭터でも発生します）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;家に訪問してくる
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	;訪問してくる
	IF LOCAL:1 && ARG == 5 && ARG:1 == 0
		RETURN 1
	;「はい」を選択
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 1
		RETURN 1
	;「いいえ」を選択
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 2
		RETURN 1
	;手が離せない状態で、帰ってくれる
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 3
		RETURN 1
	;手が離せない状態で、入ってきた
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 4
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;眠いのでカード/家へ帰る
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6 && ARG:1 == 0
		RETURN 1
	ELSEIF LOCAL:1 && ARG == 6 && ARG:1 == 1
		RETURN 1
	ENDIF
