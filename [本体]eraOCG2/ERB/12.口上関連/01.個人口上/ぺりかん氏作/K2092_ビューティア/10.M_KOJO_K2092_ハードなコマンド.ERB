#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
			PRINTFORMW 「えっ！？　わ、私っ❤　なにかっ❤　粗相をぉ❤　してしまった❤　かしらっ❤」
		ELSE
			PRINTFORMW 「なっ！？　や、やめなさい……っ！」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
				PRINTFORMW 「わ、私っ❤　何かっ❤　気を損ねるようなことをしたかしらっ❤」
			ELSE
				PRINTFORMW 「な、なんでぇ……！？」
			ENDIF
		CASE 2
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
				PRINTFORMW 「ご、ごめんなさいっ❤　%CSTR:TARGET:MASCALL%がぶつぐらいですものっ❤　きっと私が悪いのでしょうっ❤」
			ELSE
				PRINTFORMW 「やめ、やめなさい……っ！？　な、なにか悪いことしたかしらっ！？」
			ENDIF
		CASE 3
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
				PRINTFORMW 「い、痛いっ❤　で、でも……っ❤　それで%CSTR:TARGET:MASCALL%の気が済むなら……❤　もっと、ぶってぇ……❤」
			ELSE
				PRINTFORMW 「や、やめて……っ」
			ENDIF
		CASE 4
			PRINTFORMW 「わ、私は悪い子ですっ❤　%CSTR:TARGET:MASCALL%の분노を受け止めますっ❤　気が済むまで、叩いて頂戴っ❤」
		CASE 5
			PRINTFORMW 「あぁ……❤　お尻に、痕がついちゃった……❤　こんなの見られたら、みんなわかっちゃう……❤　私が、%CSTR:TARGET:MASCALL%のモノだって……❤」
	ENDSELECT
ENDIF
RETURN 1

