;==================================================
;153,콘돔を買いに行かせる
;流れるタイミングは買った後
;==================================================
@M_KOJO_MESSAGE_COM_K2092_153
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2092_153_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2092_153_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「買ってきたわ……うぅ、もうあのお店にいけないわ……」
		RETURN 1
	ENDIF
	;基本セット
	IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「はい、約束の콘돔……❤　そうそう、店員さんが普段顔を合わせる方でね……❤　二度見、されちゃったわ……❤」
			CASE 1
				PRINTFORMW 「すぐに使うのでテープで結構です、って言ったの……❤　次からあの店に、どんな顔して行けばいいのでしょうね……❤」
			CASE 2
				PRINTFORMW 「ねぇ、今度一緒に買いに行きましょうね……❤　私の肩を、お尻を、おっぱいを揉んで……❤　%CSTR:TARGET:MASCALL%のメスってアピールしてほしいの……❤」
		ENDSELECT
	ELSE
		PRINTFORMW 「……絶対、顔を覚えられたわ……は、恥ずかしい……っ」
	ENDIF
ENDIF
RETURN 1

;==================================================
;154,リミッター解除
;가슴사이즈は元々の大きさ（リミ解使用前）を参照
;==================================================
@M_KOJO_MESSAGE_COM_K2092_154
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2092_154_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2092_154_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「きゃあ！？　な、なに……っ！？」
		RETURN 1
	ENDIF
	;基本セット
	SELECTCASE TALENT:TARGET:가슴사이즈 
		;ひんぬー
		CASE -2,-1,0
			PRINTFORMW 
		;普通と爆乳
		CASE 1,2
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
			PRINTFORML 「欲張りさんね……❤　私のおっぱいじゃ足りなかったの、かしら……❤」
			PRINTFORMW 「だったら普段から私のおっぱいにかまってあげて……❤　そうしたらこんなに大きくなってしまうかも、しれないわよ……❤」
			ELSE
			PRINTFORMW 「ううう……こんなに大きくなっちゃったらますます肩こりが……」
			ENDIF
		;泣いていいよ
		CASE -3
			PRINTFORMW 
		;ウシ
		CASE 3
			PRINTFORMW 「%CSTR:TARGET:MASCALL%のエッチ……❤　おっぱい星人……❤」
	ENDSELECT
ENDIF
RETURN 1
