;==================================================
;0,デュエルスタート！
;==================================================
@M_KOJO_DUEL_K2092_0(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「ドレミコード、開演……お상대、よろしくお願いしますね……♪」
		CASE 2
			PRINTFORMW 「ようこそお越しくださいましたお客様……ここからは『시도레미코드 뷰티아』のデュエルにお付き合いいただきます……なんてね♪」
		CASE 3
			PRINTFORMW 「ふふ、あなたとのデュエルではどんな音色が生まれるのかしら……楽しみね♪」
	ENDSELECT
ENDIF

;==================================================
;1,モンスター소환
;例：%カード名%を소환！
;==================================================
@M_KOJO_DUEL_K2092_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF GROUPMATCH(カードID,2086,2087,2089,2094)
		PRINTFORMW 「%カード名%ちゃん、お願いしますね♪」
	ELSEIF カードID == 2088
		PRINTFORMW 「大丈夫、自信を持って……%カード名%ちゃん、出番ですよ♪」
	ELSEIF カードID == 12085
		PRINTFORMW 「ふふ♪　今日もみんなを導いてください、ね？　%カード名%ちゃん、よろしくお願いします♪」
	ELSE
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「%カード名%ちゃん、소환しますね？」
		CASE 2
			PRINTFORMW 「ふふ、お姉さんを助けてくれるかしら、%カード名%ちゃん♪」
		CASE 3
			PRINTFORMW 「%カード名%ちゃんを소환、いいかしら？」
	ENDSELECT
	ENDIF
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_KOJO_DUEL_K2092_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 소환出処
		;패에서 
		CASE 召種손패
			IF GROUPMATCH(カードID,2085,2086,2087,2088,2089,2090,2091,2092,2094,12085)		
				PRINTFORM 「
				SETCOLOR C_FIRE_T
				PRINTFORM 揺れなさい、魂震わすタクト！　奏でましょう、
				SETCOLOR C_M_GREEN
				PRINTFORM 光のシンフォニー！　펜듈럼소환！
				SETCOLOR C_WATER_T
				PRINTFORMW 」
				IF カードID == 2086
					PRINTFORMW 「ドーナツ食べ過ぎたらダメだからね♪　%カード名%ちゃん、出番よ♪」
				ELSEIF カードID == 2087
					PRINTFORMW 「レモンの香り、お姉さん好きだわ♪　%カード名%ちゃん、出番よ♪」
				ELSEIF カードID == 2088
					PRINTFORMW 「大丈夫、みんなあなたの力を信じてる……。%カード名%ちゃん、出番よ♪」
				ELSEIF カードID == 2089
					PRINTFORMW 「今日も元気いっぱいね♪　%カード名%ちゃん、出番よ♪」	
				ELSEIF カードID == 2094
					PRINTFORMW 「ふふ♪　お姉さんに練習の成果、見せてね♪　%カード名%ちゃん、出番よ♪」			
				ELSEIF カードID == 2090
					PRINTFORMW 「空まで響け、サックスの音色♪　%カード名%ちゃん、先輩を助けてくれるかしら♪」
				ELSEIF カードID == 2091
					PRINTFORMW 「いつも華やか、天使のラッパ♪　%カード名%ちゃん、いきましょうか♪」
				ELSEIF カードID == 2092
					PRINTFORMW 「さぁ、みんなに幸せとどけるわ……！　お姉さん、いっちゃうわよ……♪」
				ELSEIF カードID == 2085
					PRINTFORMW 「ふふ♪　あなたはいつも通り、クールねぇ……！　%カード名%、あなたの花道、空けておいたわよ……！」
				ELSEIF カードID == 12085
					PRINTFORMW 「妖精さん、お願いね……♪　%カード名%ちゃん、いきましょう……♪」
				ELSE
					PRINTFORMW 「패에서 、%カード名%ちゃんを呼ぶわね♪」
				ENDIF
			ENDIF
		;마법함정ゾーンから。　キリ番・シェイプシスターなどを出す場合
		CASE 召種마함
			IF GROUPMATCH(カードID,2085,2086,2087,2088,2089,2090,2091,2092,2094,12085)		
				PRINTFORMW 「みんなを裏方で終わらせないわ♪　%カード名%をスポットライトの先へ♪」
			ELSE
				PRINTFORMW 「마법함정ゾーンから%カード名%ちゃんを특수소환、いいわよね？」
			ENDIF
