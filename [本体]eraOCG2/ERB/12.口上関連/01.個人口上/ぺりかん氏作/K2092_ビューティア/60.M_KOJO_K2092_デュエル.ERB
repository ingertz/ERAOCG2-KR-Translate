						SETCOLOR C_WATER_T
						PRINTFORML ……ふふ♪　これはどうかしら？
						PRINTFORM 　%カード名%を발동♪　우후후、%CSTR:TARGET:MASCALL%もビッ
						CALL XON_FONT("クリしてるみたいね……,溶❤1",C_PINK)
						PRINTFORMW 」					
						RESETCOLOR						
					CASE 1
						PRINTFORM 「
						CALL XON_FONT("──√￣……ハイ、ワカリマシタ……,壊❤",C_PINK)
						SETCOLOR C_WATER_T
						PRINTFORML ……お姉さんの本気、みせましょうか……♪
						PRINTFORM 　%カード名%を使わせてもらうわね♪　あ
						CALL XON_FONT("らあら、予想外だった、かしら？　……우후후,溶❤1",C_PINK)
						PRINTFORMW 」
						RESETCOLOR						
					CASE 2
						PRINTFORM 「
						CALL XON_FONT("──√￣……ハイ、ワカリマシタ……,壊❤",C_PINK)
						SETCOLOR C_WATER_T
						PRINTFORML ……패에서 、마법カード、
						PRINTFORM 　%カード名%を발동するわ！　우후후、チェー
						CALL XON_FONT("ンはないのかしら、ならこのままいくわね……,溶❤1",C_PINK)
						PRINTFORMW 」
						RESETCOLOR						
				ENDSELECT
			ELSEIF GROUPMATCH(カードID,79853,79854,79855,79857)
				SELECTCASE RAND:3
					CASE 0
					SETCOLOR C_PINK
						PRINTFORM 「──√￣……%CALLNAME:TARGET%、
						CALL XON_FONT("リョウカイ……,壊❤",C_PINK)
						SETCOLOR C_WATER_T
						PRINTFORML ……ふふっ、%CSTR:TARGET:MASCALL%を驚かせてあげるわ
						PRINTFORM 　%カード名%を패에서 발동！　상대に奉
						CALL XON_FONT("仕することができる、禁止制限ギリギリの효과よ♪　耐えられるかしら……,溶❤1",C_PINK)
						PRINTFORMW 」
						RESETCOLOR						
					CASE 1
						SETCOLOR C_PINK
						PRINTFORM 「──√￣……%CALLNAME:TARGET%、
						CALL XON_FONT("リョウカイ……,壊❤",C_PINK)
						SETCOLOR C_WATER_T
						PRINTFORML ……さて、이 카드를 使わせてもらうわね？
						PRINTFORM 　%カード名%を使用するわね……？　このカードにより、%CSTR:TARGET:MASCALL%
						CALL XON_FONT("は私の、奉仕攻撃を受けなければダメ♪　우후후、どう対処するのかしら……,溶❤1",C_PINK)
						PRINTFORMW 」
						RESETCOLOR						
					CASE 2
						SETCOLOR C_PINK
						PRINTFORM 「──√￣……%CALLNAME:TARGET%、
						CALL XON_FONT("リョウカイ……,壊❤",C_PINK)
						SETCOLOR C_WATER_T
						PRINTFORML ……ドレミコードの奥の手を使います……！
						PRINTFORM 　ドレミコード・%カード名%！　ふふっ♪　ドレミコードに伝わ
						CALL XON_FONT("る秘密の力で、私は奉仕によるダイレクトアタックが可能よ……,溶❤1",C_PINK)
						PRINTFORMW 」
						RESETCOLOR						
				ENDSELECT
			ELSEIF GROUPMATCH(カードID,2085,2086,2087,2088,2089,2090,2091,2092,2094,12085)
				PRINTFORMW 「우후후♪　손패より%カード名%を펜듈럼スケールにセッティング、するわね……！」
			ELSEIF カードID == 62088
				PRINTFORMW 「幸せの多重奏、みんなに届けてあげるわね？　響け！　%カード名%！！」
			ELSE
			PRINTFORMW 「손패より、%カード名%を발동するわ♪」
			ENDIF
		CASE 2
			;필드발동
			;필드발동
			IF カードID == 2086
				PRINTFORMW 「%カード名%ちゃん、おねがいね♪　さぁハーモニカの音色に誘われて、みんなを呼ばせてもらうわ……！」
			ELSEIF カードID == 2090
				PRINTFORMW 「%カード名%ちゃんの효과를 발동、サックスの音色、덱まで響け……！」
			ELSE
				PRINTFORMW 「%カード名%ちゃんの효과、발동するわね……♪」
			ENDIF
		CASE 3
			;마함발동
			;마함발동
			IF GROUPMATCH(カードID,2085,2086,2087,2088,2089,2090,2091,2092,2094,12085)
				PRINTFORMW 「さぁ、開演するわよ！　ドレミコード、出演の時間よ……！」
			ELSE
				PRINTFORMW 「ここで……！　%カード名%발동するわね」
			ENDIF
		CASE 4
			;묘지발동
			PRINTFORMW 「묘지에서 %カード名%발동！　……ふふ、驚いたかしら？」
	ENDSELECT
ENDIF



