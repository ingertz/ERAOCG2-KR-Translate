				PRINTFORMW 「덱에서 %カード名%ちゃん、よろしくね？」
			ENDIF
		;EX덱에서 
		CASE 召種EX덱
			IF GROUPMATCH(カードID,2085,2086,2087,2088,2089,2090,2091,2092,2094,12085)		
				PRINTFORM 「
				SETCOLOR C_FIRE_T
				PRINTFORM 揺れなさい、魂震わすタクト！　奏でましょう、
				SETCOLOR C_M_GREEN
				PRINTFORM 光のシンフォニー！　펜듈럼소환！
				SETCOLOR C_WATER_T
				PRINTFORMW 」
				IF カードID == 2086
					PRINTFORMW 「ドーナツ食べ過ぎたらダメだからね♪　%カード名%ちゃん、出番よ♪」
				ELSEIF カードID == 2087
					PRINTFORMW 「レモンの香り、お姉さん好きだわ♪　%カード名%ちゃん、出番よ♪」
				ELSEIF カードID == 2088
					PRINTFORMW 「大丈夫、みんなあなたの力を信じてる……。%カード名%ちゃん、出番よ♪」
				ELSEIF カードID == 2089
					PRINTFORMW 「今日も元気いっぱいね♪　%カード名%ちゃん、出番よ♪」	
				ELSEIF カードID == 2094
					PRINTFORMW 「ふふ♪　お姉さんに練習の成果、見せてね♪　%カード名%ちゃん、出番よ♪」			
				ELSEIF カードID == 2090
					PRINTFORMW 「空まで響け、サックスの音色♪　%カード名%ちゃん、先輩を助けてくれるかしら♪」
				ELSEIF カードID == 2091
					PRINTFORMW 「いつも華やか、天使のラッパ♪　%カード名%ちゃん、いきましょうか♪」
				ELSEIF カードID == 2092
					PRINTFORMW 「さぁ、みんなに幸せとどけるわ……！　お姉さん、いっちゃうわよ……♪」
				ELSEIF カードID == 2085
					PRINTFORMW 「ふふ♪　あなたはいつも通り、クールねぇ……！　%カード名%、あなたの花道、空けておいたわよ……！」
				ELSEIF カードID == 12085
					PRINTFORMW 「妖精さん、お願いね……♪　%カード名%ちゃん、いきましょう……♪」
				ELSEIF カードID == 2093
				PRINTFORML 「天上より響き渡れ、世界を癒すシンフォニー！」
				PRINTFORMW 「さぁ、おいで下さいませ、%カード名%！！」
				ELSEIF カードID == 42085
				PRINTFORML 「天上より響き渡れ、世界を癒すシンフォニー！」
				PRINTFORMW 「ふふ、主役は華やかにいかないと、ね？　%カード名%、いきましょうか♪」
				ELSE
					PRINTFORMW 「EX덱에서 、%カード名%ちゃん、出番よ♪」
				ENDIF
			ENDIF
		;묘지에서 
		CASE 召種묘지
			PRINTFORMW 「묘지でお眠のところ、悪いわね……%カード名%ちゃん、朝ですよ～♪」
		;제외状態から
		CASE 召種제외
			PRINTFORMW 「ふふ♪　私達の歌、世界のハザマにも届くのね……。제외されていた%カード名%ちゃんを呼び出すわね♪」
		;主にトークン生成
		CASE 10
			PRINTFORMW 「あらあら、トークンが특수 소환된 わ♪」
	ENDSELECT
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K2092_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORMW 「ふふ♪　こんな의식はどうかしら♪　%カード名%ちゃんを의식소환、するわね？」
		CASE 융합
			PRINTFORMW 「우후후、お姉さん、융합소환をやってみるわね？　%カード名%ちゃん、出番よー♪」
		CASE 싱크로
			PRINTFORMW 「チューニング、お願いするわ？　%カード名%ちゃん、싱크로소환ー♪」
		CASE 엑시즈
			PRINTFORMW 「音と音を重ねて……엑시즈소환！　%カード名%ちゃん、いけるかしら♪」
		CASE 링크
			IF カードID == 2093
				PRINTFORMW 「かくも麗しき女神様、我々の演奏に導かれどうかおいでくださいな。링크소환！　%カード名%、光臨！」
			ELSEIF カードID == 42085
				PRINTFORMW 「링크소환！　クーリア、いくわよ……！　%カード名%、さぁ主役の開演よ！」
			ELSEIF カードID == 1131
				PRINTFORMW 「さぁ、スペシャルゲストに登場していただきましょうか♪　%カード名%、いきましょう……！」
			ELSE
			PRINTFORMW 「音と音とを링크して、紡ぎ出すは新たなハーモニー！　링크소환！　%カード名%ちゃん、いきましょうか♪」
			ENDIF
		;초차원モンスター（デュエマ）
		CASE 초차원
			PRINTFORMW 「ふふ♪　お姉さん、초차원にも演奏が届いてるなんて嬉しくなっちゃう♪　さぁ%カード名%ちゃん、その力、見せてちょうだい、ね♪」
	ENDSELECT
ENDIF

;==================================================
;4,효과使用宣言
;==================================================
@M_KOJO_DUEL_K2092_4(カードID,발동出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC 발동出処
