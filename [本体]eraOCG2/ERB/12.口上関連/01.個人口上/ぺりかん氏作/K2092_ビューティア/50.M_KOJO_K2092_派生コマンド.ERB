;==================================================
;5,수음펠라
;==================================================
@M_KOJO_MESSAGE_SCOM_K2092_5
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2092_5_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2092_5_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
			PRINTFORML 「あらあら……❤　『ママ』の수음だけじゃ、펠라치오だけじゃ만족できなくなっちゃった……？　ワガママさんねぇ……❤」
			PRINTFORMW 「ふふ……❤　こう、かしら……❤　あらあら、おチンチンがさっきより硬くなってきた気がするわね……❤」
		ELSE
			PRINTFORMW 「こ、今度は手と口、同時にしてほしい……？　はぁ……ドンドン要求がヒートアップしてないかしら？」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
		SELECTCASE RAND:3
			CASE 0
				IF ABL:TARGET:혀 > 2 && ABL:TARGET:손가락 > 2
					PRINTFORML 「ぐぽっ❤　ぐぽっ❤　ふふっ、どうかしら❤　『ママ』の수음と펠라、同時奉仕は……❤　ふふ、気持ちよさそうで嬉しいわ……❤」
					PRINTFORMW 「もちろん、まだ終わりじゃないわ……❤　%CSTR:TARGET:MASCALL%にたくさん사정してほしくてここまで頑張ったんだから……❤　ぐぽっ❤　ぐちゅっ❤」
				ELSEIF ABL:TARGET:혀 > 2
					PRINTFORML 「何度も何度もしてるうちに『ママ』の舌、%CSTR:TARGET:MASCALL%のおチンチンを만족させられるようになってきたでしょう……❤」
					PRINTFORMW 「ふふ……❤　そのうち完璧な수음펠라を披露してみせるわ……❤　いっぱい사정してもらえるよう、『ママ』頑張るからね……❤」
				ELSEIF ABL:TARGET:손가락 > 2
					PRINTFORML 「ふふっ……❤　『ママ』の指さばき、いかがかしら……❤　まだまだ펠라は下手だけど、こっちはハープやってた경험があるからね……❤」
					PRINTFORMW 「そのうち、口と同時に%CSTR:TARGET:MASCALL%をイカせてみせるから……❤　その時を楽しみにしてて、ね……❤」
				ELSE
					PRINTFORMW 「んんっ……指に集中すると口が、舌に集中すると手がおろそかになっちゃうわね……期待に応えられないダメな『ママ』でゴメンね……」
				ENDIF
			CASE 1
				IF ABL:TARGET:Ｍ감각 > 2 && ABL:TARGET:정액중독 > 2
					PRINTFORML 「あふっ❤　ああっ❤　あひぃ❤　『ママ』の口の中に%CSTR:TARGET:MASCALL%のおチンチンがいっぱいぃぃ……❤」
					PRINTFORMW 「鈴口からザーメンの香りが匂い立つわぁ……❤　いっぱい사정して❤　『ママ』の口を%CSTR:TARGET:MASCALL%の精子で凌辱してぇ❤」
				ELSEIF ABL:TARGET:정액중독 > 2
					PRINTFORMW 「はやく❤　はやく『ママ』の口に사정して❤　%CSTR:TARGET:MASCALL%のザーメンを『ママ』味わいたいの❤」
				ELSEIF ABL:TARGET:Ｍ감각 > 2
					PRINTFORMW 「んふっ❤　おチンチンの感触を確かめるたび、『ママ』感じちゃってるわ……❤　はしたない『ママ』でごめんなさいね……❤」
				ELSE
					PRINTFORMW 「私のことは気にしないでね……❤　%CSTR:TARGET:MASCALL%はおチンチンへの奉仕に集中して、ね……❤」
				ENDIF
			CASE 2
				IF TCVAR:MASTER:전턴절정 == 1
					PRINTFORML 「いっぱい사정したわね……❤　ふふ、このままじゃあ汚いから、キレイキレイしましょうねぇ……❤」
					PRINTFORMW 「『ママ』のお手々でいっぱい拭き拭きして❤　『ママ』のお口でいっぱいペロペロして❤　%CSTR:TARGET:MASCALL%のおチンチン、キレイキレイなったかな～……❤　ふふっ❤」
				ELSEIF BASE:MASTER:발기 >= 1350
					PRINTFORML 「あらあら……❤　なんて立派なおチンチンなんでしょう……❤　『ママ』ビックリしちゃったわ……❤　濡れてきちゃう……❤」
					PRINTFORMW 「もう……❤　暴れん坊ねぇ……❤　そんなおチンチンには、えいっ❤　ぐぽっ❤　ぐぽっ❤　『ママ』の수음펠라、どうかしら……❤　%CSTR:TARGET:MASCALL%のおチンチンのほうが正直ね……❤」
				ELSEIF BASE:MASTER:발기 >= 600 && BASE:MASTER:발기 < 1350 
					PRINTFORML 「우후후……❤　だんだん발기してきてお利口さんなおチンチンね……❤　とってもいい子で『ママ』嬉しいわ……❤」
					PRINTFORMW 「わかるかしら、指が金玉をモミモミしているのが……❤　わかるわよね、舌がカリ首をナメナメしているのが……❤　ふふ、精子がグツグツ、作られてるわね……❤」
				ELSEIF BASE:MASTER:발기 < 600
					PRINTFORML 「大丈夫ですよ……❤　『ママ』がすぐ元気にしてあげますからね……❤　すぐに발기させてあげますからね……❤」
					PRINTFORMW 「우후후、どうかしら……❤　『ママ』の指がおチンチンをしごいてますね……❤　このまま『ママ』のお口で暖めてあげますからね……❤」 
				ENDIF
		ENDSELECT
		RETURN 1

	;それ以外
	ELSE
		PRINTFORMW 「んん……っ、ま、만족かしら……」
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K2092_{SELECTCOM}_1
RETURN 1

