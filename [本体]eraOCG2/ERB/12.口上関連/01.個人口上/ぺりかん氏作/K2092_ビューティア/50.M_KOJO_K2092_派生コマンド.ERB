;==================================================
;3,Gスポット刺激
;==================================================
@M_KOJO_MESSAGE_SCOM_K2092_3
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2092_3_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2092_3_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		;처녀膜ぶち抜き
		IF TCVAR:파과 == 1
			PRINTFORML 「──っああ゛！？　……え、えぇ……な、何を……ま、まさか……っ！？」
			PRINTFORMW 「は、ははは……ウソ、でしょ……わ、私のバージン……こんなカタチで散らされちゃうの……」
			SIF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
				PRINTFORMW 「せ、責任とってくれる、わよね……？　『うん』って言うまで離さないから……♪」
		;それ以外
		ELSE
			IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
				PRINTFORML 「──ああ゛っ❤　し、子宮が痺れてぇ……❤」
				PRINTFORMW 「だ、ダメよっ❤　そんな、ところイジっちゃぁ……ひぃん゛❤　あ゛っ❤」
			ELSE
				PRINTFORMW 「──ひっ！？　な、なに、いまの痺れは……！？」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
		IF TALENT:TARGET:포르치오성감
		CALL XON_FONT("「ひぃぃ……,❤❤,　わ、私ぃ……,❤❤,　も、もうソコ、ゾリゾリされるだけでイッちゃうのぉ……,溶❤1,溶❤2,溶❤3,溶❤4",C_WATER_T)
		PRINTFORML 」
		CALL XON_FONT("「や、やだぁ……,❤❤,　もうこれ以上、イキたくないぃぃ……,❤❤❤,　や、ヤメてぇ……,❤❤❤,　イジメないでぇ……,❤❤❤,　ヤメ、ないでぇ……,群❤",C_WATER_T)
		PRINTFORMW 」
		ELSE
		CALL XON_FONT("「だ、ダメなの──ほ゛ぉっ,！❤,　そんな、トコロ、指ぃ──い゛ぃんっ,❤！,　イジら、ないでぇ──あ゛ふっ,！❤",C_WATER_T)
		PRINTFORMW 」 
		ENDIF
		RETURN 1

	;それ以外
	ELSE
		PRINTFORML 「──っ！？　な、なんでも──お゛っ！？　ない、……っわ！
		PRINTFORMW 　え、えぇ……指で──え゛っ！？　か、感じてるはずが、ないもの……」
		RETURN 1
	ENDIF
ENDIF
