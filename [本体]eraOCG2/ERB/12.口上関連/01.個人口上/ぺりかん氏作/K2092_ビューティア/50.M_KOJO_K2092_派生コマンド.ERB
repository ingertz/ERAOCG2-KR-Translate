	;基本セット
	;연모
	SETCOLOR C_WATER_T
	IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
		IF NAME:(LOCAL:101) == "도도레미코드 큐티아"
			PRINTFORML 「ふふ、キューティアったら……❤　すっかり%CSTR:TARGET:MASCALL%との섹스に夢中ね……❤　あらあら鼻水まで垂らして……カワイイ顔が台無しだわ……❤」
			PRINTFORMW 「あら……❤　そうよね、%CSTR:TARGET:MASCALL%が一人抱き潰したぐらいで만족しないわよね……❤　私もそこのキューティアみたいに、ブザマに抱き潰して頂戴……❤」
		ELSEIF NAME:(LOCAL:101) == "레도레미코드 드리미아"
			PRINTFORML 「そうよドリーミア……❤　大人も子供も関係ない……❤　強いおチンチンに굴복するのがオンナの幸せなの……❤　私のようにね……❤」
			CALL XON_FONT("「お゛ほ゛っ,！❤,　な、何おどろいてぇ,❤！,　そ、そうよぉ,❤！,　私ぃ,！❤,　",C_WATER_T)
			PRINTFORM %CSTR:TARGET:MASCALL%にハメてもらうの好きぃ
			CALL XON_FONT("！❤",C_WATER_T)
			PRINTFORM 　%CSTR:TARGET:MASCALL%に
			CALL XON_FONT("ぃ,！❤,　おチンチンにぃ,❤！,　굴복しちゃったのぉ,❤❤❤",C_WATER_T)
			PRINTFORMW 」
		ELSEIF NAME:(LOCAL:101) == "미도레미코드 엘리티아"
			PRINTFORML 「あらあら……❤　エリーティアってオマンコ、そんなに弱かったのね……❤　%CSTR:TARGET:MASCALL%に突かれて❤　気持ちよくて❤　何もできなくて……❤　私と、おそろいね……❤」
			CALL XON_FONT("「あ゛あ゛っ,！❤,　そう、そう゛なのぉ,❤！,　私もぉ,！❤,　エリーティアと同じぃ,❤！,　",C_WATER_T)
			PRINTFORM %CSTR:TARGET:MASCALL%におチンポ
			CALL XON_FONT("ハメられてぇ,！❤,　おチンチンに굴복するただのメスなのぉ,！❤,群❤",C_WATER_T)
			PRINTFORMW 」
		ELSEIF NAME:(LOCAL:101) == "파도레미코드 팬시아"
			PRINTFORML 「わかってるでしょうファンシア……❤　%CSTR:TARGET:MASCALL%は貴女一人で手に負えないって……❤　独り占めしたい気持ちは、痛いほどわかるけどね……❤」
			CALL XON_FONT("「き、たぁ,！❤,　おチンチン、きたぁ,❤！,　ファンシアいいじゃない,！❤,　どうせ私",C_WATER_T)
			PRINTFORM たち、%CSTR:TARGET:MASCALL%から離れられないの
			CALL XON_FONT("よぉ,❤！,　だったら仲良くぅ,！❤,　愛されましょう,❤❤❤",C_WATER_T)
			PRINTFORMW 」
		ELSEIF NAME:(LOCAL:101) == "솔도레미코드 그레이시아"
			PRINTFORML 「マイペースなグレーシアがこんなに大きな声をあげるなんて……❤　私でも聞いたことがないわ……❤　ふふ、疲れたでしょうグレーシア、後は私に任せて……❤」
			CALL XON_FONT("「お゛ほ゛っ,！❤,　あ゛っ,❤！,　ダメッ,！❤,　気持ちいいのぉ,！❤,　",C_WATER_T)
			PRINTFORM %CSTR:TARGET:MASCALL%のおチンチン気持ち
			CALL XON_FONT("いいのぉ,❤！,　グレーシアっ,❤！,　グレーシア助けてぇ,❤！,❤❤❤",C_WATER_T)
			PRINTFORMW 」
		ELSEIF NAME:(LOCAL:101) == "라도레미코드 엔제리아"
			CALL XON_FONTL("「え、エンジェリアぁ,！❤,　私っ、エンジェリアと一緒にハメ潰されてるぅ,❤！,　が、頑張ってぇ,！❤,　頑張って耐えるのよエンジェリアぁ,❤❤,」",C_WATER_T)
			CALL XON_FONT("「あ゛っ,！❤,　だ、ダメダメダメぇ,❤！,？❤,　せ、先輩としてエンジェリアより先にイクわけには……っ,❤❤,　ご、ごめんなさぁい❤　イク、イッちゃう,❤！,　せめて、同時にぃ……,群❤",C_WATER_T)
			PRINTFORMW 」
		ELSEIF NAME:(LOCAL:101) == "그랜도레미코드 쿨리아"
			CALL XON_FONT("",C_WATER_T)
			PRINTFORM 「いいのぉ,！❤,　私も,❤！,　クーリアもっ,❤！,　どっち
			PRINTFORM もぉ❤　%CSTR:TARGET:MASCALL%
			CALL XON_FONTL("のぉ,❤❤,　モノなのぉ……,❤！,」",C_WATER_T)
			CALL XON_FONT("「もっとぉ,！❤,　もっと深く突いてぇ,❤！,　クーリア、二人一緒にぃ,❤！,　一緒に、どこまでもっ、堕ちていきましょう……,溶❤1,溶❤2,溶❤3,溶❤4",C_WATER_T)
			PRINTFORMW 」
		ELSEIF NAME:(LOCAL:101) == "그랜도레미코드 뮤제시아"
			CALL XON_FONT("「あぁ……っ,！❤,　やっぱり",C_WATER_T)
			PRINTFORM 女神様も、%CSTR:TARGET:MASCALL%の前ではただのメス……❤
			CALL XON_FONTL("　おチンチンハメられてヨガるしかないメスなのだわ……,❤❤,」",C_WATER_T)
			CALL XON_FONT("「いいんです……❤　だって……──お゛ほ゛っ,！❤,　きたぁ,❤！,　私もぉ,❤！,　ハメ潰されてぇ,❤！,　굴복しちゃったメスなんですもの……っ,❤❤,　二人仲良くぅ,❤❤,　イキましょう,群❤",C_WATER_T)
			PRINTFORMW 」
		ELSE
			PRINTFORMW 「はぁーっ❤　はぁーっ❤　ま、待ち切れないの……❤　はやく、はやくハメてぇ……❤」
		ENDIF
		RETURN 1

	;それ以外
	ELSE
		CALL XON_FONT("「……う、ウソ……あれだけヤッて、まだ、足りないの……ひぃ、こないで──お゛っ！？　あ゛あっ！？　お゛ほっ,！❤",C_WATER_T)
		PRINTFORMW 」
		RETURN 1
	ENDIF
ENDIF
RESETCOLOR
RETURN 1
