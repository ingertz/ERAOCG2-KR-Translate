;==================================================
;1,식스나인
;==================================================
@M_KOJO_MESSAGE_SCOM_K2092_1
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2092_1_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2092_1_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「……え？　えぇ、聞いたことはあるわ……。식스나인、서로의 性器を舐め合う……のでしょう？」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
		SELECTCASE RAND:3
			CASE 0
				IF ABL:TARGET:Ｃ감각 > 2
					PRINTFORMW 「んああっ❤　く、クリトリス舐めちゃ、ダメぇ……❤　ま、『ママ』、ただのオンナになっちゃうぅ……❤」
				ELSE
					PRINTFORMW 「……ふふ❤　まだまだ……っ❤　『ママ』のほうが先に%CSTR:TARGET:MASCALL%をイカせちゃうんだからぁ……❤」
				ENDIF
			CASE 1
				PRINTFORML 「ちゅぅ❤　ちゅぱっ❤　ちゅぽっ❤　ぢゅぽっ❤　じゅるるっ❤　ふふ、『ママ』の펠라、気持ちいいかしら……❤」
				IF ABL:MASTER:기교 > 3
				PRINTFORMW 「우후후……❤　『ママ』ね、こうみえてもう限界なの……❤　%CSTR:TARGET:MASCALL%のクリ責めが強すぎて……❤　『ママ』、イカされちゃいそうだわ……❤」
				ELSE
				PRINTFORMW 「『ママ』にもプライドがあるわ……❤　私が%CSTR:TARGET:MASCALL%を甘やかすんだから……❤　絶対、先にイカせてあげるからね……❤」
				ENDIF
			CASE 2
				PRINTFORMW 「ズルいわ……❤　『ママ』の、私の弱いトコロ、全部%CSTR:TARGET:MASCALL%に把握済みなんだもの……❤　こんなの、集中できるわけないじゃない……❤」
		ENDSELECT
		RETURN 1

	;それ以外
	ELSE
		PRINTFORMW 「ちょ、て、手加減しなさいな……っ！？　わ、私ばっかり、一方的にぃ……っ！」
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K2092_{SELECTCOM}_1
RETURN 1

