			CALL XON_FONTL("「み、見ないでぇ,！❤,　わ、私、エリーティアの前では頼れる先輩でいたいのぉ,！❤,　私は、憧れの、先輩でぇ……っ,！❤",C_WATER_T)
			CALL XON_FONT("　あひ゛ぃ,！❤,　そ、そうなのっ,❤！,　私、ビューティアはぁ,❤❤,　",C_WATER_T)
			PRINTFORM %CSTR:TARGET:MASCALL%のおチンチン
			CALL XON_FONT("突っ込まれて悦ぶぅ,❤❤❤,　ただのメスなのぉ,❤❤❤,　エリーティア、ごめんねぇ……,壊❤",C_WATER_T)
			PRINTFORMW 」
		ELSEIF NAME:(LOCAL:101) == "파도레미코드 팬시아"
			CALL XON_FONT("「あ゛あ゛っ,！❤,　ご、ごめんなさいファンシア……,溶❤1,　私",C_WATER_T)
			PRINTFORM ね、%CSTR:TARGET:MASCALL%との
			CALL XON_FONTL("섹스、大好きなのぉ……,！❤",C_WATER_T)
			CALL XON_FONT("　で、でも貴女ならわかるでしょう……,？❤,　こんなおチンチンでぇ,❤❤,　ゴツゴツ突かれたらぁ……,❤❤❤,　オンナはみんな、メスに堕ちちゃうのよぉ……,群❤",C_WATER_T)
			PRINTFORMW 」
		ELSEIF NAME:(LOCAL:101) == "솔도레미코드 그레이시아"
			CALL XON_FONTL("「お゛っ,！❤,　お゛お゛っ,！❤,　び、ビックリしちゃったでしょう、グレーシア……,❤❤,　これが貴女の憧れた先輩の、真の姿なのぉ……,溶❤1",C_WATER_T)
			CALL XON_FONT("　おチンチン突かれてぇ……,！❤,　オマンコ굴복してぇ……,❤❤,　ヨガってイッちゃうただのオンナ……,❤❤❤,　それが貴女の先輩、ビューティアの本性なのよぉ……,群❤",C_WATER_T)
			PRINTFORMW 」
		ELSEIF NAME:(LOCAL:101) == "라도레미코드 엔제리아"
			CALL XON_FONT("「あ゛ふっ,！❤,　え、エンジェリア見ないでぇ……❤　",C_WATER_T)
			PRINTFORM 私が%CSTR:TARGET:MASCALL%のおチンチンで
			CALL XON_FONTL("ヨガるところ、見ないでぇ……,溶❤1",C_WATER_T)
			CALL XON_FONT("　あ、貴女も今にわかるわ……,！❤,　おチンチンでオマンコずぽずぽされてぇ,❤❤,　堕ちないメスはいないわぁ,❤❤❤,　ああ゛っ,❤！,　お゛お゛っ,❤！",C_WATER_T)
			PRINTFORMW 」
		ELSEIF NAME:(LOCAL:101) == "그랜도레미코드 쿨리아"
			CALL XON_FONT("「あ゛おっ,！❤,　い゛ひ゛っ,❤！,　",C_WATER_T)
			PRINTFORM %CSTR:TARGET:MASCALL%、もっと
			CALL XON_FONTL("ジュポジュポしてぇ,！❤,　私のオマンコ、あなたのカタチにしてぇ……,❤！",C_WATER_T)
			CALL XON_FONT("　あは゛っ,！❤,　何よクーリア,❤❤,　どうせ貴女も私とおんなじ,❤❤❤,　",C_WATER_T)
			PRINTFORM %CSTR:TARGET:MASCALL%のおチンチンの前
			CALL XON_FONT("ではただのメス,❤！,　一緒に堕ちていきましょう……,❤？",C_WATER_T)
			PRINTFORMW 」
		ELSEIF NAME:(LOCAL:101) == "그랜도레미코드 뮤제시아"
			CALL XON_FONTL("「め、め゛がみさ゛ま゛ぁ,！❤,　聞こえてますかぁ,❤！,　私の、嬌声がぁ,❤❤",C_WATER_T)
			CALL XON_FONT("　めがみさまもぉ,！❤,　一緒におチンポ突かれましょう,❤❤,　一緒",C_WATER_T)
			PRINTFORM に%CSTR:TARGET:MASCALL%のメスに
			CALL XON_FONT("なりましょう……,❤❤❤",C_WATER_T)
			PRINTFORMW 」
		ELSE
			CALL XON_FONT("「み、見られてるのに,！❤,　せ、섹스止まらないぃ,❤！,　お、お願い助けて……,❤❤,　このままじゃ私、抱き殺されちゃうぅぅ……,❤❤❤",C_WATER_T)
