			ENDIF
		;親愛
		CASE 5
			IF ABL:TARGET:Ｖ감각 >= 4
				CALL XON_FONTL("「やだぁ❤　,！❤,　指でぇ、イキたくないぃ,！❤,　ただでさえ、敏感なのにぃ,❤！,　オマンコ、弱いのにぃ……,！❤",C_WATER_T)
				CALL XON_FONT("「せ、せめておチンチン,！❤,　%CSTR:TARGET:MASCALL%のおチンチンがいいっ,❤！,　ハメてぇ,！❤,　%CSTR:TARGET:MASCALL%と一緒にイキたいのぉ……,！❤,❤？",C_WATER_T)
				PRINTFORMW 」
			ELSE
				PRINTFORML 「もう……❤　今更、指でかき混ぜなくても充分ほぐれてると思うわよ、私のオマンコ……❤　いっぱい、かき回されちゃったもの……❤」
				CALL XON_FONT("「それとも……私を指だけでイカせたいの……,❤？,　許してよ、そんなコトされたら❤　私、勝ちの目がなくなっちゃう……❤　ただでさえ%CSTR:TARGET:MASCALL%に負けっぱなしなのに……❤",C_WATER_T)
				PRINTFORMW 」
			ENDIF
	ENDSELECT
ENDIF
RETURN 1

