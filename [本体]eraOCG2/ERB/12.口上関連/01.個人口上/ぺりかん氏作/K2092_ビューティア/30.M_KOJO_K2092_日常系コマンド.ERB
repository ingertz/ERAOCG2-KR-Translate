@M_KOJO_MESSAGE_COM_K2092_350_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;抱き寄せ初回
	IF FIRSTTIME(TOSTR(350),1)
		IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
			PRINTFORML 「そ、そう……するのね、とうとう……」
			CALL XON_FONT("「も、もう気づいていると思うけど……こういう関係になるのはハジメテなの……優しくして、ね……,？❤",C_WATER_T)
			PRINTFORMW 」
		ELSE
			PRINTFORMW 「そ、そう……するのね、とうとう……」
		ENDIF
	;それ以外
	ELSE
		
		;通常押し倒し
		IF CFLAG:MASTER:우후후 == 1
			IF CFLAG:TARGET:만취강간 == 1
				PRINTFORMW 「우후후♪　暑くて困ってたのよ♪　脱がせてくださる……？」
			ELSEIF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
				SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「あらあら♪　そんな勢いよく押し倒されちゃったら服がシワになっちゃうわね？」
						CALL XON_FONT("「なので……シワにならないよう、脱がしてくださる,❤？,　우후후……,❤❤❤",C_WATER_T)
						PRINTFORMW 」
					CASE 1
						PRINTFORML 「たくさん愛して……❤　甘えさせて……❤　溺れさせて……❤」
						CALL XON_FONT("「私もその分愛させて……,❤❤,　甘やかさせて……,❤❤,　一緒に溺れて,群❤",C_WATER_T)
						PRINTFORMW 」
					CASE 2
						PRINTFORMW 「いいのよ……❤　私のカラダも、ココロも、全て%CSTR:TARGET:MASCALL%のモノ……❤」
				ENDSELECT
			ELSE
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「拒否しても、するんでしょう……？」
					CASE 1
						PRINTFORMW 「せ、せめて優しくして……」
					CASE 2
						PRINTFORMW 「カラダ、許すなんて……私って流されやすかったの……？」
				ENDSELECT
			ENDIF
		;攻守反転（MASTERが受け）
		ELSEIF CFLAG:MASTER:우후후 == 2
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「あらあら……❤　%CSTR:TARGET:MASCALL%ったらイケナイ人……❤」
					PRINTFORMW 「私のような年増に優しくするだけ優しくして、ソレで終わり？　そんなの、勘違いしちゃうに決まってるじゃない……❤」
				CASE 1
					CALL XON_FONT("「大丈夫……❤　ぜぇ……んぶ私に任せて……❤　%CSTR:TARGET:MASCALL%は何もしなくていいの……❤　私に全てを委ねて……ね？,？❤",C_WATER_T)
					PRINTFORMW 」
				CASE 2
					PRINTFORML 「ごめんなさいね、%CSTR:TARGET:MASCALL%……❤　あなたより年上なのに、ガマンのきかないオバサンでごめんなさい……❤」
					CALL XON_FONT("「でもね、もう抑えきれないの……❤　申し訳ないけど、しばらく私に付き合って……❤　いい子だから、お願い、ね……,溶❤1,溶❤2,溶❤3,溶❤4,",C_WATER_T)
					PRINTFORMW 」 
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1

