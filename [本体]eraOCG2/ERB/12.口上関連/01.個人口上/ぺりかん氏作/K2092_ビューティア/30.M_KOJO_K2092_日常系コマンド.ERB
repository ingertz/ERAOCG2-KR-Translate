LOCAL = 1
;-------------------------------------------------
IF LOCAL
;はじめて膝枕
	IF FIRSTTIME(SELECTCOM)
		PRINTFORMW 「膝枕……？　もう、そんなに私に甘えたいのかしら……？　えっ、私が……？」
		IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
			PRINTFORML 「……はぁ……ほん……っと%CSTR:TARGET:MASCALL%という人は……私を甘やかし倒してどうするというのよ……❤」
			PRINTFORMW 「わかったわ、それじゃあ存分に甘えさせてもらうわね……髪、撫でてもらえる……？」
		ELSE
			PRINTFORMW 「……その……頭、おもくないかしら……？　り、リボンが邪魔だったり、しない……？」
		ENDIF
		RETURN 1
	ENDIF
	IF ABL:TARGET:친밀 >= 10
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「……このまま、寝ちゃってもいいかしら……❤」
			CASE 1
				PRINTFORMW 「……うん……私、頑張ってるわ……うん、%CSTR:TARGET:MASCALL%が認めてくれるなら、それだけでいいの……❤」
			CASE 2
				PRINTFORMW 「あったかいわ、%CSTR:TARGET:MASCALL%……❤　あなたの全てが、とっても暖かいの……❤」
		ENDSELECT
	ELSEIF ABL:TARGET:친밀 <= 4
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「……落ち着かないわ……あ、いえ、%CSTR:TARGET:MASCALL%の膝の心地が悪いという意味ではなくてね？」
			CASE 1
				PRINTFORMW 「……子供扱いされるなんて、いつ以来かしら……」
			CASE 2
				PRINTFORMW （な、なんだか気恥ずかしいわ……こんな姿、エリーティアやグレーシアには見せられない……）
		ENDSELECT
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「……笑ってほしいのだけど……ど、どう甘えれば、いいのかしら……？」
			CASE 1
				PRINTFORMW 「……あまり顔を覗かないで……恥ずかしいの……❤」
			CASE 2
				PRINTFORML 「そんなに普段、気を張ってるように見えるかしら……？　だとしたら不覚、ね……」
				PRINTFORMW 「別に無理をしてるつもりはないのだけど……今は素直に甘えさせてもらうわね……❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
