;480,デュエル
;勝敗はプレイヤーから見てのもの
;TFLAG:SELECTCOM분기(1=通常승리 -1=通常패배 -2=引き分け
;10=通常듀얼前 11=パック賭け듀얼前 12=デート賭け듀얼前 13=パンツ賭け듀얼前 14=お持ち帰り듀얼前 15=お前モンスターじゃないか？ 16=スケベ要求듀얼前 20=闇のゲーム
;31=パック賭け승리 32=デート賭け승리 33=パンツ賭け승리 34=お持ち帰り成功 35=カード化승리（牝以外） 36=スケベ要求事後 40=罰ゲーム！
;135=カード化見逃す 235=穏便カード化 335=凌辱後カード化 435=凌辱後見逃す
;50=賭け듀얼패배怒られた 51=パック賭け패배 52=デート패배デート 55=カード化패배 56=スケベ要求패배 156=スケベ要求弱味削除 256=スケベ要求패배패배버릇付きおねだり)
;==================================================
@M_KOJO_MESSAGE_COM_K2092_480
;デュエルにTRAIN_MESSAGEはない
CALL M_KOJO_MESSAGE_COM_K2092_480_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2092_480_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;これが０の時はデュエルしない時なのでおわり
	SIF TFLAG:SELECTCOM분기 == 0
		RETURN 1

	;デュエル前
	IF INRANGE(TFLAG:SELECTCOM분기,10,21)
		SELECTCASE TFLAG:SELECTCOM분기
			;通常듀얼
			CASE 10
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「デュエル、ね……♪　ふふ、お手柔らかに……♪」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORMW 「今なら多少、%CSTR:TARGET:MASCALL%に食い下がることも出来るでしょう……それでは一手ご指南、いただきますね♪」
						ELSE
							PRINTFORMW 「デュエルはまだ初心者だけれども……遠慮なくいらして、ねっ♪」
						ENDIF
					CASE 2
						IF CFLAG:MASTER:듀얼레이트 >= 6000 || TALENT:MASTER:수라
							PRINTFORML 「……もう、デュエルになると急に雰囲気が変わるのだから……」
							PRINTFORMW 「いいわ……好きなことに真剣になる%CSTR:TARGET:MASCALL%、お姉さん好きだわ……♪」
						ELSE
							PRINTFORMW 「さて、%CSTR:TARGET:MASCALL%の実力は如何ほど……なんてね♪」
						ENDIF
				ENDSELECT
			
			;ここから賭け듀얼
			;パック賭け
			CASE 11
				SELECTCASE RAND:2
					CASE 0
						PRINTFORMW 「パックを……？　まぁそれぐらいならいいけれども……あまり賭け事は感心しないわね……」
					CASE 1
						IF CFLAG:MASTER:듀얼레이트 >= 6000 || TALENT:MASTER:수라
							PRINTFORML 「どうぞお手柔らかに……なんて聞いてくれる%CSTR:TARGET:MASCALL%じゃないわよねぇ……」
							PRINTFORMW 「ま、パックぐらいならいいでしょう。もちろんただ巻き上げられて終わる気はないのですけどね……っ」
						ELSEIF EXP:TARGET:듀얼경험 >= 15
							PRINTFORMW 「あらあら……♪　私だって負けるつもりはないわよ？」
						ELSE
							PRINTFORMW 「私としても持ってるカードが少ないからありがたいけど……%CSTR:TARGET:MASCALL%に巻き上げられて終わる気がするわねぇ……」
						ENDIF
				ENDSELECT
			;デート賭け
			CASE 12
				IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
					PRINTFORMW 「あらあら……♪　中々可愛らしいことをするのね♪　ああ、ごめんなさいね？　からかう意図があるわけではないのよ？」
				ELSE
					PRINTFORMW 「……あら、ふふ……♪　中々いじらしいわねぇ……」
				ENDIF
			;パンツ賭け
			CASE 13
				IF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨 || CFLAG:TARGET:호감도 >= 2000
				PRINTFORMW 「も、もう……❤　私のパンツがほしいなんて、こんなオバサンをからかわないでほしいわ……❤」
			ELSE
				PRINTFORMW 「……もう、私のパンツなんて価値もないでしょうに……」
			ENDIF
			;お持ち帰り
			CASE 14
