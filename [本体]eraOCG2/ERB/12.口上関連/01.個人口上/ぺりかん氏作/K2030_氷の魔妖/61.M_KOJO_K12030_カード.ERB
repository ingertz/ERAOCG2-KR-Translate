;※※※※※※※※※※※※※※※※※※※※※※※※※
;CARD용구상
;※※※※※※※※※※※※※※※※※※※※※※※※※
;직접 카드의 ID를 사용할 수 있음.
;캐릭터가 없어도 움직임
;존재 증명
@M_KOJO_CARD_K12030
RETURN 1
;==================================================
;0,몬스터 소환 시
;==================================================
@M_KOJO_CARD_K12030_0(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE RAND:2
	CASE 0	
		PRINTFORMW 「겨울이 오면 세상 모든 것이 숨을 거두니……」
	CASE 1
		PRINTFORMW 「자, 이곳은 이미 겨울이야.」
	ENDSELECT
ENDIF

;==================================================
;1,攻撃時
;==================================================
@M_KOJO_CARD_K12030_1(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「凍えなさい」
ENDIF

;==================================================
;2,효과발동
;==================================================
;효과별로 출력하고 싶다면, 직접 카드 데이터를 보고 설정할 필요가 있음
;귀찮거나, 모르겠다면 분기는 하지 말 것
;실패 판정은, 이른바 효과를 무효당했을 때 같은 것
@M_KOJO_CARD_K12030_2(종류,失敗판정)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 종류
#DIM DYNAMIC 失敗판정
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 失敗판정 == 0
		IF 종류 == 특수소환時 || 종류 == EX소환時
			PRINTFORMW 「백설에 파묻히거라.」
		ELSEIF 종류 == 묘지起動 || 종류 == フリー誘発
			PRINTFORMW 「자, 저승에서 돌아올 시간이다.」
		ENDIF
	ELSE
		PRINTFORMW 「결국 나로서는 여기까지, 인가.」
	ENDIF
ENDIF

;==================================================
;3,除去時
;==================================================
;일일이 뭐든지 제거될 때마다 말하면 시끄러우므로, 기본적으로는 파괴에만 반응하도록 설정
@M_KOJO_CARD_K12030_3(除去종류,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 除去종류
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 除去종류
	CASE 破壊行き
		PRINTFORMW 「크읏!? ……다시, 만나도록 하죠.」
	ENDSELECT
ENDIF

