;==================================================
@M_KOJO_EVENT_K2030_1(ARG,ARG:1)
;구상주는 TARGET
;--------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------
IF LOCAL
	;공백
	PRINTFORML
	;-------------------------------------------------
	;하루 첫 인사 분기 (MAIN/외출 모두)
	;기입 체크（=0, 비표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG,1,2,6) && CFLAG:TARGET:인사했음 == 0
		IF TALENT:TARGET:애처
			PRINTFORMW 「좋은 아침, 나의 %CSTR:TARGET:MASCALL%. ……후훗♪」
		ELSEIF TALENT:TARGET:굴복됨
				PRINTFORMW 「좋은 아침이에요, %CSTR:TARGET:MASCALL%❤」
				PRINTFORMW 「어머나, 벌써 아침이었네요. ……아침이었지.」
		ELSEIF TALENT:TARGET:연모 
			PRINTFORMW 「%CSTR:TARGET:MASCALL%인가, 좋은 아침. 나를 만나다니 재수 없네, 이쪽으로선 행운이지만」
		ELSE
			PRINTFORMW 「……아아, %CSTR:TARGET:MASCALL%인가. 재수 없네, 나를 만나다니」
		ENDIF
		RETURN 1
	ENDIF

	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;MASTER가 들어왔다
	;기입 체크（=0, 비표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「여기 있어~」
		PRINTFORMW %CALLNAME:TARGET%는 이쪽을 한 번 힐끗 보고는, 소맷자락을 팔랑팔랑 흔들었다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGET이 들어왔다
	;eraOCG2_V0.40_BT_240518 시점에선 나오지 않으므로 주의
	;기입 체크 (=0, 미표시, 1, 표시)
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「어라, 이런 곳에 있었네」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGET이 목욕탕에 들어와서 같이 들어감
	;eraOCG2_V0.40_BT_240518 시점에선 나오지 않으므로 주의
	;기입 체크 (=0, 미표시, 1, 표시)
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「어머, %CSTR:TARGET:MASCALL%도 왔어?」
		PRINTFORMW 「뭘 바보같이 멍하니 서 있어. 들어왔으면 등이라도 밀어」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGET이 목욕탕에 들어왔다가 나감
	;eraOCG2_V0.40_BT_240518 시점에선 나오지 않으므로 주의
	;기입 체크 (=0, 미표시, 1, 표시)
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML 「……그래, 들어오는구나. 그럼 이만」
		PRINTFORMW 「아아, 설녀가 나온 다음이니 욕조가 차갑지 않으면 좋겠네」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGET이 목욕탕에 들어왔다가 쫓겨남
	;미확인
	;기입 체크 (=0, 미표시, 1, 표시)
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORMW 「……%CSTR:TARGET:MASCALL%, 소녀의 맨살을 뭐라고 생각하는 거야. 집주인? 알 바 아니고, 나가」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;외출지에서 조우했다
	;eraOCG2_V0.40_BT_240522 시점에선 나오지 않으므로 주의
	;기입 체크 (=0, 미표시, 1, 표시)
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF TALENT:TARGET:연모 
			PRINTFORMW 「이런 곳에서 만나다니, ……가끔은 신에게 감사해 줘도 괜찮겠네」
		ELSE
			PRINTFORMW 「어라, %CSTR:TARGET:MASCALL%. 기막힌 우연이네.」 
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;다른 캐릭터와 데이트 중에 조우했다
	;eraOCG2_V0.40_BT_240522 시점에선 나오지 않으므로 주의
	;ARG:1에 데이트 상대
	;기입 체크 (=0, 미표시, 1, 표시)
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		IF TALENT:TARGET:연모 
			PRINTFORML 「……흐응, 뭐, 됐어. 방해하면 저쪽 아가씨에게도 미안하니까」
			PRINTFORMW 「……보상은 기대, 하고 있을게」
		ELSE
			PRINTFORMW 「헤에, 의외로 만만히 볼 사람이 아니었네」
		ENDIF 
			RETURN 1
	ENDIF
ENDIF
RETURN 1

