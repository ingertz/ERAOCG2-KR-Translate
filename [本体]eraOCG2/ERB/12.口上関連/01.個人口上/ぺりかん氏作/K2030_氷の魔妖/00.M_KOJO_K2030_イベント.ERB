	ENDIF
	;-------------------------------------------------
	;집에 방문해 온다
	;기입 체크 (=0, 미표시, 1, 표시)
	LOCAL:1 = 1
	;-------------------------------------------------
	;방문해 온다
	IF LOCAL:1 && ARG == 5 && ARG:1 == 0
		PRINTFORMW 「왔어, 마중 나와.」
		RETURN 1
	;「네」를 선택
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 1
		PRINTFORML 「……그래, 그거면 됐어.」
		PRINTFORMW 말투는 평범하지만, 표정이 어딘가 들떠 보인다……
		RETURN 1
	;「아니오」를 선택
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 2
		PRINTFORMW 「…………그래, 그렇겠지. 그럼 잘 있어.」
		RETURN 1
	;자리를 비울 수 없는 상태에서, 돌아가 줌
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 3
		PRINTFORML 「……흐음. 뭐, 됐어.」
		PRINTFORMW 「다음에 왔을 땐 환대할 준비 해놓으라고.」
		RETURN 1
	;자리를 비울 수 없는 상태에서, 들어왔다
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 4
		PRINTFORML 「헤에…… 내가 온 것보다 중요한 일이 있단 말이지.」
		PRINTFORMW 「후후♪ 놀래주는 건 이쪽의 십팔번이야, 각오해.」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;졸려서 카드/집으로 돌아간다
	;기입 체크 (=0, 미표시, 1, 표시)
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6 && ARG:1 == 0
		PRINTFORMW 「피곤해. 갈래.」
		RETURN 1
	ELSEIF LOCAL:1 && ARG == 6 && ARG:1 == 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;혼자서 외출을 한다
	;(내방 캐릭터의 귀가 시에 욕구불만과 욕망이 높으면 발생)
	;기입 체크 (=0, 미표시, 1, 표시)
	LOCAL:1 = 0
	;-------------------------------------------------
	;통상 외출
	IF LOCAL:1 && ARG == 7 && ARG:1 == 0
		RETURN 1
	;아르바이트 외출
	ELSEIF LOCAL:1 && ARG == 7 && ARG:1 == 1
		RETURN 1
	ENDIF
ENDIF
RETURN 1

