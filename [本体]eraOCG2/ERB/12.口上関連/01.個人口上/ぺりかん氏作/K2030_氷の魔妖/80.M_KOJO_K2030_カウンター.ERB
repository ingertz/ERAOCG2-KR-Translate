					PRINTFORML 「お背中、流させてもらうわね？　ふふ……♪」
				CASE 3
					PRINTFORML 「お背中、流してあげるわ。……っふふ、幸せね……❤」
			ENDSELECT
		;洗髪（セルフ）
		CASE 3
			호감도修正 = 1
			SIF TALENT:TARGET:애처
				호감도修正 += 0
			SIF TALENT:TARGET:연모 == 2
				호감도修正 += 1
			SIF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨
				호감도修正 += 1
			SELECTCASE RAND:호감도修正 + 1
				CASE 1
					PRINTFORML 「……その、うなじを凝視しないで……」
					SIF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨
					PRINTFORML 「恥ずかしい、のよ。……こんなところ、普段見せないじゃない……」
				CASE 2
					PRINTFORML 「丁寧？　……そりゃ美しさを保つための努力はかかせないでしょう？」
				CASE 3
					PRINTFORML 「私の髪、%CSTR:TARGET:MASCALL%は好きでしょう？　じゃあもっと、キレイにしておかないとね……❤」
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1

