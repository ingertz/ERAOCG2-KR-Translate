@M_KOJO_MESSAGE_COM_K2030_21_1
#DIM DYNAMIC 욕망修正
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;처음
	;기입 체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「어라, 아무것도 안 해? 휴식 시간이야?」
		RETURN 1
	ENDIF
	;기본 세트
	욕망修正 = 2
	SIF ABL:TARGET:욕망 >= 9
		욕망修正 += 1
	SIF ABL:TARGET:욕망 >= 6
		욕망修正 += 1
	SIF ABL:TARGET:욕망 >= 3
		욕망修正 += 1
	SELECTCASE RAND:욕망修正 + 1
		CASE 1
			PRINTFORMW 「한숨 돌리는구나. 역시 %CSTR:TARGET:MASCALL%라도 지치긴 하는구나」
		CASE 2
			PRINTFORMW 「응…… 조금 쉬게 해줘」
		;욕망 3 이상
		CASE 3
			PRINTFORMW %CALLNAME:TARGET%는 얼굴을 붉히며, 힐끔힐끔 이쪽을 엿보고 있다.
		;욕망 6 이상
		CASE 4
			PRINTFORMW 「……안 해?」
		;욕망 9 이상
		CASE 5
			PRINTFORMW 「……심술쟁이. 이렇게나 몸을 달아오르게 해놓고, 기다리게 하다니……」
	ENDSELECT
ENDIF
RETURN 1
