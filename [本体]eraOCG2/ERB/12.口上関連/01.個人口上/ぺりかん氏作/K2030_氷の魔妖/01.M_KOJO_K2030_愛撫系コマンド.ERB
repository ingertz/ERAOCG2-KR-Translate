@M_KOJO_MESSAGE_COM_K2030_0
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2030_0_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2030_0_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;처음
	;기입 체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「만지는구나. ……별로 기대는 안 하니까, 뭐, 힘내서 날 기분 좋게 만들어 보시지. ……읏」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;삽입 중
	;기입 체크
	LOCAL:1 = 1
	;-------------------------------------------------
	;V삽입
	IF LOCAL:1 && TEQUIP:50 == MASTER
		;사정했다
		IF NOWEX:MASTER:사정
			PRINTFORMW 「……후후, 내 안, %CSTR:TARGET:MASCALL%가 사정해서 뜨거워……」
			PRINTFORMW 「어라, 안뿐만 아니라 몸 전체를 데워주는 거야? 후후, 고마워……」
			RETURN 1
		ELSE
			PRINTFORMW 「아, 이봐, 넣고 있을 때 만지지 마……!」
			PRINTFORMW 「으, 의식을 질 안에 집중해서 참고 있단 말이야, 다른 곳을 만지면──!」
			RETURN 1
		ENDIF
	;A삽입
	ELSEIF LOCAL:1 && TEQUIP:51 == MASTER
		;사정했다
		IF NOWEX:MASTER:사정
			PRINTFORMW 「……응, 후후, 내 몸, 따뜻해?」
			PRINTFORMW 「%CSTR:TARGET:MASCALL%가 엉덩이까지 귀여워해 줬으니까……. 아, 이봐, 손길이 야하잖아, 이, 변태……❤」
			RETURN 1
		ELSE
			PRINTFORMW 「이, 이봐, 몸, 더듬지 마……」
			PRINTFORMW 「엉덩이, 힘, 빠져서, 깊숙이, 들어가버려엇……읏」
			RETURN 1
		ENDIF
	ENDIF

	;-------------------------------------------------
	;후타나리
	;기입 체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 「하, 하지 마…… 자지, 만지지 마……」
		PRINTFORMW 「나, 나 여자인데……. 시, 싫어, 이런, 자지로, 기분 좋은 건, 알고 싶지 않아아아……읏!」
		RETURN 1
	ENDIF

	;기본 세트
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 1
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			IF TALENT:TARGET:연모
				PRINTFORMW 「……으응……큿……. 잘하네……」
				PRINTFORMW 「내가 직접 만졌을 때는, 이렇게, 느끼지 못했는데……❤」
			ELSEIF TALENT:TARGET:굴복됨
				PRINTFORMW 「하앙❤　후후, 너무 기분 좋아서, 무서울 정도야❤」
			ELSE
			PRINTFORMW 「응, 조금, 근질거리네」
			ENDIF
		CASE 2
			PRINTFORMW 「……야한 손길이네. 그렇게 내 몸이, 즐거워?」
				IF TALENT:TARGET:연모
				PRINTFORMW 「뭐, 나는 설녀니까. 성욕에 굶주린 %CSTR:TARGET:MASCALL%가 음탕해지는 것도 어쩔 수 없나」
				PRINTFORMW 「으응……후후, 더 기분 좋게 해줘, 응……❤」
			ELSEIF TALENT:TARGET:굴복됨 
				PRINTFORMW 「후후, 괜찮아❤ 더욱 더어~…… 즐겨줘, 응❤」
			ENDIF
		CASE 3
			PRINTFORMW 「뭔가 이상하게 익숙한데……. 마치 다른 여자로 경험한 것 같은……」
			IF TALENT:TARGET:연모
				PRINTFORMW 「질투……, 그래, 하고 있어. 뭐, 내가 %CSTR:TARGET:MASCALL%의 성욕을 전부 받아줄 수 있냐고 묻는다면…… 무리네」
				PRINTFORMW 「뭐, 부디 힘내보도록 할게. %CSTR:TARGET:MASCALL%가 오래오래, 나를 사랑해 주도록, 말이야」
			ELSEIF TALENT:TARGET:굴복됨
				PRINTFORMW 「후후, 뭐 당연하지❤ 나를 이~렇게나 빠지게 만들었는걸❤」
				PRINTFORMW 「%CSTR:TARGET:MASCALL% 같은 수컷 님이 다른 암컷을 거느리지 않을 리가 없잖아❤」
			ENDIF
		;연모
		CASE 4
			PRINTFORMW 「……햣❤　자, 잠깐 클리토리스는 그만……읏」
			PRINTFORMW 「아, 아픈 건 아니야. 그저, 조금, 민감할 뿐이라서……햐아아앙❤」
		CASE 5
			PRINTFORMW 「응, 햐후후……❤ 나, 대체, %CSTR:TARGET:MASCALL%에게 얼마나 만져진 걸까……」
			PRINTFORMW 「후후, 잔뜩, 만져줘……, 잔뜩, 느끼게 해줘……❤」
		;친애
		CASE 6
			PRINTFORMW 「%CSTR:TARGET:MASCALL%의 손, 정말 따뜻하네. 가끔 부러워져」
			PRINTFORMW 「그러니까, 말이야. 데워줘. %CSTR:TARGET:MASCALL%의 손으로, 잔뜩 잔뜩 기분 좋게 해줬으면 좋겠어……❤」
		CASE 7
			PRINTFORMW 「응, 아핫❤ 더, 더욱 만져줘❤ 입술도, 젖가슴도, 클리토리스도, 보지도……」
			PRINTFORMW 「나, %CSTR:TARGET:MASCALL%의 손으로 가버리고 싶어, 끝없이, 끝없이…… 응❤」
		;애처
		CASE 8
			PRINTFORMW 「%CSTR:TARGET:MASCALL%, 만지기만 해도 괜찮아……? 나를, 더 원하지 않는 걸까」
			PRINTFORMW 「응, 후후…… 알고 있구나. 그래, 이런 시간에도 행복을 느껴. %CSTR:TARGET:MASCALL%도 그렇게 느껴준다면, 기쁠 거야……❤」
	ENDSELECT
ENDIF
RETURN 1
