;※※※※※※※※※※※※※※※※※※※※※※※※※
;CARD用구상
;※※※※※※※※※※※※※※※※※※※※※※※※※
;직접 카드의 ID를 사용할 수 있음.
;캐릭터가 없어도 움직임
;존재 증명
@M_KOJO_CARD_K2030
RETURN 1
;==================================================
;0,몬스터 소환 시
;==================================================
@M_KOJO_CARD_K2030_0(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「지금부터는 우리들, 『마요괴』의 시간이야」
ENDIF

;==================================================
;1,공격 시
;==================================================
@M_KOJO_CARD_K2030_1(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「자아, 버틸 수 있을까?」
ENDIF

;==================================================
;2,효과발동
;==================================================
;효과별로 출력하고 싶다면, 직접 카드 데이터를 보고 설정해야 한다.
;귀찮거나 잘 모르겠다면 분기하지 말 것
;실패 판정은, 소위 효과가 무효화되었을 때 같은 경우
@M_KOJO_CARD_K2030_2(종류,失敗판정)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 종류
#DIM DYNAMIC 失敗판정
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 失敗판정 == 0
		PRINTFORMW 「어머어머, 『마요괴』에게 손을 대다니, 겁 없는 분이네」
	ELSE
		PRINTFORMW 「……설마 녹아버릴 줄이야」
	ENDIF
ENDIF

;==================================================
;3,제거 시
;==================================================
;일일이 뭐든지 제거될 때마다 말하면 시끄러우므로, 기본적으로는 파괴에만 반응하도록 설정
@M_KOJO_CARD_K2030_3(除去종류,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 除去종류
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 除去종류
	CASE 破壊行き
		PRINTFORMW 「두고 봐……!」
	CASE 제외行き
		PRINTFORMW 「힉!? 그만해, 봉인당하는 것만은……! 무, 무서워……」
	ENDSELECT
ENDIF

