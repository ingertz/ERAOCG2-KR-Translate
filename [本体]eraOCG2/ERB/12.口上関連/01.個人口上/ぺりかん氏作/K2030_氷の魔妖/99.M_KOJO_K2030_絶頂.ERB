;==================================================
;펠라치오
;==================================================
@M_KOJO_MESSAGE_PALAMCNG_A_K2030_4(ARG)
CALL PALAM_MESSAGE_A
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;ごっくん
	IF EXP_UP(15) == NOWEX:MASTER:사정 * 3
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「……んっ❤　ふふ、飲んでやったわ。感謝しなさい……❤」
			CASE 1
				PRINTFORMW 「クサくて、苦くて、濃厚ね……❤」
			CASE 2
				PRINTFORMW 「……んっ❤　……ふぅ、ま、%CSTR:TARGET:MASCALL%のなら……ね❤」
		ENDSELECT
	;吐き出す
	ELSEIF EXP:TARGET:정음경험 <= 20
