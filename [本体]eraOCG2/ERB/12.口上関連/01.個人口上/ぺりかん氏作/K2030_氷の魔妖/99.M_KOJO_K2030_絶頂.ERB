;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;분기作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:절정
;4以上で昇天、3で超強절정、2で強절정、1で절정

;NOWEX:Ｃ절정 NOWEX:Ｖ절정 NOWEX:Ｂ절정 NOWEX:Ａ절정 NOWEX:Ｍ절정
;各部位の절정

;NOWEX:二重절정、NOWEX:三重절정、NOWEX:四重절정、NOWEX:五重절정
;同時に절정した時の状態
;上記五つに加えてNOWEX:Ｅ절정でも판정

;TOTALEX
;地の文の판정に使われているもの
;5以上で潮を吹き、4以下で背中を反らせて절정する
;詳しくはEVENT_MESSAAGE_ORGASMを参照

;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが삽입中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが삽입中となる。

;NOWEX:사정
;사정量、最大3。たとえばIF NOWEX:MASTER:사정 > 1だと、あなたが大量사정以上した場合となる。

;==================================================
;절정時の구상
;==================================================
@M_KOJO_MESSAGE_PALAMCNG_B_K2030(ARG)
#DIM TOTALEX
#DIM DYNAMIC 호감도修正
CALL PALAM_MESSAGE_B(ARG)
TOTALEX =  NOWEX:ARG:Ｃ절정 + NOWEX:ARG:Ｖ절정 + NOWEX:ARG:Ａ절정 + NOWEX:ARG:Ｂ절정+ NOWEX:ARG:Ｍ절정 + NOWEX:ARG:Ｅ절정 + NOWEX:ARG:분유 + NOWEX:ARG:사정
SIF !(TOTALEX + NOWEX:ARG:방뇨)
	RETURN 0
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;분유
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:분유 && NOWEX:ARG:절정 <= 2 && !TCVAR:ARG:전턴절정
		IF EXP:TARGET:분유경험 >= 100
			PRINTFORMW 「っもっと゛ぉ❤　もっと絞って゛ぇ❤　母乳でぇ❤　イッちゃ、うぅぅぅ……❤」
		ELSE
			IF TALENT:TARGET:연모
				PRINTFORMW 「あっ❤　あああっ❤　母乳、がぁ❤　……っふふ❤　の、のみたい……？」
			ELSEIF TALENT:TARGET:굴복됨
				PRINTFORMW 「あ゛っ❤　母乳、とまらな、いぃ……っ❤　%CSTR:TARGET:MASCALL%、もっと゛絞ってぇ❤」
			ELSE
				PRINTFORMW 「っあ……！？　な、んで……！？　母乳、とまらな──！？」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;사정した
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:2 = 1
	;-------------------------------------------------
	IF LOCAL:2 && NOWEX:ARG:사정 && NOWEX:ARG:절정 <= 2
		IF TALENT:TARGET:연모
				PRINTFORML 「ふああああっ❤　で、사정るぅ❤　せーし、사정るぅぅ……❤」
				IF TALENT:MASTER:성별 == 0
					PRINTFORMW 「……よ、よかったわ……❤　……%CSTR:TARGET:MASCALL%、私のあかちゃん……孕みなさいよ……❤」
				ELSE
					PRINTFORMW 「……はぁ、はぁ……❤　……ず、ズルいわ……❤　%CSTR:TARGET:MASCALL%、こんなに気持ちよかったのね……❤」
				ENDIF
			ELSEIF TALENT:TARGET:굴복됨
				PRINTFORMW 「ふあああっ❤　%CSTR:TARGET:MASCALL%、ごめんなさぁいぃ❤　私、わたし……❤　%CSTR:TARGET:MASCALL%に、粗相を……っ❤」
			ELSE
				PRINTFORML 「っあ……！？　い、イヤよ……！　こんなので、イキたくな──！？」
				PRINTFORMW 「あ！？　あああああっ！？　と、とまってぇ……っ！」
			ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;방뇨
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:3 = 1
	;-------------------------------------------------
	IF LOCAL:3 && NOWEX:ARG:방뇨
		IF TALENT:TARGET:연모
				PRINTFORMW 「……くぅ……❤　み、見られてしまった……。おねがい、嫌いにならないで……っ」
			ELSEIF TALENT:TARGET:굴복됨
				PRINTFORMW 「あっ……❤　は、はい……❤　私、%CALLNAME:TARGET%は……❤　こんな年で粗相してしまう……ヘンタイの、魔妖……です❤」
			ELSE
				PRINTFORMW 「っみ、みるな……！？　こんなとこ、見るなぁ……！？　やだ、止まらない──！？　あ、ああっ……❤」
			ENDIF
		RETURN 1
	ENDIF

	;구상の色の변경　この状態だとピンク色　必要ない場合はこことRESETCOLORを消す
	SETCOLOR C_H_PINK
	;基本セット
	;限界突破조교中
	IF BASE:ARG:체력 < 300
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「かはっ❤　かひゅっ❤　かひっ……❤　か、ああっ……❤」
			CASE 1
				PRINTFORMW 「……ぁー❤　ぁぁ゛……っ❤」
			CASE 2
				PRINTFORMW 「……ひゅー……っ❤　……ひゅー……っ❤　……ひゅー……っ❤　……きひ……っ……❤」
		ENDSELECT
	;通常
	ELSE
		IF TCVAR:ARG:전턴절정
			SELECTCASE RAND:4
				CASE 0
					CALL XON_FONT("「……まっ,！❤,　わたし、まだイッてぇ──,❤！,？❤",C_H_PINK)
					PRINTFORMW 」
				CASE 1
					CALL XON_FONT("「やだぁ,！❤,　あた゛まっ,❤！,　お゛かしく゛なる゛ぅ,塵❤1,塵❤2,❤❤❤",C_H_PINK)
					PRINTFORMW 」
				CASE 2
					CALL XON_FONT("「止まらないっ,！❤,　キモチ゛イイがっ,❤！,　止まら゛ない゛っ,！❤,　ああっ❤　あ゛あ゛あ゛あ゛あ゛ぁ゛っ,塵❤1,塵❤2,❤❤❤",C_H_PINK)
					PRINTFORMW 」
				CASE 3
					CALL XON_FONT("「イクッ,！❤,　またイクぅ,❤！,　やだぁ,❤❤,　こわいのぉ,！❤,　助けてよぉ,塵❤1,塵❤2,❤❤❤",C_H_PINK)
					PRINTFORMW 」
			ENDSELECT
		ELSE
			SELECTCASE NOWEX:ARG:절정
				;절정
				CASE 1
					SELECTCASE RAND:3
						CASE 0
							CALL XON_FONT("「あっ,！❤,　イッ,❤！,　ああっ❤　ああああっ,❤！",C_H_PINK)
							PRINTFORMW 」
						CASE 1
							CALL XON_FONT("「……,！❤,❤？,　……っ,❤！,　……ぁ……っ,❤！,？❤",C_H_PINK)
							PRINTFORMW 」
						CASE 2
							CALL XON_FONT("「ああっ,！❤,？❤,　……,❤！,❤？,　……くぅ……っ,！❤",C_H_PINK)
							PRINTFORMW 」
					ENDSELECT
				;強절정 
				;超強절정
				CASE 2,3
					SELECTCASE RAND:3
						CASE 0
							CALL XON_FONT("「あっ,！❤,？❤,　イッ,❤！,　ああっ❤　いくっ,❤！,　イッちゃうぅぅ……っ,❤！",C_H_PINK)
							PRINTFORMW 」
						CASE 1
							CALL XON_FONT("「……ああ゛っ,！❤,❤？,　……っあ゛ああ,❤！,　……ぁ……イ、クゥ……,❤！,？❤",C_H_PINK)
							PRINTFORMW 」
						CASE 2
							CALL XON_FONT("「あ゛あっ,！❤,？❤,　おお゛っ,❤！,❤？,　……ああ゛あっ,！❤,❤？,　も、もうっ……,❤！",C_H_PINK)
							PRINTFORMW 」
						CASE 3
							CALL XON_FONT("「ん゛ん～っ,❤！,？❤,　ん、ん゛ん～っ,❤！,❤？,　ああっ,！❤,　気持ちい,❤❤,　あぁぁぁあぁぁっ,塵❤1,塵❤2,❤❤❤",C_H_PINK)
					ENDSELECT
				;昇天
				CASE IS >= 4
					SELECTCASE RAND:3
						CASE 0
							CALL XON_FONT("「ダメェ,！❤,？❤,　イッ,❤！,　イッちゃうっ❤　いくっ,❤！,　イッちゃうぅぅ……っ,塵❤1,塵❤2,群❤",C_H_PINK)
							PRINTFORMW 」
						CASE 1
							CALL XON_FONT("「……ああ゛っ,！❤,❤？,　……っも゛,❤！,　も゛うやだぁ,❤！,？❤,　とめてぇ,❤！,！❤,　止め、ないでぇぇ,塵❤1,塵❤2,❤❤❤",C_H_PINK)
							PRINTFORMW 」
						CASE 2
							CALL XON_FONT("「バカにぃ,！❤,？❤,　バカになる゛ぅ,❤！,❤？,　……あた゛ま゛ぁ,！❤,❤？,　ま゛っ゛し゛ろ゛にな゛る゛ぅぅぅぅ……,塵❤1,塵❤2,❤❤❤",C_H_PINK)
							PRINTFORMW 」
						CASE 3
							CALL XON_FONT("「おお゛っ,❤！,？❤,　お゛ほ゛ぉ,❤！,❤？,　だめっ,！❤,　むり゛っ,❤❤,　と゛まら゛、ない゛ぃぃ,塵❤1,塵❤2,群❤",C_H_PINK)
					ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1


;==================================================
;あなたが사정したときに関する구상の표시
;一時的にTARGETを구상主に설정している
;==================================================

;==================================================
;TARGETの手による사정で、사정대상が非TARGET
;==================================================
@M_KOJO_MESSAGE_PALAMCNG_A_K2030_00(ARG)
#DIM DYNAMIC 사정대상
CALL PALAM_MESSAGE_A
사정대상 = NO:ARG
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 0
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 
	RETURN 1
ENDIF
RETURN 1

;==================================================
;사정場所
;==================================================

;==================================================
;콘돔（ペニスから引き抜いて見せつけ）
;==================================================
@M_KOJO_MESSAGE_PALAMCNG_A_K2030_0(ARG)
CALL PALAM_MESSAGE_A
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE NOWEX:TARGET:사정
		;一般
		CASE 1
			IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
				PRINTFORMW 「……あら、どこか調子悪いの？　%CSTR:TARGET:MASCALL%、こんなものじゃないでしょう……❤」
			ELSE
				PRINTFORMW 「……そんなに、사정るものなのね……」
			ENDIF
		;大量
		CASE 2
			IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
				PRINTFORMW 「……ふふ、元気そうな精子ね……❤」
			ELSE
				PRINTFORMW 「……사정しすぎじゃない？」
			ENDIF
		;大量を超えた大量
		CASE 3
			IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
				PRINTFORMW 「……どうせなら、ゴムなしのほうがよかったわね……❤」
			ELSE
				PRINTFORMW 「……よ、かったわ。……ゴム、つけてくれて……」
			ENDIF
	ENDSELECT
	RETURN 1
ENDIF
RETURN 1

;==================================================
;질내
;==================================================
@M_KOJO_MESSAGE_PALAMCNG_A_K2030_1(ARG)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 사정人物箇所
IF MASTER_POSE(6, 1, 1) > 0
	사정人物箇所 = MASTER_POSE(6, 1, 1)
ENDIF
CALL PALAM_MESSAGE_A
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;同時절정
	IF NOWEX:TARGET:절정
		IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「……っふふ❤　%CSTR:TARGET:MASCALL%も、イッたの、ね……❤　相性がいいようで、なによりだわ……❤」
					CASE 1
						PRINTFORMW 「嬉しい、わ……❤　절정するタイミングが一緒で……まるで以心伝心、みたいで……❤」
					CASE 2
						PRINTFORMW 「……お互い、汗だく……ね❤　……どうする？　……私はまだ、やれるけど……❤」
				ENDSELECT
			ELSE
				PRINTFORMW 「……はぁ、はぁ……。……なによ、%CSTR:TARGET:MASCALL%もイッたの……？　……まったく、カラダのほうは、相性いいみたいね……」
			ENDIF
	;それ以外
	ELSE
		SELECTCASE NOWEX:MASTER:사정
			;一般
			CASE 1
				IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「……感じるわ❤　%CSTR:TARGET:MASCALL%のが、私のナカに……❤」
					CASE 1
						PRINTFORMW 「知ってるわよ……❤　これぐらいじゃ%CSTR:TARGET:MASCALL%はまだ足りない……❤　そうでしょ？」
					CASE 2
						PRINTFORMW 「……どうせならもっと……❤　ほんとに赤ちゃん、作っちゃいましょうか……❤」
				ENDSELECT
			ELSE
				PRINTFORMW 「……ナカに、사정されたのね……」
			ENDIF
			;大量
			CASE 2
				IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「……もう、どれだけ私を孕ませたいの……❤」
					CASE 1
						PRINTFORMW 「あった、かいわ……私のナカ……満たされた感じがする……❤」
					CASE 2
						PRINTFORMW 「……そんなに、私の具合はよかったのかしら……❤　ふふ……❤」
				ENDSELECT
			ELSE
				PRINTFORMW 「……ニンゲンごときに孕まされるとは思ってないけど……不安になるわね、少しだけ」
			ENDIF
			;大量を超えた大量
			CASE 3
				IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「……収まりきらないわよ、もう❤」
					CASE 1
						PRINTFORMW 「%CSTR:TARGET:MASCALL%の精子で……❤　私、溶けてしまいそうよ……❤」
					CASE 2
						PRINTFORMW 「……孕んだ❤　ぜったい、孕んだわ……❤　ふふ……❤　%CSTR:TARGET:MASCALL%と、わたしの……ややこが、ナカに……❤」
				ENDSELECT
			ELSE
				PRINTFORML 「……どれだけ、注ぐのよ……私まで、グッタリしてきたわ……」
				PRINTFORMW 「……ああもう……っ、今回は、私の負けでいいわ……」
			ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

