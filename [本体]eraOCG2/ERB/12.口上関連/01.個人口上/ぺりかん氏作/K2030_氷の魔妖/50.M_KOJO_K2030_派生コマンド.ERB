;==================================================
;12,파이즈리펠라
;==================================================
@M_KOJO_MESSAGE_SCOM_K2030_12
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2030_12_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2030_12_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;처음
	;기입 체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「어라, 젖가슴 사이로 삐져나왔네…… 흐응……」
		PRINTFORMW 「낼름…… 헤에, 기분 좋은 거야? ……흐응, 그래……」
		RETURN 1
	ENDIF
	;기본 세트
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			IF TALENT:TARGET:연모
				PRINTFORMW 「어라, 젖가슴만으로는 외로워 보이네. 살짝 보이는 귀두 끝이 떨리고 있어」
				PRINTFORMW 「낼름…… 후훗, 기뻐 보이네……♪」
			ELSE
			PRINTFORMW 「흐응, 젖가슴만으로는 부족했구나. 입으로도 해달라니, ……정말 욕심쟁이라니까…… 쪽」
			ENDIF
		CASE 2
			IF TALENT:TARGET:연모
				PRINTFORMW 「음츕…… 후후, 귀여워……♪」
				PRINTFORMW 「……어때? 꽤, 잘한다고 생각하지 않아? %CSTR:TARGET:MASCALL%를 위해서인데, 연습 정도는 해야지」
			ELSE
			PRINTFORMW 「크읏…… 끼우면서 입도 움직이는 건, 생각보다 힘드네……」
			ENDIF
		CASE 3
			IF TALENT:TARGET:연모
				PRINTFORMW 「음, 쪽……♪ ……차가울 텐데?」
				PRINTFORMW 「설녀니까, 젖가슴, 차갑잖아. 입으로 데워줄게……♪」
			ELSE
			PRINTFORMW 「읏…… 쪽……, ……뭐야?」
			PRINTFORMW 「별로…… 적극적으로 변한 건 아니야」
			ENDIF
		CASE 4
			PRINTFORMW 「응, ……쪽♪ 영차, ……낼름♪ 훗, ……함♪」
			PRINTFORMW 「후훗, 입으로 봉사하는 거랑 젖가슴으로 봉사하는 거, 어느 쪽이 좋아?」
		CASE 5
			PRINTFORMW 「젖가슴이라고 할 것 없이…… 입이라고 할 것 없이…… 내 온몸으로 기분 좋게 해줄 테니까……」
			PRINTFORMW 「그러니까 잔뜩, 사정해줘…… 전부, 받아줄 테니까……❤」
	ENDSELECT
ENDIF
;미기입
;CALLFORM M_KOJO_MESSAGE_COM_K2030_{SELECTCOM}_1
RETURN 1

