;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;처음
	;기입 체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「……후후훗, 제법 분수를 잘 아네……♪ 그래, 항상 내가 위, %CSTR:TARGET:MASCALL%가 아래여야만 해……♪」
		PRINTFORMW 「후훗, 그래, 아주 좋아……♪ ……? 앞? 으응? 알았지만……」
		PRINTFORMW 「……!? 잠깐, 뭐야!? 거울, 나, 이런 표정 짓고 있어!? 거짓말, 거짓말이야, 이렇게, 녹아내려서……읏❤」
		RETURN 1
	ENDIF
	;기본 세트
	;연모
	IF TALENT:연모
		PRINTFORMW 「후, 후후훗! 그래, 맞아……! 거기, 기분 좋아……❤」
		PRINTFORMW 「아앙……❤ 남자 위에 걸터앉아서❤ 핥아지고❤ 이래선 완전 걸레 같잖아……읏❤」
		RETURN 1

	;그 외
	ELSE
		PRINTFORMW 「히야앗!? 히잉!? 거짓말, 거짓말이야……! 내가, 지배, 하는 쪽인데……!」
		PRINTFORMW 「이런, 이런 얼굴로는! 마치, 내가…… 쾌락에, 지배당하는, 여자 같잖아……!」
		RETURN 1
	ENDIF
ENDIF
;미기입
;CALLFORM M_KOJO_MESSAGE_COM_K2030_{SELECTCOM}_1
RETURN 1

;==================================================
;3,G스팟 자극
;==================================================
@M_KOJO_MESSAGE_SCOM_K2030_3
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2030_3_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2030_3_1
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;처음
	;기입 체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		;처녀膜ぶち抜き
		IF TCVAR:파과 == 1
			PRINTFORMW 「……응……아앗!? 끅, 큿……후우……」
			PRINTFORMW 「내, 내 처녀……, 손가락으로, 찢은 거네……? 그, 그래……」
			PRINTFORMW 「……괘, 괜찮아, 생각, 보다는, 말이야……」
			PRINTFORMW 「읏……후우……. 이정도, 라면…… 실전, 삽입은, 어떻게든, 되려나……」
			PRINTFORMW 「……아, 자, 손가락…… 내밀어. 내 피, 더럽잖아……」
			PRINTFORMW 「……깨끗하게, 해줄 테니까」
		;그 외
		ELSE
			PRINTFORMW 「읏……!? ……이, 이봐」
			PRINTFORMW 「손가락을 깊게 넣을 거면, 말이라도 하라고」
			PRINTFORMW 「아프다거나 그런 거 이전에, 깜짝 놀라잖아」
		ENDIF
		RETURN 1
	ENDIF
	;기본 세트
	;연모
	IF TALENT:연모
		PRINTFORMW 「꼼, 꼼꼼하네…… 이젠 충분히 풀렸다고 생각하는데」
		PRINTFORMW 「읏아, 크읏……❤ 약점, 파고들리고 있어……❤」
		RETURN 1

	;그 외
	ELSE
		PRINTFORMW 「흐, 으으으……읏, 너무, 만지지 마」
		PRINTFORMW 「등, 등골이 오싹오싹하단 말이야, 앗!?」
		RETURN 1
	ENDIF
ENDIF
;미기입
;CALLFORM M_KOJO_MESSAGE_COM_K2030_{SELECTCOM}_1
RETURN 1

