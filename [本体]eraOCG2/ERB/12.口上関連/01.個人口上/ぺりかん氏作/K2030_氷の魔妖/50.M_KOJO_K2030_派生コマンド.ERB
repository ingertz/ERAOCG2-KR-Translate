@M_KOJO_MESSAGE_SCOM_K2030_1
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2030_1_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2030_1_1
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;처음
	;기입 체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「승부……? 헤에…… 서로 성기를 핥아서 어느 쪽이 가게 할 수 있는지, 라……. 재미있네, 받아들일게」
		PRINTFORMW 「……!? 잠깐만! 나, 클리, 민감하단 말야……!」
		RETURN 1
	ENDIF
	;기본 세트
	;연모
	IF TALENT:연모
		PRINTFORMW 「츄읍, 츄르릅, ……하앙❤ 아앙❤ 이, 그만, 그만두지 마❤」
		PRINTFORMW 「……미안해. 나만, 기분 좋아서……. ……흐트러진 모습이 보고 싶었어? 정말, 바보…… 좋아해❤」
		RETURN 1

	;그 외
	ELSE
		PRINTFORMW 「츕……!? 응큿!? 햐앗……! 크읏……!낼름……히잉! 낼, 낼름……으아아앗!?」
		PRINTFORMW %CALLNAME:TARGET%는 어떻게든 자지를 핥으려고 하지만, %CALLNAME:MASTER%가 클리토리스를 핥을 때마다 반응해버리고 있다……
		RETURN 1
	ENDIF
ENDIF
;미기입
;CALLFORM M_KOJO_MESSAGE_COM_K2030_{SELECTCOM}_1
RETURN 1

