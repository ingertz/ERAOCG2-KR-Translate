;80,수음
;==================================================
@M_KOJO_MESSAGE_COM_K2030_80
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2030_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2030_80_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;처음
	;기입 체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「어때, 기분 좋아?」
		PRINTFORML 「……에, 아파? 해본 적도 없는데 알 리가 없잖아, 참아」
		PRINTFORMW 「네네, 알았어, 좀 더 부드럽게 해줄게. ……이러면 돼?」
		RETURN 1
	ENDIF
	;기본세트
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「정말 이런 걸로 기분 좋은 거야?」
			IF TALENT:TARGET:연모
				PRINTFORMW 「응, 잘하고 있다면 기쁘네. 원하는 거 있으면 말해, 응?」
			ELSEIF TALENT:TARGET:굴복됨
				PRINTFORMW 「다행이다……❤ 불만 있으면 말해줘❤」
			ENDIF
		CASE 2
			IF TALENT:TARGET:연모
				PRINTFORMW 「내 손, 차가운데 시들거나 하진 않아? 괜찮아?」
				PRINTFORMW 「미안해. 체온이, 좀처럼 오르질 않아서. 그만큼 서비스는 할 테니까……」
			ELSEIF TALENT:TARGET:굴복됨
				PRINTFORMW 「괜찮아요. 소중하고 소중한 자지 님❤ 정중하게 흔들어 드릴게요……❤」
			ELSE
			PRINTFORMW 「손이 차가워서 기분 좋아? 그러네, 동상에 걸리지 않으면 좋겠네. ……농담이야」
			ENDIF
		CASE 3
			PRINTFORMW 「……좀 더 작게 만들 순 없어? 손이 피곤하단 말이야」
			IF TALENT:TARGET:연모
			PRINTFORMW 「하지만, 이 손에 있는 게 나를 기분 좋게 해주는 거지……. 후후, 훌륭하네……❤」
			ELSEIF TALENT:TARGET:굴복됨
			PRINTFORMW 「좀 더 작았더라면 나, 이 정도로 굴복하진 않았을 텐데~❤ 분하다~❤」
			ENDIF
		CASE 4
			PRINTFORMW 「……전부터 생각했는데, 내 손, 너무 차갑지 않아? 역시 따뜻한 여자애 쪽이……」
			PRINTFORMW 「……! 후후, %CSTR:TARGET:MASCALL%는 꽤 별나네. 좋아, 기분 좋게 해줄게……」
		CASE 5
			PRINTFORMW 「후후, 여기가 기분 좋은 거지……. 자, 언제든지 사정해도 괜찮아❤」
			PRINTFORMW 「잔뜩 더럽혀줘. 쌓인 흰 눈을 짓밟듯이, 나를, %CSTR:TARGET:MASCALL%의 색으로 물들여줘, 응❤」
	ENDSELECT
ENDIF
RETURN 1

;==================================================
;81,펠라치오
;==================================================
@M_KOJO_MESSAGE_COM_K2030_81
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2030_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2030_81_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;처음
	;기입 체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;첫 키스
		IF EXP:TARGET:Ｍ경험 == 0 && EXP:TARGET:펠라경험 == 1 && CALLNAME:(CFLAG:TARGET:키스상실상대) == CALLNAME:MASTER
			PRINTFORMW 「……그래. 그런 거구나」
			PRINTFORMW 「나 같은 여자는, 자지에 키스하는 게 어울린다고, 그런 거지. 네네, 알았어」
			PRINTFORMW 웅크려 %CALLNAME:MASTER%의 것에 입을 맞추는 %CALLNAME:TARGET%. ……기분 탓일까, 그 감은 눈에서 눈물 한 줄기가 흐른 것 같았다.
		;그 외
		ELSE
			PRINTFORMW 「설마 내가 인간 상대로 샤쿠하치(尺八)를 하게 될 날이 오다니. ……네네, 요즘은 펠라치오라고 하는구나」
		ENDIF
		RETURN 1
	ENDIF
	;기본세트
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
		
	;청소 펠라
	IF STAIN:MASTER:2 & 4 && ABL:TARGET:기교 >= 3
		PRINTFORMW 「……자, 내 입으로 깨끗하게 해줄게……. 후훗, 아-…… 음」

	;통상
	ELSE
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
			IF TALENT:TARGET:연모
				PRINTFORMW 「꿀꺽……, 생각해보니 꽤 익숙해졌네. 정말이지」
				PRINTFORMW 「정말, %CSTR:TARGET:MASCALL%랑 같이 있으면 쓸데없는 것만 배우게 되네. 응, 쓸데없어. 그야 %CSTR:TARGET:MASCALL% 말고 다른 사람에게 쓸 기회도 없고」
			ELSEIF TALENT:TARGET:굴복됨
				PRINTFORMW 「어때? %CSTR:TARGET:MASCALL%에게 길들여진 덕분에, 이렇게나 잘하게 됐어……❤」
			ELSE
				PRINTFORMW 「응, 으음……. 어렵네. 턱이 빠질 것 같아서 무서워……」
			ENDIF
			CASE 2
				IF TALENT:TARGET:연모
					PRINTFORMW 「자, 잘 먹겠습니다……. 꿀꺽……❤ 어때, 기분 조아?」
					PRINTFORMW 「푸핫……. 이빨, 별로 안 닿았지? 나름대로 늘려고 노력하고 있다고」
				ELSEIF TALENT:TARGET:굴복됨
					PRINTFORMW 「이렇게 보니 움찔움찔 귀엽네…… 먹어버리고 싶을 정도로❤」
					PRINTFORMW 「후후, 과연 농담일까? 질척❤ 꿀꺽꿀꺽……❤」
				ELSE
					PRINTFORMW 「꽤 겁이 없네, %CSTR:TARGET:MASCALL%. 내가 깨물어 버릴 거라는 상상은 안 해?」
					PRINTFORMW %CALLNAME:TARGET%의 말에 무심코 섬칫했다. 그것을 보고 %CALLNAME:TARGET%는 바보 취급하듯 웃고 있다……
				ENDIF
			CASE 3
			IF TALENT:TARGET:연모
				PRINTFORMW 「질척…… 꿀꺽…… 누풉풉푸……, 푸핫❤」
				PRINTFORMW 「어때, 코로 숨 쉬는 것도 익숙해졌지? 후후, %CSTR:TARGET:MASCALL%의 냄새도 느껴져」
			ELSEIF TALENT:TARGET:굴복됨
				PRINTFORMW %CALLNAME:TARGET%는 황홀한 눈으로 이쪽의 단단한 것을 사랑스럽다는 듯이 계속 핥고 있다.
			ELSE
				PRINTFORMW 「응! ……푸하아……읏. 하아……읏, 하아……읏. ……숨이, 안 쉬, 어져……」
			ENDIF
			CASE 4
				PRINTFORMW 「후, 후후, 어때? 이렇게 차가운 구강 봉사, 다른 데서는 맛볼 수 없잖아?」
			CASE 5
				PRINTFORMW 「……❤ ……❤❤ ……! ……푸하앗!? 하아-……읏, 하아-……읏……」
				PRINTFORML 「……왜 중간에 뺀 거야. 에, 질식할 것 같았다고? ……괜찮아, 조금 숨 못 쉬어도 죽지는 않아」
				PRINTFORMW 「그러니까, 응. 다시 한번, 맛보게 해줘. %CSTR:TARGET:MASCALL%의 늠름한 것을……❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

