;100,스팽킹
;==================================================
@M_KOJO_MESSAGE_COM_K2030_100
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2030_100_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2030_100_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;처음
	;기입 체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「끅!? 뭐하는 거야, 갑자기 때리다니!!」
		PRINTFORMW 「내가 누군 줄 알고! 그런 짓을 할 거면──아앗!?」
		RETURN 1
	ENDIF
	;기본 세트
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			IF TALENT:TARGET:굴복됨 
				PRINTFORML 「아파❤ 아파요❤」
				PRINTFORMW 「무슨 실례라도 저질렀나요?❤ 사과할 테니 용서해──히잇!?❤」
			ELSEIF TALENT:TARGET:애처 || TALENT:TARGET:연모
				PRINTFORML 「꺄악!? 그, 그만해……」
				PRINTFORMW 「뭐, 뭐 거슬리는 짓이라도 했어? 말해주면 고칠 테니까──앗!?」
			ELSE
				PRINTFORMW 「그, 그만해! 그 손 내려──끄윽!?」
			ENDIF
		CASE 2
			IF TALENT:TARGET:굴복됨 
				PRINTFORML 「네엣❤ 저희들은❤ 인간에게❤ 폐를 끼쳤습니다❤」
				PRINTFORMW 「잔뜩 때려서, 어리석은 암컷을, 깨닫게 해주세요❤──피긱!?❤」
			ELSEIF TALENT:TARGET:애처 || TALENT:TARGET:연모
				PRINTFORML 「싫어…… 아픈 거 싫어……」
				PRINTFORMW 「부탁이야…… 이젠 때리지 마……」
			ELSE
				PRINTFORMW 「나, %CSTR:TARGET:MASCALL%에게 맞을 이유는 없잖아!?」
				PRINTFORMW 「『인간에게 적대적』? 하지만 %CSTR:TARGET:MASCALL%에게는 아무것도──끄윽!?」
			ENDIF
		CASE 3
			IF TALENT:TARGET:굴복됨 
				PRINTFORML 「네엣❤ 저어❤ %CSTR:TARGET:MASCALL%가 자국을 남겨줬으면 좋겠어요❤」
				PRINTFORMW 「어디든 상관없어요❤ %CSTR:TARGET:MASCALL%가 원하는 대로……꺄앙❤」
			ELSEIF TALENT:TARGET:애처
				PRINTFORML 「아, 자국, 남았네…… 엉덩이, 욱신거리고 아파……」
				PRINTFORMW 「──잠깐, 왜 손을 치켜드는 거야!? 『흥분시킨 쪽이 나쁘다』고? 그, 그럴 생각은──!?」
			ELSE
				PRINTFORML 「나 같은 거, 때려봤자 재미없잖아? 그러니까 자, 그만두지 않을래?」
				PRINTFORMW 「『하얀 피부에 손자국이 비쳐서 예쁘다』고? 뭐, 그런 이유로──아악!? 아파!?」
			ENDIF
		CASE 4
			PRINTFORML 「나, 아픈 거 싫어해…… 그러니까, 부탁이야, 괴롭히지 마……」
			PRINTFORMW 얼굴을 돌리는 %CALLNAME:TARGET%에게 흥분한 당신은 힘껏 손을 치켜들었다. %CALLNAME:TARGET%는 절망한 표정으로 올려다보고 있다……
		CASE 5
			PRINTFORML 「!? 히익!」
			PRINTFORMW 「……괘, 괜찮아. 무서워도, %CSTR:TARGET:MASCALL%의 것이라면 견딜 수 있어……. 부, 분명 견뎌, 보일, 거야……」
	ENDSELECT
ENDIF
RETURN 1

