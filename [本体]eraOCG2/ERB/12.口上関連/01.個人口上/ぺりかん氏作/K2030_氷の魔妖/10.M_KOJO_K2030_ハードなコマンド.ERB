;101,채찍
;==================================================
@M_KOJO_MESSAGE_COM_K2030_101
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2030_101_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2030_101_1
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;처음
	;기입 체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「……그거 뭐야? 설마 사 온 거야? ……또 헛돈 썼네」
		PRINTFORMW 「애초에 그런 걸 어디다 쓰려고……. 모처럼 사 와도 쓸데가 없잖──엣?」
		RETURN 1
	ENDIF
	;기본 세트
	;굴복or음란
	IF TALENT:TARGET:굴복됨
		PRINTFORML 「……아, 아아, 아아아아아❤」
		PRINTFORMW 「무, 물론❤ %CSTR:TARGET:MASCALL%가 말하는 건 절대적이니까…… 바, 받아들일게?」
		PRINTFORMW %CALLNAME:TARGET%는 억지로 미소를 지어 보였지만, 채찍을 휘두르는 시늉을 하자 덜덜 떨며 눈물을 흘리고 있다……

	;연모
	ELSEIF TALENT:연모
		PRINTFORMW 「……!? ……!! ……! ……읏!? ……흐, 으으……」
		PRINTFORMW 「……저기, 만약, 상처, 남아도…… 사랑해 줄 거지……?」
		RETURN 1

	;그 외
	ELSE
		PRINTFORMW 「잠깐, 그만──히긱!? 컥!? 끄윽!? 아악!?」
		PRINTFORMW 「……하아, 하아…… 그, 그만해…… 부탁이야……」
		RETURN 1
	ENDIF
ENDIF
RETURN 1

