;105,밧줄
;==================================================
@M_KOJO_MESSAGE_COM_K2030_105
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2030_105_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2030_105_1
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;처음
	;기입 체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「읏!? 묶는 거야? 설마 넘겨버릴 생각이야!?」
		PRINTFORMW 「……미안해, 동요해버려서……. 인간들 사이에 섞여 지낼 때, 불안했거든. 언젠가 붙잡히는 게 아닐까 하고」
		PRINTFORMW 「……이건 개인적인 취미인 거지? ……%CSTR:TARGET:MASCALL%는, 나를, 배신하지 않을 거지……?」
		RETURN 1
	ENDIF
	;기본 세트
	;装着
	IF TEQUIP:밧줄
		IF TALENT:TARGET:굴복됨 
			PRINTFORML 「……혹시 저❤ 마요괴로서 넘겨지는 걸까요……?」
			PRINTFORMW 「괜찮아요. 저, 배신당해도 어쩔 수 없으니까……」
			PRINTFORMW 「하지만, 버리지 않아 주신다면, 저, 너어무 기쁠 거예요……❤」

		;연모
			ELSEIF TALENT:연모
			PRINTFORMW 「……알고 있겠지만, 나, 아픈 거 싫어해」
			PRINTFORMW 「하지만 %CSTR:TARGET:MASCALL%에게라면 묶여도 괜찮아. 그 대신, 배신하지 마, 알았지?」
