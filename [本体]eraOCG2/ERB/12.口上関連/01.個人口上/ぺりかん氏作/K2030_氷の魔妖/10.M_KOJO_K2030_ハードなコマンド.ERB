;==================================================
;154,리미터 해제
;가슴 사이즈는 원래 크기(리미터 해제 사용 전)를 참조
;==================================================
@M_KOJO_MESSAGE_COM_K2030_154
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2030_154_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2030_154_1
;-------------------------------------------------
;기입 체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;처음
	;기입 체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「……핫?」
		PRINTFORMW 「엣? 엣? ……핫? 어째서, 내 가슴이……?」
		RETURN 1
	ENDIF
	;기본 세트
	SELECTCASE TALENT:TARGET:가슴사이즈 
		;빈유
		CASE -2,-1,0
			PRINTFORMW 「햐아!? 에, 갑자기 커졌어!?」
			PRINTFORMW 「아니 잠깐!? 그럼 왜 일부러 작게 만든 거야!? 내 젖가슴을!」
		;보통과 폭유
		CASE 1,2
			PRINTFORMW 「꺄악!? 또, 또 내 가슴이!?」
			PRINTFORMW 「정말! 어떻게 하는 거야, 그거……!」
		;울어도 좋아
		CASE -3
			PRINTFORMW 
		;젖소
		CASE 3
			PRINTFORMW 「꺄악!? 또, 또 커졌어!?」
			PRINTFORMW 「너 말이야, 이런 걸 반복하니까 평소에도 커져버린 거 아니야!? 응❤」
	ENDSELECT
ENDIF
RETURN 1
