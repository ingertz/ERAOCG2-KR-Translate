;전부 *삽입을 할 때* 의 구상을 위해, 기분 좋은 곳을 도려내거나 자궁을 찌그러뜨리고 싶을 때는 파생 명령어로
;A계열은 파생되지 않기 때문에 삽입계속해서 헐떡이면 느낌이 좋아진다
;==================================================
;60,정상위
;==================================================
@M_KOJO_MESSAGE_COM_K2030_60
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2030_60_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2030_60_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;정상위
;기입체크（=0, 비표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;소분기
	;-------------------------------------------------
	;처음
	;기입체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;처녀
		IF TCVAR:파과 == 1
			CALL M_KOJO_MESSAGE_COM_K2030_SHOJO_BREAK
			RETURN 1
		ELSE
			PRINTFORMW 「손, 잡아줄래? ……후후, 따뜻한 손……」
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;삽입 계속
	;삽입한 채로 이 체위로 바꾼다
	;기입체크
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:V삽입관리플래그 == MASTER
		;前回사정した
		IF TCVAR:질내사정플래그 
			CALL M_KOJO_MESSAGE_COM_K2030_SEXCHANGE_2
			RETURN 1
		ELSE
			CALL M_KOJO_MESSAGE_COM_K2030_SEXCHANGE_1
			RETURN 1
		ENDIF
	ENDIF
	;기본 세트
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 0
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 0
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「박아줘도, 괜찮아」
		CASE 2
			PRINTFORMW 「%CSTR:TARGET:MASCALL%의 얼굴을 볼 수 있으니, 안심돼」
		CASE 3
			PRINTFORMW 「……이 자세, 의외로 부끄럽네. 마치 잡아먹히는 것 같아」
	ENDSELECT
ENDIF
RETURN 1

