;==================================================
;10,ダメージ反応！（ダメージ）
;==================================================
@M_KOJO_DUEL_K2535_10(ダメージ量,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC ダメージ量
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE ダメージ量
		;ダメージなし
		CASE 0
			PRINTFORMW 「へへん、効かないよ！」
		;１～１９９９の時、小ダメージ
		CASE 1 TO 1999
			IF ライフ_상대 < 0
				PRINTFORMW 「え～！？　もうおれのライフがゼロォ～！？　なんだか納得いかないよ～！」
			ELSEIF ライフ_상대 < 2000
				PRINTFORMW 「……いってて……なんとかしないと！」
			ELSEIF ライフ_상대 < 4000
				PRINTFORMW 「くっ……！　あれ、おれのLP結構ピンチ！？」
			ELSE
				PRINTFORMW 「うわっ！」
			ENDIF
		;２０００～３９９９の時、結構なダメージ
		CASE 2000 TO 3999
			IF ライフ_상대 < 2000
				PRINTFORMW 「くぅぅ……負けた～！」
			ELSEIF ライフ_상대 < 2000
				PRINTFORMW 「くぅ、ううぅ……あ、諦めるもんか……！」
			ELSEIF ライフ_상대 < 4000
				PRINTFORMW 「ぐうぅ……まだまだ！」
			ELSE
				PRINTFORMW 「いてて……これぐらい！」
			ENDIF
		;４０００～７９９９の時、超大ダメージ
		CASE 4000 TO 7999
			IF ライフ_상대 < 0
				PRINTFORML 「──ねぇ、次はおれが勝つからさ、
				PRINTFORMW 　またデュエルしようね！」
			ELSEIF ライフ_상대 < 1000
				PRINTFORMW 「うわああああっ！？　……まだ、絶望はしない……っ」
			ELSEIF ライフ_상대 < 4000
				PRINTFORMW 「ぐわああああっ！？」
			ELSE
				PRINTFORMW 「あっぶね～、회복しておいてよかった～……！」
			ENDIF
		;８０００以上、基本即死
		CASEELSE
			IF ライフ_상대 > 0
				PRINTFORMW 「うぅぅ……龍可、おれを守ってくれたのか……？」
			ELSE
				PRINTFORMW 「うわああああああっ！！！」
			ENDIF
	ENDSELECT
ENDIF


