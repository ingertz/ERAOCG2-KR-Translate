;==================================================
;0,デュエルスタート！
;==================================================
@M_KOJO_DUEL_K2535_0(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「いくよパワー・ツール！　おれたちの力を、%CALLNAME:MASTER%にぶつけるんだ！」
		CASE 2
			PRINTFORMW 「おれのモンスターたちのカッコいい姿、見せちゃうもんね！」
		CASE 3
			PRINTFORMW 「よぉし、デュエルだ！　いい勝負にしようね、%CALLNAME:MASTER%！」
	ENDSELECT
ENDIF

;==================================================
;1,モンスター소환
;例：%カード名%を소환！
;==================================================
@M_KOJO_DUEL_K2535_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF GROUPMATCH(カードID,24601,24602)
		PRINTFORMW 「こい、ディフォーマーモンスター！　%カード名%を소환！」
	ELSEIF GROUPMATCH(カードID,24007,24008)
		PRINTFORMW 「패에서 ！　%カード名%を소환！　ジャキーン！」
	ELSEIF カードID == 24600
		PRINTFORMW 「패에서 튜너モンスター！　%カード名%を소환！」
	ELSEIF GROUPMATCH(カードID,24603,24604,24605)
		PRINTFORMW 「よぉし、ここでこいつだ！　패에서 %カード名%を소환するよ！」
	ELSE
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「패에서 ！　%カード名%を소환！」
		CASE 2
			PRINTFORMW 「よし、%カード名%を소환！　ガキーン！」
		CASE 3
			PRINTFORMW 「いっくぞ～！　패에서 %カード名%を소환するね！」
	ENDSELECT
	ENDIF
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_KOJO_DUEL_K2535_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 소환出処
		;패에서 
		CASE 召種손패
			IF GROUPMATCH(カードID,24601,24602)
				PRINTFORMW 「こい、ディフォーマーモンスター！　%カード名%を특수소환！」
			ELSEIF GROUPMATCH(カードID,24007,24008)
				PRINTFORMW 「패에서 ！　%カード名%を특수소환！　シャキーン！」
			ELSEIF GROUPMATCH(カードID,24600,24606)
				PRINTFORMW 「패에서 튜너モンスター！　%カード名%を특수소환だ！」
			ELSEIF GROUPMATCH(カードID,24603,24604,24605)
				PRINTFORMW 「きてくれ！　패에서 %カード名%を특수 소환한다よ！」
			ELSE
				PRINTFORMW 「패에서 %カード名%を특수 소환한다よ！」
			ENDIF
		;마법함정ゾーンから。　キリ番・シェイプシスターなどを出す場合
		CASE 召種마함
			PRINTFORMW 「마법함정ゾーンから%カード名%を특수소환！　ジャキーン！」
		;덱에서 
		CASE 召種덱
			IF GROUPMATCH(カードID,24601,24602)
				PRINTFORMW 「덱에서 こい、ディフォーマーモンスター！　%カード名%、ジャッキーン！」
			ELSEIF GROUPMATCH(カードID,24007,24008)
				PRINTFORMW 「덱에서 ！　%カード名%を특수소환！　シャキーン！」
			ELSEIF GROUPMATCH(カードID,24600,24606)
				PRINTFORMW 「덱에서 튜너モンスター！　%カード名%を특수소환だ！」
			ELSEIF GROUPMATCH(カードID,24603,24604,24605)
				PRINTFORMW 「きてくれ！　덱에서 %カード名%を특수 소환한다よ！」
			ELSE
				PRINTFORMW 「덱에서 %カード名%を특수 소환한다よ！」
			ENDIF
		;EX덱에서 
		CASE 召種EX덱
			PRINTFORMW 「よぉし！　EX덱에서 %カード名%を특수소환だ！」
		;묘지에서 
		CASE 召種묘지
			IF GROUPMATCH(カードID,24601,24602)
				PRINTFORMW 「묘지에서 蘇れ、ディフォーマーモンスター！　%カード名%、ズドーン！」
			ELSEIF GROUPMATCH(カードID,24007,24008)
				PRINTFORMW 「묘지에서 ！　%カード名%を특수소환！　ジャジャーン！」
			ELSEIF GROUPMATCH(カードID,24600,24606)
				PRINTFORMW 「묘지에서 튜너モンスター！　%カード名%を특수소환だ！」
			ELSEIF GROUPMATCH(カードID,24603,24604,24605)
				PRINTFORMW 「きてくれ！　묘지에서 %カード名%を특수 소환한다よ！」
			ELSE
				PRINTFORMW 「묘지에서 %カード名%を특수 소환한다よ！」
			ENDIF
		;제외状態から
		CASE 召種제외
			PRINTFORMW 「게임에서 제외されている%カード名%を필드에 특수 소환한다よ！」
		;主にトークン生成
		CASE 10
			IF カードID == 172652
				PRINTFORMW 「%カード名%を특수소환！　このトークンが존재하는 한、おれはEX덱에서 싱크로소환しか行うことができなくなるよ！」
			ELSEIF カードID == 2240
				PRINTFORMW 「一緒に戦ってくれ！　%カード名%を특수소환！」
			ELSE
				PRINTFORMW 「%カード名%を특수소환しちゃうよ！」
			ENDIF
	ENDSELECT
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K2535_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORMW 「몬스터를 의식소환！」
		CASE 융합
			PRINTFORMW 「몬스터를 융합소환！」
		CASE 싱크로
			IF カードID == 52460
				PRINTFORMW 「みんなに笑顔を届けるため、勇気とハートをチューンON！　싱크로소환！　愛と絆の戦士！　%カード名%！」
			ELSEIF カードID == 52601
				PRINTFORMW 「世界の平和を守るため、勇気と力をドッキング！　싱크로소환！　愛と正義の使者、%カード名%！」
			ELSEIF カードID == 50570
				PRINTFORMW 「世界の未来を守るため、勇気と力がレボリューション！　싱크로소환！　進化せよ、%カード名%！」
			ELSEIF カードID == 52602
				PRINTFORMW 「世界の明日を照らすため、勇気と力でイグニッション！　싱크로소환！　愛と正義の勇者、%カード名%！」
			ELSEIF カードID == 52603
				PRINTFORMW 「鋼の逆鱗に触れたいヤツはご自由に！　싱크로소환！　%カード名%！」
			ELSEIF カードID == 50560
				PRINTFORMW 「聖なる守護の光、今交わりて永久の命となる。싱크로소환！　守ってくれ、%カード名%！」
			ELSEIF カードID == 50572
				PRINTFORMW 「太古の森よりフィールドを制圧する精霊よ、かりそめの姿にその身をやつし降臨せよ！　싱크로소환！　%カード名%！」
			ELSEIF カードID == 52010
				PRINTFORMW 「黒き暴風よ、おれに力を貸してくれ！　싱크로소환！　現れろ、%カード名%！」
			ELSE
				PRINTFORMW 「みんなの笑顔を守るため、仲間のハートをドッキング！　싱크로소환！　%カード名%！」
			ENDIF
		CASE 엑시즈
			PRINTFORMW 「몬스터를 엑시즈소환！」
		CASE 링크
			PRINTFORMW 「몬스터를 링크マーカーにセット、링크소환！　%カード名%！！」
		;초차원モンスター（デュエマ）
		CASE 초차원
			PRINTFORMW 「초차원から、%カード名%を특수소환！　……かっちょいい～！」
	ENDSELECT
ENDIF

;==================================================
;4,효과使用宣言
;==================================================
@M_KOJO_DUEL_K2535_4(カードID,발동出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
#DIM DYNAMIC 발동出処
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 발동出処
		CASE 1
			;손패발동
			CASE 1
			IF カード種 == 装備마법
				PRINTFORMW 「よぉし！　필드의 モンスターに카드를 装備だ！」
			ELSE
				PRINTFORMW 「패에서 %カード名%의 효과를 발동するよ！」
			ENDIF
		;필드발동
			CASE 2
				PRINTFORMW 「필드의 %カード名%의 효과를 발동！」
		;마함발동
			CASE 3
			IF カード種 == 速攻마법
				PRINTFORMW 「速攻마법！　%カード名%を발동だ！」
			ELSEIF カード種 == 지속마법
				PRINTFORMW 「지속마법、%カード名%의 효과를 발동！」
			ELSEIF カード種 == 装備마법
				PRINTFORMW 「モンスターに装備された%カード名%의 효과를 발동！　ジャッキーン！」
			ELSEIF カード種 == フィールド
				PRINTFORMW 「フィールド마법、%カード名%의 효과를 발동！」
			ELSEIF カード種 == 通常함정
				PRINTFORMW 「な～にかな、な～にかなっ！　%カード名%！」
			ELSE
				PRINTFORMW 「%カード名%의 효과를 발동！」
			ENDIF
		;묘지발동
			CASE 4
				PRINTFORMW 「묘지의 %カード名%의 효과를 발동じゃん！」
	ENDSELECT
ENDIF



;==================================================
;5,효과발동
;==================================================
@M_KOJO_DUEL_K2535_5(カードID,효과종류)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC 효과종류
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	;無効にされた場合
	IF 효과종류 == -1
		PRINTFORMW 「そんな、ひどいよ～！？」
	;それ以外
	ELSE
		IF カードID == 24600 && 효과종류 == 필드起動
			PRINTFORMW 「공격 표시인 효과！　패에서 레벨４ディフォーマーを특수 소환한다よ！」
		ELSEIF カードID == 24602 && 효과종류 == 攻撃時誘発
			PRINTFORMW 「수비 표시인 이 카드가 필드에 いるとき、１턴에 １번、ディフォーマー몬스터는 攻撃を回避できる！」
		ELSEIF カードID == 24603 && 효과종류 == 필드起動
			PRINTFORMW 「いっくぞ～！　元祖ダイヤル・オン！」
		ELSEIF カードID == 24604 && 효과종류 == 필드起動
			PRINTFORMW 「いっくぞ～！　スマートダイヤル・オン！」
		ELSEIF カードID == 24605 && 효과종류 == 필드起動
			PRINTFORMW 「いっくぞ～！　テレホンダイヤル・オン！」
		ELSEIF カードID == 24606 && 효과종류 == 필드起動
			PRINTFORMW 「ディフォーマー카드를 패에 加えたあと、一枚덱に戻すよ！」
		ELSEIF カードID == 52460 && GROUPMATCH(효과종류,특수소환時,EX소환時)
			PRINTFORMW 「이 카드가 특수 소환한 とき、필드의 モンスター一体をこのターン튜너として扱う！　チューンアップだ%カード名%！」
		ELSEIF カードID == 52460 && GROUPMATCH(효과종류,필드起動,묘지起動)
			PRINTFORMW 「싱크로モンスター一体に이 카드를 装備！　イクイップ・コンバート！」
		ELSEIF カードID == 52460 && 효과종류 == 손패起動
			PRINTFORMW 「%カード名%が装備された몬스터가 상대を戦闘で倒したとき、続けて攻撃できる！　テンション・アップ！」
		ELSEIF カードID == 52601 && 효과종류 == 필드起動
			PRINTFORMW 「덱에서 装備카드를 一枚、おれの패에 加えちゃうよ！　パワー・サーチ！」
		ELSEIF カードID == 52601 && 효과종류 == 필드起動
			PRINTFORMW 「パワー・ツールは装備を犠牲に하는 것으로、破壊に耐える力を持つ！　がんばってくれ、%カード名%！」
		ELSEIF カードID == 50570 && 효과종류 == EX소환時
			PRINTFORMW 「%カード名%は싱크로소환成功時、プレイヤーの라이프를4000にできる！　ライフ・エクストリーム！」
		ELSEIF カードID == 50570 && 효과종류 == 필드起動
			PRINTFORMW 「묘지에서 레벨１の몬스터 １장을 특수소환できる！　さらに進化だ、%カード名%！」
		ELSEIF カードID == 52062 && GROUPMATCH(효과종류,특수소환時,EX소환時)
			PRINTFORML 「이 카드가 특수 소환에 성공한 とき、装備카드를 덱と묘지에서 ３장까지 選んで、装備できる！　
			PRINTFORMW 　いくぞ%カード名%！　ブレイブ・パワー・サーチ！！」
		ELSEIF カードID == 52062 && GROUPMATCH(효과종류,필드起動,フリー誘発)
			PRINTFORML 「이 카드는 필드의 装備카드를 一つ묘지로 보내고、상대의 몬스터의 표시形式を변경するか、효과를 無効にするかのどちらかを발동할 수 있다！
			PRINTFORMW 　いっけぇ%カード名%！　パワーツール・ブレイク！」
		ELSEIF カードID == 52603 && 효과종류 == 효과後誘発
			PRINTFORMW 「こいつは装備카드가 装備されたとき、ドローできる！　装備特典！」
		ELSEIF カードID == 52603 && GROUPMATCH(효과종류,필드起動,フリー誘発)
			PRINTFORMW 「%カード名%は装備카드를 奪えるんだ！　装備強奪！」
		ELSEIF カードID == 50560 && 효과종류 == EX소환時
			PRINTFORMW 「フィールド마법を모두 파괴하고、おれのLPを1000회복する！　プレイン・バック！」
		ELSEIF カードID == 50560 && 효과종류 == 필드起動
			PRINTFORMW 「このターンおれはバトルフェイズを行えなくなるけど、そのかわり패에서 レベルが４이하의 몬스터를 특수소환できるんだ！　へへっ、すごい효과だろ！」
		ELSEIF カードID == 50572 && 효과종류 == 효과後誘発
			PRINTFORMW 「この%カード名%はフィールド마법が발동すると、덱에서 ドローできるんだ！」
		ELSEIF カードID == 50572 && 효과종류 == 필드起動
			PRINTFORMW 「フィールド마법が存在するとき、モンスター一体を破壊できる！　妖精靭尾！」
		ELSEIF カードID == 72650
			PRINTFORMW 「こいつは%カード名%！　装備몬스터의 표시形式で효과가 変わる、すげぇ装備カードなんだ！」
		ELSEIF カードID == 72651
			PRINTFORMW 「기계족 몬스터를 대상にとり、その표시形式によって효과가 変化する！　さぁなーにかな、なーにかなっ！」
		ELSEIF カードID == 72652 && 효과종류 == 마함起動
			PRINTFORMW 「へへっ、이 카드는 필드에 ガジェット・ボックス・トークンを生み出すことができるんだ！」
		ELSEIF カードID == 72653 && GROUPMATCH(효과종류,마함起動,손패起動)
			PRINTFORMW 「패에서 ディフォーマーを一枚묘지로 보내고、묘지의 기계족一体をリペアするよ！　さぁ蘇れ！」
		ELSEIF カードID == 72653 && 효과종류 == 戦破壊→묘지
			PRINTFORMW 「%カード名%は破壊されることで게임에서 제외されているディフォーマー몬스터를 특수소환できる！　さぁ戻ってこーい！」
		ELSEIF カードID == 24007 && 효과종류 == 소환時
			PRINTFORMW 「이 카드가 소환したとき、덱에서 レベルが１の기계족 몬스터를 패에 加える！　シャッキーン！」
		ELSEIF カードID == 24007 && 효과종류 == 필드起動
			PRINTFORML 「이 카드를 릴리스하고 、패에서 ディフォーマー몬스터를 특수 소환하고、さらに추가でガジェット・トレーラーを呼び出すことが出来る！
