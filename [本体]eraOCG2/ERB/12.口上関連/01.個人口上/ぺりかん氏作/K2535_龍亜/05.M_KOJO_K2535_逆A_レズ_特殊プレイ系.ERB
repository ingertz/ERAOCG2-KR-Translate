	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「なっ……！？　お、おれのチンチンにさわって、どうするんだよ……！？」
		SIF EXP:TARGET:사정경험 == 0
		PRINTFORMW 「うわぁ……っ！？　な、なに！？　おれのチンチンからっ、なにか、なにかドクドク駆け上がってくる……っ！？」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「もっと触ってぇ❤　おれ、%CALLNAME:MASTER%の手で사정したいよぉ❤」
			CASE 1
				IF TALENT:MASTER:성별 == 0
					PRINTFORML 「……な、なぁ……やっぱ%CALLNAME:MASTER%ってこういうのも경험豊富なの……？」
					PRINTFORMW 「ちょ！？　か、カワイイなんて……うわぁ❤　手がぁ❤　はげし、はげしいっ❤　イクッ❤　チンチンいっちゃうううぅぅ❤」
				ELSE
					PRINTFORML 「な、なぁ……やっぱ자신のチンチンで気持ちいいとこ勉強したの？　そ、そうなんだ……❤」
					PRINTFORMW 「お、おれも……っ❤　おれも%CALLNAME:MASTER%のチンチン気持ちよく出来るようになるからなっ❤　ちょ、そんなっ❤　微笑ましそうに見るなよぉ❤」
				ENDIF
			CASE 2
				PRINTFORMW 「だ、ダメだよっ❤　おれ、このままじゃ%CALLNAME:MASTER%の手を汚しちゃう❤　あっ❤　は、早くしないでぇ❤　こんなのガマンできないよぉ❤」
		ENDSELECT
		RETURN 1
	;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「さわるなぁ……！　チンチンさわるなよぉ……！？」
			CASE 1
				PRINTFORMW 「き、気持ちよくなんかない！？　こんなのが気持ちいいわけないだろう！？」
			CASE 2
				PRINTFORMW 「お、おれのチンチン、どんどん膨らんできた……！？　%CALLNAME:MASTER%、何をしたんだよ……っ！？」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1
