;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
			PRINTFORMW 「いいの？　おれ、%CALLNAME:MASTER%のお尻を好きにしちゃうよ……❤」
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%のお尻を～！？　な、なんでだよぉ……！」
			SIF EXP:TARGET:Ａ경험 != 0
			PRINTFORMW 「おれがされたのを思い出してって……わ、わぁ～！？　お、思い出させないでよ……！」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		IF ABL:TARGET:기교 > 2
			PRINTFORM 「へへっ❤　ど～だ、気持ちいいだろっ❤
			IF ABL:TARGET:Ａ감각 > 2
			PRINTFORMW 　%CALLNAME:MASTER%にしてもらったコトを、ちゃんと活かしてるんだっ❤　どう？　おれ、エライでしょっ❤」
			ELSE
			PRINTFORMW 　大事なのは%CALLNAME:MASTER%を思いやる気持ちだよなっ❤　優しく……だけどイケるように……❤　おれ、まだまだ頑張るよっ❤」
			ENDIF
		ELSE
			PRINTFORMW 「あっ！？　い、痛かったらゴメン……お詫びに、あとでオシオキしてよ……❤　とびっきり痛くしていいから、さ……❤」
		ENDIF
		RETURN 1
	;それ以外
	ELSE
		PRINTFORML 「うぅ、クサイ……こんなの、ほんとに気持ちいいの？」
		IF TALENT:MASTER:성별 == 0
			PRINTFORMW 「……うわぁ、なんだか濡れてきたよ……？　ほんとに気持ちいいんだ……」
		ELSE
			PRINTFORMW 「……うわぁ、チンチンがビクビクしてる……ほんとに気持ちいいんだ……」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1
