;====================================================================
;64,逆レイプする
;紛らわしいが女あなたが上に乗るのであり、あなたが襲われるわけではない
;====================================================================
@M_KOJO_MESSAGE_COM_K2535_64
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2535_64_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2535_64_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;조교者が처녀
		IF TCVAR:MASTER:파과 == 1
			PRINTFORMW 「%CALLNAME:MASTER%！？　血、血がでてるよっ！？」
			RETURN 1
		ELSE
			PRINTFORMW 「うわぁ！？　お、オカシイよ%CSTR:TARGET:MASCALL%……っ。ち、チンチンが熱くて、柔らかいのに包まれて……気持ちよすぎてなんだか怖いよぉ……っ」
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;삽입継続
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:MASTER:100 == TARGET
		;前回사정した
		IF TCVAR:질내사정플래그 
			IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
				PRINTFORML 「や、やめてぇ❤　たった今、사정したばっかだって知ってるでしょ！？　そんなすぐに、できないってばぁ……❤」
				PRINTFORMW 「ひゃああっ❤　み、耳に囁かないで……っ❤　こ、こんなときだけ男の子扱いしてっ、見てろよおれ、だってぇ……❤」
			ELSE
				PRINTFORMW 「うわぁ！？　だ、사정したばっかりだって……っ、無理だよ……っ、止まってってばぁ……っ！？」
			ENDIF
			RETURN 1
		ELSE
			SELECTCASE RAND:3
				CASE 0
					IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
						PRINTFORML 「き、気持ちいいっ❤　%CALLNAME:MASTER%のナカ、気持ちいいよぉ❤　사정るっ❤　사정していいよねっ❤
						PRINTFORMW 　……えっ！？　そんな、お預け！？　%CALLNAME:TARGET%ならもっとガマンできるってそんな勝手な……っ❤　あっ❤　ダメだっ❤　ガマンなんてぇ……❤」
					ELSE
						PRINTFORMW 「わ、わかんないっ！？　わかんないよぉ！？　チンチンが熱くて気持ちよくて、おれ、どうしちゃったのさぁ！？」
					ENDIF
				CASE 1
					IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
						PRINTFORML 「お、おれだって……っ❤　おれだって%CALLNAME:MASTER%を気持ちよくさせてみせる……っ❤　ヤラれっぱなしで終わるもんかぁ……っ❤
						PRINTFORMW 　あぁっ❤　だ、ダメだぁ❤　おれのチンチンっ❤　小さすぎて上手く、いかないっ❤　ダメだっ❤　%CALLNAME:MASTER%に負けちゃう……っ❤」
					ELSE
						PRINTFORMW 「お、おれだって……！　訳わかんないけど%CALLNAME:MASTER%のヤラれっぱなしでたまるかぁ……っ！　ふん！　ふん！　ど、どうだ……っ」
					ENDIF
				CASE 2
					IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
						PRINTFORML 「%CALLNAME:MASTER%っ❤　%CALLNAME:MASTER%好きっ❤　お、おれ頑張るからっ❤　まだ子供でちんちんも小さいけどっ❤　いつか%CALLNAME:MASTER%も만족させられるよう頑張るからっ❤
						PRINTFORMDW 必死に腰をヘコヘコさせる%CALLNAME:TARGET%。その頭を撫でてやると、腟内で可愛らしい肉棒が「ビクンっ！」と跳ね上がった……
					ELSE
						PRINTFORMW 「うわぁ！？　%CALLNAME:MASTER%にい、一方的に搾り取られるぅ！」
					ENDIF
			ENDSELECT
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		PRINTFORMW 「こ、今度こそ%CALLNAME:MASTER%に負けないぞ……っ❤　こ、今度こそ、今度こそ……っ❤」
		RETURN 1

	;それ以外
	ELSE
		PRINTFORMW 「うわぁ！？　また%CALLNAME:MASTER%に襲われる……っ！？」
		RETURN 1
	ENDIF
ENDIF
RETURN 1

