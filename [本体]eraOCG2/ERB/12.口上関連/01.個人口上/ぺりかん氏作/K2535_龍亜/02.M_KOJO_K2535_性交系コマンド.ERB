;※※※※※※※※※※※※※※※※※※※※※※※※※
;성교系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;全て *삽입をする時* の구상のため、気持ちいい所を抉ったり、子宮を潰したい時は파생コマンドへ
;Ａ系は파생しないため、삽입継続で喘がせるといい感じになる
;==================================================
;60,정상위
;==================================================
@M_KOJO_MESSAGE_COM_K2535_60
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2535_60_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2535_60_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;정상위
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;처녀
		IF TCVAR:파과 == 1
			CALL M_KOJO_MESSAGE_COM_K2535_SHOJO_BREAK
			RETURN 1
		ELSE
			IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
				PRINTFORML 「お願い、いっきに来て……❤　おれをオンナのコにして……❤」
				PRINTFORMW 「あ゛あっ❤　チンチン、삽입ってるぅ❤　龍可ぁ❤　おれ、お姉ちゃんになっちゃったぁ❤」
			ELSE
				PRINTFORML 「まって！？　おれを押さえつけてなにをするつもりなのさ%CALLNAME:MASTER%！？」
				PRINTFORMW 「ぐ！？　ぎぃぃ……っ！？　なんでぇ……なんでこんなことするのさ……！？」
			ENDIF
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;삽입継続
	;삽입したままこの체위に切り替える
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:V삽입관리플래그 == MASTER
		;前回사정した
		IF TCVAR:질내사정플래그 
			CALL M_KOJO_MESSAGE_COM_K2535_SEXCHANGE_2
			RETURN 1
		ELSE
			CALL M_KOJO_MESSAGE_COM_K2535_SEXCHANGE_1
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	호감도修正 = 1
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 0
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
				PRINTFORMW 「へへ……❤　この체위、いいよな❤　ラブラブってかんじでさ……❤」
			ELSE
				PRINTFORML 「……見るなぁ……！　お、おれは男だ……っ、オンナのコじゃ、ないのにぃ……！」
				PRINTFORMDW 顔を隠し強情に男と言い張る%CALLNAME:TARGET%。そんな「彼」の「オマンコ」に肉棒をあてがい、たっぷりと「オンナのコ」の悦びを教えてやった……
			ENDIF
		CASE 2
			PRINTFORMW 「あ゛っ❤　ナカにきたぁ❤　へへ、なんでおれ、男って言い張ってたんだろう❤」
		CASE 3
			PRINTFORMW 「おれのナカ、気持ちよかったらいつでも사정してくれよな❤　だいじょうぶ、おれは「男」だから임신なんかしないってっ❤」
	ENDSELECT
ENDIF
RETURN 1

