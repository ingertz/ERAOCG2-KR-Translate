;==================================================
;480,デュエル
;勝敗はプレイヤーから見てのもの
;TFLAG:SELECTCOM분기(1=通常승리 2=通常패배 3=引き分け
;10=通常듀얼前 11=パック賭け듀얼前 12=デート賭け듀얼前 13=パンツ賭け듀얼前 14=お持ち帰り듀얼前 15=お前モンスターじゃないか？ 16=スケベ要求듀얼前 20=闇のゲーム
;31=パック賭け승리 32=デート賭け승리 33=パンツ賭け승리 34=お持ち帰り成功 35=カード化승리（牝以外） 36=スケベ要求事後 40=罰ゲーム！
;135=カード化見逃す 235=穏便カード化 335=凌辱後カード化 435=凌辱後見逃す
;50=賭け듀얼패배怒られた 51=パック賭け패배 52=デート패배デート 55=カード化패배 56=スケベ要求패배 156=スケベ要求弱味削除 256=スケベ要求패배패배버릇付きおねだり)
;==================================================
@M_KOJO_MESSAGE_COM_K2535_480
;デュエルにTRAIN_MESSAGEはない
CALL M_KOJO_MESSAGE_COM_K2535_480_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2535_480_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;これが０の時はデュエルしない時なのでおわり
	SIF TFLAG:SELECTCOM분기 == 0
		RETURN 1

	;デュエル前
	IF INRANGE(TFLAG:SELECTCOM분기,10,21)
		SELECTCASE TFLAG:SELECTCOM분기
			;通常듀얼
			CASE 10
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「おれのカッコいいモンスター、見せちゃうもんね！　デュエルだ！」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORMW 「おれが強くなったとこ、いつか遊星たちに見せるんだ……！　デュエル！」
						ELSE
							PRINTFORMW 「おれも最強チームの一員だったんだ、ヘマはしないぞ！」
						ENDIF
					CASE 2
						IF CFLAG:MASTER:듀얼레이트 >= 6000 || TALENT:MASTER:수라
							PRINTFORML 「怖くないって言ったらウソになるけど……だけどワクワクしてるんだ」
							PRINTFORMW 「こんなに強そうな%CALLNAME:MASTER%に勝っちゃったら、つまりおれは強いってことでしょ？　よぉし、やるぞ～！」
						ELSE
							PRINTFORMW 「ほんとに%CALLNAME:MASTER%って強いの～？　おれがデュエルで確かめてやる！」
						ENDIF
				ENDSELECT
			
			;ここから賭け듀얼
			;パック賭け
			CASE 11
				PRINTFORMW 「え～！　パックなんか賭けちゃって大丈夫なの～？　おれが勝っちゃうもんね！」
			;デート賭け
			CASE 12
				PRINTFORMW 「龍可みたいに長い時間つきあわされるのは簡便だよ～！？　こうなったらデュエルで勝ってやる！」
			;パンツ賭け
			CASE 13
				PRINTFORMW 「え～！？　パンツなんか賭けて、なにがしたいのさ～！？」
			;お持ち帰り
			CASE 14
				PRINTFORMW 「おれが負けたら%CALLNAME:MASTER%の家に？　じゃあおれが勝ったらおれの家に来てよ！」
			;モンスターか問い詰める（人間は불가）
			CASE 15
				PRINTFORMW 
			;スケベ強要
			CASE 16
				IF TALENT:TARGET:패배버릇
					PRINTFORMW 「う、うん……❤　負けたら、またそういうコトしてもらえるんだね❤　ま、負けないよ……❤」
				ELSEIF CFLAG:TARGET:약점장악 == 1
					IF EXP:TARGET:패배조교경험 >= 1
						PRINTFORMW 「……わ～！？　そ、そんな恥ずかしい写真、残しておくわけにはいかない……！　デュエルだ！」
					ELSE
						PRINTFORMW 「……そ、そんな脅しには屈しないぞ！　おれはヒーローになるんだ！」
					ENDIF
				ELSE
					PRINTFORMW 「えぇ～！？　そんなにお金があったらあのパックも買い放題じゃん！　デュエル、やるやる！」
				ENDIF
			;闇のゲーム
			CASE 20
				PRINTFORMW 「な、なに……？　もしかしてダークシグナー……！？」
		ENDSELECT

	;デュエル後
	ELSE
		SELECTCASE TFLAG:SELECTCOM분기
			;通常승리
			CASE 1
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「くっそ～、負けた～！　……あ、挨拶はちゃんとしないと。デュエルありがとう！　次は絶対、勝つからね！」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORML 「負けた～！　……次のドローなんだったんだろう」
							PRINTFORMW 「う～ん、あと１ターン持ちこたえられたらな～。まだまだ、頑張らなきゃ！」
						ELSE
							PRINTFORML 「負けた～！　……次のドローなんだったんだろう」
							PRINTFORMW 「あ～ん、もっと早くコイツがきてくれたらな～！？　クッソ～、くやし～！」
						ENDIF
					CASE 2
						IF CFLAG:MASTER:듀얼레이트 >= 6000 || TALENT:MASTER:수라
							PRINTFORML 「やっぱり%CALLNAME:MASTER%は強いよ！　おれだっていつか%CALLNAME:MASTER%に並ぶ……ううん、超えてやるんだ！」
							PRINTFORMW 「そうしたらきっと遊星やジャックにだって勝てる日がくるはず……！　よぉし、頑張るぞ～！」
						ELSE
							PRINTFORMW 「うわ～！？　カード텍스트を読んでる間に負けた～！　そ、そんなのインチキだ～！」
						ENDIF
				ENDSELECT
			;通常패배
			CASE 2
				SELECTCASE RAND:3
					CASE 0
						PRINTFORMW 「やったぁ～！　やっぱ勝つって気持ちいいね！」
					CASE 1
						IF EXP:TARGET:듀얼경험 >= 15
							PRINTFORMW 「勝ちたいって気持ち、よくわかるよ……。だから、おれも負けられないんだ……！」
						ELSE
							PRINTFORMW 「へへ、おれだってチームファイブディーズのひとりだったんだ！　そう簡単には負けられないよね……！」
						ENDIF
					CASE 2
						IF CFLAG:MASTER:듀얼레이트 >= 6000 || TALENT:MASTER:수라
							PRINTFORML 「やった……！　やったぁ！　%CALLNAME:MASTER%に勝てちゃった～！」
							PRINTFORMW 「やっぱり諦めないって大事だよね！　信じていれば必ずカードは応えてくれるんだ！」
						ELSE
							PRINTFORMW 「へへへーんだ！　悔しかったらいつでも再戦うけつけちゃうもんね～！」
						ENDIF
				ENDSELECT
			;通常引き分け
			CASE 3
				PRINTFORMW 「……え～！　引き分け！？　むぅ、納得いかないよ！　%CALLNAME:MASTER%、もう一度デュエルしよ！」

			;ここから賭け승리
			;パック賭け
			CASE 31
				PRINTFORMW 「くっそ～！　わかってる、はい約束のパックだよ……ねぇねぇ、良いカード引けた？」
			;デート賭け
			CASE 32
				PRINTFORMW 「負けた～！？　しょうがないな～%CALLNAME:MASTER%に付き合ってやるよ」
			;パンツ賭け
			CASE 33
				PRINTFORMW 「はいこれ……龍可にどう言い訳しよう」
			;お持ち帰り
			CASE 34
				PRINTFORMW 「しょ～がないな～！　じゃ、%CALLNAME:MASTER%の家にお邪魔させてもらうね！」
			;下二桁３５は"モンスターか問い詰める"の분기
			;カード化（牝以外、選択肢無し）
			CASE 35
				PRINTFORMW 
			;カード化を見逃す（元気でな！）
			CASE 135
				PRINTFORMW 
			;穏便に話してカード化（怖くないよ～痛くないよ～）
			CASE 235
				PRINTFORMW 
			;身体を対価に見逃す（見逃すとは言ってない）
			CASE 335
				PRINTFORMW 
			;身体を対価に見逃す（見逃す）（패배버릇付いたり弱み握られたりする）
			CASE 435
				PRINTFORMW 
			;身体要求事後
			CASE 36
				IF TALENT:TARGET:패배버릇
					PRINTFORML 「……つ、次こそ勝つから❤　次こそ%CALLNAME:MASTER%に勝って……❤　おれ、もう一度ヒーローになるんだ……❤」
					PRINTFORM 口でこそ勇ましいが、顔を赤らめた%CALLNAME:TARGET%からその気概は感じられない……その証拠に
					IF TALENT:TARGET:성별 == 0
						PRINTFORM すっかり元の성별から変えられた股間から、オンナのコの悦びに溢れた愛液がドプドプと垂れ流されている……
					ELSE
						PRINTFORMW その股間から生えたモノは小さいながらもギンギンに勃ち、鈴口からは漏らしたようにザーメンがチロチロと垂れ流されている……
					ENDIF
				ELSE
					PRINTFORML 「……遊星……龍可……どうしよう……おれ……」
					PRINTFORMW 「おれ、こんなんじゃ……ヒーローなんてなれないよ……」
				ENDIF
			;闇のゲーム
			CASE 40
				PRINTFORMW 「うわぁ！？　せ、せめて遊星たちに連絡を──」

			;ここから賭け패배
			;怒られた
			CASE 50
				PRINTFORMW 「も～！　デュエルに変なもの、持ち込まないでよ！」
			;パック賭け（パックを手渡す）
			CASE 51
				PRINTFORMW 「へへっ♪　やりぃ～！　もしダブったカードがでたら%CALLNAME:MASTER%にあげてもいいよ～？」
			;デート賭け（デートはしてくれる）
			CASE 52
				PRINTFORMW 「よっしゃ～！　……も～、そんな顔しないでよ！　そんなにおれと一緒に出かけたかったの？」
			;カード化패배（逃げられた）
			CASE 55
				PRINTFORMW 
			;身体要求패배（金払う）
			CASE 56
				PRINTFORMW 「やったぁ！　じゃ、早速なにを買おっかな～！　……あ、でも龍可にバレたらうるさいしなー……やっぱカードかな？」
			;身体要求패배（弱味削除）
			CASE 156
				PRINTFORMW 「よ、よぉし……！　これでもう、%CALLNAME:MASTER%の言いようにはされないんだからな……！」
			;身体要求패배（패배버릇付いてる時限定凌辱おねだり）（ラブホ直行）
			CASE 256
				PRINTFORML 「え……？　あれ、おれ、勝った……？　勝っちゃった、の……？　なんで、あれ、じゃあオシオキは……？」
				PRINTFORMW 「や、やだ！　け、消さないで！　ほ、ほら、おれまだ一回しか勝ってないし、最初のほうなんて生意気だったから%CALLNAME:MASTER%も気持ちよくなかったでしょ！？　だからノーカンだって！」
				PRINTFORMW 「だ、だから……❤　今回が、その埋め合わせってことで、実質引き分け……❤　引き分けってことはつまりおれの負けだよ、きっと……❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

