@M_KOJO_MESSAGE_COM_K2535_312_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
			;龍亞が男
			IF TALENT:TARGET:성별 == 2
				IF TALENT:MASTER:성별 == 2
					PRINTFORMW 「んぶっ！？　も、もう急に키스なんてするなよ……❤　え、おれと%CALLNAME:MASTER%は男同士？　へへ、そんなの関係ないだろ……❤」
				ELSE
					PRINTFORMW 「んぶっ！？　な、なんだよそんなにおれと키스したかったの❤　いいよ%CALLNAME:MASTER%とならおれ、もっと키스したい……❤」
				ENDIF
			;龍亞が女
			ELSE 
				IF TALENT:MASTER:성별 == 2 ;
					PRINTFORML 「んぶっ！？　なんだよ、%CALLNAME:MASTER%ったらそんなにおれと키스したかったの……❤
					PRINTFORMW 　え、別におかしくないだろ？　好きあってる男女が키스するなんてさ……❤」
				ELSE
					PRINTFORMW 「んぶっ！？　へへっ、%CALLNAME:MASTER%ったらそんなにおれと키스したかったんだ……❤　いいよ、いっぱい키스してよ……❤」
				ENDIF
			ENDIF
		ELSE
			;龍亞が男
			IF TALENT:TARGET:성별 == 2
				IF TALENT:MASTER:성별 == 2
					PRINTFORMW 「んぶっ！？　な、なんで키스なんか……！　お、おれも%CALLNAME:MASTER%も男同士だろ！？」
				ELSE
					PRINTFORMW 「んぶっ！？　な、なんで키스なんか……！　こ、こういうのは好きあってるもの同士でやるものだろ！？」
				ENDIF
			;龍亞が女
			ELSE 
				IF TALENT:MASTER:성별 == 2 ;
					PRINTFORMW 「んぶっ！？　お、男同士で키스なんか変だよ……！　ち、ちがう！　おれは女じゃない男だ……！」
				ELSE
					PRINTFORMW 「んぶっ！？　な、なんで키스なんか……！　女同士で키스なんて……い、いや違う！　おれは男だ……！」
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2 || CFLAG:TARGET:호감도 > 5000
		호감도修正 += 0
	SIF TALENT:TARGET:연모 >= 1 || TALENT:TARGET:굴복됨
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
		IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
			;龍亞が男
			IF TALENT:TARGET:성별 == 2
				PRINTFORML 「ちゅっ……❤　へへ、おれも키스、うまくなっただろ？　%CALLNAME:MASTER%にたくさん、教えてもらったからな……❤」
				IF TALENT:MASTER:성별 == 2
					PRINTFORMW 「男同士でも好きならいいよね……❤　もっと、もっと키스しようよ%CALLNAME:MASTER%❤　ちゅっ❤　ぶちゅぅ❤」	
				ELSE
					PRINTFORMW 「好きぃ……❤　おれ、%CALLNAME:MASTER%のこと大好きぃ❤　키스……❤　もっと키스したいよ……❤」
				ENDIF
			;龍亞が女
			ELSE 
				PRINTFORML 「ちゅっ……❤　へへ、おれも키스、うまくなっただろ？　%CALLNAME:MASTER%にたくさん教えてもらったからね……❤」
				IF TALENT:MASTER:성별 == 2 ;
					PRINTFORMW 「もっと……❤　もっとおれに教えてくれよ%CALLNAME:MASTER%❤　おれに「オンナのコ」の悦びってやつをさ……❤」
				ELSE
					PRINTFORMW 「もっと……❤　もっと%CALLNAME:MASTER%と키스したいんだ……❤　オンナのコ同士でも、好きならいいよね……❤」
				ENDIF
			ENDIF
		ELSE
			;龍亞が男
			IF TALENT:TARGET:성별 == 2
				IF TALENT:MASTER:성별 == 2
					PRINTFORMW 「うぅ、絶対おかしいよ……。男と男で키스するなんておれ、聞いたことないよ……！」
				ELSE
					PRINTFORMW 「んんっ！？　そ、そんなにおれと키스したかったの……？」
				ENDIF
			;龍亞が女
			ELSE 
				IF TALENT:MASTER:성별 == 2 ;
					PRINTFORMW 「お、おれは男だ！　女の子じゃない……！　やだ、키스なんて……っ！　んっ！？　んん～っ！！」
				ELSE
					PRINTFORMW 「べ、別におれが男のままでいいじゃんか！　なんで女の子同士で……んっ！？　んん～っ！！」
				ENDIF
			ENDIF
		ENDIF
		CASE 2
		IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
			;龍亞が男
			IF TALENT:TARGET:성별 == 2
				IF TALENT:MASTER:성별 == 2
					PRINTFORMW 「へへ……❤　%CALLNAME:MASTER%と키스すると、おれの胸がポカポカするんだ❤　男同士なのにオカシイかな……？　んあっ！　んちゅっ❤　……へへ、%CALLNAME:MASTER%もおんなじなんだ❤」	
				ELSE
					PRINTFORMW 「%CALLNAME:MASTER%に키스してもらうと、胸が熱くなってくるんだ……もしかしてコレが恋、なのかな……──んんっ❤　ちゅっ❤　ちゅぅ❤　……へへ、もっと、しよーよ……❤」
				ENDIF
			;龍亞が女
			ELSE
				IF TALENT:MASTER:성별 == 2 ;
					PRINTFORMW 「おれ、%CALLNAME:MASTER%にオンナのコにしてもらってよかった……❤　だって男のままだとこんなに%CALLNAME:MASTER%から愛してもらえないもん……❤」
				ELSE
					PRINTFORML 「おれ、%CALLNAME:MASTER%にオンナのコにしてもらってよかった……❤　だって%CALLNAME:MASTER%からしてもらえる키스、気持ちいいんもん……❤
					PRINTFORMW 　男のクセに%CALLNAME:MASTER%から키스してもらえるのを待つ、なんて男らしくないよな……❤　だからおれ、オンナのコになる運命だったんだよ……❤」
				ENDIF
			ENDIF
		ELSE
			;龍亞が男
			IF TALENT:TARGET:성별 == 2
				IF TALENT:MASTER:성별 == 2
					PRINTFORMW 「やだ……っ！　%CALLNAME:MASTER%と키스なんて、やだぁ……！」
				ELSE
					PRINTFORMW 「き、키스って好きな人同士でやるもんなんだろ！？　アキ姉ちゃんが言ってた！」
				ENDIF
			;龍亞が女
			ELSE 
				IF TALENT:MASTER:성별 == 2 ;
					PRINTFORMW 「な、なんでおれを女に……！　お、おれが好きだからやった！？　そ、そんな理由で……──んむぅ！？」
				ELSE
					PRINTFORML 「き、키스って好きな人同士でやるもんだろ！？　%CALLNAME:MASTER%なんて大嫌いだ！
					PRINTFORMW 　……そ、そんな悲しそうな顔すんなよ……っ。だ、だっておれを女にするやつを、どうやって好きになればいいんだよぉ……」
				ENDIF
			ENDIF
		ENDIF
		CASE 3
		IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
			;龍亞が男
			IF TALENT:TARGET:성별 == 2
			PRINTFORML 「うん……❤　龍可は気づいてないと思う……❤　おれと%CALLNAME:MASTER%が、こんなに키스する関係なんだって……❤」	
				IF TALENT:TARGET:성별 == 2
					PRINTFORMW 「知ったらあいつ、ビックリするだろうなぁ❤　アニキが男と、키스をしてるなんてさ❤　おれだってつい最近まで、想像してなかったよ……❤」
				ELSE
					PRINTFORMW 「たまに龍可の唇も見たりするんだけどさ……❤　やっぱ妹と%CALLNAME:MASTER%は違うんだな❤　やっぱ키스は好きな人だからしたいって感じるんだ……❤」
				ENDIF
			;龍亞が女
			ELSE 
				PRINTFORML 「うん……❤　おれがオンナのコのカラダだって、龍可には気づかれてないよ❤　あいつも鈍いよなぁ❤」
				IF TALENT:MASTER:성별 == 2 ;
					PRINTFORMW 「……なぁ。おれって龍可の代わりなの？　龍可とほんとは키스したいんじゃないの……？　あっ❤　へへ、余計なコト、考えなくていいよね……❤」
				ELSE
					PRINTFORMW 「……なぁ。どうしておれをオンナのコにしたの？　オンナのコのほうが似合ってると思ったから？　へへ、それなら嬉しいなぁ❤」
				ENDIF
			ENDIF
		ELSE
			;龍亞が男
			PRINTFORM 「誰かに相談……ってできるわけないだろ！？　
			IF TALENT:TARGET:성별 == 2
				IF TALENT:MASTER:성별 == 2
					PRINTFORML お、男に키스されちゃった、なんて龍可に知られちゃったら、おれ、もうお兄ちゃんできなくなっちゃう……！」
				ELSE
					PRINTFORML お、女に抵抗できずに키스されちゃった、なんて龍可に知られちゃったら、おれ、一生からかわれちゃう……！」
				ENDIF
			;龍亞が女
			ELSE 
			PRINTFORM た、ただでさえカラダが女になったことは龍可に秘密なのにさ……！　その上
				IF TALENT:MASTER:성별 == 2 
					PRINTFORM 男
				ELSE
					PRINTFORM %CALLNAME:MASTER%
				ENDIF
				PRINTFORML と키스したなんて知られちゃったら……変な目で見られちまうよ～！？」
			ENDIF
			PRINTFORMDW ではこの事実を公表されたくなければ黙って키스を受け入れるんだな……。ニヤリとほくそ笑みながら脅すと、%CALLNAME:TARGET%は悔しそうに顔を伏せた
		ENDIF
		;연모
		CASE 4
			IF TALENT:TARGET:성별 == 2
				IF TALENT:MASTER:성별 == 2
					PRINTFORMW 「%CALLNAME:MASTER%……❤　おれに키스、して……❤　……おれがオンナのコみたい？　へへ、おれをそうしたのは%CALLNAME:MASTER%じゃんかぁ……❤」
				ELSE
					PRINTFORML 「%CALLNAME:MASTER%……❤　おれに키스、して……❤　……全然男らしくない？　%CALLNAME:MASTER%は男らしくないおれはイヤ……？」
					PRINTFORMDW 不安そうに目を潤ませる%CALLNAME:TARGET%。こちらから키스をしてやると、「あ……❤」と嬉しそうに受け入れた……
				ENDIF
			;龍亞が女
			ELSE 
				PRINTFORML 「おれ、不安なんだ……オンナのコのカラダにされて、%CALLNAME:MASTER%から見捨てられたら生きていけないよ……」
				PRINTFORMW 「だから키스、してほしい……❤　うぅん、키스だけじゃなくておれのカラダを全て好きにして……❤　おれを一生、%CALLNAME:MASTER%につなぎとめてほしい……❤」
			ENDIF
		CASE 5
			PRINTFORML 「ずっと疑問だったんだ。テレビとかで大人はすぐに키스するけど、あれの何が楽しいのって」
			PRINTFORMW 「実際にやってみないとわからないことばっかりだね。……ねぇ、もっかい키스していい？」
		CASE 6
			PRINTFORMW 
		CASE 7
			PRINTFORMW 
		;親愛
		CASE 8
			PRINTFORMW 
		CASE 9
			PRINTFORMW 
		;애처
		CASE 10
			PRINTFORMW 
	ENDSELECT
ENDIF
RETURN 1
