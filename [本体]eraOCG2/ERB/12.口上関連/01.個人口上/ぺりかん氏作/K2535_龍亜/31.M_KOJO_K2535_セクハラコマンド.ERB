;==================================================
;310,尻を撫でる
;ABL:친밀(2以下=不快(TALENT:臆病なら涙目) 3以上=恥ずかしがる(TALENT:男嫌い兼MASTERが男なら、身をすくめる) 6以上=されるがまま)
;CFLAG:우후후==2&&TCVAR:TARGET:CT행동(31=後ろから抱きつく 32=前から抱きつく 50=수음 51=펠라 52=스마타 53=파이즈리 59=乳首吸われる
;60=딥키스 61=逆レイプ 70=クンニ強制 72=애널奉仕強制
;CFLAG:우후후==2&&TEQUIP:식스나인(パンツありTCVAR:TARGET:20(70～72)はこちら)
;PREVCOM(305=膝枕
;TFLAG:400(1=デート先or地底のモブが反応する)
;==================================================
@M_KOJO_SUCCESS_COM_K2535_310
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K2535_310
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2535_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2535_310_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;친밀。ここを記入した場合、これより下は流れない
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1
		;６以上
		IF ABL:TARGET:친밀 >= 6
			IF TALENT:TARGET:성별 == 2
				PRINTFORML 「おれ、おかしくなっちゃったのかな……男のくせに、お尻をこうやって撫でられても気持ち悪くならないんだ……」
				PRINTFORMW 「むしろ、%CALLNAME:MASTER%にならもっとやってほしいって……そう思っちゃうんだ……❤」
			ELSE
				PRINTFORML 「おれ、%CALLNAME:MASTER%のせいでおかしくなっちゃった……❤　お、オンナのコにされて、それがイヤだったはずなのに……」
				PRINTFORMW 「むしろ%CALLNAME:MASTER%にお尻を触ってもらえて……オンナのコになってよかったって、そう悦んじゃってるんだ❤」
			ENDIF
		;３以上
		ELSEIF ABL:TARGET:친밀 >= 3
			PRINTFORMW 「うぅ……何か変だよ～……お尻触るのって、普通じゃないじゃん……」
		;２以下
		ELSEIF ABL:TARGET:친밀 <= 2
			PRINTFORMW 「な、なに！？　気持ち悪いよ～！」
		ENDIF
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 
		CASE 2
			PRINTFORMW 
		CASE 3
			PRINTFORMW 
		;연모
		CASE 4
			PRINTFORMW 
		;親愛
		CASE 5
			PRINTFORMW 
	ENDSELECT
ENDIF
RETURN 1
