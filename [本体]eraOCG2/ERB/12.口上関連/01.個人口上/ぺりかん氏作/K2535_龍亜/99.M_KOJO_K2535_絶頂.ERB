;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;분기作りに有用そうな変数などのメモ
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;NOWEX:절정
;4以上で昇天、3で超強절정、2で強절정、1で절정

;NOWEX:Ｃ절정 NOWEX:Ｖ절정 NOWEX:Ｂ절정 NOWEX:Ａ절정 NOWEX:Ｍ절정
;各部位の절정

;NOWEX:二重절정、NOWEX:三重절정、NOWEX:四重절정、NOWEX:五重절정
;同時に절정した時の状態
;上記五つに加えてNOWEX:Ｅ절정でも판정

;TOTALEX
;地の文の판정に使われているもの
;5以上で潮を吹き、4以下で背中を反らせて절정する
;詳しくはEVENT_MESSAAGE_ORGASMを参照

;TEQUIP:50
;Ｖに誰の竿が入ってるか。TEQUIP:50 = MASTERであなたが삽입中となる。
;TEQUIP:51
;Ａに誰の竿が入ってるか。TEQUIP:51 = MASTERであなたが삽입中となる。
;NOWEX:사정
;사정量、最大3。たとえばIF NOWEX:MASTER:사정 > 1だと、あなたが大量사정以上した場合となる。

;-------------------------------------------------
;절정時の구상
;-------------------------------------------------
@M_KOJO_MESSAGE_PALAMCNG_B_K2535(ARG)
#DIM TOTALEX
#DIM DYNAMIC 호감도修正
CALL PALAM_MESSAGE_B(ARG)
TOTALEX =  NOWEX:ARG:Ｃ절정 + NOWEX:ARG:Ｖ절정 + NOWEX:ARG:Ａ절정 + NOWEX:ARG:Ｂ절정+ NOWEX:ARG:Ｍ절정 + NOWEX:ARG:Ｅ절정 + NOWEX:ARG:분유 + NOWEX:ARG:사정
SIF !(TOTALEX + NOWEX:ARG:방뇨)
	RETURN 0
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;분유
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:분유
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;사정した
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:사정
		IF FIRSTTIME(SELECTCOM)
			PRINTFORML 「うわっ、なにっ！？　お、おれ、チンチンからっ、何か来る、来ちゃう──！」
			PRINTFORMDW 男性器から勢いよく吹き出す정액に戸惑う%CALLNAME:TARGET%。どうやら今回が精通だったようだ……
		RETURN 1
		ENDIF
		IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「こ、こんな気持ちいいの、ガマンできないよぉ❤　あっ❤　でるっ❤　チンチンからでるぅ❤」
				CASE 1
					PRINTFORMW 「あ゛あっ❤　でるぅ❤　사정ちゃうよぉ❤　あ゛っ❤　ああっ❤　あ゛ーーーーっ❤　あ゛ーーーーーーっ❤」
				CASE 2
					PRINTFORML 「で、사정ちゃうぅ❤　ダメだぁ❤　こんなの、笑われちゃうぅ❤　早くてわらわれちゃうぅ❤」
					PRINTFORMW 「やだっ❤　子供じゃないもんっ❤　おれだってぇ❤　ガマンっ❤　ガマンっ、できないっ❤　あっ❤　ダメッ❤　あっ❤　あ゛っ❤　あ゛あ゛あぁぁぁっ❤」
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「あ゛あっ！　で、사정ちゃうっ❤　やめろ、사정るっ、ダメだっ、사정ちゃうっ、あっ、あ゛あっ……❤」
				CASE 1
					PRINTFORMW 「み、みるなぁ！　おれが사정してるトコロ、みるなぁ……！」
				CASE 2
					PRINTFORMW 「だ、ダメだっ！？　ガマン、ガマンできない……っ❤」
			ENDSELECT
			ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;방뇨
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && NOWEX:ARG:방뇨
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「ち、ちがう！？　おれ、もう子供じゃないもん！　これは、これは、何かの間違いだ……っ」
			CASE 1
				PRINTFORMW 「やめろよ……みるなぁ……」
			CASE 2
				PRINTFORMW 「も、もうお漏らしなんかしないよ！？　きょ、今日はたまたまガマンできなかっただけ……っ！　普段はお漏らしなんかしてないからね！？」
		ENDSELECT
		RETURN 1
	ENDIF

	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;ここを記入した場合、これより下は流れない
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1
		RETURN 1
	ENDIF
	;구상の色の변경　この状態だとピンク色　必要ない場合はこことRESETCOLORを消す
	SETCOLOR C_H_PINK
	;基本セット
	SELECTCASE NOWEX:ARG:절정
		;절정
		CASE 1
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖ섹스 == MASTER
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ENDIF
		;強절정
		CASE 2
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖ섹스 == MASTER
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ENDIF
		;超強절정
		CASE 3
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖ섹스 == MASTER
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ENDIF
		;昇天
		CASE 4 TO 5
			IF TOTALEX >= 5
				IF TEQUIP:ARG:Ｖ섹스 == MASTER
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ELSE
				IF TOTALEX >= 3
					PRINTFORMW 
				ELSE
					PRINTFORMW 
				ENDIF
			ENDIF
	ENDSELECT
	RESETCOLOR
ENDIF
RETURN 1


