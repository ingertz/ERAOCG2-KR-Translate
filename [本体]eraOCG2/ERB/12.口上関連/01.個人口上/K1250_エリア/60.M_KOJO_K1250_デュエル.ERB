;==================================================
;4,효과使用宣言
;==================================================
@M_KOJO_DUEL_K1250_4(カードID,발동出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC 발동出処
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 발동出処
		CASE 1
			;손패발동
			SELECTCASE RAND:2 + 1
			CASE 1
				PRINTFORMW 「손패から、%カード名%の효과を발동するよ～」
			CASE 2
				PRINTFORMW 「%カード名%の효과を손패から발동！」
			ENDSELECT
		CASE 2
			;필드발동
			IF カードID == 11250 || カードID == 41250 || カードID == 11251 || カードID == 41251 || カードID == 11252 || カードID == 41252 || カードID == 11253 || カードID == 41253 || カードID == 11254 || カードID == 41254 || カードID == 11255 || カードID == 41255
				PRINTFORMW 「령사の力、見せちゃうよ！」
			ELSEIF カードID == 40000 || カードID == 40001 || カードID == 40002
				PRINTFORMW 「三幻神の一柱よ、その力の一端を今こそ！」
			ELSE
				PRINTFORMW 「お願い、キミの力が必要なの！
 				PRINTFORMW 　%カード名%の효과、발동！」
			ENDIF
		CASE 3
			;마함발동
			IF カード種 == 速攻마법
				PRINTFORMW 「速攻마법、行くよ～！
					IF カードID == 61250
						PRINTFORML 　これが私たちの精霊術だっ！
						PRINTFORMW 　精霊術の使い手、발동！」
					ELSE
						PRINTFORMW 　%カード名%、발동！」
					ENDIF
			ELSEIF カード種 == 지속마법
				PRINTFORMW 「場を支配する魔術の粋……지속마법！
					IF カードID == 61251
						PRINTFORML 　精霊よ、自然を司る偉大なる力を我らに！
						PRINTFORMW 　憑依각성、발동！」
					ELSE
						PRINTFORMW 　%カード名%、발동するよ！」
					ENDIF
			ELSEIF カード種 == フィールド
				IF カードID == 61253
					PRINTFORML 「これが仲間と紡ぐ精霊術の極み……
					PRINTFORMW 　大霊術－「一輪」！」
				ELSE
					PRINTFORML 「概念さえも書き換える、これなるは魔術の頂の一つ
					PRINTFORMW 　フィールド마법、발동するよ！」
				ENDIF
			ELSEIF カード種 == 通常함정
				PRINTFORMW 「やらせない！
					IF カードID == 81250
						PRINTFORML 　これが私たちの連携戦術！
						PRINTFORMW 　憑依連携、발동！」
					ELSE
						PRINTFORML 「リバースカード、オープン！
						PRINTFORMW 　%カード名%、발동！」
					ENDIF
			ELSEIF カード種 == 지속함정
				PRINTFORMW 「ここで仕掛けるよ！
					IF カードID == 81251
						PRINTFORML 　精霊達よ、真の力を解放せよ！
						PRINTFORMW 　憑依解放、발동！」
					ELSE
						PRINTFORMW 　%カード名%、발동するよ！」
					ENDIF
			ELSE
				PRINTFORMW 「%カード名%の효과を발동するね」
			ENDIF
		CASE 4
			;묘지발동
			IF カードID == 81250
				PRINTFORML 「一度で終わりじゃないんだよ？
				PRINTFORMW 　묘지から、憑依連携の효과を발동！」
			ELSE
				PRINTFORMW 「묘지から、%カード名%の효과を발동するよ！」
			ENDIF
	ENDSELECT
ENDIF



