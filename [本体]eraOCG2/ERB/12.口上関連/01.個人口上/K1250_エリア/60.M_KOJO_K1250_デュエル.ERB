;==================================================
;0,デュエルスタート！
;==================================================
@M_KOJO_DUEL_K1250_0(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「行こう、皆……デュエル！」
		CASE 2
			PRINTFORMW 「精霊よ……私に力を貸して」
		CASE 3
			PRINTFORMW 「よーし、負けないよ～！　듀얼！」
	ENDSELECT
ENDIF

