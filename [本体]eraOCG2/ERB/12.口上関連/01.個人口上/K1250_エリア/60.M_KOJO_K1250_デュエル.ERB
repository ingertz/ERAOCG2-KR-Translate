;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K1250_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORML 「我、贄を捧げその名を高らかに讃えよう
			PRINTFORMW 　의식소환！　降臨せよ、%カード名%！」
		CASE 융합
			PRINTFORML 「形混ざりて万物転変……
			PRINTFORMW 　융합소환！　現れよ、%カード名%！」
		CASE 싱크로
			PRINTFORML 「集いし精霊が、自然と繋ぐ力になる！
			PRINTFORMW 　싱크로소환！　%カード名%！」
		CASE 엑시즈
			PRINTFORML 「手と手を重ねて紡ぐ未来
			PRINTFORML 　%カード名%を엑시즈소환！
			PRINTFORMW 　なんてね、えへへっ」
		CASE 링크
			PRINTFORMW 「行くよ！　アローヘッド確認、サーキットコンバイン！
				;清冽エリア
				IF カードID == 41250
					PRINTFORML 　소환条件は물속성モンスターを含むモンスター２体！
					PRINTFORML 　精霊と共に、舞えよ一輪！　清涼の彩を添えて！
					PRINTFORMW 　링크소환！　清冽の水령사エリア！」
