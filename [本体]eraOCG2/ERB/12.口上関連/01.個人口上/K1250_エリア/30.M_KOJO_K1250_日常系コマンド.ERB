								CSTR:TARGET:SEMCALL = %RESULTS%
						ENDIF
					PRINTFORMDW %CSTR:TARGET:SEMCALL%と呼んでもらうことにしました。
				ELSE
					PRINTFORMW 「どうかしたの？」
				ENDIF
	ENDIF
ENDIF
RETURN 1
