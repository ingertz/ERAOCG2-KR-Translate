@M_KOJO_MESSAGE_COM_K1250_480_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;これが０の時はデュエルしない時なのでおわり
	SIF TFLAG:SELECTCOM분기 == 0
		RETURN 1

	;デュエル前
	IF INRANGE(TFLAG:SELECTCOM분기,10,21)
		SELECTCASE TFLAG:SELECTCOM분기
			;通常듀얼
			CASE 10
				PRINTFORMW 「よーし、負けないよ！」
			;ここから賭け듀얼
			;パック賭け
			CASE 11
				PRINTFORMW 「ふふん、ちょうど新弾のパックが欲しかったんだよね♪」
			;デート賭け
			CASE 12
				PRINTFORMW 「こんなことしなくても普通に頼めば……ううん、きっと듀얼することに意味があるんだよね！」
			;パンツ賭け
			CASE 13
				IF TALENT:TARGET:연모
					PRINTFORMW 「キミ、ほんと……はぁ、こうなったら私が듀얼で性根を叩き直してあげるからね！」
				ELSE
					PRINTFORMW 「ぱ、ぱぱ、パンツが欲しいだなんて何考えてるの！？　ま、負けないからね！」
				ENDIF
			;お持ち帰り
			CASE 14
				IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨 || TALENT:TARGET:음란
					PRINTFORMW 「誘ってくれるのは嬉しいけどもっとこう、무드とかさ……私だってちょっとは憧れるものがあって……！」
				ELSE
					PRINTFORMW 「あ……え？　ま、負けたら、えっちなことされちゃ……ううん、負けなければいいんだもんね！」
				ENDIF
			;モンスターか問い詰める（人間は불가）
			CASE 15
				PRINTFORMW 「残念、キミなら私と仲良くしてくれる、って信じてたのに……」
			;スケベ強要
			CASE 16
				;満更でもない
				IF TALENT:TARGET:패배버릇
					PRINTFORMW 「ま、負けたらまた無理やり気持ちよく……♥　だ、ダメ、今度は負けないんだから、ね……♥」
				;恥ずかしい写真は消してくれよなー
				ELSEIF CFLAG:TARGET:약점장악 == 1
					IF EXP:TARGET:패배조교경험 >= 1
						PRINTFORMW 「うぅ……今度こそ、その写真消してもらうからね！」
					ELSE
						PRINTFORMW 「な、なんとしても勝たなきゃ……！」
					ENDIF
				;金金金！듀얼리스트として恥ずかしくないのか！
				ELSE
					PRINTFORMW 「えへへ……ケーキとチョコとそれからプリンにおまんじゅう……よーし、負けないよ！」
				ENDIF
			;闇のゲーム
			CASE 20
				PRINTFORMW 「この気配……！　どうしてこんな危険な力をキミが…！？」
		ENDSELECT

	;デュエル後
	ELSE
		SELECTCASE TFLAG:SELECTCOM분기
			;通常승리
			CASE 1
				PRINTFORMW 「ま、負けちゃった～……やっぱり%CSTR:TARGET:MASCALL%は強いね」
			;通常패배
			CASE -1
				PRINTFORMW 「ふっふっふっ、どう？　これが령사の力だよ♪」
			;通常引き分け
			CASE -2
				PRINTFORMW 「わっ、引き分けることなんてあるんだ…！？」

			;ここから賭け승리
			;パック賭け
			CASE 31
				PRINTFORMW 「うぅ、私のお小遣いが……」
			;デート賭け
			CASE 32
				IF TALENT:TARGET:연모
					PRINTFORMW 「うぅ、負けた……それじゃあ、どこに行こっか%CSTR:TARGET:MASCALL%？　えへへ、どこにでもついて行くよ♪」
				ELSE
					PRINTFORMW 「く、悔しい～！　わかった、キミについて行くね」
				ENDIF
			;パンツ賭け
			CASE 33
				PRINTFORMW 「脱ぐから後ろ向いて……えぇ、ダメなの？　うぅぅ、はずかしい……」
				PRINTFORML
				PRINTFORMDW %CALLNAME:TARGET%がパンツを脱ぐところまでじっくりと鑑賞させてもらった……。
			;お持ち帰り
			CASE 34
				IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨 || TALENT:TARGET:음란
					PRINTFORMW 「ふふっ、それじゃあこの後も楽しみにしてるね%CSTR:TARGET:MASCALL%……♥」
				ELSE
					PRINTFORMW 「うぅ、変なことしないでね……？」
				ENDIF
			;下二桁３５は"モンスターか問い詰める"の분기
			;カード化（牝以外、選択肢無し）
			CASE 35
				PRINTFORMW 「そ、そんな……きゃぁ～！」
			;カード化を見逃す（元気でな！）
			CASE 135
				PRINTFORMW 「ほ、ほんとにいいの？　ありがとう、%CSTR:TARGET:MASCALL%……！」
			;穏便に話してカード化（怖くないよ～痛くないよ～）
			CASE 235
				PRINTFORMW 「そ、それなら……うん、わかった。　キミのこと信じるね」
			;身体を対価に見逃す（見逃すとは言ってない）
			CASE 335
				PRINTFORMW 「う……あ♥　な、なんで、約束とちが……」
			;身体を対価に見逃す（見逃す）（負け癖付いたり弱み握られたりする）
			CASE 435
				PRINTFORMW 「負けちゃった……や、ヤダ、触らないで……」
			;身体要求事後
			CASE 36
				;満更でもない
				IF TALENT:TARGET:패배버릇
					PRINTFORMW 「あっ……は、ぁ♥　も、もっとして欲しい、です……♥」
				ELSE
					;三回負けたら色違い負け癖ゲット！
					SELECTCASE EXP:TARGET:패배조교경험
						CASE 1
							PRINTFORMW 「ひっく、ぐすっ……こんな、こんなのヒドイ……」
						CASE 2
							PRINTFORMW 「んん……♥　違う、違うの……こんな無理やりされて気持ちよくなったりなんて……♥」
					ENDSELECT
				ENDIF
			;闇のゲーム
			CASE 40
				PRINTFORMW 「いや、いやぁぁぁぁぁ！！」
			;ここから賭け패배
			;怒られた
			CASE 50
				PRINTFORMW 「賭け듀얼なんて良くない事だよ？　ちゃんと反省してね、%CSTR:TARGET:MASCALL%！」
			;パック賭け（パックを手渡す）
			CASE 51
				PRINTFORMW 「えへへ、やった！　……わ、これ欲しかったカードだ♪」
			;デート賭け（デートはしてくれる）
			CASE 52
				PRINTFORML 「これで負けるのはちょっとどうかと思うな……
				PRINTFORMW 　じゃ、負けた%CSTR:TARGET:MASCALL%には今日一日、私に付き合ってもらおっかな♪」
			;カード化패배（逃げられた）
			CASE 55
				PRINTFORMW 「ふぅ、私の勝ちだね！　バイバイ%CSTR:TARGET:MASCALL%、今度会うときはまた友達として仲良くしてね！」
			;身体要求패배（金払う）
			CASE 56
				PRINTFORML 「えへ、えへへへへ♪　何買おっかなぁ……
				PRINTFORMW 　はっ！？　こほん、これに懲りたらもうお金で女の子を買おうなんてことしちゃダメだよ？　バツとしてこのお金が私がもらっておきます♪」
			;身体要求패배（弱味削除）
			CASE 156
				PRINTFORMW 「やった……！　もうあんなこと絶対しないでね！」
			;身体要求패배（負け癖付いてる時限定凌辱おねだり）（ラブホ直行）
			CASE 256
				PRINTFORMW 「あぁ……こんなことダメなのに♥　もう体が熱くて我慢できないよぉ……♥」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

