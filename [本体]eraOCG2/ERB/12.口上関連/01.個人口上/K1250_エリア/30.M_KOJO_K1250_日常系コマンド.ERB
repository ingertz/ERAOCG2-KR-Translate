			BINPUT
				IF RESULT == 0
					CSTR:TARGET:MASCALL = ダーリン
				ELSEIF RESULT == 1
					CSTR:TARGET:MASCALL = ハニー
				ELSEIF RESULT == 2
					CSTR:TARGET:MASCALL = ご主人様
				ELSEIF RESULT == 3
					CSTR:TARGET:MASCALL = マスター
				ELSEIF RESULT == 4
					CSTR:TARGET:MASCALL = %CALLNAME:MASTER%
				ELSE
					INPUT
					SIF RESULTS != ""
						CSTR:TARGET:MASCALL = %RESULTS%
				ENDIF
