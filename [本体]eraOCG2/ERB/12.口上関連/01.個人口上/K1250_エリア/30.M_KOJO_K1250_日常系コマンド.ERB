@M_KOJO_MESSAGE_COM_K1250_301_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:SELECTCOM분기
		CASE 1
			SELECTCASE RAND:3 + 1
				CASE 1
					PRINTFORML 「こ、これは……！！
					PRINTFORML 　ここ数年で最高の出来！」
					PRINTFORML
					PRINTFORMDW なんかワインみたいなこと言ってる……。
				CASE 2
					PRINTFORML 「いただきます……ずずっ
					PRINTFORML 　はぁ～……ワビサビだねぇ……」
					PRINTFORML
					PRINTFORMDW なんだか知った風なことを言っている……。
				CASE 3
					PRINTFORMW 「ふぅ……%CSTR:TARGET:MASCALL%と飲むお茶は最高だねぇ…」
			ENDSELECT
		CASE 0
			SELECTCASE RAND:3 + 1
				CASE 1
					PRINTFORML 「わぁ、お茶だ♪
					PRINTFORML 　ずずっ……はふぅ……」
					PRINTFORML
					PRINTFORMDW %CALLNAME:TARGET%はお茶を飲んでまったりしている……。
				CASE 2
					PRINTFORML 「このお茶、どこから出したの……？
					PRINTFORMW 　……あっ、普通においしい」
				CASE 3
					PRINTFORML 「%CSTR:TARGET:MASCALL%、今のどうやったの？
					PRINTFORMW 　お願い、もう一回！　もう一回お茶出して見せて！」
			ENDSELECT
		CASE -1
			SELECTCASE RAND:3 + 1
				CASE 1
					PRINTFORML 「わぁ、お茶だ♪
					PRINTFORML 　いただきます……んぶっ！？」
					PRINTFORML
					PRINTFORMDW 淹れ方を間違えて渋すぎたらしい……。
				CASE 2
					PRINTFORML 「ずずっ……に、苦い～……」
					PRINTFORML
					PRINTFORMDW 苦い、苦いと言いながら必死で飲んでくれる%CALLNAME:TARGET%に少し申し訳ない気持ちになった……。
				CASE 3
					PRINTFORML 「%CSTR:TARGET:MASCALL%……と、とととってもおいしい……よ？」
					PRINTFORML
					PRINTFORMDL なんだか様子がおかしい気がするが……どれ、자신も飲んでみよう。
					PRINTFORMDW …………し、渋過ぎる！！　もったいないが捨てることにしよう。
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1
