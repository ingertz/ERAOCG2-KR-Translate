					PRINTFORML
					PRINTFORMDL [0] - おちんちん
					PRINTFORMDL [1] - おチンポ
					PRINTFORMDL [2] - ご主人様
					PRINTFORMDL [3] - 旦那様
					PRINTFORMDL [4] - 자신で決める
					BINPUT
						IF RESULT == 0
							CSTR:TARGET:MASCALL = おちんちん
						ELSEIF RESULT == 1
							CSTR:TARGET:MASCALL = おチンポ
						ELSEIF RESULT == 2
							CSTR:TARGET:MASCALL = ご主人様
						ELSEIF RESULT == 3
							CSTR:TARGET:MASCALL = 旦那様
						ELSEIF RESULT == 4
							INPUT
							SIF RESULTS != ""
								CSTR:TARGET:DIKCALL = %RESULTS%
						ENDIF
					PRINTFORMDW %CSTR:TARGET:DIKCALL%と呼んでもらうことにしました。
				ELSEIF RESULT == 2
					PRINTFORMDL なんて呼んでもらおうか？
					PRINTFORMDL	現在：%CSTR:TARGET:SEMCALL%
					PRINTFORML
					PRINTFORMDL [0] - 정액
					PRINTFORMDL [1] - ザーメン
					PRINTFORMDL [2] - 자신で決める
					BINPUT
						IF RESULT == 0
							CSTR:TARGET:SEMCALL = 정액
						ELSEIF RESULT == 1
							CSTR:TARGET:SEMCALL = ザーメン
						ELSEIF RESULT == 2
