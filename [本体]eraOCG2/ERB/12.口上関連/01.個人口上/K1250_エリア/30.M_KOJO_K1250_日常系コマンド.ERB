;300,会話
;TFLAG:SELECTCOM분기(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより교양が4以上高い)
;TCVAR:302(0=会話可能 1=非연모時会話不能)
;MARK:반발각인(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;CFLAG:우후후(조교中の会話)
;CFLAG:변기화(肉便器の時の会話)
;==================================================
@M_KOJO_SUCCESS_COM_K1250_300
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K1250_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で구상色が付きません。
CALL TRAIN_MESSAGE
;구상メイン呼出
CALL M_KOJO_MESSAGE_COM_K1250_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K1250_300_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;호감도修正、通常（연모系陥落なし）で１
	호감도修正 = 1
	;TARGETが【애처】だったら호감도修正に４
	SIF TALENT:TARGET:애처 && ITEM:천년도어 == 1
		호감도修正 = 4
	;TARGETが【親愛】だったら호감도修正３　親愛・애처は천년도어開通を条件に추가。
	SIF TALENT:TARGET:연모 == 2 && ITEM:천년도어 == 1
		호감도修正 = 3
	;TARGETが【연모】を得ていたら호감도修正に２
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 = 2
	;우후후中の会話
	IF CFLAG:TARGET:우후후
		SELECTCASE RAND:4 + 1
			CASE 1
				PRINTFORML 「무드、って大切だよねぇ……その話、今するの？
				PRINTFORMW 　はぁ～、しょうがないなぁ%CSTR:TARGET:MASCALL%は」
			CASE 2
				PRINTFORML 「んっ、と……えへへ、ちょっと期待してるかな
				PRINTFORMW 　いっぱい気持ちよく……して♥」
			CASE 3
					PRINTFORMW 「この後何が食べたいか、って……？
				IF TALENT:TARGET:절정익숙함 == 1 && TALENT:TARGET:연모 == 2
					PRINTFORML 　んー……っと、ちゅっ♥　はむっ、むぐ……ぴちゃ……れる……んんっ、ぷはぁっ…ふふっ♥
					PRINTFORMW 　これ、%CSTR:TARGET:MASCALL%の%CSTR:TARGET:DIKCALL%が食べたいなぁ♥
					PRINTFORMW 　だから……早く挿れて欲しいな❤」
				ELSE
					PRINTFORMW 　あのさぁ……それ、おっぱい揉みながらする話じゃないよね？」
				ENDIF
			CASE 4
				PRINTFORML 「えー……今덱構築の話する？」
				PRINTFORMW 「もう、ほんとキミはそういうところ……私ならこのカード入れるよ」
		ENDSELECT
	;日常会話
	ELSE
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
			;通常会話
				SELECTCASE RAND:5 + 1
					CASE 1
						IF TIME >= KANTAN_TIME(6,00) && TIME < KANTAN_TIME(9,00)
							PRINTFORML 「ふぁ……%CSTR:TARGET:MASCALL%、もう덱調整してるんだね……
							PRINTFORMW 　私はまだちょっと……ん～、だいぶねむ……」
						ELSEIF TIME >= KANTAN_TIME(9,00) && TIME < KANTAN_TIME(12,00)
							PRINTFORML 「ん～！
							PRINTFORMW 　今日も元気に頑張ろうね、%CSTR:TARGET:MASCALL%！」
						ELSEIF TIME >= KANTAN_TIME(12,00) && TIME < KANTAN_TIME(15,00)
							PRINTFORML 「んー、そろそろお昼だね～
							PRINTFORMW 　そう思ったらなんだかお腹空いてきたかも」
						ELSEIF TIME >= KANTAN_TIME(15,00) && TIME < KANTAN_TIME(18,00)
							PRINTFORML 「もう夕方かぁ……
							PRINTFORMW 　こっちの世界だとやりたいことがいっぱいあるからあっという間に時間が過ぎちゃうなぁ……」
						ELSE
							PRINTFORMW 「ふわぁ～……
							PRINTFORMW 　むっ、ちょっと%CSTR:TARGET:MASCALL%？　人のあくび、そんなにじっと見ないでよ」
							PRINTFORML
							PRINTFORMW 「キミに油断したところ見られるの、恥ずかしい……」
						ENDIF
					CASE 2
						PRINTFORML 「むぅ……いい덱レシピが思いつかないなぁ
						PRINTFORML 　ね、%CSTR:TARGET:MASCALL%。　이 카드를 使いたいんだけど──」
						PRINTFORML
						PRINTFORMDW 真剣に新しい덱を考える%CALLNAME:TARGET%の相談に乗りながら過ごした……。
					CASE 3
						PRINTFORML 「ギゴバイト達の言葉？　それならちゃんとわかってるよ
						PRINTFORMW 　契約した時に心も繋がったからそれでわかる感じかな
						PRINTFORMW 　ちなみにギゴバイトはキミのこと……うーん、これは内緒♪」
					CASE 4
						PRINTFORML 「ね、%CSTR:TARGET:MASCALL%、今ヒマ？　ヒマだよね？
						PRINTFORML 　덱作ってるから忙しい……って！
						PRINTFORMW 　わかってるけど退屈なの～！　構って、遊んでよぉ～！」
						PRINTFORML
						PRINTFORMDW じたばたと暴れる%CALLNAME:TARGET%を見かねて、ゲームで遊ぶことにした。
					CASE 5
						PRINTFORMW 「他の령사について？
						PRINTFORML 　う～ん……いいよ、誰のこと聞きたい？」
						PRINTL
						PRINTL
						PRINTFORMDL [0] - ウィン
						PRINTFORMDL [1] - ヒータ
						PRINTFORMDL [2] - アウス
						PRINTFORMDL [3] - ライナ
						PRINTFORMDL [4] - ダルク
						IF TALENT:TARGET:연모 == 2
							PRINTFORMDL [5] - エリア
						ENDIF
						BINPUT
						PRINTL
						PRINTL
							IF RESULT == 0
							;ウィン
								PRINTFORMW 「ん～、ウィンかぁ～
								PRINTFORML 　あっ、私実はウィンと一番仲がいいんだよ
								PRINTFORMW 　水と風で相性がいいのかな～、서로의 髪の毛いじって遊んだりするんだ
								PRINTFORML 　それから、二人の精霊術を合わせて虹を作るのもキレイで大好き！
								PRINTFORMW 　そのうち%CSTR:TARGET:MASCALL%にも見せてあげるね♪」
							ELSEIF RESULT == 1
							;ヒータ
								PRINTFORMW 「ヒータについて聞きたい？
								PRINTFORML 　うーん……そうだ、ヒータって結構暑がりなところあるんだよ。　火の精霊のおかげで体温が他の人より高いんだって
								PRINTFORMW 　冬とかくっついてるとぬくぬくで気持ちいいよ～？
								PRINTFORML 　それから……ヒータって実は私たちの中で一番女子力高いんだよ
								PRINTFORMW 　私たち、毎日持ち回りで요리当番してるんだけどヒータの作るご飯が一番おいしいの♪
								PRINTFORMW 　あとね、ここだけの話……小さい頃から一番叶えたい夢はずーっと『かわいいお嫁さん』なんだよ、すごく可愛いよね」
							ELSEIF RESULT == 2
							;アウス
								PRINTFORMW 「アウスか～
								PRINTFORML 　アウスは真面目で勉強と研究が大好きって感じだよ
								PRINTFORML 　それから、コーヒーに凝っててアウスが淹れてくれるコーヒーってすごくおいしいんだ
								PRINTFORMW 　あー……でも、あれだね
								PRINTFORMW 　マイビーカー、とか言って実験に使うビーカーに자신의 コーヒー淹れるのは危ないから止めて欲しいよね……」
							ELSEIF RESULT == 3
							;ライナ
								PRINTFORMW 「ライナ？
								PRINTFORML 　ライナはちょっとドジなところがあるかな……
								PRINTFORML 　砂糖と塩を間違えたり、しょうゆとソースを間違えるみたいな感じでちょっと失敗することが多いかも
								PRINTFORMW 　時々『ちょっと』じゃすまないことがあるけど……そういう時はダルクが必死に走り回って解決したりするよ
								PRINTFORML 　でもいつもニコニコしてて周囲を明るくしてくれるんだよね
								PRINTFORMW 　うん、私はライナのそんなところが好きだよ
								PRINTFORMW 　あとねあとね、私とライナの霊術を合わせるとオーロラが作れるんだよ！　えへへっ、スゴいでしょ？」
							ELSEIF RESULT == 4
							;ダルク
								PRINTFORMW 「ダルクのこと？
								PRINTFORML 　ダルクはそうだなぁ、まず요리がすごく上手だよ
								PRINTFORMW 　요리当番を持ち回りでしてる……って話はしたかな？　ヒータの次に요리がおいしいんだ～♪
								PRINTFORML 　それから……人と関わるのがちょっと苦手だけど、周りのことはよく見てくれてるよ
								PRINTFORMW 　ライナが失敗した時にフォローしてたり、研究に夢中で何日も寝てないアウスを無理やりベッドに押し込んだり……
								PRINTFORML 　後、掃除や洗い物が好きみたい。　何かが綺麗になるのを見るのが好きなんだって
								PRINTFORMW 　……ね、%CSTR:TARGET:MASCALL%？　キミとダルクってなんだか仲良くなれそうだよね？」
							ELSE
							;エリア
								PRINTFORMW 「えっ、わ、私！？
								PRINTFORMW 　えーっと、そうだなぁ……えへへ、자신의 こと聞かれると思わなかったからなんだか照れちゃうね？
								PRINTFORML 　そうだなぁ、例えば水に関連すること全般好きだよ。　泳いだり、雨の中を歩いたり、そんなの
								PRINTFORMW 　後好きな物は……爬虫類とか好きだな～。　私のギゴバイト、六령사の精霊の中で一番可愛いって断言出来るくらい
								PRINTFORMW 　それから、えっとぉ……」
								PRINTFORML 　%CSTR:TARGET:MASCALL%、キミのことが好き、大好き
								PRINTFORMW 　デュエルしてる時の真剣な表情も、笑ったときのふにゃって感じも、頭を撫でてくれる時の撫で方も、키스の仕方も、匂いも、体温も、その……えっちなことする時も……全部、大好き♥
								PRINTFORMW 　ずっと隣に居て欲しいくらい、%CSTR:TARGET:MASCALL%のこと愛してるよ……本当に……」
							ENDIF
				ENDSELECT
			CASE 2
			;연모
				SELECTCASE RAND:1 + 1
					CASE 1
						IF ITEM:천년도어 == 1
							PRINTFORMW 「なんだか夢みたいだなぁ……
							PRINTFORMW 　え、何がって……そりゃぁ、%CSTR:TARGET:MASCALL%とずっと一緒に居られることが、だよ
							PRINTFORML 　前はいつこっちに来られなくなるかわからなくて嬉しい反面怖かったからね
							PRINTFORMW 　その点は、천년도어で次元旅行できるようにしてくれた水遣いちゃんに感謝だね～」
							PRINTFORMW
							PRINTFORMW 「……でも、キミのことは渡さないから
							PRINTFORMW 　うん？　あはは、なんでもないよ～！　気にしない、気にしない……ね？」
						ELSE
							PRINTFORML 「はぁ……この時間がずっと続けばいいのになぁ……
							PRINTFORMW 　急にどうしたって……うーん…………なんでもないよ、うん
							PRINTFORMW 　ただ急にちょっと寂しい気分になっただけだから、ちょっとだけこうしてて……」
							PRINTFORML
							PRINTFORMDW そう言うと%CALLNAME:TARGET%はあなたの肩にそっと寄りかかって目を閉じた──。
						ENDIF
				ENDSELECT
			CASE 3
			;親愛
				SELECTCASE RAND:2 + 1
					CASE 1
						PRINTFORML 「ね、%CSTR:TARGET:MASCALL%……好きだよ
						PRINTFORMW 　ふへへ、言ってみたかっただけ～♥」
					CASE 2
						PRINTFORML 「改めて%CSTR:TARGET:MASCALL%って結構なんでもできるよね……
						PRINTFORML 　炊事に洗濯、掃除にデュエル……
						PRINTFORMW 　後、私のこと気持ちよくも出来ちゃう♥
						PRINTFORMW 　うぅ～、ちょっとむずむずしてきたかも……」
				ENDSELECT
			CASE 4
			;애처
				SELECTCASE RAND:2 + 1
					CASE 1
						PRINTFORMW 「えへ、えへへへ……」
						PRINTFORML
						PRINTFORMDW %CALLNAME:TARGET%は指輪をしきりに眺めて緩み切った笑顔を浮かべている……。
						PRINTFORML
						PRINTFORMW 「ん～……こんなものがもらえるなんて本当に幸せ……」
						PRINTFORML
						PRINTFORMDW そう言いながら、%CALLNAME:TARGET%は左手の薬指に嵌めた指輪に祈るように口づけした……。
					CASE 2
						PRINTFORML 「困ったなぁ……私の%CSTR:TARGET:MASCALL%が素敵過ぎる……
						PRINTFORMW 　一緒に居て、知らなかったことを知るたびにどんどん好きになっちゃう……本当に困ったなぁ……
						PRINTFORMW 　こんなに私のこと夢中にさせた責任、ちゃんと取ってね%CSTR:TARGET:MASCALL%♥」
				ENDSELECT
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
