			ENDSELECT
		CASE 4
		;アクション
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「この坊主頭のおじさん渋くてかっこいい……♥
					PRINTFORMW 　バトルアクションもスピード感あふれててすごい！」
				CASE 1
					PRINTFORMW 「わ、わ……！　うぅ、映画なのにカーチェイス見るとつい体が左右に動いちゃう」
				CASE 2
