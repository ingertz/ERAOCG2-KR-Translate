;==================================================
;12,파이즈리펠라
;==================================================
@M_KOJO_MESSAGE_SCOM_K2620_12
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2620_12_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2620_12_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「んん……意外と頭使うな、これ……」
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「ムネだけじゃ物足んねえのか……この欲張りめ」
		CASE 2
			PRINTFORMW 「ん、要領つかめてきた、かも……」
		CASE 3
			PRINTFORMW 「……気持ちいいか？　俺のカラダ、やわらかいもんなぁ？」
		CASE 4
			IF TALENT:MASTER:성별 == 2
				PRINTFORMW 「女のカラダ全部使わせて、男冥利に尽きるだろ❤　ん❤」
			ELSE
				PRINTFORMW 「%CSTR:TARGET:MASCALL%の男の部分、女のカラダで可愛がってやるよ……❤」
			ENDIF
		CASE 5
			PRINTFORMW 「んんっ……❤　いつでも、たっぷり出してくれて、構わねえからな……❤」
	ENDSELECT
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K2620_{SELECTCOM}_1
RETURN 1

