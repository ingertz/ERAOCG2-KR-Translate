CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2620_318_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2620_318_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;알바중
	IF CFLAG:TARGET:알바중
		SELECTCASE RAND:3 + 1
			CASE 1
				PRINTFORMW 「っ……くそっ……覚えてろよぉっ……」
			CASE 2
				PRINTFORMW 「ぁっ……はぁっ、はぁっ……」
			CASE 3
				PRINTFORMW 「ふーっ、ふーっ……な、なんでもないっ！」
		ENDSELECT
	;それ以外
	ELSE
		SELECTCASE RAND:3 + 1
			CASE 0
				PRINTFORMW 「っ……なに笑ってんだ、このぉっ……」
			CASE 1
				PRINTFORMW 「……こんなのより、%CSTR:TARGET:MASCALL%の方がいいっ……」
			CASE 2
				PRINTFORMW 「やっ……これ……っ、ずるい……っ」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

;==================================================
;340,鼠径部を嗅がせる（ちん嗅ぎ）
;연모か淫乱陥落していたら竿を舐める
;==================================================
@M_KOJO_MESSAGE_COM_K2620_340
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2620_340_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2620_340_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「ああもう、どうしてほしいんだよっ……」
		CASE 2
			PRINTFORMW 「んっ、これだけで、만족なのか……？」
		CASE 3
			PRINTFORMW 「……っ、%CSTR:TARGET:MASCALL%、意地悪いよなっ……」
		;연모
		CASE 4
			PRINTFORMW 「はぁっ……❤　ヘンな気分になる❤」
		CASE 5
			PRINTFORMW 「んんっ……❤　求められてるのわかっちまう❤」
		;親愛
		CASE 6
			PRINTFORMW 「あぁ……❤　カラダが疼いちまう❤」
	ENDSELECT
ENDIF
RETURN 1

;==================================================
;341,体を舐めさせる
;==================================================
@M_KOJO_MESSAGE_COM_K2620_341
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2620_341_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2620_341_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;足舐め
	IF TCVAR:TARGET:도게자중
		PRINTFORMW 「このっ……覚えてろよっ……」

	;耳舐め
	ELSE
		호감도修正 = 3
		SIF TALENT:TARGET:애처
			호감도修正 += 0
		SIF TALENT:TARGET:연모 == 2
			호감도修正 += 1
		SIF TALENT:TARGET:연모 >= 1
			호감도修正 += 3
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORMW 「何期待してんだ？　やらしいな……」
			CASE 2
				PRINTFORMW 「身体震えてるぞ？　くくっ」
			CASE 3
				PRINTFORMW 「まったく、やればいいんだろ、やれば……」
			;연모
			CASE 4
				PRINTFORMW 「んっ、こーら、腰引けてるぞ……❤」
			CASE 5
				PRINTFORMW 「あんまり我慢させないでくれ……❤」
			CASE 6
				PRINTFORMW 「んんっ……あんまり恥ずかしいこと言わせるな……好きだよ❤」
			;親愛
			CASE 7
				PRINTFORMW 「愛してるぞ……なんだよ、たまには言ってもいいだろ……❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
