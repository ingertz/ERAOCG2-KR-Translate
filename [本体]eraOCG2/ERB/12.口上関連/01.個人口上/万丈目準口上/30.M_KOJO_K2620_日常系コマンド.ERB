;-------------------------------------------------
IF LOCAL
	IF CFLAG:MASTER:현재위치 == 場所_ラブホ
		PRINTFORMW 「……っ、おい、ここって……そういう……」
	ELSE
		PRINTFORMW 「さて、お手並み拝見といこうか」
	ENDIF
ENDIF
RETURN 1
