;300,会話
;TFLAG:SELECTCOM분기(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより교양が4以上高い)
;TCVAR:302(0=会話可能 1=非연모時会話不能)
;MARK:반발각인(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;CFLAG:우후후(조교中の会話)
;CFLAG:변기화(肉便器の時の会話)
;==================================================
@M_KOJO_SUCCESS_COM_K2620_300
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K2620_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で구상色が付きません。
CALL TRAIN_MESSAGE
;구상メイン呼出
CALL M_KOJO_MESSAGE_COM_K2620_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2620_300_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;호감도修正、通常（연모系陥落なし）で５
	호감도修正 = 5
	;TARGETが【애처】だったら호감도修正に＋２
	SIF TALENT:TARGET:애처
		호감도修正 += 2
	;TARGETが【親愛】だったら호감도修正に＋２
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	;TARGETが【연모】を得ていたら호감도修正に＋１
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	;「RAND:n」n面ダイスを振る
	;우후후中の会話
	IF CFLAG:TARGET:우후후
		SELECTCASE RAND:3 + 1
			CASE 1
				PRINTFORMW 「%CSTR:TARGET:MASCALL%って……あったかいな……っ、べ、別に深い意味はないっ」
			CASE 2
				PRINTFORMW 「……この時間が、長く続けばいいのに」
			CASE 3
				PRINTFORMW 「まったく、責任取ってくれるんだろうな……？」
		ENDSELECT
	;日常会話
	ELSE
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORMW 「暇だからな、話に付き合ってやる。　ありがたく思え」
			CASE 2
				PRINTFORMW 「なんだ、%CSTR:TARGET:MASCALL%また俺のこと探してたのか？」
			CASE 3
				PRINTFORMW 「デュエルってのは、力推しだけじゃ勝てないぞ。　わかるか？」
			CASE 4
				PRINTFORMW 「ふわぁ……眠くなってきた……」
			CASE 5
				PRINTFORMW 「なんだその顔は。　バカにしてるのか？　なに、いつもその顔だと？」
			;연모
			CASE 6
				PRINTFORMW 「%CSTR:TARGET:MASCALL%と話すと、変に落ち着くんだ……なんなんだ、いったい？」
			;親愛
			CASE 7
				PRINTFORMW 「最近、%CSTR:TARGET:MASCALL%のことばかり考えちまう……どうにかしてくれないか？」
			CASE 8
				PRINTFORMW 「%CSTR:TARGET:MASCALL%と話してると、なんか変に時間経つのが早いな……まあ、悪くはない」
			;애처
			CASE 9
				PRINTFORMW 「%CSTR:TARGET:MASCALL%には、カッコわるいとこも見せちまって……あんな……ああもうっ！」
			CASE 10
				PRINTFORMW 「%CALLNAME:MASTER%……俺の前から、いなくなってくれるなよ？」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1
