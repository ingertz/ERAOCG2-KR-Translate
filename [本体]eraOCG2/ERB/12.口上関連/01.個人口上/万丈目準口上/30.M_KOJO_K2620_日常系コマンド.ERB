@M_KOJO_MESSAGE_COM_K2620_600
;散策するにはTRAIN_MESSAGEが無い
CALL M_KOJO_MESSAGE_COM_K2620_600_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2620_600_1
