;TCVAR:抱き寄せ初回　1=普通に合意ゲット　2=先に키스ぐらいしろよ　3=媚薬or発情には勝てなかったよお…　4=悔しい…각인さえなければﾋﾞｸﾋﾞｸﾝ
;5=強引に迫られると断れぬ(素質臆病持ち専用) 6=まんざらでもない　7=駄目　8=論外 98=구상内특수판정による失敗 99=구상内특수판정による成功
;구상内특수판정は該当するCFLAGが0だと無効
;CFLAG:MASTER:우후후 (1=通常時　2=攻守反転)

;押し倒せるタイミングでないとコマンドが出ないため、TFLAG:194 == 0 以外は書く必要は無い
;上記の抱き寄せ初回は使えないため注意すること
;==================================================
@M_KOJO_MESSAGE_COM_K2620_350
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2620_350_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2620_350_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;抱き寄せ初回
	IF FIRSTTIME(TOSTR(350),1)
		PRINTFORMW 「は、はぁっ！？　ちょっ、%CSTR:TARGET:MASCALL%、なにして……っ！？　意味わかってんのか……！？」
		PRINTFORMW 「ふざけんな、俺にこんなことして……責任、取れよな……っ」
		PRINTFORMW 「っ、近い……っ……」
	;それ以外
	ELSE
		;通常押し倒し
		IF CFLAG:MASTER:우후후 == 1
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「お、おい。　こ、こっちは心の準備とか……っああもうっ！」
				CASE 1
					PRINTFORMW 「……いいけどよ……止められないって、わかってるし……別に、嫌じゃないし……」
				CASE 2
					PRINTFORMW 「ま、またそういうコトすんのか……こ、こっちだって負けねえからなっ！」
			ENDSELECT
		;攻守反転（MASTERが受け）
		ELSEIF CFLAG:MASTER:우후후 == 2
			PRINTFORMW 「%CSTR:TARGET:MASCALL%が油断するなら、主導権はこっちがもらうからな……？」
		ENDIF
	ENDIF
ENDIF
RETURN 1
