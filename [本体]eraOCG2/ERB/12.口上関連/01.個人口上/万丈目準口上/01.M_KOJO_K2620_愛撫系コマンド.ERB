@M_KOJO_MESSAGE_COM_K2620_0_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「っ……、あ、あんまりベタベタすんな……っ」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;삽입中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V삽입
	IF LOCAL:1 && TEQUIP:50 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			PRINTFORMW 「ふぁ……❤　今カラダ、熱いからぁ……❤」
			RETURN 1
		ELSE
			PRINTFORMW 「やっ……❤　今触られると、耐えられねえ……❤」
			RETURN 1
		ENDIF
	;A삽입
	ELSEIF LOCAL:1 && TEQUIP:51 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			PRINTFORMW 「んっ❤　今、やさしくするな……❤　尻、あちい……❤」
			RETURN 1
		ELSE
			PRINTFORMW 「はぁっ……❤　やっ、今、触んなぁ……っ❤」
			RETURN 1
		ENDIF
	ENDIF

	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		;書いたけどこれ以外표시されないの寂しいので一旦LOCAL0
		PRINTFORMW 「やっ❤　カラダ中、おかしくなる……っ❤」
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 1
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「……%CSTR:TARGET:MASCALL%、手馴れてないか？　こういうの……」
		CASE 2
			PRINTFORMW 「そ、それは反則だっ……」
		CASE 3
			PRINTFORMW 「……別に、嫌がっては、ねえだろっ」
		;연모
		CASE 4
			PRINTFORMW 「っ❤　%CSTR:TARGET:MASCALL%に触られると、弱くなっちまう……❤」
		CASE 5
			PRINTFORMW 「そんなにやさしくされたら、わかんなくなる……❤」
		;親愛
		CASE 6
			PRINTFORMW 「ぁっ❤　気持ちよさそうって……❤　当たり前だろ❤」
		CASE 7
			PRINTFORMW 「んぅっ❤　やめないでくれ……意地悪❤」
		;애처
		CASE 8
			PRINTFORMW 「ふふ……❤　あとで、お返ししてやるからな……❤」
	ENDSELECT
ENDIF
RETURN 1
