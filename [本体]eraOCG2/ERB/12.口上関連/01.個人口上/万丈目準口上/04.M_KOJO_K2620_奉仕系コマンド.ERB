;80,수음
;==================================================
@M_KOJO_MESSAGE_COM_K2620_80
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2620_80_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2620_80_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「……こ、こう、か？　……強すぎたり、してねぇか？」
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「……触ってるだけ、なのに、すげえ反応だな……❤」
		CASE 2
			PRINTFORMW 「……俺と、弱いとこ、おんなじかもな❤」
		CASE 3
			PRINTFORMW 「……息の仕方、変になってるぞ❤」
		CASE 4
			PRINTFORMW 「……どう触って欲しいか、言わなくてもわかるぜ……❤」
		CASE 5
			PRINTFORMW 「この俺が、気持ちよくしてるの、忘れんなよ❤」
	ENDSELECT
ENDIF
RETURN 1

;==================================================
;81,펠라치오
;==================================================
@M_KOJO_MESSAGE_COM_K2620_81
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2620_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2620_81_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;ファースト키스
		IF EXP:TARGET:Ｍ경험 == 0 && EXP:TARGET:펠라경험 == 1 && CALLNAME:(CFLAG:TARGET:키스상실상대) == CALLNAME:MASTER
			PRINTFORMW 「……こういうことより先に、順序があると思わねえのか……？　はぁ……呆れるな」
		;それ以外
		ELSE
			PRINTFORMW 「……ん、あむ、こうすりゃ、いいんだろっ……」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
		
	;お掃除펠라
	IF STAIN:MASTER:2 & 4 && ABL:TARGET:기교 >= 3
		PRINTFORMW 

	;通常
	ELSE
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORMW 「んっ、変な声、出してんじゃねえよ……❤」
			CASE 2
				PRINTFORMW 「んっんっ……これで、できてるのか……？」
			CASE 3
				PRINTFORMW 「……なんだ、言われた通りに、してるだろ……？」
			CASE 4
				PRINTFORMW 「んぅっ……❤　ふぅ……❤　こんなん、我慢できなくなる……❤」
			CASE 5
				PRINTFORMW 「はぁっ……❤　なんか、俺の方が、気持ちよくなっちまってる……❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

