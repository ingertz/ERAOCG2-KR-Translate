	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本セット
	;開始
	IF TEQUIP:앞치마
		;연모
		IF TALENT:연모
			PRINTFORMW 
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 
			RETURN 1
		ENDIF
	;終了
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1

