			SIF ABL:TARGET:마조끼 >= 5
				마조끼修正 += 1
			SIF ABL:TARGET:마조끼 >= 4
				마조끼修正 += 1
			SIF ABL:TARGET:마조끼 >= 3
				마조끼修正 += 1
			SIF ABL:TARGET:마조끼 >= 2
				마조끼修正 += 1
			SIF ABL:TARGET:마조끼 >= 1
				마조끼修正 += 2
			SELECTCASE RAND:마조끼修正 + 1
				CASE 1
					PRINTFORMW 「うぐ……動くと、変な感じする……」
				CASE 2
					PRINTFORMW 「変に慣れるのが、いちばん嫌だ……」
				CASE 3
					PRINTFORMW 「……%CSTR:TARGET:MASCALL%、俺をどうしたいってんだよっ！」
				;마조끼1以上
				CASE 4
					PRINTFORMW 「どれだけ仕込めば気が済むんだ、変態っ……！」
				CASE 5
					PRINTFORMW 「フーッ、フーッ、くるし……っ」」
				CASE 6
					PRINTFORMW 「違う、こんなの、違うっ……❤」
				CASE 7
					PRINTFORMW 「こんな、の、で、俺が悦ぶとでもっ……っ❤」
				CASE 8
					PRINTFORMW 「はぁっ……❤　ほんとに、変になっちまうっ……❤」
				CASE 9
					PRINTFORMW 「%CSTR:TARGET:MASCALL%にこうされるたびに、俺、もう……❤」
			ENDSELECT
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「ほ、ほんとに、やめっ……！」
			RETURN 1
		ENDIF
	;解除
	ELSE
		IF TALENT:연모
			마조끼修正 = 3
			SIF ABL:TARGET:마조끼 >= 5
				마조끼修正 += 1
			SIF ABL:TARGET:마조끼 >= 4
				마조끼修正 += 1
			SIF ABL:TARGET:마조끼 >= 3
				마조끼修正 += 1
			SIF ABL:TARGET:마조끼 >= 2
				마조끼修正 += 1
			SIF ABL:TARGET:마조끼 >= 1
				마조끼修正 += 2
			SELECTCASE RAND:마조끼修正 + 1
				CASE 1
					PRINTFORMW 「なに만족げな顔してんだよ、バカぁ……っ」
				CASE 2
					PRINTFORMW 「……っぁ、急に抜くなぁっ、ばかっ……」
				CASE 3
					PRINTFORMW 「ぁっ、ジロジロ観察してんじゃねぇっ……」
				;마조끼1以上
				CASE 4
					PRINTFORMW 「はぁっ、やっと抜けた……うぅっ……」
				CASE 5
					PRINTFORMW 「うぅっ……こんなこと、させやがってぇ……」」
				CASE 6
					PRINTFORMW 「んぁっ、尻が熱いぃ……❤」
				CASE 7
					PRINTFORMW 「……あぁ、%CSTR:TARGET:MASCALL%の手で、またおかしくされちまった……❤」
				CASE 8
					PRINTFORMW 「なぁ、このあと、どうする気だよっ……❤」
				CASE 9
					PRINTFORMW 「あぁっ……❤　ぜんぶ、お前の好きにしてくれ……❤」
			ENDSELECT
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「うう、最悪だ……っ」
			RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1

