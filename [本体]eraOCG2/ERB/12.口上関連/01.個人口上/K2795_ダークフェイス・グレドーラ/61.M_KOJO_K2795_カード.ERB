;※※※※※※※※※※※※※※※※※※※※※※※※※
;CARD用구상
;※※※※※※※※※※※※※※※※※※※※※※※※※
;直接カードのIDを使える。
;캐릭터が無くても動く
;存在証明
@M_KOJO_CARD_K2795
RETURN 1
;==================================================
;0,モンスター소환時
;==================================================
@M_KOJO_CARD_K2795_0(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「我が手繰るは無尽の糸、この手に墜ちぬ贄は無し……」
ENDIF

;==================================================
;1,攻撃時
;==================================================
@M_KOJO_CARD_K2795_1(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE RAND:2 + 1
		CASE 1
			PRINTFORMW 「喰ろうてやろうぞ」
		CASEELSE
			PRINTFORMW 「さあ、糧となるがいい」
	ENDSELECT
ENDIF

;==================================================
;2,효과발동
;==================================================
;효과別で鳴らしたいなら、直接カードのデータを見て、설정する必要がある
;面倒、分からないであれば분기はせず
;失敗판정は、いわゆる효과를 無効にされたとかそういうやつ
@M_KOJO_CARD_K2795_2(종류,失敗판정)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 종류
#DIM DYNAMIC 失敗판정
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 失敗판정 == 0
		SELECTCASE 종류
			CASE 효과後誘発
				PRINTFORMW 「妾の巣は獲物を決して逃がさん♪」
			CASE 필드起動,フリー誘発
				PRINTFORMW 「さあ、メガコロニーに新たな子が産まれるぞ！」
		ENDSELECT
	ELSE
		; PRINTFORMW 
	ENDIF
ENDIF

;==================================================
;3,除去時
;==================================================
;いちいちなんでも除去で話すとやかましいため、デフォでは破壊にのみ反応するように설정
@M_KOJO_CARD_K2795_3(除去종류,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 除去종류
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 除去종류
	CASE 破壊行き
		PRINTFORMW 「ふふ、良き戦士じゃの」
	ENDSELECT
ENDIF

