;==================================================
;5,효과발동
;==================================================
@M_KOJO_DUEL_K2795_5(カードID,효과종류)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC 효과종류
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	;無効にされた場合
	IF 효과종류 == -1
		PRINTFORMW 「くくく、一筋밧줄ではいかぬか」
	;それ以外
	ELSE
		IF カードID == 30055 ;プロムラーバ
			SELECTCASE 효과종류
				CASE 손패起動
					PRINTFORMW 「%カード名%は덱에서 インセクトをドロップすることでスペリオルコールできる……」
				CASE 필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지
					PRINTFORMW 「こやつは死してなお策謀を妾の為に残しておいてくれるでのぉ……덱에서 メガコロニー마법または함정を손패に」
				CASE 身代효과
					PRINTFORMW 「そなたの献身、無駄にはせぬぞ」
				CASEELSE
					GOTO HANYOU
			ENDSELECT
		ELSEIF カードID == 2795 ;グレドーラ
			SELECTCASE 효과종류
				CASE 효과後誘発
					PRINTFORMW 「おっと、そなたのしもべが妾の巣にかかってしまったようじゃのぉ……」
				CASE 필드起動,フリー誘発
					PRINTFORMW 「ふふ、繭が孵るか、より強き子が生まれるか。 楽しみじゃのぉ……」
				CASEELSE
					GOTO HANYOU
			ENDSELECT
		ELSEIF カードID == 55070 ;罪魁グレドーラ
			SELECTCASE 효과종류
				CASE EX소환時
					PRINTFORMW 「次のターンの終了時まで、손패以外からのスペリオルコールは許さぬ」
				CASE 필드起動,フリー誘発
					PRINTFORMW 「それ、そなたの繭が妾の子として生まれ変わるぞ……」
				CASEELSE
					GOTO HANYOU
			ENDSELECT
		ELSEIF カードID == 30050 ;アルキデス
			SELECTCASE 효과종류
				CASE 필드起動,フリー誘発
					PRINTFORMW 「強き勇士も万全の状態でなくせば脅威とはならぬ……パラライズ」
				CASE 효과後誘発
					PRINTFORMW 「さあ"ダークフェイス"よ、繭を喰らいて強くなるがいい！」
				CASE 필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지
					PRINTFORMW 「くくく、妾がいる限りアルキデスは패 / 필드의 インセクトを喰らい復活する！」
				CASEELSE
					GOTO HANYOU
			ENDSELECT
		ELSEIF カードID == 30051 ;ボルグワスプ
			SELECTCASE 효과종류
				CASE 손패起動
					PRINTFORMW 「패 / 필드의 インセクトを喰らい出でよ」
				CASE 묘지起動
					PRINTFORMW 「패 / 필드의 インセクトを喰らい甦れ」
				CASE 필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지
					PRINTFORMW 「くく、ボルグワスプは１匹ではないのだぞ？」
				CASEELSE
					GOTO HANYOU
			ENDSELECT
		ELSEIF カードID == 30052 ;ネルニムファ
			SELECTCASE 효과종류
				CASE 손패起動
					PRINTFORMW 「おや、そなたのしもべが酔いしれているようじゃのぉ……出番じゃ、%カード名%」
				CASE 묘지起動
					PRINTFORMW 「ほれ、そなたのしもべの美しき死を、奏でたがっている子がおるぞ……」
				CASE 필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지
					PRINTFORMW 「いずこから聞こえる旋律に、哀れな餌食がまた一人……、さあ、そなたのしもべを"印"を置いた状態で呼ぶがよい」
				CASEELSE
					GOTO HANYOU
			ENDSELECT
		ELSEIF カードID == 30053 ;リトルドルカス
			SELECTCASE 효과종류
				CASE 소환時,특수소환時
					PRINTFORMW 「こやつの笛が鳴ったぞ、聞こえぬか？ 巨悪の足音が……」
				CASE 필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지
					PRINTFORMW 「笛の音は止む事はない……この世に悪が栄える限り、のぉ」
				CASEELSE
					GOTO HANYOU
			ENDSELECT
		ELSEIF カードID == 30054 ;パラライズ・マドンナ
			SELECTCASE 효과종류
				CASE 발동誘発
					PRINTFORMW 「完全ガード、%カード名%」
				CASE 필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지
					PRINTFORMW 「チェック、ドロートリガー。 ……おっと、好きな子を加えられるんじゃったのぉ」
				CASEELSE
					GOTO HANYOU
			ENDSELECT
		ELSEIF カードID == 71670 ;犯罪結社メガコロ
			SELECTCASE 효과종류
				CASE 마함起動,손패起動
					PRINTFORMW 「妾の子らは犠牲を厭わぬ……패 / 필드의 インセクトと引き換えに덱のメガコロニーを손패に加える」
				CASE 묘지起動
					PRINTFORMW 「패 / 필드의 インセクト引き換えに、そなたの場の카드 １장을 파괴한다。 さあ暗躍せよ、我が子らよ！」
				CASEELSE
					GOTO HANYOU
			ENDSELECT
		ELSEIF カードID == 71671 ;無尽の糸
			SELECTCASE 효과종류
				CASE 마함起動,손패起動,フリー誘発
					PRINTFORMW 「ふふ、死の果てまでも妾の糸の内よ」
				CASEELSE
					GOTO HANYOU
			ENDSELECT
		ELSEIF カードID == 91670 ;悪しき女王の戯れ
			SELECTCASE 효과종류
				CASE 마함起動,フリー誘発
					PRINTFORMW 「さあ、新たな子が生まれるぞ……」
				CASE 묘지起動
					PRINTFORMW 「さて、そなたはどう可愛がってやろうか……덱에서 마법 / 함정 카드 １장을 손패に加えるぞ」
				CASEELSE
					GOTO HANYOU
			ENDSELECT
		ELSEIF カードID == 91670 ;悪しき女王の戯れ
			SELECTCASE 효과종류
				CASE 발동誘発
					PRINTFORMW 「妾の巣では、かような狼藉は許さぬぞ？ そなたの그 효과는 無効じゃ」
					PRINTFORMW 「それに……仕置きとして、そなたのしもべに印をつけさせてもらおうかのぉ？」
				CASE 효과後誘発
					PRINTFORMW 「そなたのしもべを糧として、妾の子らはより強くなる……！ 덱에서 몬스터 １장을 손패に加えるぞ」
				CASEELSE
					GOTO HANYOU
			ENDSELECT
		ENDIF
		RETURN
$HANYOU
		; SELECTCASE RAND:3 + 1
		; 	CASE 1
		; 		PRINTFORMW 
		; 	CASE 2			
		; 		PRINTFORMW 
		; 	CASE 3
		; 		PRINTFORMW 
		; ENDSELECT
	ENDIF
ENDIF

