;DUEL用구상
;※※※※※※※※※※※※※※※※※※※※※※※※※
;カードID == (カードの番号)　でそのカード専用の구상が流せる
;カード番号は 10.デュエル関連/02.CARDS 内に入っているため、必要に応じて参照するように
;例：
;		IF カードID == 1000
;			PRINTFORMW 「ブラックマジシャンガールを소환！」
;		ENDIF

;==================================================
;0,デュエルスタート！
;==================================================
@M_KOJO_DUEL_K2795_0(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「この女王が、直々に상대をしてやろう」
		CASE 2
			PRINTFORMW 「さあ、妾の子らの餌食となるがいい」
		CASE 3
			PRINTFORMW 「楽しみじゃのぉ、そなたのひれ伏す姿がの……」
	ENDSELECT
ENDIF

;==================================================
;1,モンスター소환
;例：%カード名%を소환！
;==================================================
@M_KOJO_DUEL_K2795_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「ゆけ、%カード名%」
		CASE 2
			PRINTFORMW 「コール、%カード名%」
		CASE 3
			PRINTFORMW 「来い、%カード名%」
	ENDSELECT
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_KOJO_DUEL_K2795_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 소환出処
		;패에서 
		CASE 召種손패
			IF カードID == 30055 ;プロムラーバ
				PRINTFORMW 「さあ、先駆となれ。 %カード名%」
			ELSE
				PRINTFORMW 「%カード名%を패에서 スペリオルコール」
			ENDIF
		;마법함정ゾーンから。　キリ番・シェイプシスターなどを出す場合
		CASE 召種마함
			PRINTFORMW 「ふふ、面白い감각じゃの。 %カード名%を마법&함정 존よりスペリオルコール」
		;덱에서 
		CASE 召種덱
			IF カードID == 30050 ;アルキデス
				PRINTFORMW 「我が最愛の愛し子、%カード名%よ！ 덱より来たれ！」
			ELSEIF カードID == 30051 ;ボルグワスプ
				PRINTFORMW 「ふふ、聞こえぬか？ この羽音が……%カード名%！」
			ELSE
				PRINTFORMW 「%カード名%を덱よりスペリオルコール」
			ENDIF
		;EX덱에서 
		CASE 召種EX덱
			PRINTFORMW 「%カード名%をＧゾーン……ＥＸ덱よりスペリオルコール」
		;묘지에서 
		CASE 召種묘지
			IF カードID == 30050 ;アルキデス
				PRINTFORMW 「いくら喰らおうと構わぬ。 再び甦れ、%カード名%！」
			ELSEIF カードID == 30051 ;ボルグワスプ
				PRINTFORMW 「寝ぼけておる暇などあるまい。 妾の敵を討て、%カード名%」
			ELSEIF カードID == 30052 ;ネルニムファ
				PRINTFORMW 「さあ、死より甘き旋律が聞こえるじゃろう？ %カード名%」
			ELSE
				SELECTCASE RAND:2 + 1
					CASE 1
						PRINTFORMW 「死してなおメガコロニーの為に働いてもらおうぞ、%カード名%」
					CASE 2
						PRINTFORMW 「%カード名%をドロップゾーンよりスペリオルコール」
				ENDSELECT
			ENDIF
		;제외状態から
		CASE 召種제외
			PRINTFORMW 「ふふ、どこへ行っても妾の糸の上よ。 %カード名%、来い」
		;主にトークン生成
		CASE 10
			PRINTFORMW 「来い、%カード名%」
	ENDSELECT
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K2795_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORMW 「喰らえば喰らうほど強き者が生まれるのぉ、%カード名%！」
		CASE 융합
			PRINTFORMW 「相異なるものを混ぜ合わせるなど造作もない。 %カード名%！」
		CASE 싱크로
			PRINTFORMW 「ふふ、そなたにも蟲の調べが聞こえたかの？ %カード名%！」
		CASE 엑시즈
			SELECTCASE RAND:2 + 1
				CASE 1
					PRINTFORMW 「上に立つものよ、喰らいて力と成すものよ。 %カード名%！」
				CASE 2
					PRINTFORMW 「ライド、%カード名%」
			ENDSELECT
		CASE 링크
			IF カードID == 2795 ;グレドーラ
				PRINTFORMW 「我が手繰るは無尽の糸、この手に墜ちぬ贄は無し」
				PRINTFORMW 「ライド！ %カード名%！」
			ELSE
				SELECTCASE RAND:2 + 1
					CASE 1
						PRINTFORMW 「妾が指す所、悪意あり……%カード名%！」
					CASE 2
						PRINTFORMW 「ライド、%カード名%」
				ENDSELECT
			ENDIF
		;초차원モンスター（デュエマ）
		CASE 초차원
			IF カードID == 55070 ;罪魁グレドーラ
				PRINTFORMW 「永劫無窮の罪悪巣窟、それが妾のこの国よ！」
				PRINTFORMW 「時空超越≪ストライドジェネレーション≫！ %カード名%！」
			ELSE
				PRINTFORMW 「時空超越≪ストライドジェネレーション≫！ %カード名%！」
			ENDIF
	ENDSELECT
ENDIF

