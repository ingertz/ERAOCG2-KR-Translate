;==================================================
;10,ダメージ反応！（ダメージ）
;==================================================
@M_KOJO_DUEL_K2795_10(ダメージ量,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC ダメージ量
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE ダメージ量
		;ダメージなし
		CASE 0
			PRINTFORMW 「ふふ、女王を傷つけるにはいささか足りぬのぉ」
		;１～１９９９の時、小ダメージ
		CASE 1 TO 1999
			PRINTFORMW 「ふむ、いい一撃じゃ」
		;２０００～３９９９の時、結構なダメージ
		CASE 2000 TO 3999
			PRINTFORM 「くっ……、
			IF ライフ_상대 >= 0
				PRINTFORMW いい目じゃのぉ……」
			ELSE
				PRINTFORMW ……ここまでのようじゃの」
			ENDIF
		;４０００～７９９９の時、超大ダメージ
		CASE 4000 TO 7999
			PRINTFORMW 「くっ……！ 良き戦士じゃのぉ……！」
		;８０００以上、基本即死
		CASEELSE
			PRINTFORMW 「──ふふ、見事じゃ──！」
	ENDSELECT
ENDIF


