;※※※※※※※※※※※※※※※※※※※※※※※※※
;CARD用구상
;※※※※※※※※※※※※※※※※※※※※※※※※※
;直接カードのIDを使える。
;캐릭터が無くても動く
;存在証明
@M_KOJO_CARD_K30050
RETURN 1
;==================================================
;0,モンスター소환時
;==================================================
@M_KOJO_CARD_K30050_0(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「俺様は完璧なのだ！」
		CASE 2
			PRINTFORMW 「万夫不当！ 最上無二！」
		CASEELSE
			PRINTFORMW 「女王陛下！ この命の全てを賭けて！」
	ENDSELECT
ENDIF

;==================================================
;1,攻撃時
;==================================================
@M_KOJO_CARD_K30050_1(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE RAND:2 + 1
		CASE 1
			PRINTFORMW 「女王陛下の名を受け継いだ最強怪人の力、思い知れ！」
		CASEELSE
			PRINTFORMW 「誰も俺様を止めることなど出来ないィ！」
	ENDSELECT
ENDIF

;==================================================
;2,효과발동
;==================================================
;효과別で鳴らしたいなら、直接カードのデータを見て、설정する必要がある
;面倒、分からないであれば분기はせず
;失敗판정は、いわゆる효과를 無効にされたとかそういうやつ
@M_KOJO_CARD_K30050_2(종류,失敗판정)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 종류
#DIM DYNAMIC 失敗판정
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 失敗판정 == 0
		SELECTCASE 종류
			CASE 필드起動,フリー誘発
				SELECTCASE RAND:2 + 1
					CASE 1
						PRINTFORMW 「生かさぬよう。 殺さぬよう。 いい格言だなァ！？」
					CASEELSE
						PRINTFORMW 「膝を折れ！ 地を這いずれェ！」
				ENDSELECT
			CASE 효과後誘発
				SELECTCASE RAND:2 + 1
					CASE 1
						PRINTFORMW 「俺様は強くなる！ 女王陛下から頂いたこの名にふさわしく！」
					CASEELSE
						PRINTFORMW 「女王陛下の覇道の前に！ 邪魔なんだよォ！」
				ENDSELECT
			CASE 필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지
				SELECTCASE RAND:2 + 1
					CASE 1
						PRINTFORMW 「女王様の為ならばァ！ 野を越え山越え冥府越えェ！」
					CASEELSE
						PRINTFORMW 「俺様！ 復・活！！」
				ENDSELECT
		ENDSELECT
	ELSE
		; PRINTFORMW 
	ENDIF
ENDIF

;==================================================
;3,除去時
;==================================================
;いちいちなんでも除去で話すとやかましいため、デフォでは破壊にのみ反応するように설정
@M_KOJO_CARD_K30050_3(除去종류,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 除去종류
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 0
;-------------------------------------------------
IF LOCAL
	SELECTCASE 除去종류
	; CASE 破壊行き
	; 	PRINTFORMW 「女王陛下ーッ！」
	ENDSELECT
ENDIF

