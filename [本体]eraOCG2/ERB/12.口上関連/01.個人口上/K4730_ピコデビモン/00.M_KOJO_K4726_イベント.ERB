;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT"系이벤트
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;部屋で遭遇
;==================================================
@M_KOJO_EVENT_K4726_1(ARG,ARG:1)
;구상主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------
IF LOCAL
	;空行
	PRINTFORML
	;-------------------------------------------------
	;一日初めての挨拶분기（MAIN/お外どちらも）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && GROUPMATCH(ARG,1,2,6) && CFLAG:TARGET:인사했음 == 0
		IF CFLAG:1000 == 1
			PRINTFORMW 「おはよう、%CSTR:TARGET:MASCALL%」
		ELSEIF CFLAG:1001 == 2
			PRINTFORMW 「おはよう、%CSTR:TARGET:MASCALL%」
		ENDIF
		RETURN 1
	ENDIF

	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:1000 == 1
			PRINTFORMW 「おお、%CSTR:TARGET:MASCALL%」
			IF CFLAG:호감도 >= 100 && !CFLAG:1002
				PRINTFORMW 「んん？ んあっ…こ、これはなんだ？」
				PRINTFORMW 
				PRINTFORMW 
				CALL K4726_EVOLUTION2
				CFLAG:1002 = 1
			ENDIF
		ELSEIF CFLAG:1000 == 2
			PRINTFORMW 「おお、%CSTR:TARGET:MASCALL%」
			IF CFLAG:호감도 >= 500 && !CFLAG:1003
				PRINTFORMW 「んん？ む…これはまさか…」
				PRINTFORMW 
				PRINTFORMW 
				CALL K4726_EVOLUTION3
				CFLAG:1003 = 1
			ENDIF
		ELSEIF CFLAG:1000 == 3
			PRINTFORMW 「おや、%CSTR:TARGET:MASCALL%じゃないか」
			IF CFLAG:호감도 >= 1000 && !CFLAG:1004
				PRINTFORMW 「んん？ おっと…これはまさか…」
				PRINTFORMW 
				PRINTFORMW 
				CALL K4726_EVOLUTION4
				CFLAG:1004 = 1
			ENDIF
		ELSEIF CFLAG:1000 == 4
			PRINTFORMW 「奇遇だな、%CSTR:TARGET:MASCALL%」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;eraOCG2_V0.40_BT_240518時点では流れないため注意
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:1000 == 1
			PRINTFORMW 「おお、%CSTR:TARGET:MASCALL%」
		ELSEIF CFLAG:1000 == 2
			PRINTFORMW 「おお、%CSTR:TARGET:MASCALL%」
		ELSEIF CFLAG:1000 == 3
			PRINTFORMW 「おや、%CSTR:TARGET:MASCALL%じゃないか」
		ELSEIF CFLAG:1000 == 4
			PRINTFORMW 「奇遇だな、%CSTR:TARGET:MASCALL%」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;eraOCG2_V0.40_BT_240518時点では流れないため注意
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF CFLAG:1000 == 1
			PRINTFORMW 「おお、%CSTR:TARGET:MASCALL%、%CSTR:TARGET:SELFCALL%も一緒にいいよな？」
		ELSEIF CFLAG:1000 == 2
			PRINTFORMW 「おお、%CSTR:TARGET:MASCALL%、%CSTR:TARGET:SELFCALL%も一緒に入らせてもらおうか」
		ELSEIF CFLAG:1000 == 3
			PRINTFORMW 「おや、%CSTR:TARGET:MASCALL%じゃないか、%CSTR:TARGET:SELFCALL%も一緒に入らせてもらうよ？」
		ELSEIF CFLAG:1000 == 4
			PRINTFORMW 「奇遇だな、%CSTR:TARGET:MASCALL%、%CSTR:TARGET:SELFCALL%も一緒に入らせてもらうぞ？」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;eraOCG2_V0.40_BT_240518時点では流れないため注意
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF CFLAG:1000 == 1
			PRINTFORMW 「おっと、%CSTR:TARGET:MASCALL%、先客がいるなら水浴びは後だな～」
		ELSEIF CFLAG:1000 == 2
			PRINTFORMW 「おっと、%CSTR:TARGET:MASCALL%か それなら%CSTR:TARGET:SELFCALL%は後で入らせてもらろうか」
		ELSEIF CFLAG:1000 == 3
			PRINTFORMW 「おや、%CSTR:TARGET:MASCALL%じゃないか、それなら%CSTR:TARGET:SELFCALL%は後にさせえてもらろうかな？」
		ELSEIF CFLAG:1000 == 4
			PRINTFORMW 「おや、%CSTR:TARGET:MASCALL%、それなら%CSTR:TARGET:SELFCALL%は後で入らせてもらうとしよう」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;未確認
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;eraOCG2_V0.40_BT_240522時点では流れないため注意
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORMW  
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他캐릭터と데이트중に遭遇した
	;eraOCG2_V0.40_BT_240522時点では流れないため注意
	;ARG:1にデート상대
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		PRINTFORMW  
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;朝起きたとき（おはよう구상）
;==================================================
@M_KOJO_EVENT_K4726_2(ARG,ARG:1)
;구상主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------
IF LOCAL
	;空行
	PRINTFORML
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;MASTERが起きていて、상대가 起きてきた（いつでも）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF CFLAG:1000 == 1
			PRINTFORMW 「%CSTR:TARGET:MASCALL%か…よし、%CSTR:TARGET:SELFCALL%はバッチリ目覚めたぜ？ んで、何かするのか？」
		ELSEIF CFLAG:1000 == 2
			PRINTFORMW 「%CSTR:TARGET:MASCALL%か…ふむ、%CSTR:TARGET:SELFCALL%は目を覚ましたぞ？ それで何かするのか？」
		ELSEIF CFLAG:1000 == 3
			PRINTFORMW 「%CSTR:TARGET:MASCALL%か…ふふっ、起きて早々顔を見れるなんてついているね それで何かするのかい？」
		ELSEIF CFLAG:1000 == 4
			PRINTFORMW 「%CSTR:TARGET:MASCALL%…起きて早々顔を見られて嬉しいよ それで何かするのかな？」
		ENDIF
		RETURN 1
	ENDIF
	;非同棲かつ상대가 先に起きてる
	;20250310現在、流れる상황は無い
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:1000 == 1
			PRINTFORMW 「起きろ、%CSTR:TARGET:MASCALL%…もう朝だぞ？ 起きないと悪戯しちゃうぞ？ いいのか？」
		ELSEIF CFLAG:1000 == 2
			PRINTFORMW 「起きるのだ、%CSTR:TARGET:MASCALL%…もう朝だぞ？ それとも%CSTR:TARGET:SELFCALL%の好きにしていいのか？」
		ELSEIF CFLAG:1000 == 3
			PRINTFORMW 「起きな、%CSTR:TARGET:MASCALL%…もう朝だよ？ 起きないなら%CSTR:TARGET:SELFCALL%の好きにするよ？ いいのかい？」
		ELSEIF CFLAG:1000 == 4
			PRINTFORMW 「起きろ、%CSTR:TARGET:MASCALL%…もう朝だ 起きてくれないと、%CSTR:TARGET:SELFCALL%は悲しい どうか起きてくれ」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;朝に성교
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:1000 == 1
			PRINTFORMW 「へへ、朝から%CSTR:TARGET:MASCALL%は盛んだな～♥」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;상대가 寝ている
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF CFLAG:1000 == 1
			PRINTFORMW 「くかー…くかー…」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERが起きていて、상대가 起きてきた（朝のみ）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF CFLAG:1000 == 1
			PRINTFORMW 「%CSTR:TARGET:MASCALL%、もう朝か～？」
			PRINTFORMW 「ふわ～…まだ眠い…」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;상대가 起きてきて、MASTERが감기気味（朝のみ）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF CFLAG:1000 == 1
			PRINTFORMW 「どうしたんだよ、%CSTR:TARGET:MASCALL%…顔色が悪いぜ？」
			PRINTFORMW 「감기？ わわ、そりゃ寝てなきゃ駄目だぜ」
		ENDIF
		RETURN 1
	ENDIF
ENDIF
RETURN 1

;==================================================
;夜寝るとき（おやすみ구상）
;==================================================
@M_KOJO_EVENT_K4726_3(ARG,ARG:1)
;구상主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;自室に帰って寝る（～は【現在地】から【캐릭터の自室】に戻りました）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF CFLAG:우후후
			;우후후ダウン後に何も言わせない場合はここに何も書かない
			PRINTFORML
		ELSE
			IF CFLAG:1000 == 1
				PRINTFORMW 「そろそろ帰るかな～…おやすみ、%CSTR:TARGET:MASCALL% いい夢見ろよ～」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;수면中（～は眠っている）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		IF CFLAG:1000 == 1
			PRINTFORMW 「くかー…くかー…」
		ENDIF
		RETURN 1
	ENDIF

	;-------------------------------------------------
	;쇠약して寝る（체력500以下,우후후時は우후후強制終了）
	;（캐릭터の自室以外：～を【現在地】から【캐릭터の自室】に運びました）
	;（캐릭터の自室　　：～は疲れたと言って、横になりました）
	;この後ARG == 1 が流れる
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF CFLAG:우후후
			IF CFLAG:1000 == 1
				;우후후中にダウン
				PRINTFORMW 「はあ…♥ もう限界だぜ…♥」
			ENDIF
		ELSE
			IF CFLAG:1000 == 1
				PRINTFORMW 「んあ…ちょっと疲れたなぁ…」
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERがダウン（연모のみ,そのまま一日が終了）
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF CFLAG:우후후
