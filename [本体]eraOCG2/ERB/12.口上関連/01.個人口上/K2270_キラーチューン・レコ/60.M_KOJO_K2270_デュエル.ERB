;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 발동出処
		CASE 1
			;손패발동
			IF GROUPMATCH(カードID,79840,79841,79842,79843,79844,79845,79846,79847,79848)
				SELECTCASE RAND:3
					CASE 0
