;カードID == (カードの番号)　でそのカード専用の구상が流せる
;カード番号は 10.デュエル関連/02.CARDS 内に入っているため、必要に応じて参照するように
;例：
;		IF カードID == 1000
;			PRINTFORMW 「ブラックマジシャンガールを소환！」
;		ENDIF

;==================================================
;0,デュエルスタート！
;==================================================
@M_KOJO_DUEL_K2270_0(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「OK~, 듀얼 개시 선언을 해볼까」
			PRINTFORMW 「듀얼 개시~……!」
		CASE 2
			PRINTFORMW 「『킬러 튠』의 장점이란 걸 알려줄게」
		CASE 3
			PRINTFORMW 「후후, 너와의 듀얼인가……, 열심히 해볼게」
	ENDSELECT
ENDIF

;==================================================
;1,モンスター소환
;例：%カード名%を소환！
;==================================================
@M_KOJO_DUEL_K2270_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF カードID == 2270
		PRINTFORMW 「%カード名%, 아니, 나를 소환」
	ELSEIF カードID == 2271
		PRINTFORMW 「%カード名%, 좀 이것저것 만지러 나와줘」
	ELSEIF カードID == 2272
		PRINTFORMW 「%カード名%, 튀어나와」
	ELSEIF カードID == 2273
		PRINTFORMW 「%カード名%, 오늘의 게스트…… 부를 수 있어?」
	ELSE
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「%カード名%, 오늘은 너를 지명하겠어」
		CASE 2
			PRINTFORMW 「%カード名%를 소환할게」
		CASE 3
			PRINTFORMW 「%カード名% 소환, ……그리고, 다음은……」
	ENDSELECT
	ENDIF
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_KOJO_DUEL_K2270_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 소환出処
		;패에서 
		CASE 召種손패
			IF GROUPMATCH(カードID,2270,2271,2272,2273)		
				IF カードID == 2270
					PRINTFORMW 「%カード名%, 아니 나, 여기서 특수 소환」
				ELSEIF カードID == 2271
					PRINTFORMW 「%カード名%, 차례야」
				ELSEIF カードID == 2272
					PRINTFORMW 「%カード名%, 좀 튀어나와」
				ELSEIF カードID == 2273
					PRINTFORMW 「%カード名%, 지금 나와줘」
				ELSE
					PRINTFORMW 「%カード名%(을)를 특수 소환」
				ENDIF
			ENDIF
		;마법함정ゾーンから。　キリ番・シェイプシスターなどを出す場合
		CASE 召種마함
				PRINTFORMW 「마법 함정 존에서 %カード名%(을)를 불러낼게」
		;덱에서 
		CASE 召種덱
			IF GROUPMATCH(カードID,2270,2271,2272,2273)		
				PRINTFORMW 「자, 킬러 튠의 멤버를 불러보실까…!」
			ELSE
				PRINTFORMW 「덱에서 %カード名%를 특수 소환……!」
			ENDIF
		;EX덱에서 
		CASE 召種EX덱
			PRINTFORMW 「비기 보여줄게……, EX 덱에서 직접 이 녀석을 소환……, %カード名%!」
		;묘지에서 
		CASE 召種묘지
			PRINTFORMW 「묘지에서 돌아와…… %カード名%!」
		;제외状態から
		CASE 召種제외
			PRINTFORMW 「차원의 틈을 부수고…… 돌아와라, %カード名%」
		;主にトークン生成
		CASE 10
			PRINTFORMW 「토큰 생성……! ……자 그럼 이 녀석을…… 어떻게 할까」
	ENDSELECT
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K2270_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORMW 「정당한 의식 아래, 지금 여기에 내려서라…… %カード名%!」
		CASE 융합
			PRINTFORMW 「융합(리믹스)이라고 해볼까…… %カード名%!」
		CASE 싱크로
			IF カードID == 42270
				PRINTFORML 「자아, 주역의 등장이라고 해볼까……!」
				PRINTFORMW 「%カード名%……, 내가 나설 차례야……!」
			ELSEIF カードID == 42271
				PRINTFORML 「모인 곡을 조율하여, 새로운 선율을 자아낸다……!」
				PRINTFORMW 「튠 싱크로…… %カード名%……!」
			ELSEIF カードID == 52180
				PRINTFORML 「쌓아 올린 소리를 끼워 맞추어, 진정한 조율을 이끌어낸다……!」
				PRINTFORMW 「튠 싱크로…… %カード名%……!」
			ELSEIF カードID == 52181
				PRINTFORML 「우리들의 곡을 연주할 장소여…… 지금이야말로 기동해, 분위기 띄워라!」
				PRINTFORMW 「튠 싱크로…… %カード名%……!」
			ELSE
			PRINTFORMW 「킬러 튠도 때로는 이런 동조(싱크로)한다는 거 보여줄게…… %カード名%!」
			ENDIF
		CASE 엑시즈
			PRINTFORMW 「오버레이 네트워크 구축……, 자, 이중주로 가볼까…… %カード名%!」
		CASE 링크
			PRINTFORMW 「몬스터를 링크 마커에……, 그리고, 애로우헤드 확인…… 링크 소환…… %カード名%!」
		;초차원モンスター（デュエマ）
		CASE 초차원
			PRINTFORMW 「초차원 존에서 부르겠어…… 이향의 존재…… %カード名%!」
	ENDSELECT
ENDIF

;==================================================
;4,효과使用宣言
;==================================================
@M_KOJO_DUEL_K2270_4(カードID,발동出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC 발동出処
TRYCALLFORM CARDNAME_{カードID}("名前")
