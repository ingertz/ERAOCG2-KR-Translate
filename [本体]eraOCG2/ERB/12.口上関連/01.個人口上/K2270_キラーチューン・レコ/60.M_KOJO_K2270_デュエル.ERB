;==================================================
;10,ダメージ反応！（ダメージ）
;==================================================
@M_KOJO_DUEL_K2270_10(ダメージ量,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC ダメージ量
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE ダメージ量
		;ダメージなし
		CASE 0
			IF ライフ_상대 < 2000
				PRINTFORMW 「(음~…… 데미지 없음인가……, ……이건 이거대로 무섭네)」
			ELSEIF ライフ_상대 < 4000
				PRINTFORMW 「(데미지 없음, ……좋은 건지 나쁜 건지……)」
			ELSE
				PRINTFORMW 「피해 없음, 세이프려나……」
			ENDIF
		;１～１９９９の時、小ダメージ
		CASE 1 TO 1999
			IF ライフ_상대 < 0
				PRINTFORMW 「역시 %CALLNAME:MASTER%…… 확실하게 숨통을 끊으러 오네……」
			ELSEIF ライフ_상대 < 2000
				PRINTFORMW 「……위험해…… 위험하네 이거」
			ELSEIF ライフ_상대 < 4000
				PRINTFORMW 「(LP 절반 깎였나…… 이거 곤란하네)」
			ELSE
				PRINTFORMW 「아얏」
			ENDIF
		;２０００～３９９９の時、結構なダメージ
		CASE 2000 TO 3999
			IF ライフ_상대 < 2000
				PRINTFORMW 「호쾌하게 끝장냈네~, 화려한 건 좋아해, %CALLNAME:MASTER%」
			ELSEIF ライフ_상대 < 2000
				PRINTFORMW 「으아"~~위험해……!」
			ELSEIF ライフ_상대 < 4000
				PRINTFORMW 「아하하, 벌써 절반인가, 빡세네」
			ELSE
				PRINTFORMW 「……꽤나 무거운 일격 날려주네…… %CALLNAME:MASTER%」
			ENDIF
