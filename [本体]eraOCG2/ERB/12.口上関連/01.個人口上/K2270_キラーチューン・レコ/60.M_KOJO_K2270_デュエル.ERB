						PRINTFORML ……좀 놀라게 해줄게……
						PRINTFORM 　%カード名%(을)를 패에서 발동……! ……놀랐어…? 나도 나름대로 듀얼에 익
						CALL XON_FONT("숙해졌다는 거니까……,溶❤1",C_PINK)
						PRINTFORMW 」					
						RESETCOLOR						
					CASE 1
						PRINTFORM 「
						CALL XON_FONT("──√￣……네, 발동……하겠습니다……,壊❤",C_PINK)
						SETCOLOR C_AQUA
						PRINTFORML ……그럼, 좀 아깝지만……
						PRINTFORM 　%カード名%, 발……동, 할 테니까……, 이
						CALL XON_FONT("게 이쪽에서 얻은…… 비장의 수 중 하나니까……,溶❤1",C_PINK)
						PRINTFORMW 」
						RESETCOLOR						
					CASE 2
						PRINTFORM 「
						CALL XON_FONT("──√￣……네, 알겠습니다……,壊❤",C_PINK)
						SETCOLOR C_AQUA
						PRINTFORML ……패에서, 마법 카드,
						PRINTFORM 　%カード名%, 발동……, ……아무것도 없으
						CALL XON_FONT("면…… 이대로 효과 처리로, 넘어갈 테니까……,溶❤1",C_PINK)
						PRINTFORMW 」
						RESETCOLOR						
				ENDSELECT
			ELSEIF GROUPMATCH(カードID,79853,79854,79855,79857)
				SELECTCASE RAND:3
					CASE 0
					SETCOLOR C_PINK
						PRINTFORM 「──√￣……%CALLNAME:TARGET%、
						CALL XON_FONT("라져……,壊❤",C_PINK)
						SETCOLOR C_AQUA
						PRINTFORML ……놀라도 좋아………읏
						PRINTFORM 　%カード名%(을)를 패에서 발동
						PRINTFORM ……, 이쪽에서 손에 넣은 좀
						PRINTFORM 
						CALL XON_FONT("새로운 힘이에요, ……놀랍죠……,溶❤1",C_PINK)
						PRINTFORMW 」
						RESETCOLOR						
					CASE 1
						SETCOLOR C_PINK
						PRINTFORM 「──√￣……%CALLNAME:TARGET%、
						CALL XON_FONT("라져……,壊❤",C_PINK)
						SETCOLOR C_AQUA
						PRINTFORML ……으음…… 그럼 이거 쓸게………읏
						PRINTFORM 　%カード名%…! 지금부터, %CALLNAME:MASTER%
						CALL XON_FONT("는 나의, 봉사를 받게 될…… 테니까……,溶❤1",C_PINK)
						PRINTFORMW 」
						RESETCOLOR						
					CASE 2
						SETCOLOR C_PINK
						PRINTFORM 「──√￣……%CALLNAME:TARGET%、
						CALL XON_FONT("라져……,壊❤",C_PINK)
						SETCOLOR C_AQUA
						PRINTFORML ……나의 좀…… 뭐, 비장의 수라는 녀석……
						PRINTFORM 　%カード名%! ……이것의
						CALL XON_FONT("효과로, 나는 봉사로 직접 공격을 할 수 있다는 말씀……,溶❤1",C_PINK)
						PRINTFORMW 」
						RESETCOLOR						
				ENDSELECT
			ELSEIF GROUPMATCH(カードID,62270,62271)
				PRINTFORMW 「이 녀석을 쓰겠어…… %カード名%!!」
			ELSE
			PRINTFORMW 「패에서 %カード名%(을)를 발동……으랏차」
			ENDIF
		CASE 2
			;필드발동
			IF GROUPMATCH(カードID,2270,2271,2272,2273)	
				PRINTFORMW 「%カード名%의 효과……, 좀 어지럽게 움직여 볼게」
			ELSE
				PRINTFORMW 「%カード名%, 써볼까……!」
			ENDIF
		CASE 3
			;마함발동
			IF GROUPMATCH(カードID,62270,62271,82270)
				PRINTFORMW 「자, 킬러 튠의 개점이라고 해볼까……!」
			ELSE
				PRINTFORMW 「여길까……? %カード名%의 효과 발동」
			ENDIF
		CASE 4
			;묘지발동
			PRINTFORMW 「…그럼, 묘지에서 %カード名%…… 쓰겠어」
	ENDSELECT
ENDIF



;==================================================
;5,효과발동
;==================================================
@M_KOJO_DUEL_K2270_5(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	;無効にされた場合
	IF ARG:1 == 1
		PRINTFORMW 「뭐…… 그야 막겠지……!」
	;それ以外
	ELSE
		IF カードID == 2270
			PRINTFORMW 「%カード名%, 아니 나의 효과…… 발동!」
		ELSEIF カードID == 2271
			PRINTFORMW 「%カード名%, 지명이야, 나의 말이지」
		ELSEIF カードID == 2272
			PRINTFORMW 「%カード名%, 물어부술 준비는 됐어…?」
		ELSEIF カードID == 2273
			PRINTFORMW 「%カード名%, 오늘의 서프라이즈 게스트는 누구?」
		ELSEIF GROUPMATCH(カードID,79840,79841,79842,79843,79844,79845,79846,79847,79848,79853,79854,79855,79857)
			SETCOLOR C_PINK
			PRINTFORM 「……아하……❤, ……이…… 이제부터…… %CALLNAME:TARGET%(은)는……,
			CALL XON_FONT("마인드 컨트롤 당하겠네요……,壊❤,溶❤1,溶❤2,溶❤3,溶❤4,」",C_PINK)
			PRINTFORMW 
			RESETCOLOR
		ELSE
			SELECTCASE RAND:3 + 1
				CASE 1
					PRINTFORMW 「여기서 써볼까……!」
				CASE 2			
					PRINTFORMW 「%カード名%의 효과, 여기서 발동!」
				CASE 3
					PRINTFORMW 「자, 한 번 가볼까……!」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF

