;==================================================
;1,モンスター소환
;例：%カード名%を소환！
;==================================================
@M_KOJO_DUEL_K2270_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	IF カードID == 2270
		PRINTFORMW 「%カード名%、もとい、アタシを소환」
	ELSEIF カードID == 2271
		PRINTFORMW 「%カード名%、ちょっと色々弄りに出てきてちょーだい」
	ELSEIF カードID == 2272
		PRINTFORMW 「%カード名%、飛び出しといで」
	ELSEIF カードID == 2273
		PRINTFORMW 「%カード名%、今日のゲスト……呼べる？」			
	ELSE
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「%カード名%、今日はアンタをご指名させてもらうよ」
		CASE 2
			PRINTFORMW 「%カード名%を소환するよ」
		CASE 3
			PRINTFORMW 「%カード名%소환、……んで、つぎはっと……」
	ENDSELECT
	ENDIF
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_KOJO_DUEL_K2270_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 소환出処
		;패에서 
		CASE 召種손패
			IF GROUPMATCH(カードID,2270,2271,2272,2273)		
				IF カードID == 2270
					PRINTFORMW 「%カード名%、もといアタシ、ここで특수소환」
				ELSEIF カードID == 2271
					PRINTFORMW 「%カード名%、出番だよ」
				ELSEIF カードID == 2272
					PRINTFORMW 「%カード名%、ちょっと飛び出しといで」
				ELSEIF カードID == 2273
					PRINTFORMW 「%カード名%、今でてちょーだい」	
				ELSE
					PRINTFORMW 「%カード名%を특수소환っと」
				ENDIF
			ENDIF
		;마법함정ゾーンから。　キリ番・シェイプシスターなどを出す場合
		CASE 召種마함
				PRINTFORMW 「마법함정ゾーンから%カード名%を呼び出すよ」
		;덱에서 
		CASE 召種덱
			IF GROUPMATCH(カードID,2270,2271,2272,2273)		
				PRINTFORMW 「さあ、キラーチューンのメンバーをおよびさせてもらおうかな…！」
			ELSE
				PRINTFORMW 「山札から%カード名%を특수소환……！」
			ENDIF
		;EX덱에서 
		CASE 召種EX덱
			PRINTFORMW 「裏技見せたげる……、ＥＸ덱에서 直接コイツを소환……、%カード名%！」
		;묘지에서 
		CASE 召種묘지
			PRINTFORMW 「묘지에서 戻っておいで……%カード名%！」
		;제외状態から
		CASE 召種제외
			PRINTFORMW 「次元の狭間をぶち破り……戻ってこい、%カード名%」
		;主にトークン生成
		CASE 10
			PRINTFORMW 「トークン生成……！……さーてこいつを……どうしよっか」
	ENDSELECT
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_KOJO_DUEL_K2270_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORMW 「正当なる의식の下に、今ここに降り立て……%カード名%！」
		CASE 융합
			PRINTFORMW 「융합（リミックス）と言ってみようか……%カード名%！」
		CASE 싱크로
			IF カードID == 42270
				PRINTFORML 「さあし、主役のご登場といこうじゃないか……！」
				PRINTFORMW 「%カード名%……、アタシのお出ましだよ……！」
			ELSEIF カードID == 42271
				PRINTFORML 「集いし曲を調律し、新たな旋律を紡ぎ出す……！」
				PRINTFORMW 「チューン싱크로……%カード名%……！」
			ELSEIF カードID == 52180
				PRINTFORML 「積み上げた音を嵌め合わせ、真なる調律を導きだす……！」
				PRINTFORMW 「チューン싱크로……%カード名%……！」
			ELSEIF カードID == 52181
				PRINTFORML 「アタシらの曲の奏で場よ……今こそ起動し、ブチ上げろ！」
				PRINTFORMW 「チューン싱크로……%カード名%……！」	
			ELSE
			PRINTFORMW 「キラーチューンも時にはこういう同調（싱크로）するとこ見せたげる……%カード名%！」
			ENDIF
		CASE 엑시즈
			PRINTFORMW 「オーバーレイネットワーク構築……、さあ、二重奏といこうじゃん……%カード名%！」
		CASE 링크
			PRINTFORMW 「몬스터를 링크マーカーに……、で、アローヘッド確認……링크소환……%カード名%！」
		;초차원モンスター（デュエマ）
		CASE 초차원
			PRINTFORMW 「초차원ゾーンから呼ばせてもらうよ……異郷の存在……%カード名%！」
	ENDSELECT
ENDIF

