;==================================================
;10,ダメージ反応！（ダメージ）
;==================================================
@M_KOJO_DUEL_K2270_10(ダメージ量,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC ダメージ量
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE ダメージ量
		;ダメージなし
		CASE 0
			IF ライフ_상대 < 2000
				PRINTFORMW 「（ん～……ダメージ無しか……、……これはこれで怖っ）」
			ELSEIF ライフ_상대 < 4000
				PRINTFORMW 「（ダメージ無し、……いいんだかわるいんだか……）」
			ELSE
				PRINTFORMW 「被害なし、セーフかな……」
			ENDIF
		;１～１９９９の時、小ダメージ
		CASE 1 TO 1999
			IF ライフ_상대 < 0
				PRINTFORMW 「さすが%CALLNAME:MASTER%……きっちりトドメ刺してくるね……」
			ELSEIF ライフ_상대 < 2000
				PRINTFORMW 「……やっばい……やっばいなあこれ」
			ELSEIF ライフ_상대 < 4000
				PRINTFORMW 「（ＬＰ半分切っちゃったか……コレまずいなあ）」
			ELSE
				PRINTFORMW 「あだっ」
			ENDIF
		;２０００～３９９９の時、結構なダメージ
		CASE 2000 TO 3999
			IF ライフ_상대 < 2000
				PRINTFORMW 「豪快にトドメ刺したね～、派手なのは好きだよ、%CALLNAME:MASTER%」
			ELSEIF ライフ_상대 < 2000
				PRINTFORMW 「っぁ”～～っぶな……！」
			ELSEIF ライフ_상대 < 4000
				PRINTFORMW 「あははっ、もう半分かあ、厳しっ」
			ELSE
				PRINTFORMW 「……けっこー重い１撃してくれるね……%CALLNAME:MASTER%」
			ENDIF
		;４０００～７９９９の時、超大ダメージ
		CASE 4000 TO 7999
			IF ライフ_상대 < 0
				PRINTFORMW 「おぉ～～……ごっそりいったね……！……負けちゃった。さすが%CALLNAME:MASTER%」
			ELSEIF ライフ_상대 < 1000
				PRINTFORMW 「クッソ……！」
			ELSEIF ライフ_상대 < 4000
				PRINTFORMW 「マジか……！あっというまに半分か～……！」
			ELSE
				PRINTFORMW 「……案外회복も悪くないもんだね……」
			ENDIF
		;８０００以上、基本即死
		CASEELSE
				PRINTFORMW 「いいね～、一撃必殺級。ロマンなとこはアタシも気に入ってるよ%CALLNAME:MASTER%」
	ENDSELECT
ENDIF


