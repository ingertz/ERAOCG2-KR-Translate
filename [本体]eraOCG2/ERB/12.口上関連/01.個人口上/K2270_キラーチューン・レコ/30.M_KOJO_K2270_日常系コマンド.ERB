;==================================================
;480,デュエル
;勝敗はプレイヤーから見てのもの
;TFLAG:SELECTCOM분기(1=通常승리 -1=通常패배 -2=引き分け
;10=通常듀얼前 11=パック賭け듀얼前 12=デート賭け듀얼前 13=パンツ賭け듀얼前 14=お持ち帰り듀얼前 15=お前モンスターじゃないか？ 16=スケベ要求듀얼前 20=闇のゲーム
;31=パック賭け승리 32=デート賭け승리 33=パンツ賭け승리 34=お持ち帰り成功 35=カード化승리（牝以外） 36=スケベ要求事後 40=罰ゲーム！
;135=カード化見逃す 235=穏便カード化 335=凌辱後カード化 435=凌辱後見逃す
;50=賭け듀얼패배怒られた 51=パック賭け패배 52=デート패배デート 55=カード化패배 56=スケベ要求패배 156=スケベ要求弱味削除 256=スケベ要求패배패배버릇付きおねだり)
;==================================================
@M_KOJO_MESSAGE_COM_K2270_480
;デュエルにTRAIN_MESSAGEはない
CALL M_KOJO_MESSAGE_COM_K2270_480_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2270_480_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;これが０の時はデュエルしない時なのでおわり
	SIF TFLAG:SELECTCOM분기 == 0
		RETURN 1

	;デュエル前
	IF INRANGE(TFLAG:SELECTCOM분기,10,21)
		SELECTCASE TFLAG:SELECTCOM분기
			;通常듀얼
			CASE 10
				PRINTFORMW 「……おっし、やったろうじゃん、듀얼（デュエル）」
			
			;ここから賭け듀얼
			;パック賭け
			CASE 11
				PRINTFORMW 「賭け事……いいね、上等じゃん。いただくよ」
			;デート賭け
			CASE 12
				PRINTFORML 「……ええと……デートを賭けて？」
				PRINTFORMW 「……（こっちの世界だとこういうデートの誘い方が普通なのかな……？）」
			;パンツ賭け
			CASE 13
				PRINTFORMW 「……속옷……속옷ぃ……？」
			;お持ち帰り
			CASE 14
				IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨 || TALENT:TARGET:음란
					PRINTFORMW 「（……これ……まけちゃったら……アタシ……、…アタシ……%CALLNAME:MASTER%に……）」
					PRINTFORML レコは無言になるが、静かに『こくり』と頷き同意した
					PRINTFORMW 「………❤」
				ELSE
					PRINTFORMW 「……まぁ……勝てば、いっか……」
				ENDIF
			;モンスターか問い詰める（人間は불가）
			CASE 15
				PRINTFORML 「………やっば、よくわかったね……」
				PRINTFORMW そう語りながら%CALLNAME:TARGET%は듀얼板を構える……！
			;スケベ強要
			CASE 16
				PRINTFORMW 「……ぁ……あんたねえ……、……もう」
			;闇のゲーム
			CASE 20
				PRINTFORMW 「……っ”…！……アンタ、ヤばいやつでしょ……」
		ENDSELECT

	;デュエル後
	ELSE
		SELECTCASE TFLAG:SELECTCOM분기
			;通常승리
			CASE 1
				PRINTFORMW 「流石だね%CALLNAME:MASTER%、アタシの負けだよ」
			;通常패배
			CASE 2
				PRINTFORMW 「っしゃ！……ふふん、アタシもヤるもんでしょ？%CALLNAME:MASTER%」
			;通常引き分け
			CASE 3
				PRINTFORMW 「…ねえ、もう１戦、もう１戦しよ」

			;ここから賭け승리
			;パック賭け
			CASE 31
				PRINTFORMW 「負けたか―、……あい、約束のパック。いいの出るといいね」
			;デート賭け
			CASE 32
				PRINTFORMW 「まけちゃったかあ……、……ＯＫ，じゃ、デートいこっか」
			;パンツ賭け
			CASE 33
				IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨 || TALENT:TARGET:음란
					PRINTFORMW レコは%CALLNAME:MASTER%の目の前でホットパンツを脱ぎ、하반신だけ속옷姿となる
					PRINTFORMW 듀얼中に食い込んでしまったのか、割れ目が浮かんでいる속옷をレコは両手で脱いで%CALLNAME:MASTER%に渡した
					PRINTFORMW ……ホットパンツを履きなおさないまま、もじもじとしながらレコは真っ赤な顔で口を開く
					PRINTFORMW 「……っ……ヘンタイ……❤」
				ELSE
					PRINTFORMW レコは%CALLNAME:MASTER%の目の前でホットパンツを脱ぎ、속옷を雑に片手で脱ぐ
					PRINTFORMW 脱いだばかりのパンツを%CALLNAME:MASTER%に投げ渡した
					PRINTFORMW 「……このヘンタイ……」
				ENDIF
			;お持ち帰り
			CASE 34
				IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨 || TALENT:TARGET:음란
					PRINTFORMW 「……まけちゃった……か……」
					PRINTFORMW 「（……、……どうしよ……もう期待しちゃって……濡れて……からだあつくなってる……アタシ……❤）」
				ELSE
					PRINTFORMW 「……わかってるわかってる、約束は約束……だよね」
				ENDIF
			;下二桁３５は"モンスターか問い詰める"の분기
			;カード化（牝以外、選択肢無し）
			CASE 35
				PRINTFORMW 
			;カード化を見逃す（元気でな！）
			CASE 135
				PRINTFORMW 「え？見逃してくれんの？……単に듀얼（デュエル）したかっただけ…？」
			;穏便に話してカード化（怖くないよ～痛くないよ～）
			CASE 235
				PRINTFORMW 「…下手に精霊だってバレたらまずいのかあ……仕方ない……」
			;身体を対価に見逃す（見逃すとは言ってない）
			CASE 335
				PRINTFORMW 「……わかった……、……アンタにささげたげる……」
			;身体を対価に見逃す（見逃す）（패배버릇付いたり弱み握られたりする）
			CASE 435
				PRINTFORMW 「っ”……、……仕方ないか……、わかった。……アンタにアタシを抱かせたげる…」
			;身体要求事後
			CASE 36
				PRINTFORMW 「はーーっ”……❤はっ……❤あらひ……負けて……犯されて……っ”ぅぅ”…❤」
			;闇のゲーム
			CASE 40
				PRINTFORMW 

			;ここから賭け패배
			;怒られた
			CASE 50
				PRINTFORMW 
			;パック賭け（パックを手渡す）
			CASE 51
				PRINTFORMW 「んふふ……新しいカード……、何が来るかな～……」
			;デート賭け（デートはしてくれる）
			CASE 52
				PRINTFORMW 「……じゃ、アタシが勝ったから……、アタシに付き合ってね、いいでしょ？」
			;カード化패배（逃げられた）
			CASE 55
				PRINTFORMW 
			;身体要求패배（金払う）
			CASE 56
				PRINTFORMW 
			;身体要求패배（弱味削除）
			CASE 156
				PRINTFORMW 
			;身体要求패배（패배버릇付いてる時限定凌辱おねだり）（ラブホ直行）
			CASE 256
				PRINTFORML 듀얼（デュエル）に승리した%CALLNAME:TARGET%は、頬を紅潮させ、無意識におまんこを自ら弄りながら近づいてくる……
				PRINTFORMW 「……つぎ……、っせ……섹스……で……섹스で勝負して……」
				PRINTFORMW 「……アンタの……ぉ……おちんぽ……に……勝ててないから………❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1


