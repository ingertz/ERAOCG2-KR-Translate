@M_KOJO_SUCCESS_COM_K2270_301
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K2270_301
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2270_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2270_301_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
IF FIRSTTIME(SELECTCOM)
	PRINTFORML レコは差し出されたお茶をぐいっっと一気に飲み干す
	PRINTFORMW 「……んっ、おいしいねこれ。……出してくれてありがと」
	PRINTFORMW 「……こういう苦いのもアリかなあ」
	RETURN 1
	ENDIF

	SELECTCASE TFLAG:SELECTCOM분기
		CASE 1
			PRINTFORMW 「ふ～……染みるぅ……演奏でバテたからだのすみずみに……」
		CASE 0
			PRINTFORMW レコは差し出された茶をちびちびと飲みながら楽譜に筆を走らせてる
		CASE -1
			PRINTFORMW 「出してくれてあんがとね、ちょうどほしかったんだ」
	ENDSELECT
ENDIF
RETURN 1
