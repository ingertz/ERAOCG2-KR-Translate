;480,デュエル
;勝敗はプレイヤーから見てのもの
;TFLAG:SELECTCOM분기(1=通常승리 -1=通常패배 -2=引き分け
;10=通常듀얼前 11=パック賭け듀얼前 12=デート賭け듀얼前 13=パンツ賭け듀얼前 14=お持ち帰り듀얼前 15=お前モンスターじゃないか？ 16=スケベ要求듀얼前 20=闇のゲーム
;31=パック賭け승리 32=デート賭け승리 33=パンツ賭け승리 34=お持ち帰り成功 35=カード化승리（牝以外） 36=スケベ要求事後 40=罰ゲーム！
;135=カード化見逃す 235=穏便カード化 335=凌辱後カード化 435=凌辱後見逃す
;50=賭け듀얼패배怒られた 51=パック賭け패배 52=デート패배デート 55=カード化패배 56=スケベ要求패배 156=スケベ要求弱味削除 256=スケベ要求패배패배버릇付きおねだり)
;==================================================
@M_KOJO_MESSAGE_COM_K2270_480
;デュエルにTRAIN_MESSAGEはない
CALL M_KOJO_MESSAGE_COM_K2270_480_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2270_480_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;これが０の時はデュエルしない時なのでおわり
	SIF TFLAG:SELECTCOM분기 == 0
		RETURN 1

	;デュエル前
	IF INRANGE(TFLAG:SELECTCOM분기,10,21)
		SELECTCASE TFLAG:SELECTCOM분기
			;通常듀얼
			CASE 10
				PRINTFORMW 「……좋아, 해보자고, 듀얼」
			
			;ここから賭け듀얼
			;パック賭け
			CASE 11
				PRINTFORMW 「내기…… 좋네, 훌륭하잖아. 받아 갈게」
			;デート賭け
			CASE 12
				PRINTFORML 「……그게…… 데이트를 걸고?」
				PRINTFORMW 「……(이쪽 세계에선 이런 데이트 신청 방식이 평범한 건가……?)」
			;パンツ賭け
			CASE 13
				PRINTFORMW 「……속옷…… 속옷이……?」
			;お持ち帰り
			CASE 14
				IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨 || TALENT:TARGET:음란
					PRINTFORMW 「(……이거…… 져버리면…… 나……, …나…… %CALLNAME:MASTER%에게……)」
					PRINTFORML 레코는 말이 없어지지만, 조용히 『끄덕』하고 고개를 끄덕여 동의했다
					PRINTFORMW 「………❤」
				ELSE
					PRINTFORMW 「……뭐…… 이기면, 되나……」
				ENDIF
			;モンスターか問い詰める（人間は불가）
			CASE 15
				PRINTFORML 「………위험해, 잘도 알았네……」
				PRINTFORMW 그렇게 말하며 %CALLNAME:TARGET%는 듀얼 디스크를 겨눈다……!
			;スケベ強要
			CASE 16
				PRINTFORMW 「……아…… 너 말야……, ……정말」
			;闇のゲーム
			CASE 20
				PRINTFORMW 「……읏…! ……너, 위험한 녀석이지……」
		ENDSELECT

	;デュエル後
	ELSE
		SELECTCASE TFLAG:SELECTCOM분기
			;通常승리
			CASE 1
				PRINTFORMW 「역시 대단하네 %CALLNAME:MASTER%, 나의 패배야」
			;通常패배
			CASE 2
				PRINTFORMW 「아싸! ……후흥, 나도 꽤 하지? %CALLNAME:MASTER%」
			;通常引き分け
			CASE 3
				PRINTFORMW 「…저기, 한 판 더, 한 판 더 하자」

			;ここから賭け승리
			;パック賭け
			CASE 31
				PRINTFORMW 「졌나-, ……자, 약속한 팩. 좋은 거 나오면 좋겠네」
			;デート賭け
			CASE 32
				PRINTFORMW 「져버렸나아……, ……OK, 그럼, 데이트 갈까」
			;パンツ賭け
			CASE 33
				IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨 || TALENT:TARGET:음란
					PRINTFORMW 레코는 %CALLNAME:MASTER%의 눈앞에서 핫팬츠를 벗고, 하반신만 속옷 차림이 된다
					PRINTFORMW 듀얼 중에 파고들어 버린 건지, 틈새가 떠오른 속옷을 레코는 양손으로 벗어 %CALLNAME:MASTER%에게 건넸다
					PRINTFORMW ……핫팬츠를 다시 입지 않은 채, 머뭇머뭇거리며 레코는 새빨간 얼굴로 입을 연다
					PRINTFORMW 「……읏…… 변태……❤」
				ELSE
					PRINTFORMW 레코는 %CALLNAME:MASTER%의 눈앞에서 핫팬츠를 벗고, 속옷을 거칠게 한 손으로 벗는다
					PRINTFORMW 방금 벗은 팬티를 %CALLNAME:MASTER%에게 던져 건넸다
					PRINTFORMW 「……이 변태……」
				ENDIF
			;お持ち帰り
			CASE 34
				IF TALENT:TARGET:연모 || TALENT:TARGET:굴복됨 || TALENT:TARGET:음란
					PRINTFORMW 「……져버렸……나……」
					PRINTFORMW 「(……, ……어쩌지…… 벌써 기대해버려서…… 젖어서…… 몸 뜨거워지고 있어…… 나……❤)」
				ELSE
					PRINTFORMW 「……알고 있어 알고 있어, 약속은 약속……이지」
				ENDIF
			;下二桁３５は"モンスターか問い詰める"の분기
			;カード化（牝以外、選択肢無し）
			CASE 35
				PRINTFORMW 
			;カード化を見逃す（元気でな！）
			CASE 135
				PRINTFORMW 「에? 봐주는 거야? ……단순히 듀얼하고 싶었을 뿐…?」
			;穏便に話してカード化（怖くないよ～痛くないよ～）
			CASE 235
				PRINTFORMW 「…섣불리 정령이라는 거 들키면 곤란한 건가아…… 어쩔 수 없네……」
			;身体を対価に見逃す（見逃すとは言ってない）
			CASE 335
				PRINTFORMW 「……알았어……, ……너한테 바쳐줄게……」
			;身体を対価に見逃す（見逃す）（패배버릇付いたり弱み握られたりする）
			CASE 435
				PRINTFORMW 「읏……, ……어쩔 수 없나……, 알았어. ……너한테 나를 안게 해줄게…」
			;身体要求事後
			CASE 36
				PRINTFORMW 「하아아읏……❤ 핫……❤ 나…… 져서…… 범해져서……읏 으으…❤」
			;闇のゲーム
			CASE 40
				PRINTFORMW 

			;ここから賭け패배
			;怒られた
			CASE 50
				PRINTFORMW 
			;パック賭け（パックを手渡す）
			CASE 51
				PRINTFORMW 「음후후…… 새로운 카드……, 뭐가 나올까나～……」
			;デート賭け（デートはしてくれる）
			CASE 52
				PRINTFORMW 「……그럼, 내가 이겼으니까……, 나랑 어울려줘, 괜찮지?」
			;カード化패배（逃げられた）
			CASE 55
				PRINTFORMW 
			;身体要求패배（金払う）
			CASE 56
				PRINTFORMW 
			;身体要求패배（弱味削除）
			CASE 156
				PRINTFORMW 
			;身体要求패배（패배버릇付いてる時限定凌辱おねだり）（ラブホ直行）
			CASE 256
				PRINTFORML 듀얼에 승리한 %CALLNAME:TARGET%는, 뺨을 붉히며, 무의식중에 보지를 스스로 만지작거리며 다가온다……
				PRINTFORMW 「……다음……, 쎄…… 섹스……로…… 섹스로 승부해줘……」
				PRINTFORMW 「……너의…… 자…… 자지……에게는…… 이기지 못했으니까………❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1


