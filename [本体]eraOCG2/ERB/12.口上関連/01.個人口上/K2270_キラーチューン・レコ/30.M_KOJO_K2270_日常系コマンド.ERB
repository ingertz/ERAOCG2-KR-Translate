;==================================================
;300,会話
;TFLAG:SELECTCOM분기(1=大成功 0=成功 -1=失敗 -2=大失敗（TARGETがMASTERより교양が4以上高い)
;TCVAR:302(0=会話可能 1=非연모時会話不能)
;MARK:반발각인(3以上=会話不能)(4以上はバグ
;TCVAR:泥酔(1=通常成功or大失敗)
;CFLAG:우후후(조교中の会話)
;CFLAG:변기화(肉便器の時の会話)
;==================================================
@M_KOJO_SUCCESS_COM_K2270_300
;成否판정
;TFLAG:192(-2=コマンド終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K2270_300
;コマンド共通メッセージ(TRAIN_MESSAGE) 
;削除すると「～話をした。」とかが消えます。また、削除した場合は自動で구상色が付きません。
CALL TRAIN_MESSAGE
;구상メイン呼出
CALL M_KOJO_MESSAGE_COM_K2270_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2270_300_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL

;はじめて会話
	IF FIRSTTIME(SELECTCOM)
		PRINTFORML レコは%CALLNAME:MASTER%をじっと見ながら口を開く
		PRINTFORMW 「ふーん……本当に全然違う世界の住人なんだね、纏ってる雰囲気が違うっていうか……」
		PRINTFORML 「……まっ、これからよろしく。こういうのもまあ……、……うん、いい刺激になる경험になりそうだし……」
		PRINTFORMW 「面白いことにどんどん首を突っ込んでね、ついてくから」
		RETURN 1
	ENDIF

	;호감도修正、通常（연모系陥落なし）で１１
	호감도修正 = 11
	;TARGETが【애처】だったら호감도修正に＋２
	SIF TALENT:TARGET:애처
		호감도修正 += 5
	;TARGETが【親愛】だったら호감도修正に＋２
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 5
	;TARGETが【연모】を得ていたら호감도修正に＋１
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 6
	;「RAND:n」n面ダイスを振る
	;우후후中の会話
	IF CFLAG:TARGET:우후후
		SELECTCASE RAND:3 + 1
			CASE 1
				PRINTFORMW 「……なーに？……続きはどしたの？」
			CASE 2
				PRINTFORML 「……こういう意味での裸の付き合いは……全く考えてもなかったかなあ……」
				PRINTFORMW 「……ぁ、別に嫌とかじゃないよ、むしろ好き」
			CASE 3
				PRINTFORMW 「……ぁ～……あんまり目線向けないで……、……、…………」
				PRINTFORMW 「……………………、……恥ずかしいから」
		ENDSELECT
	ELSEIF CFLAG:TARGET:데이트중
		호감도修正 = 1
		SIF TALENT:TARGET:연모 >= 1
			호감도修正 += 1
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				IF CFLAG:TARGET:현재위치 == 場所_繁華街
					PRINTFORML 「へぇ～……全然建物が荒れてないし明るいね……」
					PRINTFORMW 「こうしてのんびり歩き回れるっていいね、気に入った」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_식사通り
					PRINTFORML 「いい香りがしてくるね……、……ねえ%CALLNAME:MASTER%、アンタって辛いのイける口？」
					PRINTFORMW 「あぁ、無理しなくていいよ。後で자신で行ってもみるから」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_カドショ
					PRINTFORMW 「……ふーん、ここがある意味この世界の中心の場所ってわけか」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_カフェ
					PRINTFORML 「カフェかあ……、……レコード置いてたりする？」
					PRINTFORMW 「あのノイズ……、…ぁー……あのぷちぷち音がいいんだよね、味があって」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_病院
					PRINTFORML 「どんな世界でも病院はずっと忙しそうだね……」
					PRINTFORMW 「……アタシのジュークジョイントでも酔った勢いとその場のノリでの喧嘩がちょっとね……」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_公園
					PRINTFORML 「公園かぁ～、……ん～……程よい静けさ」
					PRINTFORMW %CALLNAME:TARGET%は手に持ったメモ帳に楽譜や歌詞を書き始めてる……
				ELSEIF CFLAG:TARGET:현재위치 == 場所_神社
					PRINTFORML 「まつりごとってやってたりする？ここで」
					PRINTFORMW 「そういう時と場でしか聞けないものもあるし、……そういう時にも一緒に来いって誘ってよね」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_教会
					PRINTFORML 「教会かあ……、……あ、クラブの歌手が匿われたりしてるとか……ないかあ」
					PRINTFORMW 「……冗談冗談、厳格で真っ当な聖歌のパフォーマンスだけの場っていうのも一興だよ」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_森
					PRINTFORML 「森かぁ……、……ごめん、……なんていうか、落ち着かないんだよね……」
					PRINTFORMW 「静かすぎるっていうか……平和すぎるっていうか……、……喧噪に慣れすぎちゃってるからかなあ、コレ」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_裏通り
					PRINTFORMW 「……ふふっ、悪い感じの匂いがしてくる場所じゃん」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_学校内
					PRINTFORML 「……待った、デュエルの専門学校？」
					PRINTFORMW 「……なるほどね……、アンタに限らず腕に듀얼板っていうの付けてる人がいっぱい見かけるのはそういう世界だからってことか……」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_観客席
					PRINTFORML 「へ～、伊達に듀얼（デュエル）が商業にもなってる世界なだけあってこんな場もあるんだね」
					PRINTFORMW 「……アタシも機会があれば出してよね、派手に盛り上げたげる」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_バー
					PRINTFORMW 「……こういう静かな場もいいもんだね、……一杯飲ませてよ、もちろんおごりね」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_鉱山
					PRINTFORMW 「……へえ、随分と厄いもんがこべりついてる場所だね……」
				ELSE
					PRINTFORML 「こうじっくり並べられてるもんみてると……全然違うね、アタシのいる世界と」
					PRINTFORMW 「……%CALLNAME:MASTER%、アレなに？」
				ENDIF
			CASE 2
				IF CFLAG:TARGET:현재위치 == 場所_繁華街
					PRINTFORML 「へ～、いい音なりそうなモノいっぱいじゃん」
					PRINTFORMW そう語りながらレコは音楽関係の店舗にばかり目を向けている					
				ELSEIF CFLAG:TARGET:현재위치 == 場所_スーパー
					PRINTFORML 「買い物？……色々取り扱ってる場所なんだ……」
					PRINTFORMW 「……辛めのレトルト食品とかって……ある？」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_カフェ
					PRINTFORML 「ふぅ……、……一息つける場所あってありがたい……」
					PRINTFORMW 「……このチリソース使ってる料理おいしそ、頼ませてもらうね」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_病院
					PRINTFORML 「……な～んかよく見るとモンスターっぽいのもいるなあ……」
					PRINTFORMW 「アレ墓守？……それに魔術師に……、……あ、暗殺者っぽいのもいる」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_カドショ
					PRINTFORML 「……あ、이 카드의 モンスター、ウチの店に来たことある」
					PRINTFORMW レコは%CALLNAME:MASTER%にジョークジョイント【キラーチューン】に来るお客さんの話をしている
				ELSEIF CFLAG:TARGET:현재위치 == 場所_ラブホ
					PRINTFORML 「……へ～、ヤりたいの？」
					PRINTFORMW そういいながらレコは衣服の胸元をずらして%CALLNAME:MASTER%にだけ見えるよう胸の突起をちらりと見せつける
				ELSEIF CFLAG:TARGET:현재위치 == 場所_夜のお店
					PRINTFORML 「……%CALLNAME:MASTER%、アンタの好みってどんな子？」
					PRINTFORMW レコは夜のお店の前で客を待つ人々を指さしながら聞いてくる……
				ELSEIF CFLAG:TARGET:현재위치 == 場所_森
					PRINTFORML 「こういう深い森、あんまり深くまで行きたくはないかなあ」
					PRINTFORMW 「……なんか出てきそうじゃない？야수족のヤツとかさ」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_裏通り
					PRINTFORMW 「……随分と落ち着いていられるよね、……やっぱりこういう場所にも……慣れてる？」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_学校内
					PRINTFORML 「……もしかして、もしかしてだけど……音楽の授業も듀얼（デュエル）関係とかは……無いよね？」
					PRINTFORMW 「…………いや、アタシらみたいに音楽に関わるヤツってのはいるしさ」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_スタジアム
					PRINTFORML 「%CALLNAME:MASTER%が大会に出るならまあ……応援くらいはしたげる」
					PRINTFORMW 「ただし、特等席で応援させなよ。アンタが創り上げる盤面の上でね」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_バー
					PRINTFORML 「……飲みすぎはだめだかんね、こういう場所は嗜むのが丁度いい」
					PRINTFORMW 「バカ騒ぎしたいって言うなら、……まあ、ウチの店に呼んであげる」
				ELSEIF CFLAG:TARGET:현재위치 == 場所_牧場
					IF TALENT:TARGET:모유체질
						PRINTFORML 「……っ……❤……ね……ねえ…、まさかアタシを牝牛に使うためにこうしたんじゃないよね……？」
						PRINTFORMW 「……ちゃんとアンタがアタシのを絞ってよね……おねがいだからっ”……❤」
					ELSE
						PRINTFORML 「……ん～……ちょっと期待してたんだけどなー…」
						PRINTFORMW 寂れた牧場を前にしたレコの肩は少し落ちてしまっている
					ENDIF
				ELSE
					PRINTFORML 「いーよ、好きな場所に向かってくれて。ちゃんとついていくから」
					PRINTFORMW 「……ま、この世界だとアンタについてけば面白いことに巡り合えるだろうしね」
				ENDIF
		ENDSELECT

	;日常会話
	ELSE
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				PRINTFORML 「……ジョークジョイント【キラーチューン】はいつでも誰でも환영だよ」
				PRINTFORMW 「音楽を聴きたい子、奏でたい子、そんな皆が集まってるんだ」
			CASE 2
				PRINTFORML 「……アンタが店に来てくれたら……、……用心棒……いや듀얼리스트だね」
				PRINTFORMW 「アタシらの音楽をバックに熱が溢れる듀얼をしてくれそうかなーって」
				PRINTFORMW 「……え？魅せる듀얼は普通に듀얼する難しい？……なんとかなんない？」
			CASE 3
				PRINTFORML 「ウチの店にいる子にクリップって子がいるんだ、なにかと噛みつき癖がある子でさ」
				PRINTFORML 「……ん～……、なんていうか意地っ張りっていうか、……特に競い合ってくるっていうか……、”クリップもヤル！クリップもスル！”って感じ」
				PRINTFORMW 「あの子のハードコアテクノはイイよ、狂音同士の調律が重なり合って文字通り脳がぶっ飛ぶ감각がするからね」
			CASE 4
				PRINTFORMW 「ウチのジュークジョイントにミクスって子がいてさ。店のでっかい機械の관리担当」
				PRINTFORML 「店内の音響設備担当もヤっててさ、いつ寝てるんだかわかんないくらいてきぱき機械弄りと作曲ばっかりしてる」
				PRINTFORMW 「……かなりぶっちぎって駆け走るよーなドラムンベースをよく創ってるのもそういうノリが合ってるからなのかな……？」
			CASE 5
				PRINTFORMW 「キューの事聞いたことある？……あの子はウチの宣伝担当、最近はＳＮＳのアカウントも作ったんだって」
				PRINTFORMW 「よくお客さんとかと仲良く話してるとこよく見るし、アタシもなんとなく……こう、ほっとけない感じがするんだよね」
				PRINTFORMW 「何かとリクエストがあれば答える子だけど、好きなのはチップチューンなんだって。アンタも聞く機会があればソレをリクエストしてみなよ」
			CASE 6
				PRINTFORMW 「アタシ？……ん～……アタシはまあ……、……秘密といきたいけどバレバレかな」
				PRINTFORML 「キラーチューン・レッドシール。……キューの言葉を借りるならお店の”顔”ってヤツ、……らしい」
				PRINTFORMW 「好みの曲は……とにかく熱が上がっていくような、胸を焦がして焼くような……そういうのかな……」
			CASE 7
				PRINTFORML 「こっちもこっちで荒事が茶飯事なんだね、……ウチも立地が立地だからとやかく言えないけど」
				PRINTFORMW 「ただどんな場所でも……、……皆が一緒に熱く滾りながらハまれるのがあるっていいことじゃない？」
			CASE 8
				PRINTFORMW 「辛くて美味い料理っていうのはただ辛いのとは違うんだよね」
				PRINTFORML 「辛さが交わってこそ感じられる旨味があって、食べてく内に全身が熱くなってね」
				PRINTFORMW 「曲をヤり終えた後の１０辛の一杯を食べ終えた時のやり遂げた感はほんと……イいよ」
			CASE 9
				PRINTFORMW 「……音楽を奏でる者たちっていうのはちゃんと他にもいるものなんだね」
				PRINTFORML 「アタシらとは全然違ってるけど、聞いててああいう奏で方もあるんだってなるよ」
				PRINTFORMW 「……ところで相談なんだけど、そいつらと듀얼出来たりしない？」
			CASE 10
				PRINTFORML レコはペンでメモ帳を『トントン』と叩き、時折思いついたかのように筆を走らせている
				PRINTFORMW 「……ぁ、……ごめん。けどちょっとイイとこなの、ごめん」
			CASE 11
				PRINTFORMW 「듀얼（デュエル）っていうのは難しいね」
				PRINTFORML 「……無駄を削ぐ独奏か、多様に幅を広げての多重奏か……」
				PRINTFORMW ……レコは多様な카드를 並べ、どういった덱にするべきか悩み続けている
			;연모
			CASE 12
				PRINTFORML 「%CALLNAME:MASTER%……アンタがウチの店で働いてくれると……その、……ありがたいんだけどなあ……」
				PRINTFORMW 「……バーテン、兼、듀얼리스트、……どうよ」
			CASE 13
				PRINTFORML 「……ねえ、%CALLNAME:MASTER%が好きな………、……好きな音楽って……どんなの？」
				PRINTFORMW 「ウチでも身内同士で気に入った他所の曲聞かせ合ったりしててさ、……その……アンタはどんなの聞いてるんだろって気になって」
			CASE 14
				PRINTFORML レコは%CALLNAME:MASTER%が덱を整えている姿をじっと見つめている
				PRINTFORMW 「……ん？……ぁぁ、気になる？……もうちょっと見せてよ、見てて飽きないし」
			CASE 15
				PRINTFORMW 「……%CALLNAME:MASTER%って辛いのに興味ない？……いや、アタシと同じくらいじゃなくてもいいから、ほら、ごはんさ、一緒に外で……ほら」
			CASE 16
				PRINTFORML 「%CALLNAME:MASTER%、……今度試しにアタシの曲聞いたりしてみない……？」
				PRINTFORMW 「アタシ好みの選曲にはなるけどね」
			CASE 17
				PRINTFORML 「……こっちでやってる듀얼（デュエル）にも慣れてきたかな……多分」
				PRINTFORMW 「……あとで付き合ってよ、練習」
			;親愛
			CASE 18
				PRINTFORML 「……%CALLNAME:MASTER%とはなんか……長くなってるね、付き合い」
				PRINTFORMW 「……もっと呼んでね、%CALLNAME:MASTER%といると飽きないし」
			CASE 19
				PRINTFORML 「……%CALLNAME:MASTER%って色々な子と縁が繋がってるよね、不思議と」
