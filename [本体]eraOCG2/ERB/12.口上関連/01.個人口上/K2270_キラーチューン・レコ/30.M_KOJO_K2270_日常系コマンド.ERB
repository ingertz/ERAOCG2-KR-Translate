RETURN RESULT

@M_KOJO_MESSAGE_COM_K2270_403_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF CFLAG:MASTER:감기플래그 >= 1
		;MASTERが감기の場合に휴식すると、이벤트の看病구상が流れます
		;文章を繋げられる自信の無い方はここに書かないようにしてください
	ELSE
		;添い寝する時
		IF CFLAG:TARGET:수면 == 1
			PRINTFORMW 「……뭐, 같이 자버리는 것도 괜찮나……」
		;それ以外
		ELSE
			SELECTCASE RAND:3
				CASE 0
					IF TALENT:TARGET:연모 == 1
						PRINTFORMW 「……내키지 않을 때는 빈둥거리는 게 좋아, ……한도는 있지만」
					ELSE
						PRINTFORMW 「……지쳤다는 느낌? ……그렇구나……, ……뭐, 푹 쉬자」
