@M_KOJO_MESSAGE_COM_K2270_189_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「……나, 신부감이라는 성격은 아니라고 생각하는데」
		PRINTFORMW 「……그게……, …서…… 서방……님?」
		RETURN 1
	ENDIF
	;基本セット
	;開始
	IF TEQUIP:새댁플레이
		;연모
		IF TALENT:연모
			PRINTFORMW 「후후……, 나를 신부로 삼아준다면, 언제든지 범하거나 마음대로 할 수 있겠네……❤」
			RETURN 1
		;それ以外
		ELSE
			PRINTFORMW 「……뭐랄까, 조금 이상한 느낌. 신부가 된다는 거 생각해 본 적도 없고」
			RETURN 1
		ENDIF
	;終了
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1
