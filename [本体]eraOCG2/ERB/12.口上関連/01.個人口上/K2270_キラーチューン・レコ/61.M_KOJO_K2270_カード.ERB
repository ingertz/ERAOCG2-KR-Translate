;※※※※※※※※※※※※※※※※※※※※※※※※※
;CARD用구상
;※※※※※※※※※※※※※※※※※※※※※※※※※
;直接カードのIDを使える。
;캐릭터が無くても動く
;存在証明
@M_KOJO_CARD_K2270
RETURN 1
;==================================================
;0,モンスター소환時
;==================================================
@M_KOJO_CARD_K2270_0(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「킬러 튠……『%CALLNAME:TARGET%』의 등장이야~……」
ENDIF

;==================================================
;1,攻撃時
;==================================================
@M_KOJO_CARD_K2270_1(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	PRINTFORMW 「라져, 한 방 먹이고 올게」
ENDIF

;==================================================
;2,효과발동
;==================================================
;효과別で鳴らしたいなら、直接カードのデータを見て、설정する必要がある
;面倒、分からないであれば분기はせず
;失敗판정は、いわゆる효과を無効にされたとかそういうやつ
@M_KOJO_CARD_K2270_2(종류,失敗판정)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 종류
#DIM DYNAMIC 失敗판정
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 失敗판정 == 0
		IF 종류 == S素材時효과
			PRINTFORMW 「……연주 방해…… 때려 부숴줄게……!」
		ELSEIF 종류 == 소환時
			PRINTFORMW 「……자, 차례가 왔어 너희들!」
		ENDIF

	ELSE
		PRINTFORMW 「……읏……, 미안, 실수했어」
	ENDIF
ENDIF

;==================================================
;3,除去時
;==================================================
;いちいちなんでも除去で話すとやかましいため、デフォでは破壊にのみ反応するように설정
@M_KOJO_CARD_K2270_3(除去종류,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 除去종류
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE 除去종류
	CASE 戦闘破壊行き
		PRINTFORMW 「읏…… 그 얼굴, 기억해둘 테니까……!」
	CASE 破壊行き
		PRINTFORMW 「미안, 물러날 테니까…… 뒤는 잘 부탁해……!」
	CASE 제외行き
		PRINTFORMW 「반드시 돌아올 테니까……!」
	ENDSELECT
ENDIF

