	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「아～…… 그 투박한 걸로 가게 할 생각이구나……, …별나네ー」
		RETURN 1
	ENDIF
