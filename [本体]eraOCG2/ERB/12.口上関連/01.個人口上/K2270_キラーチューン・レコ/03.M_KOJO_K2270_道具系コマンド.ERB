;40,로터
;クリトリスに当てる
;==================================================
@M_KOJO_MESSAGE_COM_KX_40
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_KX_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_KX_40_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「로터…かぁ、使ってるとこ見たことあるなぁ」
		PRINTFORMW 「誰って？……えー……秘密」
		RETURN 1
	ENDIF
	;基本セット
	;４以上
	IF ABL:TARGET:Ｃ감각 >= 4
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「クリだめっっ”❤だめっ”❤だめっっ”ぁっ””ぃぐっっ”❤っっ❤だめえ”っっ”❤」
			CASE 1
				PRINTFORMW 「허접클리いじめないで”よぉ”❤おっ”❤ぁ”っっ”❤つぶりぇる”❤クリ、로터でつぶぢゃれるぅ”❤❤❤」
			CASE 2
				PRINTFORMW 「ぁ”っっ”❤あたしのクリっ”❤イっぢゃっ”ぅ”❤ぁ”❤っ”っ”～～～❤」
		ENDSELECT
	;２未満
	ELSEIF ABL:TARGET:Ｃ감각 < 2
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「っ”んっ”……❤……ちょーどいい…かんじ……❤」
			CASE 1
				PRINTFORMW 「ぁ”っ❤……ん”……❤……ぶるぶるくるっぅ……❤」
		ENDSELECT
	;４未満
	ELSEIF ABL:TARGET:Ｃ감각 < 4
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「ぁ”っっ❤クリいってるっ”からぁ”❤まだいぐっ”❤っ”❤」
			CASE 1
				PRINTFORMW 「ぃ”っっ”❤……ん”っ❤……なんか…前よりかんじ”っ”ぁ””❤っっぁ”❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

