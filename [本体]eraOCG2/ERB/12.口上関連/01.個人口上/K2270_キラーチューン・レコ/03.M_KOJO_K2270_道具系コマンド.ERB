;40,로터
;クリトリスに当てる
;==================================================
@M_KOJO_MESSAGE_COM_K2270_40
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2270_40_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2270_40_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 「로터…인가, 쓰는 거 본 적 있네」
		PRINTFORMW 「누구냐고? ……에ー…… 비밀」
		RETURN 1
	ENDIF
	;基本セット
	;４以上
	IF ABL:TARGET:Ｃ감각 >= 4
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「클리 안 돼엣❤ 안 돼엣❤ 안 돼에에 읏, 가아앗❤ 으읏❤ 안 돼에엣❤」
			CASE 1
				PRINTFORMW 「허접 클리 괴롭히지 말아줘어❤ 오읏❤ 아으읏❤ 찌그러져❤ 클리, 로터로 찌그러져버려어❤❤❤」
			CASE 2
				PRINTFORMW 「아으읏❤ 내 클리잇❤ 가버려으읏❤ 아❤ 으읏～～～❤」
		ENDSELECT
	;２未満
	ELSEIF ABL:TARGET:Ｃ감각 < 2
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 「으응읏……❤……딱 좋아… 느낌……❤」
			CASE 1
				PRINTFORMW 「아읏❤……응……❤……부들부들 와아……❤」
		ENDSELECT
	;４未満
	ELSEIF ABL:TARGET:Ｃ감각 < 4
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「아으읏❤ 클리 가고 있으니까아❤ 아직 가앗❤ 읏❤」
			CASE 1
				PRINTFORMW 「이으읏❤……응읏❤……뭔가… 전보다 느껴져섯❤ 으읏아❤」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

