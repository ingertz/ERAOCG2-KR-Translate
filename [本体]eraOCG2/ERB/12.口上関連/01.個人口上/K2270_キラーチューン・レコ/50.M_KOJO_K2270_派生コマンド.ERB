;==================================================
;1,식스나인
;==================================================
@M_KOJO_MESSAGE_SCOM_K2270_1
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2270_1_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2270_1_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「식스나인인가～……, ……엄청나게 시선 느껴지네 이거……」
		PRINTFORMW 「……이…… 이상하게 만지지 말아줘…… 아픈 거라든가……, 그런 거……」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		PRINTFORMW 「읏❤ 으읏으❤……조…… 조금만 더 살살해줘……어❤」
		IF BASE:MASTER:발기 >= 1350
			PRINTFORML 발기한 %CALLNAME:MASTER%의 음경을 레코는 스스로 물고 입안에서 끝부분을 계속 핥고 있다……
			PRINTFORMW 「응으읏❤ 으오곳❤ 으읏, ❤……싸…… 싸……읏 이……오❤」
		ELSEIF BASE:MASTER:발기 >= 600 && BASE:MASTER:발기 < 1350
			PRINTFORML 「……읏❤ 딱…… 딱딱해…지고 있네……❤」
			PRINTFORMW 「좀 더 굵게 세워줄게……으❤ 잠…… 보지 핥는 거 기다려……❤」
		ELSEIF BASE:MASTER:발기 <600
			PRINTFORMW  「음후후…… 서 있지 않으면 뭐…… 못 봐줄 정도는 아닌 느낌이려나……」
		ENDIF 
		RETURN 1

	;それ以外
	ELSE
		PRINTFORML %CALLNAME:MASTER%에게 클리토리스를 달콤하게 깨물리고, 보지의 질육을 손가락으로 만지작거려지며 레코는 갈 것 같아진다
		PRINTFORMW 「읏❤ 아❤ 으읏～～～～으읏❤ 으이꾸……으으…❤」
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K2270_{SELECTCOM}_1
RETURN 1

