	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		;처녀膜ぶち抜き
		IF TCVAR:파과 == 1
			PRINTFORML 何の삽입もされず使われていないレコの처녀を%CALLNAME:MASTER%は指で奪いながら、レコのおまんこの内側の弱い部分を責めたてる……
			PRINTFORMW 「っ”～～～～～～っ”…！……いったぁ……ぁ”…………、……やっぱ指でもいたいのはいりぁ”❤あ”❤」
			PRINTFORMW 「……まっ”……❤なんかそこだめっ”❤きてるからっ”❤なんかきてっ”……っ”❤」
		;それ以外
		ELSE
			PRINTFORMW 「っ”ぃ”❤あ”っっ……❤……そこよわっ”❤よわいから、よわいからだめ、だめ”❤だめ”❤ぇ”❤だめ”」
			PRINTFORM 「だめってイって”❤言ってる”❤いって”❤っ”ぃ”❤いっれぇぇ”ぇ”
			CALL XON_FONT("塵❤1,塵❤2",C_AQUA)
			PRINTFORMW 」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		PRINTFORML %CALLNAME:MASTER%から牝として弱い部位を指で弄ばれ、レコは潮吹きを繰り返しながらイき続ける……
		PRINTFORM 「ぁ”❤あは”❤アタシのよわいとこ”❤ぜ～～んぶしられぢゃってる”❤ぅ”❤あ”❤あ”」
		CALL XON_FONT("！❤",C_AQUA)
		PRINTFORMW 」
		RETURN 1

	;それ以外
	ELSE
		PRINTFORM 「も”❤っっやづませ”❤っぁ”❤っっぃぐ”❤っぐぅぅぅぅ”
		CALL XON_FONT("❤！",C_AQUA)
		PRINTFORMW 」
		RETURN 1
	ENDIF
ENDIF
