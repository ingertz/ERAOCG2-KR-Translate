;==================================================
;1,식스나인
;==================================================
@M_KOJO_MESSAGE_SCOM_K2270_1
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2270_1_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2270_1_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		PRINTFORMW 「식스나인か～……、……めっちゃくちゃ目線感じるねこれ……」
		PRINTFORMW 「……へっ……変な弄り方しないでよね……痛いのとか……、そういうこと……」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		PRINTFORMW 「っ”❤っっ”ぅ”❤……も……もちょっと加減して……ぇ”❤」
		IF BASE:MASTER:발기 >= 1350
			PRINTFORML 발기した%CALLNAME:MASTER%の淫茎をレコは自ら咥え口の中で先端を舐め続けている……
			PRINTFORMW 「ん”っっ”❤っっぉごっ”❤っっ、❤……だ……せ……っ”この……ぉ”❤」
		ELSEIF BASE:MASTER:발기 >= 600 && BASE:MASTER:발기 < 1350
			PRINTFORML 「……っ”❤っかっ”……硬く…なってきてんね……❤」
			PRINTFORMW 「もっとぶっとく勃たせたげる……ぅ”❤まっ……おまんこ舐めるのまった”……❤」
		ELSEIF BASE:MASTER:발기 <600
			PRINTFORMW  「んふふ……勃ってないとまあ……見られなくもない感じかなあ……」
		ENDIF 
		RETURN 1

	;それ以外
	ELSE
		PRINTFORML %CALLNAME:MASTER%からクリトリスを甘く噛まれ、おまんこの膣肉を指で弄られながらレコはイきそうになる
		PRINTFORMW 「っ”❤ぁ”❤っっ”～～～～っっ”❤っぃっぐ……ぅぅ”…❤」
		RETURN 1
	ENDIF
ENDIF
;未記入
;CALLFORM M_KOJO_MESSAGE_COM_K2270_{SELECTCOM}_1
RETURN 1

