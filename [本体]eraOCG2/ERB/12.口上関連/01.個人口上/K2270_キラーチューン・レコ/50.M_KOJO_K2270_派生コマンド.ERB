;==================================================
;3,Gスポット刺激
;==================================================
@M_KOJO_MESSAGE_SCOM_K2270_3
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2270_3_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2270_3_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		;처녀膜ぶち抜き
		IF TCVAR:파과 == 1
			PRINTFORML 아무런 삽입도 되지 않고 쓰이지 않은 레코의 처녀를 %CALLNAME:MASTER%는 손가락으로 빼앗으며, 레코의 보지 안쪽의 약한 부분을 책망한다……
			PRINTFORMW 「읏～～～～～～읏…! ……아파아……아…………, ……역시 손가락이라도 아픈 건 시러어❤ 아❤」
			PRINTFORMW 「……잠……❤ 뭔가 거기 안 돼엣❤ 오고 있으니까앗❤ 뭔가 와앗……읏❤」
		;それ以外
		ELSE
			PRINTFORMW 「읏이❤ 아읏……❤ ……거기 약해엣❤ 약하니까, 약하니까 안 돼, 안 돼❤ 안 돼❤ 에❤ 안 돼」
			PRINTFORM 「안 된다고 가버려❤ 말하고 있어❤ 가버려❤ 읏❤ 가버려어어어
			CALL XON_FONT("塵❤1,塵❤2",C_AQUA)
			PRINTFORMW 」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		PRINTFORML %CALLNAME:MASTER%에게 암컷으로서 약한 부위를 손가락으로 농락당해, 레코는 분수를 반복하며 계속 가버린다……
		PRINTFORM 「아❤ 아하❤ 나의 약한 곳❤ 전～～부 알려져 버렸어❤ 으❤ 아❤ 아」
		CALL XON_FONT("！❤",C_AQUA)
		PRINTFORMW 」
		RETURN 1

	;それ以外
	ELSE
		PRINTFORM 「이제❤ 으읏 쉬게 해줘❤ 으아❤ 으읏 가앗❤ 으구으으으으
		CALL XON_FONT("❤！",C_AQUA)
		PRINTFORMW 」
		RETURN 1
	ENDIF
ENDIF
