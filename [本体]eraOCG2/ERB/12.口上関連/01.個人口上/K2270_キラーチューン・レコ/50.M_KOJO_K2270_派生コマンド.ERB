;4,乱れ牡丹
;背面座位。男が女を持ち上げる、女が男に完全に身体を任せる
;==================================================
@M_KOJO_MESSAGE_SCOM_K2270_4
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2270_4_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2270_4_1
