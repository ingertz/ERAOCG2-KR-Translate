;12,파이즈리펠라
;==================================================
@M_KOJO_MESSAGE_SCOM_K2270_12
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_SCOM_K2270_12_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K2270_12_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「……この胸で파이즈리しながら펠라てっ…物好きだね～……」
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
