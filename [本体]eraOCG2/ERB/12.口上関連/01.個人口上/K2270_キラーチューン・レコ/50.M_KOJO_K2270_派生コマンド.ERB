#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「……이 가슴으로 파이즈리 하면서 펠라라니… 별나네～……」
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「읏❤ 훗……… 츄릅…… 읏 츕❤……어…… 어때…? 이거……❤」
		CASE 2
			PRINTFORMW 「으응읏❤ 훗……❤ 훗…… 읏❤ 츄르르르읏❤」
		CASE 3
			PRINTFORMW 「………읏 츄르르❤ 릅❤……응읏…… 어때애……❤ 가슴판 즈리 펠라❤ 기분 조아……?」
		CASE 4
			PRINTFORMW 「……오❤ 츄르르르읏❤ 츕❤ 츄폿❤……핫……❤ 핫❤……가슴……의, 자지…… 뜨거워어……❤」
		CASE 5
			PRINTFORMW 「싸버려어❤ 자❤ %CALLNAME:MASTER%의 정액……이❤ 읏 츄르르르읏❤ 츄릅❤」
	ENDSELECT
ENDIF
