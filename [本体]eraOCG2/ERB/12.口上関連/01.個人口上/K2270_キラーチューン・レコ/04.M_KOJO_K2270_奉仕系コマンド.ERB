;81,펠라치오
;==================================================
@M_KOJO_MESSAGE_COM_K2270_81
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2270_81_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2270_81_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;ファースト키스
		IF EXP:TARGET:Ｍ경험 == 0 && EXP:TARGET:펠라경험 == 1 && CALLNAME:(CFLAG:TARGET:키스상실상대) == CALLNAME:MASTER
			PRINTFORML 「……자지에 키스? ……음～……, ……처음인데 말야…… 키스는」
			PRINTFORMW 「……알았어 알았어, 해줄게. ………으응읏……❤」
			PRINTFORML 그렇게 말하며, 레코는 자신에게 내밀어진 음경의 끝에 입술을 겹친다……
			PRINTFORMW 「응읏……응……. ……이걸로… 어때?」
			
		;それ以外
		ELSE
			PRINTFORML 「입으로인가……, ……깨물지 않도록 조심하겠지만…… 그……」
			PRINTFORMW 「……해버리면 미안해…?」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
		
	;お掃除펠라
	IF STAIN:MASTER:2 & 4 && ABL:TARGET:기교 >= 3
		PRINTFORMW 

	;通常
	ELSE
		SELECTCASE RAND:호감도修正 + 1
			CASE 1
				IF ABL:TARGET:정액중독 >= 2
					PRINTFORML 「역한 냄새 나고…… 뜨겁고……이❤ 읏하아……❤ 핫……❤ 네 자지……이❤」
					PRINTFORMW 자신에게 향해져 있는 %CALLNAME:MASTER%의 자지를, 레코는 스스로 목구멍 깊숙이 삼키며 계속 봉사하고 있다……
					PRINTFORMW 「응읏읏……츕❤ 읏❤ 츄르르르읏❤ 으읏 츕❤」
				ELSE
					PRINTFORML 「응읏……오읏, 츄릅……츕❤……으응……」
					PRINTFORMW 「……어때? 이런 느낌으로…… 조아…?」
				ENDIF
			CASE 2
				IF ABL:TARGET:정액중독 >= 3
					PRINTFORML 「읏응읏……오……오오…❤ 응으읏❤ 응츄❤ 응읏❤」
					PRINTFORMW 굶주려 있을 때 먹이를 받은 개처럼, %CALLNAME:MASTER%의 자지를 레코는 스스로 목구멍 깊숙이 물고, 봉사하고 있다……
					PRINTFORMW 「응으읏❤ 응읏❤ 으읏 츄읏❤ 응읏❤ 읏❤ 으읏❤」
				ELSE
					PRINTFORMW 「응읏……❤ 으읏아……엣❤ ……기분 좋아……?」
				ENDIF
			CASE 3
				IF ABL:TARGET:정액중독 >= 2
					PRINTFORML 「응읏❤ 음봇❤ 츕 츄르르❤」
					PRINTFORMW 레코는 눈앞에 내밀어진 %CALLNAME:MASTER%의 자지에서 입을 떼지 않고, 입안에서 혀를 자지에 기어가게 하며 앞뒤로 머리를 움직여 봉사하고 있다……
					PRINTFORMW 「응으읏❤ 응으읏❤ 응읏❤ 츕❤ 구츄❤ 읏❤ 으❤ 응읏❤ 읏～～～～읏❤」
				ELSE
					PRINTFORML 「읏……❤ 응읏……아읏, 핫……❤」
					PRINTFORMW 「……어때애? ……기분 조아? 어때읏❤ 으응❤……❤」
				ENDIF
			CASE 4
				IF ABL:TARGET:정액중독 >= 3
					PRINTFORMW 「정액 읏❤ 걸쭈우욱한 저엉액이❤ 읏 츄르르르르으읏❤ 응읏❤ 기풋❤ 응읏으❤ 응읏❤」
					PRINTFORML 레코는 정액을 원해 펠라치오를 할 뿐만 아니라, 젖은 양 구멍을 %CALLNAME:MASTER%에게 과시하듯 가랑이를 벌리고,
					PRINTFORMW 헤콧❤ 헤콧❤……하고 허리를 위아래로 움직여 정을 토해내게 하려고 그 욕망도 부추겨간다……
					PRINTFORMW 「주세여어❤ 자지즙 주세여어❤ 으읏❤」
				ELSE
					PRINTFORML 레코는 거칠게 숨을 몰아쉬며, 눈앞에 내밀어진 %CALLNAME:MASTER%의 발기한 자지를 사랑스럽다는 듯이 봉사하고 있다……
					PRINTFORMW 「음ーーー읏❤ 응읏❤ 츕……❤ 응읏❤」
				ENDIF
			CASE 5
				IF ABL:TARGET:정액중독 >= 3
					PRINTFORML 「읏 하아아아❤ 핫❤ 응읏❤ 응응으읏❤ 츕❤ 츄릅❤ 으❤ 응❤ 으읏 응응응❤❤❤」
					PRINTFORMW %CALLNAME:MASTER%의 "자지님"을 레코는 혀를 달라붙게 하듯 기어가게 하고, 목구멍 깊은 곳에서 끝부분을 조이며, 기둥 전체를 입술로 빨면서 머리를 앞뒤로 움직여 물소리를 내며 봉사하고 있다……
					PRINTFORMW 「응읏❤ 응으읏 붓❤ 으❤ 으오엑❤ 읏 응응응❤❤❤」
					PRINTFORMW 「（정액이❤ %CALLNAME:MASTER%님의 자지님의 정액이, 꿀꺽꿀꺽 마시고 시퍼어❤ 뿌려지고 시퍼어❤）」
				ELSE
					PRINTFORML %CALLNAME:MASTER%의 발기 자지에 대해, 레코는 얼굴을 짓누르고 쿠퍼액도 자신의 얼굴에 문지르며, 체액 투성이인 얼굴을 드러내면서 봉사를 하고 있다…
					PRINTFORMW 「응으읏❤ 으오봇❤ 응읏❤ 읏～～～～으읏❤❤❤」
				ENDIF
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

