@M_KOJO_MESSAGE_COM_2270_0_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「……처음이니까……, …그…… 상냥하게…… 해줘」
		PRINTFORMW 「……이봐, 이런 식으로 섞이는 건……, ……처음이니까……」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;삽입中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V삽입
	IF LOCAL:1 && TEQUIP:50 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			PRINTFORMW 「읏～～～……❤ 읏…아…우와앗…끝내줘……❤」
			RETURN 1
		ELSE
			PRINTFORMW 「아읏❤……읏❤ 읏아❤ 읏핫…❤ 뜨거…… 녹아버릴 것 같…아❤」
			RETURN 1
		ENDIF
	;A삽입
	ELSEIF LOCAL:1 && TEQUIP:51 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			PRINTFORMW 「그쪽에❤ 싸는 거야……아❤……뜨거……으으…❤」
			RETURN 1
		ELSE
			PRINTFORMW 「바보❤ 그런 곳에 싸지 마……아…아～～…❤」
			RETURN 1
		ENDIF
	ENDIF

	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 1
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「응……, 읏❤……감질난다고…… 정말……읏❤」
		CASE 2
			PRINTFORMW 「……정성스럽게 하는 걸 좋아하는 거야? ……뭐…… 싫진…❤……않아……읏…」
		CASE 3
			PRINTFORMW 「읏히읏❤ 잠깐……이상한 목소리 나오니까 기다려❤ 으읏아❤」
		;연모
		CASE 4
			PRINTFORMW 「읏……❤……꼬집히거나 손가락으로……읏❤ 당하는 거……좋을…지도…오❤」
		CASE 5
			PRINTFORMW 「읏아❤ 아읏❤……거짓말…… 만져지는 것만으로 갈 것 같아아❤아아……❤」
		;親愛
		CASE 6
			PRINTFORMW 「하아아…❤ 하아…읏❤ 기……기다려❤ 그것만으로 가버릴 것 같게 되니까아❤」
		CASE 7
			PRINTFORMW 「～～～읏❤읏❤읏구❤읏아❤아❤손가락으로 하는 거…안 돼읏❤」
		;애처
		CASE 8
			PRINTFORMW 「애태우는 거 치사해❤ 치사하다구❤…아❤～～～～읏❤읏❤」
	ENDSELECT
ENDIF
RETURN 1
