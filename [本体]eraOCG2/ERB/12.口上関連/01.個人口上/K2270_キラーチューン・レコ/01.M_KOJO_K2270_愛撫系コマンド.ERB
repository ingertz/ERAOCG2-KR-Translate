	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「……初めてだから……、…その……優しく……して」
		PRINTFORMW 「……ほら、こういう形で交わるのって……、……初めてだから……」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;삽입中
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;V삽입
	IF LOCAL:1 && TEQUIP:50 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			PRINTFORMW 「っ”～～～……❤っ”…ぁ…うっわ”っ…キっくぅ……❤」
			RETURN 1
		ELSE
			PRINTFORMW 「ぁ”っ❤……っ”❤っ”ぁ”❤っはっ”…❤あっづ……とけち”ゃい”そ…ぉ”❤」
			RETURN 1
		ENDIF
	;A삽입
	ELSEIF LOCAL:1 && TEQUIP:51 == MASTER
		;사정した
		IF NOWEX:MASTER:사정
			PRINTFORMW 「そっち”にっ”❤だすの……ぉ”❤……あっづ……ゥぅ”…❤」
			RETURN 1
		ELSE
			PRINTFORMW 「ばっっ”❤んなと”こ”にだすなっ”……ぁ”…ぁ～～…❤」
			RETURN 1
		ENDIF
	ENDIF

	;-------------------------------------------------
	;ふたなり
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && (TALENT:2 & 3) == 3
		PRINTFORMW 
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 1
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 2
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「んっ……、っ❤……じれったい……っての……っ”❤」
		CASE 2
			PRINTFORMW 「……丁寧にするの好きなわけ？……まあ……いやじゃっ”…❤……ない……っ…」
		CASE 3
			PRINTFORMW 「っひ”っ❤まっっ”……変な声出るからまった”❤っっぁ”❤」
		;연모
		CASE 4
			PRINTFORMW 「っ……❤……摘まんだり指で……っ”❤されるの……ぃぃ…かも…ぉ”❤」
		CASE 5
			PRINTFORMW 「っぁ”❤あ”っっ”❤……うっそ……触られるだけでイぎそ”っ”ぉ”❤ぉぉ”……❤」
		;親愛
		CASE 6
			PRINTFORMW 「はーーっ…❤はーー…っ❤まっ……まって”❤それだけでイっぢゃいそうになってるかりぁ”❤」
		CASE 7
			PRINTFORMW 「～～～っ”❤っ”❤っぐ”❤っ”ぁ”❤あ”❤指でするの…だめっ”❤」
		;애처
		CASE 8
			PRINTFORMW 「焦らすのずるぃ”❤ずっるぅ”❤…ぁ”❤～～～～っ”❤っ”❤」
	ENDSELECT
ENDIF
