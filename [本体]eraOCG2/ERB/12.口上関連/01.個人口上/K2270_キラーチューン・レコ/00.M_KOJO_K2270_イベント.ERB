	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:TARGET:연모 > 0
			PRINTFORMW 「……、……たっ……ただいま……❤」
		ELSE
			PRINTFORMW 「……ただいま……、……うん、ただいま……」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;캐릭터が外出から帰宅する
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 1
	;-------------------------------------------------
