		PRINTFORML 「……ごめんくださーい、アタシだよー、レコだよー」
		PRINTFORMW 「%CALLNAME:MASTER%、入っていい～？」
		RETURN 1
	;「はい」を選択
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 1
		PRINTFORMW 「……あんがと、んじゃお言葉に甘えて。おじゃましま～す」
		RETURN 1
	;「いいえ」を選択
	ELSEIF LOCAL:1 && ARG == 5 && ARG:1 == 2
		PRINTFORMW 「あ～……そっか、ごめん、連絡も何もなしだったもんね……次の機会にしとくよ」
		RETURN 1
	;手が離せない状態で、帰ってくれる
