;※※※※※※※※※※※※※※※※※※※※※※※※※
;성교系コマンド
;※※※※※※※※※※※※※※※※※※※※※※※※※
;全て *삽입をする時* の구상のため、気持ちいい所を抉ったり、子宮を潰したい時は파생コマンドへ
;Ａ系は파생しないため、삽입継続で喘がせるといい感じになる
;==================================================
;60,정상위
;==================================================
@M_KOJO_MESSAGE_COM_K2270_60
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2270_60_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2270_60_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;정상위
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;처녀
		IF TCVAR:파과 == 1
			CALL M_KOJO_MESSAGE_COM_K2270_SHOJO_BREAK
			RETURN 1
		ELSE
			PRINTFORMW 「으읏❤……응읏……❤얼굴…… 가까워……❤」
			RETURN 1
		ENDIF
	ENDIF
	;-------------------------------------------------
	;삽입継続
	;삽입したままこの체위に切り替える
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && TCVAR:V삽입관리플래그 == MASTER
		;前回사정した
		IF TCVAR:질내사정플래그 
			CALL M_KOJO_MESSAGE_COM_K2270_SEXCHANGE_2
			RETURN 1
		ELSE
			CALL M_KOJO_MESSAGE_COM_K2270_SEXCHANGE_1
			RETURN 1
		ENDIF
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 0
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 0
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORMW 「읏❤딱 달라붙는 거……좋을…지도…오………❤」
		CASE 2
			PRINTFORMW 「……저기이❤으읏 좀 더……어❤ 박아…… 박아줘어❤ 오읏❤」
		CASE 3
			PRINTFORML 「아❤ 싸줘❤ 내 암컷 구멍 보지에 마음껏 싸도 되니까아❤ 아❤ 좀 더❤ 좀 더 해줘어❤」
			PRINTFORMW 「자지님의❤ 오으읏❤ 가아앗❤ 저 정액 만족할 때까지 싸줘어❤❤❤」
	ENDSELECT
ENDIF
RETURN 1

