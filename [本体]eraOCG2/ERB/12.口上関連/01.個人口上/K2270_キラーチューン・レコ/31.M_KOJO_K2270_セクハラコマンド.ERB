		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORML 急にお尻を触られたレコは%CALLNAME:MASTER%の手をひっぱたいた
			PRINTFORMW 「……セクハラ」
		CASE 2
			PRINTFORMW 「……ちょっ、……何？」
		CASE 3
			PRINTFORMW 「……勝手に触んないでほしいなー……」
		;연모
		CASE 4
			PRINTFORMW 「……もう、……%CALLNAME:MASTER%はそういうとこがなければなあ……」
		;親愛
		CASE 5
			PRINTFORMW 「んっ……、……まあ……いいけどさ……❤」
	ENDSELECT
ENDIF
RETURN 1
