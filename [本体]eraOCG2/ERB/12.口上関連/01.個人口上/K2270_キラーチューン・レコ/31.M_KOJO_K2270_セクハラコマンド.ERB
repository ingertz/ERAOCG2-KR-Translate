	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1
		;６以上
		IF ABL:TARGET:친밀 >= 6
			PRINTFORMW 
		;３以上
		ELSEIF ABL:TARGET:친밀 >= 3
			PRINTFORMW 
		;２以下
		ELSEIF ABL:TARGET:친밀 <= 2
			PRINTFORMW 
		ENDIF
