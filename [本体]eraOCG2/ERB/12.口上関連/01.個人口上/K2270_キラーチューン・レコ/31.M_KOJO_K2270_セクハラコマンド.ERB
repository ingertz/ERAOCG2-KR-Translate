@M_KOJO_MESSAGE_COM_K2270_310_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;친밀。ここを記入した場合、これより下は流れない
	;記入チェック（=0, 非표시、1, 표시）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1
		;６以上
		IF ABL:TARGET:친밀 >= 6
			PRINTFORMW 
		;３以上
		ELSEIF ABL:TARGET:친밀 >= 3
			PRINTFORMW 
		;２以下
		ELSEIF ABL:TARGET:친밀 <= 2
			PRINTFORMW 
		ENDIF
		RETURN 1
	ENDIF

	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 1
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORML 갑자기 엉덩이를 만져진 레코는 %CALLNAME:MASTER%의 손을 찰싹 때렸다
			PRINTFORMW 「……성희롱」
		CASE 2
			PRINTFORMW 「……잠깐, ……뭐야?」
		CASE 3
			PRINTFORMW 「……마음대로 만지지 말아줬으면 하는데-……」
		;연모
		CASE 4
			PRINTFORMW 「……정말, ……%CALLNAME:MASTER%는 그런 점만 없으면 말야……」
		;親愛
		CASE 5
			PRINTFORMW 「응……, ……뭐…… 괜찮지만……❤」
	ENDSELECT
ENDIF
RETURN 1
