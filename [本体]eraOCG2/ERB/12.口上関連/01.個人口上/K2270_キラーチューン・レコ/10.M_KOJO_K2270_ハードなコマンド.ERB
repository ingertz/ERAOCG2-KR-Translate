;111,踏む
;TFLAG:193（1=身体,2=절정胸,3=절정クリトリス,4=정액腹,5=土下座頭）
;==================================================
@M_KOJO_MESSAGE_COM_K2270_111
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2270_111_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2270_111_1
#DIM DYNAMIC 호감도修正
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML 레코는 바닥에 허리를 내리고, 가랑이를 크게 벌려 자신의 암컷 구멍을 무방비하게 드러내는 체위를 취했다
		PRINTFORMW 「……보지…… 밟거나…… 하는구나……, 꽤 심한 짓을 하네…… %CALLNAME:MASTER%는」
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 0
		PRINTFORML 레코는 자신의 성기를 짓밟히면서도, 애액을 흩뿌리며 가면서 기뻐하고 있다……
		PRINTFORMW 「훗……❤ 으으……❤ 밟혀서 으읏 가버렷…❤ 으읏 구으으…❤」
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 0
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
		IF TALENT:TARGET:연모
			PRINTFORML 보지를 짓밟힐 때마다 레코는 짓눌러오는 발의 움직임에 맞춰 허리를 앞으로 내밀어 스스로 보지를 들이대고 있다
			PRINTFORMW 「아으읏…❤ 보지이…❤ 내 보지 밟혀서 망가져 버려어엇…❤ 아으읏…❤」
		ELSE	
			PRINTFORMW 「읏～～～～～으읏! ……보지 밟혀서엇, 가거나 하지잇, 읏～～～읏…❤」
		ENDIF
		CASE 2
			IF TALENT:TARGET:연모
				PRINTFORML 레코는 %CALLNAME:MASTER%에게 보지를 짓밟힐 때마다 고통뿐만 아니라 지배당하는 쾌락에 타락해 가고 있다……
				PRINTFORMW 「(나앗, ❤ 나 이상해지고 있어어❤ 이런 짓 당해서 기뻐해 버리고 있어어❤ 으으으～～～읏…❤)」
			ELSE
				PRINTFORMW 「읏읏……, ……아파아……으이……!」
			ENDIF
		CASE 3
			IF TALENT:TARGET:연모
				PRINTFORML %CALLNAME:MASTER%가 보지를 짓밟는 힘을 강하게 할 때마다, 레코는 허리를 띄우며 갈 것 같아진다……
				PRINTFORMW 「가…… 갑니다……❤ %CALLNAME:TARGET%는 읏… 아 보지 짓밟혀서 갑니다아으으으❤」
			ELSE
				PRINTFORMW 「으으 아……파아………읏……, 으으으……」
			ENDIF
	ENDSELECT
ENDIF
RETURN 1

