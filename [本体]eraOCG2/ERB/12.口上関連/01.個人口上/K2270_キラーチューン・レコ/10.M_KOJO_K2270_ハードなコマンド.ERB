;101,鞭
;==================================================
@M_KOJO_MESSAGE_COM_K2270_101
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K2270_101_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K2270_101_1
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小분기
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORML %CALLNAME:MASTER%가 손에 든 채찍을 보고, 레코는 조금 겁먹은 표정이 된다
		PRINTFORMW 「그걸로…… 나를 때리는 느낌……인가아……, ……다…… 다시 생각해 주면…… 고맙겠는데에……?」
		RETURN 1
	ENDIF
	;基本セット
	;연모
	IF TALENT:연모
		PRINTFORML 방 안에 소리가 울려 퍼질 정도의 힘으로 살을 채찍으로 맞으면서, 레코는 애액을 뿜어내며 갈 것 같아진다
		PRINTFORMW 「읏～～～～～……읏 아❤ 아읏……❤ 으읏 핫…… 잠❤ 아읏❤」
		RETURN 1

	;それ以外
	ELSE
		SELECTCASE RAND:3
			CASE 1
				PRINTFORMW 「읏 아팟……읏 으으으으……읏!」
			CASE 2
				PRINTFORMW 「잠…… 숨…… 고르…… 으아읏! ……으으 컥……!」
			CASE 3
				PRINTFORMW 「읏 으으으으……! 읏 으……읏, 아팟…… 아아…」
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
RETURN 1

