	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		IF EXP:TARGET:Ｍ경험 == 0 && EXP:TARGET:펠라경험 == 1 && CALLNAME:(CFLAG:TARGET:키스상실상대) == CALLNAME:MASTER
			PRINTFORML 무릎을 바닥에 댄 레코는 %CALLNAME:MASTER%에게 머리를 잡혀 발기한 음경을 얼굴에 들이대어지고 있다
			PRINTFORMW 「……첫 키스를 그런 흉악한 짓에 바치게 하는구나……」
			PRINTFORMW 「……최악, ……그래도 좋아, 당해줄게……」
			PRINTFORMW 그렇게 말하며, 레코는 스스로 입가에 손가락을 걸어 삽입되기 쉽도록 한다
		;それ以外
		ELSE
			PRINTFORML %CALLNAME:MASTER%의 허리에 얼굴이 닿도록 레코는 무릎을 바닥에 댄 체위가 되어 있다
			PRINTFORMW 「……목구멍에 억지로 처박을 생각…… 만만이라는 느낌……?」
			PRINTFORMW 「……숨은 쉴 수 있게 조절은 해줘……」
		ENDIF
		RETURN 1
	ENDIF
	;基本セット
	호감도修正 = 3
	SIF TALENT:TARGET:애처
		호감도修正 += 0
	SIF TALENT:TARGET:연모 == 2
		호감도修正 += 1
	SIF TALENT:TARGET:연모 >= 1
		호감도修正 += 2
	SELECTCASE RAND:호감도修正 + 1
		CASE 1
			PRINTFORML %CALLNAME:MASTER%의 발기 자지가 목구멍에 처박혀, 얼마 안 되는 틈새를 타액이 막아 레코는 질식할 뻔하면서 목구멍을 자지를 훑기 위해 쓰여진다……
			PRINTFORMW 「응으읏읏, 긋…… 오고읏, 오오읏」
		CASE 2
			PRINTFORMW 레코는 %CALLNAME:MASTER%의 발기 자지에 의해 목구멍이 넓혀질 때마다 움찔움찔 육체를 경련시키며 반응을 보이고 있다
		CASE 3
			PRINTFORMW %CALLNAME:MASTER%에 의해 목구멍 깊은 곳을 계속 찔려, 레코의 입 주위가 체액으로 흠뻑 젖어 있다
		CASE 4
			PRINTFORML 고쥬, 고쥬읏…… 하고 목구멍 깊은 곳까지 자지를 처박히면서, 레코는 무의식중에 혀를 움직여 %CALLNAME:MASTER%의 음경을 기분 좋게 하려고 봉사하고 있다
			PRINTFORMW 「－－－읏❤ 읏❤ 으오봇❤ 오읏읏❤ 오읏 오오❤」
		CASE 5
			PRINTFORML %CALLNAME:MASTER%의 음경이 목구멍을 찌를 때마다, %CALLNAME:TARGET%의 암컷 구멍은 애액과 분수를 뿜어내며 %CALLNAME:MASTER%의 흥분을 재촉해 버린다……
			PRINTFORMW 「(아❤ 아하❤ 나 부서져어❤ %CALLNAME:MASTER%의 자지님에게 부서져버려어❤)」
	ENDSELECT
ENDIF
RETURN 1

