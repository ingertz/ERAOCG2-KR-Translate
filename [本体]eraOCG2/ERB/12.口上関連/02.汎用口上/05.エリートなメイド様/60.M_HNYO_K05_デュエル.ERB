;==================================================
;10,ダメージ反応！（ダメージ）
;==================================================
@M_HNYO_DUEL_K05_10(ダメージ量,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC ダメージ量
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE ダメージ量
		;ダメージなし
		CASE 0
			PRINTFORMW 「おや、ダメージがありませんよ？」
		;１～１９９９の時、小ダメージ
		CASE 1 TO 1999
			PRINTFORMW 「おや、手加減してくれたのですか？　%CSTR:TARGET:MASCALL%はお優しいのですね♪」
		;２０００～３９９９の時、結構なダメージ
		CASE 2000 TO 3999
			PRINTFORMW 「～～～っ！　どうやら、%CSTR:TARGET:MASCALL%も本気の様ですね……！」
		;４０００～７９９９の時、超大ダメージ
		CASE 4000 TO 7999
			PRINTFORMW 「さ、流石です%CSTR:TARGET:MASCALL%……っ！」
		;８０００以上、基本即死
		CASEELSE
			PRINTFORMW 「ふふ、そこまでされるとは……　私の完敗、ですね♪」
	ENDSELECT
ENDIF


