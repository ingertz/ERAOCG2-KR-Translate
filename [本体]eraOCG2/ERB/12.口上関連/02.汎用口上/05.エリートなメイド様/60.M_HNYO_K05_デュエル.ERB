;==================================================
;999,EROTICS関連
;実行コマンドは数が多いのでテンプレートにはよく使われてそうな物だけ書いておきます
;추가したい場合は ERB/10.デュエル関連/01.デュエルシステム回り/효과汎用/エロ行動関連/02.カード조교
;を参照してください
;==================================================
@M_HNYO_DUEL_K05_999(ARG,ARG:1,実行コマンド)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC 実行コマンド
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 実行コマンド
		CASE "Ｃ単発"
			PRINTFORMW 「ッ！？　お、おやめください%CSTR:TARGET:MASCALL%！///」
		CASE "묘상捕縛"
			PRINTFORMW 「お、お許しください%CSTR:TARGET:MASCALL%……っ❤」
		CASE "全身愛撫"
			PRINTFORMW 「だ、ダメです%CSTR:TARGET:MASCALL%……っ❤」
		CASE "前穴凌辱"
			PRINTFORMW 「そ、そういうことはまた後でに……っ❤」
		CASE "全身凌辱"
			PRINTFORMW 「ああっ❤　だめです%CSTR:TARGET:MASCALL%……っ❤」
		CASE "疑似출산"
			PRINTFORMW 「～～～っ❤　あ、あまり見ないでください……っ❤」
		;その他全部
		CASEELSE
			PRINTFORMW 「そ、そういうことはデュエルの後で幾らでもお상대しますので……っ❤」
	ENDSELECT
ENDIF
