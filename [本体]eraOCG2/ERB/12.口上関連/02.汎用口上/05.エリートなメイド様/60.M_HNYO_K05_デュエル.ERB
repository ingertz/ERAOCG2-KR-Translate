;==================================================
;0,デュエルスタート！
;==================================================
@M_HNYO_DUEL_K05_0(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「はい、よろしくお願いしますね❤」
		CASE 2
			PRINTFORMW 「ふふ、デュエルでは手加減致しませんので！」
		CASE 3
			PRINTFORMW 「よろしくお願いします、%CSTR:TARGET:MASCALL%。」
	ENDSELECT
ENDIF

;==================================================
;1,モンスター소환
;例：%カード名%を소환！
;==================================================
@M_HNYO_DUEL_K05_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「이 카드는 如何でしょうか？」
		CASE 2
			PRINTFORMW 「%カード名%を소환致します。」
		CASE 3
			PRINTFORMW 「よろしくお願いします、%カード名%。」
	ENDSELECT
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_HNYO_DUEL_K05_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 소환出処
		;패에서 
		CASE 召種손패
			PRINTFORMW 「패에서 %カード名%を특수소환します！」
		;마법함정ゾーンから。　キリ番・シェイプシスターなどを出す場合
		CASE 召種마함
			PRINTFORMW 「마법함정ゾーンより、%カード名%を出させていただきます！」
		;덱에서 
		CASE 召種덱
			PRINTFORMW 「덱より、%カード名%を특수소환致します！」
		;EX덱에서 
		CASE 召種EX덱
			PRINTFORMW 「ＥＸ덱에서 失礼します、%カード名%！」
		;묘지에서 
		CASE 召種묘지
			PRINTFORMW 「묘지에서 %カード名%を蘇生致します！」
		;제외状態から
		CASE 召種제외
			PRINTFORMW 「제외されている%カード名%を私の場に呼び戻します！」
		;主にトークン生成
		CASE 10
			PRINTFORMW 「%カード名%を특수소환させて頂きます。」
	ENDSELECT
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_HNYO_DUEL_K05_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORMW 「의식소환！　よろしくお願いします、%カード名%！」
		CASE 융합
			PRINTFORMW 「%カード名%を융합소환します！」
		CASE 싱크로
			PRINTFORMW 「싱크로소환、%カード名%を盤面へ！」
		CASE 엑시즈
			PRINTFORMW 「엑시즈소환！　%カード名%、行きますよ！」
		CASE 링크
			PRINTFORMW 「%カード名%、링크소환です！」
		;초차원モンスター（デュエマ）
		CASE 초차원
			PRINTFORMW 「초차원から、%カード名%を出させていただきます！」
	ENDSELECT
ENDIF

