;==================================================
;10,ダメージ反応！（ダメージ）
;==================================================
@M_HNYO_DUEL_K04_10(ダメージ量,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC ダメージ量
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE ダメージ量
		;ダメージなし
		CASE 0
			PRINTFORMW 「ふん、ダメージの入らない攻撃に何の意味があるんだ。」
		;１～１９９９の時、小ダメージ
		CASE 1 TO 1999
			PRINTFORMW 「この程度、かすり傷だ……っ！」
		;２０００～３９９９の時、結構なダメージ
		CASE 2000 TO 3999
			PRINTFORMW 「ふん、この程度のダメージなど……っ！」
		;４０００～７９９９の時、超大ダメージ
		CASE 4000 TO 7999
			PRINTFORMW 「ぐぅぅ……っ！　な、中々やるな……っ！」
		;８０００以上、基本即死
		CASEELSE
			PRINTFORMW 「う、嘘だ……っ！　この私が、負ける等……っ！！」
	ENDSELECT
ENDIF


