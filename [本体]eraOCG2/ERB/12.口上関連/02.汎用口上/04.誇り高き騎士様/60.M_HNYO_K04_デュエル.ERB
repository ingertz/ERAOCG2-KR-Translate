		CASE 3
			PRINTFORMW 「私に勝てる気でいるのか？　甘い奴め……！」
	ENDSELECT
ENDIF

;==================================================
;1,モンスター소환
;例：%カード名%を소환！
;==================================================
@M_HNYO_DUEL_K04_1(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「%カード名%を소환する。」
		CASE 2
			PRINTFORMW 「通常소환、%カード名%だ。」
		CASE 3
			PRINTFORMW 「このカードで攻める……！　%カード名%！」
	ENDSELECT
ENDIF


;==================================================
;2,モンスター특수소환
;==================================================
@M_HNYO_DUEL_K04_2(カードID,소환出処)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 소환出処
#DIMS DYNAMIC カード名
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 소환出処
		;손패から
		CASE 召種손패
			PRINTFORMW 「손패から%カード名%を특수소환！」
		;마법함정ゾーンから。　キリ番・シェイプシスターなどを出す場合
		CASE 召種마함
			PRINTFORMW 「%カード名%を특수소환する。」
		;덱에서 
		CASE 召種덱
			PRINTFORMW 「덱에서 %カード名%を특수소환！」
		;EX덱에서 
		CASE 召種EX덱
			PRINTFORMW 「ＥＸ덱에서 %カード名%を특수소환！」
		;묘지から
		CASE 召種묘지
			PRINTFORMW 「묘지から%カード名%を특수소환！」
		;제외状態から
		CASE 召種제외
			PRINTFORMW 「제외ゾーンより、%カード名%を특수소환！」
		;主にトークン生成
		CASE 10
			PRINTFORMW 「%カード名%を특수소환する。
	ENDSELECT
ENDIF

;==================================================
;3,특수モンスター소환
;==================================================
@M_HNYO_DUEL_K04_3(カードID,ARG:1)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIM DYNAMIC カード種
TRYCALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

TRYCALLFORM CARD_{カードID}("종류")
カード種 = RESULT

;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE カード種
		CASE 의식
			PRINTFORMW 「%カード名%を의식소환！」
		CASE 융합
			PRINTFORMW 「%カード名%を융합소환！」
		CASE 싱크로
			PRINTFORMW 「%カード名%を싱크로소환！」
		CASE 엑시즈
			PRINTFORMW 「%カード名%を엑시즈소환！」
		CASE 링크
			PRINTFORMW 「%カード名%を링크소환！」
		;초차원モンスター（デュエマ）
		CASE 초차원
			PRINTFORMW 「%カード名%を초차원より展開！」
	ENDSELECT
ENDIF

