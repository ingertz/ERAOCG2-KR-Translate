;==================================================
;999,EROTICS関連
;実行コマンドは数が多いのでテンプレートにはよく使われてそうな物だけ書いておきます
;추가したい場合は ERB/10.デュエル関連/01.デュエルシステム回り/효과汎用/エロ行動関連/02.カード조교
;を参照してください
;==================================================
@M_HNYO_DUEL_K04_999(ARG,ARG:1,実行コマンド)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC 実行コマンド
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
SIF LOCAL == 1
	PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
IF LOCAL
	SELECTCASE 実行コマンド
		CASE "Ｃ単発"
			PRINTFORMW 「ひゃあっ！？　な、何をするんだき、貴様っ！？///」
		CASE "묘상捕縛"
			PRINTFORMW 「く……っ！　やるなら一思いにやれ……っ！」
		CASE "全身愛撫"
			PRINTFORMW 「ひゃあっ！？　な、何をするッ！？///」
		CASE "前穴凌辱"
			PRINTFORMW 「～～～っ！！///　この屈辱、絶対に忘れはせんぞ……っ！///」
		CASE "全身凌辱"
			PRINTFORMW 「な、何をするんだッ！　や、やめろぉ……っ！///」
		CASE "疑似출산"
			PRINTFORMW 「こ、こんなことをさせて……っ！　絶対に許さないぞ……っ！///」
		;その他全部
		CASEELSE
			PRINTFORMW 「き、貴様……っ！　デュエル中に何をするんだ……っ！！///」
	ENDSELECT
ENDIF
