@IRAI_EVENT_116(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE  "名前"
		RESULTS = (WCS4-1)ワールドチャンピオンシップ、世界大会
	CASE "이벤트種"
		RETURN 이벤트_物語
	CASE "依頼先"
		RETURN 場所_KL入口
	CASE "詳細"
		PRINTL いよいよワールドチャンピオンシップも大詰めだ。
		PRINTL 덱の準備に不安がないなら、会場のカイバーランドに向かおう。
		PRINTL
			SETCOLOR C_YELLOW
		PRINTL （注意！　？回連戦＋덱변경불가＋E.R.Aカード使用불가！）
			RESETCOLOR
		PRINTL 
	CASE "条件"
		SIF 依頼_完了횟수:115 == 0
			RETURN 0
		RETURN 1
ENDSELECT

RETURN 0

