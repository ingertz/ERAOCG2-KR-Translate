@IRAI_EVENT_116(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE  "名前"
		RESULTS = (WCS4-1)월드 챔피언십、세계대회
	CASE "이벤트種"
		RETURN 이벤트_物語
	CASE "依頼先"
		RETURN 場所_KL入口
	CASE "詳細"
		PRINTL 드디어 월드 챔피언십도 막바지다.
		PRINTL 덱 준비에 불안이 없다면, 회장인 카이바 랜드로 향하자.
		PRINTL
			SETCOLOR C_YELLOW
		PRINTL (주의! ?회 연전＋덱 변경 불가＋E.R.A 카드 사용 불가!)
			RESETCOLOR
		PRINTL 
	CASE "条件"
		SIF 依頼_完了횟수:115 == 0
			RETURN 0
		RETURN 1
ENDSELECT

RETURN 0

