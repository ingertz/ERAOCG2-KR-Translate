@IRAI_EVENT_40(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE  "名前"
		RESULTS = (ST4-1)Welcome to KAIBA CORP.
	CASE "이벤트種"
		RETURN 이벤트_物語
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		PRINTL 용사가 적이고 아직도 건재하다는 것이 확인되었다.
		PRINTL 그런 와중에, 조금 귀찮은 일에 휘말리게 된다…….
		PRINTL 
		PRINTL
		PRINTL 
	CASE "条件"
		SIF 依頼_完了횟수:34 == 0
			RETURN 0
		RETURN 1
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0



