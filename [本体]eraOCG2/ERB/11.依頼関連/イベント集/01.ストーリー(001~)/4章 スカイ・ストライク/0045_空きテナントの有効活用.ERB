@IRAI_EVENT_45(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS


SELECTCASE 参照先
	CASE "名前"
		RESULTS = (ST4-SP1)빈 테넌트의 유효활용
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		PRINTL マンション下のテナントが空いた、特に何とも思っていなかったが……
		PRINTL 하얀 소녀に妙な商材を押し付けられる。
		PRINTL 
	CASE "条件"
		SIF 依頼_完了횟수:44 == 0
			RETURN 0
		RETURN 1
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

