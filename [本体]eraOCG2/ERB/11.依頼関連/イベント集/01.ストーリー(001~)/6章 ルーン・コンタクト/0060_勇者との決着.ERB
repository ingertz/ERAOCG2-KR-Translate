@IRAI_EVENT_60(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE  "名前"
		RESULTS = (ST6-1)용사와의 결착
	CASE "이벤트種"
		RETURN 이벤트_物語
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		PRINTL 6개의 천년 아이템이 모였다.
		PRINTL KC가 만든 악몽의 아이템들이 하나로 모일 때 무슨 일이 일어나는가……
		PRINTL 그리고 용사들은 무엇을 노리고 있는 것일까……
		PRINTL 
	CASE "条件"
		SIF 依頼_完了횟수:54 == 0
			RETURN 0
		RETURN 1
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0



