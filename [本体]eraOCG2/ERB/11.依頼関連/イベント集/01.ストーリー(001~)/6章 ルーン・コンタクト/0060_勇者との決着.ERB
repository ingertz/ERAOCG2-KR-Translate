@CARD_EXPLANATION_1020061(종류)
#DIM DYNAMIC 종류
CALLFORM CARD_ABLE(0, 戦闘→묘지, 破壊→묘지)
PRINTL ①：이 카드가 파괴되었을 경우에 발동한다。
PRINTL 자신은 １０００ 데미지를 받고、이 카드를 묘지에서 특수 소환한다。
PRINTL 이렇게 특수 소환한 이 카드는 필드를 벗어날 경우、대신에 제외된다。
CALLFORM CARD_ABLE(0, 지속효과)
PRINTL ②：이 카드는 이 카드를 대상으로 하지 않는 효과를 받지 않는다。
CALLFORM CARD_ABLE(0, ターン終了時)
PRINTL ③：상대 턴의 엔드 페이즈 시에 발동한다、
PRINTL 상대에게 １０００ 데미지를 준다。



@CARDCAN_1020061(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,1020061)
SIF RESULT == 1
	RETURN 0
IF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지
	SIF 발동済_1(듀얼리스트,1020061)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,1020061,"묘지")
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン終了時
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_1020061(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 攻撃力修正
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%
IF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1020061)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 식물 송곳니
		효과추가종류:0 = 効追除処
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		CALL LIFE_CHANGE(듀얼리스트,"減少","효과",1000)
	ENDIF
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"無差耐")
ELSEIF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1020061)
	IF RESULT == 0
		CALL LIFE_CHANGE(듀얼리스트,"減少","효과",1000,1)
	ENDIF
ENDIF



