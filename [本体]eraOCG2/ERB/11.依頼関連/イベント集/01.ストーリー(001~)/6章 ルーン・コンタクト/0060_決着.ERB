@IRAI_EVENT_60(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE  "名前"
		RESULTS = (ST6-1)결착
	CASE "이벤트種"
		RETURN 이벤트_物語
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		PRINTL ６つの千年アイテムが集まった。
		PRINTL KCの作った悪夢のアイテムたちが一つに集まる時何が起こるのか……。
		PRINTL そして勇者たちは何を狙っているのだろうか……。
		PRINTL 
	CASE "条件"
		SIF 依頼_完了횟수:54 == 0
			RETURN 0
		RETURN 1
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0



