@CARDCAN_100381(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 조교대상 = -1

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,100381)
SIF RESULT == 1
	RETURN 0


IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,100381)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과条件カテゴリ:0 = 위치크래프트
	효과条件カテゴリ:1 = 젬나이트
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == 마함起動
	SIF 발동済_2(듀얼리스트,100381)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL RESETAREA_MAT
	素材範囲필드 = 1
	素材範囲마함 = 1
	;素材範囲손패 = 1
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = 융합
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_100381(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択속성
#DIMS DYNAMIC 選択속성_텍스트
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,100381,1)
	IF RESULT == 0
		;속성の選択
		IF 듀얼리스트 == "상대"
			CUSTOMDRAWLINE -
			PRINTFORML 속성を１つ選択してください。
			CUSTOMDRAWLINE -
			PRINTL [1] - 빛속성
			PRINTL [2] - 어둠속성
			PRINTL [3] - 땅속성
			PRINTL [4] - 물속성
			PRINTL [5] - 화염속성
			PRINTL [6] - 바람속성
			BINPUT
			選択속성 = RESULT
		ELSE
			;CPUが選ぶ場合はランダム・・・ここを어둠속성に固定。
			選択속성 = 어둠속성
			選択속성_텍스트 = 闇
			;選択した속성の표시
			
			PRINTFORMW 상대プレイヤーは「%選択속성_텍스트%」속성を選択しました。
			PRINTFORML 
			PRINTFORML いきなり속성を聞かれたハイネは、思わず「闇」속성を選んでしまったようだ。
			PRINTFORMW 『ちょっとハイネ、あなた자신が出たくて選んだんじゃないでしょうね？』
			PRINTFORML ジトーっとした目つきでヴェールが訝しそうに見ている……
			PRINTFORMW 『そ、そんなことありませんよ！　でも咄嗟だったのでつい자신の속성を……』
			PRINTFORMW 『……テストだからいいけど、어둠속성はハイネを呼んじゃうから危ないわよ。もっとも、ダメな選択じゃないけどね』
			PRINTFORML 
			
		ENDIF
		
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲덱 = 1
		효과条件속성 = 選択속성
		효과条件カテゴリ:0 = 위치크래프트
		효과条件カテゴリ:1 = 젬나이트
		효과条件固名前 = 위치크래프트골렘 시리카
		SIF 選択속성 == 화염속성
			효과条件スーパー名前 = 젬나이트 가넷
		SIF 選択속성 == 물속성
			효과条件スーパー名前 = 젬나이트 사피아
		SIF 選択속성 == 바람속성
			효과条件スーパー名前 = 젬나이트 르말린
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT
			;このカードを装備する処理
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件固定 = カード소환先
			CALLFORM CARD_EQUIP_ADV(듀얼리스트,場所,ゾーン)
			SIF RESULT == 1
				WAIT
		ELSE
			;소환できなかった場合の処理
			PRINTL 宣言された속성のモンスターを특수소환する事ができませんでした。
			CALL LIFE_CHANGE(듀얼리스트,"減少","コスト",1000)
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,묘지行き)
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == 마함起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,100381,2)
	IF RESULT == 0
		CALL RESETAREA_MAT
		素材範囲필드 = 1
		素材範囲마함 = 1
		;素材範囲손패 = 1
		CALL FULLRESET
		효과条件종류 = 융합
		효과条件소환可 = 2
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			TRYCALLFORM CARDSUMMON_{GETVAR(@"%듀얼리스트%_EX덱:{選択カード}")}(듀얼리스트,選択カード)
			CALL FUSSUMMON(듀얼리스트, 選択カード)
		ENDIF
	ENDIF
ENDIF










