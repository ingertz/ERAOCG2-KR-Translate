@IRAI_EVENT_381(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터
#DIM DYNAMIC 条件달성数 = 0
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 추가条件플래그 = 0

VARSET RESULT
VARSET RESULTS

;마법世界での、위치크래프트との（まともすぎる）クエスト。これ本当にeraなの？
;異世界の技術の情報など、開発のヒントにするための情報交換（ヒアリング）を行いたいとか
;OCGにおける別世界（端末世界）の융합마법の情報を提供して、対価に試作したゴーレムを貰う。
;続きでは、섀도르の人形がヴェールを襲い、デュエルで人形を破壊する感じの依頼となる予定？

;発生条件
;・천년도어による次元이동可能（２章までクリア）
;　もしくは「ヴェール」を所持済み　⇒ほぼ最初からスタートしても即クエスト受注する裏ルートを설정。シナリオ導入部も変わる
;・위치크래프트マスター・ヴェールと면식あり（他の子は不問）
;・「위치크래프트」캐릭터クターのカードを３종류以上所持する必要あり。
;クエスト추가条件
;	話の都合上、該当するカードが必要（どれもレアリティは低いので生成すればOKとしてる）
;	「젬나이트 크리스타」
;	「젬나이트 퓨전」
;	「섀도르・퓨전」

SIF !(ITEM:31102);젬나이트 크리스타(ID:31102)
	추가条件플래그 |= 1
SIF !(ITEM:71101);젬나이트 퓨전(ID:71101)
	추가条件플래그 |= 2
SIF !(ITEM:61831);섀도르 퓨전(ID:61831)
	추가条件플래그 |= 4

;「위치크래프트」캐릭터のカード枚数をチェック（依頼として표시するためには３종류以上必要）
FOR カウンタ,2040,2050
	SIF ITEM:カウンタ <= 0
		CONTINUE
	条件달성数 ++
NEXT

SELECTCASE 参照先
	CASE  "名前"
		RESULTS = (CP-WC1)위치크래프트 워크샵
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		IF 추가条件플래그 == 0;bitが立ってないなら受領可能
			PRINTL 
			IF ITEM:천년도어 == 0 ;천년도어の취득なしのケース = ヴェール所持ルートの導入となる。
				PRINTL ある日、自室の机の上に見慣れぬ巻物が置いてあったのを見つけた。
			ELSE
				PRINTL ある日、천년도어で異世界と繋がったクローゼットに巻物が置いてあったのを見つけた。
			ENDIF
			PRINTL 印章つきの封蝋までされた、時代がかった巻物にはこう書かれていた。
			PRINTL 
			PRINTL 「異なる世界の技術・我々の知らない未知の마법技術、承ります」
			PRINTL 
			PRINTL 
			PRINTL 
			PRINTL 
			PRINTL 成功報酬：情報提供料（応相談）
		ELSE
			PRINTL 
			PRINTL 依頼を受けるためには以下のカードが必要になります。
			PRINTL 
			IF 추가条件플래그 & 1
				SETCOLOR C_RED
				PRINTL ・「젬나이트 크리스타」　のカードが必要です。
				RESETCOLOR
			ELSE
				PRINTL ・「젬나이트 크리스타」　のカードは所持しています。
			ENDIF
			IF 추가条件플래그 & 2
				SETCOLOR C_RED
				PRINTL ・「젬나이트 퓨전」　のカードが必要です。
				RESETCOLOR
			ELSE
				PRINTL ・「젬나이트 퓨전」　のカードは所持しています。
			ENDIF
			IF 추가条件플래그 & 4
				SETCOLOR C_RED
				PRINTL ・「섀도르 퓨전」　のカードが必要です。
				RESETCOLOR
			ELSE
				PRINTL ・「섀도르 퓨전」　のカードは所持しています。
			ENDIF
			PRINTL 
			PRINTL カードを入手してから、再度依頼を受けて下さい。
			PRINTL （덱編集画面でのカード生成がおすすめです）
			PRINTL 
		ENDIF
	CASE "条件"
		;천년도어の開放、またはヴェール本人を呼び出せる状態
		SIF ITEM:천년도어 == 0 && CFLAG:NO_TO_CHARANUM(2040):소유함 == 0
			RETURN 0
		;ヴェールとの면식が必要（話を色々と手っ取り早くするための卑劣な条件설정だ……）
		SIF CFLAG:NO_TO_CHARANUM(2040):면식 == 0
			RETURN 0
		;「위치크래프트」の캐릭터クターのカードが３종류以上は必要。
		SIF 条件달성数 <= 2
			RETURN 0
		RETURN 1
	CASE "추가条件"
		;「젬나이트 크리스타」と「젬나이트 퓨전」と「섀도르 퓨전」の３枚のカードが必要。
		IF 추가条件플래그 != 0
			RESULTS = 의뢰를 받기엔 카드가 부족합니다。
			RETURN 1
		ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

@IRAI_ACT_381(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC 이벤트主,10
#DIM DYNAMIC 条件달성 = 0
#DIM DYNAMIC 詰めデュエルクリア플래그 = 0

;ヴェール
이벤트主:0 = NO_TO_CHARANUM(2040)
;ハイネ
이벤트主:1 = NO_TO_CHARANUM(2041)
;ジェニー
이벤트主:2 = NO_TO_CHARANUM(2042)
;エーデル
이벤트主:3 = NO_TO_CHARANUM(2047)
;シュミッタ
이벤트主:4 = NO_TO_CHARANUM(2046)
;ピットレ
이벤트主:5 = NO_TO_CHARANUM(2045)
;ポトリー
이벤트主:6 = NO_TO_CHARANUM(2044)


IF 依頼_달성상황 == 0
	;依頼スキップ機能
	IF 依頼_見返し中 == 0
		CUSTOMDRAWLINE -
		PRINTL 
		PRINTL 「依頼まるごとスキップ機能」を試験実装中！
		PRINTL 
		CUSTOMDRAWLINE -
		PRINTL 
		PRINTL 忙しくて長々とした面倒なお話を読む暇が無い、タイパ重視の現代遊戯王プレイヤーも、
		PRINTL ワンタッチで全部スキップして依頼を달성したことにして報酬のカードだけゲット可能！
		PRINTL 
		
		PRINTL 依頼をスキップしますか？
		PRINTFORML 
		PRINTFORML 
		PRINTFORML [0] - スキップせず、お話を読む
		PRINTFORML [1] - カードだけゲット！
		;PRINTFORML [33] - デュエルするところまでジャンプ（テスト用）
		BINPUT
		IF RESULT == 33
			依頼_달성상황 = 5
			依頼用エリア１名称 = 마법 세계의 어딘가
			依頼用エリア２名称 = 위치크래프트의 공방 입구
			依頼用エリア３名称 = 위치크래프트의 공방 상품 개발부
			依頼用エリア４名称 = 위치크래프트의 공방 시험실
			CALL EVENT_MOVE(MASTER,場所_依頼用エリア４,1)
			GOTO SKIPDUEL_IRAI381
		ELSEIF RESULT
			PRINTFORML 
			PRINTFORML 依頼をクリアしたものとして扱い、カードだけ入手します。
			PRINTFORMW 
			GOTO SKIPEND_IRAI381
		ENDIF
	ENDIF
	;最初　依頼を受けて自室から이동
	IF ITEM:천년도어 == 0
		;ドアなしのケースはヴェール所持している前提となる。특수演出（早期所持 = 初期캐릭터選択の想定）
		PRINTFORML 
		PRINTFORMW 「異なる世界の技術・我々の知らない未知の마법技術、承ります」
		PRINTFORML 
		PRINTFORMW ・・・仰々しい文体でそう書かれた巻物は、現代ではまず見かけない代物だ。
		PRINTFORMW メールもパソコンもある現代社会で、こんな通信手段を取る知り合いは居ないな。
		PRINTFORMW それに封蝋の紋章にも見覚えがある。
		PRINTFORMW ハンマーとハサミを抽象化したそのシンボルマークは・・・『위치크래프트』
		PRINTFORML 
		PRINTFORMW ・
		PRINTFORMW ・・
		PRINTFORMW ・・・《위치크래프트 デモンストレーション》の효과を발동！
		PRINTFORMW 《위치크래프트マスター・ヴェール》を특수소환する！
		PRINTFORML 
		CALL FLASH(2)
		PRINTFORMW POM！
		PRINTFORMW カードから幼い女の子が飛び出してきた！　もちろん守備표시で。
		PRINTFORML 
		PRINTFORMW 「もうっ。いきなり呼び出すなんて、ずいぶんじゃない？」
		PRINTFORMW 소환されたことを瞬時に察した少女――%CALLNAME:(이벤트主:0)%は、頭を掻きながら不満を軽く口にしている。
		PRINTFORML 
		PRINTFORMW そんな%CALLNAME:(이벤트主:0)%に巻物を見せつけると、彼女は肩をすくめた。
		PRINTFORMW 「あら？　この文字は마법文字じゃない。これを書いた人間はとても高レベルな마법使いね♪」
		PRINTFORML 
		PRINTFORMW 普通、そういうの자신で言うか……
		CLEARLINE 1
		PRINTFORMW 普通、そういうの자신で言うか……言うんだろうな。
		PRINTFORML 
		PRINTFORMW 「……冗談はこのぐらいにしておくとして。実は今、研究開発が"ちょっとだけ"行き詰まっててね」
		PRINTFORMW ホンの"ちょっと"だと、指の仕草で強調するように言う。
		PRINTFORMW 「そういう時は、全く新しい知見を得るのが一番手っ取り早いのよ。で、%CALLNAME:MASTER%の出番ってわけ」
		PRINTFORML 
		PRINTFORMW なるほど。理屈は分からんでもない。
		PRINTFORMW しかし、마법に関してはほとんど素人なんだが、それでいいんだろうか？
		PRINTFORMW 「いいのよ。外からの刺激が入るだけでも、物事って意外と好転したりするんだから。……それに」
		PRINTFORML 
		PRINTFORML くるりと踊るように、軽やかに%CALLNAME:(이벤트主:0)%は身を翻して指差した。
		PRINTFORMW 「%CALLNAME:MASTER%の『物事を見抜く力』……結構、信用してるのよ」
		PRINTFORML 
		PRINTFORMW ・・・
		CLEARLINE 1
		PRINTFORMW ・・・そう、事もなげに言った。
		CLEARLINE 1
		PRINTFORMW ・・・そう、事もなげに言った。そしてそのまま、자신の胸に手を当てて自信満々に言葉を続けた。
		PRINTFORMW 「なんといっても、このわたしを選び取ったのだから、大した審美眼というものよ♪」
		PRINTFORML 
		PRINTFORMW ・
		PRINTFORMW ・・
		PRINTFORMW ・・・
		PRINTFORML 
		PRINTFORMW それで、具体的には何をすればいいのか？　尋ねると、%CALLNAME:(이벤트主:0)%は少しだけ考える素振りを見せた。
		PRINTFORMW 「やっぱり私たちの工房まで来て貰いたいから……これよね」
		PRINTFORMW %CALLNAME:(이벤트主:0)%が指を鳴らすと、何もない空間から마법の杖が現れる。
		PRINTFORML 
		PRINTFORMW 《위치크래프트マスター・ヴェール》の마법の杖は、最上級の마법使いが手にするに相応しい、複雑な意匠と装飾が凝らされている。
		PRINTFORML 
		PRINTFORML 水晶のように透き通った煌玉の마법石には、ゆっくりと色を変える不思議な光の輝きが閉じ込められている。
		PRINTFORML 淡い藍色の輝きと桃色の輝きのグラデーションが玻璃の中で反射光を織り成し、杖を構える少女の頬を色づけている。
		PRINTFORML 마법石をぐるりと取り囲む水晶細工の装飾部には、１つだけでも並の마법使いの杖で中核に据えられる価値のある宝石が、数え切れないほど――――
		TWAIT 5000, 0
		PRINTFORML 
		PRINTFORMW 「……そんなにまじまじと見つめてたらケガするわよ」
		PRINTFORML 
		PRINTFORMW %CALLNAME:(이벤트主:0)%は、国１つでも替えが効かない至高の杖で軽くこちらを小突いて追い払うと、サッと大きく振りかぶった。
		PRINTFORML 
		PRINTFORM 部屋の空気が変わり、カタカタと部屋の小物が震えはじめる。
		WAIT
		PRINTFORM いや、震えているのは小物ではない、家全体――
		WAIT
		PRINTFORML いや、この世界がっ――――
		PRINTFORML 
		PRINTFORMW 「디멘션 매직！　"リターン・オブ・ザ・ワールド"！！」
		
		CALL FLASH(2)
		PRINTFORMW ・・・
		PRINTFORMW ・・・・・・
		CALL FLASH(2)
		PRINTFORMW ・・・・・・・・・！
		
		;依頼_場所 = 場所_寝室
		依頼_달성상황 ++
		依頼用エリア１名称 = 마법 세계의 어딘가
		依頼用エリア２名称 = 위치크래프트의 공방 입구
		依頼用エリア３名称 = 위치크래프트의 공방 상품 개발부
		依頼用エリア４名称 = 위치크래프트의 공방 시험실
		CALL EVENT_MOVE(MASTER,場所_依頼用エリア１,1)
		CALL EVENT_TIMER(20)
	ELSE
		;ドアありの場合は普通に自力で次元이동する必要あり。
		PRINTFORML 
		PRINTFORMW 「異なる世界の技術・我々の知らない未知の마법技術、承ります」
		PRINTFORML 
		PRINTFORMW ・・・仰々しい文体でそう書かれた巻物は、現代ではまず見かけない代物だ。
		PRINTFORMW メールもパソコンもある現代社会で、こんな通信手段を取る知り合いは居ないな。
		PRINTFORMW それに封蝋の紋章にも見覚えがある。
		PRINTFORMW ハンマーとハサミを抽象化したそのシンボルマークは・・・『위치크래프트』
		PRINTFORML 
		PRINTFORMW ・・・
		PRINTFORMW ・・・しかし、どうやってこんな巻物を置いていったのやら。
		PRINTFORMW 自宅のセキュリティにある種の不安を覚えつつも、依頼の場所に向かうことにした。
		
		依頼_場所 = 場所_마법都市
		依頼_달성상황 ++
		CALL EVENT_TIMER(10)
	ENDIF

ELSEIF 依頼_달성상황 == 1
	;마법世界。工房へ이동する。
	IF ITEM:천년도어 == 0
		PRINTFORML 
		PRINTFORMW 次元이동のショックは、凄まじいものだった。
		PRINTFORMW まだ世界全体が振動しているような錯覚が抜けず、"소환酔い"とはこういう감각なのかと納得していた。
		PRINTFORML 
		PRINTFORMW ・・・
		CLEARLINE 1
		PRINTFORMW ・・・ようやく감각が戻ってくる。
		PRINTFORMW 狭まっていた視野が戻るにつれて、先ほどまで居た自室とは、まるで違う場所でうずくまっていたのだと、改めて実感が湧いてきた。
		PRINTFORMW 「ふふ……だいぶやられたみたいね。気絶して寝込まないだけ、初心者にしては大したものよ」
		PRINTFORMW ニヤニヤと眺めながら待っていた%CALLNAME:(이벤트主:0)%は、まるでダメージを受けてない様子だ。
		PRINTFORML 
		PRINTFORMW 「立てる？　あなたにも杖が必要かしら……なんてね」
		PRINTFORMW 差し伸べてきた手を握り、起こす手伝いをしてもらう。立ち上がると、少しだけ世界が正しく見えてきたように思えてくる。
		PRINTFORML 
		PRINTFORMW ……ここが마법の世界か。
		PRINTFORMW なんというか、外国の片田舎ぐらいの雰囲気だ。
		PRINTFORMW 見慣れないは見慣れないが、そこまで元の世界とかけ離れた"異世界"には思えない。
		PRINTFORMW 「そりゃあそうよ。文化的な交流ができるような異世界ってなると、まあだいたいどこも似た形になるものなのよ」
		PRINTFORML 
		PRINTFORMW 街路の脇の木の幹をつつきながら、%CALLNAME:(이벤트主:0)%が講釈する。
		PRINTFORMW 大地があり、樹木があり、空気があり、人間が居るとなると、そこまで突飛な世界にはならないのか。
		PRINTFORMW 「それより……ちょーっとだけ座標がズレちゃったみたいね。まあ人が居ない場所って条件で跳んだから仕方ないけど」
		PRINTFORMW 失敗ではない。と言いたげに%CALLNAME:(이벤트主:0)%は弁明しながら、辺りを見回している。
		PRINTFORML 
		PRINTFORMW 土地勘がある場所なのかどうか判断しにくい反応だが、いきなり異世界でいきなり迷子というのは勘弁してほしいところだ。
		PRINTFORMW そんな心配を他所に、%CALLNAME:(이벤트主:0)%はマイペースに杖をかざして何やら魔術を行使し始めた。
					;デュマピック：마법使いの初級呪文。자신の현재위치を、基準点として설정した物体との相対的な距離で確認する事ができる마법。
		PRINTFORMW 「……ふーん。なるほどね」
		PRINTFORMW 杖の宝玉が放つ淡い光を見て、なにやら一人で勝手に理解しているらしい。
		PRINTFORMW すっかり蚊帳の外だが、流石に마법の事には口出しできないので黙って%CALLNAME:(이벤트主:0)%の判断を待つことにした。
		PRINTFORML 
		PRINTFORMW 「このぐらいの距離なら転移してもいいけど……」
		PRINTFORMW %CALLNAME:(이벤트主:0)%がこちらを流し見する。
		PRINTFORMW 「ま、いいわ。工房へは歩いて向かいましょう。%CALLNAME:MASTER%も次元跳躍したばっかりで気分が優れないでしょ」
		PRINTFORMW そう軽口を叩いた%CALLNAME:(이벤트主:0)%は、杖をどこかへと仕舞うと工房の方角を示しながら歩き始めた。
		PRINTFORML 
		PRINTFORML [0] - （……やれやれ。外を歩くのがよほど楽しいんだろうな）
		BINPUT
		PRINTFORML 
		PRINTFORML 
		PRINTFORMW そう考えながら、平衡감각を取り戻すよう一歩一歩踏みしめながら、どうにか%CALLNAME:(이벤트主:0)%の後をついていった。
		
		依頼_달성상황 ++
		CALL EVENT_MOVE(MASTER,場所_依頼用エリア２,1)
		CALL EVENT_TIMER(30)
		
	ELSE
		PRINTFORML 
		PRINTFORMW 마법都市엔디미온。
		PRINTFORMW 整然とした石造りの町並みは、まるで中世ヨーロッパをイメージしたファンタジー小説の世界に迷い込んだかのようだ。
		PRINTFORML 
		PRINTFORML 石畳の大通りを行き交う人々は規則正しい流れで都市全体を動かす原動力となっており、
		PRINTFORMW 時折、豪華な装飾の施された馬車が、都市の中心部――魔導王が統治する王城に向かって駆け上っていく。
