	CALL CHAR_CHANGE_476(이벤트主:11)
	CALL CHAR_CHANGE_476(이벤트主:12)
	CALL CHAR_CHANGE_476(이벤트主:13)
	CALL CHAR_CHANGE_476(이벤트主:14)
