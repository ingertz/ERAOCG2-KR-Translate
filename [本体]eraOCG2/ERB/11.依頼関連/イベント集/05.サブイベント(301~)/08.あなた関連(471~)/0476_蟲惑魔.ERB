@IRAI_EVENT_476(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS


SELECTCASE 参照先
	CASE "名前"
		RESULTS = (CP-TTH1)충혹마의 구멍
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		PRINTL 通信販売で購入した오나홀のレビューを見ていると、不穏なものがあった。
		PRINTL 
		PRINTL 『충혹마に搾り取られるようで、もう出ないのに吸いつくされて今は病院のベッドの上です。　★★★★☆　』
		PRINTL 『ムスコが絞り尽くされた。まるで生きているように蠢いているようで気持ち悪い。　　　　　★☆☆☆☆　』
		PRINTL 『不気味な声が聞こえますが、최면音声みたいでいつも以上に気持ちよくヌケました。　　　　★★★★★　』
		PRINTL 
		PRINTL 購入したものの中に、曰くつきのものが混ざっていたようだ……。
		PRINTL 耳を澄ますと、오나홀のパッケージから声が聞こえてくる。
		SETCOLOR C_RED
		PRINTFORML 《注意》충혹마캐릭터に変化が起こります。
		RESETCOLOR
	CASE "条件"
		SIF 依頼_完了횟수:1 == 0 && FLAG:게임모드 == 1
			RETURN 0
		SIF !ITEM:3
			RETURN 0
		RETURN 1
ENDSELECT

RETURN 0

