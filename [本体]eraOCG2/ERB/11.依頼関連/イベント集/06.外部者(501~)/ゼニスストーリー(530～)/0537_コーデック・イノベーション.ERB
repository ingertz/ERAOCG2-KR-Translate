#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 永攻紋章起動
	CALL FULLRESET
	CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,700,700)
	CALL STATCHANGE_BASIC(듀얼리스트,"상대필드",場所,-300,-300)

ELSEIF 종류 == 時限紋章起動
	CALL LIFE_CHANGE(듀얼리스트,"増加","효과",600)
ENDIF


