@CARDNAME_2024537,参照先
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 『로제스 이노베이션』
	CASE "略称"
		RESULTS = S.Z
	CASE "カテゴリ"
		RESULTS:0 = 노래："교지"의 정점　레디오 로제스
		RESULTS:1 = 작사：밀크
		RESULTS:2 = 작곡：수정의 왕
ENDSELECT


@CARD_2024537(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속마법
ENDSELECT

RETURN 0

@CARD_EXPLANATION_2024537(종류)
#DIM DYNAMIC 종류

PRINTL ①：자신 필드의 몬스터의 공격력 / 수비력은 ５００오르고、상대 필드의 몬스터의 공격력은 ５００내린다。
PRINTL ②：자신 스탠바이 페이즈에、자신의 패 / 묘지의 카드를 모두 덱에 되돌릴 수 있다。
PRINTL 그렇게 한 경우、되돌린 수＋１장、자신은 덱에서 드로우한다（최대７장）。
PRINTL ③：자신의 패가 ５장 이상 있을 경우、자신의 "제니스"는 마법 내성 / 대상 내성을 얻는다。
PRINTL 

@CARDCAN_2024537(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,2024537)
SIF RESULT == 1
	RETURN 0

IF 종류 == 永攻紋章起動
	RETURN 1

ELSEIF 종류 == 永紋章起動
	SIF 손패数(듀얼리스트) < 5
		RETURN 0
	RETURN 1

ELSEIF 종류 == 時限紋章起動
	SIF スタンバイフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_2024537(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC ドロー数
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 永攻紋章起動
	CALL FULLRESET
	CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,500,500)
	CALL STATCHANGE_BASIC(듀얼리스트,"상대필드",場所,-500)

ELSEIF 종류 == 永紋章起動
	CALL FULLRESET
	효과条件カテゴリ = 제니스
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"対耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"魔耐")

ELSEIF 종류 == 時限紋章起動
	FOR カウンタ,0,VARSIZE(@"%듀얼리스트%_손패") - 1
		SIF GETVAR(@"%듀얼리스트%_손패:カウンタ") == -1
			CONTINUE
		CALL CARD_DISPOSE(듀얼리스트,"손패",カウンタ,덱行き)
		ドロー数 ++
	NEXT
	FOR カウンタ,0,VARSIZE(@"%듀얼리스트%_묘지") - 1
		SIF GETVAR(@"%듀얼리스트%_묘지:カウンタ") == -1
			CONTINUE
		CALL CARD_DISPOSE(듀얼리스트,"묘지",カウンタ,덱行き)
		ドロー数 ++
	NEXT
	SIF ドロー数 > 7
		ドロー数 = 7
	CALL CARDDRAW_BASIC(듀얼리스트,ドロー数,1)
ENDIF
