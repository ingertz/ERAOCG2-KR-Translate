	CASE  "名前"
		RESULTS = (CP-ZI6)코덱 이노베이션
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		PRINTL 【「狡智」の頂天】
		PRINTL 蝿の王に支配された제니스が一人。
		PRINTL 情報は少なく、存在していることしか判明していない。
		PRINTL 支配以前は知略に優れていたため、舞台の裏で策謀を巡らせていたと思われる。
	CASE "条件"
		;前回クリア
		SIF 依頼_完了횟수:535 == 0
			RETURN 0
		RETURN 1
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0


