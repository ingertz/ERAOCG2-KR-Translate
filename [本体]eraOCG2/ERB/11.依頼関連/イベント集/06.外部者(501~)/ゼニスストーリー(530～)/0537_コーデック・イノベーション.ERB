@IRAI_EVENT_537(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터
#DIM DYNAMIC 条件チェック
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE  "名前"
		RESULTS = (CP-ZI6)코덱 이노베이션
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		PRINTL 【"교지"의 정점】
		PRINTL 파리 왕에게 지배된 제니스 중 한 명.
		PRINTL 정보는 적고, 존재한다는 것 외에는 판명되지 않았다.
		PRINTL 지배 이전에는 지략이 뛰어났기 때문에, 무대 뒤에서 책모를 꾸몄을 것으로 보인다.
	CASE "条件"
		;前回クリア
		SIF 依頼_完了횟수:535 == 0
			RETURN 0
		RETURN 1
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0


