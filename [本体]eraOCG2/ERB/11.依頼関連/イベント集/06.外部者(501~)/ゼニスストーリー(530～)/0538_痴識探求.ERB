#DIM DYNAMIC 대상캐릭터
#DIM DYNAMIC 条件チェック
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE  "名前"
		RESULTS = (CP-ZI6R)섹센티아 시크아웃
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		PRINTL 【「智」の頂】
		PRINTL 鎧を纏った龍のような姿をしたゼニス。
		PRINTL 表立って動くことこそ多くは無かったものの、《修羅丸》》を支配して《「戦慄」の頂　ベートーベン》を生み出す、
		PRINTL 光のデーモンコマンドと闇のエンジェルコマンドを生み出す提案など、陰から大きく戦況を動かしていた。
		PRINTL しかし、ドラゴンを封じる「智」を持っていながらも、鬼丸兄弟の「情」を理解出来なかったことが、最終的なゼニスの敗因へと繋がった。
	CASE "条件"
		;前提クリアで불가
		SIF 依頼_完了횟수:537 != 0
			RETURN 0
		;関連이벤트플래그
		SIF 依頼_進行보존:537 == 0
			RETURN 0
		;善人だったらダメー
		SIF FLAG:악랄치 < 35
			RETURN 0
		RETURN 1
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0


