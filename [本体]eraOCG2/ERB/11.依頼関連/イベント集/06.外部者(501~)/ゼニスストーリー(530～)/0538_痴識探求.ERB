@IRAI_EVENT_538(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터
#DIM DYNAMIC 条件チェック
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE  "名前"
		RESULTS = (CP-ZI6R)섹센티아 시크아웃
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		PRINTL 【「지」의 정점】
		PRINTL 갑옷을 두른 용과 같은 모습을 한 제니스.
		PRINTL 겉으로 드러나서 움직이는 일은 많지 않았지만, 《수라환》을 지배하여 《「전율」의 정점 베토벤》을 만들어내고,
		PRINTL 빛의 데몬 커맨드와 어둠의 엔젤 커맨드를 만들어내자는 제안을 하는 등, 뒤에서 크게 전황을 움직이고 있었다.
		PRINTL 하지만, 드래곤을 봉인하는 「지」를 가지고 있었음에도, 오니마루 형제의 「정」을 이해하지 못했던 것이, 최종적인 제니스의 패인으로 이어졌다.
	CASE "条件"
		;前提クリアで불가
		SIF 依頼_完了횟수:537 != 0
			RETURN 0
		;関連이벤트플래그
		SIF 依頼_進行보존:537 == 0
			RETURN 0
		;善人だったらダメー
		SIF FLAG:악랄치 < 35
			RETURN 0
		RETURN 1
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0


@IRAI_ACT_538(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC カノン
#DIM DYNAMIC ウェディング
#DIM DYNAMIC 이벤트主
#DIM DYNAMIC 절정ポイント
#DIM DYNAMIC 限界ポイント
#DIM DYNAMIC 굴복ポイント
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 前回選択コマンド
#DIM DYNAMIC 절정횟수
#DIM DYNAMIC 키스플래그
#DIM DYNAMIC 腹パン플래그

カノン = NO_TO_CHARANUM(2758)
ウェディング = NO_TO_CHARANUM(4025)
이벤트主 = NO_TO_CHARANUM(4023)

IF 依頼_달성상황 == 0
	PRINTFORML 「…………」
	PRINTFORMW 「…………」
	PRINTFORML
	PRINTFORML 로제스와의 라이브 배틀을 위해, 렌탈 %CALLNAME:カノン%는 정신수행을 하고 있다.
	PRINTFORMW %CALLNAME:ウェディング%가 말하길, 말로 사람을 조종하는 데 능숙하기 때문에, 평정을 유지하는 것이 중요하다고 한다.
	PRINTFORMW …………。
	PRINTFORML 
	PRINTFORMW 「한가하다냐-」
	PRINTFORML 
	PRINTFORML %CALLNAME:カノン% 관련 작업이 거의 다 끝나서, 할 일이 없다.
	PRINTFORMW 니아리는 %CALLNAME:カノン%의 스마트폰으로 만화를 탐독하고 있고, %CALLNAME:ウェディング%는 평소처럼 조용히 %CALLNAME:カノン%를 지켜보고 있다.
	PRINTFORML
	PRINTFORML 하지만, 남는 시간을 유효하게 사용하는 것이 유능한 듀얼리스트라는 법.
	PRINTFORMW 오늘은 마침 좋은 느낌의 의뢰가 와 있다.
	PRINTFORML
	PRINTL
	CUSTOMDRAWLINE ―
	PRINTL 의뢰：특수한 약품의 임상시험 안내
	CUSTOMDRAWLINE ―
	PRINTL 현재 저희 회사에서 개발 중인 약품의 테스터를 모집하고 있습니다.
	PRINTL 피험체는 저희 쪽에서 준비하므로, 그쪽은 피험체에 대한 액션과 리액션의 기록을 부탁드리고 싶습니다.
	PRINTL 수락하신다면, 이 의뢰를 수령하신 후, 아래 장소로 와주십시오.
	PRINTL
	PRINTL 보수：50만엔
	PRINTL
	PRINTL ……………………
	CUSTOMDRAWLINE ―
	PRINTL
	WAIT
	PRINTFORML 수상한 내용이 많기로 유명한 임상시험 아르바이트다!
	PRINTFORMW 여느 때처럼, 언뜻 본 업무 내용에 비해 보수도 이상하게 높아서, 틀림없이 제대로 된 조직이 아닐 거다!
	PRINTFORML 이 이야기를 니아리에게 했더니, 「나도 가보고 싶다냐리!」라고 대답했다.
	PRINTFORMW 약물을 투입하는 것도 아니고, 가사의 영감이 될 가능성이 있다면 오히려 좋은 일이겠지.
	PRINTFORML 
	PRINTFORML 촬영소는 여기서부터 꽤 먼 곳에 있다.
	PRINTFORMW 동쪽 역에서 전철을 타고 가자.
	依頼_場所 = 場所_東駅
	依頼_달성상황 ++

ELSEIF 依頼_달성상황 == 1
	CALL EVENT_MOVE(MASTER,場所_依頼用エリア１,1,"治験室")
	PRINTFORML 의뢰처 주소는 어느 뒷골목 빌딩의 지하에 있었다.
	PRINTFORMW 분명히 음침한 분위기가 감돌고, 알코올 섞인 비린내가 코를 찡하게 찔렀다.
	PRINTFORMW 접수처 같은 건 없고, 계단을 내려간 곳에 있던 흰 가운과 방독면을 쓴 수상한 남자가 마중해주었다.
	PRINTFORML 
	PRINTFORML 「크크크크…… 의뢰를 받아주셔서 감사합니다, %CALLNAME:PLAYER% 씨.
	PRINTFORMW 　……아니, %CALLNAME:MASTER% 님이라고 부르는 편이 좋을까요?」
	PRINTFORML 어느 쪽이든 상관없다.
	PRINTFORMW 그나저나 정말 수상한 남자다. 정말로 50만 엔을 준비했을까?
	PRINTFORMW 「크크크…… 네, 물론입니다」
	PRINTFORMW 그렇게 말하며 남자는 두툼한 봉투를 이쪽으로 건넸다.
	PRINTFORML ……만 엔짜리 지폐 50장 두께.
	PRINTFORMW 제대로 준비된 것 같아, 봉투를 돌려준다.
	PRINTFORML 「크크크…… 감사합니다.
	PRINTFORMW 　안심하십시오, 도중에 도망치거나 하진 않으니까요. 저희도 상품 데이터는 원하니까요……」
	PRINTFORML 
	PRINTFORML 이미 피험체는 준비된 것 같아, 방으로 안내받는다.
	PRINTFORMW 자, 불쌍하게도 수상한 약물의 실험 대상이 된 건 어떤 녀석일까……
	PRINTFORML 
	PRINTFORMW 「…………」
	PRINTFORML 
	PRINTFORMW ……로제스잖아.
	PRINTFORML 관두의를 입혀진 채, 받침대 위에 손발이 구속되어 있다.
	PRINTFORMW 편안하게 숨소리를 내며 자고 있으며, 남자가 말하길 약으로 재운 것 같다.
	PRINTFORML 
	PRINTFORML 이번 주 목적은 약물에 의한 반응을 보는 것이므로, 로제스가 일어나지 않으면 임상시험을 시작할 수 없다.
	PRINTFORMW 그동안 남자에게서 임상시험…… 실험 내용과 약물 정보를 듣게 되었다……
	依頼_달성상황 ++

ELSEIF 依頼_달성상황 == 2
	PRINTFORMW 「으…… 음…… 여긴……?」
	PRINTFORMW 「아, 일어났다냐리」
	PRINTFORML 
	PRINTFORMW 남자에게서 빌린 오셀로로 니아리와 놀고 있으니, 로제스가 눈을 떴다.
	PRINTFORMW 로제스는 상황을 인식하자, 이쪽으로 말을 걸어왔다.
	PRINTFORML 
	PRINTFORML 「어머, %CALLNAME:MASTER% 님이 아니신가요, 평안하신지요.
	PRINTFORMW 　모처럼이니 담소라도 나누고 싶지만, 우선 이것부터 풀어주시지 않겠어요?」
	PRINTFORMW %CALLNAME:MASTER%는 로제스에게 인사했다.
	PRINTFORMW 공교롭게도 그 제안은 받아들일 수 없다. 일이거든.
	PRINTFORML 
	PRINTFORMW 「하아…… 흥」
	PRINTFORML 찰칵하고 수갑이 울린다.
	PRINTFORMW 힘에는 자신이 있었는지, 로제스는 놀란 얼굴을 하고 있다.
	PRINTFORMW 찰칵찰칵 금속 소리가 울리는 가운데, 지금부터 약 실험을 할 것이라고 알린다.
	PRINTFORML
	PRINTFORML 「유감스럽지만 벗어날 수는 없는 것 같군요……
	PRINTFORMW 　대체, 어떤 약품을 저에게 투여할 생각이신가요?」
	PRINTFORML
	PRINTFORML 이번에 사용할 약의 이름은, 『본능의 외침 Type-3000』!
	PRINTFORMW 그 『본능의 외침』 시리즈의 최신작이다!
	PRINTFORML
	PRINTFORML 「……들어본 적 있어요. 뒷세계에서 사용되는 불법 약물.
	PRINTFORMW 　투여당하면 끝장, 남녀노소 불문하고 성에 미치게 만드는 최음제라고」
	PRINTFORML
	PRINTFORML 잘 알고 있잖아……
	PRINTFORMW 예상되는 효능으로는 기존의 성욕 증진 효과에 더해, 감도 3000배라고 한다.
	PRINTFORML 그런 이유로, 우선은 맨몸 상태의 반응을 기록하자.
	PRINTFORMW 관두의를 벗기고, 로제스의 빈약…… 조신한 몸을 노출시킨다.
	PRINTFORML
	PRINTFORML 「하아…… 여전하군요, 인간은 쓸데없는 것을 만들어내는 능력에 있어서는 타의 추종을 불허하네요.
	PRINTFORMW 　소용없어요, 우리 제니스들은 당신들보다 고위의 존재. 그런 저품질의 약물 따위 통하지 않아요」
	PRINTFORML 
	PRINTFORML 으음, 전혀 반응이 없다.
	PRINTFORMW 젖꼭지도 클리토리스도 꽤 세게 꼬집고 있는데, 전혀 아파하지 않는 것 같다.
	PRINTFORMW 「일단 이런 느낌으로 괜찮냐리?」
	PRINTFORMW 니아리가 메모지에 쓴 것을 보여준다.
	PRINTL
	CUSTOMDRAWLINE ―
	PRINTL
	PRINTL [약품 투여 전]
	PRINTL ・젖꼭지, 클리토리스를 세게 꼬집어도 목소리에 변화는 없음
	PRINTL ・반응은 전무, 전혀 재미없음
	PRINTL
	CUSTOMDRAWLINE ―
	PRINTL
	WAIT
	PRINTFORML 으음…… 뭐 괜찮겠지.
	PRINTFORMW 생각 같은 걸 쓰는 건 좋은데, 되도록 감정은 섞지 말아줘.
	PRINTFORMW 「알았다냐리!」
	PRINTFORMW 자, 그럼 기대하시던 두근두근 드럭 타임이다.
	PRINTFORML 이 최음제는 기존대로 내복약이므로, 로제스가 마셔줘야 한다.
	PRINTFORMW 억지로 마시게 할 수도 있지만…… 가능하다면, 스스로 마셔주면 수고를 덜 수 있어 편하다.
	PRINTFORMW 「……어쩔 수 없군요, 서둘러 끝내도록 하죠」
	PRINTFORML 협조적이라서 다행이다!
	PRINTFORMW 누운 채로는 목에 걸릴 수 있으니, 받침대를 일으킨 후 빨대를 입가에 가져간다.
	PRINTFORMW 물 한 컵에 한 방울이면 충분하다고 설명 들었지만, 불감증 수준이 아닌 로제스에게는 대 서비스로 10방울 정도 투약하자!
	PRINTFORML
	PRINTFORMW ……좋아, 전부 마셨군.
	PRINTFORMW 「이거 어느 정도 지나야 효과가 나타나냐리?」
	PRINTFORML 성욕에 지배된 인간은 매우 성급하니까……
	PRINTFORMW 5분이나 6분…… 10분은 걸리지 않겠지.
	PRINTFORML 
	PRINTFORMW 「그런데, 약효가 확인되지 않을 경우에는 어떻게 하실 건가요?」
	PRINTFORML 
	PRINTFORML 역시 30분 기다려도 효과가 없으면 해산일까……
	PRINTFORMW 피험체가 나쁘다고 그 흰 가운에게 불평해주자.
	PRINTFORML 
	PRINTFORMW 오셀로를 계속하면서, 로제스에게 변화가 나타나기를 기다리기로 했다……
	依頼_달성상황 ++

ELSEIF 依頼_달성상황 == 3
	CALL EVENT_TIMER(40)
	PRINTFORMW 「좋아, 내 승리다냐리!」
	PRINTFORML 강하다…… 강하지 않아?
	PRINTFORMW 귀를 차지하고도 졌는데.
	PRINTFORML
	PRINTFORMW 「……후우……❤」
	PRINTFORML
	PRINTFORML 「"잡게 해준 거"다냐리, 생각이 훤히 보였다냐리」
	PRINTFORMW 즉, 계속 손바닥 위에서 놀아났다는 건가……
	PRINTFORML 
	PRINTFORMW 「하아……으응……❤」
	PRINTFORML 
	PRINTFORML 역시 "진심"으로 하려면 책이라도 읽어야 하나.
	PRINTFORML 「고수랑 치고받는 게 좋다냐리!」
	PRINTFORMW 듀얼이랑 똑같네!
	PRINTFORML 
	PRINTFORMW 「후우ー……후우ー……❤」
	PRINTFORML 
	PRINTFORML 그러고 보니, 약을 투여하고 나서 꽤 지났다.
	PRINTFORMW 로제스의 상태를 좀 볼까.
	PRINTFORMW 「깜빡 잊고 있었다냐리!」
	PRINTFORML
	PRINTFORMW 「하아……❤　……무슨 일인가요?❤」
	PRINTFORML
	PRINTFORML 몇 분 만에 본 로제스의 얼굴은 붉게 물들어 있었다.
	PRINTFORMW 체온이 올랐는지, 내쉬는 숨에는 열기가 서려 있고, 잡티 하나 없는 몸에는 땀이 배어 있다.
	PRINTFORMW 약이 듣기 시작한 것 같다. 몸 상태를 물어보자.
	PRINTFORML 
	PRINTFORMW 「몸 상태…… 말인가요? 네, 이상은 없어요. 기껏해야 체온이 상승한…… 정도예요」
	PRINTFORML 
	PRINTFORMW 그렇군요. 감도는 어떤가요?
	PRINTFORML
	PRINTFORMW 「감도도…… 네, 특별히 변한 건 없어요……」
	PRINTFORML
	PRINTFORML 그렇군요.
	PRINTFORMW 팽팽하게 솟아있는 분홍색 젖꼭지를 튕겨본다.
	PRINTFORML
	PRINTFORMW 「흐앙──！？❤」
	PRINTFORML 
	PRINTFORML 로제스는 방금 전까지의 늠름한 목소리와는 정반대의, 사랑스러운 교성을 지르며 몸을 떨었다.
	PRINTFORMW 감도 양호, 약의 효과는 확실히 나타나고 있는 것 같다.
	PRINTFORMW 「어, 어째서…… 이런……❤」
	PRINTFORML 로제스는 평소보다 민감해진 몸에 당황하고 있는 것 같다.
	PRINTFORMW 일단, 여러 가지 해보면서, 얼마나 변했는지 확인해보자.
	PRINTFORMW 「기록은 맡겨달라냐리!」
	;ここからＡループ開始
	$LOOP_A
	CALL REPEAT_PRINTL(5)
	PRINTL 【행동을 선택해주세요】
	PRINTL
	PRINTL [0] - 뺨을 꼬집는다
	PRINTL [1] - 귀에 숨을 불어넣는다
	PRINTL [2] - 가슴을 주무른다
	PRINTL [3] - 젖꼭지를 꼬집는다
	PRINTL [4] - 클리토리스를 꼬집는다
	PRINTL [5] - 질 내부를 휘젓는다
	PRINTL [6] - 발바닥을 간지럽힌다
	BINPUT
	PRINTL
	IF RESULT == 0 || RESULT == 1 || RESULT == 6
		PRINTFORML 「후ー……후ー……❤」
		PRINTFORMW 로제스는 거친 숨을 몰아쉬며 %CALLNAME:MASTER%를 바라보고 있다.
		条件달성 = 1
		SIF 절정ポイント < 9
			절정ポイント += 1
	ELSEIF RESULT == 2
		PRINTFORML 「응읏……❤　으아아……❤」
		PRINTFORMW 로제스는 조용히 교성을 흘리고 있다.
		절정ポイント += 2
		EXP:이벤트主:Ｂ경험 += 1
	ELSEIF RESULT == 3
		PRINTFORML 「응앗❤　하아……하아……❤」
		PRINTFORMW 로제스는 움찔 몸을 떨었다.
		절정ポイント += 3
		EXP:이벤트主:Ｂ경험 += 1
	ELSEIF RESULT == 4
		PRINTFORML 「응으으응❤앗❤　하앗……❤하앗……❤」
		PRINTFORMW 로제스의 허리가 부들부들 떨리고 있다.
		절정ポイント += 3
		EXP:이벤트主:Ｃ경험 += 1
	ELSEIF RESULT == 5
		PRINTFORML 「앗……하아……응응……❤」
		PRINTFORMW 로제스의 질 안쪽에서 애액이 멈추지 않고 흘러나오고 있다.
		절정ポイント += 2
		EXP:이벤트主:Ｖ경험 += 1
	ENDIF
	;절정ポイント１０以下ならループ
	IF 절정ポイント < 10
