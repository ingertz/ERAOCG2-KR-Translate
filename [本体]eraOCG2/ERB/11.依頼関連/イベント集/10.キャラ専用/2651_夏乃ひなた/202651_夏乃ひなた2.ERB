@IRAI_EVENT_202651(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 妹の心配、姉の意地
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 場所_学校内
	CASE "詳細"
		PRINTL ひなたの妹、夏乃こかげから「姉の暴走を止めるのに協力してほしい」と相談を受けた。
		PRINTL 
		PRINTL 报酬：3000DP
	CASE "条件"
		SIF 依頼_完了횟수:102651 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:NO_TO_CHARANUM(2651):호감도 < 500
			RESULTS = 호감도が不足しています
			RETURN 1
		ENDIF
		;発注人はこかげなので、こかげの속성をチェックする。
		;仕様です。
		IF CFLAG:NO_TO_CHARANUM(2674):면식 == 0
			RESULTS = 夏乃こかげと면식がない。
			RETURN 1
		ENDIF
		IF MARK:NO_TO_CHARANUM(2674):반발각인 > 0
			RESULTS = こかげが怒っている…まずは彼女の분노を鎮めましょう。
			RETURN 1
		ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

@IRAI_ACT_202651(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC 이벤트主
#DIM DYNAMIC こかげ

이벤트主 = NO_TO_CHARANUM(2651)
こかげ = NO_TO_CHARANUM(2674)

IF 依頼_달성상황 == 0
	PRINTFORML 듀얼学院の校舎内で、あなたは夏乃こかげに呼び出された。
	PRINTFORML 普段はクールで大人びた彼女が、今日は少し困ったような表情を浮かべている。
	PRINTFORMW 「お忙しい中、お時間をいただいてありがとうございます」

	PRINTFORML 「実は…また姉さんが、자신の実力も考えずに無茶な約束をしてきたんです」
	PRINTFORML こかげが溜息を吐く。
	PRINTFORMW 「少し灸をすえてやりたいので、手を貸してください」

	IF CFLAG:NO_TO_CHARANUM(2674):호감도 > 500 || TALENT:NO_TO_CHARANUM(2674):연모 > 0 || TALENT:NO_TO_CHARANUM(2674):굴복됨 > 0
		PRINTFORML 「%CALLNAME:MASTER%なら、姉さんも本気でデュエルするでしょうから」
		PRINTFORMW こかげの瞳に信頼の色が宿る。
	ELSE
		PRINTFORML 「見ず知らずの%CALLNAME:MASTER%に頼むのは筋違いかもしれませんが…」
		PRINTFORMW こかげが少し申し訳なさそうに視線を逸らす。
	ENDIF

	PRINTFORML あなたは詳しい事情を尋ねた。
	PRINTFORML 「姉さんは『デュエルに連敗して自信を失った子供たちのために、地域の強豪デュエリスト３人全員に勝ってみせる』という約束をしてしまったんです」
	PRINTFORML 「いつものことですが、姉さんは人の頼みを断れない성격で…」
	PRINTFORMW こかげが頭を抱える。

	PRINTFORML 「でも今回の상대は本当に強い人たちばかり。このままでは姉さんが恥をかくだけです」
	PRINTFORML 「だから、事前に姉さんの実力を確かめて、必要なら説得したいんです」
	PRINTFORMW 「協力していただけますか？」

	PRINTL
	PRINTL [0] - 「分かりました、協力します」
	PRINTL [1] - 「ひなたさんのためですね」
	BINPUT

	IF RESULT == 0
		PRINTFORML 「ありがとうございます」
		PRINTFORMW こかげが安堵の表情を見せる。
	ELSE
		PRINTFORML 「はい…姉さんのためです」
		PRINTFORMW こかげが複雑な表情で頷く。
		CALL EVENT_FAVUP(こかげ,50)
	ENDIF

	PRINTFORML 「それでは、姉さんのところへ向かいましょう」
	PRINTFORMW こかげがあなたを案内する。

	依頼_달성상황++
	依頼_場所 = 場所_学校教室

ELSEIF 依頼_달성상황 == 1
	PRINTFORML 学校の教室で、%CALLNAME:이벤트主%が一人で덱の調整に悩んでいた。
	CALL SYOTAIMEN(이벤트主)
	PRINTFORML 「あ、%CALLNAME:MASTER%！それにこかげも」
	PRINTFORMW %CALLNAME:이벤트主%が顔を上げる。

	PRINTFORML 「姉さん、例の約束の件ですが…」
	PRINTFORML こかげが切り出そうとすると、%CALLNAME:이벤트主%が慌てたように手を振る。
	PRINTFORML 「だ、大丈夫だよ！きっと何とかなるから！」
	PRINTFORMW しかし、その表情には不安が色濃く浮かんでいる。

	PRINTFORML 「本当は少し怖いけど、約束しちゃったから…」
	PRINTFORML %CALLNAME:이벤트主%が小さく呟く。
	PRINTFORMW 彼女の手が微かに震えているのが見える。

	PRINTFORML あなたは練習상대になることを申し出た。
	PRINTFORML 「え？%CALLNAME:MASTER%が？」
	PRINTFORML %CALLNAME:이벤트主%が驚いた表情を見せる。
	PRINTFORMW 「でも…迷惑じゃない？」

	PRINTL
	PRINTL [0] - 「練習は大切ですから」
	PRINTL [1] - 「あなたの実力を見せてください」
	BINPUT

	IF RESULT == 0
		PRINTFORML 「ありがとう！」
		PRINTFORMW %CALLNAME:이벤트主%の表情が明るくなる。
	ELSE
		PRINTFORML 「うん、頑張る！」
		PRINTFORMW %CALLNAME:이벤트主%が決意を新たにする。
		CALL EVENT_FAVUP(이벤트主,50)
	ENDIF

	PRINTFORML 「それじゃあ、お願いします！」
	PRINTFORML %CALLNAME:이벤트主%がデュエルディスクを構える。
	PRINTFORMW こかげは少し離れた場所から見守っている。

	TARGET = 이벤트主
	CALL CHOICE_DUEL_TYPE(202651)

	依頼_달성상황++

ELSEIF 依頼_달성상황 == 2
	IF RESULT == 1
		PRINTFORML 「すごい…！」
		PRINTFORML %CALLNAME:이벤트主%が感嘆の声を上げる。
		PRINTFORML 「%CALLNAME:MASTER%とデュエルして、자신の덱の新しい可能性が見えた気がする！」
		PRINTFORMW 彼女の瞳が輝いている。

		PRINTFORML 「ありがとう！キミとデュエルして、やる気が湧いてきた！」
		PRINTFORML 「絶対勝ってくるね！」
		PRINTFORMW %CALLNAME:이벤트主%が拳を握りしめる。

		CALL EVENT_FAVUP(이벤트主,100)
		依頼_進行보존:202651 = 1
	ELSE
		PRINTFORML 「やった！勝った！」
		PRINTFORML %CALLNAME:이벤트主%が嬉しそうに跳び上がる。
		PRINTFORML 「でも、%CALLNAME:MASTER%も手強かった…」
		PRINTFORMW 「本番でもこの調子で頑張らなきゃ」

		PRINTFORML 「ありがとう！いい練習になった！」
		PRINTFORMW %CALLNAME:이벤트主%が만족そうに微笑む。

		依頼_進行보존:202651 = 0
	ENDIF

	PRINTFORML こかげが近づいてくる。
	PRINTFORML 「姉さん、調子はどうですか？」
	PRINTFORML 「うん！なんだか自信がついた気がする！」
	PRINTFORMW %CALLNAME:이벤트主%が元気よく答える。

	PRINTFORML 「それなら良かったです」
	PRINTFORML こかげがほっとした表情を見せる。
	PRINTFORML 「でも、油断は禁物ですよ」
	PRINTFORMW 「分かってる！気をつけるよ！」

	PRINTFORML %CALLNAME:이벤트主%は強豪たちとのデュエルへ向かって行く。
	PRINTFORML 「頑張って！」
	PRINTFORMW あなたとこかげはその背中を見送った。

	依頼_달성상황++

ELSEIF 依頼_달성상황 == 3
	PRINTFORML しばらくして、%CALLNAME:이벤트主%が戻ってきた。
	PRINTFORML 「ただいま！」
	PRINTFORMW 彼女の表情は晴れやかだ。

	PRINTFORML 「姉さん、結果はどうでしたか？」
	PRINTFORML こかげが心配そうに尋ねる。
	PRINTFORML 「えへへ…実は全部勝っちゃった！」
	PRINTFORMW %CALLNAME:이벤트主%が照れくさそうに笑う。

	PRINTFORML 「本当ですか！？」
	PRINTFORML こかげが驚く。
	PRINTFORML 「うん！%CALLNAME:MASTER%との練習のおかげかな」
	PRINTFORMW %CALLNAME:이벤트主%があなたを振り返る。

	IF 依頼_進行보존:202651 == 1
		PRINTFORML 「特に最後の상대は手強かったけど、%CALLNAME:MASTER%との練習で学んだことを活かせた」
		PRINTFORMW 「本当にありがとう！」
	ELSE
		PRINTFORML 「みんな強かったけど、なんとか勝てた」
		PRINTFORMW 「練習の成果が出たかな」
	ENDIF

	PRINTFORML 「子供たちもとても喜んでくれて」
	PRINTFORML 「『お姉さん、すごい！』って言ってもらえた」
	PRINTFORMW %CALLNAME:이벤트主%が嬉しそうに話す。

	PRINTFORML こかげが深く息を吐く。
	PRINTFORML 「…姉さんのこと、よろしくお願いします」
	PRINTFORMW こかげがあなたに頭を下げる。

	PRINTFORML 「こかげ？」
	PRINTFORML %CALLNAME:이벤트主%が不思議そうに妹を見る。
	PRINTFORML 「何でもありません。ただ、姉さんが無事で良かったです」
	PRINTFORMW こかげが小さく微笑む。

	PRINTFORML 「今度は無茶な約束をする前に、ちゃんと相談してくださいね」
	PRINTFORML 「う、うん…気をつける」
	PRINTFORMW %CALLNAME:이벤트主%が苦笑いを浮かべる。

	PRINTFORML 「でも、人を助けるのはやめられないかも」
	PRINTFORML 「それが姉さんらしいところですが…」
	PRINTFORMW こかげが呆れたような、でも愛情のこもった表情を見せる。

	CALL EVENT_TIMER(120)
	RETURN 2
ENDIF

RETURN 1

@IRAI_REWARD_202651
CALL DP_GET(3000)

