@IRAI_EVENT_402651(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = (CH2651-04)キミと描く未来
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 場所_学校内
	CASE "詳細"
		PRINTL 最近ひなたが姿を見せなくなった。
		PRINTL 心配になったあなたは、妹のこかげに話を聞いてみることにした。
		PRINTL 
		PRINTL 報酬：10000DP
	CASE "条件"
		SIF 依頼_完了횟수:302651 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:NO_TO_CHARANUM(2651):호감도 < 2000 && TALENT:NO_TO_CHARANUM(2651):연모 == 0
			RESULTS = 호감도/条件が不足しています。
			RETURN 1
		ENDIF
		;発注人はこかげなので、こかげの속성をチェックする。
		;仕様です。
		IF CFLAG:NO_TO_CHARANUM(2674):면식 == 0
			RESULTS = こかげと면식がない…まずは彼女と知り合う必要がある。
			RETURN 1
		ENDIF
		IF MARK:NO_TO_CHARANUM(2674):반발각인 > 0
			RESULTS = こかげが怒っている…彼女の機嫌が直るまで待とう。
			RETURN 1
		ENDIF
        ;一応最終話なので、本人もチェックしておこうか…
        IF MARK:NO_TO_CHARANUM(2651):반발각인 > 0
            RESULTS = ひなたが怒っているため、この依頼は受けられない。
            RETURN 1
        ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

@IRAI_ACT_402651(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC 이벤트主
#DIM DYNAMIC こかげ

이벤트主 = NO_TO_CHARANUM(2651)
こかげ = NO_TO_CHARANUM(2674)

IF 依頼_달성상황 == 0
	PRINTFORML 学園を訪れたあなたは、こかげを探して校内を歩いていた。
	PRINTFORML 普段ならひなたがいるはずの場所にも、彼女の姿は見当たらない。
	PRINTFORMW ようやく図書館でこかげを見つけると、彼女は一人で本を読んでいた。

	PRINTFORML あなたが近づくと、こかげは顔を上げる。
	PRINTFORML 「%CALLNAME:MASTER%…どうしたんですか？」
	PRINTFORMW いつもの冷静な表情だが、どこか疲れているように見えた。

	PRINTFORML あなたはひなたの行方について尋ねる。
	PRINTFORML こかげの表情が一瞬曇る。
	PRINTFORMW 「……やはり、心配していたんですね」

	PRINTFORML 「実は、姉さんが数日前から姿を消しているんです」
	PRINTFORML こかげは重い口調で話し始める。
	PRINTFORMW 「いつものトラブルかと思っていたのですが…今回は違うようです」

	PRINTFORML 「姉さんが、裏社会のデュエリストに目をつけられました」
	PRINTFORML こかげの声に緊張が走る。
	PRINTFORMW 「発端は、姉さんのいつものお人よしです。でも、今回は規模が違います」

	PRINTFORML こかげによると、ひなたは騙されて多額の借金を負わされた友人を助けるため、
	PRINTFORML その友人の대신에 「負ければ全てを失う」という闇のデュエルを引き受けてしまったという。
	PRINTFORMW 「姉さんは、%CALLNAME:MASTER%を巻き込まないように一人で決着をつけようとしています。時間は…ちょっど今日らしいです」

	IF TALENT:こかげ:연모 > 0 || CFLAG:こかげ:호감도 > 1000
		PRINTFORML こかげの瞳に不安の色が浮かぶ。
		PRINTFORML 「お姉さんだけじゃなくて、%CALLNAME:MASTER%も失えばどうすれば…」
		PRINTFORMW 彼女の声が震えている。

		PRINTL
		PRINTL [0] - 「デュエルなら負けないから」
		PRINTL [1] - 「君も一緒に来てくれ」
		PRINTL [2] - 「心配しないで、俺を信じて」
		BINPUT

		IF RESULT == 0
			PRINTFORML あなたの力強い言葉に、こかげは少し安心したような表情を見せる。
			PRINTFORML 「…はい。%CALLNAME:MASTER%さんなら、きっと」
			PRINTFORMW 「お姉さんをお願いします」
		ELSEIF RESULT == 1
			PRINTFORML 「私も…？」
			PRINTFORML こかげは驚いたような表情を見せるが、すぐに決意を固める。
			PRINTFORMW 「はい、お姉さんのためなら」
			CALL EVENT_FAVUP(こかげ,150)
			依頼_進行보존:302651 = 1
		ELSE
			PRINTFORML あなたの優しい言葉に、こかげは頬を染める。
			PRINTFORML 「…ありがとうございます」
			PRINTFORMW 「信じても、いいかな」
			CALL EVENT_FAVUP(こかげ,120)
		ENDIF
	ENDIF

	PRINTFORML こかげから듀얼の場所を聞き出したあなたは、急いでその場所へ向かった。
	PRINTFORMW 時間はあまり残されていない。

	依頼_달성상황++
	依頼_場所:0 = 場所_空き家

ELSEIF 依頼_달성상황 == 1
	PRINTFORML 薄暗い廃工場の奥で、あなたはついにひなたを見つけた。
	PRINTFORML 彼女は黒いスーツを着た男性と向かい合っている。
	PRINTFORMW 追い詰められた表情のひなたが、そこにいた。

	PRINTFORML 「どうしてここに…！？」
	PRINTFORML ひなたはあなたを見つけて驚く。
	PRINTFORMW 「来ちゃダメだよ！危険すぎる！」

	IF TALENT:이벤트主:연모 == 0
		; 初告白ルート
		PRINTFORML 裏社会のデュエリストが不敵に笑う。
		PRINTFORML 「ほう、助っ人か？だが、約束は約束だ」
		PRINTFORMW 「この女が負ければ、全てを失うことになる」

		PRINTFORML あなたはひなたの前に立ちはだかる。
		PRINTL 
        PRINTL [0] - 「一人で背負うな。」
        BINPUT
		PRINTFORMW ひなたの瞳に涙が浮かぶ。

		PRINTFORML 「でも…私のせいで%CALLNAME:MASTER%まで…」
		PRINTL 
        PRINTL [0] - 「お前が誰かのために戦うなら、俺はお前のために戦う」
        BINPUT
		PRINTFORMW あなたは決意を込めて宣言する。

		PRINTFORML 裏社会のデュエリストが혀打ちする。
		PRINTFORML 「面倒な奴だ。だが、代理でも構わん」
		PRINTFORMW 「負ければ、お前もただでは済まないぞ」
		
        CALLFORM ANIME_TEST("　闇に潜む危険な賭博師　","　裏社会のデュエリスト　","Underground Duelist")
		TARGET = -1
		CALL CHOICE_DUEL_TYPE(302651)

		IF RESULT == 1
			; 승리
			PRINTFORML 激闘の末、あなたは승리を収めた。
			PRINTFORML 裏社会のデュエリストは悔しそうに去っていく。
			PRINTFORMW 「今回は運が良かったな…覚えておけ」

			PRINTFORML 全てが終わり、安堵と疲労でひなたは座り込む。
			PRINTFORML あなたが手を差し伸べると、ひなたはその手を握りしめる。
			PRINTFORMW 涙が頬を伝っていた。

			PRINTFORML 「いつも、いつも助けてくれて…」
			PRINTFORML ひなたは震える声で話し始める。
			PRINTFORMW 「%CALLNAME:MASTER%がいなかったら、私はとっくにダメだった…」

			PRINTFORML 「私、%CALLNAME:MASTER%のことが…」
			PRINTFORML 彼女は勇気を振り絞って言葉を続ける。
			PRINTFORMW 「好きです！」

			SETCOLOR C_PINK
			PRINTFORML 絶体絶命の상황でも、恋の華は屈せずに咲く。
			PRINTFORMW %CALLNAME:이벤트主%は【연모】を得た
			RESETCOLOR

			PRINTL
			PRINTL [0] - 「俺も君が好きだ」
			PRINTL [1] - 「君を守りたい」
			PRINTL [2] - 「…今じゃなく、後でちゃんと答えるからな」
			BINPUT

			IF RESULT == 0
				PRINTFORML あなたの言葉に、ひなたの表情が一気に明るくなる。
				PRINTFORML 「本当に？嘘じゃない？」
				PRINTFORMW 「やったぁ！」
				CALL EVENT_FAVUP(이벤트主,300)
			ELSEIF RESULT == 1
				PRINTFORML 「守って…くれるの？」
				PRINTFORML ひなたは嬉しそうに微笑む。
				PRINTFORMW 「ありがとう…心強いよ」
				CALL EVENT_FAVUP(이벤트主,200)
			ELSE
				PRINTFORML 「あ…うん！こんなところでごめんね！」
			ENDIF
            PRINTFORMW 「とにかく、まずはここから脱出しましょう！」

			依頼_進行보존:302651 = 10
		ELSE
			; 패배
			PRINTFORML あなたは力及ばず、デュエルに敗れてしまった。
			PRINTFORML 裏社会のデュエリストが勝ち誇る。
			PRINTFORMW 「所詮はアマチュアか。約束通り、代償を払ってもらおう」

			PRINTFORML ひなたが絶望的な表情を見せる。
			PRINTFORML 「そんな…%CALLNAME:MASTER%まで巻き込んでしまって…」
			PRINTFORMW 그 후、%CALLNAME:MASTER%たちの姿を見た人はいない…

			RETURN 6
		ENDIF
	ELSE
		; 恋人ルート
		IF 依頼_進行보존:302651 == 1
			PRINTFORML その時、後ろからこかげも現れる。
			PRINTFORML 「どうして…言わないでって言ったのに」
			PRINTFORMW ひなたはこかげの方を睨む。

			PRINTFORML 「当たり前でしょ」
			PRINTFORML こかげは毅然として答える。
			PRINTFORMW 「私のたった一人のお義兄さんになるかもしれない人を、危険な目に遭わせるわけにはいかないから」
            IF TALENT:こかげ:연모 > 0 || CFLAG:こかげ:호감도 > 1000
			    PRINTFORML 「そもそも私も%CALLNAME:MASTER%を…とにかく姉さんばかりでずるいです！」
            ENDIF
		ELSE
			PRINTFORML 「どうして来たの？危険だって言ったでしょ？」
			PRINTFORML ひなたは心配そうにあなたを見る。
			PRINTFORMW 「一人で何とかするつもりだったのに…」
		ENDIF

		PRINTFORML ひなたはあなたに向き直る。
		PRINTFORML 「ごめん…心配かけたくなくて」
		PRINTFORMW 「でも、これは私が始めたことだから」

		PRINTFORML あなたは優しくひなたの肩に手を置く。
		PRINTL
        PRINTL [0] - 「恋人に、一人で戦わせるわけないでしょう？」
        BINPUT
		PRINTL
        PRINTL [0] - 「二人で片付けよう」
        BINPUT

		PRINTFORML ひなたの瞳に安堵の色が浮かぶ。
		PRINTFORML 「%CALLNAME:MASTER%…」
		PRINTFORMW 「ありがとう」
        
        CALLFORM ANIME_TEST("　闇に潜む危険な賭博師　","　裏社会のデュエリスト　","Underground Duelist")
		TARGET = -1
		CALL CHOICE_DUEL_TYPE(302651)

		IF RESULT == 1
			; 승리
			PRINTFORML あなたが승리すると、ひなたはあなたの胸に飛び込んできた。
			PRINTFORML 「怖かった…でも、%CALLNAME:MASTER%が来てくれるって信じてた！」
			PRINTFORMW あなたはひなたを抱きしめる。
            
            PRINTL
            PRINTL [0] - 「もう絶対に一人で無茶するなよ」
            BINPUT
			PRINTFORMW 「うん…ありがとう。大好きだよ」

			CALL EVENT_FAVUP(이벤트主,250)
			依頼_進行보존:302651 = 11
		ELSE
			; 패배
			PRINTFORML デュエルに敗れ、상황は絶望的になった。
			PRINTFORML ひなたは泣き崩れる。
			PRINTFORMW 「私のせいで…ごめんなさい…」
			PRINTFORMW 그 후、%CALLNAME:MASTER%たちの姿を見た人はいない…

			RETURN 6
		ENDIF
	ENDIF

	; エピローグ
	PRINTFORML 全てが終わった後、あなたたちは工場の外に出た。
	PRINTFORML 夕日が街を染める中、ひなたは安堵の表情を見せている。
	PRINTFORMW 長い悪夢がようやく終わったのだ。

	IF TALENT:こかげ:연모 > 0 || CFLAG:こかげ:호감도 > 1000
		PRINTFORML 遠くでこかげが二人を見守っている。
		PRINTFORML 「まあ、今日ぐらいはお姉さんに譲ってもいいかな」
		PRINTFORMW 彼女は微笑んで立ち去った。
	ENDIF

	IF 依頼_進行보존:302651 == 10
		; 初告白後
		PRINTFORML 「これからは、もう一人で抱え込まないから」
		PRINTFORML ひなたはあなたの手を握る。
		PRINTFORMW 「%CALLNAME:MASTER%がいてくれるなら、どんなことでも乗り越えられる気がする」

		PRINTFORML 「でも、お人よしは治らないかも」
		PRINTFORML 彼女は苦笑いする。
		PRINTFORMW 「その時は、また助けてくれる？」

		PRINTL
		PRINTL [0] - 「当然だ」
		BINPUT

		PRINTFORML 「ありがとう。これからもよろしくお願いします」
		PRINTFORMW ひなたは幸せそうに微笑んだ。
	ELSE
		; 恋人ルート
		PRINTFORML 「今度こそ、ちゃんと相談するから」
		PRINTFORML ひなたは反省したように言う。
		PRINTFORMW 「恋人に心配かけちゃダメよね」

		PRINTFORML 「でも、困ってる人を見捨てることはできないの」
		PRINTFORML 「それが私だから」
		PRINTFORMW 「一緒に人助けしてくれる？」

		PRINTFORML あなたは頷く。
		PRINTFORML 「やった！心強い相棒ができた！」
		PRINTFORMW ひなたは元気よく笑った。
	ENDIF

	PRINTFORML 二人は手を繋いで家路につく。
	PRINTFORML 今日の出来事を乗り越えて、絆はさらに深まった。
	PRINTFORMW 明日からも、きっと新しい冒険が待っているだろう。

	CALL EVENT_TIMER(180)
	RETURN 2
ENDIF

RETURN 1

