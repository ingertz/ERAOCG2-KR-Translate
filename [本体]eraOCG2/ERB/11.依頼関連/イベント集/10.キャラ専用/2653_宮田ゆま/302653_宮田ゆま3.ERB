@IRAI_EVENT_302653(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터
#DIM DYNAMIC 이벤트主

이벤트主 = NO_TO_CHARANUM(2653)

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = (CH2653-03)破滅の女神
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 場所_工場
	CASE "詳細"
		PRINTL 街のデュエリストを襲撃する「破滅の女神」の噂が広まっている。
		PRINTL 
		PRINTL 報酬：3000DP、金銭20000
	CASE "条件"
		SIF 依頼_完了횟수:202653 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:이벤트主:호감도 < 1000
			RESULTS = 호감도が不足しています
			RETURN 1
		ENDIF
		IF MARK:이벤트主:반발각인 > 0
			RESULTS = 彼女はあなたを信じたいと思っているようだが、まだ心の整理がついていないようだ。
			RETURN 1
		ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

