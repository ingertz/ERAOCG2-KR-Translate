;위원장과 마찬가지로, 실질적인 최종 보스전.
;초기 초안의 허무의 네오스는 항시 제한 5였지만, 너무 심했나 싶어 약화시켰다.
;특수승리は認めない。正面でぶつけ合え。
;난이도 = 캐릭터 인기도라고 생각해도 좋을지 모르니,
;츤데레나 메구미 때는 어떻게 될까, 하고 생각하는 요즘.

@IRAI_EVENT_302653(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터
#DIM DYNAMIC 이벤트主

이벤트主 = NO_TO_CHARANUM(2653)

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = (CH2653-03)파멸의 여신
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 場所_工場
	CASE "詳細"
		PRINTL 거리의 듀얼리스트를 습격하는 '파멸의 여신'의 소문이 퍼지고 있다.
		PRINTL 
		PRINTL 보수：3000DP、돈20000
	CASE "条件"
		SIF 依頼_完了횟수:202653 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:이벤트主:호감도 < 1000
			RESULTS = 호감도가 부족합니다
			RETURN 1
		ENDIF
		IF MARK:이벤트主:반발각인 > 0
			RESULTS = 그녀는 당신을 믿고 싶어하는 것 같지만, 아직 마음의 정리가 되지 않은 것 같다.
			RETURN 1
		ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

