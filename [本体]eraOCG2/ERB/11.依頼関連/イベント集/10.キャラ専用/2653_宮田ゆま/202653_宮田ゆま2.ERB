@IRAI_EVENT_202653(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터
#DIM DYNAMIC 이벤트主

이벤트主 = NO_TO_CHARANUM(2653)

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = (CH2653-02)거짓된 구원
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 場所_教会
	CASE "詳細"
		PRINTL 미야타 유마로부터 "듀얼을 통해 사람들에게 평안을 주는 활동을 하는 그룹에 참가했다"는 연락이 왔다.
		PRINTL 하지만, 그 활동 내용을 들으니 어딘가 위화감이 든다.
		PRINTL 
		PRINTL 보상：2000DP、카드팩×10
	CASE "条件"
		SIF 依頼_完了횟수:102653 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:이벤트主:호감도 < 500
			RESULTS = 호감도가 부족합니다
			RETURN 1
		ENDIF
		IF MARK:이벤트主:반발각인 > 0
			RESULTS = 그녀는 당신을 믿고 싶어하는 것 같지만, 아직 마음의 정리가 되지 않은 것 같다.
			RETURN 1
		ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

