@CARD_EXPLANATION_202653(종류)
#DIM DYNAMIC 종류

PRINTL ①: 이 카드는 전투 내성과 공격 유도를 가지며, 융합·S·X·L 소환의 소재로 할 수 없다.
PRINTL 이 카드가 공격 표시가 아닐 경우 공격 표시가 된다.
PRINTL 이 카드를 구원의 마음이 없는 인간이 가질 경우, 자신이 듀얼에서 패배한다.
CALLFORM CARD_ABLE(1,지속효과)
PRINTL ②: 이 카드와 전투하는 몬스터는 데미지 계산 종료 시까지 전투 내성을 얻고,
PRINTL 데미지 스텝 종료 후에 자신은 그 몬스터의 컨트롤을 얻는다.
CALL CARD_ABLE(2, 필드→戦離)
PRINTL ③: 이 카드가 필드에서 벗어났을 때 발동한다. 자신이 듀얼에서 승리한다.

@CARDCAN_202653(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,202653)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_表:{場所}") != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃後強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF モンスター数(듀얼리스트) >= 5
		RETURN 0
	SIF 戦闘場所(듀얼리스트,1) == 5
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	TRYCALLFORM CARD_{戦闘カードID(듀얼리스트,1)}("성별")
	SIF RESULT != 雄性
		RETURN 0
	RETURN 1
ELSE
	RETURN 1
ENDIF


@CARDEFFECT_202653(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 所有者
#DIM DYNAMIC 合計攻撃力
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"攻誘")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"不材")
  	CALL STATCHANGE_EFFECT(対面者,"自身",戦闘場所(듀얼리스트,1),"戦耐")
	SIF GETVAR(@"%듀얼리스트%_MZ_表:場所") != 1
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"表",1)
	IF 듀얼리스트 == "자신"
		PRINTL 구원의 마음이 없는 마스터를 둔 구원의 인형에 의해,
		PRINTL 거대한 허무가 듀얼 필드를 삼켜간다……
		CALL SET_PLAYER_INFO(듀얼리스트,"듀얼패배플래그",4)
	ENDIF
ELSEIF 종류 == 攻撃後強制誘発
	選択カード = 戦闘場所(듀얼리스트,1)
	CALL FULLRESET
	CALL CARD_REMOVAL_BASIC(듀얼리스트,"自動処理",選択カード,"強奪")
ELSEIF 종류 == 필드→戦離
  PRINTL 구원의 인형의 파괴에 의해,
  PRINTL 거대한 허무가 듀얼 필드를 삼켜간다……
  PRINTL
  CALL SET_PLAYER_INFO(듀얼리스트,"듀얼패배플래그",4,1)
ENDIF
