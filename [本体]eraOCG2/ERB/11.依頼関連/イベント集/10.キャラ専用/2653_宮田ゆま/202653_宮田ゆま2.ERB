@IRAI_EVENT_202653(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터
#DIM DYNAMIC 이벤트主

이벤트主 = NO_TO_CHARANUM(2653)

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = (CH2653-02)偽りの救済
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 場所_教会
	CASE "詳細"
		PRINTL 宮田ゆまから「デュエルを通じて人々に安らぎを与える活動をしているグループに参加した」と連絡があった。
		PRINTL しかし、その活動内容を聞くと、どこか違和感を覚える。
		PRINTL 
		PRINTL 報酬：2000DP、カードパック×10
	CASE "条件"
		SIF 依頼_完了횟수:102653 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:이벤트主:호감도 < 500
			RESULTS = 호감도が不足しています
			RETURN 1
		ENDIF
		IF MARK:이벤트主:반발각인 > 0
			RESULTS = 彼女はあなたを信じたいと思っているようだが、まだ心の整理がついていないようだ。
			RETURN 1
		ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

