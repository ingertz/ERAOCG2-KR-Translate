@CARDNAME_202653,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 救済の聖人形
	CASE "略称"
		RESULTS = 救済の聖人形
	CASE "カテゴリ"
		RESULTS:0 = なし
ENDSELECT


@CARD_202653(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 400
	CASE "守備力"
		RETURN 300
ENDSELECT

RETURN 0

@CARD_EXPLANATION_202653(종류)
#DIM DYNAMIC 종류

PRINTL ①：このカードは戦闘耐性と攻撃誘導を持て、융합・Ｓ・Ｘ・Ｌ소환の素材にできない。
PRINTL このカードが攻撃표시じゃない場合は攻撃표시になる。
PRINTL このカードは救済の心を持たない人間に持たされる場合は、자신がデュエルに패배する。
CALLFORM CARD_ABLE(1,지속효과)
PRINTL ②：このカードと戦闘するモンスターはダメージ計算終了時まで戦闘耐性を得て、
PRINTL ダメージステップ終了後に자신はそのモンスターのコントロールを得る。
CALL CARD_ABLE(2, 필드→戦離)
PRINTL ③：このカードがフィールドから離れた時に발동する。자신がデュエルに승리する。

@CARDCAN_202653(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,202653)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_表:{場所}") != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃後強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF モンスター数(듀얼리스트) >= 5
		RETURN 0
	SIF 戦闘場所(듀얼리스트,1) == 5
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	TRYCALLFORM CARD_{戦闘カードID(듀얼리스트,1)}("성별")
	SIF RESULT != 雄性
		RETURN 0
	RETURN 1
ELSE
	RETURN 1
ENDIF


@CARDEFFECT_202653(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 所有者
#DIM DYNAMIC 合計攻撃力
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"攻誘")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"不材")
  	CALL STATCHANGE_EFFECT(対面者,"自身",戦闘場所(듀얼리스트,1),"戦耐")
	SIF GETVAR(@"%듀얼리스트%_MZ_表:場所") != 1
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"表",1)
	IF 듀얼리스트 == "자신"
		PRINTL 救済の心がないマスターを持つ救済の人形によって、
		PRINTL 巨大な虚無がデュエル場を吞み込んでゆく……
		CALL SET_PLAYER_INFO(듀얼리스트,"듀얼패배플래그",4)
	ENDIF
ELSEIF 종류 == 攻撃後強制誘発
	選択カード = 戦闘場所(듀얼리스트,1)
	CALL FULLRESET
	CALL CARD_REMOVAL_BASIC(듀얼리스트,"自動処理",選択カード,"強奪")
ELSEIF 종류 == 필드→戦離
  PRINTL 救済の人形の破壊によって、
  PRINTL 巨大な虚無がデュエル場を吞み込んでゆく……
  PRINTL
  CALL SET_PLAYER_INFO(듀얼리스트,"듀얼패배플래그",4,1)
ENDIF
