;점점 길어져서 3개의 파일로 나눴다…
;지난번과 비교하면 잡몹뿐인 마지막 회. 한숨 돌리세요.
;4A 루트는 복수극과 구제교의 철저한 타도
;4B 루트는 과거의 파괴와 현재의 재생이 테마.
;어느 쪽이냐고 하면 4B 쪽이 좋네요. 죄를 짊어지고 공범으로서 나아가는 느낌.

@IRAI_EVENT_402653(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터
#DIM DYNAMIC 이벤트主

이벤트主 = NO_TO_CHARANUM(2653)

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = (CH2653-04)너만의 히어로
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 場所_川沿い
	CASE "詳細"
		PRINTL 사건 후, 자신이 저지른 잘못의 무게에 괴로워하며 듀얼에서 멀어지려는 미야타 유마.
		PRINTL 
		PRINTL 보수：5000DP、돈20000、카드팩×30
	CASE "条件"
		SIF 依頼_完了횟수:302653 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:이벤트主:호감도 < 2000 && TALENT:이벤트主:연모 == 0
			RESULTS = 호감도/조건이 부족합니다.
			RETURN 1
		ENDIF
		IF MARK:이벤트主:반발각인 > 0
			RESULTS = 그녀는 당신을 믿고 싶어하는 것 같지만, 아직 마음의 정리가 되지 않은 것 같다.
			RETURN 1
		ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

@IRAI_ACT_402653(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC 이벤트主

이벤트主 = NO_TO_CHARANUM(2653)

;시작 시, 연모 플래그를 기록한다.
IF !GETBIT(依頼_進行보존:402653, 0)
	SETBIT 依頼_進行보존:402653, 0
	IF TALENT:이벤트主:연모 < 1
		CLEARBIT 依頼_進行보존:402653, 12
	ELSE
		SETBIT 依頼_進行보존:402653, 12
	ENDIF
ENDIF

IF !GETBIT(依頼_進行보존:402653, 12)
	CALL IRAI_ACT_402653_A(参照)
	RETURN RESULT
ELSE
	CALL IRAI_ACT_402653_B(参照)
	RETURN RESULT
ENDIF

RETURN 1

@IRAI_REWARD_402653
IF !GETBIT(依頼_進行보존:402653, 12)
	CALL IRAI_REWARD_402653_A
	RETURN RESULT
ELSE
	CALL IRAI_REWARD_402653_B
	RETURN RESULT
ENDIF

@IRAI_DECK_402653(듀얼리스트)
#DIMS DYNAMIC 듀얼리스트

IF 듀얼리스트 == "상대"
  IF !GETBIT(依頼_進行보존:402653, 12)
    CALL IRAI_DECK_402653_A(듀얼리스트)
	RETURN RESULT
  ELSE
    CALL IRAI_DECK_402653_B(듀얼리스트)
	RETURN RESULT
  ENDIF
ENDIF
RETURN 0

@IRAI_DUEL_INTRO_402653
IF !GETBIT(依頼_進行보존:402653, 12)
	TRYCALL IRAI_DUEL_INTRO_402653_A
ELSE
	TRYCALL IRAI_DUEL_INTRO_402653_B
ENDIF
