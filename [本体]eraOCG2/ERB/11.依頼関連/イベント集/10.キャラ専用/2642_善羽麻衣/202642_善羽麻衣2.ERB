@IRAI_EVENT_202642(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = (CH2642-02)ライバル登場！
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 場所_商店街
	CASE "詳細"
		PRINTL 地元이벤트で、麻衣は同業のアイドル・蝶野さなぎとの共演に燃える。
		PRINTL 
		PRINTL 报酬：2000DP、お金10000
	CASE "条件"
		SIF 依頼_完了횟수:102642 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:NO_TO_CHARANUM(2642):호감도 < 500
			RESULTS = 호감도が不足しています
			RETURN 1
		ENDIF
        IF MARK:NO_TO_CHARANUM(2642):반발각인 > 0
            RESULTS = 怒っている腹黒アイドルはちょっと会いにくい…분노が収まるまで待ちましょう。
            RETURN 1
        ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

@IRAI_ACT_202642(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC 이벤트主
#DIM DYNAMIC さなぎ
#DIM DYNAMIC 麻衣호감도
#DIM DYNAMIC さなぎ호감도

이벤트主 = NO_TO_CHARANUM(2642)
さなぎ = NO_TO_CHARANUM(2551)

IF 依頼_달성상황 == 0
	PRINTFORML 商店街の路上ステージ設営が進んでいる。
	PRINTFORML 今日は地元이벤트で、%CALLNAME:이벤트主%と蝶野さなぎの共演が予定されている。
	PRINTFORMW あなたはスタッフとして舞台転換とステージ進行を支えることになった。

	PRINTFORML 「%CALLNAME:MASTER%！」
	PRINTFORMW %CALLNAME:이벤트主%が駆け寄ってくる。

	PRINTFORML 「今日はよろしくお願いします」
	PRINTFORML 「でも…」
	PRINTFORMW 彼女は対面のステージを見つめながら小声で呟く。

	PRINTFORML 「さなぎちゃんは強いよ、だからこそ勝ちたい」
	PRINTFORMW その瞳には闘志が宿っている。

	PRINTFORML しばらくして、蝶野さなぎが現れた。
    CALL SYOTAIMEN(さなぎ)
	PRINTFORML 「麻衣ちゃん、今日はよろしくね♪」
	PRINTFORMW 爽やかな笑顔だが、どこか火花が散っているような雰囲気だ。

	PRINTFORML 「こちらこそ、さなぎちゃん」
	PRINTFORMW %CALLNAME:이벤트主%も負けじと微笑み返す。

	PRINTFORML リハーサルが始まる中、あなたは会場を盛り上げるアイデアを考えていた。
	PRINTFORMW そして、ひらめいた。

	PRINTL
	PRINTL [0] - 「ファン代表エキシビションデュエルはどうでしょう？」
	PRINTL [1] - 「二人の歌の合間に何か企画を挟みませんか？」
	PRINTL [2] - 「このまま普通に進行しましょう」
	BINPUT

	IF RESULT == 0
		PRINTFORML あなたはファン代表によるエキシビションデュエルを提案した。
		PRINTFORML 「それいいね！会場も盛り上がりそう！」
		PRINTFORML %CALLNAME:이벤트主%が目を輝かせる。
		PRINTFORML 「賛成です♪」
		PRINTFORMW さなぎも同意し、企画が採用された。
		CALL EVENT_FAVUP(이벤트主,50)
		CALL EVENT_FAVUP(さなぎ,50)
		依頼_進行보존:202642 = 1
	ELSEIF RESULT == 1
		PRINTFORML あなたは何らかの企画を挟むことを提案した。
		PRINTFORML 結果的にファン代表デュエルが採用されることになった。
		PRINTFORMW 「面白そうですね」両者とも興味を示している。
		依頼_進行보존:202642 = 1
	ELSE
		PRINTFORML あなたは普通の進行を提案したが、
		PRINTFORML 結局スタッフの提案でファン代表デュエルが挟まれることになった。
		PRINTFORMW まあ、結果オーライだろう。
		依頼_進行보존:202642 = 0
	ENDIF

	依頼_달성상황++
	依頼_場所 = 場所_商店街
ELSEIF 依頼_달성상황 == 1
	PRINTFORML 이벤트が始まった。
	PRINTFORML 前半はさなぎのソロパフォーマンス。
	PRINTFORMW 流石は名の知れたアイドル、会場は大いに盛り上がっている。

	PRINTFORML 「さすがね…」
	PRINTFORMW %CALLNAME:이벤트主%が舞台袖で呟く。

	PRINTFORML そして、あなたが提案したファン代表エキシビションデュエルの時間。
	PRINTFORML 「それでは、ファンの皆さんの中から代表の方に出てきていただきます！」
	PRINTFORMW 司会者が会場を盛り上げる。

	PRINTFORML スタッフ推薦の若手ファンデュエリストが登場。
	PRINTFORML 「対戦상대は…こちらの方です！」
	PRINTFORMW なんと、あなたが指名されてしまった。

	PRINTFORML 「え？」
	PRINTFORML %CALLNAME:이벤트主%が驚いている。
	PRINTFORMW 「頑張って、%CALLNAME:MASTER%！」

	TARGET = -1
	CALL CHOICE_DUEL_TYPE()

	IF RESULT == 1
		PRINTFORML 「やったー！」
		PRINTFORML %CALLNAME:이벤트主%が嬉しそうに手を叩く。
		PRINTFORML 会場も大いに盛り上がり、温度が一気に上がった。
		PRINTFORMW 「さすが%CALLNAME:MASTER%ね♪」
		CALL EVENT_FAVUP(이벤트主,100)
	ELSE
		PRINTFORML 「あー、残念…」
		PRINTFORML %CALLNAME:이벤트主%が苦笑いを浮かべる。
		PRINTFORML それでも会場は温まり、デュエルモードに入った。
		PRINTFORMW 「次は頑張ってね」
	ENDIF

	PRINTFORML そして後半、%CALLNAME:이벤트主%のソロパフォーマンス。
	PRINTFORML 彼女の歌声とダンスが会場を魅了していく。

	依頼_달성상황++
ELSEIF 依頼_달성상황 == 2
	PRINTFORML パフォーマンスが終わり、両者が舞台に立つ。
	PRINTFORML 「お疲れ様でした」
	PRINTFORML 「こちらこそ」
	PRINTFORMW 表面上は和やかな雰囲気だが…

	IF CFLAG:さなぎ:호감도 > 1000
		PRINTFORML 「でも…麻衣ちゃんばっかり%CALLNAME:MASTER%と仲良くしてずるい」
		PRINTFORMW さなぎが少しヤキモチを焼いているようだ。
	ENDIF

	PRINTFORML 「そうだ！」
	PRINTFORML %CALLNAME:이벤트主%が突然声を上げる。
	PRINTFORML 「せっかくだから、私たちもデュエルしない？」
	PRINTFORMW 「え？」さなぎが驚く。

	PRINTFORML 「ファンの皆さんも見たいでしょ？」
	PRINTFORML 会場からは「やれー！」「見たい！」の声が上がる。
	PRINTFORMW 「それじゃあ…やりましょうか」さなぎも応じた。

	PRINTFORML 急遽、%CALLNAME:이벤트主%と蝶野さなぎのデュエルが始まることになった。
	PRINTFORMW あなたは観客席から見守ることに。

	PRINTL
	PRINTL [0] - 麻衣を応援する
	PRINTL [1] - さなぎを応援する
	PRINTL [2] - 両方を応援する
	BINPUT

	;호감도による勝敗판정
	麻衣호감도 = CFLAG:이벤트主:호감도
	さなぎ호감도 = CFLAG:さなぎ:호감도

	IF RESULT == 0
		麻衣호감도 *= 3
		PRINTFORML あなたは%CALLNAME:이벤트主%を応援した。
		PRINTFORMW 「頑張れ、麻衣！」
		CALL EVENT_FAVUP(이벤트主,100)
	ELSEIF RESULT == 1
		さなぎ호감도 *= 3
		PRINTFORML あなたは蝶野さなぎを応援した。
		PRINTFORMW 「頑張れ、さなぎ！」
		CALL EVENT_FAVUP(さなぎ,100)
	ELSE
		PRINTFORML あなたは両方を応援した。
		PRINTFORMW 「二人とも頑張って！」
	ENDIF

	PRINTFORML 激しいデュエルが繰り広げられる。
	PRINTFORML %CALLNAME:이벤트主%のゼンマイ덱と、さなぎの蝶덱が火花を散らす。
	PRINTFORMW 会場は大興奮状態だ。

	IF 麻衣호감도 >= さなぎ호감도
		PRINTFORML 「勝った！」
		PRINTFORML %CALLNAME:이벤트主%が승리を収めた。
		PRINTFORML 「やるじゃない、麻衣ちゃん」
		PRINTFORMW さなぎも清々しい表情で패배を認める。
		依頼_進行보존:202642 += 10
	ELSE
		PRINTFORML 「さすがさなぎちゃん…」
		PRINTFORML さなぎが승리を収めた。
		PRINTFORML 「いいデュエルだったよ、麻衣ちゃん」
		PRINTFORMW 両者とも만족そうな表情だ。
	ENDIF

	PRINTFORML 이벤트は大成功で幕を閉じた。
	PRINTFORMW 観客たちも大만족の様子で帰っていく。

	依頼_달성상황++
ELSEIF 依頼_달성상황 == 3
	PRINTFORML 片付けを終えて、%CALLNAME:이벤트主%があなたのもとにやってきた。
	PRINTFORMW 「お疲れ様でした、%CALLNAME:MASTER%」

	PRINTFORML 「今日はありがとう」
	PRINTFORML 「でも、まだまだ만족できない」
	PRINTFORMW 彼女の瞳には更なる向上心が宿っている。

	PRINTFORML 「次はもっと速く、もっと綺麗に回して」
	PRINTFORML 彼女はゼンマイのギミックについて語り始める。
	PRINTFORMW 「私のデュエルも、もっと精密に、もっと美しく」

	PRINTFORML 「さなぎちゃんとのライバル関係も悪くないけど」
	PRINTFORML 「一番大切なのは、ファンの皆さんに最高のパフォーマンスを見せること」
	PRINTFORMW 彼女の言葉には真摯な想いが込められている。

	PRINTFORML 「%CALLNAME:MASTER%も、また手伝ってくれる？」
	PRINTFORMW 彼女が微笑みかける。

	PRINTL
	PRINTL [0] - 「もちろんです」
	BINPUT

	PRINTFORML 「ありがとう」
	PRINTFORML 「それじゃあ、また今度ね」
	PRINTFORMW %CALLNAME:이벤트主%は만족そうに帰っていった。

	CALL EVENT_TIMER(180)
	RETURN 2
ENDIF

RETURN 1

@IRAI_REWARD_202642
CALL DP_GET(2000)
PRINTL スタッフから今回の演出料をもらった。
CALL MONEY_GET(10000)

@IRAI_DECK_202642(듀얼리스트)
#DIMS DYNAMIC 듀얼리스트

SIF 듀얼리스트 == "상대"
	RETURN 202642
RETURN 0

;デュエル開始時
@IRAI_DUEL_INTRO_202642

PRINTFORML 
PRINTFORML さなぎファン代表「よろしくお願いします！」
