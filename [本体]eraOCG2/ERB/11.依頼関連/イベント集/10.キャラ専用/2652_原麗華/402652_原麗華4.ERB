@IRAI_EVENT_402652(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터
#DIM DYNAMIC 이벤트主

이벤트主 = NO_TO_CHARANUM(2652)

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
        RESULTS = (CH2652-04A)연애 이론의 프레젠테이션
        SIF TALENT:이벤트主:연모 > 0
		    RESULTS = (CH2652-04B)비효율적인 행복의 증명
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 場所_カドショ
	CASE "詳細"
		PRINTL 대회 며칠 후, 카드샵에서 하라 레이카가 당신을 기다리고 있습니다.
		PRINTL 
		PRINTL 보상：5000DP、돈 30000、카드팩×20
	CASE "条件"
		SIF 依頼_完了횟수:302652 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:이벤트主:호감도 < 2000 && TALENT:이벤트主:연모 == 0
			RESULTS = 호감도/조건이 부족합니다.
			RETURN 1
		ENDIF
        IF MARK:이벤트主:반발각인 > 0
			RESULTS = 그녀의 기록부에는 당신에 대한 불신이 명기되어 있을 것이다. 냉정한 판단을 되찾을 때까지 기다려야 한다.
            RETURN 1
        ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

@IRAI_ACT_402652(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC 이벤트主

이벤트主 = NO_TO_CHARANUM(2652)

;開始時、연모플래그を記録する。
IF !GETBIT(依頼_進行보존:402652, 0)
    SETBIT 依頼_進行보존:402652, 0
    IF TALENT:이벤트主:연모 < 1
        CLEARBIT 依頼_進行보존:402652, 1
    ELSE
        SETBIT 依頼_進行보존:402652, 1
    ENDIF
ENDIF

IF GETBIT(依頼_進行보존:402652, 1)
    CALL IRAI_ACT_402652_B(参照)
	RETURN RESULT
ELSE
    CALL IRAI_ACT_402652_A(参照)
	RETURN RESULT
ENDIF

RETURN 1

@IRAI_REWARD_402652
CALL DP_GET(5000)
CALL MONEY_GET(5000)
CALL CARD_PACK_SHORI(20)

@IRAI_DECK_402652(듀얼리스트)
#DIMS DYNAMIC 듀얼리스트

IF 듀얼리스트 == "상대"
	RETURN 412652
ENDIF
RETURN 0

;デュエル開始時
@IRAI_DUEL_INTRO_402652

IF !GETBIT(依頼_進行보존:402652, 1)
    CALL IRAI_DUEL_INTRO_402652_A
ELSE
    CALL IRAI_DUEL_INTRO_402652_B
ENDIF

@IRAI_ACT_402652_A(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC 이벤트主
#DIM DYNAMIC ライバル

이벤트主 = NO_TO_CHARANUM(2652)
ライバル = -1

IF 依頼_달성상황 == 0
	PRINTFORML 카드샵 내부는 평소와 다름없이 활기차다.
	PRINTFORML 신상 팩을 찾는 듀얼리스트들의 열기가 가게 안을 가득 채우고 있다.
	PRINTFORMW 그런 와중에, %CALLNAME:이벤트主%가 진지한 표정으로 당신을 기다리고 있었다.
	PRINTFORML
	PRINTFORML 「%CALLNAME:MASTER%, 기다리고 있었습니다」
	PRINTFORML %CALLNAME:이벤트主%는 단말기를 꽉 쥐고 있다.
	PRINTFORMW 「잠시 시간을 내주시겠습니까? 중요한 이야기가 있습니다」
	PRINTFORML
	PRINTFORML 그녀는 당신을 가게 안쪽의 조용한 공간으로 안내한다.
	PRINTFORML 인적이 드문 곳에 멈춰 서자, %CALLNAME:이벤트主%는 태블릿을 꺼냈다.
	PRINTFORMW 그 화면에는 왠지 모를 수많은 그래프와 데이터가 표시되어 있다.
	PRINTFORML
	PRINTFORML 「그럼, 시작하겠습니다」
	PRINTFORML %CALLNAME:이벤트主%는 안경을 고쳐 쓰고 화면을 조작한다.
	PRINTFORMW 「오늘의 주제는 『당신과의 관계성에 있어, 다음 단계로의 이행 제안에 대하여』입니다」
	PRINTFORML
	PRINTFORML 화면에는 당신과 %CALLNAME:이벤트主%의 만남부터의 기록이 표시된다.
	PRINTFORML 처음 만난 날, 함께 보낸 시간, 나눈 대화들…
	PRINTFORMW 모든 것이 세세하게 기록되어 그래프로 만들어져 있다.
	PRINTFORML
	PRINTFORML 「이것이 제 감정 변동 그래프입니다. 보시다시피, 당신과 보내는 시간에」
	PRINTFORML %CALLNAME:이벤트主%는 진지한 표정으로 설명을 계속한다.
	PRINTFORMW 「심박수 상승, 도파민 분비량 증가, 사고의 비효율화가 현저하게 나타납니다」
	PRINTFORML
	PRINTFORML 당신은 어안이 벙벙하다.
	PRINTFORML 설마, 이런 식으로 이야기를 들을 줄은 몰랐다.
	PRINTFORMW %CALLNAME:이벤트主%는 페이지를 더 넘긴다.
	PRINTFORML
	PRINTFORML 「다음은, 향후 관계 시뮬레이션입니다」
	PRINTFORML 화면에는 여러 개의 그래프와 예측 데이터가 표시된다.
	PRINTFORMW 「현상 유지 패턴, 관계 강화 패턴, 그리고… 최적해 패턴입니다」
	PRINTFORML
	PRINTL
	PRINTL [0] - 나도 모르게 웃어버린다
	PRINTL [1] - 진지하게 프레젠테이션을 듣는다
	PRINTL [2] - 「요컨대, 무슨 말이야?」
	PRINTL
	BINPUT

	IF RESULT == 1
		PRINTFORML 당신은 진지한 표정으로 %CALLNAME:이벤트主%의 프레젠테이션에 귀를 기울였다.
		PRINTFORMW 그녀의 말 한마디 한마디를 제대로 받아들인다.
		PRINTFORML
		PRINTFORML 「…」
		PRINTFORMW %CALLNAME:이벤트主%는 조금 기쁜 듯이 미소지었다.
		PRINTFORML
		PRINTFORML 「…진지하게 들어주시는군요」
		PRINTFORML %CALLNAME:이벤트主%의 목소리에는 안도하는 기색이 배어 있다.
		PRINTFORMW 「감사합니다. 그럼, 계속하겠습니다」
		PRINTFORML
		PRINTFORML 그녀는 화면을 다음 페이지로 넘긴다.
		PRINTFORML 그 표정은 아까보다 부드러워져 있다.
		PRINTFORMW 당신의 진지한 태도가 그녀의 마음을 따뜻하게 한 것 같다.
		PRINTFORML
		CALL EVENT_FAVUP(이벤트主,200)

	ELSEIF RESULT == 2
		PRINTFORML 당신은 %CALLNAME:이벤트主%의 설명을 가로막고 단도직입적으로 물었다.
		PRINTFORMW 「요컨대, 무슨 말이야?」
		PRINTFORML
		PRINTFORML 「…읏！」
		PRINTFORML %CALLNAME:이벤트主%의 얼굴이 확 붉어진다.
		PRINTFORMW 안경 너머의 눈동자가 당황한 듯 흔들린다.
		PRINTFORML
		PRINTFORML 「요, 요컨대…!」
		PRINTFORML %CALLNAME:이벤트主%는 심호흡을 하고, 마음먹은 듯 외친다.
		PRINTFORMW 「제 인생 계획에 당신이라는 가장 중요한 변수를 상주시키는 것을 승인해 달라는 신청입니다!」
		PRINTFORML
		PRINTFORML 그녀의 말이 가게 안에 울려 퍼진다.
		PRINTFORML 주위 손님들이 일제히 이쪽을 쳐다보지만, %CALLNAME:이벤트主%는 눈치채지 못한다.
		PRINTFORMW 얼굴을 새빨갛게 물들이고 당신을 가만히 쳐다보고 있다.
		PRINTFORML
		CALL EVENT_FAVUP(이벤트主,100)

	ELSE
		PRINTFORML 당신은 나도 모르게 웃어버렸다.
		PRINTFORMW 너무나도 %CALLNAME:이벤트主%다운, 지나치게 진지한 고백에.
		PRINTFORML
		PRINTFORML 「…！」
		PRINTFORML %CALLNAME:이벤트主%의 표정이 굳어진다.
		PRINTFORMW 그리고 눈물을 글썽이며 당신을 쏘아본다.
		PRINTFORML
		PRINTFORML 「웃을 일이 아닙니다!」
		PRINTFORML %CALLNAME:이벤트主%의 목소리가 떨리고 있다.
		PRINTFORMW 「저는, 지극히 진지하게, 논리적으로…!」
		PRINTFORML
		PRINTFORML 그녀는 말을 잇지 못하고 고개를 숙인다.
		PRINTFORML 그 어깨가 작게 떨리고 있다.
		PRINTFORMW 당신은 조금 후회했다.
		PRINTFORML
		CALL EVENT_FAVUP(이벤트主,-200)

	ENDIF

	PRINTFORML 그때, 옆에서 시끄러운 목소리가 들려온다.
	PRINTFORML 「위원장!」
	PRINTFORMW 들어본 적 있는 목소리다.
	PRINTFORML
	PRINTFORML %CALLNAME:이벤트主%가 고개를 든다.
	PRINTFORML 「…누구시죠?」
	PRINTFORMW 그녀는 고개를 갸웃거린다. 전혀 짐작이 가지 않는 모양이다.
	PRINTFORML
	PRINTFORML 점원의 안내를 받아 나타난 것은 낯익은 인물이었다.
	PRINTFORML 학원제에서, %CALLNAME:이벤트主%에게 승부를 걸어왔던 듀얼리스트다.
	PRINTFORMW 당신들을 발견하자 그는 달려온다.
	PRINTFORML
	PRINTFORML 「위원장! 그 녀석에게서 떨어져!」
	PRINTFORML 그는 %CALLNAME:이벤트主%와 당신 사이에 끼어든다.
	PRINTFORMW 「그런 놈한테 추파 던지지 마! 위원장에게 어울리는 건 바로 나다!」
	PRINTFORML
	PRINTFORML 「…아니, 정말 누구세요?」
	PRINTFORML %CALLNAME:이벤트主%의 차가운 시선이 그를 꿰뚫는다.
	PRINTFORMW 그 반응에 그는 분명히 상처받았다.
	PRINTFORML
	PRINTFORML 「나, 나야! 예전에 위원장에게 승부를 걸었던…!」
	PRINTFORML 그는 필사적으로 자기소개를 한다.
	PRINTFORMW 「그때는 위원장의 관심을 끌고 싶어서, 나도 모르게…!」
	PRINTFORML
	PRINTFORML 「아, 그때 그…?」
	PRINTFORML %CALLNAME:이벤트主%의 말이 끊긴다. 기억난 '척'하는 거 아닐까…?
	PRINTFORMW 어쨌든 그 표정에는 흥미가 전혀 없다.
	PRINTFORML
	PRINTFORML 「나는 진심이었어! 위원장에 대한 사랑은 누구에게도 지지 않아!」
	PRINTFORML 그는 듀얼 디스크를 장착한다.
	PRINTFORMW 「그 사랑인지 뭔지, 듀얼로 증명해 봐라!」
	PRINTFORML
	PRINTFORML %CALLNAME:이벤트主%의 표정이 험악해진다.
	PRINTFORML 「잠깐만요. 제 계획이…!」
	PRINTFORMW 그녀는 동요하고 있다. 완벽해야 할 계획이 엉망이 되어버렸다.
	PRINTFORML
	PRINTFORML 「위원장을 지키는 건 내 역할이야!」
	PRINTFORML 그는 흥분한 듯 당신을 가리킨다.
	PRINTFORMW 「자, 듀얼이다!」
	PRINTFORML
	PRINTFORML %CALLNAME:이벤트主%는 단말기를 꽉 쥐고 있다.
	PRINTFORML 그 눈동자에는 불안과 기대가 뒤섞여 있다.
	PRINTFORMW 당신은 듀얼 디스크를 장착했다.
	PRINTFORML
	TARGET = ライバル
    ;ランダム덱でいいや
	CALL CHOICE_DUEL_TYPE()

	IF RESULT == 1
		CALL FLASH(3)

		PRINTFORML 듀얼에서 승리했다.
		PRINTFORML 자칭 라이벌의 라이프 포인트가 0이 되자 그는 무릎을 꿇는다.
		PRINTFORMW 「큭… 졌다…」
		PRINTFORML
		PRINTFORML 「역시…」
		PRINTFORML %CALLNAME:이벤트主%가 당신에게 달려온다.
		PRINTFORMW 그 표정은 최고의 미소다.
		PRINTFORML
		PRINTFORML 「역시, 제 분석은 틀리지 않았습니다」
		PRINTFORML %CALLNAME:이벤트主%는 단말기를 조작한다.
		PRINTFORMW 「방금 전 제안, 받아주시겠죠?」
		PRINTFORML
        SETCOLOR C_PINK
        PRINTFORML 위원장이 사랑에 빠졌기에 증명해보았다。
        PRINTFORMW %CALLNAME:이벤트主%는【연모】를 얻었다
        RESETCOLOR
        TALENT:이벤트主:연모 = 1

		PRINTFORML 그녀가 당신의 손을 잡는다.
		PRINTFORML 그 손은 희미하게 떨리고 있다.
		PRINTFORMW 「앞으로도 잘 부탁드립니다, %CALLNAME:MASTER%」
		PRINTFORML
		PRINTFORML 자칭 라이벌은 어깨를 축 늘어뜨리고 가게를 나선다.
		PRINTFORML %CALLNAME:이벤트主%는 그를 쳐다보지도 않고 당신만을 바라보고 있다.
		PRINTFORMW 「자, 프레젠테이션을 계속할까요… 이제 필요 없겠네요」
		PRINTFORML
		PRINTFORML 그녀는 단말기를 닫는다.
		PRINTFORML 「데이터보다 이 감정을 믿기로 하겠어요」
		PRINTFORMW %CALLNAME:이벤트主%는 행복하게 미소지었다.
		PRINTFORML
		CALL EVENT_FAVUP(이벤트主,200)
		CALL EVENT_TIMER(120)
		PRINTFORML 그 후, 두 사람은 카드샵을 나섰다.
        IF 依頼_見返し中 == 0
            PRINTFORML 가게를 나설 때 점원이 말을 건다.
            PRINTFORMW 「두 분, 멋진 듀얼이었어요. 이건 서비스예요」

            PRINTFORML 점원은 수많은 카드 팩과 봉투를 건네준다.
            PRINTFORML 「실은 아까 그 친구, 이 지역 유지의 아들이라서요. 아버님께서 사과와 상금을 맡기셨어요」
            PRINTFORMW 「아들이 폐를 끼친 것에 대한 사과와 당신의 실력에 대한 칭찬의 표시라고 하더군요」

            PRINTFORML %CALLNAME:이벤트主%는 놀란 표정을 짓는다.
            PRINTFORML 「어머… 예상 밖의 전개네요」
            PRINTFORMW 「하지만 당신의 실력이 인정받은 것은 당연한 결과입니다」
        ENDIF

		PRINTFORML 두 사람은 가게를 나와 해질녘 거리를 걷는다.
		PRINTFORML %CALLNAME:이벤트主%는 당신의 팔에 살며시 손을 얹는다.
		PRINTFORMW 「오늘은… 좋은 하루였어요」
		PRINTFORML
		RETURN 2

	ELSE
		PRINTFORML 듀얼에서 패배했다.
		PRINTFORML 당신의 라이프 포인트가 0이 되자 자칭 라이벌이 승리를 외친다.
		PRINTFORMW 「됐다! 내가 이겼다!」
		PRINTFORML
		PRINTFORML 「여, 여기는 일단 도망치죠」
		PRINTFORML %CALLNAME:이벤트主%는 드물게 약한 소리를 낸다.
		PRINTFORMW 그녀는 당신의 손을 잡고 가게 뒷문으로 향한다.
		PRINTFORML
		PRINTFORML 「위원장, 기다려!」
		PRINTFORML 자칭 라이벌이 쫓아오지만 %CALLNAME:이벤트主%는 뒤돌아보지 않는다.
		PRINTFORMW 「저 사람, 정말 누구였죠…?」
		PRINTFORML
		PRINTFORML 두 사람은 어떻게든 도망쳤다.
		PRINTFORML %CALLNAME:이벤트主%는 숨을 헐떡이며 당신을 본다.
		PRINTFORMW 「죄송합니다… 제 계획 때문에 이런 일이…」
		PRINTFORML
		PRINTFORML 「다음에는 꼭 이기죠」
		PRINTFORML %CALLNAME:이벤트主%는 단말기를 조작한다.
		PRINTFORMW 「오늘 데이터를 분석해서 다음 전략을 세우겠습니다」
		PRINTFORML
		CALL EVENT_FAVUP(이벤트主,-50)
		CALL EVENT_TIMER(120)
		RETURN 3

	ENDIF

ENDIF

RETURN 1

@IRAI_ACT_402652_B(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC 이벤트主
#DIM DYNAMIC 強豪

이벤트主 = NO_TO_CHARANUM(2652)
強豪 = -1

IF 依頼_달성상황 == 0
	PRINTFORML 카드샵 앞에서 %CALLNAME:이벤트主%가 기다리고 있다.
	PRINTFORML 평소의 교복 차림이 아닌 사복 차림의 그녀는 신선하다.
	PRINTFORMW 당신을 발견하자 그녀는 작게 손을 흔든다.
	PRINTFORML
	PRINTFORML 「%CALLNAME:MASTER%, 기다리고 있었습니다」
	PRINTFORML %CALLNAME:이벤트主%는 단말기를 꺼낸다.
	PRINTFORMW 「오늘의 데이트 계획입니다. 확인해주세요」
