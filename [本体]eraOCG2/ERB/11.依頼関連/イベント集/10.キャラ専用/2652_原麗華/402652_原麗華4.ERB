@IRAI_EVENT_402652(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터
#DIM DYNAMIC 이벤트主

이벤트主 = NO_TO_CHARANUM(2652)

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
        RESULTS = (CH2652-04A)恋愛理論のプレゼン
        SIF TALENT:이벤트主:연모 > 0
		    RESULTS = (CH2652-04B)非効率な幸福の証明
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 場所_カドショ
	CASE "詳細"
		PRINTL 大会から数日後、カードショップで原麗華があなたを待っている。
		PRINTL 
		PRINTL 報酬：5000DP、お金30000、カードパック×20
	CASE "条件"
		SIF 依頼_完了횟수:302652 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:이벤트主:호감도 < 2000 && TALENT:이벤트主:연모 == 0
			RESULTS = 호감도/条件が不足しています。
			RETURN 1
		ENDIF
        IF MARK:이벤트主:반발각인 > 0
			RESULTS = 彼女の記録簿には、あなたへの不信が明記されているだろう。冷静な判断を取り戻すまで待つべきだ。
            RETURN 1
        ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

@IRAI_ACT_402652(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC 이벤트主

이벤트主 = NO_TO_CHARANUM(2652)

;開始時、연모플래그を記録する。
IF !GETBIT(依頼_進行보존:402652, 0)
    SETBIT 依頼_進行보존:402652, 0
    IF TALENT:이벤트主:연모 < 1
        CLEARBIT 依頼_進行보존:402652, 1
    ELSE
        SETBIT 依頼_進行보존:402652, 1
    ENDIF
ENDIF

IF GETBIT(依頼_進行보존:402652, 1)
    CALL IRAI_ACT_402652_B(参照)
	RETURN RESULT
ELSE
    CALL IRAI_ACT_402652_A(参照)
	RETURN RESULT
ENDIF

RETURN 1

@IRAI_REWARD_402652
CALL DP_GET(5000)
CALL MONEY_GET(5000)
CALL CARD_PACK_SHORI(20)

@IRAI_DECK_402652(듀얼리스트)
#DIMS DYNAMIC 듀얼리스트

IF 듀얼리스트 == "상대"
	RETURN 412652
ENDIF
RETURN 0

;デュエル開始時
@IRAI_DUEL_INTRO_402652

IF !GETBIT(依頼_進行보존:402652, 1)
