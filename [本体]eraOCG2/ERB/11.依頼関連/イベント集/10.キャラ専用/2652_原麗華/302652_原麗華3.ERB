	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,322652)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과条件표시 = 表側표시
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드全体",場所,"표시변경",1)
		CALL CARD_RESERV(듀얼리스트,322652)
	ENDIF
