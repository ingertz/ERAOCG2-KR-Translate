@CARD_EXPLANATION_302652(종류)
#DIM DYNAMIC 종류

PRINTL 라이프를 두 배로 하여 이 카드를 발동할 수 있다.
CALLFORM CARD_ABLE(0,常在無効)
PRINTL ①：이 카드가 마법＆함정 존에 존재하는 한,
PRINTL 필드의 모든 앞면 표시 몬스터의 효과는 무효화된다.
CALLFORM CARD_ABLE(0,ターン開始時強制)
PRINTL ②：이 카드가 앞면 표시로 존재하는 한, 자신의 스탠바이 페이즈에 상대는 1000LP를 잃는다.


@CARDCAN_302652(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성
#DIM DYNAMIC EX条件달성


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,302652)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 常在無効
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン開始時強制
	SIF ゾーン != "마함"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_302652(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 素材数
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 설정종족
#DIM DYNAMIC 選択효과
#DIMS DYNAMIC 対面者
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,302652)
	IF RESULT == 0
		CALL LIFE_CHANGE(듀얼리스트,"増加","효과",GETVAR(@"ライフ_%듀얼리스트%"))
	ENDIF
ELSEIF 종류 == 常在無効
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"無効")
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"無効",0,302652)
ELSEIF 종류 == ターン開始時強制
	CALL LIFE_CHANGE(対面者,"減少","コスト",1000)
ENDIF

