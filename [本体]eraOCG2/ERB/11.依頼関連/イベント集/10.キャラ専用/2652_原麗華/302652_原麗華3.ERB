@CARDEFFECT_342652(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 묘지送カード,5

#DIM DYNAMIC カウンタ
#DIM DYNAMIC ダメージ量
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 攻撃時誘発
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,342652)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		ダメージ量 = GETVAR(@"%対面者%_MZ_攻:(%対面者%_戦闘カード)")

		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = リローデッド・シリンダー
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1 && GETVAR(@"%듀얼리스트%_제외NG置換") == 0
			PRINTL 묘지의 리로디드 실린더를 제외합니까?
			CALL YN_CHOICE(듀얼리스트)
		ELSE
			RESULT = いいえ
		ENDIF
		IF RESULT == はい
			CALL FULLRESET
			효과条件名前 = リローデッド・シリンダー
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"묘지",ゾーン,場所)
			SIF RESULT == 1
				ダメージ量 = ダメージ量 * 2
		ENDIF
		CALL LIFE_CHANGE(듀얼리스트,"減少","효과",ダメージ量,1)

		CALL EVADE_ATTACK(듀얼리스트)
		
		CALL CARDDRAW_BASIC(듀얼리스트,2)
	ENDIF
ENDIF
