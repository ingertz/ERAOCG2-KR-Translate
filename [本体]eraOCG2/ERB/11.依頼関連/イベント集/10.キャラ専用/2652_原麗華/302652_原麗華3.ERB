@IRAI_EVENT_302652(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = (CH2652-03)자물쇠 장인의 저주
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 場所_KCスタジアム
	CASE "詳細"
		PRINTL 공식 대회의 예선 회장에서, 레이카의 상태가 이상하다.
		PRINTL 
		PRINTL 보상：3000DP、카드팩×20
	CASE "条件"
		SIF 依頼_完了횟수:202652 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:NO_TO_CHARANUM(2652):호감도 < 1000
			RESULTS = 호감도가 부족합니다
			RETURN 1
		ENDIF
		IF MARK:NO_TO_CHARANUM(2652):반발각인 > 0
			RESULTS = 그녀의 기록부에는, 당신에 대한 불신이 명기되어 있을 것이다. 냉정한 판단을 되찾을 때까지 기다려야 한다.
			RETURN 1
		ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

