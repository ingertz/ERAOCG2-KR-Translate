@IRAI_EVENT_302652(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = (CH2652-03)錠前師の呪縛
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 場所_KCスタジアム
	CASE "詳細"
		PRINTL 公式大会の予選会場で、麗華の様子がおかしい。
		PRINTL 
		PRINTL 報酬：3000DP、カードパック×20
	CASE "条件"
		SIF 依頼_完了횟수:202652 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:NO_TO_CHARANUM(2652):호감도 < 1000
			RESULTS = 호감도が不足しています
			RETURN 1
		ENDIF
		IF MARK:NO_TO_CHARANUM(2652):반발각인 > 0
			RESULTS = 彼女の記録簿には、あなたへの不信が明記されているだろう。冷静な判断を取り戻すまで待つべきだ。
			RETURN 1
		ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

