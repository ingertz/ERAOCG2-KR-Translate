@IRAI_EVENT_102652(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터
#DIM DYNAMIC 이벤트主

이벤트主 = NO_TO_CHARANUM(2652)

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = (CH2652-01)規律の庭の闖入者
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 場所_学校内
	CASE "詳細"
		PRINTL アカデミアの学園祭を参加しましょう。
		PRINTL 
		PRINTL 報酬：1500DP、カードパック×5
	CASE "条件"
		RETURN 1
	CASE "추가条件"
		IF CFLAG:이벤트主:호감도 < 100
			RESULTS = 호감도が不足しています
			RETURN 1
		ENDIF
		IF MARK:이벤트主:반발각인 > 0
			RESULTS = 彼女の記録簿には、あなたへの不信が明記されているだろう。冷静な判断を取り戻すまで待つべきだ。
			RETURN 1
		ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

