@IRAI_ACT_402641(参照)
#DIM DYNAMIC 参照

; 이벤트主
#DIM DYNAMIC 이벤트主
이벤트主 = NO_TO_CHARANUM(2641)  ; エンジェラ・カラット

; 進行보존：
; 1 = 自宅での冒頭 選択肢플래그
; 10 = Aルート（恋人未成立）告白可否（1=交際開始,2=保留）
; 21 = Aルート デュエル1 結果승리済
; 31 = 承認戦 상대選択（1=執事・帝, 2=女家庭教師・列車）
; 41 = Bルート用 記念デュエル誘い意図（任意）

IF 依頼_달성상황 == 0
    ; 自宅（即時開始）
    PRINTFORML 집의 넓은 방으로 향하는 고요한 아침. %CALLNAME:이벤트主%는 등을 꼿꼿이 펴고, 자수정 작은 상자를 소중히 안고 있다.
    PRINTFORMW 「——할머님 앞에서, 『자색의 시락(紫の試楽)』을」
    PRINTFORML 당신은, 그녀의 시선 끝에, 늠름하게 앉아 있는 할머니의 모습을 보았다.
    PRINTFORMW 「소첩의 마음, 실로 맑고, 실로 강하옵니다. 그러하기에, 듀얼로써 보이겠나이다」
    PRINTL
    PRINTL [0] - 말없이 손을 얹는다
    PRINTL [1] - 「맡겨줘. 둘이서 증명하자」고 눈으로 말한다
    PRINTL [2] - 「긴장했어?」라며 걱정하며 어깨에 손을 댄다
    BINPUT
    IF RESULT == 0
        PRINTFORML 불필요한 말은 나누지 않고, 살며시 작은 상자에 얹은 손이, 두 사람의 호흡을 맞춘다.
        PRINTFORMW %CALLNAME:이벤트主%「……감사하옵니다. 함께, 가시지요」
        依頼_進行보존:402641 = 1
        CALL EVENT_FAVUP(이벤트主,100)
    ELSEIF RESULT == 1
        PRINTFORML 당신의 시선에, %CALLNAME:이벤트主%는 부드러운 미소를 돌려주었다.
        PRINTFORMW 「이인삼각이야말로, 맹세의 증표이옵니다. ——자, 그럼」
        依頼_進行보존:402641 = 2
        CALL EVENT_FAVUP(이벤트主,120)
    ELSE
        PRINTFORML 어깨에 손을 대자, 그녀는 순간 뺨을 붉혔다.
        PRINTFORMW 「……마, 마음이 든든하옵니다. ——그럼, 예를 다하여」
        依頼_進行보존:402641 = 3
        CALL EVENT_FAVUP(이벤트主,100)
    ENDIF

    ; 동행開始
    CALL EVENT_DOUKOU(이벤트主)
    依頼_달성상황 ++
    依頼_場所:0 = 場所_リビング
    CALL EVENT_TIMER(10)

ELSEIF 依頼_달성상황 == 1
    ; 大広間：분기導入
    PRINTFORML 넓은 방에 자색 천이 깔리고, 고요한 공기가 감돈다. 할머니의 눈은 엄하면서도 따뜻하다.
    IF TALENT:NO_TO_CHARANUM(2641):연모 == 0
        PRINTFORMW 할머니「우선 너희 두 사람, 서로를 마주 보아라. 마음이 진실하다면, 승리로써 증명해 보이거라」
        PRINTFORML %CALLNAME:이벤트主%는 당신을 향해 돌아서서, 깊이 예를 올렸다.
        PRINTFORMW 「서로의 이해를 확인하기 위한 진검승부……자, 실례하겠사옵니다」
        ; Aルート デュエル1：あなた vs カラット（クリフォート）
        依頼_進行보존:402641 = 20
        TARGET = 이벤트主
        CALL CHOICE_DUEL_TYPE(402641)
        IF RESULT == 1
            PRINTFORML 「그런 적 없었사옵니다」
            SETCOLOR C_PINK
            PRINTFORMW %CALLNAME:이벤트主%는 마음에 무언가 정한 듯하다…
            PRINTFORMW %CALLNAME:이벤트主%は【연모】を得た
            TALENT:NO_TO_CHARANUM(2641):연모 = 1
            RESETCOLOR
            PRINTFORML %CALLNAME:이벤트主%는 조용히 숨을 내쉬고, 무릎을 꿇고 고개를 숙였다.
            PRINTFORMW 「소첩의 마음, 이제 더는 숨길 수 없사옵니다. ——당신을, 실로 사랑스럽게 생각하고 있사옵니다」
            PRINTL
            PRINTL [0] - 교제를 시작한다
            PRINTL [1] - 답변을 보류한다
            BINPUT
            IF RESULT == 0
                PRINTFORML 살며시 고개를 끄덕이는 당신에게, 그녀의 눈동자가 반짝인다.
                PRINTFORMW 「……앞으로도, 손을 맞잡고 함께 가시지요」
                依頼_進行보존:402641 = 10
                CALL EVENT_FAVUP(이벤트主,200)
            ELSE
                PRINTFORML 당신은 신중하게 시간을 요청한다. %CALLNAME:이벤트主%는 미소 지으며, 고개를 끄덕였다.
                PRINTFORMW 「서두르는 것은 예의에 어긋나옵니다. 때가 되면, 다시——」
                依頼_進行보존:402641 = 11
            ENDIF
            依頼_달성상황 ++
            依頼_場所:0 = 場所_リビング
            CALL EVENT_TIMER(30)
        ELSE
            ; 패배분기：再戦可の励まし
            PRINTFORML 져버렸다…
            PRINTFORML %CALLNAME:이벤트主%는 당신을 부축해 일으키며, 작은 목소리로 속삭인다.
            PRINTFORMW 「——아직 끝이 아니옵니다. 마음을 갈고닦아, 다시 반상에 서시지요」
            RETURN 3
        ENDIF
    ELSE
        ; Bルート（연모済）
        PRINTFORMW 할머니「이미 마음은 맺어졌는가. 그렇다면…」
        依頼_달성상황 = 2
        GOTO BATTLE2
    ENDIF

ELSEIF 依頼_달성상황 == 2
    $BATTLE2
    ; 承認戦：A/B共通。祖母の指南役ペアとの「二人三脚」の証明。
    PRINTFORMW 할머니「이인삼각이야말로, 맹세의 증표이니라. 지도역들, 상대를 하거라」
    PRINTFORML 집사 코노스와, 가정교사 키엔이 나선다. 어느 쪽과 맞붙을지 선택할 수 있는 것 같다.
    PRINTFORMW %CALLNAME:이벤트主%「——상대를 가리는 것은 멋이 없사옵니다. 허나 책략도 예절의 일부이옵니다」

    IF TALENT:NO_TO_CHARANUM(2641):연모 == 0
        IF 依頼_進行보존:402641 == 11
            ; 告白保留した場合の少し厳しめの空気
            PRINTFORMW 코노스「아가씨를 거절하다니, 생각할 수 없도다!」
            PRINTFORML 키엔「오해를 풀려면, 반상에서 이야기하는 수밖에 없겠지」
            PRINTFORMW %CALLNAME:이벤트主%「……무례는 알고 있사옵니다. 언젠가 바르게 전할 것이오니, 지금은 승리로써 답하고 싶사옵니다」
        ELSE
            PRINTFORMW %CALLNAME:이벤트主%「예를 다하여, 함께 승리를 거머쥐시지요」
        ENDIF
    ELSE
        PRINTFORMW %CALLNAME:이벤트主%「서로 등을 맡기시지요. ——실로 든든하옵니다」
    ENDIF

    PRINTL
    PRINTL [0] - 집사 코노스와 싸운다
    PRINTL [1] - 가정교사 키엔과 싸운다
    BINPUT
    IF RESULT == 0
        依頼_進行보존:402641 = 31
        PRINTFORML 코노스「알겠사옵니다. 상대를 해드리겠소이다」
        PRINTFORMW %CALLNAME:이벤트主%「훌륭하게, 보여드리겠사옵니다」
    ELSE
        依頼_進行보존:402641 = 32
        PRINTFORML 키엔「그럼, 예의의 무대로」
        PRINTFORMW %CALLNAME:이벤트主%「가시지요」
    ENDIF

    TARGET = -1
    CALL CHOICE_DUEL_TYPE(402641)
    IF RESULT == 1
        PRINTFORML 지도역은 씁쓸한 얼굴로 고개를 끄덕였다. 「두 사람의 보조, 확실히 지켜보았노라」
        PRINTFORMW %CALLNAME:이벤트主%「할머님——이것으로, 『자색의 시락』의 답을」
        依頼_달성상황 ++
        依頼_場所:0 = 場所_リビング
        CALL EVENT_TIMER(5)
    ELSE
        PRINTFORML %CALLNAME:이벤트主%는 당신의 손을 잡고, 가볍게 쥔다.
        PRINTFORMW 「아픔은 지금뿐. 승리의 길은, 반드시 보일 것이옵니다. ——다시 한번, 도전하시지요」
        RETURN 3
    ENDIF

ELSEIF 依頼_달성상황 == 3
    ; Bルート限定：エキシビション（任意） あなた vs カラット（これまでの歩みを確かめる）
    IF TALENT:NO_TO_CHARANUM(2641):연모 > 0 && 依頼_進行보존:402641 != 10
        PRINTFORML %CALLNAME:이벤트主%는 한 걸음 나아가, 부채를 닫는 동작으로 당신을 가리킨다.
        PRINTFORMW 「지금까지의 발자취, 실로 고귀하옵니다——그러니 벗도 사랑도, 반상에서 확인하시지요」
        PRINTL
        PRINTL [0] - 기념으로 한판, 받아들이겠다
        PRINTL [1] - 지금은 할머니의 인정을 먼저 (스킵)
        BINPUT
        IF RESULT == 0
            依頼_進行보존:402641 = 41
            TARGET = 이벤트主
            CALL CHOICE_DUEL_TYPE(402641)
            IF RESULT == 1
                PRINTFORML %CALLNAME:이벤트主%「……역시, 당신은 눈부시옵니다」
                PRINTFORMW 「허나, 그것이 기뻐서 견딜 수가 없사옵니다」
                CALL EVENT_FAVUP(이벤트主,500)
            ELSE
                PRINTFORML %CALLNAME:이벤트主%는 미소 지으며 손을 내밀었다.
                PRINTFORMW 「승패는 색채일 뿐. ——오늘 밤의 추억으로 가슴에 장식하시지요」
            ENDIF
        ELSE
            PRINTFORML %CALLNAME:이벤트主%「알겠사옵니다. 중요한 것은 인정, 순서를 어겨서는 아니 되옵니다」
            PRINTFORMW 
        ENDIF
    ENDIF

    ; 共通結末——祖母の承認、紫水晶の誓い
    PRINTFORMW 할머니의 시선이, 조용히 고한다.
    PRINTFORML 「예와 정, 두 바퀴가 갖추어져야만 수레바퀴 자국은 곧게 나느니라」
    PRINTFORMW 「인정하마. ——두 사람이 함께 걷는 것을」
    PRINTFORML %CALLNAME:이벤트主%는 자수정 작은 상자를 내민다. 뚜껑 안쪽, 희미하게 빛나는 자수정이 흔들린다.
    PRINTFORMW 당신은 작은 상자에 손을 얹고, %CALLNAME:이벤트主%와 손끝을 겹쳤다.

    PRINTFORML %CALLNAME:이벤트主%「…감사하옵니다. 반드시, 행복을 만들어가겠나이다」
    PRINTFORMW 자수정의 반짝임은, 두 사람의 미래를 조용히 비추고 있었다.

    RETURN 2
ENDIF

RETURN 1

@IRAI_REWARD_402641
CALL DP_GET(8000)
CALL MONEY_GET(20000)

@IRAI_DECK_402641(듀얼리스트)
#DIMS DYNAMIC 듀얼리스트
IF 듀얼리스트 == "상대"
    ; シーンに応じて상대IDを返す。ここでは便宜上：
    ; クリフォート使い（カラット）= 本人・強化版(422641)
    ; 執事（帝） = 402641
    ; 家庭教師（列車） = 412641
    IF 依頼_進行보존:402641 == 20 || 依頼_進行보존:402641 == 41
        RETURN 422641
    ELSEIF 依頼_進行보존:402641 == 31
        RETURN 402641
    ELSEIF 依頼_進行보존:402641 == 32
        RETURN 412641
    ENDIF
    RETURN 0
ENDIF
RETURN 0

