@IRAI_EVENT_402641(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
    CASE "名前"
        RESULTS = (CH2641-04)자수정의 맹세
    CASE "이벤트種"
        RETURN 이벤트_通常
    CASE "依頼先"
        ; 即時開始（自宅）
        RETURN 即時開始
    CASE "詳細"
        PRINTL 자수정 작은 상자에 숨겨진 「자색의 시락(紫の試楽)」.
        PRINTL 넓은 방에서의 진검승부, 지금 펼쳐진다——
        PRINTL
        PRINTL 報酬：8000DP、お金20000
    CASE "条件"
        ; 前置任務クリア판정
        SIF 依頼_完了횟수:302641 == 0
            RETURN 0
        RETURN 1
    CASE "추가条件"
        ; 호감도2000以上 または 既に연모
        IF CFLAG:NO_TO_CHARANUM(2641):호감도 < 2000 && TALENT:NO_TO_CHARANUM(2641):연모 == 0
            RESULTS = 호감도/조건이 부족합니다.
            RETURN 1
        ENDIF
        IF MARK:NO_TO_CHARANUM(2641):반발각인 > 0
            RESULTS = 심기가 불편하신 듯하니, 초대를 보류하는 것이 좋을지도 모릅니다.
            RETURN 1
        ENDIF
        RETURN 0
    CASE "回想可"
        RETURN 1
ENDSELECT

RETURN 0

