; 202641_エンジェラ・カラット2.ERB
; 任務2：仮面の令嬢、夜会デュエル
; 人物ID：2641
; 任務ID：202641

@IRAI_EVENT_202641(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = (CH2641-02)仮面の令嬢、夜会デュエル
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		PRINTL 商店街の夜祭りで、即席のデュエル会が開かれているという。
		PRINTL 仮面で身分を伏せた令嬢が、あなたに「温習」を所望する——。
		PRINTL 
		PRINTL 報酬：2000DP、お金？
	CASE "条件"
		SIF 依頼_完了횟수:102641 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:NO_TO_CHARANUM(2641):호감도 < 500
			RESULTS = 호감도が不足しています
			RETURN 1
		ENDIF
		IF MARK:NO_TO_CHARANUM(2641):반발각인 > 0
			RESULTS = お嬢様はご立腹のご様子。時を置き、機嫌を直してから参りましょう。
			RETURN 1
		ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0


@IRAI_ACT_202641(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC 이벤트主

이벤트主 = NO_TO_CHARANUM(2641)

IF 依頼_달성상황 == 0
	; 即時開始なので主人公の家（リビングなど）で導入
	PRINTFORML 夜がふけ、遠くから賑やかな音頭と笑い声が聞こえてくる。
	PRINTFORMW 商店街の夜祭りが始まったようだ。即席のデュエル会もあるらしい。
	PRINTFORML 「仮初の仮面も、礼節は真なり。温習をお願いできまして？」——
	PRINTFORMW そんな雅なうわさが、あなたの耳に入る。
	PRINTFORML 体をほぐすにはちょうどいい。夜の灯りに導かれ、あなたは腰を上げた。
	PRINTFORMW 祭り会場へ向かおう。
	依頼_달성상황 ++
	依頼_場所 = 場所_商店街

ELSEIF 依頼_달성상황 == 1
	依頼_場所 = 場所_商店街

	IF TIME > KANTAN_TIME(20,00)
			PRINTFORMW さすがにこの時間では店が閉まってるだろう。
			PRINTFORMW 日を改めて向かうとしよう。
			RETURN 3
	ENDIF

	PRINTFORML 提灯が揺れ、香ばしい屋台の匂いが路地に満ちる。
	PRINTFORMW 即席デュエル会の人だかりの向こうに、仮面の令嬢が一礼した。
	PRINTFORML 仮面の令嬢「雅やかなりし夜、わらわの実力、いささか披露つかまつりましょう」
	PRINTFORMW 視線が交わる。%CALLNAME:이벤트主%だと、あなたはすぐに気づいた。
	PRINTFORML 仮面の令嬢「……仮初なれど、礼節は真。温習（ウォームアップ）、お付き合いくださる？」
	PRINTL
	PRINTL [0] - 「手合わせ、喜んで受ける」
	PRINTL [1] - 「観客への礼を述べ、静かに受ける」
	PRINTL [2] - 「少し準備を……それでも受ける」
	BINPUT

	IF RESULT == 0
		PRINTFORML あなたは頷き、デュエルディスクを掲げた。
		PRINTFORMW 仮面の令嬢は目元だけで微笑み、そっと会釈する。
		CALL EVENT_FAVUP(이벤트主,50)
	ELSEIF RESULT == 1
		PRINTFORML あなたは周囲へ一礼し、挑戦を受ける旨を示した。
		PRINTFORMW 仮面の令嬢は만족げに扇を閉じる仕草を見せる。
		CALL EVENT_FAVUP(이벤트主,30)
	ELSE
		PRINTFORML あなたは手首のバンドを確かめ、軽く深呼吸して構えた。
		PRINTFORMW 仮面の令嬢は「用意周到、良きこと」と小さく囁く。
		CALL EVENT_FAVUP(이벤트主,20)
	ENDIF

	PRINTFORML 審判役のボランティアがステージ中央を開ける。
	PRINTFORMW 「エキシビション——開幕前の手合わせ、開始！」

	; デュエル開始
	CALL EVENT_TIMER(2)
	TARGET = 이벤트主
	CALL CHOICE_DUEL_TYPE(202641)

	; 勝敗분기
	IF RESULT == 1
		; 승리
		PRINTFORML 「見事……機殻の規律、なおも研鑽の余地ありと知る。愉快愉快」
		PRINTFORMW 令嬢は潔く拍手を送り、観客からも歓声が上がった。
		IF 依頼_見返し中 == 0
			PRINTFORML 主催者「素晴らしい試合だった！出場謝礼だ、受け取ってくれ」
			PRINTFORMW 受け取った封筒は、ずしりと心地よい重みがあった。（所持金+10000）
			CALL MONEY_GET(10000)
			CALL EVENT_FAVUP(이벤트主,100)
		ENDIF
	ELSE
		; 패배
		PRINTFORML 「ふふ……けれど、ただ負かすのみは興なきもの。次は、より雅やかに参りましょう」
		PRINTFORMW 令嬢は勝者の気負いを見せず、丁寧に一礼した。拍手が温かく降り注ぐ。
		IF 依頼_見返し中 == 0
			PRINTFORML 主催者「見応えがあった！エキシビションの謝礼だ、受け取ってくれ」
			PRINTFORMW 受け取った封筒は、ずしりと心地よい重みがあった。（所持金+5000）
			CALL MONEY_GET(5000)
		ENDIF
	ENDIF

	; 手合わせ後（勝敗不問）
	PRINTFORML 仮面の令嬢「さて、まずはカードを愛でること、これ肝要にてよ」
	PRINTFORMW 令嬢は子どもたちにスリーブの扱いとシャッフルの礼節を、ひとつひとつ丁寧に教えはじめた。
	PRINTFORML 子ども「わぁ、きれい……！」「ボクもこうやって持つ！」
	PRINTFORMW あなたは横で手伝いながら、その所作の美しさに見入った。
	SIF 依頼_見返し中 == 0
		CALL EVENT_FAVUP(이벤트主,50)

	PRINTL
	PRINTL [0] - 「仮面の令嬢と夜会を連れ歩く」
	PRINTL [1] - 「ここで静かに見送る」
	BINPUT

	IF RESULT == 0
		PRINTFORML 令嬢は仮面越しに、少し照れたように小首を傾げた。
		PRINTFORMW 「では、月下の散策——お供、願いましょう」
		SIF 依頼_見返し中 == 0
			CALL EVENT_FAVUP(이벤트主,120)
		依頼_進行보존:202641 = 1
		PRINTFORML 並んで歩く間、他愛ない会話が続く。祭囃子が遠くなる。
		PRINTFORMW 夜会の灯りに、仮面の陰が柔らかく揺れた。
		CALL EVENT_TIMER(120)
	ELSE
		PRINTFORML あなたはそっと頭を下げ、令嬢の所作を邪魔しないよう離れた。
		PRINTFORMW 「礼節を尽くす背、まこと見目麗し。……また、いずれ」
		SIF 依頼_見返し中 == 0
			CALL EVENT_FAVUP(이벤트主,30)
		CALL EVENT_TIMER(60)
	ENDIF

	RETURN 2
ENDIF

RETURN 1


@IRAI_REWARD_202641
CALL DP_GET(2000)

@IRAI_DECK_202641(듀얼리스트)
#DIMS DYNAMIC 듀얼리스트

SIF 듀얼리스트 == "상대"
	RETURN 2641
RETURN 0

; デュエル開始時の導入
@IRAI_DUEL_INTRO_202641
PRINTFORML 
PRINTFORML 仮面の令嬢「いざ、機殻の規律、示してさしあげますわ」
PRINTFORMW 
