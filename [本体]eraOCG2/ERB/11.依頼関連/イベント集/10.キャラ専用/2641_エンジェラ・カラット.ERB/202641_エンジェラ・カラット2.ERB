; 202641_エンジェラ・カラット2.ERB
; 任務2：仮面の令嬢、夜会デュエル
; 人物ID：2641
; 任務ID：202641

@IRAI_EVENT_202641(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = (CH2641-02)가면 쓴 아가씨, 야회 듀얼
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		PRINTL 상점가의 밤 축제에서, 즉석 듀얼 대회가 열리고 있다고 한다.
		PRINTL 가면으로 신분을 숨긴 아가씨가, 당신에게 「연습」을 청한다——.
		PRINTL 
		PRINTL 보상：2000DP、돈？
	CASE "条件"
		SIF 依頼_完了횟수:102641 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:NO_TO_CHARANUM(2641):호감도 < 500
			RESULTS = 호감도가 부족합니다
			RETURN 1
		ENDIF
		IF MARK:NO_TO_CHARANUM(2641):반발각인 > 0
			RESULTS = 아가씨께서 화가 나신 모양입니다. 시간을 두고, 기분이 풀리면 다시 찾아뵙도록 하죠.
			RETURN 1
		ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0


@IRAI_ACT_202641(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC 이벤트主

이벤트主 = NO_TO_CHARANUM(2641)

IF 依頼_달성상황 == 0
	; 即時開始なので主人公の家（リビングなど）で導入
	PRINTFORML 밤이 깊어지고, 멀리서 떠들썩한 노랫소리와 웃음소리가 들려온다.
	PRINTFORMW 상점가의 밤 축제가 시작된 모양이다. 즉석 듀얼 대회도 있다고 한다.
	PRINTFORML 「임시 가면이라도, 예절은 진심이옵니다. 연습을 부탁드려도 되겠사옵니까?」——
	PRINTFORMW 그런 우아한 소문이, 당신의 귀에 들어온다.
	PRINTFORML 몸을 풀기에는 안성맞춤이다. 밤의 등불에 이끌려, 당신은 자리에서 일어났다.
	PRINTFORMW 축제장으로 향하자.
	依頼_달성상황 ++
	依頼_場所 = 場所_商店街

ELSEIF 依頼_달성상황 == 1
	依頼_場所 = 場所_商店街

	IF TIME > KANTAN_TIME(20,00)
			PRINTFORMW 아무래도 이 시간에는 가게가 닫혀 있겠지.
			PRINTFORMW 날을 다시 잡아 가도록 하자.
			RETURN 3
	ENDIF

	PRINTFORML 등불이 흔들리고, 고소한 포장마차 냄새가 골목에 가득하다.
	PRINTFORMW 즉석 듀얼 대회의 인파 너머로, 가면을 쓴 아가씨가 절을 했다.
	PRINTFORML 가면 쓴 아가씨「우아한 밤, 소첩의 실력을, 조금이나마 보여드리겠사옵니다」
	PRINTFORMW 시선이 마주친다. %CALLNAME:이벤트主%라는 것을, 당신은 바로 알아차렸다.
	PRINTFORML 가면 쓴 아가씨「……임시방편이오나, 예절은 진심이옵니다. 연습(웜업), 함께 해주시겠사옵니까?」
	PRINTL
	PRINTL [0] - 「대결, 기꺼이 받아들이지」
	PRINTL [1] - 「관객에게 예를 표하고, 조용히 받아들인다」
	PRINTL [2] - 「조금 준비를…… 그래도 받아들인다」
	BINPUT

	IF RESULT == 0
		PRINTFORML 당신은 고개를 끄덕이고, 듀얼 디스크를 들어 올렸다.
		PRINTFORMW 가면 쓴 아가씨는 눈가만으로 미소 지으며, 살며시 고개를 숙인다.
		CALL EVENT_FAVUP(이벤트主,50)
	ELSEIF RESULT == 1
		PRINTFORML 당신은 주위에 한 번 절하고, 도전을 받아들이겠다는 뜻을 보였다.
		PRINTFORMW 가면 쓴 아가씨는 만족스러운 듯 부채를 닫는 시늉을 보인다.
		CALL EVENT_FAVUP(이벤트主,30)
	ELSE
		PRINTFORML 당신은 손목의 밴드를 확인하고, 가볍게 심호흡하며 자세를 잡았다.
		PRINTFORMW 가면 쓴 아가씨는 「준비가 철저하군요, 좋은 일이옵니다」라고 작게 속삭인다.
		CALL EVENT_FAVUP(이벤트主,20)
	ENDIF

	PRINTFORML 심판 역할의 자원봉사자가 무대 중앙을 비운다.
	PRINTFORMW 「엑시비션——개막 전의 대결, 개시!」

	; デュエル開始
	CALL EVENT_TIMER(2)
	TARGET = 이벤트主
	CALL CHOICE_DUEL_TYPE(202641)

	; 勝敗분기
	IF RESULT == 1
		; 승리
		PRINTFORML 「훌륭하옵니다…… 기각의 규율, 여전히 연마할 여지가 있음을 알았사옵니다. 유쾌, 유쾌」
		PRINTFORMW 아가씨는 깨끗하게 박수를 보냈고, 관객들에게서도 환호성이 터져 나왔다.
		IF 依頼_見返し中 == 0
			PRINTFORML 주최자「훌륭한 시합이었다! 출전 사례금이네, 받아주게나」
			PRINTFORMW 받은 봉투는, 묵직하고 기분 좋은 무게였다. (소지금+10000)
			CALL MONEY_GET(10000)
			CALL EVENT_FAVUP(이벤트主,100)
		ENDIF
	ELSE
		; 패배
		PRINTFORML 「후후…… 허나, 그저 이기기만 하는 것은 재미없는 일. 다음에는, 더욱 우아하게 임하겠사옵니다」
		PRINTFORMW 아가씨는 승자의 거만함을 보이지 않고, 정중하게 한 번 절했다. 박수가 따뜻하게 쏟아진다.
		IF 依頼_見返し中 == 0
			PRINTFORML 주최자「볼만했다! 엑시비션 사례금이네, 받아주게나」
			PRINTFORMW 받은 봉투는, 묵직하고 기분 좋은 무게였다. (소지금+5000)
			CALL MONEY_GET(5000)
		ENDIF
	ENDIF

	; 手合わせ後（勝敗不問）
	PRINTFORML 가면 쓴 아가씨「자, 우선은 카드를 아끼는 것, 이것이 중요하옵니다」
	PRINTFORMW 아가씨는 아이들에게 슬리브 취급법과 셔플 예절을, 하나하나 정성껏 가르치기 시작했다.
	PRINTFORML 아이「와아, 예쁘다……!」「나도 이렇게 잡을래!」
	PRINTFORMW 당신은 옆에서 도우면서, 그 몸짓의 아름다움에 넋을 잃었다.
	SIF 依頼_見返し中 == 0
		CALL EVENT_FAVUP(이벤트主,50)

	PRINTL
	PRINTL [0] - 「가면 쓴 아가씨와 밤 축제를 거닌다」
	PRINTL [1] - 「여기서 조용히 배웅한다」
	BINPUT

	IF RESULT == 0
		PRINTFORML 아가씨는 가면 너머로, 조금 부끄러운 듯 고개를 갸웃거렸다.
		PRINTFORMW 「그럼, 달빛 아래의 산책——동행을, 부탁드리겠사옵니다」
		SIF 依頼_見返し中 == 0
			CALL EVENT_FAVUP(이벤트主,120)
		依頼_進行보존:202641 = 1
		PRINTFORML 나란히 걷는 동안, 시시콜콜한 대화가 이어진다. 축제 음악 소리가 멀어진다.
		PRINTFORMW 밤 축제의 등불에, 가면의 그림자가 부드럽게 흔들렸다.
		CALL EVENT_TIMER(120)
	ELSE
		PRINTFORML 당신은 살며시 고개를 숙이고, 아가씨의 몸짓을 방해하지 않도록 자리를 떴다.
		PRINTFORMW 「예절을 다하는 뒷모습, 참으로 아름답사옵니다. ……또, 언젠가」
		SIF 依頼_見返し中 == 0
			CALL EVENT_FAVUP(이벤트主,30)
		CALL EVENT_TIMER(60)
	ENDIF

	RETURN 2
ENDIF

RETURN 1


@IRAI_REWARD_202641
CALL DP_GET(2000)

@IRAI_DECK_202641(듀얼리스트)
#DIMS DYNAMIC 듀얼리스트

SIF 듀얼리스트 == "상대"
	RETURN 2641
RETURN 0

; デュエル開始時の導入
@IRAI_DUEL_INTRO_202641
PRINTFORML 
PRINTFORML 가면 쓴 아가씨「자, 기각의 규율을, 보여드리겠사옵니다」
PRINTFORMW 
