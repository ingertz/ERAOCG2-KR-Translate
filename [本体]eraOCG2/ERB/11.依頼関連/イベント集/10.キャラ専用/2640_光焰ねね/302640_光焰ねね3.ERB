@CARD_EXPLANATION_172931(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 카드는 1턴에 1장밖에 발동할 수 없다.
CALL CARD_ABLE(1,마함起動 ,손패起動)
PRINTL ①: 주사위를 1개 굴려, 그 눈에 따라 이하의 효과를 적용한다.
PRINTL ●1: 묘지에서 "탐욕의 주사위" 이외의 "다이스" 카드 1장을 선택하여 패에 넣는다.
PRINTL ●2, 3: 덱에서 1장 드로우하고, 패를 1장 묘지에 보낸다.
PRINTL ●4, 5: 덱에서 1장 드로우한다.
PRINTL ●6: 덱에서 2장 드로우한다.
PRINTL 

@CARDCAN_172931(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72931)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,72931)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF



@CARDEFFECT_172931(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC サイコロ結果
#DIM DYNAMIC 攻撃力修正


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

;EX덱에서 直出し
;参考：마법族の里、フラワリング・エトワール、해피・チャネラー

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72931,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL DICE_ROLL_NENE(듀얼리스트,1)
		サイコロ結果 = RESULT
		PRINTFORMW 나온 눈은……{サイコロ結果}다!

		IF サイコロ結果 == 1
		PRINTFORMW 회수 효과다!
			CALL FULLRESET
			효과条件カテゴリ = 다이스
			효과条件固名前 = 탐욕의주사위
			CALL CARD_ADD_BASIC(듀얼리스트,"묘지",ゾーン,場所)
		ELSEIF サイコロ結果 == 3 || サイコロ結果 == 2
			PRINTFORMW １장 회수다！
			CALL CARDDRAW_BASIC(듀얼리스트,1)
			CALL FULLRESET
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
		ELSEIF サイコロ結果 == 4 || サイコロ結果 == 5
			PRINTFORMW 1장 드로우다!
			CALL CARDDRAW_BASIC(듀얼리스트,1)
		ELSEIF サイコロ結果 == 6
			PRINTFORMW ２장 드로우다！！！
			CALL CARDDRAW_BASIC(듀얼리스트,2)
		ENDIF 
	ENDIF
ENDIF

@DICE_ROLL_NENE(듀얼리스트,다이스数)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 다이스数
#DIM DYNAMIC 다이스結果
#DIM DYNAMIC 다이스合計
#DIM DYNAMIC ロール数

PRINTFORML 다이스롤

$RE_ROLL
PRINTL 무언가의 힘을 느낀다…
다이스結果 = 6
PRINTL ┌───┐
PRINTL │●●●│
PRINTL │＜◎＞│
PRINTL │●●●│
PRINTL └───┘
PRINTL ！？！？！？！？
PRINTL 으, 어쨌든 결과를 6으로 처리할까나?

SETVAR @"%듀얼리스트%_다이스使用_保", 1
다이스合計 += 다이스結果
다이스合計 += 다이스結果
ロール数 ++
CALL CARD_FIN_DICE_SET(듀얼리스트,다이스結果)

PRINTW
SIF ロール数 < 다이스数
	GOTO RE_ROLL

RESULT:1 = 다이스合計
RETURN 다이스結果