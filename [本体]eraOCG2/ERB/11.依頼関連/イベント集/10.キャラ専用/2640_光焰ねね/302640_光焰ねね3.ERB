@CARD_EXPLANATION_172931(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 카드는 １턴에 １장밖에 발동할 수 없다。
CALL CARD_ABLE(1,마함起動 ,손패起動)
PRINTL ①：サイコロを１つ振り、その出目によって以下の효과を適用する。
PRINTL ●１：묘지에서 "強欲なサイコロ」以外の「ダイス」카드 １장을 選んで손패に加える。
PRINTL ●２，３：덱에서 １枚ドローして、손패を１枚묘지に送る。
PRINTL ●４，５：덱에서 １장 드로우한다。
PRINTL ●６：덱에서 ２枚ドローする。
PRINTL 

@CARDCAN_172931(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72931)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,72931)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF



@CARDEFFECT_172931(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC サイコロ結果
#DIM DYNAMIC 攻撃力修正


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

;EX덱에서 直出し
;参考：마법族の里、フラワリング・エトワール、ハーピィ・チャネラー

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72931,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL DICE_ROLL_NENE(듀얼리스트,1)
		サイコロ結果 = RESULT
		PRINTFORMW 出た目は……{サイコロ結果}だ！

		IF サイコロ結果 == 1
		PRINTFORMW 回収효과だ！
			CALL FULLRESET
			효과条件カテゴリ = ダイス
			효과条件固名前 = 強欲なサイコロ
			CALL CARD_ADD_BASIC(듀얼리스트,"묘지",ゾーン,場所)
		ELSEIF サイコロ結果 == 3 || サイコロ結果 == 2
			PRINTFORMW １枚ルーティングだ！
			CALL CARDDRAW_BASIC(듀얼리스트,1)
			CALL FULLRESET
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
		ELSEIF サイコロ結果 == 4 || サイコロ結果 == 5
			PRINTFORMW １枚ドローだ！
			CALL CARDDRAW_BASIC(듀얼리스트,1)
		ELSEIF サイコロ結果 == 6
			PRINTFORMW ２枚ドローだ！！！
			CALL CARDDRAW_BASIC(듀얼리스트,2)
		ENDIF 
	ENDIF
ENDIF

@DICE_ROLL_NENE(듀얼리스트,ダイス数)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC ダイス数
#DIM DYNAMIC ダイス結果
#DIM DYNAMIC ダイス合計
#DIM DYNAMIC ロール数

PRINTFORML ダイスロール

$RE_ROLL
PRINTL 何かの力を感じる…
ダイス結果 = 6
PRINTL ┌───┐
PRINTL │●●●│
PRINTL │＜◎＞│
PRINTL │●●●│
PRINTL └───┘
PRINTL ！？！？！？！？
PRINTL と、とにかく結果を6で処理しようかな？

SETVAR @"%듀얼리스트%_ダイス使用_保", 1
ダイス合計 += ダイス結果
ロール数 ++
CALL CARD_FIN_DICE_SET(듀얼리스트,ダイス結果)

PRINTW
SIF ロール数 < ダイス数
	GOTO RE_ROLL

RESULT:1 = ダイス合計
RETURN ダイス結果