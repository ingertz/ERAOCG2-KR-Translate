@IRAI_EVENT_302640(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = (CH2640-03)シャドールの試練
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		PRINTL
		PRINTL ねねが新しい덱【シャドール】の使い方に悩んでいる。
		PRINTL 彼女と特訓デュエルを行い、덱の完成度を高めてあげよう。
		PRINTL
		PRINTL 報酬：5000DP
	CASE "条件"
		SIF 依頼_完了횟수:202640 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:NO_TO_CHARANUM(2640):호감도 < 1000
            RESULTS = 호감도が不足しています
            RETURN 1
        ENDIF
		IF MARK:NO_TO_CHARANUM(2640):반발각인 > 0
			RESULTS = 怒っているようです。분노が収まるまで待ちましょう。
			RETURN 1
		ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

@IRAI_ACT_302640(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC 이벤트主

이벤트主 = NO_TO_CHARANUM(2640)

IF 依頼_달성상황 == 0
	; 自宅での導入（即時開始）
	PRINTFORML 玄関のチャイムが鳴った。
	PRINTFORMW 扉を開けると、どこか決意を宿した%CALLNAME:이벤트主%が立っている。
	PRINTFORML 「%CALLNAME:MASTER%……少し、時間いいかな？」
	PRINTFORMW %CALLNAME:이벤트主%は小さく頭を下げ、リビングへと通された。
	PRINTFORML 「あなたにだけは、本当のことを話したいの」
	PRINTFORMW 「最近、謎の人から【シャドール】の덱を託されたんだ。でも、上手く使いこなせなくて……」
	PRINTFORML 「この덱には、なにか“秘密”がある気がする」
	PRINTFORMW 「怖いけど……%CALLNAME:MASTER%となら、向き合えるかもしれない」
	PRINTFORML %CALLNAME:이벤트主%は手にしたカードをぎゅっと握りしめ、あなたを真っ直ぐに見つめた。
	PRINTFORMW 「お願い。特訓、付き合ってくれる？」
	PRINTL
	PRINTL [0] - 「一緒に掴もう、シャドールの真価」
	PRINTL [1] - 「無理はしない。少しずつ慣れていこう」
	PRINTL [2] - 黙って頷き、手を差し伸べる
	BINPUT
	IF RESULT == 0
		PRINTFORML あなたは力強く頷き、%CALLNAME:이벤트主%の手元の덱ケースをそっと支えた。
		PRINTFORMW %CALLNAME:이벤트主%の頬に安堵と高揚が混ざった笑みが灯る。
		CALL EVENT_FAVUP(이벤트主,150)
		依頼_進行보존:302640 = 1
	ELSEIF RESULT == 1
		PRINTFORML あなたは焦らず段階を踏むべきだと伝える。
		PRINTFORMW %CALLNAME:이벤트主%は深呼吸し、「うん、隣にいてね」と小さく頷いた。
		CALL EVENT_FAVUP(이벤트主,50)
		依頼_進行보존:302640 = 2
	ELSE
		PRINTFORML あなたは言葉より先に行動で示した。
		PRINTFORMW 手を差し出すと、%CALLNAME:이벤트主%は迷いを振りほどくようにその手を取った。
		CALL EVENT_FAVUP(이벤트主,100)
		依頼_進行보존:302640 = 3
	ENDIF
	PRINTFORML 「……ありがとう」
	PRINTFORMW 「それじゃ、リビングで始めよう。%CALLNAME:MASTER%がいてくれるなら、きっと大丈夫」
	依頼_달성상황 ++
	; 次フェーズの場所（自宅リビングで続行）
	依頼_場所 = 場所_リビング
ELSEIF 依頼_달성상황 == 1
	; デュエル開始と中盤演出
	PRINTFORML %CALLNAME:이벤트主%はデュエルディスクを起動し、静かに構えを取る。
	PRINTFORMW 「見ててね。私も、この덱も、もう逃げないから」
	PRINTFORML 彼女の周囲で、どこか影が揺らめいた気がした。
	PRINTFORMW あなたは胸のうちで覚悟を固め、対峙する。
	PRINTFORML
	PRINTFORMW 「デュエル、開始！」

	TARGET = 이벤트主
	CALL CHOICE_DUEL_TYPE(302640)

	; 勝ち負け不問
	; デュエル後の展開
	PRINTFORML %CALLNAME:이벤트主%の【シャドール】が、戦いの最中に真価を垣間見せた。
	PRINTFORMW 同時に、彼女の身の回りで小さな不具合や不運が連鎖する。
	PRINTFORML 「やっぱり……私の不運、ただの体質じゃないのかも」
	PRINTFORMW 「この力の副作用……そんな感じがするの」
	PRINTFORML あなたは彼女の不安を受け止め、落ち着くように合図する。
	PRINTFORMW %CALLNAME:이벤트主%は胸に手を当て、そっと目を閉じた。

	IF 依頼_進行보존:302640 == 1
		PRINTFORML 「あなたの言葉が、背中を押してくれた」
		PRINTFORMW 「怖いけど……あなたがいるなら進める。ね、もう少し付き合って」
	ELSEIF 依頼_進行보존:302640 == 2
		PRINTFORML 「焦らないって約束、守れた気がする」
		PRINTFORMW 「このペースなら、ちゃんと자신と덱に向き合えるよ」
	ELSE
		PRINTFORML 「何も言わなくても、伝わってくるんだ」
		PRINTFORMW 「あなたが隣にいるだけで、怖さが少しずつ薄れていく」
	ENDIF

	CALL EVENT_FAVUP(이벤트主,100)
	PRINTFORML 「%CALLNAME:MASTER%……ありがとう」
	PRINTFORMW 「あなたがいてくれるなら、この力とも向き合える。そう思えた」
	PRINTFORML そう言って、%CALLNAME:이벤트主%ははにかみながら深く一礼した。
	PRINTFORMW 二人の間に、確かな信頼の温度が宿る。

	CALL EVENT_TIMER(30)
	RETURN 2
ENDIF

RETURN 1

