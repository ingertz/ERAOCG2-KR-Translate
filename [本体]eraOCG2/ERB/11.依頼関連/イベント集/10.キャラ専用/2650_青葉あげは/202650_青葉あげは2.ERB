@IRAI_EVENT_202650(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 대상캐릭터

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = (CH2650-02)見てられないだけだから
	CASE "이벤트種"
		RETURN 이벤트_通常
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		PRINTL あなたの덱を覗き込んできた青葉あげは。
		PRINTL どうやら、あなたの덱構築が気になって仕方がないらしい。
		PRINTL 
		PRINTL 報酬：2500DP、パック5個
	CASE "条件"
		SIF 依頼_完了횟수:102650 == 0
			RETURN 0
		RETURN 1
	CASE "추가条件"
		IF CFLAG:NO_TO_CHARANUM(2650):호감도 < 500
			RESULTS = 호감도が不足しています
			RETURN 1
		ENDIF
		IF MARK:NO_TO_CHARANUM(2650):반발각인 > 0
			RESULTS = 今の彼女と会うのは得策じゃない…분노が収まるのを待とう。
			RETURN 1
		ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

@IRAI_ACT_202650(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC 이벤트主

이벤트主 = NO_TO_CHARANUM(2650)

IF 依頼_달성상황 == 0
	PRINTFORML あなたは自室で덱の調整をしていた。
	PRINTFORML 最近のデュエルを振り返りながら、カードの入れ替えを検討している。
	PRINTFORMW 集中して作業に取り組んでいると、玄関のチャイムが鳴った。

	PRINTFORML ドアを開けると、青葉あげはが立っている。
	PRINTFORML 「あ、えーっと…偶然通りかかっただけなんだけど」
	PRINTFORMW 彼女は少し慌てたような表情を見せている。

	PRINTFORML 「別に、%CALLNAME:MASTER%に用があるわけじゃないのよ？」
	PRINTFORML あげはは強がるように言うが、視線がちらちらと室内に向いている。
	PRINTFORMW どうやら、덱調整をしているのが見えたらしい。

	PRINTL
	PRINTL [0] - 「덱を見てもらえる？」
	PRINTL [1] - 「偶然って…ここは住宅街だけど」
	BINPUT

	IF RESULT == 0
		PRINTFORML あなたは素直に彼女に덱を見てもらうことにした。
		PRINTFORML 「え、えーっと…そ、そうね。せっかくだから見てあげる」
		PRINTFORMW あげはは少し照れながらも嬉しそうに答える。
		依頼_進行보존:202650 = 1
	ELSE
		PRINTFORML あなたは彼女の言い訳を軽く指摘した。
		PRINTFORML 「う…それは…散歩してただけよ！」
		PRINTFORMW 彼女は顔を赤くして慌てている。
		PRINTFORML 「でも、せっかくだから…あなたの덱、ちょっと気になるし」
		PRINTFORMW あげはは結局、室内に入ってきた。
		依頼_進行보존:202650 = 2
	ENDIF

	依頼_달성상황++
	依頼_場所 = 場所_リビング
ELSEIF 依頼_달성상황 == 1
	PRINTFORML あげははテーブルに広げられたカードを見つめている。
	PRINTFORML 「……その덱、ちょっと非効率じゃない？」
	PRINTFORMW 彼女は遠慮がちに口を開いた。

	PRINTFORML 「別にどうでもいいけど、見てると気になるっていうか……」
	PRINTFORML あげはは指でカードを指しながら続ける。
	PRINTFORMW 「이 카드와 このカードの相性、あまり良くないと思うの」

	PRINTFORML 「それに、この몬스터 카드の攻撃力に対して」
	PRINTFORML 「サポートカードが少なすぎるような気がするし…」
	PRINTFORMW 彼女は真剣な表情で덱を分析している。

	PRINTFORML 「あ、でも！別に文句を言ってるわけじゃないのよ？」
	PRINTFORML あげはは慌てて手を振る。
	PRINTFORMW 「ただ、私がお節介焼きで、あなたが偶然そこにいただけ」

	PRINTL
	PRINTL [0] - 「具体的にどこを直せばいい？」
	PRINTL [1] - 「君の言う通りかもしれない」
	PRINTL [2] - 「実戦で試してみよう」
	BINPUT

	IF RESULT == 0
		PRINTFORML あなたは彼女の意見を詳しく聞こうとした。
		PRINTFORML 「え、えーっと…そうね」
		PRINTFORMW あげはは少し嬉しそうに詳しく説明し始める。
	    CALL EVENT_FAVUP(이벤트主,100)
		依頼_進行보존:202650 += 10
	ELSEIF RESULT == 1
		PRINTFORML あなたは素直に彼女の指摘を受け入れた。
		PRINTFORML 「そ、そう？まあ、私の目は確かだから」
		PRINTFORMW あげはは少し得意げな表情を見せる。
	    CALL EVENT_FAVUP(이벤트主,50)
		依頼_進行보존:202650 += 20
	ELSE
		PRINTFORML あなたは実戦での検証を提案した。
		PRINTFORML 「実戦って…デュエルってこと？」
		PRINTFORMW あげはは少し驚いたような表情を見せる。
		依頼_進行보존:202650 += 30
	ENDIF

	PRINTFORML 「口で言っても分からないでしょうから」
	PRINTFORML あげははデュエルディスクを取り出す。
	PRINTFORMW 「덱の問題点を洗い出すための『指導デュエル』をしましょう」

	PRINTFORML 「勘違いしないでよね。私がお節介焼きで」
	PRINTFORML 「あなたが偶然そこにいただけ。本当に、それだけだから」
	PRINTFORMW 彼女は照れ隠しのように強がって見せる。

	TARGET = 이벤트主
	CALL CHOICE_DUEL_TYPE(202650)

	IF RESULT == 1
		PRINTFORML デュエルに승리した。
		PRINTFORML 「くっ…やるじゃない」
		PRINTFORMW あげはは悔しそうだが、どこか만족げな表情を見せる。

		PRINTFORML 「でも、もっと迅速に勝てられるでしょう」
		PRINTFORML 彼女は強がるように言う。
		PRINTFORMW 「私が本気じゃなかったから勝てただけよ」
	    CALL EVENT_FAVUP(이벤트主,100)
	ELSE
		PRINTFORML デュエルに패배してしまった。
		PRINTFORML 「ほら、やっぱり」
		PRINTFORMW あげはは少し得意げな表情を見せる。

		PRINTFORML 「でも、思ったより善戦したわね」
		PRINTFORML 彼女は少し優しい口調で付け加える。
		PRINTFORMW 「私のアドバイスを聞けば、もっと強くなれるはず」
	ENDIF

	PRINTFORML デュエル後、あげはは少し早口で話し始める。
	PRINTFORML 「まず、이 카드는 3枚入れるべきね。安定性が全然違うから」
	PRINTFORMW 彼女は熱心にアドバイスを続ける。

	PRINTFORML 「それから、このモンスターは攻撃力は高いけど」
	PRINTFORML 「소환条件が厳しすぎるの。もう少し軽いカードを入れた方がいいわ」
	PRINTFORMW あげはの説明は的確で分かりやすい。

	IF 依頼_進行보존:202650 >= 30
		PRINTFORML 「実戦で試してみて正解だったわね」
		PRINTFORML 「理論だけじゃ分からないこともあるし」
		PRINTFORMW あげはは少し感心したような表情を見せる。
	ELSEIF 依頼_進行보존:202650 >= 20
		PRINTFORML 「素直に聞いてくれて…ありがと」
		PRINTFORML あげはは少し照れながら言う。
		PRINTFORMW 「たまには私の意見も役に立つでしょ？」
	ELSE
		PRINTFORML 「詳しく聞いてくれて嬉しい…じゃなくて！」
		PRINTFORML あげはは慌てて言い直す。
		PRINTFORMW 「当然の質問よね、うん」
	ENDIF

	PRINTFORML 「……まあ、これで少しはマシになるでしょ」
	PRINTFORML あげははぶっきらぼうに言いながら、カードパックを差し出す。
	PRINTFORMW 「これ、%CALLNAME:MASTER%の덱に合いそうなカードが入ってるから」

	PRINTFORML 「お、お礼なんていらないから！」
	PRINTFORML 「私がやりたくてやっただけなんだから！」
	PRINTFORMW 彼女は慌てて立ち上がる。

	PRINTFORML あげはは足早に玄関に向かう。
	PRINTFORML しかし、ドアの前で振り返る。
	PRINTFORMW 「また…困ったことがあったら、相談してもいいわよ」

	PRINTFORML 「べ、別に%CALLNAME:MASTER%のためじゃないから！」
	PRINTFORML 「私が暇だっただけ！」
	PRINTFORMW そう言い残して、彼女は慌てて去っていった。

	PRINTFORML あなたは彼女が残していったカードパックを手に取る。
	PRINTFORMW 確かに、あなたの덱に役立ちそうなカードが入っていた。

	CALL EVENT_TIMER(120)
	RETURN 2
ENDIF

RETURN 1

