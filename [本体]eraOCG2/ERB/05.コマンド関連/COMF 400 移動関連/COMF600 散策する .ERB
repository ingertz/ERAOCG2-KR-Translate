;산책한다
@COM_ABLE600
;이동実行판정
SIF !TFLAG:100
	RETURN 0
;외출以外
SIF !SANSAKU_AREA(CFLAG:MASTER:현재위치)
	RETURN 0
SIF CFLAG:MASTER:현재위치 == 99
	RETURN 0
;一括관리
SIF GLOBAL_COMABLE(600)
	RETURN RESULT
SIF CFLAG:우후후 == 2
	RETURN 0
RETURN 1
