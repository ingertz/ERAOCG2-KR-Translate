;-------------------------------------------------
;산책한다
;-------------------------------------------------
@COM600
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択行先
#DIM DYNAMIC 依頼_ID_C
#DIM DYNAMIC 施設アリ,1000
#DIM DYNAMIC 캐릭터_ID

VARSET マップモード
IF INRANGE(CFLAG:MASTER:현재위치,50,100)
	マップモード = 0
ELSEIF INRANGE(CFLAG:MASTER:현재위치,101,149)
	マップモード = 1
ELSEIF INRANGE(CFLAG:MASTER:현재위치,150,200)
	マップモード = 2
ELSEIF INRANGE(CFLAG:MASTER:현재위치,200,250)
	マップモード = 3
ELSEIF INRANGE(CFLAG:MASTER:현재위치,910,920)
	マップモード = 90
ELSEIF INRANGE(CFLAG:MASTER:현재위치,925,930)
	マップモード = 91
ENDIF

$INPUT_LOOP




FOR 依頼_ID_C,0,1000
	TRYCALLFORM IRAI_EVENT_{依頼_ID_C}("이벤트種")
	SIF RESULT != 이벤트_施設
		CONTINUE
	TRYCALLFORM IRAI_EVENT_{依頼_ID_C}("条件")
	SIF RESULT != 1
		CONTINUE
	TRYCALLFORM IRAI_EVENT_{依頼_ID_C}("利用制限")
	SIF RESULT != 0
		CONTINUE
	TRYCALLFORM IRAI_EVENT_{依頼_ID_C}("依頼先")
	施設アリ:RESULT = 1
NEXT


PRINTFORML ——【ＭＡＰ】＞＞—————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————

IF マップモード == 0
	CALLFORM MAP_PRINT_CITY
ELSEIF マップモード == 1
	CALLFORM MAP_PRINT_CENTER
ELSEIF マップモード == 2
	CALLFORM MAP_PRINT_OUTSKIRTS
ELSEIF マップモード == 3
	CALLFORM MAP_PRINT_KAIBALAND

ELSEIF マップモード == 90
	CALLFORM MAP_PRINT_SHOP

ELSEIF マップモード == 91
	CALLFORM MAP_PRINT_LHOTEL

ENDIF

CUSTOMDRAWLINE ―
PRINTFORML ——【산책지】＞＞—————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————

SETCOLOR C_PINK
PRINTFORM 　핑크：듀얼리스트 지인
PRINTFORM  /
SETCOLOR C_GOLD
PRINTFORM　 금색：몬스터 방랑 중
PRINTFORM  /
SETCOLOR C_AQUA
PRINTFORM 　청색：의뢰처
PRINTFORM  /
SETCOLOR C_ORANGE
PRINTFORM 　（！）：시설 이벤트 있음
RESETCOLOR
PRINTFORML 
CUSTOMDRAWLINE ―


IF マップモード == 0
	FOR カウンタ,50,80
		SIF CFLAG:MASTER:현재위치 == カウンタ
			SETCOLOR C_GREEN

		SIF カウンタ == 場所_学校教室
			CONTINUE
		SIF カウンタ == 場所_휴식室
			CONTINUE
		SIF GETPLACENAME(カウンタ) == ""
			CONTINUE
		SIF カウンタ == 場所_裏通り
			SETCOLOR C_BLACK
		CALL GETMAP(カウンタ,1)
		PRINTFORM [{カウンタ,3}] - %GETPLACENAME(カウンタ),20,LEFT%	
		RESETCOLOR
	
		IF 施設アリ:カウンタ == 1
			SETCOLOR C_ORANGE
			PRINT (！)
			RESETCOLOR
		ELSE
			PRINTFORM %"",4%
		ENDIF
		PRINTFORM / 

	NEXT
ELSEIF マップモード == 1
	FOR カウンタ,101,150
		SIF CFLAG:MASTER:현재위치 == カウンタ
			SETCOLOR C_GREEN
		SIF GETPLACENAME(カウンタ) == ""
			CONTINUE
		CALL GETMAP(カウンタ,1)
		PRINTFORM [{カウンタ,3}] - %GETPLACENAME(カウンタ),20,LEFT%	
		RESETCOLOR	
		IF 施設アリ:カウンタ == 1
			SETCOLOR C_ORANGE
			PRINT (！)
			RESETCOLOR
		ELSE
			PRINTFORM %"",4%
		ENDIF
		PRINTFORM / 

	NEXT
	CALL GETMAP(カウンタ,1)
	PRINTFORM [{73,3}] - %GETPLACENAME(73),20,LEFT%	
	RESETCOLOR	
	IF 施設アリ:73 == 1
		SETCOLOR C_ORANGE
		PRINT (！)
		RESETCOLOR
	ELSE
		PRINTFORM %"",4%
	ENDIF
ELSEIF マップモード == 2
	FOR カウンタ,151,200
		SIF CFLAG:MASTER:현재위치 == カウンタ
			SETCOLOR C_GREEN

		SIF GETPLACENAME(カウンタ) == ""
			CONTINUE
		CALL GETMAP(カウンタ,1)
		PRINTFORM [{カウンタ,3}] - %GETPLACENAME(カウンタ),20,LEFT%	
		RESETCOLOR
		IF 施設アリ:カウンタ == 1
			SETCOLOR C_ORANGE
			PRINT (！)
			RESETCOLOR
		ELSE
			PRINTFORM %"",4%
		ENDIF
		PRINTFORM / 
	NEXT
ELSEIF マップモード == 3
	FOR カウンタ,201,250
		SIF CFLAG:MASTER:현재위치 == カウンタ
		SETCOLOR C_GREEN

		SIF GETPLACENAME(カウンタ) == ""
			CONTINUE
		CALL GETMAP(カウンタ,1)
		PRINTFORM [{カウンタ,3}] - %GETPLACENAME(カウンタ),20,LEFT%	
		RESETCOLOR
		IF 施設アリ:カウンタ == 1
			SETCOLOR C_ORANGE
			PRINT (！)
			RESETCOLOR
		ELSE
			PRINTFORM %"",4%
		ENDIF
		PRINTFORM / 

	NEXT
ELSEIF マップモード == 90
	FOR カウンタ,910,920
		SIF CFLAG:MASTER:현재위치 == カウンタ
			SETCOLOR C_GREEN

		SIF GETPLACENAME(カウンタ) == ""
			CONTINUE
		CALL GETMAP(カウンタ,1)
		PRINTFORM [{カウンタ,3}] - %GETPLACENAME(カウンタ),20,LEFT%	
		RESETCOLOR
		IF 施設アリ:カウンタ == 1
			SETCOLOR C_ORANGE
			PRINT (！)
			RESETCOLOR
		ELSE
			PRINTFORM %"",4%
		ENDIF
		PRINTFORM / 
	NEXT
ELSEIF マップモード == 91
	FOR カウンタ,925,930
		SIF CFLAG:MASTER:현재위치 == カウンタ
			SETCOLOR C_GREEN

		SIF GETPLACENAME(カウンタ) == ""
			CONTINUE
		CALL GETMAP(カウンタ,1)
		PRINTFORM [{カウンタ,3}] - %GETPLACENAME(カウンタ),20,LEFT%	
		RESETCOLOR
		IF 施設アリ:カウンタ == 1
			SETCOLOR C_ORANGE
			PRINT (！)
			RESETCOLOR
		ELSE
			PRINTFORM %"",4%
		ENDIF
		PRINTFORM / 
	NEXT
ENDIF



PRINTFORML
PRINTFORML 
PRINTFORML [99] - 귀가한다
CUSTOMDRAWLINE ―

PRINT [9999] - 맵 전환
SIF ITEM:천년스마트폰
	PRINT 　　　[8888] - 지인 검색
SIF ITEM:천년바이크
	PRINT 　　　[7777] - 차원여행한다
PRINTL 
CUSTOMDRAWLINE —
PRINTL [1000] - 뒤로
BINPUT




IF RESULT == 99
	NEXTCOM = 435
	RETURN 0
ELSEIF RESULT == 9999
	マップモード += 1
	SIF マップモード >= 4
		マップモード = 0
	GOTO INPUT_LOOP
ELSEIF RESULT == 8888
	SETCOLOR C_ROYAL_BLUE
	CUSTOMDRAWLINE —
	PRINTFORML 지인의 현재 위치 검색을 시작합니다(이름을 누르면 해당 위치로 이동)
	CUSTOMDRAWLINE —
	RESETCOLOR

	CALL CHARA_PLACE
	GOTO INPUT_LOOP

ELSEIF RESULT == 7777
	CALL JIGEN_RYOKOU(1)
	SIF RESULT == 0
		GOTO INPUT_LOOP
	RETURN 1
ELSEIF RESULT == 1000
	RETURN 0
ELSE
	IF GROUPMATCH(マップモード,1,2)
		SIF RESULT <= 100
		RESULT += 100
	ELSEIF GROUPMATCH(マップモード,3,4)
		SIF RESULT <= 200
			RESULT += 200
	ELSEIF GROUPMATCH(マップモード,90,91)
		SIF RESULT <= 900
			RESULT += 900
	ENDIF
	選択行先 = RESULT


	ABS PLACEPARAMATOR(CFLAG:MASTER:현재위치) - PLACEPARAMATOR(選択行先)
	SIF RESULT >= 180
		RESULT = 180
	TIME += RESULT
	CFLAG:MASTER:현재위치 = 選択行先
	IF GROUPMATCH(マップモード,90,91)
		RETURN 1
	ENDIF
	
	FOR 캐릭터_ID,1,CHARANUM
		SIF !CFLAG:캐릭터_ID:데이트중 == 1
			CONTINUE
		CFLAG:캐릭터_ID:현재위치 = 選択行先
		PRINTFORML %CALLNAME:캐릭터_ID%는 %CALLNAME:MASTER%와의 투어링을 즐겼다。
		CALL SOURCE_CALC_환락(캐릭터_ID, MASTER, 20)
		CALL SOURCE_CALC_수동(캐릭터_ID, MASTER, 20)
	NEXT
ENDIF


RETURN 1



;-------------------------------------------------
;実行판정
