;-------------------------------------------------
;일
;-------------------------------------------------
@COM466
IF CFLAG:MASTER:현재위치 != 場所_직장
	;自宅だと消費が少ない
	CALL RECOVER_PERMIL(MASTER,-50,"체력")
	CALL RECOVER_PERMIL(MASTER,-100,"기력")
ELSE
	CALL RECOVER_PERMIL(MASTER,-200,"체력")
	CALL RECOVER_PERMIL(MASTER,-300,"기력")
ENDIF

IF TARGET > 0 && !CFLAG:수면
	CALL SOURCE_CALC_환락(TARGET, MASTER, 300)
	CALL SOURCE_CALC_정복(TARGET, MASTER, 100)
	EXP:MASTER:학습경험 ++
ENDIF


IF CFLAG:MASTER:현재위치 == 場所_직장
	TIME += 240
	仕事_工数 += 4
	CALL EVILTY_POINT(-5)
ELSEIF CFLAG:MASTER:현재위치 == 場所_CDSレジ裏 
	TIME += 120
	カドショ宣伝 += 5
	CALL EVILTY_POINT(-5)
ELSE
	TIME += 120
	仕事_工数 += 2
	CALL EVILTY_POINT(-2)
ENDIF

仕事_出席 = 2


SIF EXP:MASTER:학습경험 >=100
	仕事_工数 += (EXP:MASTER:학습경험 / 100)

RETURN 1

;-------------------------------------------------
;実行판정
;-------------------------------------------------
;일
@COM_ABLE466
;이동実行판정
SIF !TFLAG:100
	RETURN 0
;一括관리
SIF GLOBAL_COMABLE(466)
	RETURN RESULT
;휴식場所
SIF !WORKAREA(CFLAG:MASTER:현재위치)
	RETURN 0
SIF 仕事_出席 == 0
	RETURN 0
SIF CFLAG:우후후 == 2
	RETURN 0
RETURN 1