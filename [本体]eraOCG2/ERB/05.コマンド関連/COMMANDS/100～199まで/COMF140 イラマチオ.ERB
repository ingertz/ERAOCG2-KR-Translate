;-------------------------------------------------
;이라마치오
;ハードな조교コマンド、レベル2
;-------------------------------------------------
@COM140

;-------------------------------------------------
;COM別FLAGの설정
;-------------------------------------------------
TCVAR:MASTER:사정대상캐릭터_1 = TARGET

TCVAR:MASTER:사정부위플래그 = 4
;강도
TCVAR:MASTER:사정쾌락강도 = 2000

;-------------------------------------------------
;ソース추가処理
;-------------------------------------------------
;消費체력、기력
DOWNBASE:체력 += 150
DOWNBASE:기력 += 200

CALL SOURCE_CALC_노출(TARGET, MASTER, 30)
CALL SOURCE_CALC_접촉(TARGET, MASTER, 120)
CALL SOURCE_CALC_봉사(TARGET, MASTER, 200)
CALL SOURCE_CALC_고통(TARGET, MASTER, 300)
CALL SOURCE_CALC_구속(TARGET, MASTER, 200)
CALL SOURCE_CALC_쾌Ｍ(TARGET, MASTER,  150)

;애널、파과血、촉수の汚れ
IF (STAIN:MASTER:0 & 8) || (STAIN:MASTER:0 & 32) || (STAIN:MASTER:0 & 64)
	CALL SOURCE_CALC_불결(TARGET, MASTER, 1200)
;愛液,정액汚れ
ELSEIF STAIN:MASTER:0 & 1 || STAIN:MASTER:0 & 4
	CALL SOURCE_CALC_불결(TARGET, MASTER, 600)
ELSE
	CALL SOURCE_CALC_불결(TARGET, MASTER, 300)
ENDIF
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷の口⇔조교者のＰの汚れが이동
STAIN:0 |= STAIN:MASTER:2
STAIN:MASTER:2 |= STAIN:0

;-------------------------------------------------
;경험の処理
;-------------------------------------------------
;펠라경험
EXP:펠라경험 ++
;同性愛　ＧＬなら戻り値1、ＢＬなら戻り値2
IF HETEROSEX(TARGET,MASTER)
	EXP:(50 + HETEROSEX(TARGET,MASTER)) += 7
	EXP:MASTER:(50 + HETEROSEX(TARGET,MASTER)) += 7
ENDIF

;애정경험(마조끼5以上限定）
SIF TALENT:연모 && ABL:마조끼 >= 5
	EXP:애정경험 += 1

RETURN 1

@CAN_COM140(ARG)
#DIM DYNAMIC 素質確認
#DIM DYNAMIC 판정値
#DIM DYNAMIC 汚れ値
#DIM DYNAMIC 実行値
SKIPDISP ARG
PRINTL 이라마치오
;-------------------------------------------------
;実行판정処理
;-------------------------------------------------


;すべての命令に共通の要素を考慮
;(순종が高いと命令に従いやすいなど)
CALL COM_ORDER
素質確認 = RESULT:1
판정値 += RESULT
;ABL:욕망
IF ABL:욕망
	SIF 素質確認
		PRINT  + 
	판정値 += ABL:욕망 * 1
	PRINT 욕망
	PRINTV 'LV,ABL:욕망,'(,ABL:욕망 * 1,')
	素質確認 = 1
ENDIF
;ABL:봉사정신
IF ABL:봉사정신
	SIF 素質確認
		PRINT  + 
	판정値 += ABL:봉사정신 * 4
	PRINT 봉사정신
	PRINTV 'LV,ABL:봉사정신,'(,ABL:봉사정신 * 4,')
	素質確認 = 1
ENDIF
;ABL:정액중독
IF ABL:정액중독
	SIF 素質確認
		PRINT  + 
	판정値 += ABL:정액중독 * 3
	PRINT 정액중독
	PRINTV 'LV,ABL:정액중독,'(,ABL:정액중독 * 3,')
	素質確認 = 1
ENDIF

IF MARK:쾌락각인
	SIF 素質確認
		PRINT  + 
	판정値 += MARK:쾌락각인 * 1
	PRINT 쾌락각인
	PRINTV 'LV,MARK:쾌락각인,'(,MARK:쾌락각인 * 1,')
	素質確認 = 1
ENDIF
;PALAM:욕정
IF GETPALAMLV(PALAM:욕정,5)
	SIF 素質確認
		PRINT  + 
	판정値 += GETPALAMLV(PALAM:욕정,5) * 1
	PRINT 욕정
	PRINTV 'LV,GETPALAMLV(PALAM:욕정,5),'(,GETPALAMLV(PALAM:욕정,5) * 1,')
	素質確認 = 1
ENDIF

;부끄럼쟁이
IF TALENT:수치심 > 0
	PRINT  - 
	판정値 -= 1
	PRINT 부끄럼쟁이
	PRINTV '(,1,')
	素質確認 = 1
ENDIF
;악취둔감
IF TALENT:악취내성 > 0
	SIF 素質確認
		PRINT  + 
	판정値 += 1
	PRINT 악취둔감
	PRINTV '(,1,')
	素質確認 = 1
ENDIF
;악취민감
IF TALENT:악취내성 < 0
	PRINT  - 
	판정値 -= 3
	PRINT 악취민감
	PRINTV '(,3,')
	素質確認 = 1
ENDIF
;헌신적
IF TALENT:헌신적
	SIF 素質確認
		PRINT  + 
	판정値 += 6
	PRINT 헌신적
	PRINTV '(,6,')
	素質確認 = 1
ENDIF
;쾌감에 부정（음란、쾌락광で無効）
IF TALENT:쾌감반응 < 0 && !TALENT:음란
	PRINT  - 
	판정値 -= 1
	PRINT 쾌감에 부정
	PRINTV '(,1,')
	素質確認 = 1
ENDIF
;연모
IF TALENT:연모
	SIF 素質確認
		PRINT  + 
	판정値 += 5
	PRINT 연모
	PRINTV '(,5,')
	素質確認 = 1
ENDIF
;친애
IF TALENT:연모 > 1
	SIF 素質確認
		PRINT  + 
	판정値 += 5
	PRINT 친애
	PRINTV '(,5,')
	素質確認 = 1
ENDIF

;조교者が후타나리
IF (TALENT:MASTER:성별 & 3) == 3
	SIF 素質確認
		PRINT  + 
	판정値 += 8
	PRINT 후타나리
	PRINTV '(,8,')
	素質確認 = 1
ENDIF


;愛液の汚れ
SIF STAIN:MASTER:2 & 1
	汚れ値 += 1
;정액の汚れ
SIF STAIN:MASTER:2 & 4
	汚れ値 += 3
;애널の汚れ
SIF STAIN:MASTER:2 & 8
	汚れ値 += 7
SIF STAIN:MASTER:2 & 16
	汚れ値 += 15
汚れ値 = 汚れ値 * (2 - TALENT:악취내성) / 2

;더러움있음
IF 汚れ値
 	PRINT  - 
	판정値 -= 汚れ値
	PRINT 더러움있음
	;악취둔감
	IF TALENT:악취내성 > 0
		PRINT 、악취둔감
	ELSEIF TALENT:악취내성 < 0
		PRINT 、악취민감
	ENDIF
	PRINTV '(,汚れ値,')
	素質確認 = 1
ENDIF

;合計を표시(36以上で実行)
PRINT  = 
PRINTV 판정値

実行値 = 36
SIF 판정値 < 実行値
	PRINT  < 
SIF 판정値 == 実行値
	PRINT  = 
SIF 판정値 > 実行値
	PRINT  > 
PRINT 실행치
PRINTV 実行値

WAIT
SKIPDISP 0
;実行できない
SIF 판정値 < 実行値
	RETURN 0
RETURN 1


;-------------------------------------------------
;実行판정
;-------------------------------------------------
@COM_ABLE140
;이라마치오実行판정
SIF !TFLAG:100
	RETURN 0
;一括관리
SIF GLOBAL_COMABLE(140)
	RETURN RESULT
;조교者がオトコか후타나리じゃないとダメ
SIF !(TALENT:MASTER:성별 & 2)
	RETURN 0
;볼개그사용중は불가
SIF TEQUIP:볼개그
	RETURN 0
;순종、욕망の합계가 6以上ないとダメ
SIF ABL:순종 + ABL:욕망 < 6
	RETURN 0
;고양이혀の奴隷の場合は기교Lv2以上必要
SIF TALENT:고양이혀 && ABL:기교 < 2
	RETURN 0
;体格差がある場合は主人が금단의지식持ちじゃないとダメ
SIF ABS(TALENT:체형 - TALENT:MASTER:체형) > 2 && (TALENT:MASTER:금단의지식 == 0)
	RETURN 0
;새댁플레이 중はダメ
SIF TEQUIP:새댁플레이
	RETURN 0
RETURN 1