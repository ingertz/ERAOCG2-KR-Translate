@COM353
TIME += 10
IF BASE:TARGET:만족 < 0
	TFLAG:SELECTCOM분기 = 1
ELSEIF TALENT:TARGET:새드 >= 1
	TFLAG:SELECTCOM분기 = 2
ELSEIF TALENT:TARGET:포식자 >= 1
	TFLAG:SELECTCOM분기 = 2
ENDIF
CALL SOURCE_CALC_정복(TARGET, MASTER, 150)

RETURN 1

