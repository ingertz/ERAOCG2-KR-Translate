;────────────────────────────────────────────────────

@CATEGORY_PRINT(選択カテゴリ)
#DIM DYNAMIC 選択カテゴリ
#DIM DYNAMIC カウンタ

CALL REPEAT_PRINTL(5)

;名前표시
CUSTOMDRAWLINE ―
TRYCALLFORM CATEGORY_STATE_{選択カテゴリ},"カテゴリ名"
PRINTFORML 　【%RESULTS%】
CUSTOMDRAWLINE ―

;속성
PRINT 속성：
TRYCALLFORM CATEGORY_STATE_{選択カテゴリ},"속성"
IF RESULT == 10
	PRINTFORM （복수）
ELSE
	FOR カウンタ,0,4
		SELECTCASE RESULT:カウンタ
			CASE 1
				SETCOLOR C_LIGHT_T
				PRINTFORM （%"빛",2%）
			CASE 2
				SETCOLOR C_DARK_T
				PRINTFORM （%"어둠"%）
			CASE 3
				SETCOLOR C_GROUND_T
				PRINTFORM （%"땅",2%）
			CASE 4
				SETCOLOR C_WATER_T
				PRINTFORM （%"물",2%）
			CASE 5
				SETCOLOR C_FIRE_T
				PRINTFORM （%"화염"%）
			CASE 6
				SETCOLOR C_WIND_T
				PRINTFORM （%"바람"%）
			CASE 7
				SETCOLOR C_LIGHT_T
				PRINTFORM （%"신",2%）
		ENDSELECT
		RESETCOLOR
	NEXT
ENDIF
;종족
PRINT 　종족：
TRYCALLFORM CATEGORY_STATE_{選択カテゴリ},"종족"
IF RESULT == 30
	PRINTFORM （복수）
ELSE
	FOR カウンタ,0,4
		SIF RESULT:カウンタ == 0
			BREAK
		SIF カウンタ != 0
			PRINT  / 
		SIF RESULT:カウンタ != 0
			PRINTFORM %GET_TALENTNAME(191,RESULT:カウンタ),12,LEFT%
	NEXT
ENDIF
;소환法
PRINT 　사용하는 ＥＸ소환：
TRYCALLFORM CATEGORY_STATE_{選択カテゴリ},"EX덱"
IF RESULT == 10
	PRINTFORM （복수）
ELSEIF RESULT == 0
	PRINTFORM （없음）
ELSE
	FOR カウンタ,0,4
		SIF RESULT:カウンタ == 0
			BREAK
		IF RESULT:カウンタ == 의식
			SETCOLOR C_GISK_BLUE
			PRINT 【의식】
		ELSEIF RESULT:カウンタ == 융합
			SETCOLOR C_FUSE_PUR
			PRINT 【융합】
		ELSEIF RESULT:カウンタ == 싱크로
			SETCOLOR C_SYN_WHITE
			PRINT 【싱크로】
		ELSEIF RESULT:カウンタ == 엑시즈
			SETCOLOR C_XYZ_BLACK
			PRINT 【엑시즈】
		ELSEIF RESULT:カウンタ == 링크
			SETCOLOR C_LINK_BLUE
			PRINT 【링크】
		ELSEIF RESULT:カウンタ == 초차원
			SETCOLOR C_PSY_RED
			PRINT 【초차원】
		ENDIF
		RESETCOLOR
	NEXT
ENDIF
PRINTL
CUSTOMDRAWLINE ―


;関連カテゴリ
TRYCALLFORM CATEGORY_STATE_{選択カテゴリ},"カテゴリ"
IF RESULTS:1 != ""
	PRINT 관련 카테고리：
	FOR カウンタ,1,5
		SIF RESULTS:カウンタ != ""
			PRINTFORM 【%RESULTS:カウンタ%】
	NEXT
	PRINTL
	CUSTOMDRAWLINE ―
ENDIF

IF 選択カテゴリ > 5000
	;シチュエーション傾向
	TRYCALLFORM CATEGORY_STATE_{選択カテゴリ},"シチュエーション"
	PRINT 시추에이션 경향：
	FOR カウンタ,0,6
		SIF RESULTS:カウンタ != ""
			PRINTFORML 【%RESULTS:カウンタ%】
	NEXT

ELSE
	;出典
	TRYCALLFORM CATEGORY_STATE_{選択カテゴリ},"出典"
	PRINTFORML 출처：%RESULTS%
ENDIF

CUSTOMDRAWLINE ―
TRYCALLFORM CATEGORY_TEXT_{選択カテゴリ}

RETURN 0

