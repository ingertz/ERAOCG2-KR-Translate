@CARDSHOP_UNEI
#DIM DYNAMIC 캐릭터_ID
#DIM DYNAMIC カードコスト,10
#DIM DYNAMIC 절정BASE計算
#DIM DYNAMIC 절정BASE基礎
#DIM DYNAMIC 이벤트主
#DIM DYNAMIC 選択파츠


$CHOICE_LOOP
CUSTOMDRAWLINE —
PRINTFORML "카드샵"
CUSTOMDRAWLINE —
PRINTFORML 
PRINTFORML [ 1] - 팩의 보충을 한다
PRINTFORML [ 2] - 싱글 카드를 놓는다
PRINTFORML [ 3] - 알바를 파견한다

PRINTFORML 
IF ショップ運営中 == 0
	SETCOLOR C_YELLOW
	PRINTFORML [10] - 샵을 재개한다
ELSE
	SETCOLOR C_GRAY
	PRINTFORML [10] - 샵을 휴업한다
ENDIF
RESETCOLOR

PRINTFORML 
CUSTOMDRAWLINE —
PRINTL
PRINTL [100] - 돌아간다
BINPUT
;돌아간다
IF RESULT == 100
	RETURN 0
ELSEIF RESULT == 1
	CALL CARDSHOP_UNEI_PACKS
ELSEIF RESULT == 2
	CALL CARDSHOP_SET_SINGLES
ELSEIF RESULT == 3
	CUSTOMDRAWLINE —
	PRINTFORML [ 1] - 알바를 파견한다
	PRINTFORML [ 2] - 알바 복장을 변경한다
	PRINTFORML 
	CUSTOMDRAWLINE —
	PRINTL
	PRINTL [100] - 돌아간다
	BINPUT
	IF RESULT == 100
		GOTO CHOICE_LOOP
	ELSEIF RESULT == 1
		CALL MONSTER_LIST(22)
	ELSEIF RESULT == 2
		CALL CARDSHOP_CHARA_CLOTHES
	ENDIF
	GOTO CHOICE_LOOP
ELSEIF RESULT == 10
	ショップ運営中 ^= 1
ENDIF
GOTO CHOICE_LOOP

@CARDSHOP_UNEI_PACKS
#DIM DYNAMIC 初回カウンタ
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 選択덱
#DIM DYNAMIC カウンタB
#DIM DYNAMIC スタート数
#DIM DYNAMIC エンド数

#DIM DYNAMIC パックセット,1000
#DIM DYNAMIC 설정종류

#DIM DYNAMIC 選択パック_ID
#DIM DYNAMIC パック_ID
#DIM DYNAMIC 選択モード
#DIM DYNAMIC 설정BOX数



$PACK_LOOP
CUSTOMDRAWLINE ―
PRINTFORML 　■팩을 골라주세요
CUSTOMDRAWLINE ―
VARSET カウンタB

FOR カウンタ,0,1000
	VARSET RESULT
	VARSET RESULTS
	CALL CARD_PACK_NAME(カウンタ)
	IF RESULT == 1
		パックセット:カウンタB = カウンタ
		カウンタB ++
	ENDIF
NEXT

FOR カウンタ,0,カウンタB
	SIF カウンタ % 2 == 0 && カウンタ != 0
		PRINTL
	パック_ID = パックセット:カウンタ
	VARSET RESULTS
	CALL CARD_PACK_NAME(パック_ID)
	IF RESULTS != ""
		PRINTFORM 　　[{カウンタ,3}] %RESULTS,50,LEFT%　
		PRINTFORM 「{残BOX数:パック_ID,3}/{補充BOX数:パック_ID,3}」
	ENDIF
NEXT
PRINTL
CUSTOMDRAWLINE ―
PRINTFORM [8888] - 설정모드
IF 選択モード == 0
	PRINTFORM 「매번선택」
ELSEIF 選択モード == 1
	PRINTFORM 「조금보충」　（100 팩）
ELSEIF 選択モード == 2
	PRINTFORM 「충분히 보충」（300 팩）
ELSEIF 選択モード == 3
	PRINTFORM 「많이 보충」（1000 팩）
ELSEIF 選択モード == 4
	PRINTFORM 「한계까지 보충」（3000 팩）
ENDIF


PRINTFORM 　　[7777] - 모든 팩을 보충한다
PRINTL



CUSTOMDRAWLINE ―
PRINTL [9999] - 돌아간다
BINPUT
IF RESULT == 9999
	RETURN 0

ELSEIF RESULT == 7777
	CUSTOMDRAWLINE ―
	PRINTFORML 보충할 수를 선택해주세요（제２/제４ 일요일에 보충） 
	CUSTOMDRAWLINE ―
	PRINTFORML 
	PRINTFORML [1] - 조금 보충　（ 100팩까지 보충）
	PRINTFORML [2] - 충분히 보충（ 300팩까지 보충）
	PRINTFORML [3] - 많이 보충（1000팩까지 보충）
	PRINTFORML [4] - 한계까지 보충（3000팩까지 보충）
	PRINTFORML 
	PRINTFORML [9999] - 돌아간다
	BINPUT
	IF RESULT == 9999
		GOTO PACK_LOOP
	ELSEIF RESULT == 1
		설정BOX数 = 100
	ELSEIF RESULT == 2
		설정BOX数 = 300
	ELSEIF RESULT == 3
		설정BOX数 = 1000
	ELSEIF RESULT == 4
		설정BOX数 = 3000
	ENDIF
	VARSET カウンタB
	FOR カウンタ,0,1000
		VARSET RESULT
		VARSET RESULTS
		CALL CARD_PACK_NAME(カウンタ)
		IF RESULT == 1
			パックセット:カウンタB = カウンタ
			カウンタB ++
		ENDIF
	NEXT
	FOR カウンタ,0,カウンタB
		パック_ID = パックセット:カウンタ
		補充BOX数:パック_ID = 설정BOX数
	NEXT

	GOTO PACK_LOOP
ELSEIF RESULT == 8888
	選択モード ++
	SIF 選択モード > 3
		選択モード = 0
	GOTO PACK_LOOP
ELSEIF INRANGE(RESULT,0,1000)
	選択パック_ID = パックセット:RESULT
	SELECTCASE 選択モード
		CASE 0
			CUSTOMDRAWLINE ―
			PRINTFORML 보충할 수를 선택해주세요（제２/제４ 일요일에 보충） 
			CUSTOMDRAWLINE ―
			PRINTFORML 
			PRINTFORML [1] - 조금 보충　（ 100팩까지 보충）
			PRINTFORML [2] - 충분히 보충（ 300팩까지 보충）
			PRINTFORML [3] - 많이 보충（1000팩까지 보충）
			PRINTFORML [4] - 한계까지 보충（3000팩까지 보충）
			PRINTFORML 
			PRINTFORML [9999] - 돌아간다
			BINPUT
			IF RESULT == 1
				補充BOX数:選択パック_ID = 100
			ELSEIF RESULT == 2
				補充BOX数:選択パック_ID = 300
			ELSEIF RESULT == 3
				補充BOX数:選択パック_ID = 1000
			ELSEIF RESULT == 4
				補充BOX数:選択パック_ID = 3000
			ENDIF
		CASE 1
			補充BOX数:選択パック_ID = 100
		CASE 2
			補充BOX数:選択パック_ID = 300
		CASE 3
			補充BOX数:選択パック_ID = 1000
		CASE 4
			補充BOX数:選択パック_ID = 3000
	ENDSELECT
	GOTO PACK_LOOP
ENDIF

@CARDSHOP_SET_SINGLES
#DIM DYNAMIC 初回カウンタ
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択덱
#DIM DYNAMIC カウンタB
#DIM DYNAMIC スタート数
#DIM DYNAMIC エンド数

#DIM DYNAMIC パックセット,1000
#DIM DYNAMIC 설정종류

#DIM DYNAMIC 選択パック_ID

#DIM DYNAMIC カード_ID
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 選択位置
#DIM DYNAMIC 설정RND
#DIM DYNAMIC 설정可能カード,100000


$DECK_LOOP
CUSTOMDRAWLINE ―
PRINTFORML 　■ 설정할 싱글 카드를 골라주세요
CUSTOMDRAWLINE ―
FOR カウンタ,0,30
	SIF カウンタ % 3 == 0 && カウンタ != 0
		PRINTL
	カード_ID = 売出カード:カウンタ
	IF カード_ID <= 0
		SETCOLOR C_GRAY
		PRINTFORM [{カウンタ,3}] %"《　빈 칸　》",45,LEFT%
		RESETCOLOR
	ELSE
		CALLFORM CARDNAME_{カード_ID}("名前")
		STRLENS RESULTS
		IF RESULT >= 41
			SUBSTRING RESULTS, 0, 38
			RESULTS = 《%RESULTS%…》
			PRINTFORM [{カウンタ,3}] %RESULTS,45,LEFT%
		ELSE
			RESULTS = 《%RESULTS%》
			PRINTFORM [{カウンタ,3}] %RESULTS,45,LEFT%
		ENDIF
	ENDIF
NEXT
PRINTL
CUSTOMDRAWLINE ―
PRINTFORML [9999] - 돌아간다　　　　　　　　　　[7777] - 무작위로 설정　　　　　　　　　　[8888] - 리셋한다
BINPUT
IF RESULT == 9999
	RETURN 0

ELSEIF RESULT == 7777
	PRINTFORML 무작위로 싱글 카들르 세트하시겠습니까？
	PRINTFORML [0] - 예
	PRINTFORML [1] - 아니오
	BINPUT
	SIF RESULT == 1
		GOTO DECK_LOOP

	FOR カード_ID,1000,100000
		TRYCALLFORM CARDNAME_{カード_ID}("カテゴリ")
		SIF MATCH(RESULTS,"듀얼리스트")
			CONTINUE
		TRYCALLFORM CARD_{カード_ID}("生産불가")
		SIF RESULT == 1
			CONTINUE

		CALL CARDPRICE(カード_ID,"レア度")
		SIF !GROUPMATCH(RESULT,3,4)
			CONTINUE
		SIF ITEM:カード_ID <= 1
			CONTINUE
		설정可能カード:カウンタB = カード_ID
		カウンタB ++
	NEXT
	
	FOR カウンタ,0,30
		SIF 売出カード:カウンタ >= 1
			CONTINUE
		설정RND = RAND:カウンタB
		選択カードID = 설정可能カード:설정RND
		IF ITEM:選択カードID >= 1
			売出カード:カウンタ = 選択カードID
			ITEM:選択カードID --
			ARRAYREMOVE 설정可能カード, 설정RND, 1
			カウンタB --
		ENDIF
	NEXT

	GOTO DECK_LOOP
ELSEIF RESULT == 8888
	FOR カウンタ,0,30
		SIF 売出カード:カウンタ <= 0
			CONTINUE
		ITEM:(売出カード:カウンタ) ++
		売出カード:カウンタ = 0
	NEXT
	GOTO DECK_LOOP
ELSE
	選択位置 = RESULT
	;選択位置にカードが存在していたら、그 카드를 置く。
	IF 売出カード:選択位置 >= 1
		選択カードID = 売出カード:選択位置
		売出カード:選択位置 = -1
		ITEM:選択カードID ++
	ENDIF
	CUSTOMDRAWLINE ―
	PRINTFORML 싱글로서 팔릴 카드를 １장 골라주세요(SR / UR 카드만)
	CUSTOMDRAWLINE ―
	PRINTFORML
	CALL EDIT_DECK_COLLECTION(1)
	IF RESULT > 0
		;選択位置にカードが存在していたら、그 카드를 置く。
		選択カードID = RESULT
		売出カード:選択位置 = 選択カードID
		;PRINTFORML 選択カードID:{選択カードID}

		ITEM:選択カードID --
		GOTO DECK_LOOP
	ELSE
		PRINTFORMW 돌아갑니다.
		GOTO DECK_LOOP
	ENDIF
ENDIF



@CARDSHOP_CHARA_CLOTHES
#DIM DYNAMIC 캐릭터_ID


$CHOICE_LOOP
CUSTOMDRAWLINE —
PRINTFORML 
FOR 캐릭터_ID,0,CHARANUM
	SIF CFLAG:캐릭터_ID:아르바이트 != PT_カドショ
		CONTINUE
	PRINTFORM [{캐릭터_ID,4}] - %CALLNAME:캐릭터_ID,40,LEFT%　
	IF CFLAG:캐릭터_ID:알바의상 == 511 || CFLAG:캐릭터_ID:알바의상 == 0
		PRINTFORM 「앞치마」
	ELSEIF CFLAG:캐릭터_ID:알바의상 == 500
		PRINTFORM 「바니걸」
	ELSEIF CFLAG:캐릭터_ID:알바의상 == 501
		PRINTFORM 「메이드의상」
	ELSEIF CFLAG:캐릭터_ID:알바의상 == 502
		PRINTFORM 「차이나의상」
	ELSEIF CFLAG:캐릭터_ID:알바의상 == 504
		PRINTFORM 「마법소녀」
	ELSEIF CFLAG:캐릭터_ID:알바의상 == 505
		PRINTFORM 「무녀복」
	ENDIF
	PRINTFORML 
NEXT
CUSTOMDRAWLINE —
PRINTL
PRINTL [100] - 돌아간다
BINPUT
IF RESULT == 100
	RETURN 0
ELSE
	캐릭터_ID = RESULT
	CALL PRINT_STATE(캐릭터_ID)
	CUSTOMDRAWLINE —
	PRINTFORML　어느 의상을 입히시겠습니까？
	CUSTOMDRAWLINE —
	PRINTFORML [511] - 「앞치마」
	PRINTFORML [500] - 「바니걸」
	PRINTFORML [501] - 「메이드의상」
	PRINTFORML [502] - 「차이나의상」
	PRINTFORML [504] - 「마법소녀」
	PRINTFORML [506] - 「무녀복」
	CUSTOMDRAWLINE —
	PRINTL
	PRINTL [100] - 돌아간다
	BINPUT
	SIF RESULT == 100
		GOTO CHOICE_LOOP
	CFLAG:캐릭터_ID:알바의상 = RESULT

	;PRINTFORML CFLAG:캐릭터_ID:バイト衣装:{CFLAG:캐릭터_ID:バイト衣装}
	CALL CLOTHES_SETTING(캐릭터_ID,CFLAG:캐릭터_ID:알바의상)
	GOTO CHOICE_LOOP
ENDIF



@CARDSHOP_UNEI_SALES
#DIM DYNAMIC 캐릭터_ID
#DIM DYNAMIC カードコスト,10
#DIM DYNAMIC 절정BASE計算
#DIM DYNAMIC 절정BASE基礎
#DIM DYNAMIC 이벤트主
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC カウンタC
#DIM DYNAMIC カウンタD
#DIM DYNAMIC 既存パック,2000
#DIM DYNAMIC 所持パック,2000
#DIM DYNAMIC 購入BOX数
#DIM DYNAMIC 支払金額
#DIM DYNAMIC 支払予定金額
#DIM DYNAMIC 売却変動値
#DIM DYNAMIC パック_ID
#DIM DYNAMIC 実売却数
#DIM DYNAMIC 合計売却数
#DIM DYNAMIC 売却金額
#DIM DYNAMIC シングル価格
#DIM DYNAMIC 설정可能カード,100000
#DIM DYNAMIC 설정RND
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC カード_ID



;売れ筋パック설정
IF DAY:3 == 30
	FOR パック_ID,0,1000
		CALL CARD_PACK_NAME(パック_ID)
		IF RESULTS != ""
			既存パック:カウンタB = パック_ID
			カウンタB ++
		ENDIF
		IF RESULT == 1
			所持パック:カウンタC = パック_ID
			カウンタC ++
		ENDIF
	NEXT
	FOR カウンタ,0,3
		売れ筋パック:カウンタ = 既存パック:(RAND:カウンタB)
	NEXT
ENDIF

IF ショップ運営中 == 1
	CUSTOMDRAWLINE ―
	PRINTFORML ■샵 운영
	PRINTFORML 판매 팩 수	
	CUSTOMDRAWLINE ―

	来客者数 = 来客者数 + RAND:10
	FOR パック_ID,0,1000
		SIF 残BOX数:パック_ID <= 0
			CONTINUE
		売却変動値 = 来客者数 * RAND:10
		IF MATCH(売れ筋パック,パック_ID)
			売却変動値 = 売却変動値 * 2
		ENDIF
		SIF 売却変動値 <= 0
			CONTINUE

		実売却数 = RAND:売却変動値
		SIF 実売却数 > 残BOX数:パック_ID
			実売却数 = 残BOX数:パック_ID

		残BOX数:パック_ID -= 実売却数
		売却金額 += 実売却数 * 15
		合計売却数 += 実売却数

		SIF 残BOX数:パック_ID <= 0
			残BOX数:パック_ID = 0

	NEXT
	CUSTOMDRAWLINE ―
	PRINTFORML 구입한 싱글 카드：
	IF 来客者数 >= 1
		FOR カード_ID,1000,100000
			TRYCALLFORM CARDNAME_{カード_ID}("カテゴリ")
			SIF MATCH(RESULTS,"듀얼리스트")
				CONTINUE
			TRYCALLFORM CARD_{カード_ID}("生産불가")
			SIF RESULT == 1
				CONTINUE
			TRYCALLFORM CARD_{カード_ID}("외부자")
			SIF RESULT >= 1
				CONTINUE
			CALL CARDPRICE(カード_ID,"レア度")
			SIF !GROUPMATCH(RESULT,3,4)
				CONTINUE
			설정可能カード:カウンタD = カード_ID
			カウンタD ++
		NEXT
		FOR カウンタ,0,来客者数
			IF RAND:3 == 0
				설정RND = RAND:カウンタD
				選択カードID = 설정可能カード:설정RND
				CALL CARD_GET_SINGLE(選択カードID,1)
			ENDIF
		NEXT
	ENDIF

	CUSTOMDRAWLINE ―
	PRINTFORML 판매한 싱글 카드：
FOR カウンタ,0,30
	VARSET シングル価格
	;PRINTFORML [{カウンタ}]売れたカード:カウンタ:{売れたカード:カウンタ} / 売出カード:カウンタ:{売出カード:カウンタ}
	IF 売れたカード:カウンタ == 1 && 売出カード:カウンタ >= 1
		TRYCALLFORM CARDNAME_{売出カード:カウンタ}("名前")
		PRINTFORML 쇼케이스의 %RESULTS%가 팔렸습니다
		売出カード:カウンタ = 0
		IF RAND:3 == 0
			シングル価格 = 200 + (RAND:50) * 100
		ELSEIF RAND:2 == 0
			シングル価格 = 500 + (RAND:50) * 100
		ELSE
			シングル価格 = 1500 + (RAND:50) * 100
		ENDIF
		売却金額 += シングル価格
	ENDIF
NEXT
	IF DAY:3 == 15 || DAY:3 == 29
	;IF DAY:3 >= 1
		CUSTOMDRAWLINE ―
		PRINTFORML 팩 입하：
		FOR パック_ID,0,1000
			購入BOX数 = 補充BOX数:パック_ID - 残BOX数:パック_ID
			SIF 購入BOX数 <= 0
				CONTINUE
			
			支払予定金額 += 購入BOX数 * 10
			IF MONEY < 支払予定金額
				BREAK
			ENDIF
			支払金額 += 購入BOX数 * 10
			残BOX数:パック_ID = 補充BOX数:パック_ID
		NEXT
	ENDIF
	CUSTOMDRAWLINE ―
	PRINTFORML 팩 이익：
	PRINTFORML 팩이、{実売却数}박스정도 팔렸습니다。

	CUSTOMDRAWLINE ―
	PRINTFORML 샵 이익:
	CALL MONEY_GET(売却金額)
	PRINTFORML 샵 운영비:
	CALL MONEY_GET(-支払金額)
	CUSTOMDRAWLINE ―
	PRINTFORML 샵 총이익:{売却金額 - 支払金額}
	CUSTOMDRAWLINE ―
ENDIF

VARSET 売れたカード
VARSET 来客者数
VARSET カドショ宣伝


RETURN 1