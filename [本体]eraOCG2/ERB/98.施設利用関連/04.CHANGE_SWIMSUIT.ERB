IF CFLAG:MASTER:현재위치 == 場所_砂浜 && GET_MONTH() == "여름의 달"
	PRINTFORMW ……아직 수영복을 즐기기엔 추운것같다。
	RETURN 0
ENDIF

FOR 캐릭터_ID,1,CHARANUM
	SIF CFLAG:캐릭터_ID:동행 == 0
		CONTINUE
	캐릭터동행中 = 1
	BREAK
NEXT

SIF 캐릭터동행中 == 1
	PRINTFORM 모두 함께
PRINTFORML 수영복으로 갈아입을까요?
PRINTFORML 
PRINTFORML [0] - 예
PRINTFORML [1] - 아니오
PRINTFORML 
BINPUT
SIF RESULT == 1
	RETURN 0

CALL CLOTHES_SETTING(MASTER,525)
CFLAG:MASTER:수영복착용 = 1
FOR 캐릭터_ID,1,CHARANUM
	SIF CFLAG:캐릭터_ID:동행 == 0
		CONTINUE
	CALL CLOTHES_SETTING(캐릭터_ID,525)
	CFLAG:캐릭터_ID:수영복착용 = 1
NEXT

