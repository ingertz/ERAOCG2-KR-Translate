@COM419
#DIM DYNAMIC 캐릭터_ID
#DIM DYNAMIC カードコスト,10
#DIM DYNAMIC 절정BASE計算
#DIM DYNAMIC 절정BASE基礎
#DIM DYNAMIC 이벤트主
#DIM DYNAMIC 選択파츠

SELECTCASE CFLAG:MASTER:현재위치
CASE 場所_車庫
	CALL MACHINE_CUSTOM
CASE 場所_事務所
	CALL MACHINE_SALES
CASE 場所_카지노
	CALL CASINO_ENTRANCE
CASE 場所_CDS入口
	CALL CARDSHOP_UNEI
CASE 場所_ラブホ, 場所_高級ホテル, 場所_Reホテル, 場所_Reラブホ
	CALL LOVE_HOTEL_ENTRY
CASE 場所_ラブホ内
	CALL LOVE_HOTEL_EXIT
CASE 場所_砂浜, 場所_Reビーチ, 場所_Re海の家, 場所_RePビーチ, 場所_Re海の家2
	CALL CHANGE_SWIMSUIT
CASE 場所_玄関
	オプション_訪問拒否 ^= 1
ENDSELECT


@COMNAME_SHISETU
SELECTCASE CFLAG:MASTER:현재위치
CASE 場所_車庫
	RESULTS = 머신 커스텀
CASE 場所_事務所
	RESULTS = 파츠를 산다
CASE 場所_카지노
	RESULTS = 카지노를 즐긴다
CASE 場所_CDS入口
	RESULTS = 카드샵 운영
CASE 場所_ラブホ, 場所_高級ホテル, 場所_Reホテル, 場所_Reラブホ
	RESULTS = 모텔에 들어간다
CASE 場所_ラブホ内
	RESULTS = 방을 나온다
CASE 場所_玄関
	IF オプション_訪問拒否 == 1
		RESULTS = 방문을 거절한다
	ELSE
		RESULTS = 방문을 환영한다
	ENDIF
CASE 場所_砂浜, 場所_Reビーチ, 場所_Re海の家, 場所_RePビーチ, 場所_Re海の家2
	RESULTS = 수영복을 입는다
ENDSELECT



;-------------------------------------------------
;実行판정
;-------------------------------------------------
;施設を利用する
@COM_ABLE419
;毎日リセット甘味플래그
;데이트중以
SIF !TFLAG:100
	RETURN 0
;寝室
SIF CAN_WORK() == 0
	RETURN 0
SIF GLOBAL_COMABLE(419)
	RETURN 0
;기력0
SIF BASE:MASTER:기력 <= 0
	RETURN 0
SIF CFLAG:우후후 == 2
	RETURN 0
RETURN 1

@CAN_WORK
#FUNCTION
#DIM DYNAMIC 캐릭터_ID

SELECTCASE CFLAG:MASTER:현재위치
CASE 場所_車庫
	RETURNF 1
CASE 場所_事務所
	RETURNF 1
CASE 場所_카지노
	RETURNF 1
CASE 場所_CDS入口
	RETURNF 1
CASE 場所_ラブホ, 場所_高級ホテル, 場所_Reホテル, 場所_Reラブホ
	RETURNF 1
CASE 場所_砂浜, 場所_Reビーチ, 場所_Re海の家, 場所_RePビーチ, 場所_Re海の家2
	RETURNF 1
CASE 場所_玄関
	RETURNF 1
;CASE 場所_ラブホ内
;	RETURNF 1
ENDSELECT
RETURNF 0



