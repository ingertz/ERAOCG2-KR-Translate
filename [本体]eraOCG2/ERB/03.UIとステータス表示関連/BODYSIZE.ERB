;-------------------------------------------------
;가슴성장
;-------------------------------------------------
@BUST_UP_BODYSIZE()
#DIM DYNAMIC 캐릭터_ID
#DIM DYNAMIC カップ

;絶壁 AAA~
;貧乳 A~
;普乳 C~
;巨乳 E~
;爆乳 H~
;ウシ乳 M~
;魔乳 S~
;規格外 Z+~
IF オプション_가슴AWS == 1
	FOR 캐릭터_ID,0,CHARANUM
		SIF TALENT:캐릭터_ID:성별 == 2
			CONTINUE
		SIF CFLAG:캐릭터_ID:가슴성장 < 1
			CONTINUE
		カップ = TOINT_CUPSIZE(캐릭터_ID)
		IF カップ >= CUPLEVEL_BUSTSIZE(-2) && BUST_SIZE(캐릭터_ID) == -3
			IF 限界値_가슴AWS == 0 || 限界値_가슴AWS >= 6000 || CANUP_AWS_TALENT_BUST(-2)
				TALENT:캐릭터_ID:가슴사이즈 = -2
				PRINTFORMW %CALLNAME:캐릭터_ID%의 가슴은【절벽】이 되었다
			ENDIF
		ELSEIF カップ >= CUPLEVEL_BUSTSIZE(-1) && BUST_SIZE(캐릭터_ID) == -2
			IF 限界値_가슴AWS == 0 || 限界値_가슴AWS >= 6500 || CANUP_AWS_TALENT_BUST(-1)
				TALENT:캐릭터_ID:가슴사이즈 = -1
				PRINTFORMW %CALLNAME:캐릭터_ID%의 가슴은【빈유】가 되었다
			ENDIF
		ELSEIF カップ >= CUPLEVEL_BUSTSIZE(0) && BUST_SIZE(캐릭터_ID) == -1
			IF 限界値_가슴AWS == 0 || 限界値_가슴AWS >= 7000 || CANUP_AWS_TALENT_BUST(0)
				TALENT:캐릭터_ID:가슴사이즈 = 0
				PRINTFORMW %CALLNAME:캐릭터_ID%의 가슴은【평유】가 되었다
			ENDIF
		ELSEIF カップ >= CUPLEVEL_BUSTSIZE(1) && BUST_SIZE(캐릭터_ID) == 0
			IF 限界値_가슴AWS == 0 || 限界値_가슴AWS >= 8000 || CANUP_AWS_TALENT_BUST(1)
				TALENT:캐릭터_ID:가슴사이즈 = 1
				PRINTFORMW %CALLNAME:캐릭터_ID%의 가슴은【거유】가 되었다
			ENDIF
		ELSEIF カップ >= CUPLEVEL_BUSTSIZE(2) && BUST_SIZE(캐릭터_ID) == 1
			IF 限界値_가슴AWS == 0 || 限界値_가슴AWS >= 9500 || CANUP_AWS_TALENT_BUST(2)
				TALENT:캐릭터_ID:가슴사이즈 = 2
				PRINTFORMW %CALLNAME:캐릭터_ID%의 가슴은【폭유】가 되었다
			ENDIF
		ELSEIF カップ >= CUPLEVEL_BUSTSIZE(3) && BUST_SIZE(캐릭터_ID) == 2
			IF 限界値_가슴AWS == 0 || 限界値_가슴AWS >= 12000 || CANUP_AWS_TALENT_BUST(3)
				TALENT:캐릭터_ID:가슴사이즈 = 3
				PRINTFORMW %CALLNAME:캐릭터_ID%의 가슴은【소젖】이 되었다

				IF RAND:3 == 0
					TALENT:캐릭터_ID:함몰유두 = 1
					PRINTFORMW 거기에、 %CALLNAME:캐릭터_ID%의 젖꼭지는 함몰되어 버렸다……。
				ENDIF
			ENDIF
		ELSEIF カップ >= 18 && BUST_SIZE(캐릭터_ID) == 3 && CFLAG:캐릭터_ID:가슴성장 < 1000 && TALENT:캐릭터_ID:모유체질 == 0
			IF 限界値_가슴AWS == 0 || 限界値_가슴AWS >= 15000
				TALENT:캐릭터_ID:모유체질 = 1
				PRINTFORMW %CALLNAME:캐릭터_ID%의 가슴은 우유가 떨어지게 되었다
			ENDIF
		ELSEIF カップ >= CUPLEVEL_BUSTSIZE(4) && BUST_SIZE(캐릭터_ID) == 3 || CANUP_AWS_TALENT_BUST(4)
			IF 限界値_가슴AWS == 0 || 限界値_가슴AWS >= 15000
				TALENT:캐릭터_ID:가슴사이즈 = 4
				PRINTFORML %CALLNAME:캐릭터_ID%의 가슴은【마유】가 되었다
			ENDIF
		ELSEIF カップ >= CUPLEVEL_BUSTSIZE(5) && BUST_SIZE(캐릭터_ID) == 4 || CANUP_AWS_TALENT_BUST(5)
			IF 限界値_가슴AWS == 0 || 限界値_가슴AWS >= 20000
				TALENT:캐릭터_ID:가슴사이즈 = 5
				PRINTFORML %CALLNAME:캐릭터_ID%의 가슴은 이미【규격외】이다！
			ENDIF
		ENDIF
	NEXT
ENDIF

;-------------------------------------------------
;ケツ성장
;-------------------------------------------------
@BUTT_UP_BODYSIZE()
#DIM DYNAMIC 캐릭터_ID
#DIM DYNAMIC お엉덩이
#DIM DYNAMIC 基準値
#DIM DYNAMIC お엉덩이レベル

IF オプション_尻AWS == 1
	FOR 캐릭터_ID,0,CHARANUM
		SIF TALENT:캐릭터_ID:성별 == 2
			CONTINUE
		SIF CFLAG:캐릭터_ID:엉덩이성장 < 1
			CONTINUE
			お엉덩이レベル = CALC_HIPSIZE_LEVEL(캐릭터_ID)
		IF お엉덩이レベル >= 100 && TALENT:캐릭터_ID:엉덩이사이즈 == -1
			IF 限界値_尻AWS == 0 || 限界値_尻AWS >= 7000 || CANUP_AWS_TALENT_HIP(0)
				TALENT:캐릭터_ID:엉덩이사이즈 = 0
				PRINTFORMW %CALLNAME:캐릭터_ID%의 엉덩이는【빈약한 엉덩이】가 되었다
			ENDIF
		ELSEIF お엉덩이レベル >= 108 && TALENT:캐릭터_ID:엉덩이사이즈 == 0
			IF 限界値_尻AWS == 0 || 限界値_尻AWS >= 8000 || CANUP_AWS_TALENT_HIP(1)
				TALENT:캐릭터_ID:엉덩이사이즈 = 1
				PRINTFORMW %CALLNAME:캐릭터_ID%의 엉덩이는【순산형】이 되었다
				IF TALENT:캐릭터_ID:허벅지사이즈 < 1
					PRINTFORMW 거기에 %CALLNAME:캐릭터_ID%의 허벅지는【커다란 허벅지】가 되었다
				ENDIF
			ENDIF
		ELSEIF お엉덩이レベル >= 115 && TALENT:캐릭터_ID:엉덩이사이즈 == 1
			IF 限界値_尻AWS == 0 || 限界値_尻AWS >= 9500 || CANUP_AWS_TALENT_HIP(2)
				TALENT:캐릭터_ID:엉덩이사이즈 = 2
				PRINTFORMW %CALLNAME:캐릭터_ID%의 엉덩이는【커다란 엉덩이】가 되었다
				IF TALENT:캐릭터_ID:허벅지사이즈 < 2
					PRINTFORMW 거기에 %CALLNAME:캐릭터_ID%의 허벅지는【두툼한 허벅지】가 되었다
				ENDIF
			ENDIF
		ELSEIF お엉덩이レベル >= 130 && TALENT:캐릭터_ID:엉덩이사이즈 == 2
			IF 限界値_尻AWS == 0 || 限界値_尻AWS >= 12000 || CANUP_AWS_TALENT_HIP(3)
				TALENT:캐릭터_ID:엉덩이사이즈 = 3
				PRINTFORMW %CALLNAME:캐릭터_ID%의 엉덩이는 이제【질량병기】이다！
				PRINTFORMW 본인 앞에서 말했더니 혼났다………。
				IF TALENT:캐릭터_ID:허벅지사이즈 < 3
					PRINTFORMW 거기에 %CALLNAME:캐릭터_ID%의 허벅지는【두꺼운 허벅지】가 되었다！
					PRINTFORMW 또 혼났다……。
				ENDIF
			ENDIF
		ENDIF
	NEXT
ENDIF

;-------------------------------------------------
;가슴성장増加
;-------------------------------------------------
@BUST_UP_AWS(캐릭터ID,値)
#DIM DYNAMIC 캐릭터ID
#DIM DYNAMIC 値

;そもそも성장機能オフ
SIF !オプション_가슴AWS
	RETURN

;数値지정条件
SIF 限界値_가슴AWS > 0 && 限界値_가슴AWS < CFLAG:캐릭터ID:가슴초기치 + CFLAG:캐릭터ID:가슴성장 + 値
	RETURN

;素質지정条件
IF 限界値_가슴AWS / 10 == -1 && TOINT_CUPSIZE(캐릭터ID,値) >= CUPLEVEL_BUSTSIZE((限界値_가슴AWS + 14) * -1)
	RETURN
ELSEIF 限界値_가슴AWS / 10 == -2 && TOINT_CUPSIZE(캐릭터ID) >= CUPLEVEL_BUSTSIZE((限界値_가슴AWS + 24) * -1)
	RETURN
ENDIF

CFLAG:캐릭터ID:가슴성장 += 値

;-------------------------------------------------
;엉덩이성장増加
;-------------------------------------------------
@HIP_UP_AWS(캐릭터ID,値)
#DIM DYNAMIC 캐릭터ID
#DIM DYNAMIC 値

;そもそも성장機能オフ
SIF !オプション_尻AWS
	RETURN

;数値지정条件
SIF 限界値_尻AWS > 0 && 限界値_尻AWS < CFLAG:캐릭터ID:엉덩이초기치 + CFLAG:캐릭터ID:엉덩이성장 + 値
	RETURN

;素質지정条件
IF 限界値_尻AWS / 10 == -1
	SELECTCASE (限界値_尻AWS + 22) * -1
		CASE -1
			RETURN
		CASE 0 ;並엉덩이
			SIF CALC_HIPSIZE_LEVEL(캐릭터ID,値) >= 100
				RETURN
		CASE 1 ;安産型
			SIF CALC_HIPSIZE_LEVEL(캐릭터ID,値) >= 108
				RETURN
		CASE 2 ;デカケツ
			SIF CALC_HIPSIZE_LEVEL(캐릭터ID,値) >= 115
				RETURN
		CASE 3 ;デカケツ
			SIF CALC_HIPSIZE_LEVEL(캐릭터ID,値) >= 130
				RETURN
	ENDSELECT
ELSEIF 限界値_尻AWS / 10 == -2
	SELECTCASE (限界値_尻AWS + 12) * -1
		CASE -1
			RETURN
		CASE 0 ;並엉덩이
			SIF CALC_HIPSIZE_LEVEL(캐릭터ID) >= 100
				RETURN
		CASE 1 ;安産型
			SIF CALC_HIPSIZE_LEVEL(캐릭터ID) >= 108
				RETURN
		CASE 2 ;デカケツ
			SIF CALC_HIPSIZE_LEVEL(캐릭터ID) >= 115
				RETURN
		CASE 3 ;デカケツ
			SIF CALC_HIPSIZE_LEVEL(캐릭터ID) >= 130
				RETURN
	ENDSELECT
ENDIF

CFLAG:캐릭터ID:엉덩이성장 += 値

;-------------------------------------------------
;가슴のAWSオプション설정値を文字列化して返す
;-------------------------------------------------
@TOSTR_AWS_TALENT_BUST
#FUNCTIONS
#DIMS DYNAMIC 文字列

SELECTCASE 限界値_가슴AWS
	CASE 0
		文字列 = 【한계 설정 없음】
	CASE IS > 0
		文字列 = %"【"+TOSTR((限界値_가슴AWS)/10)+"mm ("+DECIMAL_STRING(限界値_가슴AWS,2)+"cm)】"%
	CASE IS < 0
		IF 限界値_가슴AWS < -20
			文字列 = %"【≪"+TOSTR_BUSTSIZE_FROMINT((限界値_가슴AWS + 24) * -1)+"≫가 될때까지】"%
		ELSEIF 限界値_가슴AWS < -10
			文字列 = %"【≪"+TOSTR_BUSTSIZE_FROMINT((限界値_가슴AWS + 14) * -1)+"≫직전까지】"%
		ENDIF
ENDSELECT

RETURNF 文字列

;-------------------------------------------------
;엉덩이のAWSオプション설정値を文字列化して返す
;-------------------------------------------------
@TOSTR_AWS_TALENT_HIP
#FUNCTIONS
#DIMS DYNAMIC 文字列

SELECTCASE 限界値_尻AWS
	CASE 0
		文字列 = 【한계 설정 없음】
	CASE IS > 0
		文字列 = %"【"+TOSTR((限界値_尻AWS)/10)+"mm ("+DECIMAL_STRING(限界値_尻AWS,2)+"cm)】"%
	CASE IS < 0
		IF 限界値_尻AWS < -20
			文字列 = %"【≪"+TOSTR_HIPSIZE_FROMINT((限界値_尻AWS + 22) * -1)+"≫가 될때까지】"%
		ELSEIF 限界値_尻AWS < -10
			文字列 = %"【≪"+TOSTR_HIPSIZE_FROMINT((限界値_尻AWS + 12) * -1)+"≫직전까지】"%
		ENDIF
ENDSELECT

RETURNF 文字列

;-------------------------------------------------
;가슴のAWSオプション素質설정値から素質성장してよいかを返す
;-------------------------------------------------
@CANUP_AWS_TALENT_BUST(판정素質)
#FUNCTION
#DIM DYNAMIC 판정素質

;数値설정は別途
SIF 限界値_가슴AWS >= 0
	RETURNF 1
;変な値ははじく(虚가슴は성장とか以前なのでそれもはじく)
SIF !INRANGE(판정素質,-2,5)
	RETURNF 0
IF INRANGE(限界値_가슴AWS,-21,(판정素質+4)*-1-19) || INRANGE(限界値_가슴AWS,-11,(판정素質+4)*-1-10)
	RETURNF 0
ELSE
	RETURNF 1
ENDIF

;-------------------------------------------------
;엉덩이のAWSオプション素質설정値から素質성장してよいかを返す
;-------------------------------------------------
@CANUP_AWS_TALENT_HIP(판정素質)
#FUNCTION
#DIM DYNAMIC 판정素質

;数値설정は別途
SIF 限界値_尻AWS >= 0
	RETURNF 1
;変な値ははじく(貧엉덩이は성장とか以前なのでそれもはじく)
SIF !INRANGE(판정素質,0,3)
	RETURNF 0
IF INRANGE(限界値_尻AWS,-21,(판정素質+2)*-1-19) || INRANGE(限界値_尻AWS,-11,(판정素質+2)*-1-10)
	RETURNF 0
ELSE
	RETURNF 1
ENDIF