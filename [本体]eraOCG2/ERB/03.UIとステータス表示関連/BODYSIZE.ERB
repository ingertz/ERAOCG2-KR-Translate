;-------------------------------------------------
;お엉덩이レベル(身長からの基準値に対する割合)を返す変数
;-------------------------------------------------
@CALC_HIPSIZE_LEVEL(대상,보정値)
#FUNCTION
#DIM DYNAMIC 대상
#DIM DYNAMIC お엉덩이
#DIM DYNAMIC 基準値
#DIM DYNAMIC 보정値

お엉덩이 = (CFLAG:대상:엉덩이초기치 + CFLAG:대상:엉덩이성장) + 보정値
基準値 = CFLAG:대상:신장초기치 * 53 / 100
IF 基準値 > 0
	RETURNF お엉덩이 * 100 / 基準値
ELSE
	RETURNF -1
ENDIF

;-------------------------------------------------
;整数ARG:0の下からARG:1番目に小数点を打ち、その値を文字列として返す関数
;-------------------------------------------------
@DECIMAL_STRING(ARG:0, ARG:1)
#FUNCTIONS
IF ARG:1 <= 0
	THROW "@DECIMAL_STRING의 두번째 인수에 0이하의 값이 지정되었습니다({ARG:1})"
ENDIF

LOCAL:4 = ARG:0

LOCAL:2 = POWER(10, ARG:1)
LOCAL:3 = LOCAL:4 / LOCAL:2
LOCAL:4 = LOCAL:4 - LOCAL:3 * LOCAL:2
LOCALS:0 = {LOCAL:3}.

FOR LOCAL:0, ARG:1 - 1, 0, -1
	LOCAL:2 = POWER(10, LOCAL:0)
	LOCAL:3 = LOCAL:4 / LOCAL:2
	LOCAL:4 = LOCAL:4 - LOCAL:3 * LOCAL:2
	LOCALS:0 = %LOCALS:0%{LOCAL:3}
NEXT
LOCALS:0 = %LOCALS:0%{LOCAL:4}
RETURNF LOCALS:0

;-------------------------------------------------
;가슴사이즈(素質)を数値から文字列に変換して返す式中関数
;-------------------------------------------------
@TOSTR_BUSTSIZE(대상)
#FUNCTIONS
#DIM DYNAMIC 대상

RETURNF TOSTR_BUSTSIZE_FROMINT(BUST_SIZE(대상))

;-------------------------------------------------
;가슴사이즈を直接数値から文字列に変換して返す式中関数
;-------------------------------------------------
@TOSTR_BUSTSIZE_FROMINT(数値)
#FUNCTIONS
#DIM DYNAMIC 数値
#DIMS DYNAMIC 가슴사이즈

SELECTCASE 数値
	CASE -3 ;虚가슴(--)
		가슴사이즈 = 虚가슴
	CASE -2 ;絶壁(--~AA)
		가슴사이즈 = 絶壁
	CASE -1 ;貧乳(AA~B)
		가슴사이즈 = 貧乳
	CASE 0 ;普乳(B~D)
		가슴사이즈 = 普乳
	CASE 1 ;巨乳(D~G)
		가슴사이즈 = 巨乳
	CASE 2 ;爆乳(G~L)
		가슴사이즈 = 爆乳
	CASE 3 ;ウシ乳(L~R)
		가슴사이즈 = ウシ乳
	CASE 4 ;魔乳(R~Z)
		가슴사이즈 = 魔乳
	CASE 5 ;規格外（乳）(Z~)
		가슴사이즈 = 規格外（乳）
ENDSELECT

RETURNF 가슴사이즈

;-------------------------------------------------
;各가슴사이즈の基準カップを数値で返す変数
;-------------------------------------------------
@CUPLEVEL_BUSTSIZE(数値)
#FUNCTION
#DIM DYNAMIC 数値

SELECTCASE 数値
	CASE -3 ;虚가슴(--)
		RETURNF 0
	CASE -2 ;絶壁(--~AA)
		RETURNF 1
	CASE -1 ;貧乳(AA~B)
		RETURNF 3
	CASE 0 ;普乳(B~D)
		RETURNF 5
	CASE 1 ;巨乳(D~G)
		RETURNF 7
	CASE 2 ;爆乳(G~L)
		RETURNF 10
	CASE 3 ;ウシ乳(L~R)
		RETURNF 15
	CASE 4 ;魔乳(R~Z)
		RETURNF 21
	CASE 5 ;規格外（乳）(Z~)
		RETURNF 29
ENDSELECT


