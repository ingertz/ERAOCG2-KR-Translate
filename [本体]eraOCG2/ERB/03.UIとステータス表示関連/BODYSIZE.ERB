SELECTCASE TALENT:대상:체형
	CASE -3 ;小人
		TIMES 基礎値, 1.10
	CASE -2 ;幼児체형
		TIMES 基礎値, 1.05
	CASE -1 ;小柄체형
		TIMES 基礎値, 0.95
	CASE 0 ;普通
	CASE 1 ;長身
		TIMES 基礎値, 1.03
	CASE 2 ;大柄
		TIMES 基礎値, 1.07
	CASE 3 ;巨人
		TIMES 基礎値, 1.15
ENDSELECT

SELECTCASE TALENT:대상:몸두께
	CASE 0 ;標準
	CASE 1 ;太り気味
		TIMES 基礎値, 1.08
	CASE 2 ;むちむち
		TIMES 基礎値, 1.15
	CASE 3 ;むっちり
		TIMES 基礎値, 1.2
	CASE 4 ;ぽってり
		TIMES 基礎値, 1.25
	CASE 5 ;운동しろ
		TIMES 基礎値, 1.3
ENDSELECT

