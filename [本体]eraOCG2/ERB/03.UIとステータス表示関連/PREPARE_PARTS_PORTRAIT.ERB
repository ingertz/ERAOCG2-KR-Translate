@DISPLAY_PARTS_PORTRAIT(캐릭터_ID)
#DIM DYNAMIC 캐릭터_ID
#DIM カウンタ
#DIMS PARTS = "A", "B", "C", "V"
#DIMS CURR_PARTS
#DIMS PRE_PARTS

; 引数
; GDI値
; 30 ~ 33
; ABCV
SIF TALENT:캐릭터_ID:성별 == 2
	RETURN 0

CURR_PARTS = %GET_TALENTNAME(128,TALENT:캐릭터_ID:엉덩이사이즈)%,%GET_TALENTNAME(121,TALENT:캐릭터_ID:가슴사이즈)%,,
IF PRE_PARTS != CURR_PARTS
	CALL PREPARE_PARTS_PORTRAIT(캐릭터_ID)
	PRE_PARTS = %CURR_PARTS%
	DEBUGPRINTFORML REFRESH PARTS
ENDIF
DEBUGPRINTFORML %PRE_PARTS%

FOR カウンタ, 0, 2
	LOCALS = <div height='{(PORTRAIT_표시サイズ)*60 +200}' width='{(PORTRAIT_표시サイズ)*100 +200}' border='15' margin='35' padding='2px,2px,2px,0' xpos='{(カウンタ)*(PORTRAIT_표시サイズ+2)*100}'><shape type='space' param='50'><img src='parts_%PARTS:カウンタ%' srcb='' height='{(PORTRAIT_표시サイズ)*60}' width='{(PORTRAIT_표시サイズ)*100}' ypos='7px'></div>
	HTML_PRINT LOCALS,30
NEXT

@PREPARE_PARTS_PORTRAIT(캐릭터_ID)
#DIM DYNAMIC 캐릭터_ID
	CALL PREPARE_A_PORTRAIT(캐릭터_ID)
	CALL PREPARE_B_PORTRAIT(캐릭터_ID)
	CALL PREPARE_C_PORTRAIT(캐릭터_ID)
	CALL PREPARE_V_PORTRAIT(캐릭터_ID)

@PREPARE_A_PORTRAIT(캐릭터_ID)
#DIM DYNAMIC 캐릭터_ID
	LOCALS '= @"%GET_TALENTNAME(128,TALENT:캐릭터_ID:엉덩이사이즈)%"
	IF LOCALS == ""
		LOCALS '= "並尻"
	ENDIF
	SPRITEDISPOSE "parts_A"
	GDISPOSE 500
	DEBUGPRINTFORML parts_A_%LOCALS%
	IF ENUMFILES("RESOURCES/PARTS", @"parts_A_%LOCALS%.*")
		SPLIT RESULTS, "\\", RESULTS
		GCREATEFROMFILE 500, "parts/"+RESULTS:(RESULT-1)
		SPRITECREATE "parts_A", 500
	ENDIF

@PREPARE_B_PORTRAIT(캐릭터_ID)
#DIM DYNAMIC 캐릭터_ID
	LOCALS '= @"%GET_TALENTNAME(121,TALENT:캐릭터_ID:가슴사이즈)%"
	IF LOCALS == ""
		LOCALS '= "普乳"
	ENDIF
	SPRITEDISPOSE "parts_B"
	GDISPOSE 501
	IF ENUMFILES("RESOURCES/PARTS", @"parts_B_%LOCALS%.*")
		SPLIT RESULTS, "\\", RESULTS
		GCREATEFROMFILE 501, "parts/"+RESULTS:(RESULT-1)
		SPRITECREATE "parts_B", 501
	ENDIF
	
