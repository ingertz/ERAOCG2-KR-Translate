#DIM DYNAMIC 캐릭터_ID
	SPRITEDISPOSE "parts_C"
	GDISPOSE 502
	IF ENUMFILES("RESOURCES/PARTS", @"parts_C.*")
		SPLIT RESULTS, "\\", RESULTS
		GCREATEFROMFILE 502, "parts/"+RESULTS:(RESULT-1)
		SPRITECREATE "parts_C", 502
	ENDIF

@PREPARE_V_PORTRAIT(캐릭터_ID)
#DIM DYNAMIC 캐릭터_ID
	SPRITEDISPOSE "parts_V"
	GDISPOSE 503
	IF ENUMFILES("RESOURCES/PARTS", @"parts_V.*")
		SPLIT RESULTS, "\\", RESULTS
		GCREATEFROMFILE 503, "parts/"+RESULTS:(RESULT-1)
		SPRITECREATE "parts_V", 503
	ENDIF