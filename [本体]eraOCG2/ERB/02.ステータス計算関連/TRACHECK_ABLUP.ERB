@SOURCE_ABLUP(캐릭터_ID)
#DIM DYNAMIC 캐릭터_ID

IF ABL:캐릭터_ID:신체능력 < 6
	IF EXP:캐릭터_ID:운동경험 > EXPLV:(ABL:캐릭터_ID:신체능력 + 3) || (EXP:캐릭터_ID:운동경험 > 5 && ABL:캐릭터_ID:신체능력 == 0)
		ABL:캐릭터_ID:신체능력 ++
		PRINTFORMW %CALLNAME:캐릭터_ID%의 신체능력이 LV{ABL:캐릭터_ID:신체능력}이 되었습니다
	ENDIF
ENDIF
IF ABL:캐릭터_ID:화술기능 < 6
	IF EXP:캐릭터_ID:대화경험 > EXPLV:(ABL:캐릭터_ID:화술기능 + 3)
		ABL:캐릭터_ID:화술기능 ++
		PRINTFORMW %CALLNAME:캐릭터_ID%의 화술기능이 LV{ABL:캐릭터_ID:화술기능}이 되었습니다
	ENDIF
ENDIF

IF ABL:캐릭터_ID:청소기능 < 5
	IF EXP:캐릭터_ID:청소경험 > EXPLV:(ABL:캐릭터_ID:청소기능 + 3)
		ABL:캐릭터_ID:청소기능 ++
		PRINTFORMW %CALLNAME:캐릭터_ID%의 청소기능이 LV{ABL:캐릭터_ID:청소기능}이 되었습니다
	ENDIF
ENDIF
IF ABL:캐릭터_ID:교양 < 6
	IF EXP:캐릭터_ID:학습경험 > EXPLV:(ABL:캐릭터_ID:교양 + 3) || (EXP:캐릭터_ID:학습경험 > 5 && ABL:캐릭터_ID:교양 == 0)
		ABL:캐릭터_ID:교양 ++
		PRINTFORMW %CALLNAME:캐릭터_ID%의 교양이 LV{ABL:캐릭터_ID:교양}이 되었습니다
		SIF ABL:캐릭터_ID:교양 == 1
			PRINTW 최음약을 쓸 수 있게 되었습니다
	ENDIF
ENDIF
IF ABL:캐릭터_ID:요리기능 < 6
	IF EXP:캐릭터_ID:요리경험 > EXPLV:(ABL:캐릭터_ID:요리기능 + 3) || (EXP:캐릭터_ID:요리경험 > 5 && ABL:캐릭터_ID:요리기능 == 0)
		ABL:캐릭터_ID:요리기능 ++
		PRINTFORMW %CALLNAME:캐릭터_ID%의 요리기능이 LV{ABL:캐릭터_ID:요리기능}이 되었습니다
	ENDIF
ENDIF
IF ABL:캐릭터_ID:손가락 < 6
	LOCAL = EXP:캐릭터_ID:수음경험
	LOCAL:1 = 10 + ABL:캐릭터_ID:기교 / 2 + TALENT:캐릭터_ID:솜씨좋은손가락 * 2 + TALENT:캐릭터_ID:습득속도
	IF LOCAL * LOCAL:1 / 10 > EXPLV:(ABL:캐릭터_ID:손가락 + 3) / 2 && EXP_UP(24,캐릭터_ID)
		ABL:캐릭터_ID:손가락 ++
		PRINTFORMW %CALLNAME:캐릭터_ID%은 손재주가 생겼다
		IF ABL:캐릭터_ID:손가락 >= 5
			PRINTFORMW %CALLNAME:캐릭터_ID%은 [솜씨좋은 손가락]을 얻었다
			TALENT:캐릭터_ID:솜씨좋은손가락 = 1
		ENDIF
	ENDIF
ENDIF
IF ABL:캐릭터_ID:혀 < 6
	LOCAL = EXP:캐릭터_ID:펠라경험
	LOCAL:1 = 10 + ABL:캐릭터_ID:기교 / 2 + TALENT:캐릭터_ID:혀사용자 * 2 + TALENT:캐릭터_ID:습득속도
	IF  LOCAL * LOCAL:1 / 10 > EXPLV:(ABL:캐릭터_ID:혀 + 3) && EXP_UP(25,캐릭터_ID)
		ABL:캐릭터_ID:혀 ++
		PRINTFORMW %CALLNAME:캐릭터_ID%의 혀가 재주를 부렸다
		IF ABL:캐릭터_ID:혀 >= 5
			PRINTFORMW %CALLNAME:캐릭터_ID%은 [혀사용자]을 얻었다
			TALENT:캐릭터_ID:혀사용자 = 1
		ENDIF
	ENDIF
ENDIF
IF ABL:캐릭터_ID:가슴 < 6
	LOCAL = EXP:캐릭터_ID:파이즈리경험 * 2 +  EXP:캐릭터_ID:Ｂ경험 / 5
	LOCAL:1 = 10 + ABL:캐릭터_ID:기교 / 2 + BUST_SIZE(캐릭터_ID) + TALENT:캐릭터_ID:습득속도
	IF LOCAL * LOCAL:1 / 10 > EXPLV:(ABL:캐릭터_ID:가슴 + 3) && EXP:캐릭터_ID:파이즈리경험 >  EXPLV:(ABL:캐릭터_ID:가슴 + 1) && EXP_UP(26,캐릭터_ID)
		ABL:캐릭터_ID:가슴 ++
		PRINTFORMW %CALLNAME:캐릭터_ID%가 가슴을 이용한 성 기술이 늘어난 것 같다
		IF ABL:캐릭터_ID:가슴 >= 5
			PRINTFORMW %CALLNAME:캐릭터_ID%은 [음유]를 얻었다
			TALENT:캐릭터_ID:음유 = 1
		ENDIF
	ENDIF
ENDIF
IF ABL:캐릭터_ID:허리 < 6
	LOCAL = EXP:캐릭터_ID:Ｖ성교경험 +  EXP:캐릭터_ID:Ａ성교경험
	LOCAL:1 = 10 + ABL:캐릭터_ID:기교 / 2 + TALENT:캐릭터_ID:습득속도
	IF LOCAL * LOCAL:1 / 10 > EXPLV:(ABL:캐릭터_ID:허리 + 3)
		ABL:캐릭터_ID:허리 ++
		PRINTFORMW %CALLNAME:캐릭터_ID%의 허리놀림이 좋아졌다
	ENDIF
ENDIF
IF ABL:캐릭터_ID:질 < 6
	;広げすぎるとガバガバになっちゃいますよ
	LOCAL = EXP:캐릭터_ID:Ｖ성교경험  * 2 +  EXP:캐릭터_ID:Ｖ경험 / 5 + (EXP:캐릭터_ID:Ｖ확장경험 <= 10 ? EXP:캐릭터_ID:Ｖ확장경험 * 5 # 100 - EXP:캐릭터_ID:Ｖ확장경험)
	LOCAL:1 = 10 + ABL:캐릭터_ID:기교 / 2 + TALENT:캐릭터_ID:습득속도
	IF LOCAL * LOCAL:1 / 10 > EXPLV:(ABL:캐릭터_ID:질 + 3) && EXP:캐릭터_ID:Ｖ성교경험 >  EXPLV:(ABL:캐릭터_ID:질 + 1) && EXP_UP(20,캐릭터_ID)
		ABL:캐릭터_ID:질 ++
		PRINTFORMW %CALLNAME:캐릭터_ID%의 성교 기술이 늘어난 것 같다
		IF ABL:캐릭터_ID:질 >= 5
			PRINTFORMW %CALLNAME:캐릭터_ID%은 [음호]를 얻었다
			TALENT:캐릭터_ID:음호 = 1
		ENDIF
	ENDIF
ENDIF
IF ABL:캐릭터_ID:애널 < 6
	LOCAL = EXP:캐릭터_ID:Ａ성교경험  * 2 +  EXP:캐릭터_ID:Ａ경험 / 5 + (EXP:캐릭터_ID:Ａ확장경험 <= 25 ? EXP:캐릭터_ID:Ａ확장경험 * 2 # 100 - EXP:캐릭터_ID:Ａ확장경험)
	LOCAL:1 = 10 + ABL:캐릭터_ID:기교 / 2 + TALENT:캐릭터_ID:습득속도
	IF LOCAL * LOCAL:1 / 10 > EXPLV:(ABL:캐릭터_ID:애널 + 3) && EXP:캐릭터_ID:Ａ성교경험 > EXPLV:(ABL:캐릭터_ID:애널 + 1) && EXP_UP(21,캐릭터_ID)
		ABL:캐릭터_ID:애널 ++
		PRINTFORMW %CALLNAME:캐릭터_ID%의 항문을 이용한 성교 기술이 늘어난 것 같다
		IF ABL:캐릭터_ID:애널 >= 5
			PRINTFORMW %CALLNAME:캐릭터_ID%은 [엉덩이광]을 얻었다
			TALENT:캐릭터_ID:엉덩이광 = 1
		ENDIF
	ENDIF
ENDIF
