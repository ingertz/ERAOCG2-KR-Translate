;XON_BUTTON
;PRINTBUTTON を使用して、１文字だけ出力する
;
;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
@XON_BUTTON(文字名,ボタン値,色지정 = -1)
#DIMS DYNAMIC 文字名
#DIM DYNAMIC ボタン値
#DIM DYNAMIC 色지정
#DIM DYNAMIC UNI文字数値
#DIMS DYNAMIC UNI文字
#DIMS DYNAMIC フォント保持
#DIM DYNAMIC 色保持

;現在のフォント・色を保持
フォント保持 = %GETFONT()%

IF !CHKFONT("xonFont")
	PRINTL フォント読み込み失敗。fontフォルダを確認してください。
	RETURN 0
ENDIF

SETFONT "xonFont"

IF 色지정 != -1
	色保持 = GETCOLOR()
	SETCOLOR 色지정
ENDIF

;フォントの文字コードを취득
CALL XON_FONT(文字名,,5)
UNICODE RESULT
UNI文字 = %RESULTS%
PRINTBUTTON UNI文字,ボタン値

;最後にフォントを戻す
SETFONT フォント保持
SIF 色지정 != -1
	SETCOLOR 色保持
	

