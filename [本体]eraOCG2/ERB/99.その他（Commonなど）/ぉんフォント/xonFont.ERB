;XON_C_COLOR_MAP_TIME
;XON_C_COLOR_MAP_TIMEをリゾート用のぉんフォントが使用できるに改変したもの
;
;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
@XON_C_COLOR_MAP_TIME(文字名,デフォルトカラー,昼,夕,夜)
#DIMS DYNAMIC 文字名
#DIM  デフォルトカラー
#DIM  昼
#DIM  夕
#DIM  夜

SIF デフォルトカラー == 0
	デフォルトカラー = C_WHITE

SIF 昼 == 0
	昼 = デフォルトカラー
SIF 夕 == 0
	夕 = デフォルトカラー
SIF 夜 == 0
	夜 = デフォルトカラー

IF TIME >= KANTAN_TIME(5,00) && TIME < KANTAN_TIME(16,00)
	CALL XON_FONT(文字名,昼)
ELSEIF TIME >= KANTAN_TIME(16,00) && TIME < KANTAN_TIME(19,00)
	CALL XON_FONT(文字名,夕)
ELSE
	CALL XON_FONT(文字名,夜)
ENDIF

;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
;XON_C_COLOR_MAP_TIME_RESORT
;C_COLOR_MAPをリゾート用のぉんフォントが使用できるに改変したもの
;
;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
@XON_C_COLOR_MAP_TIME_RESORT(文字名,昼 = C_WHITE,夕 = C_GROUND_T ,夜 = C_GISK_BLUE)
#DIMS DYNAMIC 文字名
#DIM  昼
#DIM  夕
#DIM  夜

IF TIME >= KANTAN_TIME(5,00) && TIME < KANTAN_TIME(16,00)
	CALL XON_FONT(文字名,昼)
ELSEIF TIME >= KANTAN_TIME(16,00) && TIME < KANTAN_TIME(19,00)
	CALL XON_FONT(文字名,夕)
ELSE
	CALL XON_FONT(文字名,夜)
ENDIF


