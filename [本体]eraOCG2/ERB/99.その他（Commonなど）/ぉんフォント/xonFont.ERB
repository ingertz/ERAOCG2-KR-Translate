;XON_HTML_BUTTON
;HTML_PRINT を使用して、アイコン付きボタンを作成する
;
;０：PRINTFORML
;２：PRINTFORM
;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
@XON_HTML_BUTTONL(文字名,ボタン値,色지정 = -1)
#DIMS DYNAMIC 文字名
#DIM DYNAMIC ボタン値
#DIM DYNAMIC 色지정
CALL XON_HTML_BUTTON(文字名,ボタン値,色지정,0)

@XON_HTML_BUTTON(文字名,ボタン値,色지정 = -1,出力方式 = 2)
#DIMS DYNAMIC 文字名
#DIMS DYNAMIC 文字名s ,50
#DIMS DYNAMIC 文字名称
#DIM DYNAMIC ボタン値
#DIM DYNAMIC 色지정
#DIMS DYNAMIC 色지정文字
#DIMS DYNAMIC 出力文字
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 出力方式

IF !CHKFONT("xonFont")
	PRINTL フォント読み込み失敗。fontフォルダを確認してください。
	RETURN 0
ENDIF

IF 色지정 == -1
	色지정 = GETCOLOR()
ENDIF

SPLIT 文字名, ",", 文字名s

FOR カウンタ,0,VARSIZE("文字名s")-1
	SIF 文字名s:カウンタ == ""
		BREAK
	文字名称 '= 文字名s:カウンタ
	
	;フォントの文字コードを취득
	CALL XON_FONT(文字名称,,5)
	IF RESULT != 0
		UNICODE RESULT
		出力文字 = %出力文字%<font face='xonFont'>%RESULTS%</font>
	ELSE
		出力文字 = %出力文字%%文字名称%
	ENDIF
	
NEXT
;PRINTFORML 色지정{色지정}
CALL XON_COLOR_HEX(色지정)
色지정文字 = %RESULTS%

;PRINTFORML 色지정文字%色지정文字%
出力文字 = <font color='%色지정文字%'><button value='{ボタン値}'>%出力文字%</button></font>
IF 出力方式 == 2
	HTML_PRINT 出力文字,1
ELSE
	HTML_PRINT 出力文字
ENDIF
;-------------------------------------------------------
; 数値カラー → "#RRGGBB" 形式の文字列へ変換
; 例：
;   COLOR_INT_TO_HEXSTRING( 16777215 ) → "#FFFFFF"
;-------------------------------------------------------

@XON_COLOR_HEX(値)
#DIM DYNAMIC 値
#DIM DYNAMIC 赤
#DIM DYNAMIC 緑
#DIM DYNAMIC 青
#DIMS DYNAMIC 赤文字
#DIMS DYNAMIC 緑文字
#DIMS DYNAMIC 青文字
#DIMS DYNAMIC HEXSTRING

; R, G, B を分離
赤 = (値 / 65536) % 256
緑 = (値 / 256) % 256
青 = 値 % 256

; 10進 → 2桁16進文字列に変換
CALL XON_HEX2(赤)
赤文字 = %RESULTS%
CALL XON_HEX2(緑)
緑文字 = %RESULTS%
CALL XON_HEX2(青)
青文字 = %RESULTS%

; "#" + R + G + B を連結
HEXSTRING = #%赤文字%%緑文字%%青文字%

RESULTS = %HEXSTRING%

;-------------------------------------------------------
; 10進数0～255 → 2桁16進文字列に変換する補助関数
;-------------------------------------------------------
@XON_HEX2(変換数値)
#DIM DYNAMIC 変換数値
#DIMS DYNAMIC TABLE
#DIMS DYNAMIC h1
#DIMS DYNAMIC h2

; 16進文字テーブル
TABLE = 0123456789ABCDEF

SUBSTRING TABLE, 変換数値 / 16, 1
h1 = %RESULTS%
SUBSTRING TABLE, (変換数値 % 16), 1
h2 = %RESULTS%

RESULTS =%h1%%h2%

