			;グラデ機能用(未対応文字は出力しない)
			IF 出力方式 == 4
				SETFONT フォント保持
				RETURN -1
			ENDIF
			;지정文字が存在しない場合、文字名を返す
			RESULTS = %文字名称%
			該当なし = 1
	ENDSELECT
	
	
	IF 出力方式 == 3
		総文字 = %総文字%%RESULTS%
	ELSEIF 出力方式 == 5
		SETFONT フォント保持
		SIF 色지정 != -1
			SETCOLOR 色保持
		RETURN UNI文字数値
	ELSE
		
		;該当なしの場合、通常のフォントで표시したい文字のため、フォントを一時的に戻す
		IF 該当なし == 1
			SETFONT フォント保持
		ELSE
			UNICODE UNI文字数値
		ENDIF	
		PRINTFORM %RESULTS%
		SIF 該当なし == 1
			SETFONT "xonFont"
	ENDIF
