;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
;XON_GRADATION
;「ぉんフォント」が使用できるグラデーション色표시
;
;仕様：
;初期色：変化する前の色、この色から変化色に徐々に変わっていく。未지정の場合、初期値は白色
;変化色：
;START文字列：初期色で표시する文字列。グラデ文字列が省略されている場合、グラデ文字列として扱われる。
;グラデ文字列：文字色が初期色→変化色に変わっていく。
;END文字列：変化色で표시する文字列
;,出力方式
;０：PRINTFORML
;１：PRINTFORMW
;２：PRINTFORM
;
;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
;PRINTFORMLを使用
@XON_GRADATIONL(初期色 = C_WHITE, 変化色 = C_WHITE, START文字列, グラデ文字列, END文字列)
#DIM DYNAMIC 初期色
#DIM DYNAMIC 変化色
#DIMS DYNAMIC START文字列
#DIMS DYNAMIC グラデ文字列
#DIMS DYNAMIC END文字列

CALL XON_GRADATION(初期色, 変化色, START文字列, グラデ文字列, END文字列,0)
;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
;PRINTFORMWを使用
@XON_GRADATIONW(初期色 = C_WHITE, 変化色 = C_WHITE, START文字列, グラデ文字列, END文字列)
#DIM DYNAMIC 初期色
#DIM DYNAMIC 変化色
#DIMS DYNAMIC START文字列
#DIMS DYNAMIC グラデ文字列
#DIMS DYNAMIC END文字列

CALL XON_GRADATION(初期色, 変化色, START文字列, グラデ文字列, END文字列,1)
;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――

@XON_GRADATION(初期色 = C_WHITE, 変化色 = C_WHITE, START文字列, グラデ文字列, END文字列,出力方式 = 2)
#DIMS DYNAMIC START文字列
#DIMS DYNAMIC グラデ文字列
#DIMS DYNAMIC グラデ文字列_分割 ,50
#DIMS DYNAMIC グラデ文字
#DIMS DYNAMIC END文字列
#DIM DYNAMIC 初期色
#DIM DYNAMIC 変化色
#DIM DYNAMIC 赤色 ,3 ;初期色、変化色、グラデ色
#DIM DYNAMIC 緑色 ,3
#DIM DYNAMIC 青色 ,3
#DIM DYNAMIC 文字長
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC カウンタC
#DIM DYNAMIC 出力方式 = 0 ;0は改行、1は改行(+クリック)、2は無改行

; --- 初期色の RGB を取り出す ---
赤色:0 = (初期色 / 0x10000) % 0x100		;// 上位2桁
緑色:0 = (初期色 / 0x100)   % 0x100		;// 真ん中2桁
青色:0 = 初期色 % 0x100					;// 下位2桁

; --- 変化色の RGB を取り出す ---
赤色:1 = (変化色 / 0x10000) % 0x100		;// 上位2桁
緑色:1 = (変化色 / 0x100)   % 0x100		;// 真ん中2桁
青色:1 = 変化色 % 0x100					;// 下位2桁

;「STARTのみ」or「ENDのみ」or「グラデだけ未入力」なら、全部グラデに詰める
IF (START文字列 != "" && グラデ文字列 == "" && END文字列 == "") ||(START文字列 == "" && グラデ文字列 == "" && END文字列 != "") || (START文字列 != "" && グラデ文字列 == "" && END文字列 != "")
	グラデ文字列 = %START文字列%%END文字列%
	START文字列 =
	END文字列 =
ENDIF

; --- 長さ취득 ---
CALL XON_FONT(グラデ文字列,,3)
文字長 = RESULT

;初期色のみ文字を出力
SETCOLOR 初期色
;PRINTFORM %START文字列%
CALL XON_FONT(START文字列)

SPLIT グラデ文字列, ",", グラデ文字列_分割

; グラデーション
FOR カウンタ,0,VARSIZE("グラデ文字列_分割")-1
	
	;通常モード
	IF 文字長 == 1
		;1文字だけ지정された場合の、0除算対策(文字を出力し、色を変える)
		文字長 = 2
		カウンタC = 1
	ENDIF
	SIF グラデ文字列_分割:カウンタ == ""
		BREAK
	
	グラデ文字 '= グラデ文字列_分割:カウンタ
	
	;カンマ区切りのブロックごとに판정
	赤色:2 = 赤色:0 + (( 赤色:1 - 赤色:0 ) * (カウンタ + カウンタB + カウンタC)) / ( 文字長 - 1 )
	緑色:2 = 緑色:0 + (( 緑色:1 - 緑色:0 ) * (カウンタ + カウンタB + カウンタC)) / ( 文字長 - 1 )
	青色:2 = 青色:0 + (( 青色:1 - 青色:0 ) * (カウンタ + カウンタB + カウンタC)) / ( 文字長 - 1 )
	COLOR_FROMRGB 赤色:2, 緑色:2, 青色:2
	SETCOLOR RESULT
	;フォント内に存在するかチェック
	CALL XON_FONT(グラデ文字,,4)
	IF RESULT == -1
		;出力されなければ、一文字ずつ取り出して出力
		FOR カウンタB, 0 ,STRLENSU(グラデ文字)
			赤色:2 = 赤色:0 + (( 赤色:1 - 赤色:0 ) * (カウンタ + カウンタB + カウンタC)) / ( 文字長 - 1 )
			緑色:2 = 緑色:0 + (( 緑色:1 - 緑色:0 ) * (カウンタ + カウンタB + カウンタC)) / ( 文字長 - 1 )
			青色:2 = 青色:0 + (( 青色:1 - 青色:0 ) * (カウンタ + カウンタB + カウンタC)) / ( 文字長 - 1 )
			COLOR_FROMRGB 赤色:2, 緑色:2, 青色:2
			SETCOLOR RESULT
			SUBSTRINGU グラデ文字, (カウンタB ), 1
			PRINTFORM %RESULTS%
		NEXT
		カウンタC += STRLENSU(グラデ文字)-1
	ENDIF
	カウンタB = 0
NEXT

SETCOLOR 変化色
IF 出力方式 == 0
	CALL XON_FONTL(END文字列)
ELSEIF 出力方式 == 1
	CALL XON_FONTW(END文字列)
ELSE
	CALL XON_FONT(END文字列)
	;PRINTFORM %END文字列%
ENDIF

RESETCOLOR 

RETURN 0

@XON_CUSTOMDRAWLINE(初期色 = C_WHITE, 変化色 = C_WHITE, グラデ文字列)
#DIM DYNAMIC 初期色
#DIM DYNAMIC 変化色
#DIMS DYNAMIC グラデ文字

#DIMS DYNAMIC グラデ文字列
#DIMS DYNAMIC グラデ文字列_分割 ,160
#DIM DYNAMIC グラデ文字列_分割文字長 ,160
#DIMS DYNAMIC グラデ文字列_分割B ,50
#DIM DYNAMIC 文字カウンタ
#DIM DYNAMIC グラデ文字数
#DIM DYNAMIC 赤色 ,3 ;初期色、変化色、グラデ色
#DIM DYNAMIC 緑色 ,3
#DIM DYNAMIC 青色 ,3
#DIM DYNAMIC 文字長
#DIM DYNAMIC 最大文字長 = 154
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 出力方式 = 0 ;0は改行、1は改行(+クリック)、2は無改行

; --- 初期色の RGB を取り出す ---
赤色:0 = (初期色 / 0x10000) % 0x100		;// 上位2桁
緑色:0 = (初期色 / 0x100)   % 0x100		;// 真ん中2桁
青色:0 = 初期色 % 0x100					;// 下位2桁

; --- 変化色の RGB を取り出す ---
赤色:1 = (変化色 / 0x10000) % 0x100		;// 上位2桁
緑色:1 = (変化色 / 0x100)   % 0x100		;// 真ん中2桁
青色:1 = 変化色 % 0x100					;// 下位2桁


;初期色を지정
SETCOLOR 初期色

SPLIT グラデ文字列, ",", グラデ文字列_分割B

; --- 長さ취득 ---
FOR カウンタ,0,VARSIZE("グラデ文字列_分割B")-1
	;登録文字と未登録文字列で、이하의 ように配列を詰める
	;「카드」「を伏せる！」→「카드」「を」「伏」「せ」「る」「！」

	SIF グラデ文字列_分割B:カウンタ == ""
		BREAK
	グラデ文字 '= グラデ文字列_分割B:カウンタ
	
	;フォント内に存在するかチェック
	CALL XON_FONT(グラデ文字,,5)
	IF RESULT != 0
		;存在していれば、そのまま入れる
		グラデ文字列_分割:文字カウンタ '= グラデ文字
		グラデ文字列_分割文字長:文字カウンタ = 2
		文字カウンタ++
	ELSE
		;分割して入れる
		FOR カウンタB, 0 ,STRLENSU(グラデ文字)
			;1文字ずつ取り出し、半角・全角を判別して文字数をカウント
			SUBSTRINGU グラデ文字, (カウンタB ), 1
			グラデ文字列_分割:文字カウンタ = %RESULTS%
			グラデ文字列 = %RESULTS%
			STRLENS グラデ文字列
			グラデ文字列_分割文字長:文字カウンタ = RESULT
			文字カウンタ++
		NEXT
	ENDIF
NEXT
文字カウンタ = 0
; グラデーション
FOR カウンタ,0,最大文字長
	
	SIF 文字長 >= 最大文字長
		BREAK
	
	FOR カウンタB,0,VARSIZE("グラデ文字列_分割")-1
		
		SIF グラデ文字列_分割:カウンタB == ""
			BREAK
		文字カウンタ += グラデ文字列_分割文字長:カウンタB
		SIF 文字カウンタ >= 最大文字長
			BREAK
		;PRINTFORML count{グラデ文字列_分割文字長:カウンタB}
		グラデ文字 '= グラデ文字列_分割:カウンタB
		;カンマ区切りのブロックごとに판정
		赤色:2 = 赤色:0 + (( 赤色:1 - 赤色:0 ) * 文字カウンタ) / ( 最大文字長 - 1 )
		緑色:2 = 緑色:0 + (( 緑色:1 - 緑色:0 ) * 文字カウンタ) / ( 最大文字長 - 1 )
		青色:2 = 青色:0 + (( 青色:1 - 青色:0 ) * 文字カウンタ) / ( 最大文字長 - 1 )
		COLOR_FROMRGB 赤色:2, 緑色:2, 青色:2
		SETCOLOR RESULT
		
		;フォント内に存在するかチェック
		CALL XON_FONT(グラデ文字)
	NEXT
NEXT

SETCOLOR 変化色
PRINTFORML
RESETCOLOR 

RETURN 0


;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
;XON_FONT
;「ぉんフォント」を표시する。
;ぉんフォントはeraOCGでのみ利用許可
;
;仕様：
;連続で記号を出したい場合、
;이하의 ように、カンマ(,)で区切るとその順番に出力できます。
;CALL XON_FONT("손패,ハート,ハート,ハート")
;
;,出力方式
;０：PRINTFORML
;１：PRINTFORMW
;２：PRINTFORM
;３：グラデーション機能用(文字数チェック)
;４：グラデーション機能用(対応文字だけ出力)
;５：ボタン機能用(1文字だけチェック。Unicodeの値を返す)
;
;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
;PRINTFORMLを使用
@XON_FONTL(文字名,色지정 = -1)
#DIMS DYNAMIC 文字名
#DIM DYNAMIC 色지정

CALL XON_FONT(文字名,色지정,0)
;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
;PRINTFORMWを使用
@XON_FONTW(文字名,色지정 = -1)
#DIMS DYNAMIC 文字名
#DIM DYNAMIC 色지정
#DIM DYNAMIC 出力方式

CALL XON_FONT(文字名,色지정,1)
;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
@XON_FONT(文字名,色지정 = -1,出力方式 = 2)
#DIMS DYNAMIC 文字名
#DIM DYNAMIC 色지정
#DIM DYNAMIC 出力方式
#DIMS DYNAMIC フォント保持
#DIM DYNAMIC 色保持
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 文字名s , 50
#DIMS DYNAMIC 文字名称
#DIM DYNAMIC 該当なし
#DIM DYNAMIC 半角플래그
#DIMS DYNAMIC 総文字
#DIM DYNAMIC 総文字数
#DIM DYNAMIC UNI文字数値

;現在のフォント・色を保持
フォント保持 = %GETFONT()%

IF !CHKFONT("xonFont")
	PRINTL フォント読み込み失敗。fontフォルダを確認してください。
	RETURN 0
ENDIF

SETFONT "xonFont"

IF 色지정 != -1
	色保持 = GETCOLOR()
	SETCOLOR 色지정
ENDIF

;全角・半角の空白置換
