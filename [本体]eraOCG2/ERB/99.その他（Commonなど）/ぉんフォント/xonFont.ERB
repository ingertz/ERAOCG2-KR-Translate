;		CASE "未설정"	
;			UNI文字数値 =  0x00FD
;		CASE "未설정"	
;			UNI文字数値 =  0x00FE
;		CASE "未설정"	
;			UNI文字数値 =  0x00FF

		;ゼリーはS->L->Eの順に繋がり、L同士は自由に繋がる
		CASE "A1","AゼリーS1"
			UNI文字数値 =  0x01A1	;普通に出るイメージ
		CASE "A8","AゼリーS2"
			UNI文字数値 =  0x01A8	;勢いよく出るイメージ
		CASE "A2","AゼリーL1"
			UNI文字数値 =  0x01A2
		CASE "A3","AゼリーL2"
			UNI文字数値 =  0x01A3
		CASE "A4","AゼリーL3"
			UNI文字数値 =  0x01A4
		CASE "A5","AゼリーL->E"
			UNI文字数値 =  0x01A5
		CASE "A6","AゼリーE_Loop"
			UNI文字数値 =  0x01A6	;まっすぐ伸びる
