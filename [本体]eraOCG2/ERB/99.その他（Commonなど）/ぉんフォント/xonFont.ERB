		CASE "제외","소멸"
			UNI文字数値 =  0x00A8
		CASE "미설정"
			UNI文字数値 =  0x00A9
		CASE "융합"
			UNI文字数値 =  0x00AA
		CASE "싱크로"
			UNI文字数値 =  0x00AB
		CASE "엑시즈"
			UNI文字数値 =  0x00AC
		CASE "펜듈럼"
			UNI文字数値 =  0x00AD
		CASE "링크"
			UNI文字数値 =  0x00AE
		CASE "튜너"
			UNI文字数値 =  0x00AF
		
		CASE "ERA"
			UNI文字数値 =  0x00B0
		CASE "UR"
			UNI文字数値 =  0x00B1
		CASE "SPR"
			UNI文字数値 =  0x00B2
		CASE "R"
			UNI文字数値 =  0x00B3
		CASE "NEW"
			UNI文字数値 =  0x00B4
		CASE "주의"
			UNI文字数値 =  0x00B5
		CASE "금지"
			UNI文字数値 =  0x00B6
		CASE "금지2"
			UNI文字数値 =  0x00B7
		CASE "제한"
			UNI文字数値 =  0x00B8
		CASE "준제한"
			UNI文字数値 =  0x00B9
		CASE "レベル","★"
			UNI文字数値 =  0x00BA
		CASE "レベルR","☆"
			UNI文字数値 =  0x00BB
		CASE "フィールド","フィールド마법"
