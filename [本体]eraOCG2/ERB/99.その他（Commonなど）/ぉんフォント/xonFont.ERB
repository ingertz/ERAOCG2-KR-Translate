SIF 色지정 != -1
	SETCOLOR 色保持

IF 出力方式 == 0
	PRINTFORML 
ELSEIF 出力方式 == 1
	PRINTFORMW 
ELSEIF 出力方式 == 3
	RETURN STRLENSU( 総文字 )
ENDIF

RETURN 0

