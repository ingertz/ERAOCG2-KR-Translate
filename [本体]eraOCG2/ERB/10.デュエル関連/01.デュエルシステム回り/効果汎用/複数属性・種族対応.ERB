@複数속성検出(대상者,ゾーン,場所,보존変数)
#DIMS DYNAMIC 대상者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 場所
#DIM REF 보존変数, 0

#DIM DYNAMIC カードID
#DIM DYNAMIC カード속성, 10
#DIM DYNAMIC カウンタ

VARSET 보존変数
カードID = GETVAR(@"%대상者%_%ゾーン%:場所")
SIF カードID <= -1
	RETURN 0

;元々の속성を취득
VARSET RESULT, 0, 0, 10
CALLFORM CARD_{カードID}("속성")
ARRAYCOPY "RESULT", "カード속성"

;ゾーンが필드なら、속성の上書きを確認する
;元々持っていない속성になっている場合は、その속성だけになる
;（OCGの裁定では元々持っているか否かに関わらず속성변경효과를 受けた場合はその속성のみになるのだが
;　eraOCG2では受けている효과の影響が취득できないためこのような処理とする）
IF ゾーン == "필드" && !MATCH(カード속성, GETVAR(@"%대상者%_MZ_属:場所"))
	VARSET カード속성
	カード속성:0 = GETVAR(@"%대상者%_MZ_属:場所")
ENDIF

;各속성の未所持／所持を別変数にマッピング
FOR カウンタ, 0, 10
	SIF カード속성:カウンタ <= 0
		CONTINUE
	보존変数:(カード속성:カウンタ) = 1
NEXT


@효과条件속성_複数(보존変数)
#DIM REF 보존変数, 0

#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB

효과条件속성:0 = 9999
カウンタB = 0
FOR カウンタ, 빛속성, (신속성 + 1)
	SIF 보존変数:カウンタ == 1
		효과条件속성:(カウンタB ++) = カウンタ
NEXT


@속성一致チェック(보존変数A, 보존変数B)
#FUNCTION
#DIM REF 보존変数A, 0
#DIM REF 보존変数B, 0

#DIM DYNAMIC カウンタ

FOR カウンタ, 빛속성, (신속성 + 1)
	SIF 보존変数A:カウンタ == 1 && 보존変数B:カウンタ == 1
		RETURNF 1
NEXT
RETURNF 0


@複数종족検出(대상者,ゾーン,場所,보존変数)
#DIMS DYNAMIC 대상者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 場所
#DIM REF 보존変数, 0

#DIM DYNAMIC カードID
#DIM DYNAMIC カード종족, 10
#DIM DYNAMIC カウンタ

VARSET 보존変数
カードID = GETVAR(@"%대상者%_%ゾーン%:場所")
SIF カードID <= -1
	RETURN 0

;元々の종족を취득
VARSET RESULT, 0, 0, 10
CALLFORM CARD_{カードID}("종족")
ARRAYCOPY "RESULT", "カード종족"

;ゾーンが필드なら、종족の上書きを確認する
;元々持っていない종족になっている場合は、その종족だけになる
;（OCGの裁定では元々持っているか否かに関わらず종족변경효과를 受けた場合はその종족のみになるのだが
;　eraOCG2では受けている효과の影響が취득できないためこのような処理とする）
IF ゾーン == "필드" && !MATCH(カード종족, GETVAR(@"%대상者%_MZ_種:場所"))
	VARSET カード종족
	カード종족:0 = GETVAR(@"%대상者%_MZ_種:場所")
ENDIF

;各종족の未所持／所持を別変数にマッピング
FOR カウンタ, 0, 10
	SIF カード종족:カウンタ <= 0
		CONTINUE
	보존変数:(カード종족:カウンタ) = 1
NEXT


@효과条件종족_複数(보존変数)
#DIM REF 보존変数, 0

#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB

효과条件종족:0 = 9999
カウンタB = 0
FOR カウンタ, 마법사족, (환신야수족 + 1)
	SIF 보존変数:カウンタ == 1
		효과条件속성:(カウンタB ++) = カウンタ
NEXT


@종족一致チェック(보존変数A, 보존変数B)
#FUNCTION
#DIM REF 보존変数A, 0
#DIM REF 보존変数B, 0

#DIM DYNAMIC カウンタ

FOR カウンタ, 마법사족, (환신야수족 + 1)
	SIF 보존変数A:カウンタ == 1 && 보존変数B:カウンタ == 1
		RETURNF 1
NEXT
RETURNF 0




@ELEMENTS_KIND_BASIC(듀얼리스트,ゾーン,参照渡し用変数,対面플래그,反転플래그)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC 대상者
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 対面플래그
#DIM DYNAMIC 反転플래그
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 範囲플래그 = 0
#DIM DYNAMIC サーチ範囲
#DIM DYNAMIC 대상カードID
#DIM DYNAMIC 속성カウンタ
#DIM DYNAMIC 속성一時보존変数
#DIM DYNAMIC 속성数 = 0
#DIM REF 参照渡し用変数, 0
VARSET RESULT

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

;---------------------------------------
;RESULT:0は通常「1」を返す。関数処理の正常終了を示す返り値。ゾーン지정の記述誤りの場合はRETURN 0を返す。
;RESULT:1に지정したゾーン中の속성の合計数[0-7]を返す。基本的に속성数のカウントはこれを利用する。
;RESULT:2に속성ごとにビットを立てた数値を返している。個別の속성ごとの存在情報を元にして、何らかの処理を元の関数側で実施する加工用途向け。
;빛속성 bit[1] //数字[  2]
;어둠속성 bit[2] //数字[  4]
;땅속성 bit[3] //数字[  8]
;물속성 bit[4] //数字[ 16]
;화염속성 bit[5] //数字[ 32]
;바람속성 bit[6] //数字[ 64]
;신속성 bit[7] //数字[128]
;지정したゾーンがモンスター不在ならRESULT:1もRESULT:2も[0]が返る。

;参照渡し用変数は、@효과条件속성_複数()で효과条件속성を複数속성で利用する用途の変数。参照渡し形式なので引数の지정が必須となっている（仕様）
;呼び出す元の関数側で『#DIM DYNAMIC 複数속성, 8』というふうに宣言した変数配列を用意して参照渡しの形式で利用する。
;使用例は「71706_령신의 성궤」を参照。※なお「@효과条件속성_複数()」は霊使いフォルダに格納されている関数ファイル内に存在している。
;
;対面플래그　0なら듀얼리스트のゾーンのみ、1は対面者のゾーンのみ、2は両方のゾーンをチェックする。「서로의 묘지에 존재하는 속성数」など판정する時は2を설정。
;反転플래그　0なら上記の説明そのままでの正常利用。1は結果を全て反転させて返す（「～～に存在しない속성」「～～と異なる속성」等の条件판정で利用する）
;---------------------------------------
;
;@ELEMENTS_KIND_BASICの『ゾーン』の引数に利用できる특수な名称지정の一覧
;【名称지정】			【範囲】						【詳細】
;「全場」				：필드＋마함					:필드의 カードの지정　（現代風の마함領域に置いたモンスターカードも参照するケース）
;「全場＋묘지」			：필드＋마함＋묘지				:필드 / 묘지의 カードの지정　（↑＋묘지も範囲というさらに広めの用途）
;「묘지＋제외」			：묘지＋제외					:묘지 / 제외 상태인 カードの지정　（現代風の묘지リソース、雷龍융합の範囲지정）
;「필드＋묘지」			：필드＋묘지					:필드 / 묘지의 "モンスター"の지정（素材제외する타입の융합효과などの範囲지정）
;「손패＋필드」			：손패＋필드					:패 / 필드의 "モンスター"の지정（通常の융합などの範囲지정）
;「손패＋全場」			：손패＋필드＋마함				:패 / 필드의 カードの지정（펜듈럼モンスターも含むケースの想定）
;「손패＋필드＋묘지」	：손패＋필드＋묘지				:基本的なリソースとなる領域3つの지정（ティアラメンツ융합の範囲지정）
;「손패＋全場＋묘지」	：손패＋필드＋마함＋묘지		:一般的にメイン덱の카드가 存在する場所の網羅（제외状態だけ範囲に含めない形）
;「손패＋덱」		：손패＋덱					:リクルート효과の範囲として現代で一般的になってる範囲（素引きを許容できる타입）
;「덱＋EX덱」	：덱＋EX덱				:덱2種。EXモンスターも出せる強力なリクルート효과の範囲
;「公開領域」			：필드＋마함＋묘지＋제외		:상대プレイヤーがデュエル中に確認可能な対戦상대側のカードの範囲を全て網羅したもの。
;「非公開領域」			：손패＋덱＋EX덱		:↑の反対。全ての範囲対応版の超強力なリクルート효과範囲지정という言い換えもできる。
;「덱以外」			：손패＋필드＋마함＋묘지＋제외	:このデュエル中に덱에서 離れ、何らかの形でプレイされたorプレイできる카드를 網羅したもの。
;
;---------------------------------------


$OTHER_ELEMENTS_CHECK

IF 対面플래그 == 1
	대상者 = %対面者%
ELSE
	대상者 = %듀얼리스트%
ENDIF

;대상となるゾーンごとに範囲と参照先を決定する処理。
;通常用途では「필드」「묘지」などをゾーンの引数に지정する。「상대필드」の場合は対面플래그を利用すること。
;덱＋묘지とか、そういうマニアックな範囲지정はないが、カード효과で지정される事が多い範囲지정は一通り揃えたと思われる。
SELECTCASE ゾーン
	CASE "필드"
		サーチ範囲 = 5
		参照先 = %ゾーン%
	CASE "마함"
		サーチ範囲 = 5
		参照先 = %ゾーン%
	CASE "손패"
		サーチ範囲 = 紙束最大値
		参照先 = %ゾーン%
	CASE "묘지"
		サーチ範囲 = 紙束最大値
		参照先 = %ゾーン%
	CASE "덱"
		サーチ範囲 = 紙束最大値
		参照先 = %ゾーン%
	CASE "EX덱"
		サーチ範囲 = 紙束最大値
		参照先 = %ゾーン%
	CASE "제외"
		サーチ範囲 = 紙束最大値
		参照先 = %ゾーン%
	CASE "全場" ;필드＋마함
		範囲플래그 = 2
		サーチ範囲 = 5
		参照先 = 마함
	CASE "全場＋묘지" ;필드＋마함＋묘지
		範囲플래그 = 4
		サーチ範囲 = 紙束最大値
		参照先 = 묘지
	CASE "필드＋묘지" ;필드＋묘지
		範囲플래그 = 2
		サーチ範囲 = 紙束最大値
		参照先 = 묘지
	CASE "묘지＋제외" ;묘지＋제외
		範囲플래그 = 8
		サーチ範囲 = 紙束最大値
		参照先 = 제외
	CASE "손패＋필드" ;손패＋필드
		範囲플래그 = 2
		サーチ範囲 = 紙束最大値
		参照先 = 손패
	CASE "손패＋全場" ;손패＋필드＋마함
		範囲플래그 = 4
		サーチ範囲 = 紙束最大値
		参照先 = 손패
	CASE "손패＋필드＋묘지" ;손패＋필드＋묘지
		範囲플래그 = 16
		サーチ範囲 = 紙束最大値
		参照先 = 손패
	CASE "손패＋全場＋묘지" ;손패＋필드＋마함＋묘지
		範囲플래그 = 32
		サーチ範囲 = 紙束最大値
		参照先 = 손패
	CASE "손패＋덱" ;손패＋덱
		範囲플래그 = 128
		サーチ範囲 = 紙束最大値
		参照先 = 손패
	CASE "덱＋EX덱" ;덱＋EX덱
		範囲플래그 = 128
		サーチ範囲 = 紙束最大値
		参照先 = EX덱
	CASE "公開領域" ;필드＋마함＋묘지＋제외
		範囲플래그 = 32
		サーチ範囲 = 紙束最大値
		参照先 = 제외
	CASE "非公開領域" ;손패＋덱＋EX덱
		範囲플래그 = 256
		サーチ範囲 = 紙束最大値
		参照先 = EX덱
	CASE "덱以外" ;손패＋필드＋마함＋묘지＋제외
		範囲플래그 = 64
		サーチ範囲 = 紙束最大値
		参照先 = 손패
	CASEELSE
		RETURN 0
ENDSELECT

$CHECK_ELEMENTS_LOOP
;カードチェックの処理
FOR カウンタ,0,サーチ範囲
	SIF GETVAR(@"%대상者%_%参照先%:カウンタ") <= -1
		CONTINUE
	대상カードID = GETVAR(@"%대상者%_%参照先%:カウンタ")
	TRYCALLFORM CARD_{대상カードID}, "종류"
	SIF RESULT >= 10
		CONTINUE
	;特定カテゴリのみで속성数にカウントしたり逆に제외する動きもしたいので一部条件に対応。スーパー名前・カテゴリ・固カテゴリ・종족のみ対応。
	IF 효과条件スーパー名前 != ""
		TRYCALLFORM CARDNAME_{대상カードID}, "名前"
		MATCH 효과条件スーパー名前,RESULTS
		SIF RESULT != 0
			GOTO ELEMENT_COUNT
	ENDIF
	IF 효과条件カテゴリ != ""
		TRYCALLFORM CARDNAME_{대상カードID}, "カテゴリ"
		GROUPMATCH 효과条件カテゴリ,RESULTS:0,RESULTS:1,RESULTS:2,RESULTS:3,RESULTS:4
		SIF RESULT == 0
			CONTINUE
	ENDIF
	IF 효과条件固カテゴリ != ""
		TRYCALLFORM CARDNAME_{대상カードID}, "カテゴリ"
		GROUPMATCH 효과条件固カテゴリ,RESULTS:0,RESULTS:1,RESULTS:2,RESULTS:3,RESULTS:4
		SIF RESULT != 0
			CONTINUE
	ENDIF
	IF 효과条件종족 > 0
		TRYCALLFORM CARD_{대상カードID}, "종족"
		GROUPMATCH 효과条件종족,RESULT:0,RESULT:1,RESULT:2,RESULT:3,RESULT:4
		SIF RESULT == 0
			CONTINUE
	ENDIF
	
	$ELEMENT_COUNT
	TRYCALLFORM CARD_{대상カードID}, "속성"
	IF RESULT:1 != 0

		;複数속성を持った몬스터의 場合、複数の속성をカウントする。
		FOR カウンタB,0,7
			속성一時보존変数 = RESULT:カウンタB
			SIF 속성一時보존変数 != 0
				SETBIT 속성カウンタ, 속성一時보존変数
		NEXT
	ELSE
		속성一時보존変数 = RESULT
		SETBIT 속성カウンタ, 속성一時보존変数
	ENDIF
	
	;確認用　カードID と속성一時보존変数と속성カウンタを표시
	;PRINTFORMW カードID:{대상カードID}　속성一時보존変数:{속성一時보존変数}　속성カウンタ:{속성カウンタ}
NEXT

SELECTCASE 範囲플래그
	CASE 2
		範囲플래그 = 1
		サーチ範囲 = 5
		参照先 = 필드
	CASE 4
		範囲플래그 = 2
		サーチ範囲 = 5
		参照先 = 마함
	CASE 8
		範囲플래그 = 1
		サーチ範囲 = 紙束最大値
		参照先 = 묘지
	CASE 16
		範囲플래그 = 2
		サーチ範囲 = 紙束最大値
		参照先 = 묘지
	CASE 32
		範囲플래그 = 4
		サーチ範囲 = 紙束最大値
		参照先 = 묘지
	CASE 64
		範囲플래그 = 32
		サーチ範囲 = 紙束最大値
		参照先 = 제외
	CASE 128
		範囲플래그 = 1
		サーチ範囲 = 紙束最大値
		参照先 = 덱
	CASE 256
		範囲플래그 = 128
		サーチ範囲 = 紙束最大値
		参照先 = 손패
	CASEELSE
		範囲플래그 = 0
ENDSELECT

IF 範囲플래그 != 0
	GOTO CHECK_ELEMENTS_LOOP
ENDIF

IF 対面플래그 == 2
	対面플래그 = 1
	GOTO OTHER_ELEMENTS_CHECK
ENDIF

;反転플래그による속성カウンタのビット反転処理
IF 反転플래그 == 1
	FOR カウンタ,0,8
		INVERTBIT 속성カウンタ, カウンタ
	NEXT
ENDIF

;ループ処理後の속성チェックと変数の整理
RESULT:2 = 속성カウンタ

FOR カウンタ,1,8
	GETBIT 속성カウンタ,カウンタ
	IF RESULT == 1
		参照渡し用変数:(カウンタ) = 1
		속성数 ++
	ENDIF
NEXT

RESULT:1 = 속성数

;変数確認
[SKIPSTART]
PRINTFORML 　　　속성数：RESULT:1・・・{RESULT:1}
