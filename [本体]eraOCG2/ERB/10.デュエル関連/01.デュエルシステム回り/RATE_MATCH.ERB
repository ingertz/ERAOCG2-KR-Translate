@NPC_RANDOM_RATEMATCH_CHECK
#DIM DYNAMIC チェック플래그
#DIM DYNAMIC 対戦상대A
#DIM DYNAMIC 対戦상대B
#DIM DYNAMIC 対戦상대候補,100000
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB


IF オプション_NPCレート戦 == 1
    PRINTFORML
    PRINTFORML NPC의 레이트 변동을 확인하시겠습니까？
    PRINTFORML 
    PRINTFORML [0] - 예
    PRINTFORML [1] - 아니오
    BINPUT
    SIF RESULT == 0
        チェック플래그 = 1
ENDIF

;対戦상대A決定
FOR 対戦상대A,1,CHARANUM
    SIF TALENT:対戦상대A:듀얼리스트 == 0
        CONTINUE
    SIF TALENT:対戦상대A:외부자 != 0
        CONTINUE
    ;対戦상대B決定
    FOR カウンタ,1,CHARANUM
        SIF TALENT:カウンタ:듀얼리스트 == 0
            CONTINUE
        SIF TALENT:カウンタ:외부자 != 0
            CONTINUE
        SIF !INRANGE(CFLAG:カウンタ:듀얼레이트,(CFLAG:対戦상대A:듀얼레이트)-500,(CFLAG:対戦상대A:듀얼레이트)+500)
            CONTINUE
        対戦상대候補:カウンタB = カウンタ
        カウンタB ++
    NEXT
    IF カウンタB == 0 ;レートの近い상대がいなければモブと対戦
        対戦상대B = -1
    ELSE
        対戦상대B = 対戦상대候補:RAND(カウンタB+1)
        SIF 対戦상대B == 0
            対戦상대B = -1
        SIF 対戦상대A == 対戦상대B ;同一人物同士のマッチングならモブと対戦
            対戦상대B = -1
        SIF RAND:3 == 0 ;確率で名無しモブと対戦
            対戦상대B = -1
    ENDIF
    SIF RAND:100 == 0 ;低確率でお休み
        CONTINUE
    ;対戦処理
    CALL NPC_RANDOM_RATEMATCH_ACT(対戦상대A,対戦상대B,チェック플래그)
NEXT


@NPC_RANDOM_RATEMATCH_ACT(対戦상대A,対戦상대B,チェック플래그)
#DIM DYNAMIC チェック플래그
#DIM DYNAMIC 対戦상대A
#DIM DYNAMIC 対戦상대A_デュエル力
#DIM DYNAMIC 対戦상대B
#DIM DYNAMIC 対戦상대B_デュエル力
#DIM DYNAMIC デュエル力合計
#DIM DYNAMIC レート修正

;デュエル力チェック
CALL NPC_RANDOM_RATEMATCH_TIER(対戦상대A)
対戦상대A_デュエル力 = RESULT
IF 対戦상대B == -1 ;モブは最弱
    対戦상대B_デュエル力 = 1
ELSE
    CALL NPC_RANDOM_RATEMATCH_TIER(対戦상대B)
    対戦상대B_デュエル力 = RESULT
ENDIF
;もし例外がいたら緊急停止
SIF 対戦상대A_デュエル力 == -1 || 対戦상대B_デュエル力 == -1
    RETURN -1
デュエル力合計 = 対戦상대A_デュエル力 + 対戦상대B_デュエル力 + 1
;勝敗판정
IF RAND(デュエル力合計) <= 対戦상대A_デュエル力 ;対戦상대Aの勝ち
    IF 対戦상대B > 0
        IF CFLAG:対戦상대A:듀얼레이트 > CFLAG:対戦상대B:듀얼레이트
            レート修正 = 100 - RAND:11
        ELSEIF CFLAG:対戦상대A:듀얼레이트 < CFLAG:対戦상대B:듀얼레이트
            レート修正 = 100 + RAND:11
        ELSE
            レート修正 = 100
        ENDIF
    ELSE
        レート修正 = 70 + RAND:11
    ENDIF
    IF チェック플래그 == 1
        PRINTFORML 
        IF 対戦상대B > 0
            PRINTFORML 「%NAME:対戦상대A%」는「%NAME:対戦상대B%」와의 레이트전에서 승리했다！
            PRINTFORML 「%NAME:対戦상대A%」의 듀얼레이트:{CFLAG:対戦상대A:듀얼레이트} + {レート修正}
            PRINTFORMW 「%NAME:対戦상대B%」의 듀얼레이트:{CFLAG:対戦상대B:듀얼레이트} - {レート修正}
        ELSE
            PRINTFORML 「%NAME:対戦상대A%」는 이름없는 듀얼리스트와의 레이트전에서 승리했다！
            PRINTFORMW 「%NAME:対戦상대A%」의 듀얼레이트:{CFLAG:対戦상대A:듀얼레이트} + {レート修正}
        ENDIF
    ENDIF
	CFLAG:対戦상대A:듀얼레이트 += レート修正
    IF 対戦상대B > 0
        CFLAG:対戦상대B:듀얼레이트 -= レート修正
        SIF CFLAG:対戦상대B:듀얼레이트 == 0
            CFLAG:対戦상대B:듀얼레이트 = -1
    ENDIF
ELSE ;対戦상대Bの勝ち
    IF 対戦상대B > 0
        IF CFLAG:対戦상대A:듀얼레이트 > CFLAG:対戦상대B:듀얼레이트
            レート修正 = 100 + RAND:11
        ELSEIF CFLAG:対戦상대A:듀얼레이트 < CFLAG:対戦상대B:듀얼레이트
            レート修正 = 100 - RAND:11
        ELSE
            レート修正 = 100
        ENDIF
    ELSE
        レート修正 = 150 + RAND:11
    ENDIF
    IF チェック플래그 == 1
        PRINTFORML 
        IF 対戦상대B > 0
            PRINTFORML 「%NAME:対戦상대A%」는「%NAME:対戦상대B%」와의 레이트전에서 패배했다…
            PRINTFORML 「%NAME:対戦상대A%」의 듀얼레이트:{CFLAG:対戦상대A:듀얼레이트} - {レート修正}
            PRINTFORMW 「%NAME:対戦상대B%」의 듀얼레이트:{CFLAG:対戦상대B:듀얼레이트} + {レート修正}
        ELSE
            PRINTFORML 「%NAME:対戦상대A%」는 이름없는 듀얼리스트와의 레이트전에서 패배했다…
            PRINTFORMW 「%NAME:対戦상대A%」의 듀얼레이트:{CFLAG:対戦상대A:듀얼레이트} - {レート修正}
        ENDIF
    ENDIF
    CFLAG:対戦상대A:듀얼레이트 -= レート修正
    SIF CFLAG:対戦상대A:듀얼레이트 == 0
        CFLAG:対戦상대A:듀얼레이트 = -1
    IF 対戦상대B > 0
        CFLAG:対戦상대B:듀얼레이트 += レート修正
    ENDIF
ENDIF




@ONLINE_RATEMATCHING
#DIM DYNAMIC 対戦상대
#DIM DYNAMIC 対戦상대候補,10000
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB

IF RAND:4
    VARSET カウンタ
    VARSET カウンタB
    FOR カウンタ,1,CHARANUM
        SIF TALENT:カウンタ:듀얼리스트 == 0
            CONTINUE
        SIF TALENT:カウンタ:외부자 != 0
            CONTINUE
        SIF CFLAG:カウンタ:현재위치 <= 20
            CONTINUE
        SIF !INRANGE(CFLAG:カウンタ:듀얼레이트,(CFLAG:MASTER:듀얼레이트)-500,(CFLAG:MASTER:듀얼레이트)+500)
            CONTINUE
        対戦상대候補:カウンタB = カウンタ
        カウンタB ++
    NEXT

    SIF カウンタB == 0
        CONTINUE
    対戦상대 = 対戦상대候補:RAND(カウンタB+1)
    RETURN 対戦상대
ELSE
    RETURN 0
ENDIF

RETURN 0


@CHOOSE_DECK_ONLINE_RATEMATCH
#DIM DYNAMIC 설정
#DIM DYNAMIC 덱リスト,1000
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択덱
FOR カウンタ,0,1000
	VARSET RESULT
	TRYCALLFORM DUELDECK_{11000 + カウンタ}("存在確認")
	SIF RESULT != 1
		CONTINUE
	덱リスト:カウンタB = 11000 + カウンタ
	カウンタB ++
NEXT

選択덱 = 덱リスト:(RAND:カウンタB)
RETURN 選択덱

