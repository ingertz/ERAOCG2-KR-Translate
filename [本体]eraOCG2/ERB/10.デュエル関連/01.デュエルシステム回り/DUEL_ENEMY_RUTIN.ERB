		濾過範囲상대묘지 = 1
		濾過条件속성 = 땅속성
		CALL CARD_CHECK_EXT("상대",0,"",0)
		SIF RESULT == 0
			RETURN 1
	CASE "작열의 화령사 히타"
		CALL FULLRESET_EXT
		濾過範囲상대묘지 = 1
		濾過条件속성 = 화염속성
		CALL CARD_CHECK_EXT("상대",0,"",0)
		SIF RESULT == 0
			RETURN 1
	CASE "청렬의 수령사 에리아"
		CALL FULLRESET_EXT
		濾過範囲상대묘지 = 1
		濾過条件속성 = 물속성
		CALL CARD_CHECK_EXT("상대",0,"",0)
		SIF RESULT == 0
			RETURN 1
	CASE "창취의 풍령사 윈"
		CALL FULLRESET_EXT
		濾過範囲상대묘지 = 1
		濾過条件속성 = 바람속성
		CALL CARD_CHECK_EXT("상대",0,"",0)
		SIF RESULT == 0
			RETURN 1

	CASE "섬도희－하야테"
		CALL FULLRESET_EXT
		SIF ターン数 == 1
			条件달성 ++
		CALL FULLRESET_EXT
		濾過範囲묘지 = 1
		濾過条件名前:0 = 섬도기동－인게이지
		CALL CARD_CHECK_EXT("상대",0,"",0)
		SIF RESULT == 1
			条件달성 ++
		CALL FULLRESET_EXT
		濾過範囲묘지 = 1
		濾過条件名前 = 섬도희－레이
		CALL CARD_CHECK_EXT("상대",0,"",0)
		SIF RESULT == 1
			条件달성 ++
		SIF 条件달성
			RETURN 1
	CASE "섬도희－카가리"
		CALL FULLRESET_EXT
		濾過範囲필드 = 1
		濾過条件名前:0 = 섬도희－하야테
		CALL CARD_CHECK_EXT("상대",0,"",0)
		SIF RESULT == 1 && メインフェイズ２ != 1
			RETURN 1
		CALL FULLRESET_EXT
		濾過範囲묘지 = 1
		濾過条件名前:0 = 섬도기동－인게이지
		CALL CARD_CHECK_EXT("상대",0,"",0)
		SIF RESULT == 0
			RETURN 1
	CASE "섬도희－시즈쿠"
		CALL FULLRESET_EXT
		SIF ターン数 > 1 && メインフェイズ２ != 1
			RETURN 1
	CASE "섬도희－카이나"
		CALL FULLRESET_EXT
		SIF ターンプレイヤー == "상대"
			RETURN 1
	CASE "데먼스미스 레퀴엠","데먼스미스 세퀜티아"
		SIF 발동済_1("상대",カードID)
			RETURN 1
	CASE "블러드 로즈 드래곤"
		SIF 발동済_1("상대",カードID)
			RETURN 1
		CALL FULLRESET
		濾過範囲묘지 = 1
		濾過条件名前 = 블랙 로즈 드래곤
		CALL CARD_CHECK_EXT("상대",0,"",0,カードID)
		SIF RESULT != 1
			RETURN 1
		CALL FULLRESET
		濾過範囲상대필드 = 1
		濾過範囲상대마함 = 1
		濾過条件除去種 = 묘지
		濾過条件CNT = 1
		CALL CARD_CHECK_EXT("상대",0,"",0,カードID)
		SIF RESULT < 2
			RETURN 1
	CASEELSE

ENDSELECT
RETURN 0

