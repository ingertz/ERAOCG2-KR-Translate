		CASE "제너레이드 섀도우 로프톨"
			IF ターン数 < 1
				효과条件優先名前 = 빛의 제너레이드 마르델
			ELSE
				효과条件優先名前 = 제너레이드 세이즈 발라
			ENDIF
		CASE "나비의 단검－엘마"
			효과条件優先名前 = 가디언 엘마
		CASE "유성의 활－실"
			효과条件優先名前:0 = 가디언 엘마
			SIF ターン数 <= 1
				효과条件優先名前:1 = 가디언 케이스트
			효과条件優先名前:2 = 가디언 실
		CASE "파사의 대검－바오우"
			효과条件優先名前 = 가디언 바오우
		CASE "중력의 도끼－그랄"
			효과条件優先名前:0 = 가디언 그랄
			효과条件優先名前:1 = 가디언 트라이스
			효과条件劣後名前 = 가디언 에아토스
		CASE "섬광의 쌍검－트라이스"
			효과条件優先名前 = 가디언 에아토스
		CASE "록스 로즈 드래곤"
			SIF 발동済_1("상대",21151) == 0
				효과条件優先名前 = 화이트 로즈 드래곤
			SIF 발동済_1("상대",32153) == 0
				효과条件優先名前 = 바이올런스 위치
		CASE "운명의 여로"
			CALL FULLRESET_EXT
			濾過範囲손패 = 1
			濾過範囲필드 = 1
			濾過条件名前:0 = 아라메시아의 의
			濾過条件名前:1 = 아라메시아의 용사
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			IF RESULT != 1
				효과条件優先名前:0 = 성전의 수견사
			ELSE
				효과条件優先名前:0 = 방랑의 그리폰라이더
				효과条件優先名前:1 = 기룡 드라코백
				효과条件優先名前:2 = 빛의 성검 단넬
			ENDIF
		CASE "란카의 충혹마"
			SIF 발동済_1("상대",1379) == 0
