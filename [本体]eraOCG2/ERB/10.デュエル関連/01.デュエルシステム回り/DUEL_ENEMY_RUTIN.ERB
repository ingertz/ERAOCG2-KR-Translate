;カードをサーチ、효과での특수소환する時の優先度ボーナスはここで설정
@ENEMY_PRIORITY_FILTER(カードID,参照先,場所)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 場所
#DIM DYNAMIC カードID
#DIM DYNAMIC 발동カードID
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 攻撃力설정
#DIM DYNAMIC 修正値
#DIM DYNAMIC 返し値

IF GROUPMATCH(参照先,"상대필드","상대마함","상대묘지","상대손패","상대덱","상대제외","상대EX덱")
	修正値 += 99999
ELSEIF GROUPMATCH(参照先,"덱")
	修正値 += 50000
ENDIF

IF 효과条件손패취득 == 1
	CALL FULLRESET_EXT
	濾過範囲손패 = 1
	濾過条件ID = カードID
	CALL CARD_CHECK_EXT("상대")
	IF RESULT == 1
		;あったら修正値-20000
		修正値 += -20000
	ELSE
		;無かったら修正値+20000
		修正値 += 20000
	ENDIF
	TRYCALLFORM CARD_{カードID}("종류")
	IF RESULT == フィールド
		修正値 += 20
	ELSEIF RESULT == 지속마법
		修正値 += 10
	ELSEIF RESULT == 通常마법
		修正値 += 5
	ELSEIF RESULT == 速攻마법
		修正値 += 3
	ELSEIF RESULT == 装備마법
		修正値 += 0
	ELSEIF RESULT == 지속함정
		修正値 += 2
	ELSEIF RESULT == 通常함정
		修正値 += 1
	ENDIF

	TRYCALLFORM CARDNAME_{カードID}("名前")
	SELECTCASE RESULTS
		CASE "제알 웨폰－페가수스 트윈 세이버","제알 웨폰－라이트닝 블레이드","제알 웨폰－토네이도 브링거"
			修正値 += -10000
		CASE "원죄보－스네이크아이"
			SIF 발동済_1("상대",カードID) == 0 && 발동済_2("상대",カードID) == 0
				修正値 += 10000
		CASE "스네이크아이즈 포프루스"
			SIF 발동済_1("상대",カードID) == 0
				修正値 += 10000
		CASE "Live☆Twin 키스킬 프로스트","Live☆Twin 리일라 트리트","Live☆Twin 리일라 스위트"
			修正値 -= 500
	ENDSELECT
ENDIF

;同名ターン１효과を使ってる程に優先度下げ
SIF 발동済_1("상대",カードID)
	修正値 -= 500
SIF 발동済_2("상대",カードID)
	修正値 -= 500
SIF 발동済_3("상대",カードID)
	修正値 -= 500
SIF 발동済_4("상대",カードID)
	修正値 -= 500
SIF 발동済_P1("상대",カードID)
	修正値 -= 500
SIF 발동済_P2("상대",カードID)
	修正値 -= 500
SIF 발동済_P3("상대",カードID)
	修正値 -= 500

;カテゴリで一纏め
TRYCALLFORM CARDNAME_{カードID}("カテゴリ")
IF MATCH(RESULTS,"라뷰린스")
	TRYCALLFORM CARD_{カードID}("종류")
	IF RESULT <= 10 ;モンスターはモンスターゾーンの同名カードチェック（마함置き除去ケア）
		CALL FULLRESET_EXT
		濾過範囲필드 = 1
		濾過条件ID = カードID
		CALL CARD_CHECK_EXT("상대")
		IF RESULT == 1;あったら
			修正値 += -3000
		ENDIF
	ELSEIF INRANGE(RESULT,20,40) ;마함は마함ゾーンの同名カードチェック
		CALL FULLRESET_EXT
		濾過範囲마함 = 1
		濾過条件ID = カードID
		CALL CARD_CHECK_EXT("상대")
		IF RESULT == 1;あったら
			修正値 += -3000
		ENDIF
	ENDIF
ELSEIF MATCH(RESULTS,"스프라이트")
	TRYCALLFORM CARD_{カードID}("종류")
	IF RESULT == 효과モン
		SIF 발동済_2("상대",カードID)
			修正値 -= 500
	ENDIF
ENDIF

;個別での優先度修正
TRYCALLFORM CARDNAME_{カードID}("名前")
SELECTCASE RESULTS
	CASE "크샤트리라 유니콘"
		;同名カードチェック
		CALL FULLRESET_EXT
		濾過範囲필드 = 1
		濾過条件名前 = 크샤트리라 유니콘
		CALL CARD_CHECK_EXT("상대")
		IF RESULT == 1;あったら
			修正値 += -2000
		ELSE ;無かったら
			修正値 += 500
		ENDIF
	CASE "크샤트리라 펜리르"
		;同名カードチェック
		CALL FULLRESET_EXT
		濾過範囲필드 = 1
		濾過条件名前 = 크샤트리라 펜리르
		CALL CARD_CHECK_EXT("상대")
		IF RESULT == 1;あったら
			修正値 += -2000
		ELSE ;無かったら
			修正値 += 500
		ENDIF
	CASE "스케어클로 크샤트리라"
		;同名カードチェック
		CALL FULLRESET_EXT
		濾過範囲필드 = 1
		濾過条件名前 = 스케어클로 크샤트리라
		CALL CARD_CHECK_EXT("상대")
		IF RESULT == 1;あったら
			修正値 += 0
		ELSE ;無かったら
			修正値 += 2100
		ENDIF
	CASE "크샤트리라 라이즈하트"
		;同名カードチェック
		CALL FULLRESET_EXT
		濾過範囲필드 = 1
		濾過条件名前 = 크샤트리라 라이즈하트
		CALL CARD_CHECK_EXT("상대")
		IF RESULT == 1;あったら
			修正値 += 0
		ELSE ;無かったら
			修正値 += 800
		ENDIF
	CASE "크샤트리라 오우거"
		;同名カードチェック
		CALL FULLRESET_EXT
		濾過範囲필드 = 1
		濾過条件名前 = 크샤트리라 오우거
		CALL CARD_CHECK_EXT("상대")
		IF RESULT == 1;あったら
			修正値 += -2000
		ELSE ;無かったら
			修正値 += -500
		ENDIF
	CASE "M∀LICE＜P＞Dormouse"
		修正値 += 1000
	CASE "M∀LICE＜P＞White Rabbit"
		修正値 += 500
	CASE "M∀LICE＜C＞GWC-06"
		修正値 += 500
	CASE "M∀LICE＜C＞MTP-07"
		修正値 += 300
	CASE "센츄리온 프리메라"
		IF 발동済_1("상대",カードID)
			修正値 += -1000
		ELSE
			修正値 += 1000
		ENDIF
	CASE "센츄리온 트루디아"
		IF 발동済_1("상대",カードID)
			修正値 += -1000
		ELSE
			修正値 += 1000
		ENDIF
	CASE "센츄리온 아트리"
		IF 발동済_1("상대",カードID)
			修正値 += -1000
		ELSE
			修正値 += 1000
		ENDIF
	CASE "센츄리온 시메리아"
		IF 발동済_1("상대",カードID)
			修正値 += -1000
		ELSE
			修正値 += 1000
		ENDIF
	CASE "센츄리온 에메트ＶＩ"
		修正値 += -1000
	CASE "센츄리온 가고일ＩＩ"
		修正値 += -1000
	CASE "상검사－막야"
		修正値 += 200
	CASE "스프라이트 블루"
		修正値 += 300
	CASE "방랑의 그리폰라이더"
		修正値 += 1000
	CASE "저승사자 고즈"
		修正値 -= 10000
ENDSELECT

TRYCALLFORM CARDNAME_{カードID}("名前")
SIF MATCH(효과条件優先名前, RESULTS)
	修正値 += 10000

TRYCALLFORM CARDNAME_{カードID}("名前")
SIF MATCH(효과条件劣後名前, RESULTS)
	修正値 += -10000

TRYCALLFORM CARD_{カードID}("レベル")
SIF MATCH(효과条件優先レベル, RESULT)
	修正値 += 10000

TRYCALLFORM CARD_{カードID}("攻撃力")
SIF MATCH(효과条件優先攻撃力, RESULT)
	修正値 += 10000

$SKIP_RUTIN
IF 参照先 == "필드"
	返し値 = 상대_MZ_攻:場所 + 修正値
ELSE
	TRYCALLFORM CARD_{カードID}("攻撃力")
	返し値 = RESULT + 修正値
ENDIF
;PRINTFORML PRIORITY カードID:{カードID}/返し値:{返し値}
SIF 返し値 <= 0
	返し値 = 1
RETURN 返し値


;カードを효과での특수소환する時の優先するカードの指名はここで설정
@ENEMY_RUTIN_CARD_SS(参照先,場所,カードID)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 場所
#DIM DYNAMIC カードID
#DIM DYNAMIC 条件달성


SIF カードID <= 0
	RETURN 0

CALLFORM CARDNAME_{カードID}("名前")
SELECTCASE RESULTS
	CASE "Live☆Twin 엔트런스"
		CALL FULLRESET_EXT
		濾過範囲덱 = 1
		濾過条件名前:0 = Live☆Twin 키스킬
		濾過条件名前:1 = Live☆Twin 리일라
		CALL CARD_CHECK_EXT("상대",0,"",0)
		IF RESULT == 1
			효과条件優先名前:0 = Live☆Twin 키스킬
			효과条件優先名前:1 = Live☆Twin 리일라
		ENDIF
	CASE "이블 어썰트", "이블 히어로 시니스터 네크롬"
		CALL FULLRESET_EXT
		濾過範囲덱 = 1
		濾過条件カテゴリ = 이블 히어로
		濾過条件종류 = モン全般
		濾過条件固名前:0 = 이블 히어로 어더스터 골드
		CALL CARD_CHECK_EXT("상대",0,"",0)
		SIF RESULT == 1
			효과条件劣後名前:0 = 이블 히어로 어더스터 골드
	CASE "새크리파이스 데먼 로터스"
		CALL FULLRESET_EXT
		濾過範囲덱 = 1
		濾過条件名前 = 스피릿 오브 유벨
		CALL CARD_CHECK_EXT("상대",0,"",0)
		SIF RESULT == 1
			효과条件優先名前 = 스피릿 오브 유벨
	CASE "론 파이어 블로섬"
		SIF 발동済_1("상대",32154) == 0
			효과条件優先名前 = 밤장미 흑기사
	CASE "밤장미 흑기사"
		효과条件劣後名前 = 밤장미 흑기사
ENDSELECT


;本当に이 몬스터의 표시を표시변경権を使って変えていいのかの설정
@ENEMY_RUTIN_CHANGE_POSE(場所)
#DIM DYNAMIC 場所

SIF 상대_MZ_攻:場所 <= 1500
	RETURN 0
RETURN 1

;メインフェイズ１でセットする마법・함정はここで指名
@ENEMY_RUTIN_SET_CARD(場所)
#DIM DYNAMIC 場所
#DIM DYNAMIC カードID
#DIM DYNAMIC 지정カード

カードID = 상대_손패:場所

CALLFORM CARDNAME_{カードID}("名前")
SELECTCASE RESULTS
	CASE "홀티아의 충혹마"
		지정カード = 1
	CASE " M∀LICE＜C＞GWC-06", "M∀LICE＜C＞MTP-07", "M∀LICE＜C＞TB-11"
		지정カード = 1
	CASE "크로노다이버 파워리저브"
		지정カード = 1
	CASE "셰이프시스터"
		지정カード = 1
	CASE "액셀블록 카운터"
		지정カード = 1
	CASE "흑마술의 부적"
		지정カード = 1
ENDSELECT

;손패にハモンがあれば마법を優先的にセット
CALL FULLRESET_EXT
濾過範囲손패 = 1
濾過条件名前 = 번개황제 하몬
CALL CARD_CHECK_EXT("상대",0,"",0)
IF RESULT == 1
	CALLFORM CARDNAME_{カードID}("종류")
	SIF INRANGE(RESULT,通常마법,速攻마법)
		지정カード = 1
ENDIF

;손패にウリアがあれば함정を優先的にセット
CALL FULLRESET_EXT
濾過範囲손패 = 1
濾過条件名前 = 신염황제 우리아
CALL CARD_CHECK_EXT("상대",0,"",0)
IF RESULT == 1
	CALLFORM CARDNAME_{カードID}("종류")
	SIF INRANGE(RESULT,通常함정,지속함정)
		지정カード = 1
ENDIF


;１ターン目ではなく、メインフェイズ２でない場合は、RETURN 0する
SIF ターン数 != 1 && メインフェイズ２ == 0 && 지정カード == 0
	RETURN 0
RETURN 1



;자신의 ターンで行われる府フリーチェーン、処理用であってルーチン관계ない
@ENEMY_RUTIN_FRCHAIN
#DIM DYNAMIC 選択カード
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB

#DIM DYNAMIC 발동カード_ID
#DIM DYNAMIC 確認カード_ID
#DIMS DYNAMIC 参照先
#DIMS DYNAMIC 설정参照先
#DIM DYNAMIC 효과종류
#DIM DYNAMIC 설정효과종류
#DIM DYNAMIC 最大PRI値
#DIM DYNAMIC サーチ範囲


;――――――――――――――――――――――――――――――――――――――――――――――――――
;――효과발동のチェック―――――――――――――――――――――――――――――――――――――――
;――――――――――――――――――――――――――――――――――――――――――――――――――
VARSET カウンタB
VARSET 選択カード, -1
VARSET 最大PRI値, -1
$INPUT_EFFECT_LOOP
IF カウンタB == 0
	サーチ範囲 = 紙束最大値
	参照先 = 손패
	효과종류 = 손패起動
ELSEIF カウンタB == 1
	サーチ範囲 = 5
	参照先 = 필드
	효과종류 = 필드起動
ELSEIF カウンタB == 2
	サーチ範囲 = 5
	参照先 = 마함
	효과종류 = 마함起動
ELSEIF カウンタB == 3
	サーチ範囲 = 紙束最大値
	参照先 = 묘지
	효과종류 = 묘지起動
ENDIF

FOR カウンタ,0,サーチ範囲
	SIF GETVAR(@"상대_%参照先%:カウンタ") == -1
		CONTINUE
	確認カード_ID = GETVAR(@"상대_%参照先%:カウンタ")
	;カードの효과を使えて――
	TRYCALLFORM CARDCAN_{確認カード_ID}("상대",효과종류,参照先,カウンタ)
	IF RESULT == 1
		;설정したルーチンで、最大PRI値以上の結果が出た時に通される
		;1つ目は大体通ってしまう

		CALL ENEMY_RUTIN_ACT_EFFECT(효과종류,参照先,カウンタ,確認カード_ID)
		IF RESULT > 最大PRI値
			最大PRI値 = RESULT
			選択カード = カウンタ
			설정参照先 = %参照先%
			설정효과종류 = 효과종류
		ENDIF
	ENDIF
NEXT
IF カウンタB < 3
	カウンタB ++
	GOTO INPUT_EFFECT_LOOP
ENDIF

IF 選択カード != -1
	발동カード_ID = GETVAR(@"상대_%설정参照先%:選択カード")
	IF 参照先 == "손패"
		CALL KOJO_MESSAGE_SEND("DUEL",OPPOSER,4,발동カード_ID,1)
	ELSEIF 参照先 == "필드"
		CALL KOJO_MESSAGE_SEND("DUEL",OPPOSER,4,발동カード_ID,2)
	ELSEIF 参照先 == "마함"
		CALL KOJO_MESSAGE_SEND("DUEL",OPPOSER,4,발동カード_ID,3)
	ELSEIF 参照先 == "묘지"
		CALL KOJO_MESSAGE_SEND("DUEL",OPPOSER,4,발동カード_ID,4)
	ENDIF	
	SETCOLOR C_W_RED
	CUSTOMDRAWLINE —
	CALLFORM CARDNAME_{발동カード_ID}("名前")
	PRINTFORMW 상대는 %参照先%에서 『{選択カード}』%RESULTS%의 효과 발동 선언을 했습니다！
	CUSTOMDRAWLINE —
	RESETCOLOR
	CALLFORM CARD_STANBY(발동カード_ID,"상대",설정효과종류,설정参照先,選択カード)
	CALL CARD_FINAL(ターンプレイヤー)
	RETURN 0
ENDIF



;상대のモンスターの攻撃力を、효과込みで判断するのはここ
@ENEMY_RUTIN_ATK(듀얼리스트,攻撃先,攻撃元)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 攻撃先
#DIM DYNAMIC 攻撃元
#DIM DYNAMIC 与攻撃カードID
#DIM DYNAMIC 被攻撃カードID
#DIM DYNAMIC 攻撃力修正


被攻撃カードID = GETVAR(@"%듀얼리스트%_필드:攻撃先")
SIF 被攻撃カードID <= 0
	RETURN 0

CALLFORM CARDNAME_{被攻撃カードID}("名前")
SELECTCASE RESULTS
CASE "검의 미캉코 하레", "구슬의 미캉코 후우리", "거울의 미캉코 니니"
	CALL FULLRESET
	CALL CARD_EQUIP_CHECK(듀얼리스트,攻撃先,"필드")
	SIF RESULT == 0
		RETURN 0
	RETURN 999999
CASE "잭나이츠 파라디온 아스트람"
	SIF GETVAR(@"%듀얼리스트%_MZ_召種:攻撃元") != 召種通常
		RETURN 999999
;戦闘耐性＋ダメージ反射
CASE "오오히메의 미캉코", "아라히메의 미캉코", "우즈히메의 미캉코", "No.92 위해신룡 Heart－eartH Dragon", "유벨"
	RETURN 999999
;攻撃時誘発で戦闘상대を除去等
CASE "사이버스 퀀텀 드래곤"
	RETURN 999999
CASE "환상의 소환신 엑조디아"
	攻撃力修正 = GETVAR(@"%듀얼리스트%_MZ_攻:攻撃先") + GETVAR(@"ライフ_%듀얼리스트%")
	RETURN 攻撃力修正
ENDSELECT

CALLFORM CARDNAME_{被攻撃カードID}("カテゴリ")
SIF RESULTS == "시계신"
	RETURN 999999

攻撃力修正 = GETVAR(@"%듀얼리스트%_MZ_攻:攻撃先")
RETURN 攻撃力修正





;표시形式の決定
@ENEMY_RUTIN_POSE(カードID)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 표시形式

#DIM DYNAMIC 상대攻撃力
#DIM DYNAMIC 상대守備力
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名前


CALLFORM CARDNAME_{カードID}("名前")
カード名前 = %RESULTS%
SELECTCASE カード名前
	CASE "궁극의 푸른 눈의 영룡"
		표시形式 = 攻撃표시
	;ダメージ反射を持つカードは攻撃표시
	CASE "검의 미캉코 하레", "구슬의 미캉코 후우리", "거울의 미캉코 니니","오오히메의 미캉코", "아라히메의 미캉코", "우즈히메의 미캉코", "No.92 위해신룡 Heart－eartH Dragon", "유벨"
		표시形式 = 攻撃표시
CASEELSE
	CALLFORM CARD_{カードID}("攻撃力")
	상대攻撃力 = RESULT
	CALLFORM CARD_{カードID}("守備力")
	상대守備力 = RESULT
	IF 상대守備力 > 상대攻撃力
		표시形式 = 守備표시
	ENDIF
		;１ターン目で攻撃力と守備力が一緒なら守備표시に
		IF 상대守備力 == 상대攻撃力 && ターン数 == 1
			표시形式 = 守備표시
		ENDIF
		;EXモンスターじゃなく、攻撃力と守備力が０なら守備표시に
		TRYCALLFORM CARD_{カードID}("종류")
		IF RESULT <= 通常モン && 상대守備力 == 0 && 상대攻撃力 == 0
			표시形式 = 守備표시
	ENDIF
ENDSELECT

RESULTS = %표시形式%
RETURN 1
