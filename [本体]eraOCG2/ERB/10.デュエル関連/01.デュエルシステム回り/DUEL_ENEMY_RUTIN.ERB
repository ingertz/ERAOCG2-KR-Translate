;通常소환、EX소환するより先に、손패、フィールド等から효과발동する時の優先度ボーナスはここ
@ENEMY_RUTIN_ACT_EFFECT(종류,ゾーン,場所,カードID)
#DIM DYNAMIC カードID
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 返し値


SIF カードID <= 0
	RETURN -1

CALLFORM CARDNAME_{カードID}("名前")
SELECTCASE RESULTS
CASE "증원"
	返し値 += 10000
CASE "번개"
	CALL FULLRESET_EXT
	濾過範囲상대필드 = 1
	濾過条件CNT = 1
	CALL CARD_CHECK_EXT("상대",0,"",場所)
	SIF RESULT >= 1
		返し値 += 5500 * RESULT
CASE "크샤트리라 유니콘"
	返し値 += 3000
CASE "크샤트리라 펜리르"
	返し値 += 2000
CASE "서큐베 바르모니카"
	返し値 += 3000
CASE "엑스 라이제올"
	返し値 += 3000
CASE "네크로파데스의 의"
	返し値 += 10000
ENDSELECT


RETURN 返し値


;そもそも효과を발동するかの설정
@ENEMY_RUTIN_EFFECT(종류,ゾーン,場所,カードID)
#DIM DYNAMIC カードID
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 대상효과種
#DIM DYNAMIC 대상효과ID
#DIM DYNAMIC 行数カウント
#DIM DYNAMIC 行数カウント（終）
#DIM DYNAMIC 使用行数

#DIM DYNAMIC 後カード_ID
#DIMS DYNAMIC 後듀얼리스트
#DIM DYNAMIC 後효과種
#DIMS DYNAMIC 後ゾーン
#DIM DYNAMIC 後場所


IF 効後_カウンタ != 0
	後カード_ID = 効後_효과ID:(効後_カウンタ - 1)
	後듀얼리스트 = %効後_実行者:(効後_カウンタ - 1)%
	後효과種 = 効後_효과種:(効後_カウンタ - 1)
	後ゾーン = %効後_ゾーン:(効後_カウンタ - 1)%
	後場所 = 効後_設場所:(効後_カウンタ - 1)
ENDIF

SIF カードID <= 0
	RETURN 0
;基本的には同じIDの 카드는 연속的に발동しない
FOR カウンタ,0,100
	SIF GROUPMATCH(상대_誘発選択済:カウンタ,カードID)
		RETURN 1
NEXT

CALLFORM CARDNAME_{カードID}("名前")
SELECTCASE RESULTS
	CASE "사이코 엔드 퍼니셔"
		;場に자신しかいなければ발동しない
		IF 종류 == 필드起動
			SIF モンスター数("자신") == 0
				RETURN 1
			CALL FULLRESET_EXT
			濾過範囲필드 = 1
			濾過条件固名前 = 사이코 엔드 퍼니셔
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			SIF RESULT == 0
				RETURN 1
		ENDIF

	;トラブルサン：無駄に使わないようにするため
	CASE "Evil★Twin’s 트러블 써니","The Evil★Twins！키스킬＆리일라"
		SIF モンスター数("자신") == 0
			RETURN 1
	;シュトラールを戻させないため
	CASE "드래곤메이드의 전환"
		IF 종류 == 묘지起動
			CALL FULLRESET_EXT
			濾過範囲필드 = 1
			濾過条件カテゴリ = 드래곤메이드
			濾過条件종류 = 효과モン
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			SIF RESULT == 0
				RETURN 1
		ENDIF
	;상검顕現、有効な場間がないため
	CASE "용상검현"
		SIF 종류 == 제외時
			RETURN 1
	;同上
	CASE "충혹의 동산"
		SIF 종류 == 마함起動 && 상대_魔_表:場所 == 1
			RETURN 1

	CASE "비밀병기 폭탄"
		;상대場のカードの数が少ないと使わせない
		SIF (モンスター数("자신") + 마함数("자신")) < 4
			RETURN 1
	;デミス、裁き、無駄な殺傷はやめろ
	CASE "종언의 왕 데미스", "저지먼트 드래곤"
		SIF (モンスター数("자신") + 마함数("자신")) == 0
			RETURN 1
		SIF (モンスター数("상대") + 마함数("상대")) >= 3
			RETURN 1
	;無駄な殺傷はやめろ
	CASE "뉴스타트", "격류장"
		SIF モンスター数("자신") <= 1
			RETURN 1
	CASE "여섯 무사의 문"
		;카운터４個以上じゃなければ使わせない
		IF 종류 == 마함起動 && 상대_魔_表:場所 == 1
			SIF 상대_魔_個Ｃ:場所 < 4
				RETURN 1
		ENDIF
	CASE "여섯 무사의 결속"
		;카운터１個以下では使わせない
		IF 종류 == 마함起動 && 상대_魔_表:場所 == 1
			SIF 상대_魔_個Ｃ:場所 <= 1
				RETURN 1
		ENDIF
	;상대のモンスターがいなければ使わせない…？けど意図が分からなかったので一旦コメントアウト
	; CASE "드래그마의 기사 플루르드리스"
	; 	SIF (モンスター数("자신")) == 0
	; 		RETURN 1
	;(CPU)から見て자신のターン、 메인 페이즈에 は使わせない…んだったけど、ゼロが来て話が変わったので一旦コメントアウト
	; CASE "섬도희－레이"
	; 	SIF ターンプレイヤー == "상대" && メインフェイズ == 1
	; 		RETURN 1
	CASE "다크 다이브 봄버"
		;攻撃する前は使わせない
		IF 종류 == 필드起動
			SIF 상대_MZ_戦:場所 != 0
				RETURN 1
		ENDIF
	CASE "무한포영", "이펙트 뵐러", "상검대사－적소"
		;상대の효과발동に合わせて발동させる
		SIF 종류 != フリー誘発
			RETURN 1
		SIF 効後_カウンタ < 1
			RETURN 1

		FOR カウンタ,0,100
			SIF GROUPMATCH(상대_誘発選択済:カウンタ,90100,1095,50610)
				RETURN 1
		NEXT
	CASE "마를 새기는 데먼스미스"
		;상대フィールドに除去するカードが無ければ발동させない
		IF 종류 == 필드起動
			CALL FULLRESET_EXT
			濾過範囲상대필드 = 1
			濾過条件除去種 = 묘지
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			SIF RESULT == 0
				RETURN 1
		ENDIF
	CASE "플레시아의 충혹마"
		;묘지、제외にホールティアの충혹마が無ければ使わせない
		IF 종류 == 필드起動 || 종류 == フリー誘発
			CALL FULLRESET_EXT
			濾過範囲묘지 = 1
			濾過範囲제외 = 1
			濾過条件名前 = 홀티아의 충혹마
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			SIF RESULT == 0
				RETURN 1
		ENDIF
	CASE "날개들의 여왕 티타니아"
		;상대フィールドに除去するカードが無ければ발동させない
		IF 종류 == 필드起動 || 종류 == フリー誘発
			CALL FULLRESET_EXT
			濾過範囲상대필드 = 1
			濾過条件以攻撃力 = 2000
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			SIF RESULT == 0
				RETURN 1
		ENDIF
	CASE "숲을 채색하는 엘프 여왕"
		;상대フィールドに除去するカードが無ければ발동させない
		IF 종류 == 필드起動 || 종류 == フリー誘発
			CALL FULLRESET_EXT
			濾過範囲상대필드 = 1
			濾過条件CNT = 1
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			SIF RESULT < 2
				RETURN 1
		ENDIF
	CASE "하루 우라라"
		SIF 効後_カウンタ == 0
			RETURN 1
		SIF 後듀얼리스트 == "상대"
			RETURN 1

		うららチェック = 1

	;	PRINTFORML 다음카드_ID:{後カード_ID}/다음듀얼리스트:%後듀얼리스트%/다음효과종류:{後효과種}/다음존:%後ゾーン%/다음장소:{後場所}
		TRYCALLFORM CARDCAN_{後カード_ID}(後듀얼리스트,後효과種,後ゾーン,後場所)
		VARSET うららチェック
	;	PRINTFORMW 우라라체크패스 : {うららチェックパス}
		IF うららチェックパス == 0
			VARSET うららチェックパス	
			RETURN 1
		ELSE
			VARSET うららチェックパス	
		ENDIF
	CASE "저택 와라시"
		SIF 効後_カウンタ == 0
			RETURN 1
		SIF 後듀얼리스트 == "상대"
			RETURN 1
		わらしチェック = 1
		TRYCALLFORM CARDCAN_{後カード_ID}(後듀얼리스트,後효과種,後ゾーン,後場所)
		VARSET わらしチェック
		IF わらしチェックパス == 0
			VARSET わらしチェックパス	
			RETURN 1
		ELSE
			VARSET わらしチェックパス	
		ENDIF
	CASE "화목의 사자", "위협하는 포효", "패자의 일괄"
		;どれか１つでも발동していたら、발동しない
		SIF 발동済_1("상대",91090)
			RETURN 1
		SIF 발동済_1("상대",91091)
			RETURN 1
		SIF 발동済_1("상대",91100)
			RETURN 1
		SIF ターンプレイヤー == "상대"
			RETURN 1
	CASE "멸망룡 베이도스"
		;상대モンスターが無ければ使わせない
		IF 종류 == 戦破壊→묘지
			CALL FULLRESET_EXT
			濾過範囲상대필드 = 1
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			SIF RESULT == 0
				RETURN 1
		ENDIF
	CASE "No.39 유토피아"
		;자신のターンかつ、自身の攻撃で、손패にダブル・アップ・チャンスがなければ使わせない
		IF 종류 == 攻撃時誘発
			IF ターンプレイヤー == "상대"
				SIF 戦闘場所("상대") != 場所
					RETURN 1
				CALL FULLRESET_EXT
				濾過範囲손패 = 1
				효과条件名前 = 더블 업 찬스
				CALL CARD_CHECK_EXT("상대",0,"",場所)
				SIF RESULT == 0
					RETURN 1
			ENDIF
		ENDIF
	CASE "No.39 희망황 비욘드 더 호프"
		;自滅にしかならず、使わせるとしても使う場面の基準が作れないので一切使わせない
		IF 종류 == 필드起動 || 종류 == フリー誘発
			RETURN 1
		ENDIF
	CASE "갤럭시아이즈 포톤 드래곤"
		;攻撃力2000以外のモンスターは대상から外すように
		IF 종류 == 손패起動
			CALL FULLRESET_EXT
			濾過範囲필드 = 1
			濾過条件固攻撃力 = 2000
			濾過条件CNT = 1
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			SIF RESULT < 2
				RETURN 1
		ENDIF
	CASE "해제 버튼（TSP）"
		;自滅にしかならず、使わせるとしても使う場面の基準が作れないので一切使わせない
		RETURN 1
	CASE "M∀LICE＜Q＞HEARTS OF CRYPTER"
		;상대のカードが無ければ自滅する事が多いので使わせない
		IF 종류 == 필드起動 || 종류 == フリー誘発
			CALL FULLRESET_EXT
			濾過範囲상대필드 = 1
			濾過範囲상대마함 = 1
			濾過条件除去種 = 제외
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			SIF RESULT == 0
				RETURN 1
		ENDIF
	CASE "M∀LICE＜P＞March Hare"
		;상대ターンなら白うさぎが無ければ발동させない。자신ターンなら묘지に링크モンスターが無ければ발동させない
		IF ターンプレイヤー != "상대"
			CALL FULLRESET_EXT
			濾過範囲손패 = 1
			濾過範囲묘지 = 1
			濾過条件名前 = M∀LICE＜P＞White Rabbit
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			IF RESULT == 0
				CALL FULLRESET_EXT
				濾過範囲묘지 = 1
				濾過条件名前:0 = M∀LICE＜Q＞WHITE BINDER
				濾過条件名前:1 = M∀LICE＜Q＞RED RANSOM
				CALL CARD_CHECK_EXT("상대",0,"",場所)
				SIF RESULT == 0
					RETURN 1
			ENDIF
		ENDIF
	CASE "액세스코드 토커"
		;コストが자신しかいなければ발동しない
		IF 종류 == 필드起動
			CALL FULLRESET_EXT
			濾過範囲필드 = 1
			濾過範囲묘지 = 1
			濾過条件종류 = 링크
			濾過条件固名前 = 액세스코드 토커
			濾過条件속성:0 = 신속성
			SIF GETBIT(GETVAR(@"상대_MZ_T1汎数:場所"),0) != 1
				濾過条件속성:1 = 빛속성
			SIF GETBIT(GETVAR(@"상대_MZ_T1汎数:場所"),1) != 1
				濾過条件속성:2 = 어둠속성
			SIF GETBIT(GETVAR(@"상대_MZ_T1汎数:場所"),2) != 1
				濾過条件속성:3 = 땅속성
			SIF GETBIT(GETVAR(@"상대_MZ_T1汎数:場所"),3) != 1
				濾過条件속성:4 = 물속성
			SIF GETBIT(GETVAR(@"상대_MZ_T1汎数:場所"),4) != 1
				濾過条件속성:5 = 화염속성
			SIF GETBIT(GETVAR(@"상대_MZ_T1汎数:場所"),5) != 1
				濾過条件속성:6 = 바람속성
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			SIF RESULT == 0
				RETURN 1
		ENDIF
	CASE "기믹 퍼핏－블러디 돌"
		IF 종류 == 손패起動
			CALL FULLRESET_EXT
			濾過範囲EX덱 = 1
			濾過条件レベル = 8
			濾過条件종류 = 엑시즈
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			SIF RESULT != 1
				RETURN 1
		ENDIF
	CASE "웰컴 라뷰린스", "빅웰컴 라뷰린스"
		IF 종류 == 마함起動 || 종류 == フリー誘発
			IF GETVARS(@"상대_フィールド名") == "라뷰린스 래버린스"
				CALL FULLRESET_EXT	
				濾過範囲상대필드 = 1
				濾過範囲상대마함 = 1
				濾過条件除去種 = 묘지
				CALL CARD_CHECK_EXT("상대",0,"",場所)
				SIF RESULT != 1
					RETURN 1
			ENDIF
		ENDIF
	CASE "팬텀 포그 블레이드"
		;상대フィールドに대상になるカードが無ければ발동させない
		IF 종류 == 필드起動
			CALL FULLRESET_EXT
			濾過範囲상대필드 = 1
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			SIF RESULT == 0
				RETURN 1
		ENDIF
	CASE "클리어윙 싱크로 드래곤","크리스탈윙 싱크로 드래곤","크리스탈클리어윙 오버 싱크로 드래곤"
	;자신の효과に対して효과を발동させない
		SIF 後듀얼리스트 == "상대"
			RETURN 1
	CASE "플뢰르 드 바로네스"
		IF 종류 == ターン開始時
			SIF 효과발동済("상대",場所,ゾーン) == 0
				RETURN 1
		ENDIF
	CASE "흔들리는 눈빛"
		CALL FULLRESET_EXT
		濾過範囲마함 = 1
		濾過範囲상대마함 = 1
		濾過条件표시 = 10
		濾過条件CNT = 1
		CALL CARD_CHECK_EXT("상대",0,"",場所)
		SIF RESULT < 2
			RETURN 1
	CASE "순백의 성녀 에클레시아"
		IF 종류 == 필드起動 || 종류 == フリー誘発
			CALL FULLRESET_EXT
			濾過範囲EX덱 = 1
			濾過条件종류 = 싱크로
			濾過条件소환可 = 1
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			SIF RESULT == 1
				RETURN 1
		ENDIF
	CASE "데스 엠페러 데몬"
		IF 종류 == 손패起動
			CALL FULLRESET
			濾過範囲마함 = 1
			濾過範囲상대마함 = 1
			濾過条件표시 = 表側표시
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			SIF RESULT == 1
				RETURN 0
		ENDIF
	CASE "원석룡 어나더 베릴"
		IF 종류 == 필드起動
			RETURN 1
		ENDIF
	CASE "아이스 라이제올"
		IF 종류 == 손패起動
			SIF 발동済_2("상대",31224) == 0 && 소환権 >= 0
				RETURN 1
		ENDIF
	CASE "잭나이츠 오르페골 엔릴기르수"
		IF 종류 == 묘지起動 || (종류 == フリー誘発 && ゾーン == "묘지")
			CALL FULLRESET
			濾過範囲상대필드 = 1
			濾過範囲상대마함 = 1
			濾過条件除去種 = リリース
			CALL CARD_CHECK_EXT("상대",0,"",場所,カードID)
			SIF RESULT != 1
				RETURN 0
		ENDIF
	CASE "오르페골 롱기르수"
		IF 종류 == 필드起動 || 종류 == フリー誘発
			CALL FULLRESET
			濾過範囲상대필드 = 1
			濾過範囲상대마함 = 1
			濾過条件除去種 = リリース
			CALL CARD_CHECK_EXT("상대",0,"",場所,カードID)
			SIF RESULT != 1
				RETURN 1
		ENDIF
	CASE "브램블 로즈 드래곤"
		IF 종류 == 필드起動 || 종류 == フリー誘発
			CALL FULLRESET
			濾過範囲상대필드 = 1
			濾過範囲상대마함 = 1
			濾過条件除去種 = 묘지
			濾過条件CNT = 1
			CALL CARD_CHECK_EXT("상대",0,"",場所,カードID)
			SIF RESULT < 2
				RETURN 1
		ENDIF
	CASE "블랙 로즈 드래곤"
		IF 종류 == EX소환時
			CALL FULLRESET
			濾過範囲상대필드 = 1
			濾過範囲상대마함 = 1
			濾過条件除去種 = 묘지
			濾過条件CNT = 1
			CALL CARD_CHECK_EXT("상대",0,"",場所,カードID)
			SIF RESULT < 2
				RETURN 1
		ENDIF
	CASE "블러드 로즈 드래곤"
		IF 종류 == EX소환時
			CALL FULLRESET
			濾過範囲묘지 = 1
			濾過条件名前 = 블랙 로즈 드래곤
			CALL CARD_CHECK_EXT("상대",0,"",場所,カードID)
			SIF RESULT != 1
				RETURN 1
			CALL FULLRESET
			濾過範囲상대필드 = 1
			濾過範囲상대마함 = 1
			濾過条件除去種 = 묘지
			濾過条件CNT = 1
			CALL CARD_CHECK_EXT("상대",0,"",場所,カードID)
			SIF RESULT < 2
				RETURN 1
		ENDIF
	CASE "밤장미 흑기사"
		IF 종류 == 필드起動
			RETURN 1
		ENDIF
	CASE "베이슬 로즈 슛"
		IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
			CALL FULLRESET_EXT
			濾過範囲묘지 = 1
			濾過条件カテゴリ = 로즈
			濾過条件소환可 = 1
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			SIF RESULT != 1
				RETURN 1
		ENDIF
	CASE "방랑의 그리폰라이더", "일리걸 나이트", "키노의 충혹마"
		IF 종류 == フリー誘発
			SIF 効後_カウンタ != 0
				RETURN 1
			SIF 後듀얼리스트 == "상대"
				RETURN 1
		ENDIF
	CASE "란카의 충혹마"
		IF 종류 == 필드起動 || 종류 == フリー誘発
			RETURN 1
		ENDIF
	CASE "플레시아의 충혹마"
		IF 종류 == 필드起動 || 종류 == フリー誘発
			CALL FULLRESET
			濾過範囲상대필드 = 1
			濾過条件除去種 = 묘지
			CALL CARD_CHECK_EXT("상대",0,"",場所,カードID)
			SIF RESULT != 1
				RETURN 1
		ENDIF
ENDSELECT

;カテゴリチェック
CALLFORM CARDNAME_{カードID}("カテゴリ")
SELECTCASE RESULTS
CASE "함정 속으로"
	FOR カウンタ,0,100
		VARSET RESULTS
		TRYCALLFORM CARDNAME_{상대_誘発選択済:カウンタ}("カテゴリ")
		SIF RESULTS == "함정 속으로"
			RETURN 1
	NEXT
ENDSELECT

;CPUは자신마함に펜듈럼が２枚以上あれば펜듈럼の손패起動を使わない。
CALLFORM CARD_{カードID}("分割")
IF RESULT == 펜듈럼 && 종류 == 손패起動
	CALL FULLRESET_EXT
	濾過範囲마함 = 1
	濾過条件종류 = 펜듈럼
	濾過条件CNT = 1
	CALL CARD_CHECK_EXT("상대",0,"",場所)
	SIF RESULT >= 2
		RETURN 1
	;同名のPが마함にあれば、손패からそのPを발동しない
	CALL FULLRESET_EXT
	濾過範囲마함 = 1
	濾過条件ID = カードID
	CALL CARD_CHECK_EXT("상대",0,"",場所)
	SIF RESULT == 1
		RETURN 1
ENDIF

;同名のフィールド마법が自場にあれば、손패からそのフィールド마법を발동しない
CALLFORM CARD_{カードID}("종류")
IF RESULT == フィールド && 종류 == 손패起動
	CALL FULLRESET_EXT
	濾過範囲마함 = 1
	濾過条件ID = カードID
	CALL CARD_CHECK_EXT("상대",0,"",場所)
	SIF RESULT == 1
		RETURN 1
ENDIF

RETURN 0

;カードの素材化を守るための설정
@ENEMY_RUTIN_SOZAI(素材カードID,参照先,場所,소환カード_ID,소환法)
#DIM DYNAMIC 소환法
#DIM DYNAMIC 지정カード
#DIM DYNAMIC 소환カード_ID
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 場所
#DIM DYNAMIC 素材カードID
#DIM DYNAMIC 素材攻撃力
#DIM DYNAMIC 소환攻撃力
#DIM DYNAMIC 修正値
#DIM DYNAMIC 返し値
#DIM DYNAMIC 参照値１
#DIM DYNAMIC 参照値２

SIF ALT条件 >= 1
	RETURN 0
	
; IF GROUPMATCH(参照先,"상대필드","상대마함","상대묘지","상대손패","상대덱","상대제외","상대EX덱")
; 	修正値 -= 99999
; ELSEIF GROUPMATCH(参照先,"덱")
; 	修正値 -= 50000
; ENDIF

;基本、소환するモンスターと同名のカードは素材にしないように
IF 参照先 == "필드"
	IF 素材カードID == 소환カード_ID
		修正値 += 100000
	ENDIF
	;特定のカードは素材にしないように
	TRYCALLFORM CARDNAME_{素材カードID}("名前")
	SELECTCASE RESULTS
		CASE "세라의 충혹마"
			修正値 += 100000
		CASE "사랑에 빠진 소녀"
			修正値 += 100000
		CASE "기간틱 스프라이트"
			SIF 소환法 == 링크
				修正値 += 100000
		CASE "밤장미 흑기사"
			修正値 -= 98000
	ENDSELECT
ENDIF


SELECTCASE 소환法
	CASE 의식

	CASE 융합
		IF 参照先 == "필드"
			修正値 -= 15000
		ELSEIF 参照先 == "상대제외"
			修正値 -= 12000
		ELSEIF 参照先 == "상대묘지"
			修正値 -= 9000
		ELSEIF 参照先 == "상대덱"
			修正値 -= 6000
		ELSEIF 参照先 == "상대손패"
			修正値 -= 3000
		ENDIF
	CASE 싱크로
		CALLFORM CARD_{소환カード_ID}("レベル")
		IF RESULT < 8
			SIF 상대_MZ_攻:場所 > 1950
				修正値 += 98000
		ENDIF
	CASE 엑시즈
		CALLFORM CARD_{소환カード_ID}("レベル")
		IF RESULT < 5
			SIF 상대_MZ_攻:場所 > 1950
				修正値 += 98000
		ENDIF
	CASE 링크
		TRYCALLFORM CARD_{素材カードID}("レベル")
		参照値１ = RESULT
		TRYCALLFORM CARD_{소환カード_ID}("レベル")
		参照値２ = RESULT
		CALL ENEMY_RUTIN_PRIORITY(소환カード_ID,場所)
		参照値２ += RESULT
		SIF 参照値１ >= 参照値２
			修正値 += 100000
	CASEELSE
		SIF 상대_MZ_攻:場所 > 1950
			修正値 += 98000
ENDSELECT

;修正値 = -修正値


IF GROUPMATCH(参照先,"상대필드")
	返し値 = -상대_MZ_攻:場所 + 修正値
ELSEIF GROUPMATCH(参照先,"상대마함","상대묘지","상대손패","상대덱","상대제외","상대EX덱")
	TRYCALLFORM CARD_{素材カードID}("攻撃力")
	返し値 = -RESULT + 修正値
ELSEIF 参照先 == "필드"
	返し値 = 상대_MZ_攻:場所 + 修正値
ELSE
	TRYCALLFORM CARD_{素材カードID}("攻撃力")
	返し値 = RESULT + 修正値
ENDIF

;TRYCALLFORM CARDNAME_{カードID}("名前")
;PRINTFORML 素材「%RESULTS%」： 返し値:{返し値}

;評価値が100,000以上だと無視される
RETURN 返し値


;카드를 패에 加える処理で、どの카드가 選ばれるかの설정。
@ENEMY_RUTIN_CARD_ADD(参照先,場所,カードID)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 場所
#DIM DYNAMIC カードID
#DIMS DYNAMIC カード名
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 条件달성

듀얼리스트 = 상대

SIF カードID <= 0
	RETURN 0

CALLFORM CARDNAME_{カードID}("名前")
カード名 = %RESULTS%

;손패に加える処理の분기
IF 효과条件손패취득 == 1
	SELECTCASE カード名
		CASE "상검대사－적소"
			IF 발동済_1("상대",61895)
				CALL FULLRESET_EXT
				濾過範囲손패 = 1
				濾過範囲묘지 = 1
				濾過条件名前 = 상검사－막야
				CALL CARD_CHECK_EXT("상대",0,"",場所)
				IF RESULT == 0
					효과条件優先名前 = 상검사－막야
				ELSEIF RESULT == 1
					CALL FULLRESET_EXT
					濾過範囲손패 = 1
					濾過範囲묘지 = 1
					濾過条件名前 = 상검군사－용연
					CALL CARD_CHECK_EXT("상대",0,"",場所)
					SIF RESULT == 0
						효과条件優先名前 = 상검군사－용연
				ENDIF
			ELSE
				효과条件優先名前 = 용상검현
			ENDIF
		CASE "용상검현"
			CALL FULLRESET_EXT
			濾過範囲손패 = 1
			濾過範囲묘지 = 1
			濾過条件名前 = 상검사－막야
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			IF RESULT == 0
				효과条件優先名前 = 상검사－막야
			ELSEIF RESULT == 1
				CALL FULLRESET_EXT
				濾過範囲손패 = 1
				濾過範囲묘지 = 1
				濾過条件名前 = 상검군사－용연
				CALL CARD_CHECK_EXT("상대",0,"",場所)
				SIF RESULT == 0
					효과条件優先名前 = 상검군사－용연
			ENDIF
		CASE "여섯 무사의 군대장"
			CALL FULLRESET_EXT
			濾過範囲손패 = 1
			濾過範囲마함 = 1
			濾過条件名前 = 여섯 무사의 문
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			IF RESULT != 1
				효과条件優先名前 = 여섯 무사의 문
			ENDIF
		CASE "시엔의 봉화"
			효과条件優先名前 = 진 여섯 무사－카게키
		CASE "여섯 무사의 문"
			효과条件優先名前 = 진 여섯 무사－키잔
		CASE "E－이멀전시 콜"
			IF 소환権
				효과条件優先名前 = 엘리멘틀 히어로 에어맨
			ELSE
				CALL FULLRESET_EXT
				濾過範囲손패 = 1
				濾過条件名前 = 엘리멘트 스파크
				CALL CARD_CHECK_EXT("상대",0,"",場所)
				IF RESULT == 1
					효과条件優先名前:0 = 엘리멘틀 히어로 어나더 네오스
					효과条件優先名前:1 = 엘리멘틀 히어로 네오스
				ENDIF
			ENDIF
		CASE "엘리멘틀 히어로 에어맨"
			CALL FULLRESET_EXT
			濾過範囲손패 = 1
			濾過条件名前 = 엘리멘트 스파크
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			IF RESULT == 1
				효과条件優先名前:0 = 엘리멘틀 히어로 어나더 네오스
				효과条件優先名前:1 = 엘리멘틀 히어로 네오스
			ENDIF
		CASE "빛의 원군"
			효과条件優先名前 = 라이트로드 서머너 루미나스
		CASE "섬도희－카가리"
			효과条件優先名前 = 섬도기동－인게이지
		CASE "섬도희－시즈쿠"
			효과条件優先名前 = 섬도기동－인게이지
		CASE "섬도기동－인게이지"
			CALL FULLRESET_EXT
			濾過範囲손패 = 1
			濾過範囲필드 = 1
			濾過範囲묘지 = 1
			濾過条件名前:0 = 섬도희－레이
			CALL CARD_CHECK_EXT("상대",0,"",0)
			SIF RESULT == 0
				효과条件優先名前 = 섬도희－레이
		CASE "이블 히어로 어더스터 골드"
			효과条件劣後名前 = 이블 히어로 헬 라이더
		CASE "매혹의 뱀파이어레이디"
			효과条件劣後名前:0 = 유령토끼
			효과条件劣後名前:1 = 부유벚꽃
			효과条件劣後名前:2 = 저택 와라시
			효과条件劣後名前:3 = 하루 우라라
			효과条件劣後名前:4 = 사요 시구레
			효과条件劣後名前:5 = 하나 미즈키
		CASE "조커즈 스트레이트"
			CALL FULLRESET_EXT
			濾過範囲덱 = 1
			濾過条件名前 = 킹스 나이트
			CALL CARD_CHECK_EXT("상대",0,"",場所)
			IF RESULT == 1 
				효과条件優先名前 = 킹스 나이트
			ENDIF
		CASE "백업＠이그니스터"
			효과条件優先名前 = 위자드＠이그니스터
		CASE "M∀LICE＜P＞March Hare"
			효과条件優先名前:0 = M∀LICE＜P＞March Hare
			효과条件劣後名前:0 = M∀LICE＜Q＞RED RANSOM
			효과条件劣後名前:1 = M∀LICE＜Q＞WHITE BINDER
			효과条件劣後名前:2 = M∀LICE＜Q＞HEARTS OF CRYPTER
		CASE "라뷰린스 서번츠 아리안나"
			효과条件劣後名前 = 백은 성의 라뷰린스
		CASE "소울 레조네이터"
			효과条件優先名前:0 = 본 데몬
		CASE "콜 레조네이터","크림즌 헬가이아"
			효과条件優先名前:0 = 소울 레조네이터
		CASE "혹정의 새턴카모밀"
			효과条件優先名前:0 = 흑극정의 코스모스터
		CASE "흑극정의 코스모스터"
			효과条件優先名前:0 = 해학의 코스모스 공주
			효과条件優先名前:1 = 뒤섞는 코스모스 공주
		CASE "빛의 제너레이드 마르델"
