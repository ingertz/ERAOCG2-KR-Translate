@CHECK_STRUC_GET
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 덱,10000
#DIM DYNAMIC パック,10000
#DIM DYNAMIC 종족カウント,30
#DIM DYNAMIC カード数カウント
#DIM DYNAMIC 외부자数カウント
#DIM DYNAMIC 学生数カウント
#DIM DYNAMIC 펫数カウント
#DIM DYNAMIC ERA数カウント



FOR カウンタ,1000,100000
	VARSET RESULT
	VARSET RESULTS
	TRYCALLFORM CARDNAME_{カウンタ}("名前")
	SIF RESULTS == ""
		CONTINUE
	TRYCALLFORM CARD_{カウンタ}("トークン")
	SIF RESULT == 1
		CONTINUE
	SIF ITEM:カウンタ <= 0
		CONTINUE


	TRYCALLFORM CARDNAME_{カウンタ}("カテゴリ")
	SELECTCASE RESULTS
	CASE "충혹마"
		덱:100 += 1
	CASE "드래곤메이드"
		덱:101 += 1
	CASE "Live☆Twin","Evil☆Twin"
		덱:102 += 1
	CASE "센츄리온"
		덱:103 += 1
	CASE "엑소시스터"
		덱:104 += 1
	CASE "바르모니카"
		덱:105 += 1
	CASE "맬리스"
		덱:106 += 1
	ENDSELECT

	TRYCALLFORM CARDNAME_{カウンタ}("カテゴリ")
	SELECTCASE RESULTS
	CASE "HERO"
		パック:34 += 1
	CASE "라바르","염왕","참기"
		パック:36 += 1

	CASE "리추어","빙결계","네크로즈"
		パック:38 += 1
	CASE "뱅키시 소울","세리온즈","밸리언츠"
		パック:39 += 1
	CASE "루닉","클리포트","얼터가이스트"
		パック:40 += 1
	CASE "무사신","여섯 무사","첩자"
		パック:42 += 1
	CASE "리추어","의수경","점술공주","포츈 레이디","다이스"
		パック:17 += 1
	CASE "마계극단","어메이즈먼트","천후"
		パック:23 += 1
	CASE "티아라멘트","팬텀","생아발론","＠이그니스터"
		パック:47 += 1
	ENDSELECT
	TRYCALLFORM CARDNAME_{カウンタ}("カテゴリ")
	SIF MATCH(RESULTS,"E.R.A")
		ERA数カウント ++
	TRYCALLFORM CARD_{カウンタ}("종족")
	IF RESULT >= 1
		종족カウント:RESULT ++
	ENDIF
	カード数カウント ++
NEXT

;知り合いのTALENT周り
FOR カウンタ,1,CHARANUM
	SIF CFLAG:カウンタ:면식 == 0
		CONTINUE

	SIF TALENT:カウンタ:외부자 != 0
		외부자数カウント ++
	SIF TALENT:カウンタ:소속 == 1
		学生数カウント ++
	

	SIF TALENT:カウンタ:펫 == 1
		펫数カウント ++
NEXT
SIF FLAG:악랄치 <= 0
	パック:27 = 1
SIF FLAG:악랄치 >= 100
	パック:30 = 1



SIF 덱:100 >= 5
	CALL CARD_STRUC_GET(100,1)
SIF 덱:101 >= 5
	CALL CARD_STRUC_GET(101,1)
SIF 덱:102 >= 5
