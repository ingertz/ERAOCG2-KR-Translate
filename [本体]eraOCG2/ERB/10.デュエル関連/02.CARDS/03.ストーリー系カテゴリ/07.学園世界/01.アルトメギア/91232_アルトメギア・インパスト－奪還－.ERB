@CARDNAME_91232,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 아르토메기아 임파스토－탈환－
	CASE "略称"
		RESULTS = 신예학도－탈환－
	CASE "カテゴリ"
		RESULTS:0 = 아르토메기아
ENDSELECT


@CARD_91232(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 260124
ENDSELECT

RETURN 0

@CARD_EXPLANATION_91232(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 카드는 １턴에 １장밖에 발동할 수 없다。
PRINTL 자신 필드에 "아르토메기아" 몬스터가 존재하는 경우、
PRINTL 이 카드는 세트한 턴에도 발동할 수 있다。
PRINTL 상대는 이 카드의 발동에 대해서 효과를 발동할 수 없다。
CALLFORM CARD_ABLE(1,발동誘発)
PRINTL ①：상대가 몬스터의 효과를 발동했을 때에 발동할 수 있다。
PRINTL 자신 필드의 융합 몬스터 １장을 엔드 페이즈까지 제외하고、그 발동을 無効にし파괴한다。
PRINTL 그 후、자신 필드의 몬스터의 종족가 ３종류 이상인 경우、
PRINTL 상대 필드의 마법 / 함정 카드를 모두 패로 되돌린다。
;마법 / 함정 카드를 全てバウンスの任意化は後で誰かお願い


@CARDCAN_91232(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,91232)
SIF RESULT == 1
	RETURN 0

IF 종류 == 발동誘発
	SIF 발동済_1(듀얼리스트,91232)
		RETURN 1
	SIF ゾーン == "마함"
		RETURN 0
	;ゾーン処理も설정済み
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = 융합
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 상황確認
	SIF ゾーン != "마함"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 아르토메기아
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == チェーン可否
	RETURN 1
ENDIF


@CARDEFFECT_91232(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID


IF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91232,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과条件종류 = 융합
		효과条件行先플래그 = 제외行き
		효과条件추가플래그 = 1
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")
			IF RESULT == 1
				CALL FIELD_INFO_COUNT(듀얼리스트,"種")
				IF RESULT >= 3
					CALL FULLRESET
					효과範囲상대마함 = 1
					CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"손패")
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
