@CARDNAME_36031,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 감옥신영수－네르베도
	CASE "略称"
		RESULTS = 네르베도
	CASE "カテゴリ"
		RESULTS:0 = 아르토메기아
		RESULTS:1 = 감옥신
	CASE "検索カテゴリ"
		RESULTS:0 = 메디우스
ENDSELECT


@CARD_36031(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 미확인족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 300
	CASE "守備力"
		RETURN 200
	CASE "성별"
		RETURN 0
	CASE "分割"
		RETURN 펜듈럼
	CASE "レア度"
		RETURN RARE
	CASE "추가日"
		RETURN 260124
ENDSELECT
RETURN 0

@CARD_EXPLANATION_36031(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("P_MAGIC")
CALLFORM CARD_ABLE(P1,발동誘発)
PRINTL このカード名のＰ효과は１ターンに１度しか使用できない。
PRINTL ①：「감옥신」モンスターか「아르토메기아」モンスターの효과の발동にチェーンして
PRINTL 상대がモンスター효과を발동した時に발동できる。
PRINTL その발동を無効にし、このカードを破壊する。
CALL TEXT_DECORATION("P_MAGIC_2")
CALLFORM CARD_ABLE(3,EX덱起動)
PRINTL 자신の마법＆함정ゾーンに「혼절감옥신 비드리움」と「혼절감옥신 비드리움」を除く「감옥신」Pモンスターが存在する場合、
PRINTL １ターンに１度、このカードをEX덱から특수소환できる。
PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,필드起動)
PRINTL ①：덱の上からカード３枚を제외して발동できる。
PRINTL このカードを破壊し、EX덱から「創감옥신ネルヴァ」１体を융합소환扱いで특수소환する。
PRINTL （この효과で제외したカードの효과は誘発しない）
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：このカードがEX덱に加わった場合に발동できる。
PRINTL 「감옥신영수－네르베도」を除く、「감옥신」モンスターか「아르토메기아」モンスター１体を
PRINTL 자신の덱・EX덱（펜듈럼）から특수소환する。



@CARDCAN_36031(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC 選択カードID
#DIMS DYNAMIC 存在カード名,100
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,36031)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 발동誘発
	; Ｐ효과：상대のモンスター효과の발동にチェーンして발동
	SIF 발동済_P1(듀얼리스트,36031)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	TRYCALLFORM CARDNAME_{効後_효과ID:(効後_カウンタ - 2)}("カテゴリ")
	SIF MATCH(RESULTS,"감옥신")
		RETURN 1
	TRYCALLFORM CARDNAME_{効後_효과ID:(効後_カウンタ - 2)}("カテゴリ")
	SIF MATCH(RESULTS,"아르토메기아")
		RETURN 1
	RETURN 0

ELSEIF 종류 == EX덱起動
	SIF 발동済_3(듀얼리스트,36031)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,36031,"EX덱")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件名前 = 혼절감옥신 비드리움
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件カテゴリ = 감옥신
	효과条件分割 = 펜듈럼
	효과条件固名前 = 혼절감옥신 비드리움
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動
	; ①：덱の上からカード３枚を제외して발동
	SIF 발동済_1(듀얼리스트,36031)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 現山札数(듀얼리스트) < 3
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件名前 = 創감옥신ネルヴァ
	효과条件特不無視 = 1
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 효과後誘発
	; ②：このカードがEX덱に加わった場合に발동
	SIF 발동済_2(듀얼리스트,36031)
		RETURN 0
	CALL FULLRESET
	효과条件名前 = 감옥신영수－네르베도
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"ＥＸ山送")
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲EX덱 = 1
	효과条件종류 = モン全般
	효과条件カテゴリ:0 = 감옥신
	효과条件カテゴリ:1 = 아르토메기아
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_36031(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC 選択カードID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,36031)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF

ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,36031,P1)
	IF RESULT == 0
		; 상대のモンスター효과の발동を無効にする
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")
		; このカードを破壊する
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,破壊行き)
	ENDIF

ELSEIF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,36031,3)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,36031,1)
	IF RESULT == 0
		; 덱の上からカード３枚を제외
		CALL CARD_DECK_DISPOSE(듀얼리스트,"덱",3,完全제외行き)
		; このカードを破壊
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,破壊行き)
		; EX덱から「創감옥신ネルヴァ」を융합扱いで특수소환
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件名前 = 創감옥신ネルヴァ
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			CALL FULLRESET
			CALL CARD_EX_SUMMON(듀얼리스트,"EX덱",選択カード)
		ENDIF
	ENDIF

ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,36031,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲EX덱 = 1
		효과条件종류:0 = 효과モン
		효과条件종류:1 = 通常モン
		효과条件カテゴリ:0 = 감옥신
		효과条件カテゴリ:1 = 아르토메기아
		효과条件固名前 = 감옥신영수－네르베도
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF
