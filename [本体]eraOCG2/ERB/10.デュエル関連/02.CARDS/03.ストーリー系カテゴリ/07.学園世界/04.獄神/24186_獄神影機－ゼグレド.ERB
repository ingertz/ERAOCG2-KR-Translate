@CARDNAME_24186,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 감옥신영기－제그레도
	CASE "略称"
		RESULTS = 제그레도
	CASE "カテゴリ"
		RESULTS:0 = 둠즈
		RESULTS:1 = 감옥신
	CASE "検索カテゴリ"
		RESULTS:0 = 메디우스
ENDSELECT


@CARD_24186(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 300
	CASE "守備力"
		RETURN 200
	CASE "성별"
		RETURN 0
	CASE "分割"
		RETURN 펜듈럼
	CASE "レア度"
		RETURN RARE
	CASE "추가日"
		RETURN 260124
ENDSELECT
RETURN 0

@CARD_EXPLANATION_24186(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("P_MAGIC")
CALLFORM CARD_ABLE(P1,마함起動)
PRINTL 이 카드명의 Ｐ효과は１턴에 １번밖에 사용할 수 없다。
PRINTL ①：자신 메인 페이즈에 발동할 수 있다。
PRINTL このカードと자신의 패 / 필드（表側표시）の「감옥신」モンスターか「둠즈」몬스터 １장을 파괴한다。
PRINTL 그 후、필드의 카드 １장을 파괴할 수 있다。
CALL TEXT_DECORATION("P_MAGIC_2")
CALLFORM CARD_ABLE(3,EX덱起動)
PRINTL 자신의 마법＆함정 존에 「혼절감옥신 비드리움」と「혼절감옥신 비드리움」を除く「감옥신」P몬스터가 존재하는 경우、
PRINTL １턴에 １번、이 카드를 EX덱에서 특수 소환할 수 있다。
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,필드起動)
PRINTL ①：덱 위에서 カード３枚を제외하고 발동할 수 있다。
PRINTL 이 카드를 파괴하고、EX덱에서 「壊감옥신ユピテル」１장을 Ｘ소환扱いで특수 소환한다。
PRINTL 그 후、자신의 패를 １장 捨て、특수 소환한 몬스터의 Ｘ素材を１つ増やす事ができる。
PRINTL （이 효과로 제외したカード의 효과는 誘発しない）
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：이 카드가 EX덱に加わった場合に발동할 수 있다。
PRINTL 덱에서 「감옥신」마법・함정カードか「둠즈」마법 / 함정 카드 １장을 패에 넣는다。



@CARDCAN_24186(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC 選択カードID
#DIMS DYNAMIC 存在カード名,100
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,24186)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動
	; Ｐ효과：このカードと자신의 패 / 필드（表側표시）の「감옥신」か「둠즈」몬스터 １장을 파괴하고、その後필드의 카드 １장을 破壊する
	SIF 발동済_P1(듀얼리스트,24186)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲필드 = 1
	효과条件カテゴリ:0 = 감옥신
	효과条件カテゴリ:1 = 둠즈
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	; 필드의 카드를 破壊できるかチェック
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == EX덱起動
	SIF 발동済_3(듀얼리스트,24186)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,24186,"EX덱")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件名前 = 혼절감옥신 비드리움
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件カテゴリ = 감옥신
	효과条件分割 = 펜듈럼
	효과条件固名前 = 혼절감옥신 비드리움
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
	
ELSEIF 종류 == 필드起動
	; ①：덱 위에서 カード３枚を제외하고 발동（이 카드를 파괴하고、EX덱에서 「壊감옥신ユピテル」をＸ소환扱いで특수소환）
	SIF 발동済_1(듀얼리스트,24186)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 現山札数(듀얼리스트) < 3
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件名前 = 壊감옥신ユピテル
	효과条件特不無視 = 1
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 효과後誘発
	; ②：이 카드가 EX덱に加わった場合に발동（덱에서 「감옥신」또는 「둠즈」마법・함정を패에 加える）
	SIF 발동済_2(듀얼리스트,24186)
		RETURN 0
	CALL FULLRESET
	효과条件名前 = 감옥신영기－제그레도
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"ＥＸ山送")
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = 마법全般
	효과条件カテゴリ:0 = 감옥신
	효과条件カテゴリ:1 = 둠즈
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_24186(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC 選択カードID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24186)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF
ELSEIF 종류 == 마함起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24186,P1)
	IF RESULT == 0
		; 이 카드를 破壊
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,破壊行き)
		; 자신의 패 / 필드（表側）の「감옥신」か「둠즈」몬스터 １장을 破壊
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲필드 = 1
		효과条件カテゴリ:0 = 감옥신
		효과条件カテゴリ:1 = 둠즈
		효과条件종류 = モン全般
		효과条件行先플래그 = 破壊行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			; 필드의 카드 １장을 破壊
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲마함 = 1
			효과範囲상대필드 = 1
			효과範囲상대마함 = 1
			효과条件任意 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
		ENDIF
	ENDIF
ELSEIF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24186,3)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24186,1)
	IF RESULT == 0
		; 덱 위에서 カード３枚を제외
		CALL CARD_DECK_DISPOSE(듀얼리스트,"덱",3,完全제외行き)
		; 이 카드를 破壊
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,破壊行き)
		; EX덱에서 「壊감옥신ユピテル」をＸ소환扱いで특수소환
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件名前 = 壊감옥신ユピテル
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			CALL FULLRESET
			CALL CARD_EX_SUMMON(듀얼리스트,"EX덱",選択カード)
			; 그 후、자신의 패를 １장 捨てる
			CUSTOMDRAWLINE —
			PRINTL 【자신의 패를 １장 捨て、특수 소환한 몬스터의 Ｘ素材を１つ増やす事ができる。】
			CALL FULLRESET
			효과範囲손패 = 1
			효과条件任意 = 1
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				; 특수 소환한 몬스터의 Ｘ素材を１つ増やす
				CALL SET_FIELD_INFO(듀얼리스트,"필드",カード소환先,"Ｘ",1)
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24186,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종류 = 마법全般
		효과条件カテゴリ:0 = 감옥신
		효과条件カテゴリ:1 = 둠즈
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF

