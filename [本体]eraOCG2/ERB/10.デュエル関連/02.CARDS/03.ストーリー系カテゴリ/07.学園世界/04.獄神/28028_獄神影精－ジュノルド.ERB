@CARDNAME_28028,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 감옥신영정－쥬노르도
	CASE "略称"
		RESULTS = 쥬노르도
	CASE "カテゴリ"
		RESULTS:0 = 엘펜노츠
		RESULTS:1 = 감옥신
	CASE "検索カテゴリ"
		RESULTS:0 = 메디우스
ENDSELECT


@CARD_28028(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 300
	CASE "守備力"
		RETURN 200
	CASE "성별"
		RETURN 0
	CASE "分割"
		RETURN 펜듈럼
	CASE "レア度"
		RETURN RARE
	CASE "추가日"
		RETURN 260124
ENDSELECT
RETURN 0

@CARD_EXPLANATION_28028(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("P_MAGIC")
CALLFORM CARD_ABLE(P1,효과後誘発)
PRINTL 이 카드명의 Ｐ효과は１턴에 １번밖에 사용할 수 없다。
PRINTL ①：이 카드가 Ｐゾーンに存在する状態で、
PRINTL 자신 필드에 「감옥신」モンスターか「엘펜노츠」몬스터가 특수 소환된 場合に발동할 수 있다。
PRINTL 이 카드를 파괴하고、자신은 ２장 드로우한다。그 후、자신의 패를 １장 골라 버린다。
CALL TEXT_DECORATION("P_MAGIC_2")
CALLFORM CARD_ABLE(3,EX덱起動)
PRINTL 자신의 마법＆함정 존에 「혼절감옥신 비드리움」と「혼절감옥신 비드리움」を除く「감옥신」P몬스터가 존재하는 경우、
PRINTL １턴에 １번、이 카드를 EX덱에서 특수 소환할 수 있다。
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,필드起動)
PRINTL ①：덱 위에서 カード３枚を제외하고 발동할 수 있다。
PRINTL 이 카드를 파괴하고、EX덱에서 「調감옥신ジュノーラ」１장을 Ｓ소환扱いで특수 소환한다。
PRINTL （이 효과로 제외したカード의 효과는 誘発しない）
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：이 카드가 EX덱に加わった場合に발동할 수 있다。
PRINTL 「감옥신영수－네르베도」を除く、「감옥신」モンスターか「엘펜노츠」몬스터 １장을 
PRINTL 자신의 EX덱（펜듈럼）・묘지에서 패에 넣는다。



@CARDCAN_28028(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC 選択カードID
#DIMS DYNAMIC 存在カード名,100
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,28028)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 효과後誘発
	IF ゾーン == "마함"
		; P효과：이 카드가 Pゾーンに存在し、자신 필드에 「감옥신」か「엘펜노츠」몬스터가 특수 소환된 場合
		SIF 발동済_P1(듀얼리스트,28028)
			RETURN 0
		CALL FULLRESET
		효과条件カテゴリ:0 = 감옥신
		효과条件カテゴリ:1 = 엘펜노츠
		CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환")
		SIF RESULT != 1
			RETURN 0
		CALL CARD_DRAW_CHECK
	ELSE
		; ②：이 카드가 EX덱に加わった場合に발동（「감옥신영정－쥬노르도」を除く、「감옥신」か「엘펜노츠」몬스터를 EX덱（펜듈럼）・묘지에서 패에 加える）
		SIF 발동済_2(듀얼리스트,28028)
			RETURN 0
		
		CALL FULLRESET
		효과条件名前 = 감옥신영정－쥬노르도
		CALL CARD_CHECK_FIN_DATA(듀얼리스트,"ＥＸ山送")
		SIF RESULT != 1
			RETURN 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과範囲묘지 = 1
		효과条件종류 = モン全般
		효과条件カテゴリ:0 = 감옥신
		효과条件カテゴリ:1 = 엘펜노츠
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ENDIF
	RETURN 1

ELSEIF 종류 == EX덱起動
	SIF 발동済_3(듀얼리스트,28028)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,28028,"EX덱")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件名前 = 혼절감옥신 비드리움
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件カテゴリ = 감옥신
	효과条件分割 = 펜듈럼
	효과条件固名前 = 혼절감옥신 비드리움
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動
	; ①：덱上から3枚제외하고 발동。自身を파괴하고、EX덱에서 「調감옥신ジュノーラ」をS소환扱いで특수소환
	SIF 발동済_1(듀얼리스트,28028)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 現山札数(듀얼리스트) < 3
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件名前 = 調감옥신ジュノーラ
	효과条件特不無視 = 1
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_28028(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC 選択カードID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28028)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF

ELSEIF 종류 == 효과後誘発
	IF ゾーン == "마함"
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28028,P1)
		IF RESULT == 0
			; 이 카드를 파괴하고、2枚ドロー、その後패를 1枚골라 捨てる
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,破壊行き)
			CALL CARDDRAW_BASIC(듀얼리스트,2)
			IF RESULT == 1
				; 패를 1枚골라 捨てる
				CALL FULLRESET
				효과範囲손패 = 1
				CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
		ENDIF
	ELSE
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28028,2)
		IF RESULT == 0
			CALL FULLRESET
			효과範囲EX덱 = 1
			효과範囲묘지 = 1
			효과条件종류 = モン全般
			효과条件カテゴリ:0 = 감옥신
			효과条件カテゴリ:1 = 엘펜노츠
			효과条件固名前 = 감옥신영정－쥬노르도
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF

ELSEIF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28028,3)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28028,1)
	IF RESULT == 0
		; 덱 위에서 カード3枚を제외
		CALL CARD_DECK_DISPOSE(듀얼리스트,"덱",3,完全제외行き)
		; 이 카드를 破壊
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,破壊行き)
		; EX덱에서 「調감옥신ジュノーラ」をS소환扱いで특수소환
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件名前 = 調감옥신ジュノーラ
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			CALL FULLRESET
			CALL CARD_EX_SUMMON(듀얼리스트,"EX덱",選択カード)
		ENDIF
	ENDIF

ENDIF

