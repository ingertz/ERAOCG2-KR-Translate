@CARDNAME_16960,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 혼절감옥신 비드리움
	CASE "略称"
		RESULTS = 비드리움
	CASE "カテゴリ"
		RESULTS:0 = 감옥신
	CASE "検索カテゴリ"
		RESULTS:0 = 메디우스
ENDSELECT


@CARD_16960(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 12
	CASE "攻撃力"
		RETURN 5000
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 雄性
	CASE "分割"
		RETURN 펜듈럼
	CASE "連動ID"
		RETURN 1960
	CASE "소환불가"
		RETURN 1
	CASE "특수불가"
		RETURN 1
	CASE "レア度"
		RETURN ULR
	CASE "추가日"
		RETURN 260124
ENDSELECT
RETURN 0

@CARD_EXPLANATION_16960(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("P_MAGIC")
CALLFORM CARD_ABLE(P1,마함起動)
PRINTL 이 카드명의 Ｐ효과は１턴에 １번밖에 사용할 수 없다。
PRINTL ①：자신 메인 페이즈에 발동할 수 있다。
PRINTL 이 카드를 파괴하고、자신의 패 / 묘지에서 「감옥신」몬스터 １장을 특수 소환할 수 있다。
PRINTL 특수소환しなかった場合、대신에 이 턴 中、자신 필드의 レベル１２の「감옥신」몬스터의 공격력은 ５０００오른다。
CALL TEXT_DECORATION("P_MAGIC_2")
CALLFORM CARD_ABLE(0,EX덱起動,묘지起動)
PRINTL 이 카드는 通常소환할 수 없다。
PRINTL 융합 / Ｓ / Ｘ몬스터를 １体ずつ、자신의 フィールド（表側표시）・묘지에서 EX덱に戻した場合のみ
PRINTL EX덱 / 묘지에서 특수 소환할 수 있다。
PRINTL 이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,특수소환時)
PRINTL ①：이 카드가 특수 소환된 경우에 발동한다。
PRINTL 서로의 묘지의 카드를 全て제외한다。
PRINTL （이 효과로 제외したカード의 효과는 誘発しない）
CALLFORM CARD_ABLE(2,필드→묘지,破壊→묘지,戦闘→묘지)
PRINTL ②：이 카드가 EX덱に加わった場合に발동할 수 있다。
PRINTL 덱에서 「감옥신」카드 １장을 패에 넣는다。
CALLFORM CARD_ABLE(2,지속효과)
PRINTL ③：필드의 이 카드는 상대몬스터의 효과를 受けない。



@CARDCAN_16960(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC 選択カードID
#DIMS DYNAMIC 存在カード名,100
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,16960)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動
	SIF 발동済_P1(듀얼리스트,16960)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻紋章起動
	RETURN 1
ELSEIF 종류 == EX덱起動 || 종류 == 묘지起動
	CALL CARD_SS_CHECK(듀얼리스트,16960,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件종류 = 융합
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件종류 = 싱크로
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件종류 = 엑시즈
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 특수소환時
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲상대묘지 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	SIF 발동済_2(듀얼리스트,16960)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ:0 = 감옥신
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF




@CARDEFFECT_16960(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC 選択カードID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,16960)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF
ELSEIF 종류 == 마함起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,16960,P1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,破壊行き)
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 감옥신
		효과条件任意 = 1
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 1
			CALL CARD_RESERV(듀얼리스트,16960,攻紋章予約)
		ENDIF
	ENDIF
ELSEIF 종류 == 攻紋章起動
	CALL FULLRESET
	효과条件カテゴリ = 감옥신
	효과条件レベル = 12
	CALL STATCHANGE_BASIC(듀얼리스트,"필드",0,5000)

ELSEIF 종류 == EX덱起動 || 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,16960)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件종류 = 융합
		효과条件行先플래그 = EX덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲묘지 = 1
			효과条件종류 = 싱크로
			효과条件行先플래그 = EX덱行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲필드 = 1
				효과範囲묘지 = 1
				효과条件종류 = 엑시즈
				효과条件行先플래그 = EX덱行き
				CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
				IF RESULT == 1
					CALL FULLRESET
					CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
				ENDIF
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,16960)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_HYPER_DISPOSE(듀얼리스트,"묘지",完全제외行き)
		CALL FULLRESET
		CALL CARD_HYPER_DISPOSE(듀얼리스트,"상대묘지",完全제외行き)
	ENDIF

ELSEIF 종류 == 필드→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,16960,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ:0 = 감옥신
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"モ耐")
ENDIF


