@CARDNAME_28029,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 엘펜노츠의 감옥신정
	CASE "略称"
		RESULTS = 엘펜노츠감옥신정
	CASE "カテゴリ"
		RESULTS:0 = 엘펜노츠
		RESULTS:1 = 감옥신
	CASE "検索カテゴリ"
		RESULTS:0 = 메디우스
ENDSELECT


@CARD_28029(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 300
	CASE "守備力"
		RETURN 200
	CASE "튜너"
		RETURN 1
	CASE "성별"
		RETURN 0
	CASE "추가日"
		RETURN 251106
ENDSELECT
RETURN 0

@CARD_EXPLANATION_28029(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：자신은 Ｓ몬스터밖에 EX덱에서 특수 소환할 수 없다。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：자신 / 상대의 메인 페이즈에 발동할 수 있다。
PRINTL 자신의 중앙 몬스터 존의 몬스터 １장의 레벨을 턴 종료시까지 ３개 올린다。
PRINTL 그 후、"엘펜노츠" S몬스터가 "조감옥신 쥬노라" １장의 S소환을 할 수 있다。
CALLFORM CARD_ABLE(3,S素材時효과)
PRINTL ③：이 카드가 S소재로서 묘지로 보내진 경우에 발동할 수 있다。
PRINTL 덱에서 "엘펜노츠" 카드 １장을 패에 넣는다。
PRINTL 그 후、중앙 몬스터 존의 몬스터 １장을、중앙 이외의 몬스터 존으로 이동할 수 있다。
PRINTL （이동에는、지정한 몬스터를 제외하고 이루어진다）


@CARDSUMMON_AA_28029


@CARDCAN_28029(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC 選択カードID
#DIMS DYNAMIC 存在カード名,100

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,28029)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_2(듀얼리스트,28029)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_필드:2") == -1
		RETURN 0
	RETURN 1
ELSEIF 종류 == S素材時효과
	SIF 발동済_3(듀얼리스트,28029)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 엘펜노츠
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ENDIF


@CARDEFFECT_28029(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC 選択カードID
#DIMS DYNAMIC 存在カード名,100

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 지속효과
	CALL SET_TMP_EX_RST(듀얼리스트,"종류",싱크로)
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28029,2)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,"필드",2,"一星",3)
		CALL CARD_LOADUP
		CALL RESETAREA_MAT
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件スーパー名前 = 조감옥신 쥬노라
		효과条件カテゴリ = 엘펜노츠
		효과条件종류 = 싱크로
		효과条件소환可 = 2
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL RESETAREA_MAT
			CALL FULLRESET
			효과条件スーパー名前 = 조감옥신 쥬노라
			효과条件カテゴリ = 엘펜노츠
			효과条件종류 = 싱크로
			효과条件소환可 = 2
			효과条件任意 = 1
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
			選択カード = RESULT
			IF 選択カード != 9999
				TRYCALLFORM CARDSUMMON_{GETVAR(@"%듀얼리스트%_EX덱:{選択カード}")}(듀얼리스트,選択カード)
				CALL SYNSUMMON(듀얼리스트,選択カード)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == S素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28029,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 엘펜노츠
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_필드:2")}("종류")
			IF RESULT == 싱크로
				PRINTL
				PRINTL 중앙 몬스터 존의 몬스터 １장을 이동하시겠습니까？
				PRINTL
				CALL YN_CHOICE(듀얼리스트,"이동한다","이동하지않는다")
				IF RESULT == 0
					カウンタ = 現필드(듀얼리스트)
					CALL FULLRESET
					CALL CARD_SET_MOVE(듀얼리스트,2,10)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF

