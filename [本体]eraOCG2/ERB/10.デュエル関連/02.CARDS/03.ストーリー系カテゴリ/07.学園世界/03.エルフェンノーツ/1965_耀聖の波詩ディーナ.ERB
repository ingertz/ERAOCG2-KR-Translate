@CARDNAME_1965,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 엘펜노츠 디나
	CASE "略称"
		RESULTS = 디나
	CASE "カテゴリ"
		RESULTS:0 = 엘펜노츠
ENDSELECT


@CARD_1965(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 2400
	CASE "守備力"
		RETURN 1800
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251106
ENDSELECT

RETURN 0

@CARD_EXPLANATION_1965(종류)
#DIM DYNAMIC 종류


PRINTL 이 카드명의 ①②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：자신의 중앙 몬스터 존에 몬스터가 존재하지 않는 경우에 발동할 수 있다。
PRINTL 이 카드를 패에서 자신의 중앙 몬스터 존에 특수 소환한다。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：자신 메인 페이즈에 발동할 수 있다。
PRINTL 덱에서 "엘펜노츠" 지속 마법 카드 １장을 자신 필드에 앞면 표시로 놓는다。
CALLFORM CARD_ABLE(3,フリー誘発)
PRINTL ③：상대 턴에 발동할 수 있다。
PRINTL 자신 몬스터 존의、이 카드와 중앙 몬스터의 위치를 바꾼다。
PRINTL 그 후、상대의 패를 １장 골라 엔드 페이즈까지 제외할 수 있다。
PRINTL （바꾸는건、지정한 몬스터 ２장을 제외하고 이루어진다）


@CARDCAN_1965(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,1965)
SIF RESULT == 1
	RETURN 0


IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,1965)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,1965,"손패")
	SIF RESULT == 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_필드:2") != -1
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 && ターンプレイヤー == 듀얼리스트
	SIF 발동済_2(듀얼리스트,1965)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 엘펜노츠
	효과条件종류 = 지속마법
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF (종류 == 필드起動 || 종류 == フリー誘発) && ターンプレイヤー != 듀얼리스트
	SIF 발동済_3(듀얼리스트,1965)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF 場所 == 2
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_필드:2") == -1
		RETURN 0
	RETURN 1

ENDIF

@CARDEFFECT_1965(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 戦闘カード
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1965,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 필드起動 && ターンプレイヤー == 듀얼리스트
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1965,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 엘펜노츠
		효과条件종류 = 지속마법
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"表側표시")
	ENDIF
ELSEIF 종류 == 필드起動 && ターンプレイヤー != 듀얼리스트 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1965,3)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SET_MOVE_NEW(ゾーン,듀얼리스트,場所,듀얼리스트,2)
		IF RESULT == 1 && 손패数(対面者) != 0
			CALL FULLRESET
			효과範囲상대손패 = 1
			효과条件行先플래그 = 제외行き
			효과条件추가플래그 = 2
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF

