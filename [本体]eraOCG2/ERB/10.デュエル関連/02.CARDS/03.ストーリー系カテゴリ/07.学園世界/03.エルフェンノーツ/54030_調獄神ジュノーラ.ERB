@CARDNAME_54030,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 조감옥신 쥬노라
	CASE "略称"
		RESULTS = 조감옥신 쥬노라
	CASE "カテゴリ"
		RESULTS:0 = 감옥신
	CASE "検索カテゴリ"
		RESULTS:0 = 엘펜노츠
ENDSELECT


@CARD_54030(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 3100
	CASE "守備力"
		RETURN 3800
	CASE "튜너"
		RETURN 0
	CASE "추가日"
		RETURN 251106
ENDSELECT

RETURN 0

@CARDSUMMON_54030(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要レベル数 = 10

IF EX参照 == 0 || EX参照 == 1
	素材条件튜너 = 1
	素材条件スーパー場所 = 2
ELSEIF EX参照 >= 10
	素材条件튜너 = -1
ENDIF

IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,54030) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_54030(종류)
#DIM DYNAMIC 종류

PRINTL 튜너＋튜너 이외의 몬스터 １장 이상
PRINTL 이 카드를 Ｓ소환한 경우、자신의 중앙 메인 몬스터 존의 몬스터 １장을 튜너로 취급할 수 있다。
PRINTL 이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,EX소환時)
PRINTL ①：이 카드가 Ｓ소환된 경우에 발동할 수 있다。
PRINTL 상대 필드의 모든 앞면 표시 카드의 효과는 무효화된다。
CALLFORM CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ②：자신 / 상태 턴에 발동할 수 있다。
PRINTL 자신 필드의 "엘펜노츠" 몬스터의 수 만큼 상대 필드의 몬스터를 골라、
PRINTL 그 몬스터는 턴 종료시까지、소환 / 특수 소환의 소재로 할 수 없다。


@CARDCAN_54030(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,54030)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX소환時
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 無効
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_2(듀얼리스트,54030)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 엘펜노츠
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件除去種 = 不材
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_54030(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,54030,0)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과条件표시 = 10
		효과条件任意 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"無効")
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,54030,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 엘펜노츠
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		選択カード = RESULT
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件표시 = 10
		효과条件複数 = 100 - 選択カード
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"不材",1)
	ENDIF
ENDIF
