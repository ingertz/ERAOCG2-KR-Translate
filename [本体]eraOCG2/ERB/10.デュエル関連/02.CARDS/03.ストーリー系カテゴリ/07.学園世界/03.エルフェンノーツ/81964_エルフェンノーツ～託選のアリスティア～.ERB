@CARDNAME_81964,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 엘펜노츠～탁선의 아리스티아～
	CASE "略称"
		RESULTS = ～아리스티아～
	CASE "カテゴリ"
		RESULTS:0 = 엘펜노츠
ENDSELECT


@CARD_81964(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속함정
	CASE "추가日"
		RETURN 251106
ENDSELECT

RETURN 0

@CARD_EXPLANATION_81964(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(10,마함起動)
PRINTL ①：１턴에 １번、발동할 수 있다。
PRINTL 자신의 중앙 몬스터 존에 몬스터가 존재하는 경우、 그 몬스터를 중앙 이외의 몬스터 존으로 이동시킨다。
PRINTL 존재하지 않는 경우、중앙 이외의 몬스터 존의 몬스터 1장을 골라 중앙 몬스터 존으로 이동시킨다。
PRINTL （이동에는、지정한 몬스터를 제외하고 이루어진다）
CALLFORM CARD_ABLE(2,발동誘発)
PRINTL ②：자신 필드에 "엘펜노츠" 몬스터가 ３장 이상 존재하고、상대가 마법 / 함정 카드를 발동했을 때에 발동할 수 있다。
PRINTL 그 발동을 무효로 한다。
PRINTL 자신 필드에 Ｓ몬스터가 존재하는 경우、추가로 그 무효로 한 카드를 파괴한다。


@CARDCAN_81964(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성
#DIM DYNAMIC カウンタ

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,81964)
SIF RESULT == 1
	RETURN 0

IF (종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")) && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF モンスター数(듀얼리스트) >= 5
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF 발동済_2(듀얼리스트,81964)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	CALL FULLRESET
	효과条件종류 = 마함全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 엘펜노츠
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 3
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_81964(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 選択カード속성
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 속성数


IF (종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")) && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,81964,10)
	IF RESULT == 0
		$USE_EFFECT
		IF GETVAR(@"%듀얼리스트%_필드:2") != -1
			選択カード = 2
		ELSE
			CALL FULLRESET
			효과範囲필드 = 1
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
			選択カード = RESULT
		ENDIF
		IF RESULT != 9999
			;中央の場合
			IF 選択カード == 2
				カウンタ = 現필드(듀얼리스트)
				CALL FULLRESET
				CALL CARD_SET_MOVE_NEW("필드",듀얼리스트,選択カード,듀얼리스트,10)
			;それ以外の場合
			ELSEIF GETVAR(@"%듀얼리스트%_필드:2") == -1
				CALL FULLRESET
				CALL CARD_SET_MOVE_NEW("필드",듀얼리스트,選択カード,듀얼리스트,2)
			ENDIF
		ENDIF
	ENDIF
ELSEIF (종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")) && GETVAR(@"%듀얼리스트%_魔_表:場所") == 2
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,81964)
	IF RESULT == 0
		TRYCALLFORM CARDCAN_81964(듀얼리스트,마함起動,"마함",場所)
		IF RESULT == 1
			PRINTFORML 
			PRINTFORML 지금、효과를 사용하시겠습니까？
			PRINTFORML 
			CALL YN_CHOICE(듀얼리스트)
			IF RESULT == 0
				CALL CARD_EFFECT_USE(듀얼리스트,81964,2)
				GOTO USE_EFFECT
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,81964,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件종류 = 싱크로
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"묘지")
		ELSE
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")
		ENDIF
	ENDIF
ENDIF
