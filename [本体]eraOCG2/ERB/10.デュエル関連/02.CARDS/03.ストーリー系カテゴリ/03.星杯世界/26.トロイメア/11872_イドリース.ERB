@CARDNAME_11872,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 아스트로이메어 이드리스
	CASE "略称"
		RESULTS = 이드리스
	CASE "カテゴリ"
		RESULTS:0 = 트로이메어
		RESULTS:1 = 성유물
		RESULTS:2 = 이브
		RESULTS:4 = 용사
ENDSELECT


@CARD_11872(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
	
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 2100
	CASE "守備力"
		RETURN 2100
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		RETURN 1872
	CASE "추가日"
		RETURN 251123
ENDSELECT

RETURN 0

@CARD_EXPLANATION_11872(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １장밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動,묘지起動,フリー誘発)
PRINTL ①：필드의 링크 몬스터의 링크 마커의 합계가 ４이상인 경우에 발동할 수 있다。
PRINTL 이 카드를 패 / 묘지에서 특수 소환한다。
PRINTL 필드의 링크 몬스터의 링크 마커의 합계가 ８이상인 경우、이 효과는 상대 턴에도 발동할 수 있다。
CALLFORM CARD_ABLE(2,특수소환時)
PRINTL ②：이 카드가 특수 소환에 성공한 경우에 발동할 수 있다。
PRINTL 자신 / 상대 필드의 링크 몬스터를 전부 파괴한다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：자신 필드의 레벨 ９ 몬스터 및 "트로이메어" 몬스터는 효과로는 파괴되지 않는다。
PRINTL 


@CARDCAN_11872(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,11872)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動 || 종류 == 묘지起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,11872)
		RETURN 0

	SIF !GROUPMATCH(ゾーン,"손패","묘지")
		RETURN 0

	CALL CARD_SS_CHECK(듀얼리스트,11872,ゾーン)
	SIF RESULT == 1
		RETURN 0

	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件종류 = 링크
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT:2 < 4
		RETURN 0

	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件종류 = 링크
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT:2 < 8
		SIF メインフェイズ != 1
			RETURN 0
		SIF ターンプレイヤー != 듀얼리스트
			RETURN 0
		SIF 종류 == フリー誘発
			RETURN 0
	ENDIF
	RETURN 1

ELSEIF 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,11872)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件종류 = 링크
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_11872(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 손패起動 || 종류 == 묘지起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,11872,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン, 場所)
	ENDIF

ELSEIF 종류 == 특수소환時
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,11872,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종류 = 링크
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"両필드全体",場所,"묘지")
	ENDIF

ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件カテゴリ = 트로이메어
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"破耐")

	CALL FULLRESET
	효과条件종류 = レベル持ち
	효과条件レベル = 9
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"破耐")
ENDIF
