@CARDNAME_30457,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 트로이메어 크롤러
	CASE "略称"
		RESULTS = 악몽환기괴충
	CASE "カテゴリ"
		RESULTS:0 = 트로이메어
		RESULTS:1 = 크롤러
		RESULTS:3 = 게임 오리지널

ENDSELECT


@CARD_30457(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 곤충족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 100
	CASE "守備力"
		RETURN 2400
	CASE "추가日"
		RETURN 251123
ENDSELECT

RETURN 0

@CARD_EXPLANATION_30457(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １장밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時,リバース誘発)
PRINTL ①：이 카드가 소환에 성공한 경우、또는 이 카드가 리버스한 경우에 발동할 수 있다。
PRINTL 덱에서 "성유물" 몬스터 １장을 묘지로 보내고、"성유물" 마법 / 함정 카드 １장을 패에 넣는다。
PRINTL 이 턴、자신은 Ｌ 몬스터밖에 EX덱에서 특수 소환할 수 없다。
CALLFORM CARD_ABLE(2,L素材時효과)
PRINTL ②：이 카드가 링크 소재로서 묘지로 보내진 경우에 발동할 수 있다。
PRINTL 자신 필드의 "트로이메어" 몬스터의 수 만큼、패 / 덱에서 "트로이메어 크롤러"를특수 소환한다。

@CARDCAN_30457(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,30457)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == リバース誘発
	SIF 발동済_1(듀얼리스트,30457)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
    효과条件カテゴリ = 성유물
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
    효과条件カテゴリ = 성유물
	효과条件종류 = 마함全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == L素材時효과
	SIF 발동済_2(듀얼리스트,30457)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 트로이메어
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲손패 = 1
	효과条件名前 = 트로이메어 크롤러
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_30457(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 破壊カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성
#DIM DYNAMIC リピート횟수

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 소환時 || 종류 == リバース誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30457,1)
	IF RESULT == 0
		CALL FULLRESET
	    효과条件カテゴリ = 성유물
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"덱",ゾーン,場所)

		CALL FULLRESET
		효과条件カテゴリ = 성유물
		효과条件종류 = 마함全般
		CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所)

		EX소환可能종류 = 링크
		CALL CARD_EX_RESTRICTION(듀얼리스트)
	ENDIF

ELSEIF 종류 == L素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30457,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 트로이메어
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		リピート횟수 = RESULT

		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲손패 = 1
		효과条件名前 = 트로이메어 크롤러
		효과条件複数 = 100 - リピート횟수
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF

