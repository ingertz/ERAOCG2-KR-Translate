@CARDNAME_55041,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 엑스크롤러 뉴로고스
	CASE "略称"
		RESULTS = 뉴로고스
	CASE "カテゴリ"
		RESULTS:0 = 크롤러
ENDSELECT


@CARD_55041(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 곤충족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 1900
	CASE "守備力"
		RETURN 1900
	CASE "추가日"
		RETURN 251123
ENDSELECT

RETURN 0
@CARDSUMMON_55041(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 2
素材条件종족 = 곤충족

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,55041) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_55041(종류)
#DIM DYNAMIC 종류

PRINTL 곤충족モンスター２体
PRINTL このカード名の②③の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(0,지속효과,攻守変動)
PRINTL ①：자신フィールドの「크롤러」モンスターは戦闘耐性を得、攻撃力・守備力が３００アップし、
PRINTL 상대モンスターと戦闘を行う場合、상대に与える戦闘ダメージは倍になる。
CALLFORM CARD_ABLE(1,破壊→묘지,필드→戦離,필드→묘지,戦闘→묘지)
PRINTL ②：このカードが상대の효과でフィールドから離れた場合、または戦闘で破壊された場合、
PRINTL 자신の묘지のＬ以外の「크롤러」モンスターを２体まで대상として발동できる（同名カードは１枚まで）。
PRINTL そのモンスターを裏側守備표시で특수소환する。
CALLFORM CARD_ABLE(2,リバース誘発)
PRINTL ③：このカードがリバースした場合、덱からモンスター１体を묘지へ送って발동できる。
PRINTL 자신の묘지の「크롤러」モンスターを２体まで손패に加える。

@CARDCAN_55041(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,55041)
SIF RESULT == 1
	RETURN 0
IF 종류 == 破壊→묘지 || 종류 == 필드→戦離 || 종류 == 필드→묘지 || 종류 == 戦闘→묘지
	SIF 발동済_1(듀얼리스트,55041)
		RETURN 0
	IF 종류 != 戦闘→묘지
		SIF 処理中_듀얼리스트 == 듀얼리스트
			RETURN 0
	ENDIF
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종류 = レベル持ち
	효과条件カテゴリ = 크롤러
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == リバース誘発
	SIF 발동済_2(듀얼리스트,55041)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃時強制誘発
	SIF ゾーン != "필드"
		RETURN 0

	TRYCALLFORM CARDNAME_{戦闘カードID(듀얼리스트)}("カテゴリ")
	IF !MATCH(RESULTS,"크롤러")
		RETURN 0
	ENDIF

	SIF 戦闘場所(듀얼리스트,1) == 5
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_55041(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

IF 종류 == 攻撃時強制誘発
	CALL SET_PLAYER_INFO(듀얼리스트,"ダメージ倍化", 3 ,1)

ELSEIF 종류 == 破壊→묘지 || 종류 == 필드→戦離 || 종류 == 필드→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55041,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 크롤러
		효과条件종류 = レベル持ち
		효과条件固名前選択 = 1
		효과条件任意 = 1
		효과条件複数 = 98
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"裏側守備표시")
	ENDIF
ELSEIF 종류 == リバース誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55041,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"덱",ゾーン,場所)

		CALL FULLRESET
		효과条件カテゴリ = 크롤러
		효과条件종류 = モン全般
		효과条件任意 = 1
		효과条件複数 = 98
		CALL CARD_ADD_BASIC(듀얼리스트,"묘지",ゾーン,場所)
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件カテゴリ = 크롤러
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"戦耐")

ELSEIF 종류 == 攻守変動
	CALL FULLRESET
	효과条件カテゴリ = 크롤러
	CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,300,300)	
ENDIF
