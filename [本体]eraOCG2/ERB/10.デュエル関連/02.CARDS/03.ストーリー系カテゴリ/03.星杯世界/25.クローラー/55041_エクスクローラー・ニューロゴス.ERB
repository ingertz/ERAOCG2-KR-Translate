@CARDNAME_55041,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 엑스크롤러 뉴로고스
	CASE "略称"
		RESULTS = 뉴로고스
	CASE "カテゴリ"
		RESULTS:0 = 크롤러
ENDSELECT


@CARD_55041(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 곤충족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 1900
	CASE "守備力"
		RETURN 1900
	CASE "추가日"
		RETURN 251123
ENDSELECT

RETURN 0
@CARDSUMMON_55041(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 2
素材条件종족 = 곤충족

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,55041) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_55041(종류)
#DIM DYNAMIC 종류

PRINTL 곤충족 몬스터 ２장
PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １장밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,지속효과,攻守変動)
PRINTL ①：자신 필드의 "크롤러" 몬스터는 전투 내성을 얻고, 공격력・수비력이 ３００ 오르며,
PRINTL 상대 몬스터와 전투를 할 경우, 상대에게 주는 전투 데미지는 2배가 된다。
CALLFORM CARD_ABLE(1,破壊→묘지,필드→戦離,필드→묘지,戦闘→묘지)
PRINTL ②：이 카드가 상대의 효과로 필드에서 벗어난 경우、또는 전투로 파괴된 경우、
PRINTL 자신의 묘지의 Ｌ 이외의 "크롤러" 몬스터를 ２장까지 대상으로 하고 발동할 수 있다（같은 이름의 카드는 １장까지）。
PRINTL 그 몬스터를 뒷면 수비 표시로 특수 소환한다。
CALLFORM CARD_ABLE(2,リバース誘発)
PRINTL ③：이 카드가 리버스 한 경우、덱에서 몬스터 １장을 묘지로 보내고 발동할 수 있다。
PRINTL 자신의 묘지의 "크롤러" 몬스터를 ２장까지 패에 넣는다。

@CARDCAN_55041(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,55041)
SIF RESULT == 1
	RETURN 0
IF 종류 == 破壊→묘지 || 종류 == 필드→戦離 || 종류 == 필드→묘지 || 종류 == 戦闘→묘지
	SIF 발동済_1(듀얼리스트,55041)
		RETURN 0
	IF 종류 != 戦闘→묘지
		SIF 処理中_듀얼리스트 == 듀얼리스트
			RETURN 0
	ENDIF
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종류 = レベル持ち
	효과条件カテゴリ = 크롤러
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == リバース誘発
	SIF 발동済_2(듀얼리스트,55041)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃時強制誘発
	SIF ゾーン != "필드"
		RETURN 0

	TRYCALLFORM CARDNAME_{戦闘カードID(듀얼리스트)}("カテゴリ")
	IF !MATCH(RESULTS,"크롤러")
		RETURN 0
	ENDIF

	SIF 戦闘場所(듀얼리스트,1) == 5
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_55041(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

IF 종류 == 攻撃時強制誘発
	CALL SET_PLAYER_INFO(듀얼리스트,"ダメージ倍化", 3 ,1)

ELSEIF 종류 == 破壊→묘지 || 종류 == 필드→戦離 || 종류 == 필드→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55041,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 크롤러
		효과条件종류 = レベル持ち
		효과条件固名前選択 = 1
		효과条件任意 = 1
		효과条件複数 = 98
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"裏側守備표시")
	ENDIF
ELSEIF 종류 == リバース誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55041,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"덱",ゾーン,場所)

		CALL FULLRESET
		효과条件カテゴリ = 크롤러
		효과条件종류 = モン全般
		효과条件任意 = 1
		효과条件複数 = 98
		CALL CARD_ADD_BASIC(듀얼리스트,"묘지",ゾーン,場所)
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件カテゴリ = 크롤러
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"戦耐")

ELSEIF 종류 == 攻守変動
	CALL FULLRESET
	효과条件カテゴリ = 크롤러
	CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,300,300)	
ENDIF
