@CARDNAME_20356,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 토후섀도르 에그리스타
	CASE "略称"
		RESULTS = 섀도르에그리스타
	CASE "カテゴリ"
		RESULTS:0 = 섀도르
		RESULTS:1 = 리버스
ENDSELECT


@CARD_20356(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 2450
	CASE "守備力"
		RETURN 1950
	CASE "추가日"
		RETURN 251122
ENDSELECT

RETURN 0

@CARD_EXPLANATION_20356(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는１턴에 １번、어느쪽인가 １개밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,リバース誘発)
PRINTL ①：이 카드가 리버스한 경우에 발동할 수 있다。
PRINTL "토후섀도르 에그리스타" 이외의 자신 묘지의 "섀도르" 몬스터 １장의 리버스한 경우에 발동할 수 있는 효과를 적용한다。
CALLFORM CARD_ABLE(2,필드→묘지,손패→묘지,덱→묘지,破壊→묘지)
PRINTL ②：이 카드가 묘지로 보내진 경우에 발동할 수 있다。
PRINTL （이 효과를 발동한 턴、자신은 "섀도르" 몬스터밖에 EX덱에서 특수 소환할 수 없다）
PRINTL 자신의 패 / 필드 / 묘지의 몬스터를 융합 소재로서 제외하고、
PRINTL "섀도르" 융합 몬스터 １장을 융합 소환한다。


@CARDCAN_20356(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,20356)
SIF RESULT == 1
	RETURN 0

IF 종류 == リバース誘発
	SIF 발동済_1(듀얼리스트,20356)
		RETURN 0
	SIF 발동済_2(듀얼리스트,20356)
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件固名前 = 토후섀도르 에그리스타
	효과条件カテゴリ = 섀도르
	효과条件종류 = 효과モン
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지
	SIF 발동済_1(듀얼리스트,20356)
		RETURN 0
	SIF 발동済_2(듀얼리스트,20356)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과条件固カテゴリ = 섀도르
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"EX특수소환")
	SIF RESULT == 1
		RETURN 0

	CALL RESETAREA_MAT
	素材範囲손패 = 1
	素材範囲필드 = 1
	素材範囲묘지 = 1
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = 융합
	효과条件カテゴリ = 섀도르
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_20356(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == リバース誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,20356,1)
	IF RESULT == 0
		CALL FULLRESET
		효과条件固名前 = 토후섀도르 에그리스타
		효과条件カテゴリ = 섀도르
		효과条件종류 = 효과モン
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"묘지",ゾーン,場所)
		選択カード_ID = RESULT:99
		選択カード = RESULT
		TRYCALLFORM CARDEFFECT_{選択カード_ID}(듀얼리스트,リバース誘発,"효과処理",選択カード)
	ENDIF
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,20356,2)
	IF RESULT == 0
		CALL RESETAREA_MAT
		素材範囲손패 = 1
		素材範囲필드 = 1
		素材範囲묘지 = 1
		CALL FULLRESET
		효과条件종류 = 융합
		효과条件カテゴリ = 섀도르
		효과条件소환可 = 2
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			TRYCALLFORM CARDSUMMON_{GETVAR(@"%듀얼리스트%_EX덱:{選択カード}")}(듀얼리스트,選択カード)
			CALL FUSSUMMON(듀얼리스트,選択カード,제외行き)
		ENDIF
		CALL CARD_EX_RESTRICTION(듀얼리스트,"섀도르")
	ENDIF
ENDIF

