@CARDNAME_61832,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 레브섀도르 퓨전
	CASE "略称"
		RESULTS = 레브섀도르 퓨전
	CASE "カテゴリ"
		RESULTS:0 = 섀도르
		RESULTS:1 = 융합
ENDSELECT


@CARD_61832(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속마법
	CASE "レア度"
		RETURN ULR
	CASE "추가日"
		RETURN 251122
ENDSELECT

RETURN 0

@CARD_EXPLANATION_61832(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １장밖에 사용할 수 없으며、
PRINTL 이 효과를 발동한 턴、자신은 "섀도르" 몬스터밖에 EX덱에서 특수 소환할 수 없다。
CALLFORM CARD_ABLE(1,손패起動,마함起動)
PRINTL ①：이 카드의 발동시의 효과 처리로서、
PRINTL EX덱에서 융합 몬스터 １장을 묘지로 보낸다。
CALLFORM CARD_ABLE(2,마함起動)
PRINTL ③：자신 메인 페이즈에 발동할 수 있다。
PRINTL 자신 필드의 융합 몬스터 １장을 릴리스 한다。
PRINTL 그 후、릴리스한 몬스터와는 속성이 다른 "섀도르" 융합 몬스터 １장을 EX덱에서 융합 소환 취급으로 특수 소환한다。
PRINTL 이 효과로 융합 소환한 몬스터의 공격력은 ０이 된다。
 

@CARDCAN_61832(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,61832)
SIF RESULT == 1
	RETURN 0

CALL FULLRESET
효과条件固カテゴリ = 섀도르
CALL CARD_CHECK_FIN_DATA(듀얼리스트,"EX특수소환")
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 발동済_3(듀얼리스트,61832)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = 융합
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = 융합
	효과条件소환可 = 2
	효과条件特不無視 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,61832)
		RETURN 0
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = 융합
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF




@CARDEFFECT_61832(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 対面者
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_EX_RESTRICTION(듀얼리스트,"섀도르")

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,61832,3)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종류 = 융합
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"필드",ゾーン,場所)
		選択カード_ID = RESULT:1
		IF RESULT == 1
			CALL FULLRESET
			효과範囲EX덱 = 1
			효과条件종류 = 융합
			효과条件カテゴリ = 섀도르
			TRYCALLFORM CARD_{選択カード_ID},"속성"
			カウンタ = RESULT
			CALLFORM 효과条件속성_ADV(カウンタ,"以外")
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
			IF RESULT != 9999
				選択カード = RESULT
				CALL FULLRESET
				효과추가종류:0 = 4
				CALL CARD_EX_SUMMON(듀얼리스트,"EX덱",選択カード)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,61832,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		CALL FULLRESET
		효과条件종류 = 융합
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
	ENDIF
ENDIF

