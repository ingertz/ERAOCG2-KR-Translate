@CARDNAME_27606,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 쥬락 모노로브
	CASE "略称"
		RESULTS = Ｊ 모노로브
	CASE "カテゴリ"
		RESULTS:0 = 쥬락
ENDSELECT


@CARD_27606(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 비늘야수족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 1200
	CASE "성별"
		RETURN 無性
	CASE "추가日"
		RETURN 251026
	CASE "튜너"
		RETURN 1
	CASE "レア度"
		RETURN CMN
ENDSELECT

RETURN 0

@CARD_EXPLANATION_27606(종류)
#DIM DYNAMIC 종류
