@CARDNAME_53540,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 쥬락 메테오
	CASE "略称"
		RESULTS = Ｊ 메테오
	CASE "カテゴリ"
		RESULTS:0 = 쥬락
ENDSELECT


@CARD_53540(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 비늘야수족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 2800
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 無性
	CASE "추가日"
		RETURN 251026
	CASE "レア度"
		RETURN ULR
ENDSELECT

RETURN 0

@CARDSUMMON_53540(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件
CALL RESETCONDITION_MAT
必要レベル数 = 10
IF EX参照 == 0 || EX参照 == 1
	素材条件튜너 = 1
	素材条件カテゴリ = 쥬락
ELSEIF EX参照 >= 10
	素材条件튜너 = -1
	素材条件종족 = 비늘야수족
ENDIF

IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,53540) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_53540(종류)
#DIM DYNAMIC 종류
PRINTL "쥬락" 튜너＋튜너 이외의 비늘야수족 몬스터 １장 이상
;「쥬락」튜너＋튜너 이외의 비늘야수족モンスター２장 이상（類例が全て튜너外モンスター数が１장 이상 なのでそれに合わせる形で。）
CALL CARD_ABLE(1,EX소환時強制)
PRINTL ①：이 카드가 Ｓ소환된 경우에 발동한다。
PRINTL 필드의 카드를 전부 파괴한다。
PRINTL 그 후、자신의 묘지에서 튜너 １장을 특수 소환할 수 있다。


@CARDCAN_53540(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,53540)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX소환時強制
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_53540(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

;PRINTFORMW 종류:{종류}

IF  종류 == EX소환時強制
	CALL FULLRESET
	CALL CARD_REMOVAL_BASIC(듀얼리스트,"両全場全体",場所,"묘지")
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件튜너 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
ENDIF
