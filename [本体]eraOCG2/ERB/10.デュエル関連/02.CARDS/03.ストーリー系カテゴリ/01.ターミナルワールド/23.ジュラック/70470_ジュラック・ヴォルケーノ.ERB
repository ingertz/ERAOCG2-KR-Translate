@CARDNAME_70470,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 쥬락 볼케이노
	CASE "略称"
		RESULTS = Ｊ 볼케이노
	CASE "カテゴリ"
		RESULTS:0 = 쥬락
ENDSELECT


@CARD_70470(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN フィールド
	CASE "レア度"
		RETURN SPR
	CASE "추가日"
		RETURN 251026
ENDSELECT

RETURN 0

@CARD_EXPLANATION_70470(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動)
PRINTL ①：자신メインフェイズに발동できる。
PRINTL 자신フィールドの비늘야수족モンスター１体を破壊し、덱から「쥬락」モンスター１体を특수소환する。
CALLFORM CARD_ABLE(2,소환誘発)
PRINTL ②：상대がモンスターを특수소환した場合、このターンに상대がモンスターの효과を４回以上발동していれば발동できる。
PRINTL ＥＸ덱から「쥬락 메테오」１体をＳ소환扱いで특수소환する。
CALLFORM CARD_ABLE(3,身代효과)
PRINTL ③：자신フィールドの「쥬락」モンスターが효과で破壊される場合、
PRINTL 代わりに자신の묘지の비늘야수족モンスター１体を제외できる。

@CARDCAN_70470(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 名称

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,70470)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 발동済_1(듀얼리스트,70470)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 쥬락
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종족 = 비늘야수족
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	IF 종류 == 마함起動
		SIF GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
			RETURN 0
	ENDIF
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환誘発
	SIF 발동済_2(듀얼리스트,70470)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	SIF 最終소환決者 == 듀얼리스트
		RETURN 0
	SIF 最終소환타입 != "특수"
		RETURN 0
	SIF GET_PLAYER_INFO(듀얼리스트,"モン발동数",1,) <= 3
		RETURN 0
	CALL FULLRESET	
	효과範囲EX덱 = 1
	효과条件名前 = 쥬락 메테오
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)	
	SIF RESULT < 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 5
		RETURN 0
	RETURN 1
ELSEIF 종류 == 身代효과
	SIF 발동済_3(듀얼리스트,70470)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종족 = 비늘야수족
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	TRYCALLFORM CARDNAME_{破壊대상ID}("カテゴリ")
	SIF !MATCH(RESULTS,"쥬락")
		RETURN 0
	SIF !GROUPMATCH(破壊종류,"효과","효과")
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	SIF 破壊대상ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_70470(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 효과先
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,70470,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件종족 = 비늘야수족
		효과条件行先플래그 = 破壊行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 쥬락
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,70470,0)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF
ELSEIF 종류 == 소환誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,70470,2)
	IF RESULT == 0
		CALL FULLRESET	
		효과条件名前 = 쥬락 메테오
	    CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
    	IF RESULT != 9999
        	CALL CARD_EX_SUMMON(듀얼리스트,"EX덱",RESULT)
    	ENDIF
	ENDIF
ELSEIF 종류 == 身代효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,70470,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종족 = 비늘야수족
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"묘지",ゾーン,場所)
   		SIF RESULT == 1
			RETURN 1
	ENDIF
	RETURN 0
ENDIF