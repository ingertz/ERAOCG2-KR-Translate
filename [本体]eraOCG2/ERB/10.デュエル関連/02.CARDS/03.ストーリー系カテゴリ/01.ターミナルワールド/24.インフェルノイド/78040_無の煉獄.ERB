@CARDNAME_78040,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 무의 연옥
	CASE "略称"
		RESULTS = 무의 연옥
	CASE "カテゴリ"
		RESULTS:0 = 연옥
ENDSELECT


@CARD_78040(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
	CASE "レア度"
		RETURN SPR
	CASE "추가日"
		RETURN 251123
ENDSELECT

RETURN 0

