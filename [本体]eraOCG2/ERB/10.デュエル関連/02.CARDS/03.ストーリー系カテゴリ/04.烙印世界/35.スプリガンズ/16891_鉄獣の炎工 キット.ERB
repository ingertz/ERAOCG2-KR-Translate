@CARDNAME_16891,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 트라이브리게이드 스프리건즈 키트
	CASE "略称"
		RESULTS = 철수의 염공 키트
	CASE "カテゴリ"
		RESULTS:0 = 트라이브리게이드
		RESULTS:1 = 스프리건즈
		RESULTS:2 = 알버스
ENDSELECT


@CARD_16891(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 야수족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1700
	CASE "守備力"
		RETURN 1000
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		RETURN 1891
ENDSELECT

RETURN 0

@CARD_EXPLANATION_16891(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：자신 필드에 "트라이브리게이드 스프리건즈 키트" 이외의、
PRINTL "트라이브리게이드" 몬스터 또는 "스프리건즈" 몬스터가 존재하는 경우에 발동할 수 있다。
PRINTL 이 카드를 패에서 특수 소환한다。
CALLFORM CARD_ABLE(2,필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지)
PRINTL ②：이 카드가 묘지로 보내진 경우에 발동할 수 있다。
PRINTL "트라이브리게이드 스프리건즈 키트"를 제외한、이하의 몬스터 중 １장을 자신 묘지에서 수비 표시로 특수 소환한다。
PRINTL ●"트라이브리게이드" 몬스터
PRINTL ●"스프리건즈" 몬스터
PRINTL ●"알버스" 몬스터



@CARDCAN_16891(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,16891)
SIF RESULT == 1
	RETURN 0


IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,16891)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,16891,"손패")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件固名前 = 트라이브리게이드 스프리건즈 키트
	효과条件カテゴリ:0 = 트라이브리게이드
	효과条件カテゴリ:1 = 스프리건즈
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	SIF 발동済_2(듀얼리스트,16891)
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件固名前 = 트라이브리게이드 스프리건즈 키트
	효과条件カテゴリ:0 = 트라이브리게이드
	효과条件カテゴリ:1 = 스프리건즈
	효과条件カテゴリ:2 = 알버스
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_16891(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件チェック
#DIM DYNAMIC 条件달성,5


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF  종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,16891,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,"손패",場所)
	ENDIF
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALl CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,16891,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件固名前 = 트라이브리게이드 스프리건즈 키트
		효과条件カテゴリ:0 = 트라이브리게이드
		효과条件カテゴリ:1 = 스프리건즈
		효과条件カテゴリ:2 = 알버스
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF



