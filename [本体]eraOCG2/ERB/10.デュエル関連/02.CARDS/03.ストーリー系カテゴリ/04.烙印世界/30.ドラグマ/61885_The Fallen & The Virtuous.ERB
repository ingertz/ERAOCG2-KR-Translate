@CARDNAME_61885,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = The Fallen ＆ The Virtuous
	CASE "略称"
		RESULTS = 낙윤과 성녀
	CASE "カテゴリ"
		RESULTS:0 = 낙인
		RESULTS:1 = 드래그마
ENDSELECT


@CARD_61885(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
	CASE "レア度"
		RETURN ULR
	CASE "추가日"
		RETURN 251025
ENDSELECT
RETURN 0

@CARD_EXPLANATION_61885(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 카드는 １턴에 １장밖에 발동할 수 없다。
CALLFORM CARD_ABLE(1,마함起動,손패起動,フリー誘発)
PRINTL ①：이하의 효과에서 １개를 선택해서 발동할 수 있다。
PRINTL ●EX덱에서 "알버스" 몬스터 １장을 묘지로 보내고、
PRINTL 필드의 앞면 표시 카드 １장을 파괴한다。
PRINTL ●자신의 필드 / 묘지에 "에클레시아" 몬스터가 존재하는 경우、
PRINTL 자신 / 상대 묘지의 몬스터 １장을 자신 필드에 특수 소환한다。



@CARDCAN_61885(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성
#DIM DYNAMIC EX条件달성
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,61885)
SIF RESULT == 1
	RETURN 0


IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 발동済_1(듀얼리스트,61885)
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件カテゴリ = 알버스
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 1
		CALL FULLRESET
		IF 듀얼리스트 == "자신"
		효과範囲필드 = 1
		효과範囲마함 = 1
		ENDIF
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과条件표시 = 10
		효과条件除去種 = 묘지
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			RETURN 1
	ENDIF
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 에클레시아
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 1
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲상대묘지 = 1
		효과条件종류 = モン全般
		효과条件소환可 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			RETURN 1
	ENDIF
	RETURN 0
ENDIF


@CARDEFFECT_61885(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC EX参照
#DIM DYNAMIC 묘지送カード,10
#DIM DYNAMIC 손패묘지送カード,10
#DIM DYNAMIC 素材数
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択済カード
#DIM DYNAMIC 条件달성A
#DIM DYNAMIC 条件달성B
;융합소환
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,61885,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件カテゴリ = 알버스
		효과条件종류 = モン全般
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과範囲상대마함 = 1
			효과条件표시 = 10
			효과条件除去種 = 묘지
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				条件달성A = 1
		ENDIF
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 에클레시아
		효과条件종류 = モン全般
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과範囲상대묘지 = 1
			효과条件종류 = モン全般
			효과条件소환可 = 1
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				条件달성B = 1
		ENDIF

		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)

		IF 条件달성A == 1 && 条件달성B == 1
			PRINTFORML
			PRINTFORML 어느 효과를 사용하시겠습니까？
			PRINTFORML
			PRINTFORML [1] - EX덱에서 "알버스" 몬스터 １장을 묘지로 보내고, 필드의 앞면 표시 카드 １장을 파괴한다.
			PRINTFORML [2] - 자신 / 상대 묘지의 몬스터 １장을 자신 필드에 특수 소환한다.
			BINPUT
		ELSEIF 条件달성A == 1 && 条件달성B == 0
			RESULT = 1
		ELSEIF 条件달성A == 0 && 条件달성B == 1
			RESULT = 2
		ENDIF
		IF RESULT == 1
			CALL FULLRESET
			효과範囲EX덱 = 1
			효과条件カテゴリ = 알버스
			효과条件종류 = モン全般
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲필드 = 1
				효과範囲마함 = 1
				효과範囲상대필드 = 1
				효과範囲상대마함 = 1
				효과条件표시 = 表側표시
				CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
			ENDIF
		ELSEIF RESULT == 2
			CALL FULLRESET
			효과範囲묘지 = 1
			효과範囲상대묘지 = 1
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF
