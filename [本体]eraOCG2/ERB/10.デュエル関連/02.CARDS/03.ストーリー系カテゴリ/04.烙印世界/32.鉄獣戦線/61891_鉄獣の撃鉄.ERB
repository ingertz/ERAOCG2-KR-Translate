@CARDNAME_61891,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 트라이브리게이드 해머
	CASE "略称"
		RESULTS = 철수의 격철
	CASE "カテゴリ"
		RESULTS:0 = 트라이브리게이드
ENDSELECT


@CARD_61891(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
	CASE "추가日"
		RETURN 251218
ENDSELECT

RETURN 0

@CARD_EXPLANATION_61891(종류)
#DIM DYNAMIC 종류
;묘지に送ったこのカードも素材にできるな・・・まあいいや
PRINTL 이하의 효과에서 １개를 선택해서 발동할 수 있다（이 카드명의 이하의 효과는 각각 １턴에 １번밖에 선택할 수 없다）。
CALLFORM CARD_ABLE(1,마함起動 ,손패起動,フリー誘発)
PRINTL ●덱에서 "트라이브리게이드 해머" 이외의 "트라이브리게이드" 마법 / 함정 카드 １장을 패에 넣는다。
CALLFORM CARD_ABLE(2,마함起動 ,손패起動,フリー誘発)
PRINTL ●자신 묘지에서 "트라이브리게이드" 카드를 임의의 수만큼 제외하고 발동할 수 있다。
PRINTL 제외한 수와 같은 수의 링크 수를 가진 "트라이브리게이드" L 몬스터 １장을 EX 덱에서 특수 소환한다。
PRINTL 이 턴, 자신은 야수족 / 비행야수족 몬스터만 EX 덱에서 특수 소환할 수 있다。

@CARDCAN_61891(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 最大링크
#DIM DYNAMIC 발동불가,2

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,61891)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 발동済_1(듀얼리스트,61891)
		발동불가:0 = 1
	SIF 발동済_2(듀얼리스트,61891)
		발동불가:1 = 1

	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 트라이브리게이드
	효과条件종류 = 마함全般
	효과条件固名前 = 트라이브리게이드 해머
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1

	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		발동불가:1 = 1
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 트라이브리게이드
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	最大링크 = RESULT
	IF 最大링크 != 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件カテゴリ = 트라이브리게이드
		효과条件종류 = 링크
		CALL 효과条件レベル_ADV(最大링크, "以下")
		효과条件소환可 = 1
		효과条件特不無視 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:1 = 1
	ELSE
		발동불가:1 = 1
	ENDIF

	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_61891(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 最大링크
#DIM DYNAMIC 選択링크値
#DIM DYNAMIC 발동불가,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,61891)
		발동불가:0 = 1
	SIF 발동済_2(듀얼리스트,61891)
		발동불가:1 = 1

	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 트라이브리게이드
	효과条件종류 = 마함全般
	효과条件固名前 = 트라이브리게이드 해머
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1

	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		발동불가:1 = 1
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 트라이브리게이드
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	最大링크 = RESULT
	IF 最大링크 != 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件カテゴリ = 트라이브리게이드
		효과条件종류 = 링크
		CALL 효과条件レベル_ADV(最大링크, "以下")
		효과条件소환可 = 1
		효과条件特不無視 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:1 = 1
	ELSE
		발동불가:1 = 1
	ENDIF

	IF 발동불가:0 != 1 && 발동불가:1 != 1
		CALL YN_CHOICE(듀얼리스트,"●덱에서 「트라이브리게이드」마법 / 함정을 패에 넣는다。","●「트라이브리게이드」를 제외하고 Ｌ몬스터를 특수 소환한다。")
	ELSEIF 발동불가:0 != 1
		RESULT = 0
	ELSEIF 발동불가:1 != 1
		RESULT = 1
	ENDIF

	IF RESULT == 0
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,61891,1)
		IF RESULT == 0
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 트라이브리게이드
			효과条件종류 = 마함全般
			효과条件固名前 = 트라이브리게이드 해머
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF

	ELSEIF RESULT == 1
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,61891,2)
		IF RESULT == 0
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
			CALL FULLRESET
			효과条件カテゴリ = 트라이브리게이드
			효과条件종류 = 링크
			CALL 효과条件レベル_ADV(最大링크, "以下")
			효과条件소환可 = 1
			효과条件特不無視 = 1
			CALL CARD_CHOOSE_BASIC(듀얼리스트, "EX덱",ゾーン,場所)	
			選択カード = RESULT
			IF 選択カード != 9999
				CALLFORM CARD_{RESULT:99}("レベル")
				選択링크値 = RESULT
				CALL FULLRESET
				효과条件カテゴリ = 트라이브리게이드
				효과条件複数 = 選択링크値
				CALL CARD_ADD_GY_BASIC(듀얼리스트,"묘지",ゾーン,場所)
				IF RESULT == 1
					CALL FULLRESET
					CALL CARD_SP_SUMMON(듀얼리스트,"EX덱",選択カード)
				ENDIF	
			ENDIF
			EX소환可能종족:0 = 야수족
			EX소환可能종족:1 = 비행야수족
			CALL CARD_EX_RESTRICTION(듀얼리스트)
		ENDIF
	ENDIF
ENDIF



