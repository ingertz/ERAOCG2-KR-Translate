@CARDNAME_61891,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 트라이브리게이드 해머
	CASE "略称"
		RESULTS = 철수의 격철
	CASE "カテゴリ"
		RESULTS:0 = 트라이브리게이드
ENDSELECT


@CARD_61891(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
	CASE "추가日"
		RETURN 251218
ENDSELECT

RETURN 0

@CARD_EXPLANATION_61891(종류)
#DIM DYNAMIC 종류
;묘지に送ったこのカードも素材にできるな・・・まあいいや
PRINTL 以下の효과から１つを選択して발동できる（このカード名の以下の효과はそれぞれ１ターンに１度しか選択できない）。
CALLFORM CARD_ABLE(1,마함起動 ,손패起動,フリー誘発)
PRINTL ●덱から「트라이브리게이드の撃鉄」以外の「트라이브리게이드」마법・함정カード１枚を손패に加える。
CALLFORM CARD_ABLE(2,마함起動 ,손패起動,フリー誘発)
PRINTL ●자신の묘지から「트라이브리게이드」カードを任意の数だけ제외して발동できる。
PRINTL 제외した数と同じ数の링크数を持つ「트라이브리게이드」Ｌモンスター１体をＥＸ덱から특수소환する。
PRINTL このターン、자신は야수족・비행야수족モンスターしかＥＸ덱から특수소환できない。

@CARDCAN_61891(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 最大링크
#DIM DYNAMIC 발동불가,2

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,61891)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 발동済_1(듀얼리스트,61891)
		발동불가:0 = 1
	SIF 발동済_2(듀얼리스트,61891)
		발동불가:1 = 1

	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 트라이브리게이드
	효과条件종류 = 마함全般
	효과条件固名前 = 트라이브리게이드 해머
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1

	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		발동불가:1 = 1
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 트라이브리게이드
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	最大링크 = RESULT
	IF 最大링크 != 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件カテゴリ = 트라이브리게이드
		효과条件종류 = 링크
		CALL 효과条件レベル_ADV(最大링크, "以下")
		효과条件소환可 = 1
		효과条件特不無視 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:1 = 1
	ELSE
		발동불가:1 = 1
	ENDIF

	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_61891(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 最大링크
#DIM DYNAMIC 選択링크値
#DIM DYNAMIC 발동불가,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,61891)
		발동불가:0 = 1
	SIF 발동済_2(듀얼리스트,61891)
		발동불가:1 = 1

	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 트라이브리게이드
	효과条件종류 = 마함全般
	효과条件固名前 = 트라이브리게이드 해머
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1

	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		발동불가:1 = 1
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 트라이브리게이드
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	最大링크 = RESULT
	IF 最大링크 != 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件カテゴリ = 트라이브리게이드
		효과条件종류 = 링크
		CALL 효과条件レベル_ADV(最大링크, "以下")
		효과条件소환可 = 1
		효과条件特不無視 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:1 = 1
	ELSE
		발동불가:1 = 1
	ENDIF

	IF 발동불가:0 != 1 && 발동불가:1 != 1
		CALL YN_CHOICE(듀얼리스트,"●덱から「트라이브리게이드」마법・함정を손패に加える。","●「트라이브리게이드」を제외してＬモンスターを특수소환する。")
	ELSEIF 발동불가:0 != 1
		RESULT = 0
	ELSEIF 발동불가:1 != 1
		RESULT = 1
	ENDIF

	IF RESULT == 0
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,61891,1)
		IF RESULT == 0
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 트라이브리게이드
			효과条件종류 = 마함全般
			효과条件固名前 = 트라이브리게이드 해머
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF

	ELSEIF RESULT == 1
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,61891,2)
		IF RESULT == 0
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
			CALL FULLRESET
			효과条件カテゴリ = 트라이브리게이드
			효과条件종류 = 링크
			CALL 효과条件レベル_ADV(最大링크, "以下")
			효과条件소환可 = 1
			효과条件特不無視 = 1
			CALL CARD_CHOOSE_BASIC(듀얼리스트, "EX덱",ゾーン,場所)	
			選択カード = RESULT
			IF 選択カード != 9999
				CALLFORM CARD_{RESULT:99}("レベル")
				選択링크値 = RESULT
				CALL FULLRESET
				효과条件カテゴリ = 트라이브리게이드
				효과条件複数 = 選択링크値
				CALL CARD_ADD_GY_BASIC(듀얼리스트,"묘지",ゾーン,場所)
				IF RESULT == 1
					CALL FULLRESET
					CALL CARD_SP_SUMMON(듀얼리스트,"EX덱",選択カード)
				ENDIF	
			ENDIF
			EX소환可能종족:0 = 야수족
			EX소환可能종족:1 = 비행야수족
			CALL CARD_EX_RESTRICTION(듀얼리스트)
		ENDIF
	ENDIF
ENDIF



