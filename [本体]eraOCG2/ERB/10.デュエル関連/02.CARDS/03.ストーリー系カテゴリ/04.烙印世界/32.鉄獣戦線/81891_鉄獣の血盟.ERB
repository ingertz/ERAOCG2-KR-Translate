@CARDNAME_81891,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 트라이브리게이드 오스
	CASE "略称"
		RESULTS = 철수의 혈맹
	CASE "カテゴリ"
		RESULTS:0 = 트라이브리게이드
ENDSELECT


@CARD_81891(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 251218
ENDSELECT

RETURN 0

@CARD_EXPLANATION_81891(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과は１ターンに１度、いずれか１つしか使用できない。
CALLFORM CARD_ABLE(1,마함起動,フリー誘発)
PRINTL ①：자신フィールドのＬモンスター１体を대상として발동できる。
PRINTL そのモンスターとは종족が異なる야수족・비행야수족モンスター１体を자신の손패・묘지から특수소환する。
CALLFORM CARD_ABLE(1,묘지起動,フリー誘発,발동誘発)
PRINTL ②：자신フィールドに야수족・비행야수족モンスターがそれぞれ１体以上、合計３体以上存在する場合、
PRINTL 묘지のこのカードを제외し、以下の효과から１つを選択して발동できる。
PRINTL ●상대の손패・フィールドで발동した마법・함정カードの효과を無効にする。
PRINTL ●상대の마법＆함정ゾーンのカード１枚の효과をターン終了時まで無効にする。


@CARDCAN_81891(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 발동불가,2
#DIM DYNAMIC カウンタ
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,81891)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")
	SIF 발동済_1(듀얼리스트,81891)
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = 링크
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲묘지 = 1
	효과条件종족:0 = 야수족
	효과条件종족:1 = 비행야수족
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 묘지起動 || (종류 == フリー誘発 && ゾーン == "묘지") || 종류 == 발동誘発
	SIF ゾーン != "묘지"
		RETURN 0
	SIF 발동済_1(듀얼리스트,81891)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종족 = 야수족
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종족 = 비행야수족
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종족:0 = 야수족
	효과条件종족:1 = 비행야수족
	효과条件표시 = 表側표시
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 3
		RETURN 0
	
	IF 종류 == 발동誘発
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과条件종류 = 마함全般
		CALL CARD_CHECK_START_DATA(듀얼리스트,1)
		SIF RESULT != 1
			발동불가:0 = 1
	ENDIF

	CALL FULLRESET
	효과範囲상대마함 = 1
	효과条件표시 = 表側표시
	효과条件除去種 = 無効
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:1 = 1
	
	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_81891(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード종족
#DIM DYNAMIC 条件달성

IF 종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,81891,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과条件종류 = 링크
		효과条件표시 = 表側표시
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT != 9999
			選択カード종족 = GETVAR(@"%듀얼리스트%_MZ_種:RESULT")
			CALL FULLRESET
			효과範囲손패 = 1
			효과範囲묘지 = 1
			IF 選択カード종족 == 야수족
				효과条件종족 = 비행야수족
			ELSEIF 選択カード종족 == 비행야수족
				효과条件종족 = 야수족
			ELSE
				효과条件종족:0 = 야수족
				효과条件종족:1 = 비행야수족
			ENDIF
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF

ELSEIF 종류 == 묘지起動 || (종류 == フリー誘発 && ゾーン == "묘지") || 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,81891,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		IF 종류 == 발동誘発
			CALL FULLRESET
			효과範囲상대마함 = 1
			효과条件표시 = 表側표시
			효과条件除去種 = 無効
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				条件달성 = 1
		ENDIF

		IF 条件달성 == 1
			CALL YN_CHOICE(듀얼리스트,"●발동を無効にする。","●마법＆함정ゾーンのカードの효과を無効にする。")
		ELSEIF 종류 == 발동誘発
			RESULT = 0
		ELSEIF 종류 == 묘지起動 || 종류 == フリー誘発
			RESULT = 1
		ENDIF

		IF RESULT == 0
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")
			RETURN 1
		ELSEIF RESULT == 1
			CALL FULLRESET
			효과範囲상대마함 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"無効")
		ENDIF
	ENDIF
ENDIF
