@CARDNAME_99998,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 소생하는 환신야수
	CASE "略称"
		RESULTS = 소생하는환신야수
	CASE "カテゴリ"
		RESULTS:0 = 삼환신
ENDSELECT


@CARD_99998(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "レア度"
		RETURN ULR
ENDSELECT

RETURN 0

@CARD_EXPLANATION_99998(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없고、그 발동에 대해 상대는 효과를 발동할 수 없다。
CALLFORM CARD_ABLE(1,마함起動)
PRINTL ①：자신의 묘지에서 레벨１０ / 환신야수족 / 신속성 몬스터 １장을 특수 소환한다。
PRINTL 그 후、서로는 각각 패가 ６장이 되도록 덱에서 드로우하고、
PRINTL 자신의 LP가 4000보다 낮은 경우、자신의 LP를 4000로 한다。
PRINTL 이 효과의 발동 후、자신은 턴 종료시까지 몬스터를 특수 소환할 수 없다。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②：자신의 묘지에 레벨１０ / 환신야수족 / 신속성 몬스터가 존재하는 경우、
PRINTL 묘지의 이 카드를 제외하고 발동할 수 있다。
PRINTL 자신의 덱 / 묘지에서 "죽은 자의 소생" １장을 패에 넣는다。


@CARDCAN_99998(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,99998)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")
	SIF ゾーン != "마함"
		RETURN 0
	SIF 발동済_1(듀얼리스트,99998)
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件レベル = 10
	효과条件종족 = 환신야수족
	효과条件속성 = 신속성
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動 || (종류 == フリー誘発 && ゾーン == "묘지")
	SIF ゾーン != "묘지"
		RETURN 0
	SIF 발동済_2(듀얼리스트,99998)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件レベル = 10
	효과条件종족 = 환신야수족
	효과条件속성 = 신속성
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲덱 = 1
	효과条件名前 = 죽은 자의 소생
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == チェーン可否
	SIF !GROUPMATCH(チェーン可否종류, 마함起動, 묘지起動, フリー誘発)
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_99998(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99998,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件レベル = 10
		효과条件종족 = 환신야수족
		효과条件속성 = 신속성
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			IF 손패数(듀얼리스트) < 6
				カウンタ = 6 - 손패数(듀얼리스트)
				CALL CARDDRAW_BASIC(듀얼리스트,カウンタ)
			ENDIF
			VARSET カウンタ
			IF 손패数(対面者) < 6
				カウンタ = 6 - 손패数(対面者)
				CALL CARDDRAW_BASIC(対面者,カウンタ)
			ENDIF
			IF GETVAR(@"ライフ_%듀얼리스트%") < 4000
				CALL LIFE_CHANGE(듀얼리스트,"","변경",4000)
			ENDIF
		ENDIF
		CALL CARD_SS_RESTRICTION(듀얼리스트)
		CALL CARD_EX_RESTRICTION(듀얼리스트)
	ENDIF
ELSEIF 종류 == 묘지起動 || (종류 == フリー誘発 && ゾーン == "묘지")
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99998,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲덱 = 1
		효과条件名前 = 죽은 자의 소생
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF
