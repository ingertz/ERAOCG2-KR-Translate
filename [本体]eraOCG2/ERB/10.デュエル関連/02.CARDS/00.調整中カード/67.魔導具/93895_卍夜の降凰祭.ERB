@CARDNAME_93895,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 卍나이트 카니발
	CASE "略称"
		RESULTS = 卍밤의 봉황제
	CASE "カテゴリ"
		RESULTS:0 = 돌스자크
		RESULTS:4 = DUEL MASTERS
ENDSELECT


@CARD_93895(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 251022
ENDSELECT

RETURN 0

@CARD_EXPLANATION_93895(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 카드는 １턴에 １번、어느쪽인가 １개밖에 사용할 수 없다。
PRINTL 자신의 패 / 묘지에 "돌스자크" 몬스터가 존재하는 경우、이 카드는 패에서 발동할 수 있다。
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①：패 / 덱 / 묘지에서 "돌스자크" 몬스터 １장을 특수 소환한다。
PRINTL (이 카드를 패에서 발동한 경우、덱에서는 특수 소환할 수 없다。)
PRINTL 그 후、자신의 덱 위에서 카드를 ４장 제외한다。
CALLFORM CARD_ABLE(2,ターン終了時)
PRINTL ②：서로의 엔드 페이즈에 발동할 수 있다。
PRINTL 묘지의 이 카드와、자신의 필드 / 묘지의 "마도구" 카드 합계 ４장을 덱으로 되돌리고、
PRINTL 패 / 덱 / 묘지에서 "돌스자크" 몬스터 １장을 특수 소환한다。



@CARDCAN_93895(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성
#DIM DYNAMIC カウンタ

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,93895)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,93895)
		RETURN 0
	SIF 발동済_2(듀얼리스트,93895)
		RETURN 0
	IF ゾーン == "손패"
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲묘지 = 1
		효과条件종류 = モン全般
		효과条件カテゴリ = 돌스자크
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ELSEIF ゾーン == "마함"
		CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲묘지 = 1
		효과範囲덱 = 1
		효과条件종류 = モン全般
		효과条件カテゴリ = 돌스자크
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ELSE
		RETURN 0
	ENDIF
	RETURN 1
ELSEIF 종류 == ターン終了時
	SIF 발동済_1(듀얼리스트,93895)
		RETURN 0
	SIF 발동済_2(듀얼리스트,93895)
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 마도구
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 4
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件종류 = モン全般
	효과条件カテゴリ = 돌스자크
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_93895(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 選択カード名前

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,93895,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		SIF 종류 == 마함起動
			효과範囲덱 = 1
		효과範囲묘지 = 1
		효과範囲손패 = 1
		효과条件カテゴリ = 돌스자크
		효과条件종류 = モン全般
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL CARD_DECK_DISPOSE(듀얼리스트,"덱",4,제외行き)
		ENDIF
	ENDIF
ELSEIF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,93895,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,덱行き)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲필드 = 1
		효과条件カテゴリ = 마도구
		효과条件複数 = 4
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ = 돌스자크
			효과条件종류 = モン全般
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF

