@CARDNAME_73990,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 卍 그랜드 제로 卍
	CASE "略称"
		RESULTS = 신세괴
	CASE "カテゴリ"
		RESULTS:0 = 없음
	CASE "出典作品"
		RESULTS:0 = DUEL MASTERS
ENDSELECT


@CARD_73990(参照先)
;名前専用
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN フィールド
ENDSELECT

RETURN 0

@CARD_EXPLANATION_73990(종류)
#DIM DYNAMIC 종류

PRINTL 자신 필드는 "卍 그랜드 제로 卍"가 된다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：자신의 "마도구" 카드의 효과에 대해 상대는 카드의 효과를 발동할 수 없다。
CALL CARD_ABLE(0,효과後強制誘発)
PRINTL ②："마도구" 마법 카드의 효과가 발동한 경우에 발동할 수 있다。
PRINTL 자신은 덱에서 １장 드로우한다。그 후、이 카드에 무월 카운터를 １개 놓는다。
CALLFORM CARD_ABLE(11,ターン終了時)
PRINTL ③：이 카드가 필드에 앞면 표시로 존재하는 한 1번만、
PRINTL 이 카드의 무월 카운터가 ４개 이상인 경우、자신 엔드 페이즈에 발동할 수 있다。
PRINTL 자신의 패 / 묘지의 일반 마법 카드 １장을 제외하고、이 효과는、그 일반 마법 카드 발동시의 효과와 같아진다。

@CARDCAN_73990(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 효과使用불가,3

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,73990)
SIF RESULT == 1
	RETURN 0

IF 종류 == ターン終了時
	SIF 발동済_D1(듀얼리스트,73990)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_個Ｃ:場所") < 4
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲묘지 = 1
	효과条件종류 = 通常마법
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後強制誘発
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2
		RETURN 0
	CALL FULLRESET
	효과条件カテゴリ = 마도구
	효과条件종류 = 마법全般
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"효과발동")
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF




@CARDEFFECT_73990(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 효과先


IF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73990,11)
	IF RESULT == 0
		PRINTL
		SETCOLOR C_BLUE
		PRINTW 『열려라、무월의 문99！！』
		RESETCOLOR
			CALL FULLRESET
			효과範囲손패 = 1
			효과範囲묘지 = 1
			효과条件종류 = 通常마법
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 0
			選択カード_ID = RESULT:1
			TRYCALLFORM CARDEFFECT_{選択カード_ID}(듀얼리스트,마함起動,"효과処理")
		ENDIF
	ENDIF
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73990)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF
ELSEIF 종류 == 지속효과
	CALL SET_FIELD_MAGIC_INFO(듀얼리스트, "卍 그랜드 제로 卍")
	CALL SET_CAT_SOGAI_INFO(듀얼리스트,"마도구")
ELSEIF 효과後強制誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73990)
	IF RESULT == 0
	CALL FULLRESET
		CALL CARDDRAW_BASIC(듀얼리스트,1)
		CALL SET_FIELD_INFO(듀얼리스트,"마함",場所,"個Ｃ",1)
	ENDIF
ENDIF
