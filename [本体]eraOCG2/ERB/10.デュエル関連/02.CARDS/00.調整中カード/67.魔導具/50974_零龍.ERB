PRINTL ②：이 카드는 상대의 효과의 대상이 되지 않으며、효과로는 파괴되지 않는다。


@CARDCAN_250974(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,250974)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과
	SIF ゾーン != "마함"
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン終了時
	SIF ゾーン != "마함"
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件名前 = 멸망의 기원 제로무
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 손패数(듀얼리스트) != 0 && 손패数(対面者) != 0
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_250974(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 카운터数
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"魔自身",場所,"対耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"魔自身",場所,"破耐")
ELSEIF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,250974)
	IF RESULT == 0
		CALL FULLRESET
		효과条件名前 = 멸망의 기원 제로무
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"마함",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			IF GETVAR(@"%듀얼리스트%_魔_個Ｃ:選択カード") == 3 && モンスター数(듀얼리스트) >= 5
				PRINTL 《제론 성운 패의 의식》는《멸망의 기원 제로무》와 링크하려 했지만
				PRINTW 몬스터 존에 빈칸이 없어 실패했다
			ELSE
				PRINTW 《제론 성운 패의 의식》는《멸망의 기원 제로무》와 링크했다
				CALL FULLRESET
				CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,소멸行き)
				CALL SET_FIELD_INFO(듀얼리스트,"마함",選択カード,"個Ｃ",1)
				TRYCALLFORM CARD_UI(GETVAR(@"%듀얼리스트%_덱:0"))
				CALL FULLRESET
				효과条件속성 = 어둠속성
				효과条件任意 = 1
				효과条件山切り無し = 1
				CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所,1)
			ENDIF
			IF GETVAR(@"%듀얼리스트%_魔_個Ｃ:選択カード") == 4
				SETCOLOR C_RED
				PRINTL
				PRINTL 모든 제론 성운이《멸망의 기원 제로무》에게 링크했다
				PRINTW 제 론 卍 탄 ！
				RESETCOLOR
				CALL CARD_RECONSTRUCT(듀얼리스트,ゾーン,選択カード,150974)
				CALL RESETCONDITION
				CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,選択カード)
				CALL CARD_RESERV(듀얼리스트,50974,永紋章予約)
			ENDIF
		ENDIF
	ENDIF
ENDIF

