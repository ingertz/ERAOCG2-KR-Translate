@CARDNAME_50974,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 멸망의 기원 제로무
	CASE "略称"
		RESULTS = 멸망의 기원 제로무
	CASE "カテゴリ"
		RESULTS:0 = 제론
		RESULTS:4 = DUEL MASTERS
ENDSELECT


@CARD_50974(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 초차원
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 0
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	CASE "특수불가"
		RETURN 1
	CASE "単一存在"
		RETURN 1
	CASE "生成カード"
		RESULT:4 = 550974
		RESULT:3 = 450974
		RESULT:2 = 350974
		RESULT:1 = 250974
		RETURN 150974
	CASE "制限"
		RETURN 制限
	CASE "実装日"
		RETURN 251024
ENDSELECT
RETURN 0

@CARD_EXPLANATION_50974(종류)
#DIM DYNAMIC 종류

PRINTL 《멸망의 기원 제로무》 는 자신 필드에 １장밖에 존재할 수 없으며、이 카드의 효과의 발동에 대해 상대는 효과를 발동할 수 없다。
CALLFORM CARD_ABLE(0,ターン開始時強制)
PRINTL ①：게임 개시시에 발동한다。
PRINTL EX덱의 이 카드와、다른 ４종류의 제론 성운 카드를 자신의 마법＆함정 존에 놓고、상대는 １장 더 카드를 뽑는다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：이 카드는 상대의 효과의 대상이 되지 않으며、효과로는 파괴되지 않는다。
PRINTL ③：『제론卍탄』
PRINTL 자신의 ４장째의 제론 성운 카드를 이 카드와 링크했을 때 발동한다。
PRINTL 이 카드를 뒤집고、《제론》 으로서 특수 소환한다。

@CARDSUMMON_50974(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

RETURN 0

@CARDCAN_50974(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50974)
SIF RESULT == 1
	RETURN 0

IF 종류 == ターン開始時強制
	SIF ゾーン != "EX덱"
		RETURN 0
	SIF ターン数 > 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "마함"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 永紋章起動
	RETURN 1
ELSEIF 종류 == チェーン可否
	RETURN 1
ENDIF


@CARDEFFECT_50974(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 카운터数
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == ターン開始時強制
	CALL FULLRESET
	CALL CARD_ADD(듀얼리스트,"EX덱", "마함", 場所,"表側표시")
	CALL CARD_GENERATE_MAGIC(듀얼리스트,250974,1)
	CALL CARD_GENERATE_MAGIC(듀얼리스트,350974,1)
	CALL CARD_GENERATE_MAGIC(듀얼리스트,450974,1)
	CALL CARD_GENERATE_MAGIC(듀얼리스트,550974,1)
	CALL CARDDRAW_BASIC(対面者,1,1)
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"魔自身",場所,"対耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"魔自身",場所,"破耐")
ELSEIF 종류 == 永紋章起動
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과範囲EX덱 = 1
	효과範囲제외 = 1
	효과範囲묘지 = 1
	효과条件名前 = 멸망의 기원 제로무
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 1
		CALL LIFE_CHANGE(듀얼리스트,"","변경",0)
	ENDIF
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件名前 = 제론
	효과条件攻撃力 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 1
		CALL FULLRESET
		효과条件名前 = 제론
		CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"無効",-1)
	ENDIF
ENDIF

