@CARDNAME_28714,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 다마 두포이즈
	CASE "略称"
		RESULTS = 다마 두포이즈
	CASE "カテゴリ"
		RESULTS:0 = 마도구
		RESULTS:4 = DUEL MASTERS
ENDSELECT


@CARD_28714(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 2400
	CASE "守備力"
		RETURN 1500
	CASE "추가日"
		RETURN 251022
ENDSELECT

RETURN 0

@CARD_EXPLANATION_28714(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ②의 효과는 1턴에 1번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時強制,특수소환時強制)
PRINTL ①：이 카드가 소환 / 특수 소환에 성공한 경우에 발동한다。
PRINTL 자신 필드의 몬스터 ２장과、상대 필드의 카드 １장을 파괴한다。
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：자신 필드에 "돌스자크" 몬스터가 존재하고、상대가 몬스터를 특수 소환한 경우에 발동할 수 있다。
PRINTL 이 카드를 묘지에서 특수 소환한다。

@CARDCAN_28714(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,28714)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時強制 || 종류 == 특수소환時強制
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트,28714)
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,28714,"묘지")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환",1)
	SIF RESULT != 1
		RETURN 0
    CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 돌스자크
    CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
    SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_28714(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 攻撃力修正

IF 종류 == 소환時強制 || 종류 == 특수소환時強制
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28714)
	IF RESULT == 0
		REPEAT 2
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件종류 = モン全般
			효과条件行先플래그 = 破壊行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		REND
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
	ENDIF
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28714,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 다마 두포이즈
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF

