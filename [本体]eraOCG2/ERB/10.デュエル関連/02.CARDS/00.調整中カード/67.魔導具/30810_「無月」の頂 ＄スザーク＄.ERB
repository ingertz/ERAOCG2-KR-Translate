@CARDNAME_30810,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS
SELECTCASE 参照先
	CASE "名前"
		RESULTS = "무월"의 정점 ＄스자크＄
	CASE "略称"
		RESULTS = 제니스스자크
	CASE "カテゴリ"
		RESULTS:0 = 제니스
		RESULTS:1 = 돌스자크
		RESULTS:4 = DUEL MASTERS
	CASE "検索カテゴリ"
		RESULTS:0 = 마도구
ENDSELECT


@CARD_30810(参照先)
;名前専用
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 3550
	CASE "守備力"
		RETURN 3550
	CASE "소환불가"
		RETURN 1
ENDSELECT

RETURN 0

@CARD_EXPLANATION_30810(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드는 일반 소환할 수 없으며、카드의 효과로밖에 특수 소환할 수 없다。
PRINTL 이 카드명의 ①③④의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,ターン終了時)
PRINTL ①：서로의 엔드 페이즈에 발동할 수 있다。
PRINTL 자신의 필드 / 묘지에 "마도구" 카드를 합계 ６장 제외하고、이 카드를 패 / 묘지에서 특수 소환한다。
CALLFORM CARD_ABLE(2,특수소환時,攻撃時誘発)
PRINTL ②：이 카드가 특수 소환된 경우에 발동한다、또는 이 카드의 공격선언시에 발동할 수 있다。
PRINTL 상대 필드의 몬스터 １장을 파괴할 수 있다。그 후、상대는 패를 무작위로 １장 묘지로 보낸다。
CALLFORM CARD_ABLE(3,효과後誘発)
PRINTL ③：상대의 패가 효과로 묘지로 보내졌을 경우에 발동할 수 있다。
PRINTL 자신은 덱에서 １장 드로우한다。
CALLFORM CARD_ABLE(0,필드→묘지)
PRINTL ④：이 카드가 필드에서 벗어난 경우에 발동할 수 있다。
PRINTL 자신의 제외상태인 카드를 무작위로 ６장 묘지로 되돌린다。


@CARDCAN_30810(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,30810)
SIF RESULT == 1
	RETURN 0

IF 종류 == ターン終了時
	SIF 발동済_1(듀얼리스트,30810)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,30810,ゾーン)
	SIF RESULT == 1
		RETURN 0
	SIF ゾーン != "손패" && ゾーン != "묘지"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 마도구
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 6
		RETURN 0
	RETURN 1
ELSEIF 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,30810)
		RETURN 0
	SIF モンスター数(対面者) < 1 && 손패数(対面者) < 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時誘発
	SIF 발동済_2(듀얼리스트,30810)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF モンスター数(対面者) < 1 && 손패数(対面者) < 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_3(듀얼리스트,30810)
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"손패墓送",1)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ELSEIF 종류 == 戦破壊→묘지
	CALL FULLRESET
	효과範囲제외 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_30810(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード_ID
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30810,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 魔導具
		효과条件複数 = 6
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트, ゾーン, 場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30810,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件任意 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"손패破壊",場所,"묘지")
	ENDIF
ELSEIF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30810,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件任意 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"손패破壊",場所,"묘지")
	ENDIF
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30810,3)
	IF RESULT == 0
		CALL CARDDRAW_BASIC(듀얼리스트,1)
	ENDIF
ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30810)
	IF RESULT == 0
		REPEAT 6
			CALL CARD_DECK_DISPOSE(듀얼리스트,"제외",1)
		REND
	ENDIF
ENDIF