@CARDNAME_26181,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS
SELECTCASE 参照先
	CASE "名前"
		RESULTS = 卍월 가 류자크 卍
	CASE "略称"
		RESULTS = 가 류자크
	CASE "カテゴリ"
		RESULTS:0 = 돌스자크
		RESULTS:4 = DUEL MASTERS
	CASE "検索カテゴリ"
		RESULTS:0 = 魔導具
ENDSELECT


@CARD_26181(参照先)
;名前専用
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 비행야수족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 3000
	CASE "守備力"
		RETURN 3000
	CASE "추가日"
		RETURN 251022
ENDSELECT

RETURN 0

@CARD_EXPLANATION_26181(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：서로의 묘지에 있는 카드의 합계가 １３장 이상이라면 발동할 수 있다。
PRINTL 이 카드를 패에서 버리고、상대 필드의 카드를 전부 파괴한다。
CALLFORM CARD_ABLE(2,ターン終了時)
PRINTL ②：서로의 엔드 페이즈에 발동할 수 있다。
PRINTL 자신의 필드 / 묘지의 "마도구" 카드를 합계 ６장 제외하고、이 카드를 패 / 묘지에서 특수 소환한다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：이 카드가 필드에 앞면 표시로 존재하는 한、
PRINTL 상대의 몬스터 존을 ２곳까지 가능한 한 사용 불가능하게 한다。
CALLFORM CARD_ABLE(0,필드→묘지)
PRINTL ④：이 카드가 필드에서 벗어난 경우에 발동할 수 있다。
PRINTL 자신의 제외 상태인 카드를 무작위로 ６장 묘지로 되돌린다。


@CARDCAN_26181(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,26181)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,26181)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲상대묘지 = 1
	효과範囲묘지 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 13
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン終了時
	SIF 발동済_2(듀얼리스트,26181)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,26181,ゾーン)
	SIF RESULT == 1
		RETURN 0
	SIF ゾーン != "손패" && ゾーン != "묘지"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 마도구
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 6
		RETURN 0
	RETURN 1
ELSEIF 종류 ==  특수소환時強制
	SIF モンスター数(対面者) >= 5
		RETURN 0
	RETURN 1
ELSEIF 종류 == 戦破壊→묘지
	CALL FULLRESET
	효과範囲제외 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_26181(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード_ID
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,26181,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"全場全体",場所,"묘지")
	ENDIF
ELSEIF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,26181)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 마도구
		효과条件複数 = 6
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트,ゾーン, 場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 특수소환時強制
	REPEAT 2
		CALL FULLRESET
		CALL RESRICT_FIELD(듀얼리스트,ゾーン,場所)
		SIF モンスター数(対面者) >= 5
			RETURN 0
	REND
ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,26181)
	IF RESULT == 0
		REPEAT 6
			CALL CARD_DECK_DISPOSE(듀얼리스트,"제외",1)
		REND
	ENDIF
ENDIF
