@CARDNAME_31339,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 볼캐닉 엠페러
	CASE "略称"
		RESULTS = V 엠페러
	CASE "カテゴリ"
		RESULTS:0 = 볼캐닉
ENDSELECT


@CARD_31339(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 3100
	CASE "守備力"
		RETURN 2400
ENDSELECT
RETURN 0

@CARD_EXPLANATION_31339(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １장밖에 사용할 수 없다。
;SS
CALLFORM CARD_ABLE(1,손패起動,묘지起動)
PRINTL ①：자신 필드 / 묘지에서 화염 속성 / 원소정령족 몬스터 ３장 또는 "브레이즈 캐논" 카드 １장을 제외하고 발동할 수 있다。
PRINTL 이 카드를 패 / 묘지에서 특수 소환한다。
;함정セットバーン
CALLFORM CARD_ABLE(2,특수소환時)
PRINTL ②：이 카드가 ①의 효과로 특수 소환한 경우에 발동할 수 있다。
PRINTL 제외 상태인 화염 속성 / 원소정령족 몬스터의 수×５００ 데미지를 상대에게 준다。
PRINTL 그 후、덱에서 "볼캐닉" 함정 카드 １장을 자신 필드에 세트한다。
;徴税バーン
CALLFORM CARD_ABLE(0,효과後強制誘発)
PRINTL ③：상대가 몬스터를 특수 소환할 때 마다 상대에게 ５００데미지를 준다。



@CARDCAN_31339(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,31339)
SIF RESULT == 1
	RETURN 0
;손패묘지SS
IF 종류 == 손패起動 || 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,31339)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,31339,ゾーン)
	SIF RESULT == 1
		RETURN 0
	SIF モンスター数(듀얼리스트) >= 5
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 브레이즈 캐논
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		条件달성 ++
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件종족 = 원소정령족
	효과条件속성 = 화염속성
	효과条件固名前 = 볼캐닉 엠페러
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT >= 3
		条件달성 ++
	SIF 条件달성 == 0
		RETURN 0
	RETURN 1
;バーンセット
ELSEIF 종류 == 특수소환時
	;①から連動でのみ발동
	RETURN 0
;	SIF 발동済_2(듀얼리스트,31339)
;		RETURN 0
;	CALL FULLRESET
;	효과範囲제외 = 1
;	효과条件종족 = 원소정령족
;	효과条件속성 = 화염속성
;	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
;	SIF RESULT != 1
;		RETURN 0
;	;제외炎族がいれば발동한다。セットする함정はなくても良い
;	RETURN 1
;徴税バーン
ELSEIF 종류 == 효과後強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환",1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_31339(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

;손패묘지SS
IF 종류 == 손패起動 || 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31339,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件종족 = 원소정령족
		효과条件속성 = 화염속성
		효과条件固名前 = 볼캐닉 엠페러
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT >= 3
			CALL FULLRESET
			효과範囲마함 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ = 브레이즈 캐논
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT != 1
				;ブレイズキャノンがないなら炎族３体제외で確定
				RESULT = 0

			ELSE
				;両方あるなら選択肢を出す
				CALL YN_CHOICE(듀얼리스트,"●화염 속성 / 원소정령족 몬스터 ３장을 제외한다。","●「브레이즈 캐논」 카드 １장을 제외한다。")
			ENDIF
		ELSE
		;炎３体いないならブレイズキャノンだけ満たしている
			RESULT = 1

		ENDIF

		IF RESULT == 0

			;炎３体제외
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲묘지 = 1
			효과条件종족 = 원소정령족
			효과条件속성 = 화염속성
			효과条件固名前 = 볼캐닉 엠페러
			효과条件複数 = 3
			효과条件行先플래그 = 제외行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
;				효과範囲묘지 = 1
;				효과範囲손패 = 1
;				효과条件名前 = 볼캐닉 엠페러
				CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)	
			ENDIF
		ELSEIF RESULT == 1

			;ブレイズキャノン제외
			CALL FULLRESET
			효과範囲마함 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ = 브레이즈 캐논
			효과条件行先플래그 = 제외行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
;				효과範囲묘지 = 1
;				효과範囲손패 = 1
;				효과条件名前 = 볼캐닉 엠페러
				CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)	
			ENDIF
		ENDIF
		;ここから②효과が발동
		PRINTL 볼캐닉 엠페러의 ②의 효과를 발동하시겠습니까？
		CALL YN_CHOICE(듀얼리스트)
		IF RESULT == はい
			CALL CARD_EFFECT_USE(듀얼리스트,31339,2)
			CALL FULLRESET
			효과範囲제외 = 1
			효과条件종족 = 원소정령족
			효과条件속성 = 화염속성
			효과条件CNT = 1
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			CALL LIFE_CHANGE(듀얼리스트,"減少","효과",RESULT * 500,1)
			;ここから함정セット
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 볼캐닉
			효과条件종류 = 함정全般
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"裏側표시")
		ENDIF
	ENDIF
;특수소환時バーンセット
;ELSEIF 종류 == 특수소환時
;	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31339,2)
;	IF RESULT == 0
;		CALL FULLRESET
;		효과範囲제외 = 1
;		효과条件종족 = 원소정령족
;		효과条件속성 = 화염속성
;		효과条件CNT = 1
;		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
;		CALL LIFE_CHANGE(듀얼리스트,"減少","효과",RESULT * 500,1)
;		;ここから함정セット
;		CALL FULLRESET
;		효과範囲덱 = 1
;		효과条件カテゴリ = 볼캐닉
;		효과条件종류 = 함정全般
;		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
;		SIF RESULT == 1
;			CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"裏側표시")
;	ENDIF
;徴税バーン
ELSEIF 종류 == 효과後強制誘発
	CALL LIFE_CHANGE(듀얼리스트,"減少","효과",500,1)
ENDIF

