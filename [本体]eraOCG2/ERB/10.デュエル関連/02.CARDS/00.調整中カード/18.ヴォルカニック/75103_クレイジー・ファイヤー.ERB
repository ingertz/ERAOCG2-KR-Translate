@CARDNAME_75103,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 크레이지 파이어
	CASE "略称"
		RESULTS = 크레이지 F
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_75103(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
	CASE "生成カード"
		RETURN 131330
ENDSELECT

RETURN 0

@CARD_EXPLANATION_75103(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか발동できない。
CALLFORM CARD_ABLE(1,마함起動 ,손패起動)
PRINTL ①：자신フィールドの「브레이즈 캐논」カード１枚を破壊し、
PRINTL フィールド上のモンスターを全て破壊する。
PRINTL その後、자신フィールドに「ボムトークン」１体を특수소환する。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②：자신フィールドに「볼캐닉」モンスターが存在する場合、자신メインフェイズに묘지のこのカードを제외して발동できる。
PRINTL 「クレイジー・ファイヤー」以外の묘지・제외状態の「ファイヤー」마법カード１枚を손패に加える。


@CARDCAN_75103(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,75103)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,75103)
		RETURN 0
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件カテゴリ = 브레이즈 캐논
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
;
ELSEIF 종류 == 묘지起動
	SIF 발동済_2(듀얼리스트,75103)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 볼캐닉
	효과条件종류 =  モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件名前:0 = ファイヤー・バック
	효과条件名前:1 = ファイヤー・エジェクション
	효과条件名前:2 = ファイヤー・ソウル
	효과条件名前:3 = ファイヤー・ボール
	효과条件名前:4 = アンプリファイヤー
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_75103(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,75103,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲마함 = 1
		효과条件カテゴリ = 브레이즈 캐논
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"両필드全体",場所,"묘지")
			CALL FULLRESET
			CALL CARD_GENERATE(듀얼리스트,131330)
		ENDIF
	ENDIF
;ファイヤーサルベージ
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,75103,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,제외行き)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲제외 = 1
		효과条件名前:0 = ファイヤー・バック
		효과条件名前:1 = ファイヤー・エジェクション
		효과条件名前:2 = ファイヤー・ソウル
		효과条件名前:3 = ファイヤー・ボール
		효과条件名前:4 = アンプリファイヤー
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF

