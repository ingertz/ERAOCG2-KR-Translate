@CARDNAME_31332,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 볼캐닉 백샷
	CASE "略称"
		RESULTS = V B샷
	CASE "カテゴリ"
		RESULTS:0 = 볼캐닉
ENDSELECT


@CARD_31332(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 500
	CASE "守備力"
		RETURN 0
ENDSELECT
RETURN 0

@CARD_EXPLANATION_31332(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
;バーン＋破壊
CALLFORM CARD_ABLE(0,필드→묘지 ,손패→묘지 ,덱→묘지 ,破壊→묘지 ,戦闘→묘지)
PRINTL ①：이 카드가 묘지로 보내진 경우에 발동한다。
PRINTL 상대에게 ５００데미지를 준다。
PRINTL 추가로 "브레이즈 캐논" 카드의 효과로 인해 묘지로 보내진 경우、이하의 효과를 적용할 수 있다。
PRINTL ●패 / 덱에서 "볼캐닉 백샷" ２장을 묘지로 보낸다。
PRINTL 그 후、상대 필드의 몬스터를 전부 파괴한다。
;回収蘇生
CALLFORM CARD_ABLE(1,묘지起動)
PRINTL ②：이 카드가 묘지에 존재하는 경우、자신 필드의 "브레이즈 캐논" 카드 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 카드를 패로 되돌리고、이 카드를 특수 소환한다。
PRINTL 이 효과로 특수 소환한 이 카드는、필드에서 벗어난 경우에 제외된다。

@CARDCAN_31332(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,31332)
SIF RESULT == 1
	RETURN 0
;バーン＋破壊
IF  종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	;バーン自体は無条件で飛ぶ
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,31332)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF モンスター数(듀얼리스트) >= 5
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件カテゴリ = 브레이즈 캐논
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0	
	CALL CARD_SS_CHECK(듀얼리스트,31332,ゾーン)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_31332(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC ダメージ量
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%



;バーン＋破壊
IF  종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	ダメージ量 = 500
	CALL LIFE_CHANGE(듀얼리스트,"減少","효과",ダメージ量,1)

	;絢嵐参考にブレイズキャノンによって落ちた場合の処理
	TRYCALLFORM CARDNAME_{処理中_효과ID}("カテゴリ")
	IF RESULTS == "브레이즈 캐논"
		;손패덱に백샷が２枚あるか
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲손패 = 1
		효과条件名前 = 볼캐닉 백샷
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)

		IF RESULT == 2
			CALL YN_CHOICE(듀얼리스트,"●패 / 덱에서 「볼캐닉 백샷」２장을 묘지로 보낸다。그 후、상대 필드의 몬스터를 전부 파괴한다。","추가 효과를 적용하지 않는다")
			IF RESULT == 0
				CALL FULLRESET
				효과範囲손패 = 1
				효과範囲덱 = 1
				효과条件名前 = 볼캐닉 백샷
				효과条件複数 = 2
				CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
				IF RESULT == 1
					CALL FULLRESET
					CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드全体",場所,"묘지")
				ENDIF
			ENDIF
		ENDIF
	ENDIF
;回収蘇生
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31332,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲마함 = 1
		효과条件カテゴリ = 브레이즈 캐논
		효과条件行先플래그 = 손패行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과추가종류 = 2
			CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF

