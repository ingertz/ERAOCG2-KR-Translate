@CARDNAME_40076,参照先
;ココで지정卡片の名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 혹란마 플레시아
	CASE "略称"
		RESULTS = 란 플레시아
	CASE "カテゴリ"
		RESULTS:0 = 혹란마
		RESULTS:1 = E.R.A
	CASE "検索カテゴリ"
		RESULTS:0 = 꿀구멍
ENDSELECT


@CARD_40076(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 식물족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 150
	CASE "守備力"
		RETURN 2650
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		RETURN 1371
ENDSELECT

RETURN 0

@CARDSUMMON_40076(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 5
素材条件レベル = 4
素材条件カテゴリ:0 = 충혹마
素材条件カテゴリ:1 = 혹란마
素材条件数自由 = 1

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,40076) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_40076(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL 레벨４인 "충혹마" 몬스터 또는 "혹란마" 몬스터 ×２장 이상
PRINTL 이 카드명의 ③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ①：상대 필드에 벌레문양이 새겨져있는 몬스터는 전부 공격 표시가 된다。
PRINTL 공격력은 각각 이 카드가 가진 벌레문양 종류 수×１００만큼 내린다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：엑시즈 소재를 갖고있는 이 카드는 상대의 효과를 받지 않는다。
PRINTL 이 카드가 몬스터 존에 존재하는 한、배틀 페이즈 이외에선、
PRINTL "혹란마 플레시아" 이외의 자신 필드의 "혹란마" 몬스터는 상대의 효과의 대상이 되지 않으며、효과로는 파괴되지 않는다。
CALLFORM CARD_ABLE(1,필드起動,フリー誘発)
PRINTL ③：상대 턴에、이 카드의 엑시즈 소재 １개를 제거하고 발동할 수 있다。
PRINTL 상대 필드의 모든 몬스터에게 이 카드의 벌레 문양을 새긴다。
PRINTL 이 턴、상대 필드에 벌레 문양이 새겨져 있는 몬스터는 공격 가능한 경우 공격해야만 한다。
CALLFORM CARD_ABLE(2,攻撃時誘発)
SETCOLOR C_PINK
PRINTL ④：이 카드가 공격 대상으로 선택되었을 때、이 카드의 엑시즈 소재 １개를 제거하고 발동할 수 있다。
PRINTL 공격 몬스터의 공격력은 자신 필드의 "혹란마" 몬스터의 공격력의 합계 수치만큼 내려가며、
PRINTL 그 몬스터에게 이 카드의 벌레 문양을 새긴다、이 카드는 수비 표시가 된다。
RESETCOLOR
CALL TEXT_DECORATION("ROGUE")

;이 카드가 ④효과を발동する時、攻撃モンスターが雄性・ふたなりモンスターであり、
;かつ攻撃力がこのカードの守備力とフィールド上の全ての「혹란마」モンスターの攻撃力の合計守備力を超えている場合。
;이 카드는 攻撃力がこのカードの攻撃力の数値分アップする肉鎧として攻撃モンスターに装備し、攻撃力を下げる효과は適用されなくなる。
;그 후、자신フィールド上の「혹란마」モンスターは全て굴복し、攻撃力と守備力は０になる。

@CARDCAN_40076(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 必要的卡
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件达成

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,40076)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_1(듀얼리스트,40076)
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") < 0
		RETURN 0

	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃時誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") < 0
		RETURN 0

	RETURN 1

ELSEIF 종류 == 攻撃時強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") < 0
		RETURN 0
	RETURN 1		

ELSEIF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1

ELSEIF 종류 == 短紋章起動
	RETURN 1
ENDIF


@CARDEFFECT_40076(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 守備力修正,2
#DIM DYNAMIC 怪兽数量
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 自己選択カード
#DIM DYNAMIC 対面選択カード
#DIM DYNAMIC 성별판정
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 蟲紋종류

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,40076,1,X消費1)
	IF RESULT == 0
		FOR カウンタ,0,5
			SIF GETVAR(@"%対面者%_필드:カウンタ") == -1
				CONTINUE
			SIF GETVAR(@"%対面者%_MZ_リ数:カウンタ") >= 10
				CONTINUE
			SIF GETVAR(@"%対面者%_MZ_表:カウンタ") == 3
				CONTINUE

			;与赋予蟲紋相关的效果
			CALL TRAPSEX_GIVE_FIXED(듀얼리스트,ゾーン,종류,場所,カウンタ,10)
		NEXT

		CALL SEXTEXT_40076_1_1

		CALL CARD_RESERV(듀얼리스트,40076,短紋章予約)
	ENDIF

ELSEIF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,40076,2,X消費1)
	IF RESULT == 0
		自己選択カード = 戦闘場所(듀얼리스트)
		守備力修正:0 = GETVAR(@"%듀얼리스트%_MZ_守:自己選択カード")
		対面選択カード = 戦闘場所(듀얼리스트,1)
		攻撃力修正 = GETVAR(@"%対面者%_MZ_攻:対面選択カード")
		성별판정 = GETVAR(@"%対面者%_MZ_性:対面選択カード")

		CALL FULLRESET
		효과範囲필드 = 1
		효과条件표시 = 表側표시
		효과条件カテゴリ = 혹란마
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		怪兽数量 = RESULT
		守備力修正:1 = RESULT:3

		IF 성별판정 == 牝性
			조교대상 = GETVAR(@"%対面者%_필드:対面選択カード")
			CALL SEXTEXT_40076_2_1(듀얼리스트,조교대상,성별판정,対面選択カード,(守備力修正:0 + 守備力修正:1),攻撃力修正,怪兽数量)

			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"自動処理",対面選択カード,"永攻DOWN",守備力修正:1)
			
		ELSEIF (성별판정 == 雄性 || 성별판정 == ふたなり) && 攻撃力修正 - (守備力修正:0 + 守備力修正:1) >= 1
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"Ｘ",-1)
			조교대상 = GETVAR(@"%対面者%_필드:対面選択カード")
			CALL SEXTEXT_40076_2_1(듀얼리스트,조교대상,성별판정,対面選択カード,(守備力修正:0 + 守備力修正:1),攻撃力修正,怪兽数量)

			SIF 마함数(対面者) < 5
				CALL CARD_EQUIP_MONSTER(対面者,対面選択カード,"상대필드",自己選択カード,1)

			CALL FULLRESET
			효과条件표시 = 表側표시
			효과条件カテゴリ = 혹란마
			CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"永攻",-999999)
			CALL FULLRESET
			효과条件표시 = 表側표시
			효과条件カテゴリ = 혹란마
			CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"永守",-999999)

		ELSEIF 성별판정 == 雄性 || 성별판정 == ふたなり
			조교대상 = GETVAR(@"%対面者%_필드:対面選択カード")
			CALL SEXTEXT_40076_2_1(듀얼리스트,조교대상,성별판정,対面選択カード,(守備力修正:0 + 守備力修正:1),攻撃力修正,怪兽数量)

			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"自動処理",対面選択カード,"永攻DOWN",守備力修正:1)
		ELSE
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"自動処理",対面選択カード,"永攻DOWN",守備力修正:1)
		ENDIF
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"表",2,1)
		;与赋予蟲紋相关的效果
		CALL TRAPSEX_GIVE_FIXED(듀얼리스트,ゾーン,종류,場所,対面選択カード,10)
	ENDIF

ELSEIF 종류 == 攻撃時強制誘発
	IF 戦闘場所(듀얼리스트,1) != 5
		CALL CARD_EROTICS(戦闘カードID(듀얼리스트,1))
		SIF RESULT != 0
			조교대상 = RESULT
	ENDIF

	CALL FULLRESET
	효과範囲필드 = 1
	효과条件표시 = 表側표시
	효과条件カテゴリ = 혹란마
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	怪兽数量 = RESULT

	IF 조교대상 > 0 && 怪兽数量 >= 2
		PRINTFORML
		SETCOLOR C_PINK 
		PRINTFORMW %CALLNAME:조교대상%은 가장 먼저 플레시아를 처리하려고 했지만, 어둠 속에 숨어있는 혹란마들에게 눈치채지 못했다.
		RESETCOLOR
	ELSEIF 조교대상 > 0 && 怪兽数量 == 1
		PRINTFORML
		SETCOLOR C_PINK 
		PRINTFORMW %CALLNAME:조교대상%의 두뇌는, 강렬한 냄새의 충격으로 인해, 이미 완전히 혼란에 빠져 있었다.
		RESETCOLOR
	ENDIF

ELSEIF 종류 == 攻守変動
	FOR カウンタ,0,5
		SIF GETVAR(@"%対面者%_필드:カウンタ") == -1
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_リ数:カウンタ") >= 10
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_表:カウンタ") == 3
			CONTINUE

		CALL TRAPSEX_CATEGORY_QUANTITY(対面者,カウンタ)
		蟲紋종류 = RESULT
		IF 蟲紋종류 >= 1
			CALL FULLRESET
			攻撃力修正 = 蟲紋종류 * 100
			CALL STATCHANGE_BASIC(対面者,"自身",カウンタ,-攻撃力修正,0,40076)
			CALL STATCHANGE_EFFECT(対面者,"自身",カウンタ,"表",1)
		ENDIF
	NEXT

ELSEIF 종류 == 지속효과
	IF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") >= 0
		CALL FULLRESET
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"モ耐")
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"魔耐")
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"함정耐")
	ENDIF

	IF バトルフェイズ != 1
		CALL FULLRESET
		효과条件カテゴリ = 혹란마
		효과条件표시 = 表側표시
		효과条件他所 = 1
		CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"破耐")
		CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"対耐")
	ENDIF

ELSEIF 종류 == 短紋章起動
	FOR カウンタ,0,5
		SIF GETVAR(@"%対面者%_필드:カウンタ") == -1
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_リ数:カウンタ") >= 10
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_表:カウンタ") == 3
			CONTINUE

		CALL TRAPSEX_CATEGORY_QUANTITY(対面者,カウンタ)
		蟲紋종류 = RESULT
		SIF 蟲紋종류 >= 1
			CALL STATCHANGE_EFFECT(対面者,"自身",カウンタ,"戦狂")
	NEXT
ENDIF
