@CARDNAME_40074,参照先
;ココで지정卡片の名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 혹란마 푸티카
	CASE "略称"
		RESULTS = 란 푸티카
	CASE "カテゴリ"
		RESULTS:0 = 혹란마
		RESULTS:1 = E.R.A
	CASE "検索カテゴリ"
		RESULTS:0 = 꿀구멍
ENDSELECT


@CARD_40074(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 식물족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 450
	CASE "守備力"
		RETURN 2350
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		RETURN 1381
ENDSELECT

RETURN 0

@CARD_EXPLANATION_40074(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動,フリー誘発)
PRINTL ①：이 카드가 패에 존재하는 경우、서로의 턴에 상대 필드의 앞면 표시 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 이 카드를 특수 소환한다、그 몬스터에게 이 카드의 벌레 문양을 새긴다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：이 카드가 필드에 공격 표시로 존재하는 한、
PRINTL 상대는 이 카드에 의해 새겨진 벌레 문양을 가진 몬스터를 소환 소재로 사용할 수 없다。
CALLFORM CARD_ABLE(2,攻撃時誘発)
SETCOLOR C_PINK
PRINTL ③：공격 표시인 이 카드가 공격 대상으로 선택되었을 때에 발동할 수 있다。
PRINTL 공격 몬스터에게 이 카드의 벌레 문양을 새긴다、이 카드는 수비 표시가 된다。
RESETCOLOR
CALL TEXT_DECORATION("ROGUE")


@CARDCAN_40074(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,40074)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,40074)
		RETURN 0
	SIF モンスター数(듀얼리스트) >= 5
		RETURN 0
	SIF ゾーン != "손패"
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,40074,ゾーン)
	SIF RESULT == 1
		RETURN 0

	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃時誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_表:場所") == 2
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃時強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_表:場所") == 2
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_表:場所") != 1
		RETURN 0
	RETURN 1

ENDIF

@CARDEFFECT_40074(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 蟲紋
#DIM DYNAMIC 選択カード,2
#DIM DYNAMIC 自己選択カード
#DIM DYNAMIC 自己守備力修正
#DIM DYNAMIC 対面選択カード
#DIM DYNAMIC 対面攻撃力修正
#DIM DYNAMIC 条件达成
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 성별판정
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,40074,1)
	IF RESULT == 0
		CALL FULLRESET
		효과条件표시 = 表側표시
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"상대필드",ゾーン,場所)
		選択カード:0 = RESULT
		IF 選択カード:0 != 9999
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
			;与赋予蟲紋相关的效果
			CALL TRAPSEX_GIVE_FIXED(듀얼리스트,ゾーン,종류,場所,選択カード:0,4)

			조교대상 = GETVAR(@"%対面者%_필드:(選択カード:0)")
			성별판정 = GETVAR(@"%対面者%_MZ_性:(選択カード:0)")
			CALL SEXTEXT_40074_1_1(듀얼리스트,조교대상,성별판정)
			
			; CALL TRAPSEX_CATEGORY_QUANTITY(対面者,選択カード:0)
			; SIF RESULT >= 4
			; 	条件达成 = 1
			; CALL FULLRESET
			; 효과範囲필드 = 1
			; 효과条件표시 = 表側표시
			; 효과条件カテゴリ = 혹란마
			; 효과条件종류 = 엑시즈
			; CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			; IF RESULT == 1 && 条件达成 == 1
			; 	CALL FULLRESET
			; 	PRINTL 대상のモンスターを"蜜壺"としますか？
			; 	PRINTL [1] - ★YEAH!★
			; 	PRINTL [2] - NO
			; 	BINPUT
			; 	IF RESULT == 1
			; 		CALL FULLRESET
			; 		효과条件표시 = 表側표시
			; 		효과条件カテゴリ = 혹란마
			; 		효과条件종류 = 엑시즈
			; 		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
			; 		選択カード:1 = RESULT
			; 		IF 選択カード:1 != 9999
			; 			CALL CARD_DISPOSE(対面者,"필드",選択カード:0,소멸行き)
			; 			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード:1,"Ｘ",1)
			; 		ENDIF
			; 		CALL SEXTEXT_40074_1_2(듀얼리스트,조교대상)
			; 	ENDIF
			; ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,40074,2)
	IF RESULT == 0
		自己選択カード = 戦闘場所(듀얼리스트)
		自己守備力修正 = GETVAR(@"%듀얼리스트%_MZ_守:自己選択カード")
		対面選択カード = 戦闘場所(듀얼리스트,1)
		対面攻撃力修正 = GETVAR(@"%対面者%_MZ_攻:対面選択カード")
		성별판정 = GETVAR(@"%対面者%_MZ_性:対面選択カード")
		IF 성별판정 == 牝性
			조교대상 = GETVAR(@"%対面者%_필드:対面選択カード")
			CALL SEXTEXT_40074_2_1(듀얼리스트,조교대상,성별판정,対面選択カード,自己守備力修正,対面攻撃力修正)
		ELSEIF (성별판정 == 雄性 || 성별판정 == ふたなり) && 対面攻撃力修正 - 自己守備力修正 >= 1
			조교대상 = GETVAR(@"%対面者%_필드:対面選択カード")
			CALL SEXTEXT_40074_2_1(듀얼리스트,조교대상,성별판정,対面選択カード,自己守備力修正,対面攻撃力修正)
			CALL CARD_EROTICS(조교대상)
			IF RESULT != -1
				SIF 마함数(対面者) < 5
					CALL CARD_EQUIP_MONSTER(対面者,対面選択カード,"상대필드",自己選択カード,1)
			ELSE
				SIF 마함数(対面者) < 5
					CALL CARD_EQUIP_MONSTER(対面者,対面選択カード,"상대필드",自己選択カード,1)
			ENDIF
		ELSEIF 성별판정 == 雄性 || 성별판정 == ふたなり
			조교대상 = GETVAR(@"%対面者%_필드:対面選択カード")
			CALL SEXTEXT_40074_2_1(듀얼리스트,조교대상,성별판정,対面選択カード,自己守備力修正,対面攻撃力修正)
		ENDIF
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"表",2,1)
		;与赋予蟲紋相关的效果
		CALL TRAPSEX_GIVE_FIXED(듀얼리스트,ゾーン,종류,場所,対面選択カード,4)
	ENDIF

ELSEIF 종류 == 攻撃時強制誘発
	CALL FULLRESET
	IF RESULT == 0
		IF 戦闘場所(듀얼리스트,1) != 5
			CALL CARD_EROTICS(戦闘カードID(듀얼리스트,1))
			IF RESULT != 0
				조교대상 = RESULT
			ENDIF
		ENDIF
		IF 조교대상 > 0
			PRINTFORML
			SETCOLOR C_PINK 
			PRINTFORML 푸티카가 %CALLNAME:조교대상%의 공격에 당하려던 그때, 갑자기 나타난 식물이 두 사람을 삼켜버렸다.
			RESETCOLOR
		ENDIF		
	ENDIF

ELSEIF 종류 == 지속효과
	FOR カウンタ,0,5
		SIF GETVAR(@"%対面者%_필드:カウンタ") == -1
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_リ数:カウンタ") >= 10
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_表:カウンタ") == 3
			CONTINUE

		蟲紋 = GETVAR(@"%対面者%_MZ_蟲紋Ｃ:カウンタ")
		SIF GETBIT(蟲紋, 4) == 1
			CALL STATCHANGE_EFFECT(対面者,"自身",カウンタ,"不材")
	NEXT
ENDIF



