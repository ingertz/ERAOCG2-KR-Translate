;40070——혹란마 트리온
;3效果판정
@SEXTEXT_40070_1_1(듀얼리스트,조교대상,성별판정,対面選択カード,自己守備力修正,対面攻撃力修正)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 自己守備力修正
#DIM DYNAMIC 対面選択カード
#DIM DYNAMIC 対面攻撃力修正
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 성별판정

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 성별판정 == 牝性
	CALL CARD_EROTICS(조교대상)
	IF RESULT != -1
		조교대상 = RESULT
		SETCOLOR C_PINK
		PRINTFORML 트리온의 손가락이 %CALLNAME:조교대상%의 안을 휘젓고 있어, 쾌감 때문에 %CALLNAME:조교대상%는 공격에 집중하는 것이 어려워지고 있다.
		PRINTFORMW 그것과 동시에, 색이 기묘한 화문이 천천히 %CALLNAME:조교대상%의 몸에 기어 올라왔다……
		RESETCOLOR
		CALL EROTIC_MOVE("손가락入れ",조교대상,NO_TO_CHARANUM(1372))
	ENDIF
ELSEIF (성별판정 == 雄性 || 성별판정 == ふたなり) && 対面攻撃力修正 - 自己守備力修正 >= 1
	CALL CARD_EROTICS(조교대상)
	IF RESULT != -1
		조교대상 = RESULT
		SETCOLOR C_PINK
		PRINTFORMW 트리온은 교환의 쾌감에 빠져, %CALLNAME:조교대상%의 육봉에 완전히 정복당해 버렸다……！
		RESETCOLOR
		CALL EROTIC_MOVE("前穴凌辱",NO_TO_CHARANUM(1372),조교대상)
		IF 마함数(対面者) < 5
			SETCOLOR C_PINK
			PRINTFORMW 그리고 그대로 %CALLNAME:조교대상%에게 육개로서 끌려가 버렸다……
			RESETCOLOR
		ENDIF
		ELSE
			CALLFORM CARDNAME_{GETVAR(@"%対面者%_필드:対面選択カード")}("이름")
			SETCOLOR C_PINK
			PRINTFORMW 트리온은 교환의 쾌감에 빠져, %RESULTS%의 육봉에 완전히 정복당해 버렸다……！
			RESETCOLOR
			CALL EROTIC_MOVE("前穴凌辱",NO_TO_CHARANUM(1372), -1)
			IF 마함数(対面者) < 5
				SETCOLOR C_PINK
				PRINTFORMW 그리고 그대로 %RESULTS%에게 육개로서 끌려가 버렸다……
				RESETCOLOR
			ENDIF
		ENDIF
ELSEIF 성별판정 == 雄性 || 성별판정 == ふたなり
	CALL CARD_EROTICS(조교대상)
	IF RESULT != -1
		조교대상 = RESULT
		SETCOLOR C_PINK
		PRINTFORML 트리온의 손이 %CALLNAME:조교대상%의 육봉을 붙잡고 고속으로 흔들고 있어, 쾌감 때문에 %CALLNAME:조교대상%는 공격에 집중하는 것이 어려워지고 있다.
		PRINTFORMW 그것과 동시에, 색이 기묘한 화문이 천천히 %CALLNAME:조교대상%의 몸에 기어 올라왔다……
		RESETCOLOR
		CALL EROTIC_MOVE("全身애무",조교대상,NO_TO_CHARANUM(1372))
	ENDIF
ENDIF
