CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_EROTICS(조교대상)
IF RESULT != -1
	조교대상 = RESULT
	SETCOLOR C_PINK
	PRINTFORML 
	PRINTFORMW 전패한 %CALLNAME:조교대상%는 혹란마들에게 잘 보살핌을 받고, 그 후, 장난감으로서 다시 필드로 끌려 나왔다.
	RESETCOLOR
	CALL EROTIC_MOVE("淫紋の疼き",조교대상,-1)
ENDIF

