;40080——혹란마 클라리아
;2效果판정
@SEXTEXT_40080_1_1(듀얼리스트,攻撃カード,選択カード,蟲紋종류,守備力修正,受側조교대상,攻撃조교대상)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 蟲紋종류
#DIM DYNAMIC 守備力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 受側조교대상
#DIM DYNAMIC 攻撃カード
#DIM DYNAMIC 攻撃조교대상


IF (攻撃カード == 選択カード) && 蟲紋종류 >= 4
	CALL CARD_EROTICS(受側조교대상)
	IF RESULT != -1
		受側조교대상 = RESULT
		SETCOLOR C_PINK
		PRINTFORML 攻撃はクラリアに触れる寸前で止まり、%CALLNAME:受側조교대상%の身体に絡みつく蟲紋から激しい痒みと욕망が全身に伝わってきた。
		PRINTFORML %CALLNAME:受側조교대상%はクラリアの前で土下座し、高潮によって蟲紋がもたらす고통を和らげてくれるよう懇願した。
		PRINTFORMW しかし、クラリアは%CALLNAME:受側조교대상%が절정に達する寸前で手を止めるのを繰り返すだけで、目の前の聞き分けのない「펫」を罰した。
		RESETCOLOR
		CALL EROTIC_MOVE("淫紋の疼き",受側조교대상, -1)
	ENDIF

ELSEIF (攻撃カード == 選択カード) && 蟲紋종류 <= 3
	CALL CARD_EROTICS(受側조교대상)
	IF RESULT != -1
		受側조교대상 = RESULT
		SETCOLOR C_PINK
		PRINTFORML %CALLNAME:受側조교대상%は蟲紋がもたらす고통を強くこらえ、クラリアに向かって攻撃を繰り出した。
		PRINTFORMW 今回は何とか耐えたものの、%CALLNAME:受側조교대상%の理は既に限界に達しており、いつでも쾌감に負ける可能性があった。
		RESETCOLOR
		CALL EROTIC_MOVE("淫紋の疼き",受側조교대상, -1)
	ENDIF

ELSEIF (攻撃カード != 選択カード) && 蟲紋종류 >= 4
	CALL CARD_EROTICS(受側조교대상)
	IF RESULT != -1
		受側조교대상 = RESULT
		CALL CARD_EROTICS(攻撃조교대상)
		IF RESULT != -1
			攻撃조교대상 = RESULT
			SETCOLOR C_PINK
			PRINTFORML クラリアへ攻撃を仕掛けようとする%CALLNAME:攻撃조교대상%は、자신の仲間が既に蟲紋によって操られていることに気づかず、容易く制伏されてしまった。
			PRINTFORML %CALLNAME:攻撃조교대상%は力を振り絞って%CALLNAME:受側조교대상%の理を取り戻そうとしたが、完全に쾌감に溺れていた%CALLNAME:受側조교대상%に無視されてしまった。
			PRINTFORMW 혹란마がもたらす屈辱、仲間の堕落と裏切り、絶望に陥った%CALLNAME:攻撃조교대상%は、자신が高潮の中で仲間と同じ紋様を烙印されるのを見るしかなかった。
			RESETCOLOR
			CALL EROTIC_MOVE("淫紋の疼き",受側조교대상, -1)
			CALL EROTIC_MOVE("淫紋の疼き",攻撃조교대상, -1)
		ELSE
			SETCOLOR C_PINK
			PRINTFORML 蟲紋がもたらす痒みを我慢する%CALLNAME:受側조교대상%の脳裏に、突然クラリアの命令が響き渡り、同時に更に強烈な쾌감が伴った。
			PRINTFORML %CALLNAME:受側조교대상%は脳裏で全力を尽くしてクラリアの命令に抗おうとするが、身体は制御を失い、자신の仲間へと手を伸ばしてしまった……
			PRINTFORMW 仲間を押し倒すその瞬間まで、%CALLNAME:受側조교대상%の脳内の糸は遂に切れ、命令に抗うことを止め、仲間と共に底の見えない深淵へと堕ちていった。
			RESETCOLOR
			CALL EROTIC_MOVE("淫紋の疼き",受側조교대상, -1)
		ENDIF
	ELSE
		CALL CARD_EROTICS(攻撃조교대상)
