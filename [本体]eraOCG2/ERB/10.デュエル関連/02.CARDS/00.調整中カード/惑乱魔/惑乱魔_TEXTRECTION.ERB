#DIM DYNAMIC 攻撃조교대상


IF (攻撃カード == 選択カード) && 蟲紋종류 >= 4
	CALL CARD_EROTICS(受側조교대상)
	IF RESULT != -1
		受側조교대상 = RESULT
		SETCOLOR C_PINK
		PRINTFORML 공격은 클라리아에게 닿기 직전에 멈추고, %CALLNAME:受側조교대상%의 신체에 휘감기는 벌레문양에서 격렬한 가려움과 욕망이 전신에 전해져 왔다.
		PRINTFORML %CALLNAME:受側조교대상%는 클라리아 앞에서 도게자하고, 절정에 의해 벌레문양이 가져오는 고통을 완화해 주도록 간청했다.
		PRINTFORMW 그러나, 클라리아는 %CALLNAME:受側조교대상%가 절정에 달하기 직전에 손을 멈추는 것을 반복할 뿐으로, 눈앞의 말 안 듣는 「펫」을 벌했다.
		RESETCOLOR
		CALL EROTIC_MOVE("淫紋の疼き",受側조교대상, -1)
	ENDIF

ELSEIF (攻撃カード == 選択カード) && 蟲紋종류 <= 3
	CALL CARD_EROTICS(受側조교대상)
	IF RESULT != -1
		受側조교대상 = RESULT
		SETCOLOR C_PINK
		PRINTFORML %CALLNAME:受側조교대상%는 벌레문양이 가져오는 고통을 꾹 참고, 클라리아를 향해 공격을 내보냈다.
		PRINTFORMW 이번에는 어떻게든 견뎠지만, %CALLNAME:受側조교대상%의 이성은 이미 한계에 달해 있어, 언제라도 쾌감에 질 가능성이 있었다.
		RESETCOLOR
		CALL EROTIC_MOVE("淫紋の疼き",受側조교대상, -1)
	ENDIF

ELSEIF (攻撃カード != 選択カード) && 蟲紋종류 >= 4
	CALL CARD_EROTICS(受側조교대상)
	IF RESULT != -1
		受側조교대상 = RESULT
		CALL CARD_EROTICS(攻撃조교대상)
		IF RESULT != -1
			攻撃조교대상 = RESULT
			SETCOLOR C_PINK
			PRINTFORML 클라리아에게 공격을 하려고 하는 %CALLNAME:攻撃조교대상%는, 자신의 동료가 이미 벌레문양에 의해 조종당하고 있다는 것을 눈치채지 못하고, 쉽게 제압당해 버렸다.
			PRINTFORML %CALLNAME:攻撃조교대상%는 힘을 짜내어 %CALLNAME:受側조교대상%의 이성을 되찾으려 했지만, 완전히 쾌감에 빠져 있던 %CALLNAME:受側조교대상%에게 무시당해 버렸다.
			PRINTFORMW 혹란마가 가져오는 굴욕, 동료의 타락과 배신, 절망에 빠진 %CALLNAME:攻撃조교대상%는, 자신이 절정 속에서 동료와 같은 문양을 낙인찍히는 것을 볼 수밖에 없었다.
			RESETCOLOR
			CALL EROTIC_MOVE("淫紋の疼き",受側조교대상, -1)
			CALL EROTIC_MOVE("淫紋の疼き",攻撃조교대상, -1)
		ELSE
			SETCOLOR C_PINK
			PRINTFORML 벌레문양이 가져오는 가려움을 참는 %CALLNAME:受側조교대상%의 뇌리에, 갑자기 클라리아의 명령이 울려 퍼지고, 동시에 추가로 강렬한 쾌감이 동반되었다.
			PRINTFORML %CALLNAME:受側조교대상%는 뇌리에서 전력을 다해 클라리아의 명령에 저항하려 하지만, 신체는 제어를 잃고, 자신의 동료에게 손을 뻗어 버렸다……
			PRINTFORMW 동료를 밀어 넘어뜨리는 그 순간까지, %CALLNAME:受側조교대상%의 뇌내의 실은 마침내 끊어지고, 명령에 저항하는 것을 멈추고, 동료와 함께 바닥이 보이지 않는 심연으로 떨어져 갔다.
			RESETCOLOR
			CALL EROTIC_MOVE("淫紋の疼き",受側조교대상, -1)
		ENDIF
	ELSE
		CALL CARD_EROTICS(攻撃조교대상)
		IF RESULT != -1
			攻撃조교대상 = RESULT
			SETCOLOR C_PINK
			PRINTFORML 클라리아에게 공격을 하려고 하는 %CALLNAME:攻撃조교대상%는, 자신의 동료가 이미 벌레문양에 의해 조종당하고 있다는 것을 눈치채지 못하고, 쉽게 제압당해 버렸다.
			PRINTFORML %CALLNAME:攻撃조교대상%는 힘을 짜내어 동료의 이성을 되찾으려 했지만, 완전히 쾌감에 빠져 있던 동료에게 무시당해 버렸다.
			PRINTFORMW 혹란마가 가져오는 굴욕, 동료의 타락과 배신, 절망에 빠진 %CALLNAME:攻撃조교대상%는, 자신이 절정 속에서 동료와 같은 문양을 낙인찍히는 것을 볼 수밖에 없었다.
			RESETCOLOR
			CALL EROTIC_MOVE("淫紋の疼き",攻撃조교대상, -1)
		ENDIF
	ENDIF

ELSEIF (攻撃カード != 選択カード) && 蟲紋종류 <= 3
	CALL CARD_EROTICS(受側조교대상)
	IF RESULT != -1
		受側조교대상 = RESULT
		SETCOLOR C_PINK
		PRINTFORML %CALLNAME:受側조교대상%는 뇌내에서 필사적으로 클라리아의 명령에 저항하고, 그 목소리가 완전히 사라질 때까지 숨을 쉴 수가 없었다.
		PRINTFORML 격렬한 쾌감을 견디다 못해 바닥에 주저앉은 %CALLNAME:受側조교대상%의 옷은 이미 땀으로 젖고, 신체의 벌레문양은 여전히 희미하게 아파왔다.
		PRINTFORMW 이번에는 어떻게든 견뎠지만, %CALLNAME:受側조교대상%의 이성은 이미 한계에 달해 있어, 언제라도 쾌감에 질 가능성이 있었다.
		RESETCOLOR
		CALL EROTIC_MOVE("淫紋の疼き",受側조교대상, -1)
	ENDIF
ENDIF

