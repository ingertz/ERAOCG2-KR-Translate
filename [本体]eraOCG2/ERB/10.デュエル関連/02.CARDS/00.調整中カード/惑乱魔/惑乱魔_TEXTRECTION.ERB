;40081——혹란마 리세
;2效果판정
@SEXTEXT_40081_1_1(듀얼리스트,조교대상,성별판정,対面選択カード,自己守備力修正,対面攻撃力修正)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 自己守備力修正
#DIM DYNAMIC 対面選択カード
#DIM DYNAMIC 対面攻撃力修正
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 성별판정

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 성별판정 == 牝性
	CALL CARD_EROTICS(조교대상)
	IF RESULT != -1
		조교대상 = RESULT
		SETCOLOR C_PINK
		PRINTFORML 의식 몽롱한 %CALLNAME:조교대상%는 리세에게 허를 찔려, 약해진 정신이 갑자기 강한 자극을 받아, 격렬한 절정에 빠졌다.
		PRINTFORMW 그것과 동시에, 색이 기묘한 꽃문양이 천천히 %CALLNAME:조교대상%의 몸을 타고 기어 올라왔다……
		RESETCOLOR
		CALL EROTIC_MOVE("조교部屋",조교대상,NO_TO_CHARANUM(1378))
	ENDIF
ELSEIF (성별판정 == 雄性 || 성별판정 == ふたなり) && 対面攻撃力修正 - 自己守備力修正 >= 1
	CALL CARD_EROTICS(조교대상)
	IF RESULT != -1
		조교대상 = RESULT
		SETCOLOR C_PINK
		PRINTFORMW 리세는 교환의 쾌감에 빠져, %CALLNAME:조교대상%의 육봉에 완전히 정복당해 버렸다……!
		RESETCOLOR
		CALL EROTIC_MOVE("前穴凌辱",NO_TO_CHARANUM(1378),조교대상)
		IF 마함数(対面者) < 5
			SETCOLOR C_PINK
			PRINTFORMW 그리고 그대로 %CALLNAME:조교대상%에게 육개로서 끌려가 버렸다……
			RESETCOLOR
		ENDIF
		ELSE
			CALLFORM CARDNAME_{GETVAR(@"%対面者%_필드:対面選択カード")}("名前")
			SETCOLOR C_PINK
			PRINTFORMW 리세는 교환의 쾌감에 빠져, %RESULTS%의 육봉에 완전히 정복당해 버렸다……!
			RESETCOLOR
			CALL EROTIC_MOVE("前穴凌辱",NO_TO_CHARANUM(1378), -1)
			IF 마함数(対面者) < 5
				SETCOLOR C_PINK
				PRINTFORMW 그리고 그대로 %RESULTS%에게 육개로서 끌려가 버렸다……
				RESETCOLOR
			ENDIF
		ENDIF
ELSEIF 성별판정 == 雄性 || 성별판정 == ふたなり
	CALL CARD_EROTICS(조교대상)
	IF RESULT != -1
		조교대상 = RESULT
		SETCOLOR C_PINK
		PRINTFORML 눈이 돌 정도로 의식 몽롱하던 %CALLNAME:조교대상%는, 리세에게 허를 찔려, 약해진 정신이 갑자기 강한 자극을 받아, 격렬하게 사정하기 시작했다.
		PRINTFORMW 그것과 동시에, 색이 기묘한 꽃문양이 천천히 %CALLNAME:조교대상%의 몸을 타고 기어 올라왔다……
		RESETCOLOR
		CALL EROTIC_MOVE("조교部屋",조교대상,NO_TO_CHARANUM(1378))
	ENDIF
ENDIF

