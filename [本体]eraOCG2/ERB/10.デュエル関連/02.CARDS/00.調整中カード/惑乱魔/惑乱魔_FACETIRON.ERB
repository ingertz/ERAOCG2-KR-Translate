;赋予怪兽固定的蟲紋
@TRAPSEX_GIVE_FIXED(듀얼리스트,ゾーン,종류,場所,選択カード,添加蟲紋)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 蟲紋
#DIM DYNAMIC 添加蟲紋
#DIM DYNAMIC 返횟수

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

蟲紋 = GETVAR(@"%対面者%_MZ_蟲紋Ｃ:選択カード")
GETBIT 蟲紋, 添加蟲紋
返횟수 = RESULT

SETBIT 蟲紋, 添加蟲紋
SETVAR @"%対面者%_MZ_蟲紋Ｃ:選択カード", 蟲紋

RETURN 返횟수

;―――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
;通过卡片ID获取其名字，并판정赋予蟲紋的종류
@TRAPSEX_GIVE_OTHER(듀얼리스트,ゾーン,종류,場所,選択カード,選択カード_ID,듀얼리스트판정)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 조교者名前
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 蟲紋
#DIM DYNAMIC 듀얼리스트판정 = 0


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 듀얼리스트판정 == 1
	蟲紋 = GETVAR(@"%対面者%_蟲紋Ｃ")
ELSE
	蟲紋 = GETVAR(@"%対面者%_MZ_蟲紋Ｃ:選択カード")
ENDIF

TRYCALLFORM CARDNAME_{選択カード_ID},"名前"
조교者名前 = %RESULTS%

SELECTCASE 조교者名前
	CASE "혹란마 트리온"
		SETBIT 蟲紋, 0
	CASE "혹란마 티오"
	SETBIT 蟲紋, 1
	CASE "혹란마 란카"
		SETBIT 蟲紋, 2
	CASE "혹란마 키노"
		SETBIT 蟲紋, 3
	CASE "혹란마 푸티카"
		SETBIT 蟲紋, 4
	CASE "혹란마 리세"
		SETBIT 蟲紋, 5
	CASE "혹란마 아트라"
			SETBIT 蟲紋, 6
	CASE "혹란마 지나"
			SETBIT 蟲紋, 7
	CASE "혹란마 카즈라"
			SETBIT 蟲紋, 8
	CASE "혹란마 세라"
		SETBIT 蟲紋, 9
	CASE "혹란마 플레시아"
		SETBIT 蟲紋, 10
	CASE "혹란마 시트리스"
		SETBIT 蟲紋, 11
	CASE "혹란마 아티푸스"
		SETBIT 蟲紋, 12
	CASE "혹란마 알로메루스"
		SETBIT 蟲紋, 13
	CASE "혹란마 클라리아"
		SETBIT 蟲紋, 14
ENDSELECT

IF 듀얼리스트판정 == 1
	SETVAR @"%対面者%_蟲紋Ｃ", 蟲紋
ELSE
	SETVAR @"%対面者%_MZ_蟲紋Ｃ:選択カード", 蟲紋
ENDIF

;―――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
;赋予듀얼리스트蟲紋
@TRAPSEX_GIVE_DUEL(듀얼리스트,添加蟲紋,反転플래그)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 添加蟲紋
#DIM DYNAMIC 反転플래그
#DIMS DYNAMIC 대상名
#DIM DYNAMIC 蟲紋

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 反転플래그 == 0
	대상名 = %듀얼리스트%
ELSEIF 反転플래그 == 1
	대상名 = %対面者%
ELSEIF 反転플래그 == 2
	대상名 = お互い
ENDIF

IF 反転플래그 == 0
	蟲紋 = GETVAR(@"%듀얼리스트%_蟲紋Ｃ")
	SETBIT 蟲紋, 添加蟲紋
	SIF RESULT == -1
		SETBIT 蟲紋, 添加蟲紋
	SETVAR @"%듀얼리스트%_蟲紋Ｃ", 蟲紋

ELSEIF 反転플래그 == 1
	蟲紋 = GETVAR(@"%対面者%_蟲紋Ｃ")
	SETBIT 蟲紋, 添加蟲紋
	SIF RESULT == -1
		SETBIT 蟲紋, 添加蟲紋
	SETVAR @"%対面者%_蟲紋Ｃ", 蟲紋

ELSEIF 反転플래그 == 2
	蟲紋 = GETVAR(@"%듀얼리스트%_蟲紋Ｃ")
	SETBIT 蟲紋, 添加蟲紋
	SIF RESULT == -1
		SETBIT 蟲紋, 添加蟲紋
	SETVAR @"%듀얼리스트%_蟲紋Ｃ", 蟲紋

	蟲紋 = GETVAR(@"%対面者%_蟲紋Ｃ")
	SETBIT 蟲紋, 添加蟲紋
	SIF RESULT == -1
		SETBIT 蟲紋, 添加蟲紋
	SETVAR @"%対面者%_蟲紋Ｃ", 蟲紋
