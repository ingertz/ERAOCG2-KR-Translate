;판정对象持有的蟲紋종류数量
@TRAPSEX_CATEGORY_QUANTITY(듀얼리스트,選択カード,듀얼리스트판정)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 듀얼리스트판정
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 蟲紋
#DIM DYNAMIC 淫紋종류 = 0
#DIM DYNAMIC BIT

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 듀얼리스트판정 == 1
	蟲紋 = GETVAR(@"%듀얼리스트%_蟲紋Ｃ")
ELSEIF 듀얼리스트판정 == 2
	蟲紋 = GETVAR(@"%対面者%_蟲紋Ｃ")
ELSEIF 選択カード != 9999
	蟲紋 = GETVAR(@"%듀얼리스트%_MZ_蟲紋Ｃ:選択カード")
ENDIF

FOR BIT,0,15,1
	淫紋종류 += GETBIT(蟲紋,BIT)
NEXT

RETURN 淫紋종류

;―――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
;用于UI판정固定对象的蟲紋数量（상대）
@TRAPSEX_UI_USE1
#DIM DYNAMIC 蟲紋
#DIM DYNAMIC 淫紋종류 = 0
#DIM DYNAMIC BIT

蟲紋 = 상대_蟲紋Ｃ

FOR BIT,0,15,1
	淫紋종류 += GETBIT(蟲紋,BIT)
NEXT

RETURN 淫紋종류

;用于UI판정固定对象的蟲紋数量（자신）
@TRAPSEX_UI_USE2
#DIM DYNAMIC 蟲紋
#DIM DYNAMIC 淫紋종류 = 0
#DIM DYNAMIC BIT

蟲紋 = 자신_蟲紋Ｃ

FOR BIT,0,15,1
	淫紋종류 += GETBIT(蟲紋,BIT)
NEXT

RETURN 淫紋종류

;―――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
;赋予怪兽蟲紋的文字描述
@TRAPSEX_TEXT_MONSTER(듀얼리스트,選択カード)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 蟲紋
#DIM DYNAMIC 성별판정

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

蟲紋 = GETVAR(@"%듀얼리스트%_MZ_蟲紋Ｃ:選択カード")

PRINTL 【벌레 문양】
성별판정 = GETVAR(@"%듀얼리스트%_MZ_性:選択カード")
;下级
IF GETBIT(蟲紋, 0) == 1
	IF 성별판정 == 牝性
		SETCOLOR C_ORANGE
		PRINTL 몇몇 다갈색 문양이, 마치 클립처럼 그 몬스터의 음핵을 끼우고 있었다.
		PRINTL 
		RESETCOLOR
	ELSEIF 성별판정 == 雄性 || 성별판정 == ふたなり
		SETCOLOR C_ORANGE
		PRINTL 몇몇 문양이, 마치 클립처럼 그 몬스터의 음경을 끼우고 있었다.
		PRINTL 
		RESETCOLOR
	ELSE
		SETCOLOR C_ORANGE
		PRINTL 몇몇 다갈색 문양이, 그 몬스터의 비부에 휘감겨 있다.
		PRINTL 
		RESETCOLOR
	ENDIF
ENDIF

IF GETBIT(蟲紋, 1) == 1
	SETCOLOR C_L_BLUE
	PRINTL 담청색 문양이, 물얼룩처럼 그 몬스터의 비부 부근에 흩어져 있다.
	PRINTL 
	RESETCOLOR
ENDIF

IF GETBIT(蟲紋, 2) == 1
	SETCOLOR C_V_PINK
	PRINTL 그 몬스터가 란카에게 키스당한 장소, 얼굴, 목, 심지어 구강 내부에 이르기까지, 옅은 분홍색의 난초 문양이 부착되어 있다.
	PRINTL 
	RESETCOLOR
ENDIF

IF GETBIT(蟲紋, 3) == 1
	SETCOLOR C_AQUA
	PRINTL 하늘색 문양이, 사슬처럼 그 몬스터의 관절에 휘감겨 저릿함을 뿜어내고 있다.
	PRINTL 
	RESETCOLOR
ENDIF

IF GETBIT(蟲紋, 4) == 1
	SETCOLOR C_YELLOW_2
	PRINTL 푸티카의 함정에서 빠져나왔다 해도, 몸에 남은 꿀물은 시간이 지남에 따라 서서히 담황색 문양으로 변해 몬스터의 몸에 각인되고 말았다.
	PRINTL 
	RESETCOLOR
ENDIF

IF GETBIT(蟲紋, 5) == 1
	SETCOLOR C_S_WHITE
	PRINTL 그 몬스터의 귀여운 엉덩이에는, 리세가 장난으로 남긴 듯한 담회색 손바닥 자국 문양이 남아 있다.
	PRINTL 
	RESETCOLOR
ENDIF

IF GETBIT(蟲紋, 6) == 1
	SETCOLOR C_L_GRAY
	PRINTL 회흑색 문양이, 덩굴처럼 그 몬스터의 발에서 무릎까지 타고 올라와 휘감겨 있다.
	PRINTL 
	RESETCOLOR
ENDIF

IF GETBIT(蟲紋, 7) == 1
	SETCOLOR C_P_GREEN
	PRINTL 녹색 문양이, 나뭇가지처럼 그 몬스터의 등에 타고 올라와 있다.
	PRINTL 
	RESETCOLOR
ENDIF

IF GETBIT(蟲紋, 8) == 1
	SETCOLOR C_YELLOW
	PRINTL 황색 문양이, 목걸이처럼 그 몬스터의 흉부 부근과 쇄골 주위에 휘감겨 있다.
	PRINTL 
	RESETCOLOR
ENDIF

;上级
IF GETBIT(蟲紋, 9) == 1
	SETCOLOR C_L_GREEN
	PRINTL 담녹색 문양이, 이슬처럼 그 몬스터의 온몸에 흩어져 있다.
	PRINTL 
	RESETCOLOR
ENDIF

IF GETBIT(蟲紋, 10) == 1
	SETCOLOR C_PINK
	PRINTL 한 송이 분홍색 라플레시아가 그 몬스터의 복부에 각인되어, 요염한 빛을 내뿜고 있다.
	PRINTL 
	RESETCOLOR
ENDIF

IF GETBIT(蟲紋, 11) == 1
	SETCOLOR C_G_YELLOW
	PRINTL 황금색 문양이, 꿀처럼 그 몬스터의 가슴에 뿌려져 달콤한 향기를 내뿜고 있다.
	PRINTL 
	RESETCOLOR
ENDIF

IF GETBIT(蟲紋, 12) == 1
	SETCOLOR C_RED
	PRINTL 가느다란 암적색 문양이 거미줄처럼 서로 얽혀, 그 몬스터의 속옷이 되어 있다. 아무것도 감추고 있지는 않은데도 말이다.
	PRINTL 
	RESETCOLOR
ENDIF

IF GETBIT(蟲紋, 13) == 1
	IF 성별판정 == 牝性
		SETCOLOR C_D_RED
		PRINTL 개미 같은 적색 문양이, 그 몬스터의 성기 주위에 모여들어 따끔거리는 가려움을 자아내고 있다.
		PRINTL 
		RESETCOLOR
	ELSEIF 성별판정 == 雄性 || 성별판정 == ふたなり
		SETCOLOR C_D_RED
		PRINTL 암적색 문양이 그 몬스터의 음경에 휘감겨, 음경은 가려움으로 붉게 부어올라 있다.
		PRINTL 
		RESETCOLOR
	ELSE
		SETCOLOR C_D_RED
		PRINTL 개미 같은 적색 문양이, 그 몬스터의 몸 곳곳에 흩어져 따끔거리는 가려움을 전하고 있다.
		PRINTL 
		RESETCOLOR
	ENDIF
ENDIF

IF GETBIT(蟲紋, 14) == 1
	SETCOLOR C_SYN_WHITE
	PRINTL 하얀 토끼 문양이, 그 몬스터의 옆구리에 흩뿌려져 있다.
	PRINTL 
	RESETCOLOR
ENDIF

