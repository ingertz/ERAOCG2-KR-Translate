@CARDNAME_99073,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 혹란마 홀티아
	CASE "略称"
		RESULTS = 란 홀티아
	CASE "カテゴリ"
		RESULTS:0 = 혹란마
		RESULTS:1 = 꿀구멍
        RESULTS:2 = E.R.A
ENDSELECT


@CARD_99073(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 식물족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 200
	CASE "守備力"
		RETURN 2600
	CASE "성별"
		RETURN 牝性
	CASE "分割"
		RETURN 효과なし
	CASE "連動ID"
		RETURN 1383
ENDSELECT

RETURN 0

@CARD_EXPLANATION_99073(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL 이 카드명의 ①②의 효과는 １턴에 １번、어느쪽인가 １개밖에 사용할 수 없다。
PRINTL 이 카드는 패에서 "혹란마" 몬스터 １장 또는 "함정 속으로" / "꿀구멍" 일반 함정 카드 １장을 버리는 것으로 세트한 턴에 발동할 수 있다。
CALLFORM CARD_ABLE(1,마함起動,フリー誘発)
PRINTL ①：이 카드는 발동 후、몬스터 존에 수비 표시로 특수 소환한다。
PRINTL 그 후、자신 필드의 몬스터를 소재로서、EX덱에서 "혹란마" 몬스터 １장을 엑시즈 소환 또는 링크 소환할 수 있다。
CALLFORM CARD_ABLE(1,묘지起動,フリー誘発)
PRINTL ②：묘지의 이 카드를 제외하고 발동할 수 있다。
PRINTL 자신은 묘지의 "혹란마" 몬스터 １장을 특수 소환한다。
PRINTL 그 후、상대 필드의 앞면 표시 몬스터 １장을 골라、이 효과로 특수 소환한 자신 몬스터의 벌레 문양을 새긴다。
CALL TEXT_DECORATION("ROGUE")


@CARDCAN_99073(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,99073)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")
	SIF 발동済_1(듀얼리스트,99073)
		RETURN 0
	SIF 발동済_2(듀얼리스트,99073)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	SIF モンスター数(듀얼리스트) >= 5
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,99073,"마함")
	SIF RESULT == 1
		RETURN 0

	CALL FULLRESET
	효과範囲손패 = 1
    효과条件종류:0 = モン全般
    효과条件スーパー종류:1 = 通常함정
    효과条件カテゴリ:0 = 혹란마
    효과条件スーパーカテゴリ:1 = 함정 속으로
    효과条件スーパーカテゴリ:2 = 꿀구멍
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") == 3 && RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 묘지起動 || (종류 == フリー誘発 && ゾーン == "묘지")
	SIF 발동済_1(듀얼리스트,99073)
		RETURN 0
	SIF 발동済_2(듀얼리스트,99073)
		RETURN 0
	SIF モンスター数(듀얼리스트) >= 5
		RETURN 0

	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종류 = モン全般
	효과条件カテゴリ = 혹란마
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_99073(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 选择カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 소환カード
#DIM DYNAMIC 소환カードID
#DIM DYNAMIC 효과先
#DIM DYNAMIC 条件达成

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF (종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")) && GETVAR(@"%듀얼리스트%_魔_表:場所") == 3
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99073,1)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종류:0 = モン全般
		효과条件スーパー종류:1 = 通常함정
		효과条件カテゴリ:0 = 혹란마
		효과条件スーパーカテゴリ:1 = 함정 속으로
		효과条件スーパーカテゴリ:2 = 꿀구멍
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트, "마함", 場所, "守備표시")
			CALL FULLRESET
			PRINTL 자신 필드의 몬스터를 사용해 엑시즈 소환 또는 링크 소환을 하시겠습니까？
			PRINTL [1] - ★YEAH!★
			PRINTL [2] - NO
			BINPUT
			IF RESULT == 1
				CALL FULLRESET
				효과範囲EX덱 = 1
				효과条件カテゴリ = 혹란마
				효과条件종류:0 = 엑시즈
				효과条件종류:1 = 링크
				효과条件소환可 = 1
				CALL CARD_CHOOSE_BASIC(듀얼리스트, "EX덱",ゾーン,場所)
				소환カード = RESULT
				IF 소환カード != 9999
					소환カードID = RESULT:99
					CALLFORM CARD_{소환カードID}, "종류"
					IF RESULT == 엑시즈
						TRYCALLFORM CARDSUMMON_{소환カードID}(듀얼리스트,소환カード)
						CALL XYZSUMMON(듀얼리스트, 소환カード)
					ELSEIF RESULT == 링크
						TRYCALLFORM CARDSUMMON_{소환カードID}(듀얼리스트,소환カード)
						CALL LINSUMMON(듀얼리스트, 소환カード)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 마함起動 || (종류 == フリー誘発 && GROUPMATCH(ゾーン,"마함"))
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99073,1)
	IF RESULT == 0
		CALL RESETCONDITION		
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所, "守備표시")
		CALL FULLRESET
		PRINTL 자신 필드의 몬스터를 사용해 엑시즈 소환 또는 링크 소환을 하시겠습니까？
		PRINTL [1] - ★YEAH!★
		PRINTL [2] - NO
		BINPUT
		IF RESULT == 1
			CALL FULLRESET
			효과範囲EX덱 = 1
			효과条件カテゴリ = 혹란마
			효과条件종류:0 = 엑시즈
			효과条件종류:1 = 링크
			효과条件소환可 = 1
			CALL CARD_CHOOSE_BASIC(듀얼리스트, "EX덱",ゾーン,場所)
			소환カード = RESULT
			IF 소환カード != 9999
				소환カードID = RESULT:99
				CALLFORM CARD_{소환カードID}, "종류"
				IF RESULT == 엑시즈
					TRYCALLFORM CARDSUMMON_{소환カードID}(듀얼리스트,소환カード)
					CALL XYZSUMMON(듀얼리스트, 소환カード)
				ELSEIF RESULT == 링크
					TRYCALLFORM CARDSUMMON_{소환カードID}(듀얼리스트,소환カード)
					CALL LINSUMMON(듀얼리스트, 소환カード)
				ENDIF
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 묘지起動 || (종류 == フリー誘発 && ゾーン == "묘지")
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99073,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종류 = モン全般
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		효과先 = 最終소환場所
		소환カードID = RESULT:1

		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件표시 = 表側표시
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件达成 = 1
		IF 효과先 != 5 && 条件达成 == 1
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과条件표시 = 表側표시
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"상대필드",ゾーン,場所)
			选择カード = RESULT
			SIF 选择カード != 9999
				;与赋予蟲紋相关的效果
				CALL TRAPSEX_GIVE_OTHER(듀얼리스트,ゾーン,종류,場所,选择カード,소환カードID)
		ENDIF
	ENDIF
ENDIF