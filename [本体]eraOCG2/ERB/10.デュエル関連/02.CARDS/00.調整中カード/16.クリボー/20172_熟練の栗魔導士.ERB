@CARDNAME_20172,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 숙련된 율마도사
	CASE "略称"
		RESULTS = 숙련된 율마도사
	CASE "カテゴリ"
		RESULTS:0 = 크리보
		RESULTS:1 = 마력 카운터
ENDSELECT


@CARD_20172(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 300
	CASE "守備力"
		RETURN 200
	CASE "추가日"
		RETURN 251009
ENDSELECT
RETURN 0

@CARD_EXPLANATION_20172(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,발동強制誘発)
PRINTL ①：마법 카드의 효과가 발동하거나、패의 "크리보" 몬스터의 효과가 발동할 때 마다、
PRINTL 이 카드에 마력 카운터를 １개 놓는다。
CALLFORM CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ②：자신 / 상대 턴에、이 카드의 마력 카운터를 １개 제거하고、
PRINTL 이하의 효과에서 １개를 선택해서 발동할 수 있다。
PRINTL ●자신의 덱 / 묘지에서 "숙련된 율마도사" 이외의 "크리보" 카드 １장을 패에 넣는다。
PRINTL ●이 카드의 레벨은 １개 오르며、공격력은 １５００ 오른다。

@CARDSUMMON_AA_20172


@CARDCAN_20172(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ数
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,20172)
SIF RESULT == 1
	RETURN 0

IF 종류 == 발동強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과条件종류 = 마법全般
	CALL CARD_CHECK_START_DATA_2(듀얼리스트,2)
	SIF RESULT == 1
		RETURN 1
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件カテゴリ = 크리보
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA_2(듀얼리스트,2)
	SIF RESULT == 1
		RETURN 1
	RETURN 0

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_2(듀얼리스트,20172)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_魔Ｃ:場所") < 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_20172(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタ数
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 발동強制誘発
	CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"魔Ｃ",1)

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,20172,2)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"魔Ｃ",-1)

		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 크리보
		효과条件固名前 = 숙련된 율마도사
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL YN_CHOICE(듀얼리스트,"●덱 / 묘지에서 「크리보」카드를 패에 넣는다。","●이 카드의 공격력 １５００업！")
		ELSE
			RESULT = 1
		ENDIF

		IF RESULT == 0
			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ = 크리보
			효과条件固名前 = 숙련된 율마도사
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)

		ELSEIF RESULT == 1
			CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"永攻",1500)
			CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"永星",1)
		ENDIF
	ENDIF
ENDIF