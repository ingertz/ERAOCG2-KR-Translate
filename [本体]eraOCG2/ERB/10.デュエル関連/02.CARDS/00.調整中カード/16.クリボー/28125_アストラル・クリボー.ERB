@CARDNAME_28125,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 아스트랄 크리보
	CASE "略称"
		RESULTS = 아스크리
	CASE "カテゴリ"
		RESULTS:0 = 크리보
ENDSELECT


@CARD_28125(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 100
	CASE "守備力"
		RETURN 100
	CASE "추가日"
		RETURN 251009
ENDSELECT

RETURN 0

@CARD_EXPLANATION_28125(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：ＥＸ덱の「Ｎｏ.」Ｘモンスター１体を상대に見せて발동できる。
PRINTL このカードを손패から특수소환する。
PRINTL このカードのレベルは見せたモンスターのランクの数値と同じになる。
PRINTL この효과で특수소환したこのカードがモンスターゾーンに表側표시で存在する限り、
PRINTL 자신は「Ｎｏ.」ＸモンスターしかＥＸ덱から특수소환できない。
CALLFORM CARD_ABLE(2,X素材時효과)
PRINTL ②：このカードが「Ｎｏ.」Ｘモンスターとなった場合、자신フィールドの「Ｎｏ.」Ｘモンスター１体を대상として발동できる。
PRINTL そのモンスターは戦闘耐性・破壊耐性を得る。

@CARDCAN_28125(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,28125)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,28125)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,28125,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件カテゴリ = ナンバーズ
	효과条件종류 = 엑시즈
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == X素材時효과
	SIF 발동済_2(듀얼리스트,28125)
		RETURN 0
	CALL FULLRESET
	효과条件カテゴリ = ナンバーズ
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"EX특수소환")
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_汎数:場所") < 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_28125(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードランク

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28125,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件カテゴリ = ナンバーズ
		효과条件종류 = 엑시즈
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 9999
			TRYCALLFORM CARD_{RESULT:99},"レベル"
			選択カードランク = RESULT
			CALL FULLRESET
			효과추가종류:0 = 効追汎数
			효과추가종류:1 = 効追永星 + 選択カードランク
			CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF

ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28125,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件カテゴリ = ナンバーズ
		효과条件표시 = 表側표시
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"戦耐",2,1)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"破耐",2,1)
		ENDIF
	ENDIF

ELSEIF 종류 == 지속효과
	CALL SET_TMP_EX_RST_CAT(듀얼리스트,"ナンバーズ")
ENDIF

