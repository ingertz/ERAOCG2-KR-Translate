@CARDNAME_28127,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 앙크리보
	CASE "略称"
		RESULTS = 앙크리보
	CASE "カテゴリ"
		RESULTS:0 = 크리보
ENDSELECT


@CARD_28127(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 300
	CASE "守備力"
		RETURN 200
	CASE "추가日"
		RETURN 251009
ENDSELECT

RETURN 0

@CARD_EXPLANATION_28127(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,攻撃時誘発)
PRINTL ①：상대モンスターの攻撃宣言時に발동できる。
PRINTL 자신・상대の묘지のモンスター１体を자신フィールドに특수소환する
PRINTL （これが直接攻撃だった場合、さらに攻撃대상をそのモンスターに移し替える）。
PRINTL その後、손패のこのカードを묘지へ送る。
PRINTL この효과で특수소환したモンスターはエンドフェイズに破壊される。
CALLFORM CARD_ABLE(2,戦闘→묘지,破壊→묘지)
PRINTL ②：このカードが戦闘・효과で破壊された場合に발동できる。
PRINTL このターンのエンドフェイズに、자신の덱・묘지から「死者蘇生」１枚を選んで손패に加える。

@CARDCAN_28127(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,28127)
SIF RESULT == 1
	RETURN 0

IF 종류 == 攻撃時誘発
	SIF 발동済_1(듀얼리스트,28127)
		RETURN 0
	SIF ゾーン != "손패"
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲상대묘지 = 1
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지
	SIF 발동済_2(듀얼리스트,28127)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件名前 = 死者蘇生
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK(1)
	RETURN 1

ELSEIF 종류 == ターン終了時予約
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件名前 = 死者蘇生
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_28127(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28127,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과추가종류 = 効追終破
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1 && 戦闘場所(듀얼리스트) == 5
			CALL COVER_ATTACK(듀얼리스트,カード소환先)
		ENDIF
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28127,2)
	IF RESULT == 0
		CALL CARD_RESERV(듀얼리스트,28127,エンド予約)
	ENDIF

ELSEIF 종류 == ターン終了時予約
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件名前 = 死者蘇生
	CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
ENDIF

