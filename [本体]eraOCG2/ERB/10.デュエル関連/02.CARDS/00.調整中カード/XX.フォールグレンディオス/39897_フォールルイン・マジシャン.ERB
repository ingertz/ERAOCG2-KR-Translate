@CARDNAME_39897,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 폴스타베이더 “Ɽꓤuin” 매지션
	CASE "略称"
		RESULTS = Ɽꓤuin매지션
	CASE "カテゴリ"
		RESULTS:0 = Ɽꓤ
		RESULTS:1 = E.R.A
ENDSELECT

@CARD_39897(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1000
	CASE "守備力"
		RETURN 1800
	CASE "성별"
		RETURN 無性
	CASE "추가日"
		RETURN 250709
ENDSELECT
RETURN 0

@CARD_EXPLANATION_39897(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,소환時,특수소환時)
PRINTL ①：이 카드가 소환 / 특수 소환된 경우에、자신 필드에 "GⱤꓤendios" 몬스터가 존재한다면 발동할 수 있다。
PRINTL 이 카드를 자신의 마법＆함정 존에 앞면 표시로 놓는다。
PRINTL 이 효과로 놓여진 이 카드는 "함락주박" 카드로도 취급한다。
PRINTL 이 효과를 발동한 턴의 종료 시、자신의 마법＆함정 존의 모든 "폴스타베이더 “Ɽꓤuin” 매지션"을 패로 되돌린다。
CALL CARD_ABLE(2,필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지,X素材時효과)
PRINTL ②：이 카드가 묘지로 보내진 경우、또는 Ｘ소환의 소재가 된 경우에 발동할 수 있다。
PRINTL 묘지의 ＥＸ몬스터 이외의 "Ɽꓤ" 몬스터 １장을 특수 소환하거나、패에 넣는다。
PRINTL 이 효과를 발동한 턴、자신은 "Ɽꓤ" 몬스터 이외의 몬스터를 특수 소환할 수 없다。

@CARDCAN_39897(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,39897)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,39897)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = GⱤꓤendios
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지 || 종류 == X素材時효과
	SIF 발동済_2(듀얼리스트,39897)
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종류 = EX以外全般
	효과条件カテゴリ = Ɽꓤ
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과条件固カテゴリ = Ɽꓤ
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"SS이력")
	SIF RESULT != 0
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン終了時予約
	RETURN 1	
ENDIF


@CARDEFFECT_39897(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 選択カード数
#DIM DYNAMIC 条件Ａ
#DIM DYNAMIC 条件Ｂ
#DIM DYNAMIC 選択효과

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39897,1)
	IF RESULT == 0
		CALL FULLRESET
		효과추가カテ = 함락주박
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		CALL CARD_RESERV(듀얼리스트,39897,ターン終了時予約)
	ENDIF
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지 || 종류 == X素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39897,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종류 = EX以外全般
		효과条件カテゴリ = Ɽꓤ
		효과条件소환可 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL YN_CHOICE(듀얼리스트,"●묘지에서 묘지의 ＥＸ몬스터 이외의「Ɽꓤ」몬스터 １장을 특수 소환한다","●묘지에서 묘지의 ＥＸ몬스터 이외의「Ɽꓤ」몬스터 １장을 패에 넣는다")
			選択효과 = RESULT
		ELSE
			選択효과 = いいえ
		ENDIF
		IF 選択효과 == はい
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件종류 = EX以外全般
			효과条件カテゴリ = Ɽꓤ
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ELSE
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件종류 = EX以外全般
			효과条件カテゴリ = Ɽꓤ
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == ターン終了時予約
	FOR カウンタ, 0, 5
		SIF GETVAR(@"%듀얼리스트%_마함:カウンタ") != 39897
			CONTINUE
		CALL CARD_DISPOSE(듀얼리스트,"마함",カウンタ,손패行き)
	NEXT
ENDIF