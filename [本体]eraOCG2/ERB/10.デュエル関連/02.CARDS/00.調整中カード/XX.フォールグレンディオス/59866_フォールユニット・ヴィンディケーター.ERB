@CARDNAME_59866,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = “Ɽꓤ”유닛 “VindicatoⱤꓤ”
	CASE "略称"
		RESULTS = ControlleⱤꓤ
	CASE "カテゴリ"
		RESULTS:0 = Ɽꓤ
		RESULTS:1 = E.R.A
ENDSELECT

@CARD_59866(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 초차원
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 미확인족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 2500
	CASE "성별"
		RETURN 無性
ENDSELECT
RETURN 0

