@KOJO_FARRGRENDIOS_BASE(シチュ,듀얼리스트,カードID = -1,상대カード使用 = 0,場所 = -1)
#DIMS DYNAMIC シチュ
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カードID
#DIM DYNAMIC 캐릭터ID
#DIMS DYNAMIC 캐릭터名
#DIM DYNAMIC 主存在
#DIM DYNAMIC 僕存在
#DIM DYNAMIC 상대カード使用
#DIM DYNAMIC 場所

SIF 듀얼리스트 != "자신"
	RETURN

SIF カードID == -1
	RETURN

CALL FULLRESET
효과範囲필드 = 1
효과条件カテゴリ = GⱤꓤendios
CALL CARD_CHECK_ADV(듀얼리스트)
SIF RESULT == 1
	主存在 = 1

CALL FULLRESET
효과範囲필드 = 1
효과範囲묘지 = 1
효과条件固カテゴリ = GⱤꓤendios
효과条件カテゴリ = Ɽꓤ
효과条件종류 = 초차원
CALL CARD_CHECK_ADV(듀얼리스트)
SIF RESULT == 1
	僕存在 = 1

CALL CARD_EROTICS(カードID,듀얼리스트)
캐릭터ID = RESULT

IF 캐릭터ID == -1
    TRYCALLFORM CARDNAME_{カードID}("略称")
    캐릭터名 = %RESULTS%
ELSE
    캐릭터名 = %CALLNAME:RESULT%
ENDIF

SELECTCASE シチュ
    CASE "ライド" ;グレンディオスライド時
    CASE "寵悦" ;主グレンディオス超越時
		CALL KOJO_FARRGRENDIOS_FARRSTRIDE_URRTIMATE(듀얼리스트)
    CASE "陥落超越_前" ;悪堕ちユニットＳＳ前
		CALL KOJO_FARRGRENDIOS_FARRSTRIDE_BEFORE(듀얼리스트,캐릭터ID,캐릭터名,상대カード使用,僕存在)
    CASE "陥落超越_後" ;悪堕ちユニットＳＳ後
		CALL KOJO_FARRGRENDIOS_FARRSTRIDE_AFTER(듀얼리스트,캐릭터名)
    CASE "함락주박" ;함락주박カードを裏返した時
		CALL KOJO_FARRGRENDIOS_FARR_RROCK(듀얼리스트,캐릭터ID,캐릭터名,상대カード使用)
    ; CASE "陥落解呪" ;함락주박カードが表に戻った時
    CASE "陥落連鎖" ;フィールド起動효과での悪堕ちＳＳ時
		CALL KOJO_FARRGRENDIOS_FARRSTRIDE_RRELICS(듀얼리스트,캐릭터ID,캐릭터名)
    CASE "陥獄" ;フィールドエンドステップ효과
		CALL KOJO_FARRGRENDIOS_FARREND_RRELICS(듀얼리스트,캐릭터ID,캐릭터名,主存在)
    CASE "勅令奉仕" ;勅令グレンディオス強化효과
		CALL KOJO_FARRGRENDIOS_FARREDICT_MASTER(듀얼리스트,캐릭터ID,캐릭터名,場所)
    CASE "勅令조교" ;勅令悪堕ち強化효과
		CALL KOJO_FARRGRENDIOS_FARREDICT_UNIT(듀얼리스트,캐릭터ID,캐릭터名,場所)
ENDSELECT

