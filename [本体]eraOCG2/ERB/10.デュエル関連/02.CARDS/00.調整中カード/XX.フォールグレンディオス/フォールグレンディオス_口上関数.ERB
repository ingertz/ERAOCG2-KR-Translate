	ENDIF
ELSE
	PRINTFORMW 拘束から逃れることもできない%캐릭터名%はなされるがままにエナジーを生産し続けている……
ENDIF

@KOJO_FARRGRENDIOS_FARRSTRIDE_RRELICS(듀얼리스트,캐릭터ID,캐릭터名)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 캐릭터ID
#DIMS DYNAMIC 캐릭터名
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 候補ユニット,5
#DIM DYNAMIC 選択ユニット
#DIM DYNAMIC 조교캐릭터ID
#DIMS DYNAMIC 조교캐릭터名

VARSET 候補ユニット,-1
FOR カウンタ, 0, 5
	CALL CAT_CHECK("Ɽꓤ",듀얼리스트,カウンタ)
	SIF RESULT != 1
		CONTINUE
	CALL CAT_CHECK("GⱤꓤendios",듀얼리스트,カウンタ)
	SIF RESULT == 1
		CONTINUE
	TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_필드:カウンタ")}("종류")
	SIF RESULT != 초차원
		CONTINUE
	候補ユニット = カウンタ
	カウンタB++
NEXT

SIF カウンタB == 0
	RETURN

選択ユニット = 候補ユニット:(RAND:カウンタB)

CALL CARD_EROTICS_FIELD(듀얼리스트,"필드",選択ユニット)
조교캐릭터ID = RESULT

IF 조교캐릭터ID == -1
    TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_필드:選択ユニット")}("略称")
    조교캐릭터名 = %RESULTS%
ELSE
    조교캐릭터名 = %CALLNAME:RESULT%
ENDIF

PRINTFORML %CALLNAME:MASTER%がカードを마법＆함정ゾーンに置くと、%캐릭터名%の姿がフィールドに現れ──
PRINTFORMW ──と同時に%캐릭터名%は黒い輪の形のエネルギーに手足を拘束され、大の字で中空に固定される！
PRINTL
PRINTFORMW そうして身動きの取れない%캐릭터名%の前に、%조교캐릭터名%“Ɽꓤ”が現れる……
PRINTFORML その異様な姿と表情に短く声を上げた%캐릭터名%に構うことなく、
PRINTFORMW %조교캐릭터名%は全身に黒いオーラを纏わせると、%캐릭터名%の全身を애무しはじめた……！
PRINTL
PRINTFORML %조교캐릭터名%は巧みな手練手管で%캐릭터名%の身体を弄びながら、主の素晴らしさを滔々と諭していく……
PRINTFORML その囁きが耳朶を震す度に、唇を重ねる度に、乳首を爪が掠る度に、女陰を弄られる度に、
PRINTFORMW %캐릭터名%の心を昏いエネルギーが蝕んでゆく……！
IF 캐릭터ID != -1
	IF 조교캐릭터ID != -1
    	CALL EROTIC_MOVE("全身애무",캐릭터ID,조교캐릭터ID,100)
	ELSE
    	CALL EROTIC_MOVE("全身애무",캐릭터ID,,100)
	ENDIF
ENDIF
PRINTFORML やがて視点を定めることもできず、%캐릭터名%が四肢の拘束に体重を預けるしかなくなった頃、
PRINTFORMW %조교캐릭터名%はようやく%캐릭터名%から離れ、巨大な黒輪を出現させると、%캐릭터名%を通していく……
PRINTL
PRINTFORMW 完全に通過し終えた黒輪を眼前に이동させ、%조교캐릭터名%が徐に両手を広げると──
PRINTFORMW 甲高い悲鳴のような音と共に黒輪が砕け散り、その中心から%캐릭터名%の姿をしたⱤꓤユニットが現れた！

@KOJO_FARRGRENDIOS_FARREND_RRELICS(듀얼리스트,캐릭터ID,캐릭터名,主存在)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 캐릭터ID
#DIMS DYNAMIC 캐릭터名
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC カウンタC
#DIM DYNAMIC 選択INDEX
#DIM DYNAMIC 候補行為数
#DIM DYNAMIC 候補ユニット数,2 ;0次元が可変、1次元が보존
#DIMS DYNAMIC 候補行為,20
#DIM DYNAMIC 候補ユニット,5
#DIM DYNAMIC 主存在
#DIM DYNAMIC 選択ユニット,5
#DIM DYNAMIC 選択캐릭터名,5
#DIMS DYNAMIC 選択行為,5 ;選択ユニットと選択行為は同一INDEX同士で結合
#DIM DYNAMIC 자위描写済INDEX,5 ;자위は連続したINDEXに格納されない場合があるので보존
#DIM DYNAMIC 촉수描写済INDEX,5 ;촉수は連続したINDEXに格納されない場合があるので보존
#DIM DYNAMIC 애무描写済INDEX,5 ;애무は連続したINDEXに格納されない場合があるので보존
#DIM DYNAMIC スキップ変数 ;FOR内のスキップに使用

FOR カウンタ, 0, 5
	CALL CAT_CHECK("Ɽꓤ",듀얼리스트,カウンタ)
	SIF RESULT != 1
		CONTINUE
	CALL CAT_CHECK("GⱤꓤendios",듀얼리스트,カウンタ)
	SIF RESULT == 1
		CONTINUE
	TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_필드:カウンタ")}("종류")
	SIF RESULT != 초차원
		CONTINUE
	候補ユニット:(候補ユニット数:0) = カウンタ
	候補ユニット数:0++
NEXT

SIF 候補ユニット数:0 == 0
	RETURN

候補ユニット数:1 = 候補ユニット数:0

DO
	カウンタ++
	SIF カウンタ > 10
		BREAK
	VARSET 候補行為
	VARSET 候補行為数
	候補行為:候補行為数 = 자위
	候補行為数++
	IF 候補ユニット数:0 > 1 && MATCH(選択行為,"레즈") == 0
		候補行為:候補行為数 = 레즈
		候補行為数++
	ENDIF
	IF 主存在 > 0
		候補行為:候補行為数 = 촉수
		候補行為数++
		IF MATCH(選択行為,"키스") == 0
			候補行為:候補行為数 = 키스
			候補行為数++
		ENDIF
		IF MATCH(選択行為,"애무") < 2
			候補行為:候補行為数 = 애무
			候補行為数++
		ENDIF
		IF MATCH(選択行為,"펠라") == 0 && MATCH(選択行為,"파이즈리") == 0
			候補行為:候補行為数 = 펠라
			候補行為数++
		ENDIF
		IF HAS_PENIS(MASTER) && MATCH(選択行為,"펠라") == 0 && MATCH(選択行為,"파이즈리") == 0
			候補行為:候補行為数 = 파이즈리
			候補行為数++
		ENDIF
	ENDIF

	SELECTCASE 選択行為:(カウンタB)
		CASE "레즈" ;레즈は相方を決定
			REPEAT 2
				選択行為:カウンタB = 레즈
				選択INDEX = RAND:(候補ユニット数:0)
				選択ユニット:カウンタB = 候補ユニット:選択INDEX
				ARRAYREMOVE 候補ユニット,選択INDEX,1
				候補ユニット数:0--
				カウンタB++
			REND
		CASE "펠라" ;펠라なら35%でダブル、15%でトリプル(人数がトリプルに足りないならダブルに置換)
			IF 候補ユニット数:0 > 1 && HAS_PENIS(MASTER)
				SELECTCASE RAND:100
					CASE IS < 50
						カウンタC = 1
					CASE IS < 85
						カウンタC = 2
					CASEELSE
						IF 候補ユニット数:0 > 2
							カウンタC = 3
						ELSE
							カウンタC = 2
						ENDIF
				ENDSELECT
			ENDIF
			REPEAT カウンタC
				選択行為:カウンタB = 펠라
				選択INDEX = RAND:(候補ユニット数:0)
				選択ユニット:カウンタB = 候補ユニット:選択INDEX
				ARRAYREMOVE 候補ユニット,選択INDEX,1
				候補ユニット数:0--
				カウンタB++
			REND
		CASE "파이즈리" ;50%でダブル
			IF 候補ユニット数:0 > 1 && HAS_PENIS(MASTER)
				SELECTCASE RAND:2
					CASE 0
						カウンタC = 1
					CASEELSE
						カウンタC = 2
				ENDSELECT
			ENDIF
			REPEAT カウンタC
				選択行為:カウンタB = 파이즈리
				選択INDEX = RAND:(候補ユニット数:0)
				選択ユニット:カウンタB = 候補ユニット:選択INDEX
				ARRAYREMOVE 候補ユニット,選択INDEX,1
				候補ユニット数:0--
				カウンタB++
			REND
		CASEELSE
			選択INDEX = RAND:(候補ユニット数:0)
			選択ユニット:カウンタB = 候補ユニット:選択INDEX
			ARRAYREMOVE 候補ユニット,選択INDEX,1
			候補ユニット数:0--
			選択行為:カウンタB = %候補行為:(RAND:候補行為数)%
			カウンタB++
	ENDSELECT
LOOP 候補ユニット数:0 > 0

PRINTW テスト2

VARSET 자위描写済INDEX,-1
VARSET 촉수描写済INDEX,-1
VARSET 애무描写済INDEX,-1
PRINTFORMW 陥落の力に囚われた犠牲者の嬌声が木霊する牢獄、その中でⱤꓤユニット\@ 候補ユニット数:1 > 1 ? たち # \@は各々の方法で主の為に身を捧げている……
FOR カウンタ, 0, 候補ユニット数:1
	VARSET カウンタC
	IF スキップ変数 > 0
		スキップ変数--
		CONTINUE
	ENDIF
	SIF MATCH(자위描写済INDEX,カウンタ) > 0 || MATCH(촉수描写済INDEX,カウンタ) > 0 || MATCH(애무描写済INDEX,カウンタ) > 0
		CONTINUE
	SELECTCASE 選択行為:カウンタ
		CASE "자위"
			자위描写済INDEX:カウンタC = カウンタ
			カウンタC++
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%
			;자위をまとめて描写
			FOR カウンタB, 0, 候補ユニット数:1
				SIF カウンタB == カウンタ
					CONTINUE
				SIF 選択行為:カウンタB != "자위"
					CONTINUE
				CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタB)
				PRINTFORM 、%RESULTS%
				자위描写済INDEX:カウンタC = カウンタB
				カウンタC++
			NEXT
			PRINTFORM は、
			IF 主存在 != 0
				PRINTFORM %CALLNAME:MASTER%の命令に従い
			ELSE
				PRINTFORM 不在の主を想いながら
			ENDIF
			PRINTFORM 自らの肉体を慰めている……
		CASE "레즈"
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%、
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%は
			IF 主存在 != 0
				PRINTFORM %CALLNAME:MASTER%の命令に従い
			ELSE
				PRINTFORM 不在の主を想いながら
			ENDIF
			PRINTFORM 互いに身体を慰めあっている……
			スキップ変数 = 1
		CASE "촉수"
			촉수描写済INDEX:カウンタC = カウンタ
			カウンタC++
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%
			;촉수をまとめて描写
			FOR カウンタB, 0, 候補ユニット数:1
				SIF カウンタB == カウンタ
					CONTINUE
				SIF 選択行為:カウンタB != "촉수"
					CONTINUE
				CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタB)
				PRINTFORM 、%RESULTS%
				촉수描写済INDEX:カウンタC = カウンタB
				カウンタC++
			NEXT
			PRINTFORM は、%CALLNAME:MASTER%から伸びる機械アームに嬲られる快楽を享受している……
		CASE "키스"
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%は%CALLNAME:MASTER%と舌を絡ませながら接吻奉仕を行っている……
		CASE "애무"
			애무描写済INDEX:カウンタC = カウンタ
			カウンタC++
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%
			;애무をまとめて描写
			FOR カウンタB, 0, 候補ユニット数:1
				SIF カウンタB == カウンタ
					CONTINUE
				SIF 選択行為:カウンタB != "애무"
					CONTINUE
				CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタB)
				PRINTFORM 、%RESULTS%
				애무描写済INDEX:カウンタC = カウンタB
				カウンタC++
			NEXT
			PRINTFORM は、%CALLNAME:MASTER%の\@ カウンタC == 2 ? 각각 の # \@手にその身を弄ばれながら甘い声を上げている……
		CASE "펠라"
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%
			REPEAT 2
				カウンタC++
				SIF カウンタ + カウンタC >= 5 || 選択行為:(カウンタ + カウンタC) != "펠라"
					BREAK
				CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:(カウンタ + カウンタC))
				PRINTFORM 、%RESULTS%
				スキップ変数 = カウンタC
			REND
			PRINTFORM は、
			IF HAS_PENIS(MASTER)
				PRINTFORM %CALLNAME:MASTER%の
				IF スキップ変数 > 0
					PRINTFORM ペニスを取り囲み、余すことなく舐めしゃぶっている……
				ELSE
					PRINTFORM の股間に顔を埋めながらそのペニスを丹念に舐めしゃぶっている……
				ENDIF
			ELSE
				PRINTFORM の股間に顔を埋めながらその秘唇の雫を丁寧に舐めとっている……
			ENDIF
		CASE "파이즈리"
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%
			REPEAT 1
				SIF カウンタ + 1 >= 5 || 選択行為:(カウンタ + 1) != "파이즈리"
					BREAK
				CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:(カウンタ + 1))
				PRINTFORM 、%RESULTS%
				スキップ変数 = 1
			REND
			PRINTFORM は、%CALLNAME:MASTER%
			IF スキップ変数 > 0
				PRINTFORM のペニスを左右から挟みこみ、息の合った動作で主を愉しませている……
			ELSE
				CALL CARD_EROTICS_FIELD(듀얼리스트,"필드",選択ユニット:カウンタ)
				IF RESULT != -1
					SELECTCASE TALENT:RESULT:가슴사이즈
						CASE IS >= 2 ;爆乳以上
							PRINTFORM のペニスを自らの乳肉で包み込み、献身的に奉仕している……
						CASE IS >= 0 ;普乳以上
							PRINTFORM のペニスを自らの가슴に挟み込み、献身的に奉仕している……
						CASEELSE ;貧乳以下
							PRINTFORM のペニスに自らの가슴を擦り付け、献身的に奉仕している……
					ENDSELECT
				ELSE
					PRINTFORM のペニスを自らの가슴に挟み込み、献身的に奉仕している……
				ENDIF
			ENDIF
	ENDSELECT
	PRINTL
NEXT
PRINTFORMW Ɽꓤユニットたちの甘い\@ 候補ユニット数:1 > 1 ? 合唱 # 声\@が、それに伴う肉欲の高まりが、牢獄内の空気をより煌々と朱くしていく……！
