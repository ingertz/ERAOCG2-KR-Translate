@CARDNAME_39895,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 폴스타베이더 “WoⱤꓤdline” 드라코
	CASE "略称"
		RESULTS = WoⱤꓤdline드라코
	CASE "カテゴリ"
		RESULTS:0 = Ɽꓤ
		RESULTS:1 = E.R.A
ENDSELECT

@CARD_39895(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 無性
ENDSELECT
RETURN 0

@CARD_EXPLANATION_39895(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,손패起動,묘지起動)
PRINTL ①：자신 메인 페이즈에 발동할 수 있다。
PRINTL 패 / 묘지의 이 카드를 특수 소환한다。
PRINTL 이 효과를 발동한 턴、자신은 "Ɽꓤ" 몬스터 이외의 몬스터를 특수 소환할 수 없다。
CALL CARD_ABLE(2,필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지,X素材時효과)
PRINTL ②：이 카드가 묘지로 보내진 경우、또는 Ｘ소환의 소재가 된 경우에 발동할 수 있다。
PRINTL 덱 위에서 카드를 ５장 뒤집어、그 안에서 "Ɽꓤ" 카드 １장을 패에 넣는다。

@CARDCAN_39895(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,39895)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動 || 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,39895)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,39895,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과条件固カテゴリ = Ɽꓤ
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"SS이력")
	SIF RESULT != 0
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지 || 종류 == X素材時효과
	SIF 발동済_2(듀얼리스트,39895)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 5
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_39895(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

#DIM DYNAMIC 選択カードID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 손패起動 || 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39895,1)
	IF RESULT == 0
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
		CALL CARD_EX_RESTRICTION(듀얼리스트,"Ɽꓤ")
	ENDIF
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지 || 종류 == X素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39895,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件カテゴリ = Ɽꓤ
		CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所,5)
	ENDIF
ENDIF