@CARDNAME_85530,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = -이변- 거짓된 달
	CASE "略称"
		RESULTS = 거짓된 달
	CASE "カテゴリ"
		RESULTS:0 = 영원정
		RESULTS:1 = 이변
	CASE "出典作品"
		RESULTS:0 = 동방 Project
ENDSELECT


@CARD_85530(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "종류"
		RETURN 지속함정
	CASE "추가日"
		RETURN 251120
ENDSELECT

RETURN 0

@CARD_EXPLANATION_85530(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 카드는 １턴에 １번밖에 사용할 수 없고、③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：자신 필드에 "영원정" 몬스터가 존재하는 경우、
PRINTL 이 카드의 발동 처리로서、덱에서 "-이변- 끝나지않는 밤"을 필드에 세트한다。
CALLFORM CARD_ABLE(0,효과後誘発)
PRINTL ②：필드의 몬스터는 그 카드를 대상 / 선택되지 않은 효과를 받지 않는다。
CALLFORM CARD_ABLE(1,ターン終了時強制)
PRINTL ③：상대 엔드 페이즈시에 "달의 두뇌 에이린"이 존재하지 않는 경우、강제로 발동한다。
PRINTL 이 카드를 파괴하고、덱에서 이 카드명 이외의 "이변" 카드 1장과 그 카테고리의 레벨 4 이하 몬스터 1장을 패에 넣는다。


@CARDCAN_85530(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,85530)
SIF RESULT == 1
	RETURN 0


IF 종류 == 마함起動  || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,72400)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ELSEIF 종류 == ターン終了時強制
	SIF 발동済_3(듀얼리스트,85530)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件名前 = 달의 두뇌 에이린
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_85530(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 속성数
#DIMS DYNAMIC 설정カテゴリ

IF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,85530,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件종류 = モン全般
		효과条件カテゴリ = 영원정
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件名前 = -이변- 끝나지않는 밤
			CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"裏側표시")	
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"無差耐")
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"無差耐")
ELSEIF 종류 == ターン終了時強制
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,85530,3)
	IF RESULT == 0	
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,破壊行き)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 이변
			효과条件固名前 = -이변- 거짓된 달
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				選択カード_ID = RESULT:1
				CALLFORM CARDNAME_{選択カード_ID}("カテゴリ")
				설정カテゴリ = %RESULTS%

				CALL FULLRESET
				효과範囲덱 = 1
				효과条件カテゴリ = %설정カテゴリ%
				CALLFORM 효과条件レベル_ADV(4,"以下")
				CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
		ENDIF
	ENDIF
ENDIF

