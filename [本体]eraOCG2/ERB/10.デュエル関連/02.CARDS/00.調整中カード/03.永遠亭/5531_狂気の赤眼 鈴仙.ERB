@CARDNAME_205531,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 파부 적안최면（마인드 셰이커）
	CASE "略称"
		RESULTS = 파부 적안최면
	CASE "カテゴリ"
		RESULTS:0 = 스펠 카드
ENDSELECT


@CARD_205531(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 速攻마법
	CASE "トークン"
		RETURN 1
ENDSELECT

RETURN 0

@CARD_EXPLANATION_205531(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(10,마함起動 ,손패起動,フリー誘発)
PRINTL ①：자신 필드의 카드 １장은 턴 종료시까지 대상 내성을 얻는다。
PRINTL 자신 필드의 "광기의 붉은 눈 레이센"이 파괴어있는 경우、
PRINTL 자신 묘지에서 "광기의 붉은 눈 레이센"을 특수 소환하고, 이 카드는 "라스트 워드"가 된다。
CALL TEXT_DECORATION("LASTWORD")
PRINTL ●상대 필드의 모든 몬스터는 공격할 수 없으며, 턴 종료 시 파괴된다。


@CARDCAN_205531(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,205531)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,205531)
		RETURN 0
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_205531(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC ダメージ量

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,205531,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		
		CALL FULLRESET
		효과条件名前 = 광기의 붉은 눈 레이센
		CALL CARD_CHECK_FIN_DATA(듀얼리스트,"破壊全般")
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件名前 = 광기의 붉은 눈 레이센
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)

			CALLFORM CHARA_CUTIN("Last Word","환　롱　월　예","Luntic Red Eyes",,,,1)

			CALL FULLRESET
			효과範囲상대필드 = 1
			효과추가종류 = 97
			CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"戦無")
		ELSE			
			CALLFORM CHARA_CUTIN("Spell Card","「파부」적안최면（마인드 셰이커）",,,,,1)
		ENDIF
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		CALL CARD_GRANT_ADV(듀얼리스트,ゾーン,場所,"対耐",1)
	ENDIF
ENDIF
