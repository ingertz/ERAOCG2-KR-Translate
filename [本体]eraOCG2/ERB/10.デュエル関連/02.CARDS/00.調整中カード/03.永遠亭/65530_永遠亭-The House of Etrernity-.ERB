@CARDNAME_65530,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 영원정-The House of Etrernity-
	CASE "略称"
		RESULTS = 『영원정』
	CASE "カテゴリ"
		RESULTS:0 = 영원정
	CASE "出典作品"
		RESULTS:0 = 동방 Project
ENDSELECT


@CARD_65530(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "종류"
		RETURN フィールド
	CASE "生成カード"
		RETURN 165530
	CASE "추가日"
		RETURN 251120
ENDSELECT

RETURN 0

@CARD_EXPLANATION_65530(종류)
#DIM DYNAMIC 종류

PRINTL 자신 필드는 "영원정"이 된다。
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動)
PRINTL ①：자신 메인 페이즈 １에 발동할 수 있다。
PRINTL 덱에서 "영원정" 몬스터 １장을 패에 넣는다。
PRINTL 이 효과의 발동 후、이 턴 자신은 배틀 페이즈를 이행할 수 없다。

CALLFORM CARD_ABLE(2,지속효과)
PRINTL ②：지속인 카드가 자신 몬스터 존에 존재하는 한、이 카드는 파괴 내성을 갖는다。
PRINTL （지속인 카드는 지속 마법 / 지속 함정 / P 몬스터를 가리킨다）
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：자신 필드에 "영원과 수유의 죄인 카구야"가 존재하는 경우에 강제로 발동한다。
PRINTL 이 카드에 연구 카운터를 １개 놓는다。
PRINTL 이렇게 ３개째 카운터가 놓인 경우、자신의 패에 "봉래의 약"을 １장 넣는다。



@CARDCAN_65530(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 효과使用불가,3
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,65530)
SIF RESULT == 1
	RETURN 0


IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 발동済_1(듀얼리스트,65530)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 영원정
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과 || 종류 == 攻守変動
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 영원정
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン開始時強制
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件名前 = 영원과 수유의 죄인 카구야
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_汎数:場所") >= 3
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_65530(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 효과使用불가,3




IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,65530,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 영원정
		효과条件종류 = モン全般
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		CALL SET_PLAYER_INFO(듀얼리스트,"バトルスキップ", 1)
	ENDIF
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,65530)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF

ELSEIF 종류 == 지속효과
	CALL SET_FIELD_MAGIC_INFO(듀얼리스트, "영원정")
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"魔自身",場所,"破耐")
ELSEIF 종류 == ターン開始時強制
	SETVAR @"%듀얼리스트%_MZ_汎数:場所", GETVAR(@"%듀얼리스트%_MZ_汎数:場所") + 1
	IF GETVAR(@"%듀얼리스트%_MZ_汎数:場所") >= 3
		CALL CARD_GENERATE_HAND(듀얼리스트,165530)
	ENDIF
ENDIF

