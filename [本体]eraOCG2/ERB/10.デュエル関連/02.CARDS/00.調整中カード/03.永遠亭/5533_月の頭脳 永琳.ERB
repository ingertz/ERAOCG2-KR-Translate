@CARDNAME_5533,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 달의 두뇌 에이린
	CASE "略称"
		RESULTS = 야고코로 에이린
	CASE "カテゴリ"
		RESULTS:0 = 영원정
		RESULTS:1 = 환상소녀
		RESULTS:2 = 월인
	CASE "出典作品"
		RESULTS:0 = 동방 Project
ENDSELECT


@CARD_5533(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 미확인족
	CASE "分割"
		RETURN 펜듈럼
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 2800
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251119
ENDSELECT

RETURN 0

@CARD_EXPLANATION_5533(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②のP효과は각각 １턴에 １번밖에 사용할 수 없다。
CALL TEXT_DECORATION("P_MAGIC")
CALLFORM CARD_ABLE(P1,손패起動)
PRINTL ①：이 카드의 발동 처리로서、패를 １장 제외하고 덱에서 "영원정" 마법 / 함정 카드를 １장 세트한다。
PRINTL 이 효과로 세트한 카드는 세트한 턴에도 발동할 수 있다。
CALLFORM CARD_ABLE(P2,발동誘発)
PRINTL ②：이 카드가 마법＆함정 존에 존재하고、
PRINTL 필드의 이 카드명 이외의 카드의 효과를 발동했을 때에 발동할 수 있다。
PRINTL 이 카드를 마법＆함정 존에서 특수 소환한다。
CALL TEXT_DECORATION("P_MAGIC_2")
PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,발동誘発)
PRINTL ①：이 카드가 몬스터 존에 존재하고、
PRINTL 필드의 이 카드명 이외의 카드의 효과를 발동했을 때에 발동할 수 있다。
PRINTL 이 카드 이외의 상대 필드의 카드 １장을 파괴한다





@CARDCAN_5533(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,5533)
SIF RESULT == 1
	RETURN 0
IF 종류 == 손패起動
	SIF 발동済_P1(듀얼리스트,5533)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 영원정
	효과条件종류 = 마함全般
	효과条件セット = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発

	IF ゾーン == "마함"
		SIF 발동済_P2(듀얼리스트,52562)
			RETURN 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과条件固名前 = 달의 두뇌 에이린
		CALL CARD_CHECK_START_DATA(듀얼리스트,2)
		SIF RESULT != 1
			RETURN 0
		CALL CARD_SS_CHECK(듀얼리스트,5533,ゾーン)
		SIF RESULT == 1
			RETURN 0
	ELSEIF ゾーン == "필드"
		SIF 발동済_1(듀얼리스트,52562)
			RETURN 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과条件固名前 = 달의 두뇌 에이린
		CALL CARD_CHECK_START_DATA(듀얼리스트,2)
		SIF RESULT != 1
			RETURN 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과条件除去種 = 묘지
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ELSE
		RETURN 0
	ENDIF
	RETURN 1
ENDIF

@CARDEFFECT_5533(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5533,P1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트, ゾーン, 場所, 마함行き)

		CALL FULLRESET	
		효과範囲손패 = 1
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 영원정
			효과条件종류 = 마함全般
			CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"使化裏側표시")
		ENDIF
	ENDIF
ELSEIF 종류 == 발동誘発
	IF ゾーン == "마함"
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5533,P2)
		IF RESULT == 0
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
		ENDIF
	ELSEIF ゾーン == "필드"
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5533,1)
		IF RESULT == 0
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과範囲상대마함 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
		ENDIF
	ENDIF
ENDIF

