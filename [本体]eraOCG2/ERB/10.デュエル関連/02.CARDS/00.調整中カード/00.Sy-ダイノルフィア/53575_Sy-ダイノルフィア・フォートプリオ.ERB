@CARDNAME_53575,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = Sy-다이놀피어 포트푸리오
	CASE "略称"
		RESULTS = Sy포트푸리오
	CASE "カテゴリ"
		RESULTS:0 = 다이놀피어
		RESULTS:1 = 게임 오리지널
ENDSELECT


@CARD_53575(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 비늘야수족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 3000
	CASE "튜너"
		RETURN 1
	CASE "추가日"
		RETURN 251227
ENDSELECT

RETURN 0

@CARD_EXPLANATION_53575(종류)
#DIM DYNAMIC 종류

PRINTL 비늘야수족 튜너 + 튜너 이외의 몬스터 １장 이상
PRINTL 이 카드명의 ①②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,발동誘発)
PRINTL ①：상대가 마법 카드의 효과를 발동했을 때에 발동할 수 있다。
PRINTL 자신의 제외 상태인 "다이놀피어" 카드를 １장 덱으로 되돌리고、그 효과를 무효로 한다。
CALL CARD_ABLE(2,필드起動 ,フリー誘発)
PRINTL ②：서로의 턴에、LP를 절반 지불하고 발동할 수 있다。
PRINTL 이 카드를 포함하는 자신 필드의 몬스터를 소재로 Ｓ소환을 한다。
CALL CARD_ABLE(3,破壊→묘지)
PRINTL ③：이 카드가 전투 / 효과로 파괴된 경우에 발동할 수 있다。
PRINTL 자신의 묘지에서 레벨４ 이하인 "다이놀피어" 몬스터 １장을 골라 특수 소환한다。



@CARDSUMMON_53575(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要レベル数 = 6

IF EX参照 == 0 || EX参照 == 1
	素材条件종족 = 비늘야수족
	素材条件튜너 = 1
ELSEIF EX参照 >= 10
	素材条件튜너 = 0
ENDIF



IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,53575) 
	RETURN RESULT
ENDIF



@CARDCAN_53575(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,53575)
SIF RESULT == 1
	RETURN 0


IF 종류 == 발동誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_1(듀얼리스트,53575)
		RETURN 0
	CALL FULLRESET
	효과条件종류 = 마법全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲제외 = 1
	효과条件カテゴリ = 다이놀피어
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_2(듀얼리스트,53575)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,0)
	SIF RESULT == 1
		RETURN 0
	CALL RESETAREA_MAT
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = 싱크로
	強制素材場所 = 지정場所(場所,ゾーン)
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 破壊→묘지
	SIF 발동済_3(듀얼리스트,53575)
		RETURN 0

	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 다이놀피어
	CALL 효과条件レベル_ADV(4, "以下")
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF




@CARDEFFECT_53575(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 攻撃力修正
#DIMS DYNAMIC 対面者
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,53575,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲제외 = 1
		효과条件カテゴリ = 다이놀피어
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,53575,2)
	IF RESULT == 0
		SIF GETVAR(@"%듀얼리스트%_ぺギア") <= 0
			CALL LIFE_CHANGE(듀얼리스트,"減少","コスト",(GETVAR(@"ライフ_%듀얼리스트%")  / 2))

		CALL RESETAREA_MAT
		CALL FULLRESET
		효과条件종류 = 싱크로
		強制素材場所 = 지정場所(場所,ゾーン)
		효과条件소환可 = 1
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			TRYCALLFORM CARDSUMMON_{GETVAR(@"%듀얼리스트%_EX덱:{選択カード}")}(듀얼리스트,選択カード)
			CALL SYNSUMMON(듀얼리스트,選択カード)
		ENDIF
	ENDIF
ELSEIF 종류 == 破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,53575,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 다이놀피어
		CALL 효과条件レベル_ADV(4, "以下")
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF



