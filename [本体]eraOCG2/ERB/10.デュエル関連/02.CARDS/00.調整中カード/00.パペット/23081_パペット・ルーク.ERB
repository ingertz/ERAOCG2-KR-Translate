@CARDNAME_23081,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 퍼핏 룩
	CASE "略称"
		RESULTS = 퍼핏 룩
	CASE "カテゴリ"
		RESULTS:0 = 퍼핏
ENDSELECT


@CARD_23081(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1200
	CASE "守備力"
		RETURN 1800
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN
ENDSELECT

RETURN 0


@CARD_EXPLANATION_23081(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：이 카드가 몬스터 존에 존재하는 한、
PRINTL 공격 가능한 몬스터는 이 카드를 공격해야만 한다。
CALLFORM CARD_ABLE(1,소환時,특수소환時)
PRINTL ②：이 카드가 소환 / 특수 소환에 성공한 경우에 발동할 수 있다。
PRINTL 덱에서 전사족 / 땅속성 몬스터 １장을 묘지로 보낸다。
CALLFORM CARD_ABLE(2,攻撃時誘発)
PRINTL ③：이 카드가 공격 대상으로 선택된 경우、
PRINTL 자신 묘지의 레벨５ 이상의 전사족 / 땅속성 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 필드의 이 카드를 묘지로 보내고、대상 몬스터를 특수 소환한다。
PRINTL 그 후、공격 대상을 그 몬스터로 옮긴다。


@CARDCAN_23081(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,23081)
SIF RESULT == 1
	RETURN 0
IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1

ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,23081)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = モン全般
	효과条件종족 = 전사족
	효과条件속성 = 땅속성
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1

ELSEIF 종류 == 攻撃時誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종류 = モン全般
	효과条件종족 = 전사족
	효과条件속성 = 땅속성
	CALL 효과条件レベル_ADV(5, "以上")
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ENDIF


@CARDEFFECT_23081(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"攻誘")
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"戦狂")

ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,23081,1)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종류 = モン全般
		효과条件종족 = 전사족
		효과条件속성 = 땅속성
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"덱",ゾーン,場所)
	ENDIF

ELSEIF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,23081,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종류 = モン全般
		효과条件종족 = 전사족
		효과条件속성 = 땅속성
		CALL 효과条件レベル_ADV(5, "以上")
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF GETVAR(@"%듀얼리스트%_필드:カード소환先") > 0
			CALL COVER_ATTACK(듀얼리스트,カード소환先)
			選択カード = 戦闘場所(듀얼리스트,1)
		ENDIF
	ENDIF

ENDIF
