@CARDNAME_23080,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 퍼핏 폰
	CASE "略称"
		RESULTS = 퍼핏 폰
	CASE "カテゴリ"
		RESULTS:0 = 퍼핏
ENDSELECT


@CARD_23080(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 800
	CASE "守備力"
		RETURN 1200
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN
ENDSELECT

RETURN 0


@CARD_EXPLANATION_23080(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,소환時強制,특수소환時強制)
PRINTL ①：이 카드는 소환 / 특수 소환된 턴의 배틀 페이즈중에 ２번 공격할 수 있다。
CALLFORM CARD_ABLE(1,소환時,특수소환時)
PRINTL ②：이 카드가 소환 / 특수 소환에 성공한 경우에 발동할 수 있다。
PRINTL 덱에서 "프로모션＆앙파상" １장을 패에 넣는다。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ③：묘지의 이 카드를 제외하고 발동할 수 있다。
PRINTL 덱에서 "퍼핏 폰" 이외의 전사족 / 땅속성 몬스터 １장을 패에 넣는다。
PRINTL 그 후、상대는 자신의 덱에서 몬스터 １장을 패에 넣을 수 있다。


@CARDCAN_23080(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,23080)
SIF RESULT == 1
	RETURN 0
IF 종류 == 소환時強制 || 종류 == 특수소환時強制
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1

ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,23080)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件名前 = 프로모션＆앙파상
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1

ELSEIF 종류 == 묘지起動
	SIF 발동済_2(듀얼리스트,23080)
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = モン全般
	효과条件종족 = 전사족
	효과条件속성 = 땅속성
	효과条件固名前 = 퍼핏 폰
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1

ENDIF


@CARDEFFECT_23080(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 소환時強制 || 종류 == 특수소환時強制
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦",2)

ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,23080,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件名前 = 프로모션＆앙파상
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,23080,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종류 = モン全般
		효과条件종족 = 전사족
		효과条件속성 = 땅속성
		효과条件固名前 = 퍼핏 폰
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
 		CALL FULLRESET
		효과範囲덱 = 1
        효과条件종류 = モン全般
		효과条件任意 = 1
		CALL CARD_ADD_BASIC(対面者,"덱",ゾーン,場所)
	ENDIF

ENDIF
