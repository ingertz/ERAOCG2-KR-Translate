@CARDNAME_58351,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 포이즌 인 파라다이스 에바
	CASE "略称"
		RESULTS = 포이즌 에바
	CASE "カテゴリ"
		RESULTS:0 = 에바
		RESULTS:1 = 황구자
		RESULTS:2 = 브랜트 게이트
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_58351(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 초차원
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 사이버스족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 牝性
	CASE "특수불가"
		RETURN 1
ENDSELECT

RETURN 0

@CARDSUMMON_58351(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要素材数 = 1
素材条件カテゴリ = 에바

IF EX参照 == 1
	CALL STRIDECAN(듀얼리스트,소환カード,58351) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_58351(종류)
#DIM DYNAMIC 종류

CALL PRINT_STRIDETEXT("에바")
PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(2,EX소환時)
PRINTL ①：このカードが『超越』した場合に발동できる。
PRINTL 덱・묘지から「에바」지속마법カード１枚を자신フィールドに表側표시で置く。
PRINTL その後、ＥＸ덱の「포이즌 인 파라다이스 에바」１体を제외することで、
PRINTL 자신は상대エンドフェイズまで以下の能力を得ることができる。（この효과は重複しない）
CALLFORM CARD_ABLE(4,効後紋章起動)
PRINTL ●１ターンに１度、자신フィールドに「옵스크데이트」モンスターが특수소환された場合に발동する。
PRINTL 상대フィールドのモンスター１体を選んで상대の마법＆함정ゾーンに表側표시で置く。
CALLFORM CARD_ABLE(3,필드起動)
PRINTL ②：자신メインフェイズ１に발동できる。
PRINTL 덱・손패・묘지から「옵스크데이트」モンスター１体を특수소환する。
CALL TEXT_DECORATION_GRITTER_V

@CARDCAN_58351(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,58351)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF 발동済_1(듀얼리스트,58351)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF ターン数 <= 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 에바
	CALL CARD_CHECK_ADV(듀얼리스트)
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_超越済") != 0
		RETURN 0
	SIF 듀얼리스트 != "상대"
		RETURN 0
	RETURN 1
ELSEIF 종류 == EX소환時
	SIF 발동済_2(듀얼리스트,58351)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 에바
	효과条件セット = 1
	CALL CARD_CHECK_ADV(듀얼리스트)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 발동済_3(듀얼리스트,58351)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF メインフェイズ２ == 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲손패 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 옵스크데이트
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 効後紋章起動
	SIF 발동済_4(듀얼리스트,58351)
		RETURN 0
	CALL FULLRESET
	효과条件カテゴリ = 옵스크데이트
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환")
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 마함数(対面者) >= 5
		RETURN 0
	RETURN 1
ELSEIF 종류 == 時限紋章起動
	SIF ターンプレイヤー != 対面者 || エンドフェイズ != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_58351(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC カウンタC
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 효과先
#DIM DYNAMIC モンスター数
#DIM DYNAMIC ダメージ量
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 選択カードID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,58351,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 에바
		효과条件종류 = 지속마법
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"表側표시")
		IF RESULT == 1
			IF 듀얼리스트 == "자신"
				SIF FINDELEMENT(자신_効後紋章,58351) != -1
					RETURN
			ELSE
				SIF FINDELEMENT(상대_効後紋章,58351) != -1
					RETURN
			ENDIF
			CALL FULLRESET
			효과範囲EX덱 = 1
			효과条件名前 = 포이즌 인 파라다이스 에바
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1 && GETVAR(@"%듀얼리스트%_제외NG置換") < 1
				PRINTL ＥＸ덱の「포이즌 인 파라다이스 에바」を제외して추가の能力を得ますか？
				CALL YN_CHOICE(듀얼리스트)
				IF RESULT == はい
					CALL FULLRESET
					효과範囲EX덱 = 1
					효과条件名前 = 포이즌 인 파라다이스 에바
					효과条件行先플래그 = 제외行き
					CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
					IF RESULT == 1
						PRINTFORMW 포이즌 인 파라다이스 에바の효과がセットされました。(상대ターン終了時に消えます)
						SETVAR @"%듀얼리스트%_時限紋章:%듀얼리스트%_時限紋章カウンタ", 58351
						SETVAR @"%듀얼리스트%_時限紋章カウンタ", GETVAR(@"%듀얼리스트%_時限紋章カウンタ") + 1
						SETVAR @"%듀얼리스트%_効後紋章:%듀얼리스트%_効後紋章カウンタ", 58351
						SETVAR @"%듀얼리스트%_効後紋章カウンタ", GETVAR(@"%듀얼리스트%_効後紋章カウンタ") + 1
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,58351,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲손패 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 옵스크데이트
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 効後紋章起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,58351,4)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,表側표시,1)
	ENDIF
ELSEIF 종류 == 時限紋章起動
	IF 듀얼리스트 == "자신"
		DO
			カウンタ = FINDELEMENT(자신_時限紋章,58351)
			ARRAYREMOVE 자신_時限紋章,カウンタ,1
			SETVAR @"%듀얼리스트%_時限紋章カウンタ", GETVAR(@"%듀얼리스트%_時限紋章カウンタ") - 1
		LOOP FINDELEMENT(자신_時限紋章,58351) != -1
		DO
			カウンタ = FINDELEMENT(자신_効後紋章,58351)
			ARRAYREMOVE 자신_効後紋章,カウンタ,1
			SETVAR @"%듀얼리스트%_効後紋章カウンタ", GETVAR(@"%듀얼리스트%_効後紋章カウンタ") - 1
		LOOP FINDELEMENT(자신_効後紋章,58351) != -1
	ELSE
		DO
			カウンタ = FINDELEMENT(상대_時限紋章,58351)
			ARRAYREMOVE 상대_時限紋章,カウンタ,1
			SETVAR @"%듀얼리스트%_時限紋章カウンタ", GETVAR(@"%듀얼리스트%_時限紋章カウンタ") - 1
		LOOP FINDELEMENT(상대_時限紋章,58351) != -1
		DO
			カウンタ = FINDELEMENT(상대_効後紋章,58351)
			ARRAYREMOVE 상대_効後紋章,カウンタ,1
			SETVAR @"%듀얼리스트%_効後紋章カウンタ", GETVAR(@"%듀얼리스트%_効後紋章カウンタ") - 1
		LOOP FINDELEMENT(상대_効後紋章,58351) != -1
	ENDIF

ENDIF



