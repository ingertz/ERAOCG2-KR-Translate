RETURN 1
;==================================================
;0,モンスター소환時
;==================================================
@M_KOJO_CARD_K2804_0(ARG,ARG:1)
#DIM DYNAMIC 호감도修正
#DIMS DYNAMIC カード名
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE RAND:3 + 1
		CASE 1
			PRINTFORMW 「자, 실험을 시작해 볼까요!」
		CASE 2
			PRINTFORMW 「에바 짱의 실험 시간이에요-!」
		CASE 3
			PRINTFORMW 「지식을, 지식을, 있는 대로 모든 지식을 나에게!」
	ENDSELECT
ENDIF

