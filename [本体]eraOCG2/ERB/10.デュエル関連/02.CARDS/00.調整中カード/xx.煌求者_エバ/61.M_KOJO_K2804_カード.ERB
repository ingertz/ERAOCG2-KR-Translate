		CASE 1
			; PRINTFORMW 
		CASEELSE
			; PRINTFORMW 
	ENDSELECT
ENDIF

;==================================================
;2,효과발동
;==================================================
;효과別で鳴らしたいなら、直接カードのデータを見て、설정する必要がある
;面倒、分からないであれば분기はせず
;失敗판정は、いわゆる효과를 無効にされたとかそういうやつ
@M_KOJO_CARD_K2804_2(종류,失敗판정)
#DIM DYNAMIC 호감도修正
#DIM DYNAMIC 종류
#DIM DYNAMIC 失敗판정
;-------------------------------------------------
;記入チェック（=0, 非표시、1, 표시）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF 失敗판정 == 0
		SELECTCASE 종류
			CASE 소환時,특수소환時
				SELECTCASE RAND:2 + 1
					CASE 1
						PRINTFORMW 「오늘의 실험 테마는~? 이거!」
					CASE 2
						PRINTFORMW 「아하, 오늘은 이걸 알고 싶어요!」
				ENDSELECT
			CASE 효과後誘発
				PRINTFORMW 「후흥, 내가 봐도 잘 만들었어요!」
		ENDSELECT
	ELSE
		PRINTFORMW 「어라라, 에바 짱 대위기」
	ENDIF
ENDIF

