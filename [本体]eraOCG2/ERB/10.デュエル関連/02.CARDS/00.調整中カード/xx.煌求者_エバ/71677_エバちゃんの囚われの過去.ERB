@CARDNAME_71677,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 에바쨩의 사로잡힌 과거
	CASE "略称"
		RESULTS = 사로잡힌 과거
	CASE "カテゴリ"
		RESULTS:0 = 에바
		RESULTS:1 = 브랜트 게이트
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_71677(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 지속마법
ENDSELECT

RETURN 0

@CARD_EXPLANATION_71677(종류)
#DIM DYNAMIC 종류
PRINTL このカード名のカードは１ターンに１枚しか발동できず、②③の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①：このカードの발동時の효과処理として、
PRINTL 덱・묘지から「옵스크데이트」モンスター１体を攻撃力・守備力を０にして특수소환することができる。
PRINTL 자신フィールドに「에바」ＥＸモンスターが存在する場合、代わりに攻撃力・守備力を０にせずに특수소환する。
PRINTL この효과を발동するターン、자신は「에바」モンスターしかＥＸ덱から특수소환できない。
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：자신フィールドにモンスターが특수소환された場合に、자신フィールドのモンスター１体を대상として발동できる。
PRINTL そのモンスターはエンドフェイズまで攻撃力が５００アップし、마법・함정耐性を得る。
CALLFORM CARD_ABLE(3,戦破壊→묘지)
PRINTL ③：このカードがフィールドから묘지に送られた場合に발동できる。
PRINTL 묘지のこのカード名以外の지속마법カードまたは「황구자」モンスター１枚を손패に加える。

@CARDCAN_71677(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,71677)
SIF RESULT == 1
	RETURN 0


IF 종류 == 戦破壊→묘지
	SIF 발동済_3(듀얼리스트,71677)
		RETURN 0
	SIF !GROUPMATCH(묘지送り종류,"破壊","リリース")
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件固名前 = 에바쨩의 사로잡힌 과거
	효과条件종류 = 지속마법
	효과条件スーパーカテゴリ = 황구자
	효과条件スーパー종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트,71677)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") > 1
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환")
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,71677)
		RETURN 0
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_71677(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71677,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件固名前 = 에바쨩의 사로잡힌 과거
		효과条件종류 = 지속마법
		효과条件スーパーカテゴリ = 황구자
		효과条件スーパー종류 = モン全般
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71677,2)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			CALL FULLRESET
			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"一攻",500)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"一守",500)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"魔耐",1,上書きモード)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"함정耐",1,上書きモード)
		ENDIF
	ENDIF
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71677,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 에바
		효과条件종류 = EXモン全般
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT != 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ = 옵스크데이트
			효과추가종류 = 効追攻守０
			효과条件任意 = 1
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ELSE
			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ = 옵스크데이트
			효과条件任意 = 1
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF