@CARDNAME_21266,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = Ｓｉｎ 트루스 드래곤
	CASE "略称"
		RESULTS = Ｓｉｎ트루스
	CASE "カテゴリ"
		RESULTS:0 = Ｓｉｎ
ENDSELECT


@CARD_21266(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 12
	CASE "攻撃力"
		RETURN 5000
	CASE "守備力"
		RETURN 5000
	CASE "소환불가"
		RETURN 1
	CASE "특수불가"
		RETURN 1
	CASE "単一存在"
		RETURN 1
ENDSELECT
RETURN 0

@CARD_EXPLANATION_21266(종류)
#DIM DYNAMIC 종류

PRINTL "Ｓｉｎ 트루스 드래곤"은 자신 필드에 １장밖에 앞면 표시로 존재할 수 없다。
PRINTL 이 카드는 일반 소환할 수 없으며、"Ｓｉｎ" 카드의 효과로만 특수 소환할 수 있다。
CALLFORM CARD_ABLE(0,효과後誘発)
PRINTL ①："Ｓｉｎ 트루스 드래곤" 이외의 자신 필드의 앞면 표시인 "Ｓｉｎ"몬스터가 전투 / 효과로 파괴된 경우、
PRINTL LP를 절반 지불하고 발동할 수 있다。이 카드를 패 / 묘지에서 특수 소환한다。
CALLFORM CARD_ABLE(0,攻撃後強制誘発)
PRINTL ②：자신의 "Ｓｉｎ" 몬스터가 전투로 상대 몬스터를 파괴한 경우에 발동한다。
PRINTL 상대 필드의 몬스터를 모두 파괴하고、파괴한 수×８００데미지를 상대에게 준다。
CALLFORM CARD_ABLE(0,身代효과)
PRINTL ③：필드의 이 카드가 전투 / 효과로 파괴될 경우、
PRINTL 대신에 자신 묘지의 "Ｓｉｎ" 몬스터 １장을 제외할 수 있다。
PRINTL ④：필드 마법이 앞면 표시로 존재하지 않는 경우、이 카드는 파괴된다。


@CARDCAN_21266(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,21266)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과後強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과範囲상대마함 = 1
	효과条件종류 = フィールド
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF !GROUPMATCH(ゾーン,"손패","묘지")
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,20405,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과条件カテゴリ = Ｓｉｎ
	효과条件固名前 = Ｓｉｎ 트루스 드래곤
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"破壊全般")
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃後強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	TRYCALLFORM CARDNAME_{戦闘カードID(듀얼리스트)}("カテゴリ")
	SIF !MATCH(RESULTS,"Ｓｉｎ")
		RETURN 0
	SIF 直前戦闘破壊ID(듀얼리스트,1) == 0
		RETURN 0
	RETURN 1
ELSEIF 종류 == 身代효과
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF 破壊대상ゾーン != "필드"
		RETURN 0
	SIF 破壊대상場所 != 場所
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = Ｓｉｎ
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_21266(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC ダメージ量

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 효과後強制誘発
	CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,破壊行き)
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,21266)
	IF RESULT == 0
		CALL LIFE_CHANGE(듀얼리스트,"減少","コスト",(GETVAR(@"ライフ_%듀얼리스트%")  / 2))
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 攻撃後強制誘発
	CALL FULLRESET
	효과추가종류 = 3
	CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드全体",場所,"묘지",800)
ELSEIF 종류 == 身代효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,21266)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = Ｓｉｎ
		효과条件종류 = モン全般
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		SIF RESULT == 1
			RETURN 1
	ENDIF
	RETURN 0
ENDIF


