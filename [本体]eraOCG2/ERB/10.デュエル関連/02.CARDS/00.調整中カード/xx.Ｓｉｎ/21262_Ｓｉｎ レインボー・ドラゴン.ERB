@CARDNAME_21262,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = Ｓｉｎ 레인보우 드래곤
	CASE "略称"
		RESULTS = Ｓｉｎ R D
	CASE "カテゴリ"
		RESULTS:0 = Ｓｉｎ
ENDSELECT


@CARD_21262(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
	
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 4000
	CASE "守備力"
		RETURN 0
	CASE "連動ID"
		RETURN 21038
	CASE "소환불가"
		RETURN 1
	CASE "특수불가"
		RETURN 1
	CASE "単一存在"
		RETURN 1
ENDSELECT

RETURN 0


@CARD_EXPLANATION_21262(종류)
#DIM DYNAMIC 종류

PRINTL 「Ｓｉｎ 레인보우 드래곤」は자신フィールドに１体しか表側표시で存在できない。
PRINTL このカードは通常소환できず、「Ｓｉｎ」カードの효과でのみ특수소환できる。
CALLFORM CARD_ABLE(0,손패起動)
PRINTL ①：손패・덱から「궁극보옥신 레인보우 드래곤」１体を묘지へ送って발동できる。
PRINTL このカードを손패から특수소환する。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ②：このカードの攻撃力は、자신のフィールド・묘지に存在する「Ｓｉｎ」モンスターカードの종류×１０００になる。（４０００より低くならない）
CALLFORM CARD_ABLE(0,필드起動,フリー誘発)
PRINTL ③：상대ターンに발동できる。
PRINTL 자신・상대のフィールドのカードを全て持ち主の덱に戻す。
PRINTL ④：フィールド마법が表側표시で存在しない場合、このカードは破壊される。

@CARDCAN_21262(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,21262)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과後強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과範囲상대마함 = 1
	효과条件종류 = フィールド
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 손패起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,21262,"손패")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과条件名前 = 궁극보옥신 레인보우 드래곤
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	IF 듀얼리스트 == "상대"
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT < 2
			RETURN 0
	ENDIF
	RETURN 1
ENDIF

@CARDEFFECT_21262(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 修正値

IF 종류 == 효과後強制誘発
	CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,破壊行き)
ELSEIF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,21262)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲덱 = 1
		효과条件名前 = 궁극보옥신 레인보우 드래곤
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트,"손패",場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 攻守変動
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲묘지 = 1
	효과条件종류 = モン全般
	효과条件カテゴリ = Ｓｉｎ
	효과条件固名前起動 = 1;CARDCHECK_ADV専用
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	修正値 = (RESULT * 1000) - 4000
	IF 修正値 > 0
		CALL FULLRESET
		CALL STATCHANGE_BASIC(듀얼리스트,"自身",場所,修正値)
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,21262)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲상대필드 = 1
		효과範囲마함 = 1
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"덱")
	ENDIF
ENDIF

