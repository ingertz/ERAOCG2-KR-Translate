@CARDNAME_39707,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 촉수궁의 마안
	CASE "略称"
		RESULTS = 촉수궁의 마안
	CASE "カテゴリ"
		RESULTS:0 = 촉수
		RESULTS:1 = E.R.A
ENDSELECT


@CARD_39707(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 雄性
ENDSELECT

RETURN 0

@CARD_EXPLANATION_39707(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL このカード名の①②③の효과は１ターンにそれぞれ１度しか使用できない。
CALLFORM CARD_ABLE(1,소환時,특수소환時)
PRINTL ①：このカードの소환・특수소환に成功した場合に발동できる。
PRINTL 덱から「촉수」速攻마법・함정カード１枚をフィールドにセットする。
PRINTL この효과でセットしたカードはセットしたターンでも발동できる。
CALL CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ②：자신・상대ターンに、상대フィールドの牝性モンスター１体を대상として발동できる。
PRINTL 자신の손패・フィールドのカード１枚を묘지へ送り、대상のモンスターのコントロールをターン終了時まで得る。
CALL CARD_ABLE(3,묘지起動)
PRINTL ③：このカードが묘지に存在する場合に발동できる。
PRINTL 자신の묘지から「촉수」마법・함정カード１枚を손패に加え、このカードを持ち主の덱に戻す。
CALL TEXT_DECORATION("ROGUE")

@CARDCAN_39707(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,39707)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,39707)
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_2(듀얼리스트,39707)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_表:場所") != 1
		RETURN 0

	CALL FULLRESET
	효과範囲상대필드 = 1
    효과条件성별 = 牝性
    효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

    CALL FULLRESET
    효과範囲손패 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		条件달성 ++

    CALL FULLRESET
    효과範囲필드 = 1
    효과範囲마함 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
    	条件달성 ++

    SIF 条件달성 == 0
    	RETURN 0
    RETURN 1

ELSEIF 종류 == 묘지起動
	SIF 발동済_3(듀얼리스트,39707)
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0

	CALL FULLRESET
	효과範囲묘지 = 1
    효과条件종류 = 마함全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
    	RETURN 0
     RETURN 1
ENDIF



@CARDEFFECT_39707(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 조교대상

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39707,1)
	IF RESULT == 0
    	CALL FULLRESET
        효과範囲덱 = 1
		효과条件종류 = 速攻마법
        효과条件スーパー종류 = 함정全般
        효과条件カテゴリ = 촉수
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"使化裏側표시")
    ENDIF

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39707,2)
	IF RESULT == 0
        효과範囲손패 = 1
        효과範囲필드 = 1
        효과範囲마함 = 1
        효과条件行先플래그 = 묘지行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
            CALL FULLRESET
            효과条件성별 = 牝性
            효과条件표시 = 表側표시
            CALL CARD_CHOOSE_BASIC(듀얼리스트,"상대필드",ゾーン,場所)
            選択カード = RESULT
            IF 選択カード != 9999
				조교대상 = GETVAR(@"%対面者%_필드:選択カード")
				
				CALL FULLRESET
		        효과추가종류 = 返却行き
                CALL CARD_REMOVAL_BASIC(듀얼리스트,"自動処理",選択カード,"強奪")

				CALL CARD_EROTICS(조교대상)
				IF RESULT != -1
					조교대상 = RESULT
					PRINTFORML 
					SETCOLOR C_P_PURPLE
					PRINTFORML "えっ,はい……"
					RESETCOLOR
					PRINTFORMW 戦闘の最中、%CALLNAME:조교대상%の目の前に紫色の光が現われた。好奇心から%CALLNAME:조교대상%が近寄って触れると、次に目を開けた時、%CALLNAME:조교대상%の瞳からは光が失われていた。
					SETCOLOR C_P_PURPLE
					PRINTFORML "私の体……、ご主人様……お好きに使ってください……"
					RESETCOLOR
					IF 듀얼리스트 == "자신"
						PRINTFORMW %CALLNAME:조교대상%はゆっくりと%CALLNAME:MASTER%の場へと歩み寄り、%CALLNAME:MASTER%を自らの主と見なして、その全身を捧げて%CALLNAME:MASTER%に奉仕し始めた。
					ELSEIF 듀얼리스트 == "상대"
						PRINTFORMW %CALLNAME:조교대상%はゆっくりと상대の場へと歩み寄り、상대デュエリストを自らの主と見なして、その全身を捧げて상대に奉仕し始めた。
					ENDIF
					CALL EROTIC_MOVE("최면自発자위",조교대상,-1,50)
				ENDIF
            ENDIF
        ENDIF
    ENDIF

ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39707,3)
	IF RESULT == 0
        효과範囲묘지 = 1
		효과条件종류 = 마함全般
		효과条件カテゴリ = 촉수
        효과条件行先플래그 = 손패行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		SIF RESULT == 1
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,덱行き)
	ENDIF
ENDIF