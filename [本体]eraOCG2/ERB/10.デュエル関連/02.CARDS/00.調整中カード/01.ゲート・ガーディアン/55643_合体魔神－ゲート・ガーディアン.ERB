@CARDNAME_55643,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 합체마신－게이트 가디언
	CASE "略称"
		RESULTS = 게이트 가디언
	CASE "カテゴリ"
		RESULTS:0 = 게이트 가디언
ENDSELECT


@CARD_55643(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 12
	CASE "攻撃力"
		RETURN 3750
	CASE "守備力"
		RETURN 3400
	CASE "특수불가"
		RETURN 1
	CASE "추가日"
		RETURN 251010
ENDSELECT

RETURN 0


@CARD_EXPLANATION_55643(종류)
#DIM DYNAMIC 종류

PRINTL 「번개 마신－썬가」＋「풍 마신－휴가」＋「수 마신－스가」
PRINTL このカードは융합소환でしか특수소환できない。
PRINTL 자신の손패・フィールド・묘지の上記のカードを素材として제외し、융합소환できる。
CALLFORM CARD_ABLE(1,발동誘発)
CALLFORM CARD_ABLE(2,발동誘発)
CALLFORM CARD_ABLE(3,발동誘発)
PRINTL ①：상대が효과を발동した時に발동できる。
PRINTL （このカード名のこの효과は마법・함정・モンスターの효과に対してそれぞれ１ターンに１度しか발동できない）
PRINTL その발동を無効にし破壊する。
CALLFORM CARD_ABLE(0,필드→戦離)
PRINTL ②：このカードがフィールドから離れた場合に발동できる。
PRINTL EX덱からレベル９の「게이트 가디언」モンスター１体を소환条件を無視して특수소환する。


@CARDSUMMON_55643(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材条件名前 = 풍 마신－휴가
ELSEIF EX参照 >= 10
	素材条件名前 = 수 마신－스가
ENDIF

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,55643) 
	RETURN RESULT
ENDIF


@CARDCAN_55643(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,55643)
SIF RESULT == 1
	RETURN 0


IF 종류 == EX덱起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,55643)
	SIF RESULT == 1
		RETURN 0
	CALL RESETAREA_MAT
	素材範囲손패 = 1
	素材範囲필드 = 1
	素材範囲마함 = 1
	素材範囲묘지 = 1
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件固定 = 場所
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	IF RESULT == 1
		SIF 발동済_1(듀얼리스트,55643)
			RETURN 0
		RETURN 1
	ENDIF
	CALL FULLRESET
	효과条件종류 = 마법全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	IF RESULT == 1
		SIF 발동済_2(듀얼리스트,55643)
			RETURN 0
		RETURN 1
	ENDIF
	CALL FULLRESET
	효과条件종류 = 함정全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	IF RESULT == 1
		SIF 발동済_3(듀얼리스트,55643)
			RETURN 0
		RETURN 1
	ENDIF
	RETURN 0
ELSEIF 종류 == 필드→戦離
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件レベル = 9
	효과条件カテゴリ = 게이트 가디언
	효과条件特不無視 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_55643(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件달성,2



IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55643)
	IF RESULT == 0
		CALL RESETAREA_MAT
		素材範囲손패 = 1
		素材範囲필드 = 1
		素材範囲마함 = 1
		素材範囲묘지 = 1
		CALL FULLRESET
		TRYCALLFORM CARDSUMMON_55643(듀얼리스트,場所)
		CALL FUSSUMMON(듀얼리스트,場所,제외行き)
	ENDIF
ELSEIF 종류 == 발동誘発
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1,2)
	IF RESULT == 1
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55643,1)
		IF RESULT == 0
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"묘지")
			RETURN 1
		ENDIF
		RETURN 0
	ENDIF

	CALL FULLRESET
	효과条件종류 = 마법全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1,2)
	IF RESULT == 1
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55643,2)
		IF RESULT == 0
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"묘지")
			RETURN 1
		ENDIF
		RETURN 0
	ENDIF

	CALL FULLRESET
	효과条件종류 = 함정全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1,2)
	IF RESULT == 1
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55643,3)
		IF RESULT == 0
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"묘지")
			RETURN 1
		ENDIF
		RETURN 0
	ENDIF
ELSEIF 종류 == 필드→戦離
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55643)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件レベル = 9
		효과条件カテゴリ = 게이트 가디언
		효과条件特不無視 = 1
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF


