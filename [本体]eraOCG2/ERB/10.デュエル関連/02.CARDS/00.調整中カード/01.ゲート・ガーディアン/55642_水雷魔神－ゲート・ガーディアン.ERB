@CARDNAME_55642,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 수번개 마신－게이트 가디언
	CASE "略称"
		RESULTS = 수번개 마신
	CASE "カテゴリ"
		RESULTS:0 = 게이트 가디언
ENDSELECT


@CARD_55642(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 2550
	CASE "守備力"
		RETURN 2300
	CASE "특수불가"
		RETURN 1
	CASE "추가日"
		RETURN 251010
ENDSELECT

RETURN 0


@CARD_EXPLANATION_55642(종류)
#DIM DYNAMIC 종류

PRINTL "수 마신－스가"＋"번개 마신－썬가"
PRINTL 이 카드는 융합 소환으로밖에 특수 소환할 수 없다。
PRINTL 자신 필드의 상기의 카드를 소재로 하고 제외하여、융합 소환할 수 있다。
PRINTL 이 카드명의 ①의 효과는 １턴에 ２번까지 사용할 수 있다。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ①：자신 / 상대 턴에 발동할 수 있다
PRINTL 상대 필드의 앞면 표시 몬스터 １장의 효과를 무효로 하고、그 공격력을 턴 종료시까지 ０으로 한다。
CALLFORM CARD_ABLE(0,필드→戦離)
PRINTL ②：이 카드가 필드에서 벗어난 경우에 발동할 수 있다。
PRINTL 자신의 제외 상태인、"수 마신－스가" 또는 "번개 마신－썬가"１장을 특수 소환한다。


@CARDSUMMON_55642(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材条件名前 = 수 마신－스가
ELSEIF EX参照 >= 10
	素材条件名前 = 번개 마신－썬가
ENDIF

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,55642) 
	RETURN RESULT
ENDIF


@CARDCAN_55642(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,55642)
SIF RESULT == 1
	RETURN 0


IF 종류 == EX덱起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,55642)
	SIF RESULT == 1
		RETURN 0
	CALL RESETAREA_MAT
	素材範囲필드 = 1
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件固定 = 場所
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,55642) && 발동済_2(듀얼리스트,55642)
		RETURN 0
	SIF !GROUPMATCH(ゾーン,"필드")
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 10
	효과条件以攻撃力 = 100
	효과条件除去種 = 無効
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드→戦離
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲제외 = 1
	효과条件名前:0 = 수 마신－스가
	효과条件名前:1 = 번개 마신－썬가
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_55642(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件달성,2



IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55642)
	IF RESULT == 0
		CALL RESETAREA_MAT
		素材範囲필드 = 1
		CALL FULLRESET
		TRYCALLFORM CARDSUMMON_55642(듀얼리스트,場所)
		CALL FUSSUMMON(듀얼리스트,場所,제외行き)
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55642,15)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件표시 = 10
		효과条件以攻撃力 = 100
		효과추가종류:0 = 21
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"無効")
	ENDIF
ELSEIF 종류 == 필드→戦離
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55642)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲제외 = 1
		효과条件名前:0 = 수 마신－스가
		효과条件名前:1 = 번개 마신－썬가
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF


