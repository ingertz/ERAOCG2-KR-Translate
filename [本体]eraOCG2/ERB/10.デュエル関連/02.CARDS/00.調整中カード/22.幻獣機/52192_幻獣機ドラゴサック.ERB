@CARDNAME_52192,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 환상수기 드래고사크
	CASE "略称"
		RESULTS = 드래고사크
	CASE "カテゴリ"
		RESULTS:0 = 환상수기
		RESULTS:1 = 환상수
ENDSELECT


@CARD_52192(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 2600
	CASE "守備力"
		RETURN 2200
	CASE "生成カード"
		RETURN 124210
ENDSELECT
RETURN 0

@CARDSUMMON_52192(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 7
;추가효과用

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,58011) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_52192(종류)
#DIM DYNAMIC 종류

PRINTL 레벨７ 몬스터×２
PRINTL 이 카드명의 ①③의 효과는 1턴에 1번밖에 사용할 수 없다。
;トークン生成
CALLFORM CARD_ABLE(1,EX소환時)
PRINTL ①：이 카드가 Ｘ소환된 경우에 발동할 수 있다。
PRINTL 자신 필드에 "환상수기 토큰" ２장을 특수 소환한다。
;共通戦破耐性
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：자신 필드에 토큰이 존재하는 한、이 카드는 전투 / 효과로는 파괴되지 않는다。
;リリース破壊
CALLFORM CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ③：서로의 메인 페이즈에、이 카드의 Ｘ소재를 １개 제거하고 발동할 수 있다。
PRINTL 자신 필드의 "환상수기" 몬스터 １장을 릴리스하고、필드의 카드 １장을 파괴한다。


@CARDCAN_52192(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,52192)
SIF RESULT == 1
	RETURN 0
;トークン生成
IF 종류 == EX소환時
	SIF ゾーン != "필드"
		RETURN 0
;	SIF メインフェイズ != 1
;		RETURN 0
;	SIF ターンプレイヤー != 듀얼리스트
;		RETURN 0

;	SIF 효과발동済(듀얼리스트,場所,ゾーン)
	SIF 발동済_1(듀얼리스트,52192)
		RETURN 0
	;2体소환するから4体未満でないとダメ
	SIF モンスター数(듀얼리스트) >= 4
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,124210,"")
	SIF RESULT == 1
		RETURN 0

	RETURN 1
;耐性
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = トークン
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
;リリース破壊
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF メインフェイズ != 1
		RETURN 0
;	SIF 효과발동済(듀얼리스트,場所,ゾーン)
	SIF 발동済_2(듀얼리스트,52192)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 환상수기
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT <= 1
		RETURN 0
	SIF 마함数(対面者) != 0
		条件달성 ++
	SIF モンスター数(対面者) != 0
		条件달성 ++
	SIF 条件달성 == 0
		RETURN 0
	RETURN 1


ENDIF

@CARDEFFECT_52192(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 효과失敗

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

;トークン生成
IF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52192,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_GENERATE(듀얼리스트,124210,"",0,2)
	ENDIF

;耐性レベル変動
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"破耐")
;リリース破壊
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52192,2,X消費1)
	IF RESULT == 0
		CALL FULLRESET
		효과条件カテゴリ = 환상수기
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과範囲상대마함 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
		ENDIF
	ENDIF

ENDIF


