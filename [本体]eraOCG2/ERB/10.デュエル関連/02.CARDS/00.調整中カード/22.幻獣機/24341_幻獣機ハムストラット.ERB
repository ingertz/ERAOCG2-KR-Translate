@CARDNAME_24341,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 환상수기 햄스트래트
	CASE "略称"
		RESULTS = 햄스트래트
	CASE "カテゴリ"
		RESULTS:0 = 환상수기
		RESULTS:1 = 환상수
ENDSELECT


@CARD_24341(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 1100
	CASE "守備力"
		RETURN 1600

ENDSELECT
RETURN 0

@CARD_EXPLANATION_24341(종류)
#DIM DYNAMIC 종류

;トークン生成α
PRINTL 이 카드명의 ①②의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：패의 이 카드를 묘지로 보내고 발동할 수 있다。
PRINTL 자신의 패 / 덱 / 묘지에서 "에어리얼 차지" １장을 자신의 마법&함정 존에 앞면표시로 놓는다。
;묘지제외蘇生
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：자신 메인페이즈에 자신 필드의 토큰 １장을 릴리스 하고 발동할 수 있다。
PRINTL 자신의 묘지 / 제외 상태인 "환상수기" 몬스터 １장을 특수 소환한다。
;共通レベル変動・戦破耐性
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：자신 필드에 토큰이 존재하는 한
PRINTL 이 카드의 레벨은 ７이 되며、전투 / 효과로는 파괴되지 않는다。


@CARDCAN_24341(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,24341)
SIF RESULT == 1
	RETURN 0
;에어리얼 차지설치
IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,24341)
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲손패 = 1
	효과範囲묘지 = 1
	효과条件名前 = 에어리얼 차지
	효과条件うらら解除 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
;묘지제외蘇生
ELSEIF  종류 == 필드起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 발동済_2(듀얼리스트,24341)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = トークン
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件カテゴリ = 환상수기
	효과条件종류 = モン全般
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
;耐性レベル変動
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = トークン
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_24341(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

;에어리얼 차지설치
IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24341,1)
	;参考：白き乙女
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲손패 = 1
		효과範囲묘지 = 1
		효과条件名前 = 에어리얼 차지
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"表側표시")
	ENDIF
;묘지제외蘇生
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24341,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종류 = トークン
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과範囲제외 = 1
			효과条件カテゴリ = 환상수기
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,場所)

		ENDIF
	ENDIF
;耐性レベル変動
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"破耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"星",7)
ENDIF

