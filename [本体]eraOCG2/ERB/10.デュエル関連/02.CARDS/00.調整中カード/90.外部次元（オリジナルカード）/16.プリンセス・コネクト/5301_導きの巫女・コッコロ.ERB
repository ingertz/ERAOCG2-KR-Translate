@CARDNAME_5301,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 인도하는 무녀 콧코로
	CASE "略称"
		RESULTS = 콧코로
	CASE "カテゴリ"
		RESULTS:0 = 미식전
	CASE "出典作品"
		RESULTS:0 = 프린세스 커넥트！
ENDSELECT


@CARD_5301(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"	
		RETURN 효과モン
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 200
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251202
ENDSELECT

RETURN 0

@CARD_EXPLANATION_5301(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時,특수소환時)
PRINTL 덱에서 "미식전" 카드 １장을 패에 넣는다。
PRINTL 이 턴 동안、자신이 ２번 이상 카드의 효과를 사용한 경우、추가로 １장 더 패에 넣는다。
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ③："각성"의 효과가 발동한 경우에 발동할 수 있다。
PRINTL 자신은 ２０００라이프 회복하고、자신 필드 몬스터의 공격력 / 수비력은 ８００오른다。
PRINTL 
IF 確認듀얼리스트 == "자신"
	PRINTFORML （현재 턴 플레이어가 발동한 효과의 수는{자신_발동数}회）
ELSE
	PRINTFORML （현재 턴 플레이어가 발동한 효과의 수는{상대_발동数}회）
ENDIF
@CARDCAN_5301(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,5301)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時 
	SIF 발동済_1(듀얼리스트,5301)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 미식전
	효과条件固名前 = 인도하는 무녀 콧코로
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF 발동済_3(듀얼리스트,5301)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과条件名前 = 각성
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"효과발동",2)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_5301(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 소환時 || 종류 == 특수소환時 
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5301,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 미식전
		효과条件固名前 = 인도하는 무녀 콧코로
		IF GETVAR(@"%듀얼리스트%_발동数") < 2
			효과条件複数 = 98
		ENDIF
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5301,3)
	IF RESULT == 0
		CALL FULLRESET
		CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"永攻",800)
		CALL FULLRESET
		CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"永守",800)
		CALL LIFE_CHANGE(듀얼리스트,"増加","효과",2000)
	ENDIF
ENDIF


