@CARD_EXPLANATION_85300(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,마함起動,フリー誘発)
PRINTL ①：자신 필드의 각성 상태가 아닌 앞면 표시 몬스터 １장의 공격력 / 수비력을 ５００올리고、각성 상태로 한다。
PRINTL 그 후、상대 필드의 몬스터 １장을 파괴한다。
PRINTL 이 효과는 『각성』으로도 취급한다。
CALL CARD_ABLE(2,ターン終了時)
PRINTL ②：서로의 엔드 페이즈에 이 턴、
PRINTL 어느쪽인가의 플레이어의 LP가 ２０００이상 변동한 경우에 발동할 수 있다。
PRINTL 묘지의 이 카드를 자신 필드에 세트한다。

@CARDCAN_85300(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,85300)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,85300)
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = モン全般
	효과条件표시 = 表側표시
	효과条件条件달성 = 888
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン終了時
	SIF 발동済_2(듀얼리스트,85300)
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_LPL이력") < 2000 && GETVAR(@"%듀얼리스트%_LPH이력") < 2000
		RETURN 0
    RETURN 1
ENDIF

@CARDEFFECT_85300(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 修正値

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,각성발동)
	IF RESULT == 0
		CALL CARD_EFFECT_USE(듀얼리스트,85300,1)
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件종류 = モン全般
		효과条件표시 = 表側표시
		효과条件条件달성 = 888
		CALL CARD_GRANT_ADV(듀얼리스트,ゾーン,場所,"進化",2)
		IF RESULT == 1		
			CALL FULLRESET
			효과範囲상대필드 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
		ENDIF
	ENDIF
ELSEIF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,85300,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き,1)
	ENDIF
ENDIF