@CARDNAME_85300,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 유니온 버스트
	CASE "略称"
		RESULTS = Union Burst！
	CASE "カテゴリ"
		RESULTS:0 = 없음
	CASE "出典作品"
		RESULTS:0 = 프린세스 커넥트！
ENDSELECT

@CARD_85300(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 251215
ENDSELECT
RETURN 0

