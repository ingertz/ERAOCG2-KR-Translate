@CARDNAME_45300,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 프린세스모드 페코린느
	CASE "略称"
		RESULTS = Ｐ페코린느
	CASE "カテゴリ"
		RESULTS:0 = 미식전
	CASE "出典作品"
		RESULTS:0 = 프린세스 커넥트！
ENDSELECT


@CARD_45300(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 2800
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		RETURN 1000
	CASE "추가日"
		RETURN 251215
ENDSELECT

RETURN 0

@CARD_EXPLANATION_45300(종류)
#DIM DYNAMIC 종류

PRINTL "미식전" 튜너＋튜너 이외의 몬스터 １장以上
PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,EX덱起動)
PRINTL 이 카드는 S소환이 가능한 경우、"미식전" 튜너 １장만을 소재로 Ｓ소환할 수 있다。
CALLFORM CARD_ABLE(1,EX소환時)
PRINTL ①：이 카드가 S소환된 경우에 발동할 수 있다。
PRINTL 자신의 묘지 / 덱에서 "유니온 버스트" １장을 필드에 세트한다。
PRINTL 이렇게 세트한 카드는 세트한 턴에도 발동할 수 있다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：이 카드가 필드에 존재하는 한、
PRINTL 자신 필드의 "미식전" 몬스터는 일시 파괴 내성을 얻는다。


@CARDSUMMON_45300(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要レベル数 = 10

;1体目の条件
IF EX参照 == 0 || EX参照 == 1
	素材条件튜너 = 1
	素材条件カテゴリ = 미식전
ELSEIF EX参照 >= 10
	素材条件튜너 = 0
ENDIF

IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,45300) 
	RETURN RESULT
ENDIF

@CARDCAN_45300(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,45300)
SIF RESULT == 1
	RETURN 0
IF 종류 == EX덱起動
	CALL SYNCAN(듀얼리스트,場所,45300) 
	SIF RESULT == 0
		RETURN 0
	RETURN 1
ELSEIF 종류 == EX소환時
	SIF 발동済_1(듀얼리스트,45300)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件名前 = 유니온 버스트
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_45300(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正



IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,45300)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 미식전
		효과条件튜너 = 1
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT
			CALL CARD_EX_SUMMON(듀얼리스트, "EX덱", 場所)
		ENDIF
	ENDIF
ELSEIF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,45300,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件名前 = 유니온 버스트
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"使化裏側표시")
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件カテゴリ = 미식전
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"一破")
ENDIF
