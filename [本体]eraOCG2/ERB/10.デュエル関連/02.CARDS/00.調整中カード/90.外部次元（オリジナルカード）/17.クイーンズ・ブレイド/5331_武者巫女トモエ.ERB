@CARDNAME_5331,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 무사무녀 토모에
	CASE "略称"
		RESULTS = 무사무녀 토모에
	CASE "カテゴリ"
		RESULTS:0 = 미투사
	CASE "出典作品"
		RESULTS:0 = 퀸즈 블레이드
ENDSELECT


@CARD_5331(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1800
	CASE "守備力"
		RETURN 1200
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251202
ENDSELECT

RETURN 0

@CARD_EXPLANATION_5331(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時,특수소환時)
PRINTL ①：이 카드가 소환 / 특수 소환에 성공했을 때에 발동할 수 있다。
PRINTL 자신 묘지의 "미투사" 몬스터 １장을 특수 소환한다。
CALLFORM CARD_ABLE(2,발동誘発,攻撃時誘発)
PRINTL ②：이 카드의 공격 선언시、또는 상대가 패 / 묘지에서 몬스터의 효과를 발동했을 때에 발동할 수 있다。
PRINTL 자신의 덱 가장 위의 카드를 뒤집는다。그 카드의 종류에 따라、이하의 효과를 적용한다。
PRINTL ●몬스터：그 효과를 무효로 하고 제외한다。
PRINTL 　　　　　　　이 효과로 제외한 같은 이름의 몬스터의 효과는 이 턴 무효화된다。
PRINTL ●마법 / 함정　：상대 묘지의 카드를 ３장까지 제외한다。



@CARDCAN_5331(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,5331)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時 
	SIF 발동済_1(듀얼리스트,5331)
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 미투사
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
    SIF 발동済_2(듀얼리스트,5331)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲묘지 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件うらら解除 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1	
ELSEIF 종류 == 攻撃時誘発
	SIF 발동済_2(듀얼리스트,5331)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件うらら解除 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_5331(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 설정禁止
IF 종류 == 소환時 || 종류 == 특수소환時 
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5331,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 미투사
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 발동誘発 || 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5331,2)
	IF RESULT == 0
		TRYCALLFORM CARD_UI(GETVAR(@"%듀얼리스트%_덱:0"))
		TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_덱:0")}("종류")
		IF RESULT <= モン全般
			CALL FULLRESET
			효과条件종류 = モン全般
			CALL CARD_ADD_GY_BASIC(듀얼리스트, "상대묘지",ゾーン,場所)
			설정禁止 = RESULT:1
			CALL CARD_EFFECT_PROHIB(듀얼리스트,설정禁止,2,1)
		ELSEIF RESULT >= 20
			CALL FULLRESET
			효과条件複数 = 97
			효과条件任意 = 1		
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"상대묘지",ゾーン,場所)
		ENDIF
	ENDIF
ENDIF
