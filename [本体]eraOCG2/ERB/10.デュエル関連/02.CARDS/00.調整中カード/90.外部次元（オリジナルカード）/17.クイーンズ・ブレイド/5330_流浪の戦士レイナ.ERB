@CARDNAME_5330,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 유랑의 전사 레이나
	CASE "略称"
		RESULTS = 유랑의전사레이나
	CASE "カテゴリ"
		RESULTS:0 = 미투사
	CASE "出典作品"
		RESULTS:0 = 퀸즈 블레이드
ENDSELECT

;　　　ｱｰﾏｰﾌﾞﾚｲｸ
;(X体 玉座の継者レイナ)
@CARD_5330(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 1500
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251202
ENDSELECT

RETURN 0

@CARD_EXPLANATION_5330(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：필드에 "미투사" 몬스터가 존재하는 경우에 발동할 수 있다。
PRINTL 이 카드를 패에서 특수 소환한다。
CALLFORM CARD_ABLE(2,소환時,특수소환時,攻撃時誘発)
PRINTL ②：이 카드의 공격 선언시、또는 소환 / 특수 소환된 경우에 발동할 수 있다。
PRINTL 자신의 덱 가장 위의 카드를 뒤집는다。그 카드의 종류에 따라、이하의 효과를 적용한다。
PRINTL ●몬스터：이 카드의 공격력은 ５００오르고、１번의 배틀 페이즈중에 ２번 공격할 수 있다。
PRINTL 　　　　　　　이 턴 한번 더 이 카드명의 ②의 효과를 발동할 수 있다。
PRINTL ●마법 / 함정　：패 / 덱에서 이 카드명 이외의 "미투사" 몬스터 １장을 특수 소환한다。




@CARDCAN_5330(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,5330)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,5330)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,5330,"손패")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件カテゴリ = 미투사
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,5330)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件うらら解除 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ELSEIF 종류 == 攻撃時誘発
	SIF 발동済_2(듀얼리스트,5330)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件うらら解除 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK

	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_T1汎数:場所") != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_5330(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5330,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,"손패",場所)
	ENDIF
ELSEIF 종류 == 소환時 || 종류 == 특수소환時 || 종류 == 攻撃時誘発
	TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_덱:0")}("종류")
	IF RESULT <= モン全般 && GETVAR(@"%듀얼리스트%_MZ_T1汎数:場所") == 0
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5330)
	ELSE
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5330,2)
	ENDIF
	IF RESULT == 0
		TRYCALLFORM CARD_UI(GETVAR(@"%듀얼리스트%_덱:0"))
		TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_덱:0")}("종류")
		IF RESULT <= モン全般
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"一攻",500)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"T1汎数",1,1)
		ELSEIF RESULT >= 20
			CALL FULLRESET
			효과範囲손패 = 1
			효과範囲덱 = 1
			효과条件カテゴリ = 미투사
			효과条件固名前 = 유랑의 전사 레이나
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"追戦",1)
ENDIF
