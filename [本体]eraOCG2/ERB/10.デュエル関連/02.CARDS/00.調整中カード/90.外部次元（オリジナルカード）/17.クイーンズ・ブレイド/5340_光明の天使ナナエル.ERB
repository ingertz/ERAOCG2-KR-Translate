@CARDNAME_5340,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 광명의 천사 나나엘
	CASE "略称"
		RESULTS = 광천사 나나엘
	CASE "カテゴリ"
		RESULTS:0 = 미투사
	CASE "出典作品"
		RESULTS:0 = 퀸즈 블레이드
ENDSELECT


@CARD_5340(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 2400
	CASE "守備力"
		RETURN 1000
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251202
ENDSELECT

RETURN 0

@CARD_EXPLANATION_5340(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：필드에 "미투사" 몬스터가 존재하는 경우、패의 이 카드를 공개하고 발동할 수 있다。
PRINTL 덱에서 "퀸즈 블레이드" １장을 패에 넣는다。
CALLFORM CARD_ABLE(2,제외時,攻撃時誘発)
PRINTL ②：이 카드의 공격 선언시、또는 패의 이 카드가 공개되어 있을 때、자신의 "미투사" 몬스터가 전투를 행하는 경우에 발동할 수 있다。
PRINTL 자신의 덱가장 위의 카드를 뒤집는다。그 카드의 종류에 따라、이하의 효과를 적용한다。
PRINTL ●몬스터：그 몬스터의 공격력은 턴 종료시까지 ２０００오른다。
PRINTL ●마법 / 함정　：패의 빛속성 "미투사" 몬스터 １장을 특수 소환하고、
PRINTL 　　　　　　　상대 필드의 특수 소환된 몬스터 １장을 파괴한다。



@CARDCAN_5340(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,5340)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,5340)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 미투사
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件名前 = 퀸즈 블레이드
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時誘発
	SIF 발동済_2(듀얼리스트,5340)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件うらら解除 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	IF ゾーン == "필드"
		SIF 戦闘場所(듀얼리스트) != 場所
			RETURN 0
		SIF ターンプレイヤー != 듀얼리스트
			RETURN 0
	ELSEIF ゾーン == "손패"	
		SIF GETVAR(@"%듀얼리스트%_手_公開:場所") == 0
			RETURN 0

		TRYCALLFORM CARD_{戦闘カードID(듀얼리스트)}("カテゴリ")
		SIF !MATCH(RESULTS,"미투사")
			RETURN 0
	ELSE
		RETURN 0
	ENDIF
	RETURN 1
ENDIF

@CARDEFFECT_5340(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5340,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL STATCHANGE_HAND(듀얼리스트,"지정",場所,"公開",2)
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件名前 = 퀸즈 블레이드
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 제외時 || 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5340,2)
	IF RESULT == 0
		TRYCALLFORM CARD_UI(GETVAR(@"%듀얼리스트%_덱:0"))
		TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_덱:0")}("종류")
		IF RESULT <= モン全般
			選択カード = 戦闘場所(듀얼리스트)
			CALL FULLRESET
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"一時",2000)
		ELSEIF RESULT >= 20
			CALL FULLRESET
			효과範囲손패 = 1
			효과条件カテゴリ = 미투사
			효과条件속성 = 빛속성
			CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)

			CALL FULLRESET
			효과範囲상대필드 = 1
			효과条件召種 = 召種全특수
			CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"除処")
ENDIF
