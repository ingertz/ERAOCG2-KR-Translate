@CARDNAME_85330,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 뱅퀴시드 퀸즈
	CASE "略称"
		RESULTS = 미투사의 패배
	CASE "カテゴリ"
		RESULTS:0 = 미투사
	CASE "出典作品"
		RESULTS:0 = 퀸즈 블레이드
ENDSELECT

@CARD_85330(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 251215
ENDSELECT
RETURN 0

@CARDSUMMON_85330(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
RETURN 0

@CARD_EXPLANATION_85330(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALL CARD_ABLE(1,마함起動,フリー誘発)
PRINTL ①：상대フィールドのモンスター１体の효과を無効にし、攻撃力を０にする。
PRINTL このターン「미투사」モンスターが破壊されていた場合、
PRINTL さらに以下の효과をすべて適用する。
PRINTL ●자신はカードを１枚ドローする。
PRINTL ●このターン상대は攻撃宣言を行えない。
PRINTL ●こうして효과を無効にしたモンスターのコントロールを得る。



@CARDCAN_85330(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,85330)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,85330)
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 10
	효과条件除去種 = 無効
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 短紋章起動
	RETURN 1
ENDIF

@CARDEFFECT_85330(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 修正値

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,85330)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件표시 = 10
		효과추가종류:0 = 21
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"無効")
		IF RESULT == 1
			選択カード = 他参照選択カード
			CALL FULLRESET
			효과条件カテゴリ = 미투사
			효과条件종류 = モン全般
			CALL CARD_CHECK_FIN_DATA(듀얼리스트,"破壊이력")
			IF RESULT == 1
				CALL CARDDRAW_BASIC(듀얼리스트,1)
				CALL CARD_RESERV(듀얼리스트,85330,短紋章予約)
				CALL FULLRESET
				CALL CARD_REMOVAL_ADV(듀얼리스트,"自動処理",選択カード,"強奪")
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 短紋章起動
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"戦無")
ENDIF
