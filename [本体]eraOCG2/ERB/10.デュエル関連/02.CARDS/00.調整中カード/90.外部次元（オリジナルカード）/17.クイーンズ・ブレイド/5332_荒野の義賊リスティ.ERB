@CARDNAME_5332,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 황야의 의적 리스티
	CASE "略称"
		RESULTS = 황야의적 리스티
	CASE "カテゴリ"
		RESULTS:0 = 미투사
	CASE "出典作品"
		RESULTS:0 = 퀸즈 블레이드
ENDSELECT


@CARD_5332(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 2300
	CASE "守備力"
		RETURN 200
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251215
ENDSELECT

RETURN 0

@CARD_EXPLANATION_5332(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,효과後誘発)
PRINTL ①："미투사" 몬스터가 소환 / 특수 소환에 성공한 경우에 발동할 수 있다。
PRINTL 이 카드를 패 / 묘지에서 특수 소환한다。
CALLFORM CARD_ABLE(2,소환時,攻撃時誘発)
PRINTL ②：이 카드의 공격 선언시、또는 소환된 경우에 발동할 수 있다。
PRINTL 자신의 덱가장 위의 카드를 뒤집는다。그 카드의 종류에 따라、이하의 효과를 적용한다。
PRINTL ●몬스터：이 카드는 수비 표시가 되며, 공격 중이라면 그 공격을 무효로 한다。
PRINTL ●마법 / 함정　：카드를 2장 드로우하고, 그 후 2장을 버린다。



@CARDCAN_5332(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,5332)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과後誘発
	SIF 발동済_1(듀얼리스트,5332)
		RETURN 0
	SIF !GROUPMATCH(ゾーン,"손패","묘지")
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,5332,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과条件カテゴリ = 미투사
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"소환全般",2)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환時
	SIF 발동済_2(듀얼리스트,5332)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件うらら解除 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ELSEIF 종류 == 攻撃時誘発
	SIF 발동済_2(듀얼리스트,5332)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件うらら解除 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK

	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_5332(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5332,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 소환時 || 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5332,2)
	IF RESULT == 0
		TRYCALLFORM CARD_UI(GETVAR(@"%듀얼리스트%_덱:0"))
		TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_덱:0")}("종류")
		IF RESULT <= モン全般
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"表",2)
			SIF 종류 == 攻撃時誘発
				CALL EVADE_ATTACK(듀얼리스트)
		ELSEIF RESULT >= 20
			CALL CARDDRAW_BASIC(듀얼리스트,2)
			CALL FULLRESET
			효과範囲손패 = 1
			효과条件複数 = 2
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF
