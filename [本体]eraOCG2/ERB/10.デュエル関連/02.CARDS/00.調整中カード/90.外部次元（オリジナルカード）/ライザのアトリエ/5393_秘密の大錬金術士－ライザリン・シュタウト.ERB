@CARDNAME_5393,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 비밀의 대연금술사－라이잘린 슈타우트
	CASE "略称"
		RESULTS = 대연금 라이자
	CASE "カテゴリ"
		RESULTS:0 = 아틀리에
		RESULTS:1 = 라이자의 아틀리에
	CASE "出典作品"
		RESULTS:0 = 라이자의 아틀리에
ENDSELECT


@CARD_5393(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 260122
ENDSELECT

RETURN 0

@CARD_EXPLANATION_5393(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動,フリー誘発)
PRINTL ①：このカードと同名이외의 「라이자의 아틀리에」モンスターが자신 필드에 존재하는 경우、자신 / 상대のメインフェイズに발동할 수 있다。
PRINTL 자신 필드의 このカードと同名이외의 「라이자의 아틀리에」몬스터 １장을 손패に戻し、이 카드를 패에서 특수 소환한다。
PRINTL 자신 필드에 このカードと同名이외의 「라이자의 아틀리에」モンスターが２体以上존재하는 경우、
PRINTL さらに상대 필드의 마법 / 함정 카드 １장을 덱に戻す事ができる。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：자신 메인 페이즈에 발동할 수 있다。
PRINTL 자신의 묘지に存在するカード２장 を덱に戻す。
PRINTL 그 후、덱에서 「연금 아이템」마법 / 함정 카드 １장을 패에 넣는다。
PRINTL 



@CARDCAN_5393(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,5393)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動 || 종류 == フリー誘発
	SIF ゾーン != "손패"
		RETURN 0
	SIF 발동済_1(듀얼리스트,5393)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,5393,"손패")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 라이자의 아틀리에
	효과条件固名前 = 비밀의 대연금술사－라이잘린 슈타우트
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트,5393)
		RETURN 0

	SIF ゾーン != "필드"
		RETURN 0

	CALL FULLRESET
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0

	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0

	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 연금 아이템
	효과条件종류 = 마함全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_5393(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 攻守修正
#DIM DYNAMIC 条件달성

IF 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5393,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 라이자의 아틀리에
		효과条件固名前 = 비밀의 대연금술사－라이잘린 슈타우트
		효과条件行先플래그 = 손패行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트,"손패",場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲필드 = 1
				효과条件カテゴリ = 라이자의 아틀리에
				효과条件종류 = モン全般
				효과条件固名前 = 비밀의 대연금술사－라이잘린 슈타우트
				효과条件CNT = 1
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT >= 2
					CALL FULLRESET
					효과範囲상대마함 = 1
					효과条件任意 = 1
					CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"덱")	
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5393,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件複数 = 2
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 연금 아이템
			효과条件종류 = 마함全般
			CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所)
		ENDIF
	ENDIF
ENDIF
