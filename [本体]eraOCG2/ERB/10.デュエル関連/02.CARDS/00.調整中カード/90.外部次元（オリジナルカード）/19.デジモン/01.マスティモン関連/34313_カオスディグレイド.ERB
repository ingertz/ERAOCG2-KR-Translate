@CARDNAME_34313,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 카오스 디그레이드
	CASE "略称"
		RESULTS = Ｃ 디그레이드
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_34313(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 2511218
ENDSELECT

RETURN 0

@CARD_EXPLANATION_34313(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,마함起動,フリー誘発)
PRINTL ①：자신フィールドに表側표시のレベル９以上の光・어둠속성「디지몬」モンスターカードが存在する場合、
PRINTL 상대フィールドの表側표시のモンスター１体を대상として발동できる。
PRINTL そのモンスターを元々の持ち主の마법＆함정ゾーンに表側표시で置く。
PRINTL その後、상대フィールドの마법・함정カード１枚を選んで破壊することができる。
CALLFORM CARD_ABLE(1,묘지起動)
PRINTL ②：자신フィールドに「마스테몬」が存在する場合に자신メインフェイズに발동することができる。
PRINTL このカードを묘지から손패に加える。
PRINTL 

@CARDCAN_34313(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,34313)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,34313)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과条件カテゴリ = 디지몬
	효과条件속성:0 = 빛속성
	효과条件속성:1 = 어둠속성
	효과条件표시 = 表側표시
	CALL 효과条件レベル_ADV(9, "以上")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0


	CALL FULLRESET
	SIF 마함数(対面者) >= 5
		RETURN 0

	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF 발동済_2(듀얼리스트,34313)
		RETURN 0

	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET

	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과条件名前 = 마스테몬
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_34313(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34313,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과条件표시 = 表側표시
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"마함")
		IF RESULT == 1
			CALL FULLRESET
			효과範囲상대마함 = 1
			효과条件任意 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
		ENDIF
	ENDIF
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34313,2)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_DISPOSE(듀얼리스트,"묘지",場所,3)
	ENDIF
ENDIF
