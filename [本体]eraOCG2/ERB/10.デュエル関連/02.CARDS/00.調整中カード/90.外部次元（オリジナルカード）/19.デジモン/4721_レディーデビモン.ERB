@CARDNAME_4721,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 레이디데블몬
	CASE "略称"
		RESULTS = 레이디데블몬
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_4721(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RESULT:1 = 사이버스족
		RETURN 악마족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251130
ENDSELECT

RETURN 0

@CARD_EXPLANATION_4721(종류)
#DIM DYNAMIC 종류

PRINTL 디지몬カードは사이버스족としても扱う。
PRINTL このカード名の①②③の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,묘지起動)
PRINTL ①：このカードが묘지に存在する場合に발동することができる。
PRINTL 자신の손패・フィールドのカード２枚を묘지へ送り、このカードを특수소환する。
CALLFORM CARD_ABLE(2,소환時,특수소환時)
PRINTL ②：このカードが소환・특수소환に成功した時に발동できる。
PRINTL 「레이디데블몬」以外の빛속성・어둠속성の「디지몬」モンスター1体を묘지から손패に加える。
CALLFORM CARD_ABLE(3,필드起動,フリー誘発)
PRINTL ③：자신・상대ターンに발동することができる。
PRINTL このカードを묘지に送り、손패からレベル９か１０の어둠속성「디지몬」モンスター１体を특수소환する。
PRINTL 

@CARDCAN_4721(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성



CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,4721)
SIF RESULT == 1
	RETURN 0

IF 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,4721)
		RETURN 0

	CALL CARD_SS_CHECK(듀얼리스트,4721,"묘지",1)
	SIF RESULT == 1
		RETURN 0

	CALL FULLRESET
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0

	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲손패 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,4721)
		RETURN 0

	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件속성:0 = 빛속성
	효과条件속성:1 = 어둠속성
	효과条件カテゴリ= 디지몬
	효과条件固名前 = 레이디데블몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_3(듀얼리스트,4721)
		RETURN 0

	SIF ゾーン != "필드"
		RETURN 0

	CALL FULLRESET
	효과範囲손패 = 1
	효과条件カテゴリ= 디지몬
	효과条件종류 = モン全般
	효과条件속성 = 어둠속성
	효과条件レベル:0 = 9
	효과条件レベル:1 = 10
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_4721(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4721,1)
	IF RESULT == 0
		CALL FULLRESET
		IF モンスター数(듀얼리스트) < 5
			효과範囲손패 = 1
			효과範囲마함 = 1
		ENDIF
		효과範囲필드 = 1
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲손패 = 1
			효과範囲마함 = 1
			효과範囲필드 = 1
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲묘지 = 1
				효과条件종류 = モン全般
				효과条件名前 = 레이디데블몬
				CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4721,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件속성:0 = 빛속성
		효과条件속성:1 = 어둠속성
		효과条件カテゴリ= 디지몬
		효과条件固名前 = 레이디데블몬
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4721,3)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲손패 = 1
			효과条件カテゴリ= 디지몬
			효과条件종류 = モン全般
			효과条件속성 = 어둠속성
			효과条件レベル:0 = 9
			효과条件レベル:1 = 10
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF

