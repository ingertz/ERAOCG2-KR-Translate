@CARDNAME_34068,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 워그레이몬
	CASE "略称"
		RESULTS = 워그레이몬
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_34068(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RESULT:1 = 사이버스족
		RETURN 비늘야수족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 3000
	CASE "守備力"
		RETURN 2200
	CASE "レア度"
		RETURN ULR
ENDSELECT

RETURN 0

@CARDSUMMON_34068(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件종족 = 비늘야수족
素材条件レベル = 9

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,34068) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_34068(종류)
#DIM DYNAMIC 종류

PRINTL 비늘야수족レベル９モンスター×２
PRINTL 디지몬カードは사이버스족としても扱う。
PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,EX덱起動)
PRINTL ①：このカードは자신の묘지の「그레이몬」「메탈그레이몬」それぞれ１体を제외し、
PRINTL 자신フィールドの「아구몬」１体の上に重ねてＸ소환する事もできる。
PRINTL この方法でＸ소환したこのカードのＸ素材は２つ増える。
CALLFORM CARD_ABLE(2,필드起動 ,フリー誘発)
PRINTL ②：자신・상대ターンに、このカードの攻撃力以下の攻撃力を持つ상대モンスター１体を대상として발동できる。
PRINTL そのモンスターを破壊し、その元々の攻撃力分のダメージを상대に与える。
CALLFORM CARD_ABLE(0,攻撃時強制誘発)
PRINTL ③：このカードがドラゴンと戦闘を行う場合に발동する。
PRINTL このカードの攻撃可能횟수を１回増やし、このカードの攻撃力はダメージ計算時のみ倍になる。
PRINTL 

@CARDCAN_34068(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성



CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,34068)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF 발동済_1(듀얼리스트,34068)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,34068)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件重ねてＸ = 1
	효과条件名前 = 아구몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件名前 = 그레이몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件名前 = 메탈그레이몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_2(듀얼리스트,34068)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件攻撃力 = GETVAR(@"%듀얼리스트%_MZ_攻:場所")
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF 戦闘場所(듀얼리스트,1) == 5
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_34068(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 装備마법数
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 판정

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34068,1)
	IF RESULT == 0
		SETCOLOR C_ORANGE
		PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
		PRINTFORML
		PRINTFORML 아구몬、ワープ進化！
		PRINTFORML 
		RESETCOLOR
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 그레이몬
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件名前 = 메탈그레이몬
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL RESETCONDITION_MAT
				必要素材数 = 1
				素材条件名前 = 아구몬
				重ねてＸ = 1
				효과추가종류 = 効追Ｘ素 + 2
				TRYCALLFORM XYZSUMMON(듀얼리스트,場所)
				SETCOLOR C_ORANGE
				PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
				PRINTFORML
				PRINTFORML 워그레이몬！
				PRINTFORML 
				RESETCOLOR
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34068,2,X消費1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件攻撃力 = GETVAR(@"%듀얼리스트%_MZ_攻:場所")
		효과추가종류 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
	ENDIF
ELSEIF 종류 == 攻撃時強制誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34068)
	IF RESULT == 0
		選択カード = 戦闘場所(듀얼리스트,1)
		IF GETVAR(@"%듀얼리스트%_MZ_種:選択カード") == 드래곤족
			판정 = 1
			GOTO SKIPHANTEI
		ENDIF
		TRYCALLFORM CARDNAME_{GETVAR(@"%対面者%_필드:選択カード")}("名前")
		IF STRFIND(RESULTS, "ドラゴン")  != -1
			판정 = 1
			GOTO SKIPHANTEI
		ENDIF
		TRYCALLFORM CARDNAME_{GETVAR(@"%対面者%_필드:選択カード")}("名前")
		IF STRFIND(RESULTS, "ドラモン")  != -1
			판정 = 1
			GOTO SKIPHANTEI
		ENDIF
		TRYCALLFORM CARDNAME_{GETVAR(@"%対面者%_필드:選択カード")}("名前")
		IF STRFIND(RESULTS, "龍")  != -1
			판정 = 1
			GOTO SKIPHANTEI
		ENDIF
		TRYCALLFORM CARDNAME_{GETVAR(@"%対面者%_필드:選択カード")}("名前")
		IF STRFIND(RESULTS, "竜")  != -1
			판정 = 1
			GOTO SKIPHANTEI
		ENDIF

		$SKIPHANTEI
		IF 판정 == 1
			PRINTFORMW 「ブレイブトルネード！」
			CALL FULLRESET
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"戦",1)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"一時",GETVAR(@"%듀얼리스트%_MZ_攻:場所"))
		ENDIF
	ENDIF
ENDIF

