@CARDNAME_34068,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 워그레이몬
	CASE "略称"
		RESULTS = 워그레이몬
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_34068(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RESULT:1 = 사이버스족
		RETURN 비늘야수족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 3000
	CASE "守備力"
		RETURN 2200
	CASE "レア度"
		RETURN ULR
ENDSELECT

RETURN 0

@CARDSUMMON_34068(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件종족 = 비늘야수족
素材条件レベル = 9

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,34068) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_34068(종류)
#DIM DYNAMIC 종류

PRINTL 비늘야수족 레벨９ 몬스터×２
PRINTL 디지몬 카드는 사이버스족으로도 취급한다。
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,EX덱起動)
PRINTL ①：이 카드는 자신의 묘지의 "그레이몬" "메탈그레이몬" 각각 １장을 제외하고、
PRINTL 자신 필드의 "아구몬" １장 위에 겹쳐서 Ｘ소환할 수도 있다。
PRINTL 이 방법으로 Ｘ소환한 이 카드의 Ｘ소재는 ２개 늘어난다。
CALLFORM CARD_ABLE(2,필드起動 ,フリー誘発)
PRINTL ②：자신 / 상대 턴에、이 카드의 X소재를 1개 제거하고、
PRINTL 이 카드의 공격력 이하의 공격력을 가진 상대 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터를 파괴하고、그 원래 공격력 만큼의 데미지를 상대에게 준다。
CALLFORM CARD_ABLE(0,攻撃時強制誘発)
PRINTL ③：이 카드가 드래곤과 전투를 하는 경우에 발동한다。
PRINTL 이 카드의 공격 가능 횟수를 １회 늘리고、이 카드의 공격력은 데미지 계산시에만 두배가 된다。
PRINTL 

@CARDCAN_34068(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성



CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,34068)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF 발동済_1(듀얼리스트,34068)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,34068)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件重ねてＸ = 1
	효과条件名前 = 아구몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件名前 = 그레이몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件名前 = 메탈그레이몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_2(듀얼리스트,34068)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件攻撃力 = GETVAR(@"%듀얼리스트%_MZ_攻:場所")
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF 戦闘場所(듀얼리스트,1) == 5
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_34068(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 装備마법数
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 판정

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34068,1)
	IF RESULT == 0
		SETCOLOR C_ORANGE
		PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
		PRINTFORML
		PRINTFORML 아구몬、초특급 진화！
		PRINTFORML 
		RESETCOLOR
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 그레이몬
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件名前 = 메탈그레이몬
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL RESETCONDITION_MAT
				必要素材数 = 1
				素材条件名前 = 아구몬
				重ねてＸ = 1
				효과추가종류 = 効追Ｘ素 + 2
				TRYCALLFORM XYZSUMMON(듀얼리스트,場所)
				SETCOLOR C_ORANGE
				PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
				PRINTFORML
				PRINTFORML 워그레이몬！
				PRINTFORML 
				RESETCOLOR
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34068,2,X消費1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件攻撃力 = GETVAR(@"%듀얼리스트%_MZ_攻:場所")
		효과추가종류 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
	ENDIF
ELSEIF 종류 == 攻撃時強制誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34068)
	IF RESULT == 0
		選択カード = 戦闘場所(듀얼리스트,1)
		IF GETVAR(@"%듀얼리스트%_MZ_種:選択カード") == 드래곤족
			판정 = 1
			GOTO SKIPHANTEI
		ENDIF
		TRYCALLFORM CARDNAME_{GETVAR(@"%対面者%_필드:選択カード")}("名前")
		IF STRFIND(RESULTS, "드래곤")  != -1
			판정 = 1
			GOTO SKIPHANTEI
		ENDIF
		TRYCALLFORM CARDNAME_{GETVAR(@"%対面者%_필드:選択カード")}("名前")
		IF STRFIND(RESULTS, "드라몬")  != -1
			판정 = 1
			GOTO SKIPHANTEI
		ENDIF
		TRYCALLFORM CARDNAME_{GETVAR(@"%対面者%_필드:選択カード")}("名前")
		IF STRFIND(RESULTS, "용")  != -1
			판정 = 1
			GOTO SKIPHANTEI
		ENDIF
		TRYCALLFORM CARDNAME_{GETVAR(@"%対面者%_필드:選択カード")}("名前")
		IF STRFIND(RESULTS, "룡")  != -1
			판정 = 1
			GOTO SKIPHANTEI
		ENDIF

		$SKIPHANTEI
		IF 판정 == 1
			PRINTFORMW "테라 회오리！"
			CALL FULLRESET
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"戦",1)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"一時",GETVAR(@"%듀얼리스트%_MZ_攻:場所"))
		ENDIF
	ENDIF
ENDIF

