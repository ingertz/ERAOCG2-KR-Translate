@CARDNAME_4725,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 베르스타몬
	CASE "略称"
		RESULTS = 베르스타몬
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
		RESULTS:1 = 삼총사
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_4725(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RESULT:1 = 사이버스족
		RETURN 악마족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 3000
	CASE "守備力"
		RETURN 2500
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251230
ENDSELECT

RETURN 0

@CARD_EXPLANATION_4725(종류)
#DIM DYNAMIC 종류

PRINTL 디지몬カードは사이버스족としても扱う。
PRINTL このカード名の①②③の효과は１ターンに１度しか使用できない。
PRINTL またこのカードの①の효과は자신フィールドのレベル７・８の어둠속성
PRINTL 「디지몬」モンスター１体をリリースして발동する事もできる。
CALLFORM CARD_ABLE(1,손패起動,フリー誘発)
PRINTL ①：자신・상대のメインフェイズに발동することができる。
PRINTL このカードを손패から특수소환する。
PRINTL 자신の묘지の「디지몬」カードが５枚以下で、
PRINTL モンスターをリリースせずこの효과を발동した場合、상대は덱からカードを２枚ドローする。
CALLFORM CARD_ABLE(2,소환時,특수소환時)
PRINTL ②：このカードが소환・특수소환に成功した時に발동することができる。
PRINTL 자신の손패・덱・묘지から「디지몬」마법・함정カード１枚を자신フィールドにセットする。
PRINTL この효과でセットした速攻마법・함정カードはこのターンに발동することができる。
CALLFORM CARD_ABLE(3,필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지,X素材時효과)
PRINTL ③：このカードが상대ターンに묘지へ送られた場合に발동できる。
PRINTL 자신の손패・フィールドからカード１枚を묘지へ送り、このカードを손패に加える。
PRINTL 

@CARDCAN_4725(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성



CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,4725)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,4725)
		RETURN 0

	SIF ゾーン != "손패"
		RETURN 0

	CALL FULLRESET
	SIF メインフェイズ != 1
		RETURN 0

	CALL FULLRESET
	CALL CARD_SS_CHECK(듀얼리스트,4725,ゾーン)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,4725)
		RETURN 0

	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 디지몬
	효과条件종류 = 마함全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지 || 종류 == X素材時효과
	SIF 발동済_3(듀얼리스트,4725)
		RETURN 0
	SIF ターンプレイヤー != 対面者
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲손패 = 1
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_4725(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4725,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件속성 = 어둠속성
		효과条件レベル:0 = 7
		효과条件レベル:1 = 8
		효과条件カテゴリ= 디지몬
		효과条件任意 = 1
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		SIF RESULT == 1
			条件달성 = 1

		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,"손패",場所)
		IF 条件달성 < 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件カテゴリ = 디지몬
			효과条件CNT = 1
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT <= 5
				CALL FULLRESET
				CALL CARDDRAW_BASIC(対面者,2)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4725,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 디지몬
		효과条件종류 = 마함全般
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"使化裏側표시")
	ENDIF

ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지 || 종류 == X素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4725,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲마함 = 1
		효과範囲필드 = 1
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件종류 = モン全般
			효과条件名前 = 베르스타몬
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF
