@CARDNAME_64550,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 사쿠라미궁
	CASE "略称"
		RESULTS = 사쿠라미궁
	CASE "カテゴリ"
		RESULTS:0 = SE.RA.PH
	CASE "出典作品"
		RESULTS:0 = FATE
ENDSELECT


@CARD_64550(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN フィールド
	CASE "추가日"
		RETURN 251225
ENDSELECT

RETURN 0

@CARD_EXPLANATION_64550(종류)
#DIM DYNAMIC 종류

PRINTL 자신 필드는 "사쿠라미궁"이 된다。
PRINTL 이 카드명의 ①③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①：이 카드의 발동시의 효과 처리로서、
PRINTL 자신의 패 / 묘지에서 몬스터 ２장、또는 "사쿠라미궁" １장을 제외하고、
PRINTL 덱에서 "영령"、"얼터에고" 몬스터 １장을 특수 소환할 수 있다。
CALLFORM CARD_ABLE(0,攻撃時強制誘発)
PRINTL ②：상대 몬스터가 공격 선언을 할 때 마다 적용한다。
PRINTL 상대 덱 가장 위의 카드 １장을 제외한다。
CALLFORM CARD_ABLE(3,戦破壊→묘지)
PRINTL ③：이 카드가 필드를 벗어난 경우에 발동할 수 있다。
PRINTL 덱에서 "사쿠라미궁" １장을 패에 넣는다。

@CARDCAN_64550(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 存在판정

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,64550)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,64550)
		RETURN 0
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ELSEIF 종류 == 攻撃時強制誘発
	SIF ゾーン != "마함"
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대덱 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 戦破壊→묘지
	SIF 발동済_3(듀얼리스트,64550)
		RETURN 0
	SIF !GROUPMATCH(묘지送り종류,"リリース","破壊","제외","손패")
		RETURN 0
	SIF !GROUPMATCH(ゾーン,"마함")
		RETURN 0
	SIF 処理中_듀얼리스트 == 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件名前 = 사쿠라미궁
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "마함"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_64550(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件달성A
#DIM DYNAMIC 条件달성B


IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,64550,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲묘지 = 1
		효과条件종류 = モン全般
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT >= 2
			条件달성A = 1
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲묘지 = 1
		효과条件名前 = 사쿠라미궁
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件달성B = 1
		SIF 条件달성A == 0 && 条件달성B == 0
			RETURN 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲묘지 = 1
		IF 条件달성A == 1 && 条件달성B == 0
			효과条件종류 = モン全般
		ELSEIF 条件달성A == 0 && 条件달성B == 1
			효과条件名前 = 사쿠라미궁
		ELSEIF 条件달성A == 0 && 条件달성B == 0
			효과条件종류 = モン全般
			효과条件スーパー名前 = 사쿠라미궁
		ENDIF
		효과条件任意 = 1
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			IF RESULT:1 != 64550
				CALL FULLRESET
				효과範囲손패 = 1
				효과範囲묘지 = 1
				효과条件종류 = モン全般
				효과条件行先플래그 = 제외行き
				CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
				SIF RESULT != 1
					RETURN 0
			ENDIF
		ELSE
			RETURN 0
		ENDIF
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ:0 = 영령
		효과条件カテゴリ:1 = 얼터에고
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 攻撃時強制誘発
	CALL CARD_DECK_DISPOSE(듀얼리스트,"덱",1,제외行き,1)
ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,64550,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件名前 = 사쿠라미궁
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 지속효과
	CALL SET_FIELD_MAGIC_INFO(듀얼리스트,"사쿠라미궁")
ENDIF
