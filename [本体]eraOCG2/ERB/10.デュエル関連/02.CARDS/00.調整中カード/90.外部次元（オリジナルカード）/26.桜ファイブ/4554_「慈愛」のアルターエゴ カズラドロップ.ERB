@CARDNAME_4554,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 「자애」의 얼터에고 카즈라드롭
	CASE "略称"
		RESULTS = 카즈라드롭
	CASE "カテゴリ"
		RESULTS:0 = 영령
		RESULTS:1 = SE.RA.PH
		RESULTS:2 = 얼터에고
	CASE "出典作品"
		RESULTS:0 = FATE
ENDSELECT


@CARD_4554(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 사이버스족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 2300
	CASE "守備力"
		RETURN 1800
	CASE "성별"
		RETURN 牝性
	CASE "レア度"
		RETURN SPR
	CASE "추가日"
		RETURN 251225
ENDSELECT
RETURN 0

@CARD_EXPLANATION_4554(종류)
#DIM DYNAMIC 종류

PRINTL 레벨６ 이상의 몬스터를 포함하는 사이버스족 몬스터 ２장
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,필드起動)
PRINTL ①：자신 / 상대의 메인 페이즈에 발동할 수 있다。
PRINTL 자신의 덱、또는 자신 / 상대의 필드 / 묘지에서
PRINTL "「자애」의 얼터에고 카즈라드롭" 이외의 "얼터에고" 몬스터 １장을 제외한다。
PRINTL 그 후、제외한 몬스터의 ③의 효과를 적용한다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：이 카드가 전투 / 상대의 효과에 의해 필드를 벗어날 경우、
PRINTL 대신에 자신의 묘지 / 제외 상태인 "얼터에고" 몬스터 １장을 패로 되돌릴 수 있다。


@CARDSUMMON_4554(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 3
素材条件종족 = 사이버스족

IF EX参照 == 0 || EX参照 == 1
	CALLFORM 素材条件レベル_ADV(6, "以上")
ENDIF

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,4554)
	RETURN RESULT
ENDIF

@CARDSUMMON_AA_4554


@CARDCAN_4554(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,4554)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_1(듀얼리스트,4554)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과範囲묘지 = 1
	효과範囲상대묘지 = 1
	효과条件カテゴリ = 얼터에고
	효과条件固名前 = 「자애」의 얼터에고 카즈라드롭
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 身代효과
	; ②の身代효과：자신의 카드가 전투 / 상대의 효과で離れる場合に발동（ターン１）
	SIF 발동済_2(듀얼리스트,4554)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF 破壊대상ゾーン != "필드"
		RETURN 0
	SIF 破壊대상場所 != 場所
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件カテゴリ = 얼터에고
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_4554(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4554,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲필드 = 1
		효과範囲상대필드 = 1
		효과範囲묘지 = 1
		효과範囲상대묘지 = 1
		효과条件カテゴリ = 얼터에고
		효과条件固名前 = 「자애」의 얼터에고 카즈라드롭
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		選択カードID = RESULT:1
		IF 選択カードID == 4551
			TRYCALLFORM CARDEFFECT_{選択カードID}(듀얼리스트,バトル開始時,"효과処理",場所)
		ELSEIF 選択カードID == 4552
			TRYCALLFORM CARDEFFECT_{選択カードID}(듀얼리스트,필드起動,"효과処理",場所)
		ELSEIF 選択カードID == 4553
			TRYCALLFORM CARDEFFECT_{選択カードID}(듀얼리스트,필드起動,"효과処理",場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 身代효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4554,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲제외 = 1
		효과条件カテゴリ = 얼터에고
		효과条件CNT = 1
		효과条件行先플래그 = 손패行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			RETURN 1
		ENDIF
	ENDIF
ENDIF

