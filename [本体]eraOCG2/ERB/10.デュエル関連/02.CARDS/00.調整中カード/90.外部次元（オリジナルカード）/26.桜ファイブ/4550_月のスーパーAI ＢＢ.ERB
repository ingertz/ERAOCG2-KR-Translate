@CARDNAME_4550,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 달의 슈퍼 AI ＢＢ
	CASE "略称"
		RESULTS = ＢＢ쨩
	CASE "カテゴリ"
		RESULTS:0 = 영령
		RESULTS:1 = SE.RA.PH
		RESULTS:2 = 문캔서
	CASE "出典作品"
		RESULTS:0 = FATE
ENDSELECT


@CARD_4550(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 사이버스족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 300
	CASE "守備力"
		RETURN 200
	CASE "성별"
		RETURN 牝性
	CASE "특수制限"
		RETURN 1
	CASE "추가日"
		RETURN 251225
ENDSELECT
RETURN 0

@CARD_EXPLANATION_4550(종류)
#DIM DYNAMIC 종류

PRINTL 사이버스족 몬스터 １장
PRINTL 자신은 "달의 슈퍼ＡＩ ＢＢ쨩"을 １턴에 １번밖에 특수 소환할 수 없다。
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,EX소환時,특수소환時)
PRINTL ①：이 카드가 특수 소환된 경우에 발동할 수 있다。
PRINTL 이 카드를 릴리스하고、자신의 덱 / 묘지에서 "사쿠라 미궁" １장을 패에 넣는다。
PRINTL 자신 필드에 "「사쿠라 미궁"이 존재하는 경우、대신 "SE.RA.PH" 카드 １장을 손패에 넣을 수도 있다。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②：이 카드가 묘지에 존재하는 경우에 발동할 수 있다。
PRINTL 자신 / 상대의 묘지에서 다른 몬스터 １장을 제외하고、이 카드를 특수 소환한다。
PRINTL 그 후、자신 / 상대의 제외된 카드가 각각 １３장 이상인 경우、자신은 듀얼에서 승리한다。



@CARDSUMMON_4550(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 1
素材条件종족 = 사이버스족

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,4550)
	RETURN RESULT
ENDIF

@CARDSUMMON_AA_4550


@CARDCAN_4550(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,4550)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,4550)
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件名前 = 사쿠라 미궁
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 1
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件名前 = 사쿠라 미궁
		효과条件スーパーカテゴリ = SE.RA.PH
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ELSE
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件名前 = 사쿠라 미궁
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ENDIF
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF 발동済_2(듀얼리스트,4550)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,4550,"묘지")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲상대묘지 = 1
	효과条件종류 = モン全般
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_4550(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == EX소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4550,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲마함 = 1
		효과条件名前 = 사쿠라 미궁
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件名前 = 사쿠라 미궁
			효과条件スーパーカテゴリ = SE.RA.PH
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
			SIF RESULT != 1
				RETURN 0
		ELSE
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件名前 = 사쿠라 미궁
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
			SIF RESULT != 1
				RETURN 0
		ENDIF
	ENDIF
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4550,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲상대묘지 = 1
		효과条件종류 = モン全般
		효과条件他所 = 1
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
			IF RESULT == 1 && 제외数(듀얼리스트) >= 13 && 제외数(対面者) >= 13
				CALL SET_PLAYER_INFO(듀얼리스트,"듀얼패배플래그",4,1)
			ENDIF
		ENDIF
	ENDIF
ENDIF

