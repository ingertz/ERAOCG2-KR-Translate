@CARDNAME_5383,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		;聖騎士は「クルセイダー」読みなので、「聖騎士」カテゴリには属さない。「聖騎士」たちもこんな変態が加入してきたら困惑しますよ
		RESULTS = 견고한 크루세이더 다크니스
	CASE "略称"
		RESULTS = 다크니스
	CASE "カテゴリ"
		RESULTS:0 = 없음
	CASE "検索カテゴリ"
		RESULTS:0 = 코노스바
	CASE "出典作品"
		RESULTS:0 = 이 멋진 세계에 축복을！
ENDSELECT


@CARD_5383(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"	
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 2500
	CASE "単一存在"
		RETURN 1
	CASE "성별"
		RETURN 牝性
	CASE "소환불가"
		RETURN 1
	CASE "レア度"
		RETURN SPR
	CASE "추가日"
		RETURN 251224
ENDSELECT

RETURN 0

@CARD_EXPLANATION_5383(종류)
#DIM DYNAMIC 종류

PRINTL "견고한 크루세이더 다크니스"는 자신 필드에 １장밖에 앞면 표시로 존재할 수 없으며、일반 소환할 수없다。
PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
SETCOLOR C_LIGHT_T
PRINTL ①：앞면 수비 표시인 이 카드가 몬스터 존에 존재하는 한、
PRINTL 상대는 "견고한 크루세이더 다크니스"밖에 공격 대상 / 효과의 대상으로 선택할 수 없다（마법＆함정 존의 카드는 예외）。
RESETCOLOR
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：자신 필드 / 묘지에 융합 / Ｓ / Ｘ / Ｌ 몬스터가 존재하지 않는 상태에서、
PRINTL 상대가 융합 / Ｓ / Ｘ / Ｌ 몬스터를 특수 소환한 경우에 발동할 수 있다。패 / 묘지에서 이 카드를 수비 표시로 특수 소환한다。
CALLFORM CARD_ABLE(3,특수소환時)
PRINTL ③：이 카드가 특수 소환한 경우에 상대 필드의 앞면 표시 카드 １장을 대상으로 하고 발동할 수 있다。그 효과를 무효로 한다。

;「こんな幼げな少女の속옷を公衆の面前で剥ぎとるなんて真の鬼畜だ許せない！　ぜひとも私をあなたのパーティに入れてほしい」

;ライトノベル「이 멋진 세계에 축복을！」シリーズのメインヒロインの一人で、見た目１００点の金髪美女の聖騎士（クルセイダー）。
;クルセイダーはパーティの盾としてみんなを守る、高い実力と高潔な精神が必要な非常に重要な役割を持った職業なのだが、
;彼女は生粋のドＭで、몬스터의 攻撃で痛めつけられたい、辱められたい、嬲られたい下心でタンク役を志願した真の変態。
;本来クルセイダーは剣を使った攻撃役もできるはずだが、自身の性的쾌락のために防御系のスキルばかり習得しているため攻撃能力は異様に低い。
;
;효과는 ほんのりとドラグマのネーサンと似ているのだが、ネーサンが자신から殴りにも行けるのに対して、こっちは圧巻の攻撃力『０』。
;そのぶん、守備표시にしておくと攻撃대상、효과대상を自身に集めることができて、デコイ性能は極めて高い。（切り込み隊長＋ハイネみたいな感じ）
;「다크니스しか攻撃대상にできない。효과대상にできない。」の書き方に含めるのが難しかったので注釈になったが、마함に대상耐性はつかない仕様。
;このカード自身は何にも耐性が無いから簡単に除去されてしまうが、묘지에서 も這い出てくるしぶとさは場合によっては厄介になるかも。
;SS효과の条件でＥＸ몬스터를 使った後は出せなくなってしまうが、割り切って後攻１ターン目限定の손패誘発のような使い方もあり。（クソでかヴェーラー）
;③の효과無効はワンテンポ遅いのでＥＸ소환時효과などを無効はできないが、起動효과なら無効が間に合う。有効活用するには見極めが必要。


@CARDCAN_5383(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,5383)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트,5383)
		RETURN 0
	SIF !GROUPMATCH(ゾーン,"손패","묘지")
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,5383,"손패")
	SIF RESULT == 1 && ゾーン == "손패"
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,5383,"묘지")
	SIF RESULT == 1 && ゾーン == "묘지"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲묘지 = 1
	효과条件종류 = EXモン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 0
	;상대가 ＥＸ몬스터를 특수 소환된 경우에 발동可能。
	CALL FULLRESET
	효과条件종류 = EXモン全般
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환",1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 특수소환時
	SIF 발동済_3(듀얼리스트,5383)
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件표시 = 表側표시
	효과条件除去種 = 無効
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_表:場所") == 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_5383(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 대상カード_ID
#DIM DYNAMIC 대상종류
#DIM DYNAMIC 상대最大攻撃力 = -1
#DIM DYNAMIC 상대最大EX종류

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5383,2)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所,"守備표시")
		IF RESULT == 1
			;상대의 EX몬스터의 最大攻撃力と종류をチェックして、その高さに応じて変化する。
			;EXじゃない몬스터는 攻撃力チェックに含まない。高ければ高いほど다크니스さんは期待に瞳を輝かせる（？）システム
			FOR カウンタ,0,5
				SIF GETVAR(@"%対面者%_필드:カウンタ") == -1
					CONTINUE
				SIF GETVAR(@"%対面者%_MZ_表:カウンタ") == 3
					CONTINUE
				대상カード_ID = GETVAR(@"%対面者%_필드:カウンタ")
				TRYCALLFORM CARD_{대상カード_ID}("종류")
				대상종류 = RESULT
				SIF !(INRANGE(대상종류,4,9))
					CONTINUE
				IF 상대最大攻撃力 < GETVAR(@"%対面者%_MZ_攻:カウンタ")
					상대最大攻撃力 = GETVAR(@"%対面者%_MZ_攻:カウンタ")
					상대最大EX종류 = 대상종류
				ENDIF
			NEXT
			;다크니스さんの素敵な소환구상（とてもやかましい）
			PRINTFORML
			PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
			PRINTFORML
			SETCOLOR C_LIGHT_T
			IF RAND:4
				IF 상대最大攻撃力 > 3000
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「なんて強大な상대なんだ・・・しかし、聖騎士（クルセイダー）として一歩も退くわけにはいかない！
							PRINTFORML 　貴様らの全力でこい、私は逃げも隠れもしないぞ！　たっぷりと嬲りものにしてもらおうか！！」
						CASE 1
							PRINTFORML 「なるほど、상대는 随分と強力な몬스터를 出してきたな。では私が出て行って
							PRINTFORML 　상대의 注意と攻撃を引きつけよう。듀얼리스트殿は手出し無用だ、邪魔しないでくれよ！」
						CASEELSE
							PRINTFORML 「よいか듀얼리스트殿よ。まずは私が필드의 前に出て상대의 注意を引きつける！
							PRINTFORML 　私のポジションが一番危険だ、覚悟して見ているがいい！　いくぞ！」
					ENDSELECT
				ELSEIF 상대最大攻撃力 > 1500
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「貴様たちの横暴な振る舞い、もはや我慢ならん！
							PRINTFORML 　やるなら私からにしてもらおう！　さあ、どこからでもかかってきてくれ！」
						CASE 1
							PRINTFORML 「私の目が黒いうちに、これ以上の勝手な真似はさせんぞ！
							PRINTFORML 　その有り余るリビドーは、すべて余すことなく私にぶつけてこい！」
						CASEELSE
							PRINTFORML 「ここは私がこの身に代えても食い止める！　듀얼리스트殿、後は任せたぞ・・・
							PRINTFORML 　もしも、力及ばず倒れていたとしたら、遠慮せずに私の身体を踏んで先に進んでくれ・・・」
					ENDSELECT
				ELSE
					SELECTCASE RAND:3
						CASE 0
							PRINTFORML 「さて、まずは小手調べとして私を片付けてもらおうか！
							PRINTFORML 　どんな卑劣な手段で片付けても構わないが・・・いや、どうせなら一番卑劣な手段で頼む！」
						CASE 1
							PRINTFORML 「異世界の怪物め。その実力のほど、私が見極めてやろうじゃないか。
							PRINTFORML 　さあ、存分に殴りかかってくるがよい。いや、殴ってくださいお願いします！」
						CASEELSE
							PRINTFORML 「私は聖騎士（クルセイダー）。弱きを守り、強きに組み伏せられ・・・
							PRINTFORML 　そしていかがわしい、あんなことやこんなことをされて・・・ああっ、想像しただけで興奮が・・・」
					ENDSELECT
				ENDIF
			ELSE
				;1/4の確率で、상대의 EXモンスター종류に応じた텍스트となる。
				SELECTCASE 상대最大EX종류
					CASE 4
						PRINTFORML 「융합モンスターか・・・おおかた私も융합 소재로서 取り込んで
						PRINTFORML 　より強大なモンスターに変貌しようとしているのだろうが、そう簡単にはいかないぞ！　だが期待してるからな！」
					CASE 5
						PRINTFORML 「싱크로モンスターか・・・貧弱なステータスにすぎないザコどもが
						PRINTFORML 　徒党を組んで襲いかかるなど匪賊のごとき所業。だが、こういう連中に嬲りものにされるのも悪くない！」
					CASE 6
						PRINTFORML 「엑시즈モンスターだと・・・몬스터를 下敷きにしてオーバーレイユニット扱いにして
						PRINTFORML 　필드에 出てくるとは、なんていやらしくてうらやましいんだ！　私も下敷きにされたかったぞ！！」
					CASE 7
						PRINTFORML 「링크モンスターだと・・・公衆の面前で相性のいいモンスター同士で링크するなど・・・なんて淫らな連中だ。
						PRINTFORML 　はっ！？　まさか私とも링크して多人数での大乱闘を狙っているのか！　この色情魔どもめ・・・ハアハアッ！」
					CASEELSE
						PRINTFORML 「なんだ이 몬스터는 ・・・凄まじいプレッシャーで押し潰されそうだ。
						PRINTFORML 　これならば私を만족・・・いや、私の상대にとって不足はない！　うおおおお、さあこい！　私にすべてを見せつけてくれ！」
				ENDSELECT
			ENDIF
		ELSE
			;특수소환に失敗してしまったパターン
			PRINTFORML
			PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
			PRINTFORML
			SETCOLOR C_LIGHT_T
			PRINTFORML 「くっ・・・何たる不覚！　필드に出られず指をくわえて見ているしかないとは。
			PRINTFORML 　こんな、こんな焦らしプレイなんて私はイヤだ！　だが、こうやって辱められるのも癖になってしまいそうだ・・・」
		ENDIF
	ELSE
		;효과발동を無効化されてしまったパターン
		PRINTFORML
		PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
		PRINTFORML
		SETCOLOR C_LIGHT_T
		PRINTFORML 「ああっ！　この私が身動きできずに無効化されてしまっただと・・・
		PRINTFORML 　なんて屈辱的で素晴らしいんだ。お願いします、もっとやってください！」
	ENDIF
	PRINTFORMW 
	RESETCOLOR
ELSEIF 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5383,3)
	IF RESULT == 0
		CALL FULLRESET
		효과条件표시 = 表側표시
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"全場単体",場所,"지속無効")
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件固名前 = 견고한 크루세이더 다크니스
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"攻避")
	
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"攻誘")
	
	CALL FULLRESET
	효과条件固名前 = 견고한 크루세이더 다크니스
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"対耐")
ENDIF

