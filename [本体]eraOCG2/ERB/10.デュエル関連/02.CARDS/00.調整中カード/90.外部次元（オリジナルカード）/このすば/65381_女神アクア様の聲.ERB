@CARDNAME_65381,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 여신 아쿠아님의 소리
	CASE "略称"
		RESULTS = 여신아쿠아의소리
	CASE "カテゴリ"
		RESULTS:0 = 없음
		;RESULTS:0 = ヴァルモニカ　ではない
	CASE "検索カテゴリ"
		RESULTS:0 = 코노스바
	CASE "出典作品"
		RESULTS:0 = 이 멋진 세계에 축복을！
ENDSELECT


@CARD_65381(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 通常마법
	CASE "レア度"
		RETURN SPR
	CASE "生成カード"
		RETURN 165381
	CASE "連動ID"
		RETURN 5381
	CASE "추가日"
		RETURN 251224
ENDSELECT

RETURN 0

@CARD_EXPLANATION_65381(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,마함起動 ,손패起動)
PRINTL ①：자신의 패 / 덱에서 "물의 여신 아쿠아님" １장을 제외하고 발동할 수 있다。이하의 효과에서 １개를 골라 적용한다。
PRINTL ●자신은 ５００데미지를 받는다。
PRINTL 그 후、자신의 덱 / 묘지 / 제외 상태인 레벨４ 이하의 마법사족 / 물속성 암컷 몬스터 １장을 패에 넣고、패를 １장 골라서 버린다。
PRINTL ●자신은 ５００ＬＰ 회복한다。
PRINTL 그 후、자신의 제외 상태인 "물의 여신 아쿠아님" １장을 패에 넣는다。이 턴、상대는 데미지를 받지 않는다。
CALL CARD_ABLE(2,효과後誘発)
PRINTL ②：자신 필드에 "물의 여신 아쿠아님"이 특수 소환된 경우、묘지의 이 카드를 제외하고 발동할 수 있다。
PRINTL 상대의 ＥＸ덱 / 필드 / 묘지 / 제외 상태인 융합 / Ｓ / Ｘ / Ｌ 몬스터 카드 ３장마다 １장、
PRINTL 자신의 묘지에 "이 멋진 세계에 축복을！ 토큰"을 생성한다。이 토큰은 마법 카드로서 취급한다。

;女神아쿠아님を손패に引っ張って来る효과がついている、마법사족물속성の下級몬스터의 サーチ마법。
;雰囲気づくりのために「ヴァルモニカ」風の효과がついているが、別にカテゴリには属さない。セレトリーチェをサーチできてＬＰ増減もあり相性はよい。
;本来の想定としては「聖殿の水遣い」を손패経由で묘지送りにして、勇者一行のギミックを起動させるのが正しい。
;だが「코노스바」の再現として、제외状態という聖域に降臨した아쿠아님を손패に引っこ抜いてくるというカスの所業も選べるようになっている。
;サーチ마법としてかなり強いのだが、발동コストで女神아쿠아님が要求されるので、덱に아쿠아님を入れる必要があるのがややネック。
;
;②の묘지효과는 、オマケ효과ではあるが자신 필드에 아쿠아님を着地することができた場合のボーナス特典。
;종류が마법カードのトークンを자신의 묘지에 生成。（상대가 ＥＸ덱１５枚フル構築であれば５枚生成される）
;トークンは아쿠아님の③の万能無効효과のためのコストとして使えるので、これで１～２発ぶんのコストに充てられる。
;参考：서큐버스 걸


@CARDCAN_65381(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성 = 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,65381)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,65381)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과条件名前 = 물의 여신 아쿠아님
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트,65381)
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과条件名前 = 물의 여신 아쿠아님
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환")
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_65381(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 対面EX枚数
#DIM DYNAMIC 生成枚数
#DIM DYNAMIC 条件달성 = 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,65381)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲덱 = 1
		효과条件名前 = 물의 여신 아쿠아님
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			IF 듀얼리스트 == "자신"
				PRINTFORML 
				PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
				PRINTFORML 
				PRINTFORML 제외領域に呼びつけられた%CALLNAME:MASTER%の目の前に、羽衣をつけた青髪の乙女があらわれた！
				PRINTFORML 彼女は神々しくもあるが、しかし他人を下に見るような目つきからは、隠しきれない尊大さと生意気さを感じる。
				PRINTFORML 
				SETCOLOR C_WATER_T
				PRINTFORMW 「私は물의 여신アクア。貴方のデュエルの助けになる、素敵な女の子を授けましょう・・・」
				PRINTFORMW 「あ、誰でもって訳じゃないから。덱に入れてる마법사족・물속성の女の子から選んでね」
				RESETCOLOR
				PRINTFORML 
				PRINTL
				PRINTL こうか
				PRINTL 　聲　を選択
				PRINTL
				PRINTL [0] - 덱 / 묘지・제외 상태인 레벨４ 이하인 마법사족・물속성の牝性몬스터 １장을 選ぶ。
				PRINTL
				PRINTL [1] - ・・・目の前のコイツも『마법사족』で『물속성』だよな。
				BINPUT
				IF RESULT == 0
					CALL CARDEFFECT_65381_2(듀얼리스트,종류,ゾーン,場所)
				ELSE
					CALL CARDEFFECT_65381_1(듀얼리스트,종류,ゾーン,場所)
				ENDIF
			ELSEIF 듀얼리스트 == "상대"
				;CPUが使用する場合、絶対に아쿠아님を選ぶことはしない。
				CALL CARDEFFECT_65381_2(듀얼리스트,종류,ゾーン,場所)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,65381,20)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,제외行き)
		CALL FULLRESET
		효과範囲상대EX덱 = 1
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과範囲상대묘지 = 1
		효과範囲상대제외 = 1
		효과条件종류 = EXモン全般
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT >= 3
			対面EX枚数 = RESULT
			生成枚数 = 対面EX枚数 / 3
			IF 生成枚数 >= 1
				PRINTFORML 
				PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
				PRINTFORML 
				PRINTL 물의 여신 아쿠아님が降臨し、あたりに水しぶきが飛び散った！
				FOR カウンタ,0,生成枚数
					CALL CARD_GENERATE_GY(듀얼리스트,165381)
				NEXT
			ENDIF
		ENDIF
	ENDIF
ENDIF

;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
; 選択효과１　：●자신은 ５００ＬＰ회복한다。그 후、자신의 제외 상태인 「물의 여신 아쿠아님」１장을 패에 넣는다。このターン、상대는 ダメージを受けない。
@CARDEFFECT_65381_1(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL FULLRESET
CALL LIFE_CHANGE(듀얼리스트,"増加","효과",500)

PRINTFORML 
PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
PRINTFORML 
PRINTFORML %CALLNAME:MASTER%は、目の前で突っ立ってる尊大な態度の少女を指さした。
PRINTFORML 
SETCOLOR C_WATER_T
PRINTFORMW 「・・・へ？　いやいや、私は選べる대상じゃないのよ。女神を呼び出そうなんて "伝説の듀얼리스트"でもないと――」
RESETCOLOR
PRINTFORML 
PRINTFORML そう言う女神아쿠아님の身体が、ぽわぽわと光を放ち始めた。
PRINTFORML 
SETCOLOR C_WATER_T
PRINTFORMW 「えっ。ちょ、ちょっと待って！　私は勇者を目指す冒険者に仲間を――きゃあああっっ！」
RESETCOLOR
PRINTFORML 


CALL FULLRESET
효과範囲제외 = 1
효과条件名前 = 물의 여신 아쿠아님
CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)

PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
PRINTFORML 
SETCOLOR C_WATER_T
PRINTFORML （はあっ・・・何となく、そうなる予感はしてたのよね・・・）
RESETCOLOR
PRINTFORML 
PRINTFORMW 손패にやってきた아쿠아님は、がっくりとうな垂れたような表情をしていた。

;このターン戦闘ダメージ・효과ダメージ無効（상대プレイヤー）
CALL SET_PLAYER_INFO(対面者,"ダメージ無効",1)
CALL SET_PLAYER_INFO(対面者,"효과ダメージ無効",1)


RETURN

;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
; 選択효과２　：●자신은 ５００ダメージを受ける。그 후、자신의 덱 / 묘지・제외 상태인 레벨４ 이하인 마법사족・물속성の牝性몬스터 １장을 손패に加え、손패を１枚選んで捨てる。

;E.R.Aカードじゃないのに牝性지정はどーかなーと思うが、「勇者」の冒険のお約束として、お供の마법使いは女の子（かわいい）でなければならない（鉄の意志）
;水遣いも好相性だが、「天魔の聲選姫」に格別に配慮しているのは、セレトリーチェから「もしも私が自由にどこへだって行けるのなら、私は……ファンタージエンを冒険してみたい」という意思を（勝手に）感じ取っているため。
@CARDEFFECT_65381_2(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL FULLRESET
CALL LIFE_CHANGE(듀얼리스트,"減少","효과",500)

CALL FULLRESET
효과範囲덱 = 1
효과範囲묘지 = 1
효과範囲제외 = 1
효과条件종족 = 마법사족
효과条件속성 = 물속성
효과条件성별 = 牝性
CALLFORM 효과条件レベル_ADV(4, "以下")
CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
IF RESULT == 1
	CALL FULLRESET
	CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
ENDIF

RETURN

;――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――――
; トークン
@CARDNAME_165381(参照先)
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 이 멋진 세계에 축복을！ 토큰
	CASE "略称"
		RESULTS = 코노스바 토큰
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_165381(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
	CASE "トークン"
		RETURN 1
ENDSELECT
RETURN 0

@CARD_EXPLANATION_165381(종류)
#DIM DYNAMIC 종류

PRINTL ---------------------------------------------------------------------------------------------------------------
PRINTL 물의 여신 아쿠아님が降臨した余波でそこらじゅうに撒き散らされた水滴。
PRINTL 
PRINTL その水は悪人が飲めば罪が洗い流され、善良な人間が飲めば余りの美味さに涙が溢れ出て수면不足が解消されるらしいが、
PRINTL そんな怪しい謳い文句で青髪のアークプリーストが叩き売りしていたところを、自警団の方々が邪教の疑いで引っ捕らえてくれた。
PRINTL いつも街の安全と平和を守ってくれる自警団のみなさん ありがとう。



@CARDCAN_165381(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,165381)
SIF RESULT == 1
	RETURN 0

IF 종류 == 묘지起動
	SIF 발동済_D1(듀얼리스트,165381)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	;例外処理
	CALL CARD_SS_CHECK(듀얼리스트,0,"")
	SIF RESULT == 1
		RETURN 0
	;例外処理の例外処理
	SIF NAME:MASTER == "佐藤和真" || NAME:MASTER == "カズマ" || CALLNAME:MASTER == "カズマ"
		RETURN 1
	RETURN 0
ENDIF

;Q.なぜトークンに秘密の효과処理が？
;A.おもしろいから＋물의 여신である아쿠아님（が本来は持ってるはず）の権能をひそやかに織り込みたかったので。
;아쿠아님も水遣いのように「勇者」を呼べるという解釈は、あえて明示する必要もないので、プレイヤー名がカズマの場合の裏技要素としてコッソリ。
;出てくるは出てくるけど、別にバランスブレイカーってほどチートな性能もなく、単に「＠マン」の性能でしかない。カズマさんはそんなぐらいでよい。


@CARDEFFECT_165381(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,165381,20)
	IF RESULT == 0
		;アラメシアの儀に相当する「あなた」を특수소환する효과。「勇者」カテゴリも付与するファンサービス。
		;制約のかからない勇者소환という、すごいことしてるんだけど、아쿠아님は아쿠아님なので全くしまらない。
		PRINTFORML 
		PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
		PRINTFORML 
		SETCOLOR C_WATER_T
		PRINTFORML 「……ねえ、カズマさんも戦いたいんじゃない？　私と一緒に戦いましょうよ」
		RESETCOLOR
		PRINTFORML 물의 여신아쿠아님はそう微笑むと『こちら』に手を差し伸べた。
		PRINTFORML 
		CALL FULLRESET
		효과추가カテ = 勇者
