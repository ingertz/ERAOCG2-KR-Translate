ENDSELECT


@CARD_5382(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"	
		RETURN 의식
	CASE "속성"
		RETURN 화염속성
