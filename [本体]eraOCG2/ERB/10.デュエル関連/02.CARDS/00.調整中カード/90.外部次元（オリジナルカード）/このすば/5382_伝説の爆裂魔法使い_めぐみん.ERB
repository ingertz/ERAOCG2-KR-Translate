	CASE "守備力"
		RETURN 1000
	CASE "単一存在"
		RETURN 1
	CASE "성별"
		RETURN 牝性
	CASE "レア度"
		RETURN SPR
	CASE "生成カード"
		RETURN 80002
	;CASE "生成カード"
	;	RETURN 105382
	CASE "추가日"
		RETURN 251224
ENDSELECT

RETURN 0

@CARDSUMMON_5382(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 出処

#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照


CALL RESETCONDITION_MAT
必要レベル数 = 7

IF EX参照 == 1
	CALL RITCAN(듀얼리스트,소환カード,5382)
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_5382(종류)
#DIM DYNAMIC 종류

PRINTL "전설의 폭렬마법"에 의해 강림
PRINTL "전설의 폭렬마법사 메구밍"은、자신 필드에 １장밖에 앞면 표시로 존재할 수 없으며、
PRINTL ①의 효과는 １턴에 １번밖에 사용할 수 없고、②의 효과는 듀얼중에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：자신 메인 페이즈１에、패의 이 카드를 상대에게 보여주고 발동할 수 있다。
PRINTL （이 효과를 발동하는 턴、자신은 마법사족 몬스터만 특수 소환할 수 있으며、다음 자신의 배틀 페이즈를 스킵한다。）
PRINTL 이 카드 이외의 자신의 패 / 필드의 마법사족 몬스터 카드 및 마법 카드를 ３장까지 골라 묘지로 보낸다、
PRINTL 보낸 장 수에 따라 이하의 효과를 각각 적용한다。
PRINTL ●３장：덱 / 묘지에서 "전설의 폭렬마법" １장을 패에 넣는다。
PRINTL ●２장 이상：덱에서 레벨４ 이상인 마법사족 몬스터 １장을 패에 넣는다。
PRINTL ●１장 이상：덱에서 ２장을 드로우한다。그 후、자신의 패를 １장 선택하여 묘지로 보낸다。이 턴、상대 플레이어는 효과 데미지를 받지 않는다。
CALLFORM CARD_ABLE(20,EX소환時)
PRINTL ②：이 카드가 의식 소환된 경우에 발동할 수 있다。
PRINT 자신의 마법＆함정 존의 카드를 모두 묘지로 보내고、
SETCOLOR C_FIRE_T
PRINT "매지컬 익스플로전"
RESETCOLOR
PRINTL １장을 생성해 자신 필드에 세트한다。
PRINTL 그 후、자신의 패를 모두 묘지로 보내는 것으로、이 카드의 공격력 / 수비력을 １０００올릴 수 있다。

;「我が名は메구밍！　アークウィザードを生業とし、最強の攻撃마법〈爆裂마법〉を操りし者！」

;ライトノベル「이 멋진 세계에 축복을！」シリーズのメインヒロインの一人で、優秀な마법使いを多く輩出してきた『紅魔族』の少女。
;大きな魔女帽子を被り、마법の杖を携えて、攻撃마법としては威力・範囲ともに最強クラスの『爆裂마법（エクスプロージョン）』を使いこなす마법使い。
;が、実際には爆裂마법は攻撃範囲が広すぎて一般的な冒険者パーティにとっては使う場面がほとんどなく、また消費魔力も莫大なために一発しか撃てない。
;しかし、そういった逆風にも負けず『爆裂마법』使いの意地を貫いて冒険を続ける姿は、ある種の敬意すら抱くものである。実際に居たら厄介極まりないが。
;
;ところで、遊戯王OCGには「マジカル・エクスプロージョン」という、非常に豪快なバーン효과を持っているために禁止カードに지정されているカードがありまして……
;ということで、eraOCG2に、あの禁止カード「マジカル・エクスプロージョン」を華麗に使いこなす稀代の天才마법使いとして降臨する運びになった。
;
;最上級レベルの의식モンスターであり、専用の의식마법とのセット運用が必要な非常に"重い"カードである。『デュエル中に１度』の文字も輝いている。
;의식마법に気の利いた素材代替などの踏み倒しなんてものもないため、正攻法で의식素材と의식마법と이 카드를 かき集める必要がある。
;이 카드의 손패효과が、制約とコストは重いものの優秀なサーチ・ドロー・손패交換の효과なので出すだけなら苦労はしないが、
;バーンダメージで勝つためにはさらに묘지に大量の마법カードを貯める必要があるため、割り切って【메구밍マジエク】構築に特化させるのも手。
;
;余談だが、「메구밍」のステータスなどは「伝説の爆炎使い（フレイムロード）」という、OCGに実在する古い의식モンスターが元ネタになっている。


@CARDCAN_5382(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,5382)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,5382)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF メインフェイズ２ == 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	;最低でも場と손패に마법カードか自身以外の마법사족モンスター1枚あればOK
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과条件他所 = 1
	효과条件종족 = 마법사족
	효과条件종류 = モン全般
	효과条件スーパー종류 = 마법全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	;마법사족以外を특수소환していたら효과使用불가能
	CALL FULLRESET
	CALLFORM 효과条件종족_ADV(마법사족,"以外")
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"SS이력")
	SIF RESULT != 0
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ELSEIF 종류 == EX소환時
	SIF 발동済_D1(듀얼리스트,5382)
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_条達:場所") == 0
		RETURN 0
	RETURN 1
ELSEIF 종류 == 他효과起動
	RETURN 1
ENDIF

@CARDEFFECT_5382(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択枚数
#DIM DYNAMIC ダメージ修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5382,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과条件他所 = 1
		효과条件종족 = 마법사족
		효과条件종류 = モン全般
		효과条件スーパー종류 = 마법全般
		효과条件複数 = 97
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			選択枚数 = RESULT:2
			
			IF 選択枚数 == 3
				CALL FULLRESET
				효과範囲덱 = 1
				효과範囲묘지 = 1
				효과条件名前 = 전설의 폭렬마법
				CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
			
			IF 選択枚数 >= 2
				CALL FULLRESET
				효과範囲덱 = 1
				효과条件종족 = 마법사족
				효과条件종류 = モン全般
				CALLFORM 효과条件レベル_ADV(4, "以上")
				CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
			
			CALL CARDDRAW_BASIC(듀얼리스트,2)
			CALL FULLRESET
			효과範囲손패 = 1
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			
			;このターン효과ダメージ無効（상대プレイヤー）
			CALL SET_PLAYER_INFO(対面者,"효과ダメージ無効",1)
		ENDIF
		
		;バトルスキップ
		CALL SET_PLAYER_INFO(듀얼리스트,"バトルスキップ", 1)
		;SS縛り（마법사족縛り）
		CALL FULLRESET
		SS소환可能종족 = 마법사족
		CALL CARD_SS_RESTRICTION(듀얼리스트)
	ENDIF
ELSEIF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5382,20)
	IF RESULT == 0
		;자신の마함のカードを全て묘지로 보낸다。
		FOR カウンタ,0,5
			SIF GETVAR(@"%듀얼리스트%_마함:カウンタ") == -1
				CONTINUE
			CALL CARD_DISPOSE(듀얼리스트,"마함",カウンタ)
		NEXT
		;マジカル・エクスプロージョンを生成して자신 필드에 セット。
		CALL CARD_GENERATE_MAGIC(듀얼리스트,80002,3)
		
		;ビジュアルシーン（※スキップできません）
		PRINTFORML 
		PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
		PRINTFORML 
		PRINTFORML 「禁じられた いにしえの秘術よ！　我が呼びかけに応えて この地に再びよみがえれ！」
		PRINTFORMW 
		PRINTFORML 
		PRINTFORM フィールドに
		SETCOLOR C_FIRE_T
		PRINTFORM 「マジカル・エクスプロージョン」
		RESETCOLOR
		PRINTFORML がセットされました。
		PRINTFORMW 
		PRINTFORML 
		PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
		PRINTFORML 
		SETCOLOR C_L_GRAY
		PRINTFORML （ﾋｿﾋｿ…… 詠唱中の私と爆裂마법は無防備ですので、サポートは頼みますよ……）
		RESETCOLOR
		PRINTFORMW 
		PRINTFORML 
		
		IF 손패数(듀얼리스트) >= 1
			;추가で자신의 패を全て捨てるかの確認
			PRINTFORML 
			PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
			PRINTFORML 
			PRINTL 자신의 패를 모두 묘지로 보내시겠습니까?
			CALL YN_CHOICE(듀얼리스트)
			IF RESULT == 0
				FOR カウンタ,0,紙束最大値
					SIF GETVAR(@"%듀얼리스트%_손패:カウンタ") == -1
						CONTINUE
					CALL CARD_DISPOSE(듀얼리스트,"손패",カウンタ)
				NEXT
				CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"条達",2,1)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 攻守変動
	CALL STATCHANGE_BASIC(듀얼리스트,"自身",場所,1000,1000)
ELSEIF 종류 == 他효과起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5382,20)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종류 = 마법全般
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		ダメージ修正 = RESULT * 200
		CALL LIFE_CHANGE(듀얼리스트,"減少","효과",ダメージ修正,1)
	ENDIF
ENDIF



