@CARDNAME_59601, 参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 위치크래프트골렘 플로우라이트
	CASE "略称"
		RESULTS = WCG 플로우라이트
	CASE "カテゴリ"
		RESULTS:0 = 위치크래프트
		;RESULTS:1 = 섀도르
		RESULTS:2 = 게임 오리지널
ENDSELECT

@CARD_59601(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 800
	CASE "分割"
		RETURN デュアル
	CASE "성별"
		RETURN 牝性
	CASE "レア度"
		RETURN SPR
	CASE "生産불가"
		RETURN 1
	CASE "추가日"
		RETURN 251231
ENDSELECT

RETURN 0

