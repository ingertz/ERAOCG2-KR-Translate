;「섀도르・フュージョン」の융합の力を秘めたゴーレム。人形的な印象がより強く、受け答えもどことなく機械的。
;命令した仕事内容は問題なくこなし、不平不満も（人造ゴーレムなので当たり前だが）無いため、従者ゴーレムとしての性能は及第点といったところ。
;表面上からは見えない課題を発見するべく、ヴェールは자신의 侍従として側に置いて動作テストを行っている（という名目で生活のあれこれを怠けてる……）
;普段のゴーレムからは力も魔力も殆ど感じられないため、大した警戒もしていない。そのため、危うく暴走したゴーレムに襲われ、死ぬより恐ろしい目に遭いかける事に……
;시리카とは姉妹機の関係にある。ラピスとラズリーの文脈を踏襲。※マルチとセリオとか、ローゼンメイデンとかのイメージも混ざってるかも。
;鉄の意志と鋼の強さで、시리카を姉（天然ボケ）、플로우라이트を妹（実はお姉ちゃんラブ）としている。漫画業界の用語でいう"ズラし"ってやつだね。

;젬나이트側を유니온モンスターにしたので、こちらはデュアルモンスターに설정。通常モンスター扱いを活用して遊ぶ余地がある、おもちゃ寄りのカード性能。
;ガチで組むぶんには、クリエイション初動にするなら侍女ヴェールで光の涙経由で侍女ヴェール＋WCMヴェールでバイスマスター出したり、ゾロア使ったマギストス展開が強い。

;각성によって융합효과と「섀도르」カテゴリが추가されるのは、普段は危険性が感じ取れないという설정の表現と、섀도르側での利用をしにくくする調整。
;「위치크래프트」側では마법사족ではないものの、元からカテゴリがついてるため光の涙やサボタージュで気軽に呼べるしバイスマスターの素材にもなれる。
;⇒마법사족に설정するとWC마법等々の발동条件を満たせて使い勝手が向上するが、こいつが素でWC마법を使うのは解釈が違うので、ジェム側と同様に元素霊（岩石）族に。

;Q.섀도르なのに덱융합しないのけ？
;A.そもそも덱융합は젬나이트が本家である。ちなみに시리카は덱에서 の素材調達は상대依存１体でリクルートを挟む、マイルドな덱융합としてデザインされております。


@CARDCAN_59601(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 조교대상 = -1

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트, 종류, ゾーン, 場所, 59601)
SIF RESULT == 1
	RETURN 0


IF 종류 == 필드起動 && GETVAR(@"%듀얼리스트%_MZ_条達:場所") == 0
	SIF 발동済_1(듀얼리스트,각성발동)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 && GETVAR(@"%듀얼리스트%_MZ_条達:場所") >= 1
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL RESETAREA_MAT
	素材範囲필드 = 1
	素材範囲손패 = 1
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = 융합
	CALL 효과条件レベル_ADV(8, "以下")
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_59601(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動 && GETVAR(@"%듀얼리스트%_MZ_条達:場所") == 0
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,각성발동,1)
	IF RESULT == 0
		CALL CARD_DECK_DISPOSE(듀얼리스트,"덱",0,完全묘지行き)
		
		;条達＝각성状態の표시で利用
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"条達",2,1)
		SETVAR @"%듀얼리스트%_MZ_追カテ:場所", "섀도르"
	ENDIF
ELSEIF 종류 == 필드起動 && GETVAR(@"%듀얼리스트%_MZ_条達:場所") >= 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59601,10)
	IF RESULT == 0
		CALL RESETAREA_MAT
		素材範囲필드 = 1
		素材範囲손패 = 1
		CALL FULLRESET
		효과条件종류 = 융합
		CALL 효과条件レベル_ADV(8, "以下")
		효과条件소환可 = 2
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			TRYCALLFORM CARDSUMMON_{GETVAR(@"%듀얼리스트%_EX덱:{選択カード}")}(듀얼리스트,選択カード)
			CALL FUSSUMMON(듀얼리스트, 選択カード)
		ENDIF
	ENDIF
ENDIF
