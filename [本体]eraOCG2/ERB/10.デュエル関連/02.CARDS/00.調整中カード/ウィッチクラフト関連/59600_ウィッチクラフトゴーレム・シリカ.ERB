@CARDNAME_59600, 参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 위치크래프트골렘 시리카
	CASE "略称"
		RESULTS = WCG 시리카
	CASE "カテゴリ"
		RESULTS:0 = 위치크래프트
		RESULTS:1 = 젬나이트
		RESULTS:2 = 게임 오리지널
ENDSELECT

@CARD_59600(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 800
	CASE "守備力"
		RETURN 1500
	CASE "分割"
		RETURN 유니온
	CASE "성별"
		RETURN 牝性
	CASE "レア度"
		RETURN SPR
	CASE "生産불가"
		RETURN 1
	CASE "추가日"
		RETURN 251231
ENDSELECT

RETURN 0

@CARD_EXPLANATION_59600(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：손패의 이 카드를 상대に見せて발동할 수 있다。상대プレイヤーは신속성이외의 ６つの속성から１つの속성を宣言する。
PRINTL 「위치크래프트골렘 시리카」이외의 宣言された속성の「위치크래프트」・「젬나이트」몬스터 １장、
PRINTL または宣言された속성の力を持つ「젬나이트」몬스터 １장을 자신의 손패・덱에서 특수 소환하고、손패의 이 카드를 장착한다。
PRINTL 특수소환できなかった場合、자신은 １０００ＬＰ를 失い、이 카드를 묘지へ送る。
CALLFORM CARD_ABLE(2,필드起動,마함起動)
PRINTL ②：이 카드가 필드에 존재하는 경우、자신 메인 페이즈에 발동할 수 있다。
PRINTL 자신 필드의 モンスター카드를 융합素材とし、융합몬스터 １장을 융합소환する。

;「젬나이트 퓨전」の융합の力を秘めたゴーレム。상대依存ながら손패효과でテーマ몬스터의 リクルートと、
;융합소환までを単体で行うことができる。他の機能は持たないが、융합소환するという機能だけ見ればとてつもなく優秀。
;효과를 十二分に発揮するためには、全ての속성のテーマ몬스터를 덱に入れておく必要があるので、本格的なデュエルにはあまり向いてないが、
;とりあえずテーマの몬스터를 一通り入れておくかーぐらいの덱の組み方を肯定してくれる優しさを備えている。
;「위치크래프트」は６속성に担当が揃っているが、「젬나이트」は炎、水、風の３속성が足りていないので、それは以下のモンスターが担当している。
;화염속성：젬나이트 가넷　물속성：젬나이트 사피아　바람속성：젬나이트 르말린

;이 카드의 ①의 효과는 、「위치크래프트」フィールド마법の案をオリジナルで創作していた頃に考えていた時期のものを流用している。
;그 후、eraOCG2に合わせたものとして「위치크래프트・パパ活」なるE.R.Aカードで、상대プレイヤーに指名した속성の子を斡旋（リクルート）する
;カードというものも考えていたが、今回、割と綺麗めな方向のオリジナルの위치크래프트ゴーレムのモンスターカードとして着地する運びとなった。
;本来の構想に戻った感じであるが、やはり속성を상대側に選ばせるという要素は、덱構築を純構築に寄せさせる動機にもなり、良いバランスと思われる。

;CPUは、以下の確率で宣言する仕様。当然ではあるが、WCで필드에 出力して強い속성は選ばれにくい。젬나이트は땅속성の大当たりが若干出やすい。
;빛속성：5%　어둠속성:10%　바람속성：15%　화염속성：20%　땅속성：25%　물속성：25%


@CARDCAN_59600(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 조교대상 = -1

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,59600)
SIF RESULT == 1
	RETURN 0


IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,59600)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과条件カテゴリ:0 = 위치크래프트
	효과条件カテゴリ:1 = 젬나이트
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == 마함起動
	SIF 발동済_2(듀얼리스트,59600)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL RESETAREA_MAT
	素材範囲필드 = 1
	素材範囲마함 = 1
	;素材範囲손패 = 1
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = 융합
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_59600(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択속성
#DIMS DYNAMIC 選択속성_텍스트
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59600,1)
	IF RESULT == 0
		;속성の選択
		IF 듀얼리스트 == "상대"
			CUSTOMDRAWLINE -
			PRINTFORML 속성を１つ選択してください。
			CUSTOMDRAWLINE -
			PRINTL [1] - 빛속성
			PRINTL [2] - 어둠속성
			PRINTL [3] - 땅속성
			PRINTL [4] - 물속성
			PRINTL [5] - 화염속성
			PRINTL [6] - 바람속성
			BINPUT
			選択속성 = RESULT
		ELSE
			;CPUが選ぶ場合はランダム（빛속성：5%　어둠속성:10%　바람속성：15%　화염속성：20%　땅속성：25%　물속성：25%）
			SELECTCASE RAND:20
				CASE 0
					選択속성 = 빛속성
					選択속성_텍스트 = 光
				CASE 1 TO 2
					選択속성 = 어둠속성
					選択속성_텍스트 = 闇
				CASE 3 TO 5
					選択속성 = 바람속성
					選択속성_텍스트 = 風
				CASE 6 TO 9
					選択속성 = 화염속성
					選択속성_텍스트 = 炎
				CASE 10 TO 14
					選択속성 = 땅속성
					選択속성_텍스트 = 地
				CASEELSE
					選択속성 = 물속성
					選択속성_텍스트 = 水
			ENDSELECT
			;選択した속성の표시
			
			PRINTFORMW 상대プレイヤーは「%選択속성_텍스트%」속성を選択しました。
			
		ENDIF
		
		
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲덱 = 1
		효과条件속성 = 選択속성
		효과条件カテゴリ:0 = 위치크래프트
		효과条件カテゴリ:1 = 젬나이트
		효과条件固名前 = 위치크래프트골렘 시리카
		SIF 選択속성 == 화염속성
			효과条件スーパー名前 = 젬나이트 가넷
		SIF 選択속성 == 물속성
			효과条件スーパー名前 = 젬나이트 사피아
		SIF 選択속성 == 바람속성
			효과条件スーパー名前 = 젬나이트 르말린
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT
			;이 카드를 装備する処理
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件固定 = カード소환先
			CALLFORM CARD_EQUIP_ADV(듀얼리스트,場所,ゾーン)
			SIF RESULT == 1
				WAIT
		ELSE
			;소환できなかった場合の処理
			PRINTL 宣言された속성の몬스터를 특수소환する事ができませんでした。
			CALL LIFE_CHANGE(듀얼리스트,"減少","コスト",1000)
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,묘지行き)
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == 마함起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59600,2)
	IF RESULT == 0
		CALL RESETAREA_MAT
		素材範囲필드 = 1
		素材範囲마함 = 1
		;素材範囲손패 = 1
		CALL FULLRESET
		효과条件종류 = 융합
		효과条件소환可 = 2
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			TRYCALLFORM CARDSUMMON_{GETVAR(@"%듀얼리스트%_EX덱:{選択カード}")}(듀얼리스트,選択カード)
			CALL FUSSUMMON(듀얼리스트, 選択カード)
		ENDIF
	ENDIF
ENDIF
