@CARDNAME_91202,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 경상의 스왐프맨
	CASE "略称"
		RESULTS = 스왐프맨
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_91202(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속함정
	CASE "속성"
		RETURN 땅속성

	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	CASE "分割"
		RETURN 通常モン
ENDSELECT
RETURN 0

@CARD_EXPLANATION_91202(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드의 원래 속성은 땅속성、원래 종족은 원소정령족、원래 공격력은 ０、원래 수비력은 ０으로 취급한다。
PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(0, 마함起動)
PRINTL ①：종족과 속성을 １개씩 선언하고 이 카드를 발동할 수 있다。
PRINTL 이 카드는 선언한 종족 / 속성을 갖는 일반 몬스터가 되며、몬스터 존에 특수 소환한다（함정 카드로도 취급한다）。
PRINTL （레벨４ / 공１８００／수１０００）
CALL CARD_ABLE(2, 戦破壊→묘지)
PRINTL ②：몬스터 존에 존재하는 이 카드가 파괴되어 묘지로 보내진 경우에 발동할 수 있다。
PRINTL 이 턴의 엔드 페이즈에、이 카드를 묘지에서 자신의 마법＆함정 존에 앞면 표시로 놓는다。
CALL CARD_ABLE(3, 효과後誘発)
PRINTL ③：이 카드가 마법＆함정 존에 앞면 표시로 존재하는 상태로、자신 필드의 몬스터 카드가 효과로 파괴된 경우에 발동할 수 있다。
PRINTL 이 카드를 일반 몬스터로서 몬스터 존에 특수 소환한다（함정카드로도 취급한다）。
PRINTL 이 효과로 특수 소환한 이 카드의 종족 / 속성 / 공격력 / 수비력은、파괴된 몬스터 카드 １장의 원래 종족 / 속성 / 공격력 / 수비력과 같아지며、
PRINTL 레벨은 그 카드의 코스트와 같아지고、그 카드와 같은 이름의 카드로도 취급한다。
PRINTL 이 효과로 특수 소환한 이 카드는、필드에서 벗어날 경우에 제외된다。

@CARDCAN_91202(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트, 종류, ゾーン, 場所, 91202)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") == 3
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트, 91202, "마함")
	SIF RESULT == 1
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == 戦破壊→묘지
	SIF ゾーン != "필드"
		RETURN 0
	SIF !GROUPMATCH(묘지送り종류, "破壊", "戦闘破壊")
		RETURN 0
	SIF 발동済_2(듀얼리스트, 91202)
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF ゾーン != "마함"
		RETURN 0
	SIF 발동済_3(듀얼리스트, 91202)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2	
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_FIN_DATA(듀얼리스트, "효과破壊")
	SIF RESULT != 1
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트, 91202, "마함")
	SIF RESULT == 1
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == ターン終了時予約
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件名前 = 경상의 스왐프맨
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ENDIF

@CARDEFFECT_91202(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択종족
#DIM DYNAMIC 選択속성
#DIM DYNAMIC 選択攻撃力
#DIM DYNAMIC 選択守備力
#DIM DYNAMIC 選択レベル
#DIM DYNAMIC 破壊カードID,100
#DIM DYNAMIC 破壊カウンタ
#DIM DYNAMIC 選択カード_ID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 91202, 1)
	IF RESULT == 0
		IF 듀얼리스트 == "자신"
			PRINTL
			PRINTL 종족을 선택해주세요
			PRINTL
			PRINT [01] - 마법사족　
			PRINT [02] - 드래곤족　
			PRINTL [03] - 언데드족
			PRINT [04] - 전사족　　　
			PRINT [05] - 기계족　　　
			PRINTL [06] - 야수족
			PRINT [07] - 비행야수족　　　
			PRINT [08] - 비늘야수족　　　
			PRINTL [09] - 악마족
			PRINT [10] - 천사족　　　
			PRINT [11] - 곤충족　　　
			PRINTL [12] - 원소정령족
			PRINT [13] - 식물족　　　
			PRINT [14] - 사이킥족
			PRINTL [15] - 사이버스족
			PRINT [16] - 바다생물족　　　
			PRINT [17] - 미확인족　　
			PRINTL [20] - 환신야수족
			BINPUT
			選択종족 = RESULT
			PRINTL
			PRINTL
			PRINTL 속성을 선택해주세요
			PRINTL
			PRINT [01] - 빛속성　
			PRINT [02] - 어둠속성　
			PRINTL [03] - 땅속성
			PRINT [04] - 물속성　
			PRINT [05] - 화염속성　
			PRINTL [06] - 바람속성
			PRINTL [07] - 신속성
			BINPUT
			選択속성 = RESULT
		ELSE
			選択종족 = RAND:17 + 1
			選択속성 = RAND:6 + 1
		ENDIF
		CALL FULLRESET
		효과추가종류:0 = 効追永種 + 選択종족
		효과추가종류:1 = 効追永属 + 選択속성
		효과추가종류:2 = 効追永攻 + 1800
		효과추가종류:3 = 効追永守 + 1000
		CALL CARD_SP_SUMMON(듀얼리스트, "마함", 場所)
	ENDIF
ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 91202, 2)
	IF RESULT == 0
		CALL CARD_RESERV(듀얼리스트, 91202)
	ENDIF
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 91202, 3)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_CHECK_FIN_DATA(듀얼리스트, "破壊全般", 0, 1)
		破壊カウンタ = RESULT
		FOR カウンタ, 0, 破壊カウンタ
			破壊カードID:カウンタ = RESULT:(カウンタ + 1)
		NEXT
		
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件ID = -1
		FOR カウンタ, 0, 破壊カウンタ
			효과条件ID:カウンタ = 破壊カードID:カウンタ
		NEXT
		IF 효과条件ID != -1
			CALL CARD_CHOOSE_BASIC(듀얼리스트, "묘지", ゾーン, 場所)
			IF RESULT != 9999
				選択カード_ID = RESULT:99
				TRYCALLFORM CARD_{選択カード_ID}, "종족"
				選択종족 = RESULT
				TRYCALLFORM CARD_{選択カード_ID}, "속성"
				選択속성 = RESULT
				TRYCALLFORM CARD_{選択カード_ID}, "攻撃力"
				選択攻撃力 = RESULT
				TRYCALLFORM CARD_{選択カード_ID}, "守備力"
				選択守備力 = RESULT
				TRYCALLFORM CARD_{選択カード_ID}, "レベル"
				選択レベル = RESULT
				
				효과추가종류:0 = 効追永種 + 選択종족
				효과추가종류:1 = 効追永属 + 選択속성
				효과추가종류:2 = 効追永星 + 選択レベル
				효과추가종류:3 = 効追変化ID + 選択カード_ID
				효과추가종류:4 = 効追除処
				효과추가종류:5 = 効追永攻 + 選択攻撃力
				효과추가종류:6 = 効追永守 + 選択守備力
				CALL CARD_SP_SUMMON(듀얼리스트, "마함", 場所)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == ターン終了時予約
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件名前 = 경상의 스왐프맨
	CALL CARD_CHOOSE_ADV(듀얼리스트, ゾーン, 場所)
	IF RESULT != 9999
		CALL FULLRESET
		CALL CARD_DISPOSE(듀얼리스트, "묘지", 選択カード（CS）, 마함行き)
	ENDIF
ENDIF


