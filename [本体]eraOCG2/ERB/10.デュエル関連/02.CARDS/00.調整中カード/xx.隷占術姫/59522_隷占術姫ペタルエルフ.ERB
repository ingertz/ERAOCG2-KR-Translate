@CARDNAME_59522,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 예점술공주 페탈엘프
	CASE "略称"
		RESULTS = 예 페탈엘프
	CASE "カテゴリ"
		RESULTS:0 = 예점술공주
		RESULTS:1 = 점술공주
		RESULTS:3 = E.R.A
ENDSELECT


@CARD_59522(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 1500
	CASE "성별"
		RETURN 牝性
	CASE "分割"
		RETURN 펜듈럼
	CASE "의식代用"
		RETURN 어둠속성
	CASE "連動ID"
		;謎のERAパワーでデュエル中のみ空間を超えてミエルと連動
		;SIF 듀얼モード == 1
		;	RETURN 2569
	CASE "추가日"
		RETURN 251109
ENDSELECT
RETURN 0

@CARD_EXPLANATION_59522(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
CALL TEXT_DECORATION("P_MAGIC")
CALL CARD_ABLE(0,손패起動)
PRINTL 
PRINTL 이 카드명의 Ｐ효과는 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(P1,마함起動)
PRINTL ①：상대 필드의 카드 １장을 대상으로 하고 발동할 수 있다. 이 카드를 파괴하고, 대상의 카드를 패로 되돌린다。
CALL TEXT_DECORATION("P_MAGIC_2")
PRINTL 이 카드명의 카드명의 ②의 몬스터 효과는 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(0,지속효과)
PRINTL ①：어둠속성의 의식 소환 소재로서 릴리스 될 경우、이 카드 １장으로 의식 소환에 필요한 릴리스 소재로 취급되며、
PRINTL 자신 필드에 이 카드 이외의 "점술공주" 몬스터 카드가 존재하는 한、몬스터 존의 이 카드의 레벨은 ９가 된다。
CALL CARD_ABLE(2,소환時,특수소환時,R素材時효과)
PRINTL ②：이 카드가 소환 / 특수 소환된 경우 또는 의식 소재로서 릴리스 된 경우에 발동할 수 있다。
PRINTL 덱에서 레벨 ９이상인 의식 몬스터 １장 또는 "점술공주" 의식 마법 카드 １장을 묘지로 보낸다。
PRINTL 그 후、자신 필드의 "예점술공주 페탈엘프" １장을 릴리스 하는것으로、
PRINTL 덱에서 "예점술공주 페탈엘프" 이외의 "예점술공주" 몬스터 １장을 패에 넣을 수 있다。
CALL TEXT_DECORATION("ROGUE")

;묘지肥やし＋サーチ효과と、P효과による상대 필드의 カードのバウンスを行えるPモンスター。
;出たときに묘지にテーマカードを落とせる효과だけだと並レベル。できれば릴리스하고 サーチ효과まで行いたい。
;条件の都合上、의식素材時の발동ではフィールドに残らないのでサーチまでは行えない。
;このリリースする事で추가효과を得る仕組みは「六花」のイメージを借りている。ペタルエルフは「花びら占い」モチーフなのでそのつながり。
;後攻時に１妨害を踏みやすいP효과を持っているのがありがたくて、これだけでも地味に後攻の手数として使いやすいカードである。
;예점술공주の下級共通のリリース代替효과は어둠속성의식の汎用素材としても活用できるので、어둠속성の의식テーマなら出張採用もありなスペック。


@CARDSUMMON_AA_59522


@CARDCAN_59522(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,59522)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 발동済_P1(듀얼리스트,59522)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 손패
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과条件カテゴリ = 점술공주
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환時 || 종류 == 특수소환時 || 종류 == R素材時효과
	SIF 발동済_2(듀얼리스트,59522)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = 의식
	CALL 효과条件レベル_ADV(9, "以上")
	효과条件スーパーカテゴリ = 점술공주
	효과条件スーパー종류 = 마법全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_59522(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 選択結果 = 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59522)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF
ELSEIF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59522,P1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,破壊行き)
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"손패")
	ENDIF
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"星",9)
ELSEIF 종류 == 소환時 || 종류 == 특수소환時 || 종류 == R素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59522,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종류 = 의식
		CALL 효과条件レベル_ADV(9, "以上")
		효과条件スーパーカテゴリ = 점술공주
		효과条件スーパー종류 = 마법全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 0
			;필드의 ペタルエルフの存在確認
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲마함 = 1
			효과条件名前 = 예점술공주 페탈엘프
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1
				;事前に確認する。
				IF 듀얼리스트 == "자신"
					PRINTFORML 자신 필드의 "예점술공주 페탈엘프"를 릴리스 하시겠습니까？
					CALL YN_CHOICE(듀얼리스트)
					選択結果 = RESULT
				ELSE
					選択結果 = はい
				ENDIF
				
				IF 選択結果 == はい
					CALL FULLRESET
					효과範囲필드 = 1
					효과範囲마함 = 1
					효과条件名前 = 예점술공주 페탈엘프
					효과条件任意 = 1
					CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
					IF RESULT == 1
						;サーチ
						CALL FULLRESET
						효과範囲덱 = 1
						효과条件カテゴリ = 예점술공주
						효과条件종류 = モン全般
						효과条件固名前 = 예점술공주 페탈엘프
						CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF


