@CARDNAME_79927,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 촬영회.alc
	CASE "略称"
		RESULTS = 촬영회
	CASE "カテゴリ"
		RESULTS:0 = E.R.A
		RESULTS:1 = 닷아르크
ENDSELECT


@CARD_79927(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
	CASE "추가日"
		RETURN 20260121
ENDSELECT

RETURN 0

@CARD_EXPLANATION_79927(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,마함起動,손패起動,フリー誘発)
PRINTL ①：상대の牝性モンスター１体に자신の덱・제외状態の「.alc」装備마법カード１枚を装備する。
PRINTL その後、자신フィールドの「.alc」モンスターはエンドフェイズまで대상耐性を得る。
CALLFORM CARD_ABLE(2,攻撃時誘発)
PRINTL ②：자신の마법＆함정ゾーンに「E.R.A」装備마법カードが存在する場合、
PRINTL 상대のモンスターの攻撃宣言時、묘지のこのカードを제외して발동できる。
PRINTL その攻撃を無効にする。
CALL TEXT_DECORATION("ROGUE")


@CARDCAN_79927(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,79927)
SIF RESULT == 1
	RETURN 0


IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 발동済_1(듀얼리스트,79927)
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5 && ゾーン == "손패"
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲제외 = 1
	효과条件カテゴリ = 닷아르크
	효과条件종류 = 装備마법
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件성별 = 牝性 
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	RETURN 1
ELSEIF 종류 == 攻撃時誘発
	SIF 발동済_2(듀얼리스트,79927)
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	SIF バトルフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件カテゴリ = E.R.A
	효과条件종류 = 装備마법
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	RETURN 1
ENDIF

@CARDEFFECT_79927(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード2
#DIM DYNAMIC 조교대상

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,79927,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)

		;덱제외から装備させる.alc装備を選択
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲제외 = 1
		효과条件종류 = 装備마법
		효과条件カテゴリ = 닷아르크
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)	
		選択カード = RESULT
		IF 選択カード != 9999
			;ERA装備を装備させる상대モンスターを選択
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과条件성별 = 牝性
			효과条件표시 = 表側표시
			CALLFORM CARD_EQUIP_ADV(듀얼리스트,選択カード（CS）,参照先（CS）)
			IF RESULT != 9999
				조교대상 = RESULT:1
				CALL CARD_EROTICS(조교대상)
				IF RESULT != -1
					조교대상 = RESULT
					SETCOLOR C_PINK
					PRINTFORML 
					PRINTFORML %CALLNAME:조교대상%の衣服が改変されてしまった！
					PRINTFORML 卑猥な衣服を身に纏った%CALLNAME:조교대상%にカメラのフラッシュが突き刺さる……！
					PRINTFORML 
					RESETCOLOR
					CALL EROTIC_MOVE("晒しもの",조교대상,-1,300)
				ENDIF
			ENDIF

			;자신フィールドのモンスターにEPまで대상耐性付与
			CALL FULLRESET
			효과条件カテゴリ = 닷아르크
			CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"対耐",1)

		ENDIF
	ENDIF
ELSEIF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,79927,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL EVADE_ATTACK(듀얼리스트)
		PRINTFORML 
		PRINTFORML 激しいカメラのフラッシュによって攻撃は失敗してしまった！
		PRINTFORML 
	ENDIF
ENDIF