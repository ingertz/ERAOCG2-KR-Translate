@CARDNAME_59871,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 산드리용.alc
	CASE "略称"
		RESULTS = 산드리용.alc
	CASE "カテゴリ"
		RESULTS:0 = E.R.A
		RESULTS:1 = 닷아르크
ENDSELECT


@CARD_59871(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 사이버스족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 1800
	CASE "守備力"
		RETURN 800
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		RETURN 2048
	CASE "生成カード"
		RETURN 79650
	CASE "추가日"
		RETURN 20260121
ENDSELECT


RETURN 0


@CARD_EXPLANATION_59871(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL "E.R.A" 몬스터를 포함하는 몬스터 ２장
PRINTL 자신의 마법＆함정 존에 "E.R.A" 장착 마법 카드가 존재하지 않는 경우、이 카드는 L소환할 수 없다。
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다
CALL CARD_ABLE(1,필드起動,フリー誘発)
PRINTL ①：자신 / 상대 턴에 발동할 수 있다。
PRINTL 덱 밖에서 "유리 드레스" １장을 생성하고、필드 위의 암컷 몬스터 １장에게 장착한다。
CALL CARD_ABLE(2,효과後誘発)
PRINTL ②："E.R.A" 장착 마법 카드가 묘지로 보내진 경우에 발동할 수 있다。
PRINTL 필드의 카드 １장을 파괴한다。
CALL CARD_ABLE(0,身代효과)
PRINTL ③：자신 필드의 ".alc" 카드가 효과로 파괴될 경우、대신에 자신의 마법＆함정 존의 장착 마법 카드 １장을 파괴할 수 있다。
CALL TEXT_DECORATION("ROGUE")

@CARDSUMMON_59871(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = E.R.A
ELSE
	PRINT
ENDIF

CALL FULLRESET
효과範囲마함 = 1
효과条件종류 = 装備마법
효과条件カテゴリ = E.R.A
CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
SIF RESULT != 1
	RETURN 0

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,59871) 
	RETURN RESULT
ENDIF



@CARDCAN_59871(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,59871)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_1(듀얼리스트,59871)
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트,59871)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과条件カテゴリ = E.R.A
	효과条件종류 = 装備마법
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"묘지送り全般+HD")
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과範囲필드 = 1
	효과範囲마함 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 身代효과
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件종류 = 装備마법
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	TRYCALLFORM CARDNAME_{破壊대상ID}("カテゴリ")
	SIF !MATCH(RESULTS,"닷아르크")
		RETURN 0
	SIF !GROUPMATCH(破壊종류,"효과")
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_59871(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 필드単体
#DIM DYNAMIC 조교대상

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59871,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_GENERATE_HAND(듀얼리스트,79650)

		CALL FULLRESET
		효과条件名前 = 유리 드레스
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"손패",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲상대필드 = 1
			효과条件성별 = 牝性
			효과条件표시 = 表側표시
			CALLFORM CARD_EQUIP_ADV(듀얼리스트,選択カード,"손패")
			IF RESULT != 9999
				조교대상 = RESULT:1
				CALL CARD_EROTICS(조교대상)
				IF RESULT != -1
					조교대상 = RESULT
					SETCOLOR C_PINK
					PRINTFORML 
					PRINTFORML ──결정마술 수정장속──
					PRINTFORML %CALLNAME:조교대상%의 의상은 유리 드레스로 변모해버렸다！
					PRINTFORML 
					RESETCOLOR
					CALL EROTIC_MOVE("晒しもの",조교대상,-1,150)
				ENDIF
			ENDIF

		ENDIF
	ENDIF
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59871,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과範囲필드 = 1
		효과範囲마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
	ENDIF
ELSEIF 종류 == 身代효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59871)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲마함 = 1
		효과条件종류 = 装備마법
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			RETURN 1
		ENDIF
	ENDIF
	RETURN 0
ENDIF


