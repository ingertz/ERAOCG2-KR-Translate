@CARDNAME_59872,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 이졸데.alc
	CASE "略称"
		RESULTS = 이졸데.alc
	CASE "カテゴリ"
		RESULTS:0 = E.R.A
		RESULTS:1 = 닷아르크
ENDSELECT


@CARD_59872(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 사이버스족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 1600
	CASE "守備力"
		RETURN 1500
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		RETURN 51473
	CASE "추가日"
		RETURN 20260121
ENDSELECT

RETURN 0
@CARDSUMMON_59872(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要링크数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = E.R.A
ELSE
	PRINT
ENDIF

CALL FULLRESET
효과範囲마함 = 1
효과条件종류 = 装備마법
효과条件カテゴリ = E.R.A
CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
SIF RESULT != 1
	RETURN 0

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,59872) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_59872(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL "E.R.A" 몬스터를 포함하는 몬스터 ２장
PRINTL 자신의 마법＆함정 존에 "E.R.A" 장착 마법 카드가 존재하지 않는 경우、이 카드는 L소환할 수 없다。
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다
CALL CARD_ABLE(1,EX소환時,특수소환時)
PRINTL ①：이 카드가 특수 소환된 경우에 덱에서 "E.R.A" 장착 마법 카드를 ２장 묘지로 보내고 발동할 수 있다（같은 이름의 카드는 １장까지）。
PRINTL 레벨４ 이하인 암컷 몬스터 １장을 효과를 무효화하고 덱에서 특수 소환한다。
CALL CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ②：자신 / 상대 턴에 발동할 수 있다。
PRINTL 자신의 마법＆함정 존의 "E.R.A" 장착 마법 카드 １장을 패로 되돌린다。
PRINTL 그 후、패의 "E.R.A" 장착 마법 카드 １장을 필드의 암컷 몬스터 １장에게 장착할 수 있다。
CALL CARD_ABLE(0,지속효과)
PRINTL ③：필드에 이 카드가 존재하는 한、
PRINTL "E.R.A" 카드를 장착하고 있는 자신 필드의 몬스터는 직접 공격을 얻는다。
CALL TEXT_DECORATION("ROGUE")

@CARDCAN_59872(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 装備마법数
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,59872)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,59872)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = E.R.A
	효과条件종류 = 装備마법
	효과条件固名前起動 = 1;CARDCHECK_ADV専用
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0

	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = モン全般
	효과条件성별 = 牝性
	CALLFORM 효과条件レベル_ADV(4, "以下")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_2(듀얼리스트,59872)
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件종류 = 装備마법
	효과条件カテゴリ = E.R.A
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	FOR カウンタ,0,5
		CALL FULLRESET
		효과条件カテゴリ = E.R.A
		CALL CARD_EQUIP_CHECK(듀얼리스트,カウンタ,"필드")
		IF RESULT == 1
			RETURN 1
		ENDIF
	NEXT

ENDIF


@CARDEFFECT_59872(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID 
#DIMS DYNAMIC 選択カード名前 
#DIM DYNAMIC 装備마법数
#DIM DYNAMIC 最大レベル
#DIM DYNAMIC 조교대상

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59872,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = E.R.A
		효과条件종류 = 装備마법
		효과条件複数 = 2
		효과条件固名前選択 = 1
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件종류 = モン全般
			효과条件성별 = 牝性
			CALLFORM 효과条件レベル_ADV(4, "以下")
			효과추가종류 = 1
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59872,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲마함 = 1
		효과条件カテゴリ = E.R.A
		효과条件종류 = 装備마법
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件カテゴリ = E.R.A
			효과条件종류 = 装備마법
			효과条件任意 = 1
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"손패",ゾーン,場所)
			IF RESULT != 9999
				選択カード = RESULT
				CALL FULLRESET
				효과範囲필드 = 1
				효과範囲상대필드 = 1
				효과条件성별 = 牝性
				효과条件표시 = 表側표시
				CALLFORM CARD_EQUIP_ADV(듀얼리스트,選択カード,"손패")
				IF RESULT != 9999
					조교대상 = RESULT:1
					CALL CARD_EROTICS(조교대상)
					IF RESULT != -1
						조교대상 = RESULT
						SETCOLOR C_PINK
						PRINTFORML 
						PRINTFORML %CALLNAME:조교대상%は이졸데に卑猥な衣装を着せられてしまった！
						PRINTFORML 
						RESETCOLOR
						CALL EROTIC_MOVE("晒しもの",조교대상,-1,150)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	FOR カウンタ,0,5
		CALL FULLRESET
		효과条件カテゴリ = E.R.A
		CALL CARD_EQUIP_CHECK(듀얼리스트,カウンタ,"필드")
		IF RESULT == 1
			CALL STATCHANGE_EFFECT(듀얼리스트,"필드",カウンタ,"直攻")
		ENDIF
	NEXT
ENDIF
