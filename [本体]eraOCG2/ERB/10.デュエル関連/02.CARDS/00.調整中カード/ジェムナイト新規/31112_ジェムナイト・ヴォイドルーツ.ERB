@CARDNAME_31112,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 젬나이트 보이드루츠
	CASE "略称"
		RESULTS = GemK 보이드
	CASE "カテゴリ"
		RESULTS:0 = 젬나이트
ENDSELECT


@CARD_31112(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 1950
	CASE "守備力"
		RETURN 2450
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 250107
ENDSELECT

RETURN 0

@CARD_EXPLANATION_31112(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：「젬나이트」通常モンスター１体か「젬나이트 퓨전」１枚を
PRINTL 덱から묘지へ送って발동できる。
PRINTL このカードを손패から守備표시で특수소환する。
CALLFORM CARD_ABLE(2,발동誘発)
PRINTL ②：자신フィールドに「젬나이트」융합モンスターが存在し、상대が효과を발동した時、
PRINTL 자신の묘지からこのカードを含む「젬나이트」カード３枚を제외して발동できる。
PRINTL 「その효과を無効にする。
PRINTL その後、자신フィールドの全ての「젬나이트」モンスターの攻撃力は１０００アップする。
PRINTL 

@CARDCAN_31112(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,31112)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,31112)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,31112,"손패")
	SIF RESULT == 1
		RETURN 0

	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ= 젬나이트
	효과条件종류 = 通常モン
	효과条件スーパー名前 = 젬나이트 퓨전
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF 발동済_2(듀얼리스트,31112)
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0

	CALL FULLRESET
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0

	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 젬나이트
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0

	RETURN 1
ENDIF

@CARDEFFECT_31112(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31112,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ= 젬나이트
		효과条件종류 = 通常モン
		효과条件スーパー名前 = 젬나이트 퓨전
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"덱",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲손패 = 1
			효과条件종류 = モン全般
			효과条件名前 = 젬나이트 보이드루츠
			CALL CARD_SP_SUMMON(듀얼리스트,"손패",場所,"守備표시")
		ENDIF
	ENDIF
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31112,2)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件カテゴリ = 젬나이트
			효과条件複数 = 2
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"묘지",ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")

				CALL FULLRESET
				효과条件표시 = 表側표시
				효과条件カテゴリ = 젬나이트
				CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"永攻",1000)
			ENDIF
		ENDIF
	ENDIF
ENDIF
