@CARDNAME_31112,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 젬나이트 보이드루츠
	CASE "略称"
		RESULTS = GemK 보이드
	CASE "カテゴリ"
		RESULTS:0 = 젬나이트
ENDSELECT


@CARD_31112(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 1950
	CASE "守備力"
		RETURN 2450
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 250107
ENDSELECT

RETURN 0

@CARD_EXPLANATION_31112(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①："젬나이트" 일반 몬스터 １장 또는 "젬나이트 퓨전" １장을 
PRINTL 덱에서 묘지로 보내고 발동할 수 있다。
PRINTL 이 카드를 패에서 수비 표시로 특수 소환한다。
CALLFORM CARD_ABLE(2,발동誘発)
PRINTL ②：자신 필드에 "젬나이트" 융합 몬스터가 존재하고、상대가 효과를 발동했을 때、
PRINTL 자신의 묘지에서 이 카드를 포함하는 "젬나이트" 카드 ３장을 제외하고 발동할 수 있다。
PRINTL 그 효과를 무효로 한다。
PRINTL 그 후、자신 필드의 모든 "젬나이트" 몬스터의 공격력은 １０００오른다。
PRINTL 

@CARDCAN_31112(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,31112)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,31112)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,31112,"손패")
	SIF RESULT == 1
		RETURN 0

	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ= 젬나이트
	효과条件종류 = 通常モン
	효과条件スーパー名前 = 젬나이트 퓨전
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF 발동済_2(듀얼리스트,31112)
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0

	CALL FULLRESET
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0

	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 젬나이트
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0

	RETURN 1
ENDIF

@CARDEFFECT_31112(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31112,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ= 젬나이트
		효과条件종류 = 通常モン
		효과条件スーパー名前 = 젬나이트 퓨전
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"덱",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲손패 = 1
			효과条件종류 = モン全般
			효과条件名前 = 젬나이트 보이드루츠
			CALL CARD_SP_SUMMON(듀얼리스트,"손패",場所,"守備표시")
		ENDIF
	ENDIF
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31112,2)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件カテゴリ = 젬나이트
			효과条件複数 = 2
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"묘지",ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")

				CALL FULLRESET
				효과条件표시 = 表側표시
				효과条件カテゴリ = 젬나이트
				CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"永攻",1000)
			ENDIF
		ENDIF
	ENDIF
ENDIF
