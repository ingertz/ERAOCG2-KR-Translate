@CARDNAME_93297,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = EXTINGUISH!
	CASE "略称"
		RESULTS = EXTINGUISH!
	CASE "カテゴリ"
		RESULTS:0 = 레스큐 에이스
ENDSELECT


@CARD_93297(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 250927
ENDSELECT

RETURN 0

@CARD_EXPLANATION_93297(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명은 룰 상 "레스큐 에이스" 카드로도 취급한다。
CALLFORM CARD_ABLE(0,마함起動)
PRINTL ①：자신 필드에 "레스큐 에이스" 몬스터가 존재하는 경우、상대 필드의 효과 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터를 파괴한다。
PRINTL 자신 필드에 "R-ACE 하이드런트"가 존재하는 경우、추가로 이 턴、상대는 이 효과로 파괴한 몬스터와
PRINTL 원래 카드명이 같은 몬스터의 효과를 발동할 수 없다。
PRINTL 


;레스큐 에이스の함정カードの１枚。スタンダードな상대モンスターを破壊する효과。발동条件は必要だがコスト不要なのはそれなりに優秀。
;하이드런트が存在している場合、破壊したモンスターのIDに対して효과발동を行えなくなる추가효과もつく。
;そうそうターン中に何度も同じモンスター효과を使うことも少ないので必要性は薄いが、それでも無いよりはあったほうがいい。


@CARDCAN_93297(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 하이드런트存在플래그

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発
	;SIF 발동済_1(듀얼리스트,93297)
	;	RETURN 0
	;先に하이드런트の存在有無を確認しておいたほうが良さそうなのでここでチェック
	CALL FULLRESET
	효과範囲필드 = 1
	;효과範囲마함 = 1
	효과条件名前 = R-ACE 하이드런트
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		하이드런트存在플래그 = 1
	
	IF ゾーン == "마함"
		;「R-ACE 하이드런트」の②による、使用可能でない状態でセットされているカードの발동を판정する특수な処理
		IF GETVAR(@"%듀얼리스트%_魔_表:場所") == 3
			;そのターンの하이드런트(ID:24295)の②が발동済みである場合はもう발동できない。
			SIF 발동済_2(듀얼리스트,24295)
				RETURN 0
			;자신のフィールドに하이드런트が存在していない場合は발동できない。
			SIF 하이드런트存在플래그 != 1
				RETURN 0
			;このカードが「레스큐 에이스」カードの효과でセットされているかをT1汎数で確認
			;T1汎数に128(bit:7)がセットされていない状態では발동できない（터뷸런스、인트루더、EMERGENCY!、REINFORCE!でのセット時に설정する）
			IF GETBIT(GETVAR(@"%듀얼리스트%_魔_T1汎数:場所"),7) != 1
				RETURN 0
			ELSE
				;발동可能状態でのＣＰＵ側のための판정部分。基本的に使う상황は想定できないため、このカードは②효과を消費しての발동はしない。
				IF 듀얼리스트 == "상대"
					RETURN 0
				ENDIF
			ENDIF
		ENDIF
	ELSE
		RETURN 0
	ENDIF
	
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件종류 = 효과全般
	효과条件표시 = 表側표시
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_93297(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM 選択カード
#DIMS 選択カード名
#DIM DYNAMIC 하이드런트存在플래그

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発
	;하이드런트(ID:24295)の②の효과を用いてセットしたターンに발동したのかを確認。
	;마함起動で、表==3のカードがここを通過していたら、하이드런트の②を使用した扱いに。
	IF (종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")) && GETVAR(@"%듀얼리스트%_魔_表:場所") == 3
		SETCOLOR C_YELLOW
		PRINTFORML "R-ACE 하이드런트"의 능력에 의해 세트 카드 발동！！
		RESETCOLOR
		CALL CARD_EFFECT_USE(듀얼리스트,24295,2)
	ENDIF
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,93297,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		
		CALL FULLRESET
		효과条件종류 = 효과全般
		효과条件표시 = 表側표시
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"묘지")
		IF RESULT == 1
			;破壊したカードIDを보존して、하이드런트が存在していればそのカードIDの효과발동불가に
			選択カード = RESULT:2
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲마함 = 1
			효과条件名前 = R-ACE 하이드런트
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1
				TRYCALLFORM CARDNAME_{選択カード}("名前")
				選択カード名 = %RESULTS%
				PRINTFORML 상대 플레이어는 이 턴、"%選択カード名%"의 효과를 발동할 수 없게 되었다！
				CALL CARD_EFFECT_PROHIB(듀얼리스트,選択カード,1,1)
			ENDIF
		ENDIF
	ENDIF
ENDIF

