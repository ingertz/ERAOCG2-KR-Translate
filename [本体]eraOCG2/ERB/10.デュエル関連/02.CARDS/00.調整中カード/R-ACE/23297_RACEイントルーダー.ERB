@CARDNAME_23297,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = R-ACE 인트루더
	CASE "略称"
		RESULTS = RA인트루더
	CASE "カテゴリ"
		RESULTS:0 = 레스큐 에이스
ENDSELECT


@CARD_23297(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 炎속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1600
	CASE "守備力"
		RETURN 1600
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 250927
ENDSELECT
RETURN 0

@CARD_EXPLANATION_23297(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①③の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,소환時,특수소환時)
PRINTL ①：このカードが소환・특수소환した場合に발동できる。
PRINTL 덱から「레스큐 에이스」함정カード１枚を손패に加える。
PRINTL 자신フィールドに「R-ACE 하이드런트」が存在する場合、손패に加えずフィールドにセットする事もできる。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ②：このカードの攻撃力・守備力は、フィールドの「레스큐 에이스」モンスターの数×２００アップする。
CALLFORM CARD_ABLE(3,발동誘発)
PRINTL ③：상대がモンスターの효과をフィールドで발동した時、손패・フィールドのこのカードをリリースして발동できる。
PRINTL 자신の묘지・제외状態から「R-ACE 인트루더」以外の「레스큐 에이스」モンスター１体を특수소환する。

;レスキューエースの留守居役となりがちな전사족モンスター。손패誘発的な효과も後攻の誘発としては使いにくく、함정カードのサーチも初動にならず苦しい。
;テーマ内で攻守が最も高い下級モンスターではあるのだが、下級モンスターとして図抜けて高いわけでもないため活躍させにくいカードである。
;苦肉の策として제외も특수소환の대상に含められるようにしているが、상대依存かつ상황を選ぶので프리벤터の役割を喰うような動きはできない。
;터뷸런스のセット可能な枚数が１つ減っているのはこのカードにとっては数少ない追い風だが、それで採用するかと言われると……といったところ。
;せめてテーマ内のギミックとの一貫性を持たせるために、하이드런트居たらセットできる（하이드런트②で即撃ち可能に）ようにしておくのと、
;CPUのサーチの優先順位の都合で元々の攻守を下げて（エアホイより優先してサーチしないようにし）、攻守変動で不足分を補うように調整。


@CARDSUMMON_AA_23297


@CARDCAN_23297(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,23297)
SIF RESULT == 1
	RETURN 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,23297)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 레스큐 에이스
	효과条件종류 = 함정全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF 발동済_3(듀얼리스트,23297)
		RETURN 0
	SIF !GROUPMATCH(ゾーン,"필드","손패")
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件カテゴリ = 레스큐 에이스
	효과条件종류 = モン全般
	효과条件固名前 = R-ACE 인트루더
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_23297(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻守修正値
#DIM DYNAMIC 하이드런트存在플래그
#DIM DYNAMIC 選択結果
#DIM DYNAMIC カード추가先

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,23297,1)
	IF RESULT == 0
		;하이드런트が存在していて、마함に空きがある場合は、直接セットできる（레스큐 에이스カードの효과でのセット扱い）
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과条件名前 = R-ACE 하이드런트
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			하이드런트存在플래그 = 1
		
		IF 마함数(듀얼리스트) < 5 && 하이드런트存在플래그 == 1
			;セットするか選ぶ。CPUはセットしない
			IF 듀얼리스트 == "상대"
				選択結果 = いいえ
			ELSE
				PRINTL 「레스큐 에이스」함정カードをフィールドに直接セットしますか？
				CALL YN_CHOICE(듀얼리스트,"●セットする。（레스큐 에이스カードの효과でセットした扱いになる）","●손패に加える。")
				選択結果 = RESULT
			ENDIF
		ELSE
			;条件を満たしてない場合、손패に加える。
			選択結果 = いいえ
		ENDIF
		
		IF 選択結果 == はい
			;마함に直接セットする処理。T1汎数に128(bit:7)も설정する。
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 레스큐 에이스
			효과条件종류 = 함정全般
			CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"裏側표시")
			IF RESULT == 1
				;RESULT:2にカード추가先の情報がある。
				カード추가先 = RESULT:2
				CALL SET_FIELD_INFO(듀얼리스트,"마함",カード추가先,"T1汎数",128)
			ENDIF
		ELSE
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 레스큐 에이스
			효과条件종류 = 함정全般
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,23297,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲제외 = 1
		효과条件カテゴリ = 레스큐 에이스
		효과条件종류 = モン全般
		효과条件固名前 = R-ACE 인트루더
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 攻守変動
	
	;カード枚数をカウント
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 레스큐 에이스
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	攻守修正値 =  RESULT * 200
	
	CALL FULLRESET
	CALL STATCHANGE_BASIC(듀얼리스트,"自身",場所,攻守修正値,攻守修正値)

ENDIF
