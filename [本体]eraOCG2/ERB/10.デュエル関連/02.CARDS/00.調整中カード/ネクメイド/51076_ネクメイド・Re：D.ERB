@CARDNAME_51076,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 네크메이드 Re：D
	CASE "略称"
		RESULTS = NM Re：D
	CASE "カテゴリ"
		RESULTS:0 = 가실장
		RESULTS:1 = 네크메이드
		RESULTS:2 = 네크메이드 나나
		RESULTS:3 = 리추얼
ENDSELECT


@CARD_51076(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 초차원
	;어둠속성/빛속성/땅속성/물속성/화염속성/바람속성
	CASE "속성"
		RETURN 빛속성

	CASE "종족"
		RESULT:1 = 사이킥족
		RETURN 언데드족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 700
	;牝性/雄性があるよ
	CASE "성별"
		RETURN 牝性
	CASE "レア度"
		RETURN ULR
ENDSELECT
RETURN 0

@CARD_EXPLANATION_51076(종류)
#DIM DYNAMIC 종류

PRINTL "네크메이드" 의식 마법 카드에 의해 강림。
CALLFORM CARD_ABLE(10,필드起動)
PRINTL ①：자신 묘지의 리추얼 몬스터 １장또는 몬스터（언데드족）３장을 덱으로 되돌리고 발동할 수 있다。
PRINTL 상대 필드의 앞면 표시 몬스터 １장을 골라 원래 주인의 패로 되돌린다。
CALLFORM CARD_ABLE(0,攻撃時強制誘発)
PRINTL ②：이 카드가 몬스터와의 전투로 상대에게 주는 전투 데미지는 배가된다。



@CARDSUMMON_51076(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要レベル数 = 7

IF EX参照 == 1
	CALL RITCAN(듀얼리스트,소환カード,51076) 
	RETURN RESULT
ENDIF

@CARDCAN_51076(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성A
#DIM DYNAMIC 条件달성B

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,51076)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動
	SIF ゾーン != "필드"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종류 = モン全般
		효과条件カテゴリ = 리추얼
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과条件표시 = 表側표시
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				条件달성A = 1
			ENDIF
			
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종족 = 언데드족
		효과条件종류 = モン全般
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT >= 3
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과条件표시 = 表側표시
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
			条件달성B = 1
			ENDIF
			
		SIF 条件달성A == 0 && 条件달성B == 0
			RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃時強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트,1) == 5
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_51076(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 효과先
#DIM DYNAMIC 条件달성A
#DIM DYNAMIC 条件달성B

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51076,10)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종류 = モン全般
		효과条件カテゴリ = 리추얼
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲상대필드 = 1
				효과条件표시 = 表側표시
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				SIF RESULT == 1
				条件달성A = 1
			ENDIF
			
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종족 = 언데드족
		효과条件종류 = モン全般
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT >= 3
				CALL FULLRESET
				효과範囲상대필드 = 1
				효과条件표시 = 表側표시
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				SIF RESULT == 1
				条件달성B = 1
			ENDIF
			
		IF 条件달성A == 1 && 条件달성B == 1
			PRINTFORML
			PRINTFORML 어느 쪽으로 코스트를 지불하시겠습니까?
			PRINTFORML
			PRINTFORML [1] - 자신 묘지의 리추얼 몬스터 １장。
			PRINTFORML [2] - 자신 묘지의 몬스터（언데드족）３장。
			BINPUT
		ELSEIF 条件달성A == 1 && 条件달성B == 0
			RESULT = 1
		ELSEIF 条件달성A == 0 && 条件달성B == 1
			RESULT = 2
		ENDIF

		IF RESULT == 1
			CALL FULLRESET
				효과範囲묘지 = 1
				효과条件종류 = モン全般
				효과条件カテゴリ = 리추얼
				효과条件行先플래그 = 덱行き
				CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
				IF RESULT == 1
					CALL FULLRESET
					효과範囲상대필드 = 1
					효과条件표시 = 表側표시
					CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"손패")
				ENDIF
				
		ELSEIF RESULT == 2
			CALL FULLRESET
				효과範囲묘지 = 1
				효과条件종류 = モン全般
				효과条件종족 = 언데드족
				효과条件行先플래그 = 덱行き
				효과条件複数 = 3
				CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
				IF RESULT == 1
					CALL FULLRESET
					효과範囲상대필드 = 1
					효과条件표시 = 表側표시
					CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"손패")
				ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 攻撃時強制誘発
	CALL SET_PLAYER_INFO(듀얼리스트,"ダメージ倍化", 3 ,1)
ENDIF