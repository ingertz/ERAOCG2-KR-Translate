@CARDNAME_22802,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 네크메이드 라이터
	CASE "略称"
		RESULTS = NM 라이터
	CASE "カテゴリ"
		RESULTS:0 = 가실장
		RESULTS:1 = 네크메이드
ENDSELECT


@CARD_22802(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	;어둠속성/빛속성/땅속성/물속성/화염속성/바람속성
	CASE "속성"
		RETURN 빛속성

	CASE "종족"
		RETURN 언데드족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1000
	CASE "守備力"
		RETURN 700
	CASE "レア度"
		RETURN RARE
ENDSELECT
RETURN 0

@CARD_EXPLANATION_22802(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：이 카드가 손패に존재하는 경우、자신 메인 페이즈에 발동할 수 있다。덱の上から카드를 ５枚めくる。
PRINTL その中に「네크메이드」카드가 존재하는 경우、その카드를 묘지に送り이 카드를 특수 소환한다。
PRINTL 残りのカードは덱に戻す。
CALLFORM CARD_ABLE(2,소환時,특수소환時)
PRINTL ②：이 카드가 소환・특수 소환된 경우에 발동할 수 있다。
PRINTL 자신의 덱・묘지의 「네크메이드」마법카드 １장을 選んで자신의 마법＆함정 존에 セットする。


@CARDCAN_22802(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,22802)
SIF RESULT == 1
	RETURN 0
IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,22802)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
		CALL CARD_SS_CHECK(듀얼리스트,22802,"손패")
	SIF RESULT == 1
		RETURN 0
	SIF 現山札数(듀얼리스트) < 5
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,22802)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 네크메이드
	효과条件종류 = 마법全般
	효과条件セット = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_22802(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22802,1)
	IF RESULT == 0
		CALL FULLRESET
		효과条件カテゴリ = 네크메이드
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"덱",ゾーン,場所,5)
		IF RESULT == 1
			CALL CARD_SP_SUMMON(듀얼리스트, "손패", 場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22802,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 네크메이드
		효과条件종류 = 마법全般
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"裏側표시")
	ENDIF
ENDIF


