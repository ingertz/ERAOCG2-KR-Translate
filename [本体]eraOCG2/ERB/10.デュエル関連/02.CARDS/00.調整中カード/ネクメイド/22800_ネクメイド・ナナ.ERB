@CARDNAME_22800,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 네크메이드 나나
	CASE "略称"
		RESULTS = NM 나나
	CASE "カテゴリ"
		RESULTS:0 = 가실장
		RESULTS:1 = 네크메이드
		RESULTS:0 = 네크메이드 나나
ENDSELECT


@CARD_22800(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	;어둠속성/빛속성/땅속성/물속성/화염속성/바람속성
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 언데드족
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 1100
	CASE "守備力"
		RETURN 700
	;牝性/雄性があるよ
	CASE "성별"
		RETURN 牝性
	CASE "レア度"
		RETURN SPR
ENDSELECT
RETURN 0

@CARD_EXPLANATION_22800(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：자신 메인 페이즈에、자신 필드 위에 몬스터가 존재하지 않는 경우
PRINTL 또는 몬스터（빛속성／언데드족）가 존재하는 경우에 발동할 수 있다。
PRINTL 이 카드를 패에서 특수 소환한다、이 효과로 특수 소환한 이 카드의 레벨은 ２오른다。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：자신 메인 페이즈에、자신 필드의 앞면 표시의 이 카드를 묘지로 보내고 발동할 수 있다。
PRINTL 자신 묘지의 몬스터（레벨７）１장을 골라 덱으로 되돌리고、그 몬스터에 따라 이하의 효과를 적용한다。
PRINTL ●언데드족：자신은 ２장 드로우한다。
PRINTL ●빛속성 / 언데드족：자신은 ２장 드로우하고、덱 / ＥＸ덱 / 묘지에서 "네크메이드 나나" 몬스터 １장을 특수 소환할 수 있다。
PRINTL ●그 이외：자신은 １장 드로우한다。


@CARDCAN_22800(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM 選択カード
#DIM DYNAMIC 효과使用불가,10
#DIMS DYNAMIC 選択名前
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC カードID

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,22800)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF ゾーン != "손패"
		RETURN 0
	SIF 발동済_1(듀얼리스트,22800)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,22800,"손패")
	SIF RESULT == 1
		RETURN 0

	CALL FULLRESET
	효과範囲필드 = 1
	효과条件속성 = 빛속성
	효과条件종족 = 언데드족
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 1

	CALL FULLRESET
	효과範囲필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 0
		RETURN 1
	RETURN 0

ELSEIF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트,22800)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종류 = モン全般
	효과条件レベル = 7
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF

@CARDEFFECT_22800(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 효과使用불가,10
#DIMS DYNAMIC 選択名前
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC カードID



CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22800,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트, "손패", 場所)
		CALL SET_FIELD_INFO(듀얼리스트,"필드",カード소환先,"永星",2)
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22800,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종류 = モン全般
		효과条件レベル = 7
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"묘지",ゾーン,場所)
		IF RESULT == 1
			選択カード_ID = RESULT:1
			TRYCALLFORM CARD_{選択カード_ID}("종족")
			IF GROUPMATCH(RESULT,언데드족)
				CALL CARDDRAW_BASIC(듀얼리스트,2)
				TRYCALLFORM CARD_{選択カード_ID}("속성")
				IF GROUPMATCH(RESULT,빛속성)
					CALL FULLRESET
					효과範囲덱 = 1
					효과範囲EX덱 = 1
					효과範囲묘지 = 1
					효과条件カテゴリ = 네크메이드 나나
					효과条件종류 = モン全般
					효과条件任意 = 1
					CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
				ENDIF
			ELSE
				CALL CARDDRAW_BASIC(듀얼리스트,1)
			ENDIF
		ENDIF
	ENDIF
ENDIF
