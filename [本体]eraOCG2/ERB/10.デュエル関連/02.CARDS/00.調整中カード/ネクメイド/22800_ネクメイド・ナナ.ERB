@CARDNAME_22800,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 네크메이드 나나
	CASE "略称"
		RESULTS = NM 나나
	CASE "カテゴリ"
		RESULTS:0 = 가실장
		RESULTS:1 = 네크메이드
		RESULTS:0 = 네크메이드 나나
ENDSELECT


@CARD_22800(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	;어둠속성/빛속성/땅속성/물속성/화염속성/바람속성
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 언데드족
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 1100
	CASE "守備力"
		RETURN 700
	;牝性/雄性があるよ
	CASE "성별"
		RETURN 牝性
	CASE "レア度"
		RETURN SPR
ENDSELECT
RETURN 0

@CARD_EXPLANATION_22800(종류)
#DIM DYNAMIC 종류

PRINTL このカードの①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：자신メインフェイズに、자신フィールド上にモンスターが存在しない場合
PRINTL またはモンスター（빛속성／언데드족）が存在する場合に발동できる。
PRINTL このカードを손패から특수소환する、この효과で특수소환したこのカードのレベルは２上がる。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：자신メインフェイズに、자신フィールドの表側표시のこのカードを묘지へ送って발동できる。
PRINTL 자신の묘지のモンスター（レベル７）１体を選んで덱に戻し、そのモンスターによって以下の효과を適用する。
PRINTL ●언데드족：자신は２枚ドローする。
PRINTL ●빛속성・언데드족：자신は２枚ドローし、덱・ＥＸ덱・묘지から「네크메이드 나나」モンスター１体を특수소환できる。
PRINTL ●それ以外：자신は１枚ドローする。


@CARDCAN_22800(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM 選択カード
#DIM DYNAMIC 효과使用불가,10
#DIMS DYNAMIC 選択名前
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC カードID

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,22800)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF ゾーン != "손패"
		RETURN 0
	SIF 발동済_1(듀얼리스트,22800)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,22800,"손패")
	SIF RESULT == 1
		RETURN 0

	CALL FULLRESET
	효과範囲필드 = 1
	효과条件속성 = 빛속성
	효과条件종족 = 언데드족
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 1

	CALL FULLRESET
	효과範囲필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 0
		RETURN 1
	RETURN 0

ELSEIF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트,22800)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종류 = モン全般
	효과条件レベル = 7
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF

@CARDEFFECT_22800(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 효과使用불가,10
#DIMS DYNAMIC 選択名前
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC カードID



CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22800,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트, "손패", 場所)
		CALL SET_FIELD_INFO(듀얼리스트,"필드",カード소환先,"永星",2)
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22800,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종류 = モン全般
		효과条件レベル = 7
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"묘지",ゾーン,場所)
		IF RESULT == 1
			選択カード_ID = RESULT:1
			TRYCALLFORM CARD_{選択カード_ID}("종족")
			IF GROUPMATCH(RESULT,언데드족)
				CALL CARDDRAW_BASIC(듀얼리스트,2)
				TRYCALLFORM CARD_{選択カード_ID}("속성")
				IF GROUPMATCH(RESULT,빛속성)
					CALL FULLRESET
					효과範囲덱 = 1
					효과範囲EX덱 = 1
					효과範囲묘지 = 1
					효과条件カテゴリ = 네크메이드 나나
					효과条件종류 = モン全般
					효과条件任意 = 1
					CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
				ENDIF
			ELSE
				CALL CARDDRAW_BASIC(듀얼리스트,1)
			ENDIF
		ENDIF
	ENDIF
ENDIF
