@CARDNAME_22801,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 네크메이드 가드
	CASE "略称"
		RESULTS = NM 가드
	CASE "カテゴリ"
		RESULTS:0 = 가실장
		RESULTS:1 = 네크메이드
ENDSELECT


@CARD_22801(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	;어둠속성/빛속성/땅속성/물속성/화염속성/바람속성
	CASE "속성"
		RETURN 빛속성

	CASE "종족"
		RETURN 언데드족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1000
	CASE "守備力"
		RETURN 700
	CASE "レア度"
		RETURN RARE
ENDSELECT
RETURN 0

@CARD_EXPLANATION_22801(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,필드起動)
PRINTL ①：덱の一番上の카드를 묘지로 보내고 발동할 수 있다。 
PRINTL 이 카드의 レベルはターン終了時まで３上がる。
PRINTL 이 턴、자신은 通常소환に加えて１度、자신 메인 페이즈에 モンスター（언데드족）１体を소환できる。
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：이 카드가 フィールドから묘지로 보내진 경우에 발동할 수 있다。
PRINTL 자신의 덱の上から카드를 ５枚めくる。
PRINTL その中に「네크메이드」카드가 あった場合、その内の１장을 選んで손패に加え、残りのカードは全て묘지로 보낸다。
PRINTL 無かった場合、めくった카드를 全て덱に戻す。
PRINTL 이 턴、자신은 モンスター（언데드족）しかＥＸ덱에서 특수 소환할 수 없다。

@CARDCAN_22801(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,22801,1)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動
	SIF 발동済_1(듀얼리스트,22801)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드→묘지
	SIF 발동済_2(듀얼리스트,22801)
		RETURN 0
	SIF 現山札数(듀얼리스트) < 5
		RETURN 0
	RETURN 1
	
ELSEIF 종류 == 短紋章起動
	RETURN 1
ENDIF

@CARDEFFECT_22801(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 설정レベル

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22801,1)
	IF RESULT == 0
		CALL CARD_DECK_DISPOSE(듀얼리스트,"덱",1)
		CALL FULLRESET
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"一星",3)
		CALL CARD_RESERV(듀얼리스트,22801,短紋章予約)
	ENDIF
ELSEIF 종류 == 필드→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22801,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件カテゴリ = 네크메이드
		효과条件山切り無し = 1
		CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所,5)
		IF RESULT == 1
			CALL CARD_DECK_DISPOSE(듀얼리스트,"덱",4)
		ENDIF
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		EX소환可能종족 = 언데드족
		CALL CARD_EX_RESTRICTION(듀얼리스트)
	ENDIF
	
ELSEIF 종류 == 短紋章起動
	CALL FULLRESET
	효과条件종족 = 언데드족
	CALL STATCHANGE_HAND(듀얼리스트,"全体",場所,"召可")
ENDIF

