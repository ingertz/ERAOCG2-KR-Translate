@CARDNAME_22807,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 네크메이드 클리너
	CASE "略称"
		RESULTS = NM 클리너
	CASE "カテゴリ"
		RESULTS:0 = 가실장
		RESULTS:0 = 네크메이드
ENDSELECT


@CARD_22807(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	;어둠속성/빛속성/땅속성/물속성/화염속성/바람속성
	CASE "속성"
		RETURN 빛속성

	CASE "종족"
		RETURN 언데드족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1200
	CASE "守備力"
		RETURN 700
	;牝性/雄性があるよ
	CASE "レア度"
		RETURN CMN
ENDSELECT
RETURN 0

@CARD_EXPLANATION_22807(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,소환時,특수소환時)
PRINTL ①：이 카드의 소환 / 특수 소환에 성공한 경우에 、자신의 덱 위에서 카드 ２장을 묘지로 보내고 발동할 수 있다。
PRINTL 상대 필드의 마법 / 함정 존의 카드 １장을 골라 파괴하고、상대는 자신 묘지의 마법 / 함정 카드 １장을 골라 세트한다。
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：이 카드가 필드에서 묘지로 보내진 경우에 발동할 수 있다。
PRINTL 자신의 덱 위에서 카드를 ５장 뒤집는다。
PRINTL 그 안에 "네크메이드" 카드가 있었을 경우、그 중에 １장을 골라서 패에 넣고、남은 카드는 모두 묘지로 보낸다。
PRINTL 없었을 경우、뒤집었던 카드를 모두 덱으로 되돌린다。
PRINTL 이 턴、자신은 몬스터（언데드족）밖에 특수 소환할 수 없다。

@CARDCAN_22807(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,22807)
SIF RESULT == 1
	RETURN 0
	
IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,22807)
		RETURN 0
	CALL FULLRESET
		효과範囲상대마함 = 1
		효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	CALL FULLRESET
		효과範囲덱 = 1
		효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드→묘지
	SIF 발동済_2(듀얼리스트,22807)
		RETURN 0
	SIF 現山札数(듀얼리스트) < 5
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_22807(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22807,1)
	IF RESULT == 0
		CALL CARD_DECK_DISPOSE(듀얼리스트,"덱",2)
		CALL FULLRESET
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"마함単体",場所,"묘지")
		CALL FULLRESET
		효과条件종류 = 마함全般
		CALL CARD_SET_BASIC(対面者,"묘지",ゾーン,場所,"裏側표시")
	ENDIF
ELSEIF 종류 == 필드→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22807,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件カテゴリ = 네크메이드
		효과条件山切り無し = 1
		CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所,5)
		IF RESULT == 1
			CALL CARD_DECK_DISPOSE(듀얼리스트,"덱",4)
		ENDIF
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		SS소환可能종족 = 언데드족
		CALL CARD_SS_RESTRICTION(듀얼리스트)
	ENDIF
ENDIF
