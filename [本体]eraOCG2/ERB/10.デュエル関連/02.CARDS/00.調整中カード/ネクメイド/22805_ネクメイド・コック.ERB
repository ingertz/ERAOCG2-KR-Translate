@CARDNAME_22805,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 네크메이드 쿡
	CASE "略称"
		RESULTS = NM 쿡
	CASE "カテゴリ"
		RESULTS:0 = 가실장
		RESULTS:1 = 네크메이드
ENDSELECT


@CARD_22805(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	;어둠속성/빛속성/땅속성/물속성/화염속성/바람속성
	CASE "속성"
		RETURN 빛속성

	CASE "종족"
		RETURN 언데드족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1200
	CASE "守備力"
		RETURN 700
	CASE "レア度"
		RETURN CMN
ENDSELECT
RETURN 0

@CARD_EXPLANATION_22805(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動,묘지起動)
PRINTL ①：자신フィールド上に「네크메이드 쿡」이외의 「네크메이드」モンスターが存在する場合に발동할 수 있다。
PRINTL 이 카드를 손패・묘지から특수 소환한다。
CALLFORM CARD_ABLE(2,발동誘発)
PRINTL ②：이 카드가 묘지に存在し、자신 필드에 「네크메이드」리추얼モンスターが存在する場合に、마법카드가 발동했을 때에 발동할 수 있다。
PRINTL 덱・ＥＸ덱에서 モンスター（빛속성／언데드족）を묘지に送り、その발동を무효로 하고 제외する。
PRINTL 그 후、その同名카드를 상대の마법함정 존에 덱 밖에서 セットする。
PRINTL このターン、이 효과로 セットしたカードと同名카드를 발동できない。


@CARDCAN_22805(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,22805)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動 || 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,22805)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,22805,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 네크메이드
	효과条件固名前 = 네크메이드 쿡
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF 발동済_2(듀얼리스트,22805)
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 네크메이드
	효과条件종류 = 초차원
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲EX덱 = 1
	효과条件속성 = 빛속성
	효과条件종족 = 언데드족
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과条件종류 = 마법全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_22805(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 특수발동
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 選択カード名前
#DIMS DYNAMIC 選択カード종류
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 묘지送カード,5

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動 || 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22805,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン, 場所)
	ENDIF
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22805,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲EX덱 = 1
		효과条件속성 = 빛속성
		효과条件종족 = 언데드족
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			選択カード = RESULT
		IF 選択カード != 9999
			CALL FULLRESET
			IF 마함数(対面者) >= 5
				CALL CARD_CHECK_START_DATA(듀얼리스트,1)
				CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"제외")
				PRINTFORMW  --  -  마법함정 존에 空きがありません。

			ELSEIF 마함数(対面者) < 5
				CALL FULLRESET
				효과条件종류 = 마법全般
				CALL CARD_CHECK_START_DATA(듀얼리스트,1)

				選択カード_ID = 効後_효과ID:(処理中番号 - 1)
				TRYCALLFORM CARD_{選択カード_ID}("종류")
				選択カード = 効後_設場所:(処理中番号 - 1) 
				TRYCALLFORM CARDNAME_{選択カード_ID}("名前")
				選択カード名前 = %RESULTS%
				
				CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"제외")
				
				CALL FULLRESET
				효과範囲상대묘지 = 1
				효과条件종류 = 마법全般
				효과条件名前 = %選択カード名前%
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			
				CALL FULLRESET
				CALL CARD_GENERATE_MAGIC(듀얼리스트,選択カード_ID,2,,1)
				CALL CARD_EFFECT_PROHIB(듀얼리스트,選択カード_ID,0,1)
				PRINTFORMW  --  -  %選択カード名前% がセットされました。
				

			ENDIF
		ENDIF
	ENDIF
	RETURN 0
ENDIF
