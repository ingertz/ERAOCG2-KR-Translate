@CARDNAME_31360,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 전지맨－버튼형
	CASE "略称"
		RESULTS = 버튼형
	CASE "カテゴリ"
		RESULTS:0 = 전지맨
ENDSELECT


@CARD_31360(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 100
	CASE "守備力"
		RETURN 100
	CASE "성별"
		RETURN 260101
ENDSELECT
RETURN 0

@CARD_EXPLANATION_31360(종류)
#DIM DYNAMIC 종류

CALLFORM CARD_ABLE(0,소환時,リバース誘発)
PRINTL ①：이 카드가 소환에 성공한 경우、또는 이 카드가 리버스된 경우에 발동할 수 있다。
PRINTL 덱에서 "전지맨－버튼형" 이외의 레벨４ 이하의 "전지맨" 몬스터 １장을 특수 소환한다。
CALLFORM CARD_ABLE(0,破壊→묘지,戦闘→묘지)
PRINTL ②：이 카드가 전투 / 효과로 파괴된 경우에 발동할 수 있다。
PRINTL 덱에서 카드를 １장 드로우한다。

@CARDCAN_31360(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,31360)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == リバース誘発
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 전지맨
	효과条件固名前 = 전지맨－버튼형
	효과条件소환可 = 1
	CALL 효과条件レベル_ADV(4, "以下")	
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF

@CARDEFFECT_31360(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

IF 종류 == 소환時 || 종류 == リバース誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31360)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 전지맨
		효과条件固名前 = 전지맨－버튼형
		CALL 효과条件レベル_ADV(4, "以下")	
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31360)
	IF RESULT == 0
		CALL CARDDRAW_BASIC(듀얼리스트,1)
	ENDIF
ENDIF

