@CARDNAME_31364,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 태양전지맨
	CASE "略称"
		RESULTS = 태양전지맨
	CASE "カテゴリ"
		RESULTS:0 = 전지맨
ENDSELECT


@CARD_31364(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 1500
	CASE "生成カード"
		RETURN 131364
	CASE "성별"
		RETURN 260101
ENDSELECT
RETURN 0

@CARD_EXPLANATION_31364(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②③の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,소환時 ,특수소환時)
PRINTL ①：このカードが소환・특수소환に成功した場合に발동できる。
PRINTL 덱から빛속성モンスター１体を묘지へ送る。
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：このカードが既にモンスターゾーンに存在する状態で、
PRINTL 「태양전지맨」以外の빛속성モンスターが소환・특수소환された場合に발동する。
PRINTL ゲーム外から「浮遊電力」１体を특수소환する。
CALLFORM CARD_ABLE(3,소환時 ,특수소환時)
PRINTL ③：자신のフィールド・묘지の빛속성・원소정령족モンスター１体を대상として발동できる。
PRINTL エンドフェイズまで、このカードはその同名カードとして扱う。

@CARDCAN_31364(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,31364)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,31364)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件속성 = 빛속성
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트,31364)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_最召場所") == 場所
		RETURN 0
	CALL FULLRESET
	효과条件속성 = 빛속성
	효과条件他所 = 1
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"소환全般",2)
	SIF RESULT != 1
		RETURN 0
	SIF モンスター数(듀얼리스트) >= 5
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動
	SIF 발동済_3(듀얼리스트,31364)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件속성 = 빛속성
	효과条件종족 = 원소정령족
	효과条件固名前 = 태양전지맨
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_31364(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 守備力修正
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名前
#DIM DYNAMIC 選択カード_ID

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31364,1)
	IF RESULT == 0
		CALL FULLRESET
		효과条件속성 = 빛속성
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"덱",ゾーン,場所)
	ENDIF

ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31364,2)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_GENERATE(듀얼리스트,131364)
	ENDIF

ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31364,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件속성 = 빛속성
		효과条件종족 = 원소정령족
		효과条件固名前 = 태양전지맨
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		選択カード = RESULT
		選択カード_ID = RESULT:99
		IF 選択カード != 9999
			TRYCALLFORM CARDNAME_{選択カード_ID}("名前")
			選択カード名前 = %RESULTS%
			CALL FULLRESET
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"変化元ID",選択カード_ID,上書きモード)
		ENDIF
	ENDIF
ENDIF

