@CARDNAME_36117,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 혹정의 우라노리코리스
	CASE "略称"
		RESULTS = 혹정의 천왕성
	CASE "カテゴリ"
		RESULTS:0 = 코스모스터
	CASE "検索用カテゴリ"
		RESULTS:0 = 코스모스 공주
ENDSELECT


@CARD_36117(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 0
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 미확인족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 900
	CASE "守備力"
		RETURN 1600
	CASE "추가日"
		RETURN 251018
ENDSELECT

RETURN 0

@CARD_EXPLANATION_36117(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 ①②의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時,특수소환時)
PRINTL ①：이 카드가 소환 / 특수 소환된 경우에 발동할 수 있다。
PRINTL 덱에서 이 카드명 이외의 "코스모스터" 몬스터 １장을 특수 소환한다。
CALLFORM CARD_ABLE(2,戦闘→묘지,破壊→묘지)
PRINTL ②：이 카드가 전투 / 효과로 파괴된 경우、또는 융합 소재가 된 경우에 발동할 수 있다。
PRINTL 자신은 １장 드로우한다。
PRINTL 그 후、상대 필드의 마법 / 함정 카드 １장을 파괴할 수 있다。


@CARDCAN_36117(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,36117)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,36117)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 코스모스터
	효과条件固名前 = 혹정의 우라노리코리스
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지 || 종류 == F素材時효과
	SIF 발동済_2(듀얼리스트,36117)
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF

@CARDEFFECT_36117(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 攻撃力修正

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,36117,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 코스모스터
		효과条件固名前 = 혹정의 우라노리코리스
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지 || 종류 == F素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,36117,2)
	IF RESULT == 0
		CALL CARDDRAW_BASIC(듀얼리스트,1)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲상대마함 = 1
			효과条件任意 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
		ENDIF
	ENDIF
ENDIF

