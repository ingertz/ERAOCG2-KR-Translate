@CARDNAME_57871,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 흑극정의 코스모스터
	CASE "略称"
		RESULTS = 흑극정
	CASE "カテゴリ"
		RESULTS:0 = 코스모스터
	CASE "検索用カテゴリ"
		RESULTS:0 = 코스모스 공주
ENDSELECT


@CARD_57871(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 미확인족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 2000
	CASE "守備力"
		RETURN 1900
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251018
ENDSELECT

RETURN 0


@CARD_EXPLANATION_57871(종류)
#DIM DYNAMIC 종류

PRINTL 미확인족 몬스터 ×２장
PRINTL 이 카드명의 ①의 효과는 1턴에 1번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,EX소환時)
PRINTL ①：이 카드가 융합 소환된 경우에 발동할 수 있다。
PRINTL 덱에서 "코스모스 공주" 카드를 ２장까디 패에 넣고、패를 １장 버린다。
CALLFORM CARD_ABLE(0,지속효과,攻守変動)
PRINTL ②：자신 필드의 미확인족 몬스터의 공격은 관통하고、
PRINTL 상대 필드의 몬스터의 공격력 / 수비력은 １０００내린다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：자신 필드에 "코스모스 공주" 몬스터가 존재하는 한、
PRINTL 자신 필드의 융합 몬스터는 효과로는 파괴되지 않는다。


@CARDSUMMON_57871(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件종족 = 미확인족


IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,57871) 
	RETURN RESULT
ENDIF


@CARDCAN_57871(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,57871)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX소환時
	SIF 발동済_1(듀얼리스트,57871)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 코스모스 공주
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻守変動 || 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_57871(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57871,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 코스모스 공주
		효과条件複数 = 98
		효과条件優先名前:0 = 해학의 코스모스 공주
		효과条件優先名前:1 = 뒤섞는 코스모스 공주
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲손패 = 1
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF

ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件종족 = 미확인족
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"貫通")
	
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 코스모스 공주
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 1
		CALL FULLRESET
		효과条件종류 = 융합
		CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"破耐")
	ENDIF

ELSEIF 종류 == 攻守変動
	CALL FULLRESET
	CALL STATCHANGE_BASIC(듀얼리스트,"상대필드",場所,-1000,-1000,57871)
ENDIF