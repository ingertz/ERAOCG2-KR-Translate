@CARDNAME_56581,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 괴수는 낙원을 파괴한다 아르키테
	CASE "略称"
		RESULTS = 낙원 아르키테
	CASE "カテゴリ"
		RESULTS:0 = 아르키테
		RESULTS:1 = 괴수
		RESULTS:2 = 브랜트 게이트
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_56581(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 초차원
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 사이킥족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 牝性
	CASE "특수불가"
		RETURN 1
	CASE "連動ID"
		RETURN 2810
ENDSELECT

RETURN 0

@CARDSUMMON_56581(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要素材数 = 1
素材条件カテゴリ = 아르키테

IF EX参照 == 1
	CALL STRIDECAN(듀얼리스트,소환カード,56581) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_56581(종류)
#DIM DYNAMIC 종류

CALL PRINT_STRIDETEXT("아르키테")
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(2,EX소환時)
PRINTL ①：이 카드가 『초월』한 경우에 발동할 수 있다。
PRINTL 덱 / 묘지에서 "괴수" 또는 "파괴수" 몬스터 １장을 ＥＸ덱으로 보낸다。
PRINTL 그 후、ＥＸ덱의 "괴수는 낙원을 파괴한다 아르키테" １장을 제외하는것으로、
PRINTL 자신은 상대 엔드 페이즈까지 이하의 능력을 얻을 수 있다。（이 효과는 중복되지 않는다）
PRINTL ●ＥＸ덱에서 "괴수" 또는 "파괴수" 몬스터가 특수 소환된 경우에 발동한다。
PRINTL 자신 필드의 "아르키테" 몬스터 이외의 ＥＸ덱에서 특수 소환된 "괴수" 또는 "파괴수" 몬스터 １장을 고른다。
PRINTL 그 몬스터는 몬스터 내성을 얻고、엔드 페이즈까지 공격력이 １０００ 오른다。
CALLFORM CARD_ABLE(3,필드起動)
PRINTL ②：자신 메인 페이즈１에 발동할 수 있다。
PRINTL ＥＸ덱에서 ＥＸ몬스터 이외의 "괴수" 또는 "파괴수" 몬스터 １장을 특수 소환한다。

@CARDCAN_56581(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,56581)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF 발동済_1(듀얼리스트,56581)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF ターン数 <= 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 아르키테
	CALL CARD_CHECK_ADV(듀얼리스트)
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_超越済") != 0
		RETURN 0
	SIF 듀얼리스트 != "상대"
		RETURN 0
	RETURN 1
ELSEIF 종류 == EX소환時
	SIF 발동済_2(듀얼리스트,56581)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ:0 = 괴수
	효과条件カテゴリ:1 = 파괴수
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 발동済_3(듀얼리스트,56581)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF メインフェイズ２ == 1
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件カテゴリ:0 = 괴수
	효과条件カテゴリ:1 = 파괴수
	효과条件종류 = EX以外全般
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 効後紋章起動
	CALL FULLRESET
	효과条件カテゴリ:0 = 괴수
	효과条件カテゴリ:1 = 파괴수
	효과条件召種 = 召種EX덱
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환")
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件固カテゴリ = 아르키테
	효과条件カテゴリ:0 = 괴수
	효과条件カテゴリ:1 = 파괴수
	효과条件召種 = 召種EX덱
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 時限紋章起動
	SIF ターンプレイヤー != 対面者 || エンドフェイズ != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_56581(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC カウンタC
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 효과先
#DIM DYNAMIC モンスター数
#DIM DYNAMIC ダメージ量
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 選択カードID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,56581,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ:0 = 괴수
		효과条件カテゴリ:1 = 파괴수
		효과条件종류 = モン全般
		효과条件行先플래그 = EX덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			IF 듀얼리스트 == "자신"
				SIF FINDELEMENT(자신_効後紋章,56581) != -1
					RETURN
			ELSE
				SIF FINDELEMENT(상대_効後紋章,56581) != -1
					RETURN
			ENDIF
			CALL FULLRESET
			효과範囲EX덱 = 1
			효과条件名前 = 괴수는 낙원을 파괴한다 아르키테
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1 && GETVAR(@"%듀얼리스트%_제외NG置換") < 1
				PRINTL ＥＸ덱의 "괴수는 낙원을 파괴한다 아르키테"를 제외하고 추가 능력을 얻으시겠습니까？
				CALL YN_CHOICE(듀얼리스트)
				IF RESULT == はい
					CALL FULLRESET
					효과範囲EX덱 = 1
					효과条件名前 = 괴수는 낙원을 파괴한다 아르키테
					효과条件行先플래그 = 제외行き
					CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
					IF RESULT == 1
						PRINTFORMW 괴수는 낙원을 파괴한다 아르키테의 효과가 세트되었습니다。(상대턴 종료시에 사라집니다)
						SETVAR @"%듀얼리스트%_時限紋章:%듀얼리스트%_時限紋章カウンタ", 56581
						SETVAR @"%듀얼리스트%_時限紋章カウンタ", GETVAR(@"%듀얼리스트%_時限紋章カウンタ") + 1
						SETVAR @"%듀얼리스트%_効後紋章:%듀얼리스트%_効後紋章カウンタ", 56581
						SETVAR @"%듀얼리스트%_効後紋章カウンタ", GETVAR(@"%듀얼리스트%_効後紋章カウンタ") + 1
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,56581,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件カテゴリ:0 = 괴수
		효과条件カテゴリ:1 = 파괴수
		효과条件종류 = EX以外全般
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 効後紋章起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,56581,0)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件固カテゴリ = 아르키테
		효과条件カテゴリ:0 = 괴수
		효과条件カテゴリ:1 = 파괴수
		효과条件召種 = 召種EX덱
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"モ耐",2,上書きモード)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"一攻",1000)
		ENDIF
	ENDIF
ELSEIF 종류 == 時限紋章起動
	IF 듀얼리스트 == "자신"
		DO
			カウンタ = FINDELEMENT(자신_時限紋章,56581)
			ARRAYREMOVE 자신_時限紋章,カウンタ,1
			SETVAR @"%듀얼리스트%_時限紋章カウンタ", GETVAR(@"%듀얼리스트%_時限紋章カウンタ") - 1
		LOOP FINDELEMENT(자신_時限紋章,56581) != -1
		DO
			カウンタ = FINDELEMENT(자신_効後紋章,56581)
			ARRAYREMOVE 자신_効後紋章,カウンタ,1
			SETVAR @"%듀얼리스트%_効後紋章カウンタ", GETVAR(@"%듀얼리스트%_効後紋章カウンタ") - 1
		LOOP FINDELEMENT(자신_効後紋章,56581) != -1
	ELSE
		DO
			カウンタ = FINDELEMENT(상대_時限紋章,56581)
			ARRAYREMOVE 상대_時限紋章,カウンタ,1
			SETVAR @"%듀얼리스트%_時限紋章カウンタ", GETVAR(@"%듀얼리스트%_時限紋章カウンタ") - 1
		LOOP FINDELEMENT(상대_時限紋章,56581) != -1
		DO
			カウンタ = FINDELEMENT(상대_効後紋章,56581)
			ARRAYREMOVE 상대_効後紋章,カウンタ,1
			SETVAR @"%듀얼리스트%_効後紋章カウンタ", GETVAR(@"%듀얼리스트%_効後紋章カウンタ") - 1
		LOOP FINDELEMENT(상대_効後紋章,56581) != -1
	ENDIF

ENDIF



