@CARDNAME_71683,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 분류에너지의 연구
	CASE "略称"
		RESULTS = 분류Ｅ의 연구
	CASE "カテゴリ"
		RESULTS:0 = 아르키테
		RESULTS:1 = 괴수
		RESULTS:2 = 파괴수
		RESULTS:3 = 브랜트 게이트
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_71683(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 지속마법
ENDSELECT

RETURN 0

@CARD_EXPLANATION_71683(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 카드는 １턴에 １밖에 발동할 수 없으며、③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①：이 카드의 발동시의 효과 처리로서、
PRINTL 덱에서 "괴수" 또는 "파괴수" 몬스터 １장을 묘지로 보낼 수 있다。
CALLFORM CARD_ABLE(0,소환強制誘発)
PRINTL ②：자신 필드에 "괴수" 또는 "파괴수" 몬스터가 특수 소환될 때 마다、
PRINTL 이 카드에 개별 카운터를 １개 놓는다。（최대 ３개）
CALLFORM CARD_ABLE(2,마함起動)
PRINTL ③：자신 메인 페이즈에、이 카드에 놓인 개별 카운터를 ２개 제거하고、
PRINTL 패 / 필드（앞면 표시） / 묘지의 "괴수" 또는 "파괴수" 몬스터 １장을 ＥＸ덱으로 보내고 발동할 수 있다。
PRINTL 덱에서 이 카드명 이외의 "괴수" 또는 "파괴수" 마법 / 함정 카드 １장을 패에 넣는다。

@CARDCAN_71683(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,71683)
SIF RESULT == 1
	RETURN 0


IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 발동済_2(듀얼리스트,71683)
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_個Ｃ:場所") < 2
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ:0 = 괴수
	효과条件カテゴリ:1 = 파괴수
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ:0 = 괴수
	효과条件カテゴリ:1 = 파괴수
	효과条件固名前 = 분류에너지의 연구
	효과条件종류 = 마함全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환強制誘発
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	SIF 最終소환決者 != 듀얼리스트
		RETURN 0
	SIF 最終소환타입 != "특수"
		RETURN 0
	CALL CAT_CHECK("괴수",듀얼리스트,最終소환場所)
	SIF RESULT == 1
		条件달성 = 1
	CALL CAT_CHECK("파괴수",듀얼리스트,最終소환場所)
	SIF RESULT == 1
		条件달성 = 1
	SIF 条件달성 == 0
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_個Ｃ:場所") >= 3
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,71683)
		RETURN 0
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_71683(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71683,2)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"個Ｃ",-2)
		PRINTFORML 분류에너지의 연구『{場所}』から個別카운터が２つ取り除かれました。
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ:0 = 괴수
		효과条件カテゴリ:1 = 파괴수
		효과条件종류 = モン全般
		효과条件行先플래그 = EX덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ:0 = 괴수
			효과条件カテゴリ:1 = 파괴수
			효과条件固名前 = 분류에너지의 연구
			효과条件종류 = 마함全般
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 소환強制誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71683,0)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"個Ｃ",1)
		PRINTFORML 분류에너지의 연구『{場所}』に個別카운터が１つ置かれました。
	ENDIF
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71683,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ:0 = 괴수
		효과条件カテゴリ:1 = 파괴수
		효과条件종류 = モン全般
		효과条件任意 = 1
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF