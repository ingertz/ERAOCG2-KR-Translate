@CARDNAME_91676,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 이노센트 인 파라다이스
	CASE "略称"
		RESULTS = 아름다운박하파괴
	CASE "カテゴリ"
		RESULTS:0 = 아르키테
		;余談：海外版だと「Innocent Monster in Paradise」になって괴수(Monster)名称がついている
		RESULTS:1 = 괴수
		RESULTS:2 = 브랜트 게이트
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT

@CARD_91676(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 通常함정
ENDSELECT
RETURN 0

@CARDSUMMON_91676(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
RETURN 0

@CARD_EXPLANATION_91676(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALL CARD_ABLE(1,발동誘発)
PRINTL ①：자신フィールドに「아르키테」モンスターが存在する状態で、상대の마법・함정カードの효과が발동した場合に발동できる。
PRINTL その효과を無効にし、破壊する。
PRINTL その後、자신フィールドに「아르키테」モンスター以外のＥＸ덱から특수소환された「괴수」または「파괴수」モンスターが存在する場合、
PRINTL 상대フィールドのカード１枚を대상として破壊できる。
CALL CARD_ABLE(2,묘지起動)
PRINTL ②：자신メインフェイズに、
PRINTL ＥＸ덱からＥＸモンスター以外の「괴수」または「파괴수」モンスター１体を묘지に送って발동できる。
PRINTL 묘지のこのカードを자신フィールドにセットする。
PRINTL この효과でセットしたこのカードはフィールドから離れた場合に제외される。

@CARDCAN_91676(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,91676)
SIF RESULT == 1
	RETURN 0

IF 종류 == 발동誘発
	SIF 발동済_1(듀얼리스트,91676)
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과条件종류 = 마함全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 아르키테
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,91676)
		RETURN 0
	SIF 발동済_2(듀얼리스트,91676)
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件カテゴリ:0 = 괴수
	효과条件カテゴリ:1 = 파괴수
	효과条件종류 = EX以外全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
    RETURN 1
ENDIF

@CARDEFFECT_91676(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 修正値

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91676,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"묘지")
		IF RESULT == 1
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件カテゴリ:0 = 괴수
			효과条件カテゴリ:1 = 파괴수
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲필드 = 1
				효과範囲마함 = 1
				효과条件除去種 = 묘지
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT == 1
					CALL FULLRESET
					효과条件除去種 = 묘지
					효과条件任意 = 1
					CALL CARD_REMOVAL_BASIC(듀얼리스트,"全場単体",場所,"묘지")
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	RETURN 0
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91676,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件カテゴリ:0 = 괴수
		효과条件カテゴリ:1 = 파괴수
		효과条件종류 = EX以外全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과추가종류 = 効追除処
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き,1)
		ENDIF
	ENDIF
ENDIF