@CARDNAME_56580,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 괴수의 창조자 아르키테
	CASE "略称"
		RESULTS = 창조자 아르키테
	CASE "カテゴリ"
		RESULTS:0 = 아르키테
		RESULTS:1 = 괴수
		RESULTS:2 = 브랜트 게이트
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_56580(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 사이킥족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 1500
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		RETURN 2810
ENDSELECT
RETURN 0

@CARDSUMMON_56580(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
	必要링크数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = 아르키테
ENDIF

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,56580) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_56580(종류)
#DIM DYNAMIC 종류

PRINTL "아르키테" 몬스터를 포함하는 몬스터 ２장
PRINTL 이 카드명의 ①②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,EX소환時)
PRINTL ①：이 카드가 Ｌ소환된 경우에 발동할 수 있다。
PRINTL 덱에서 "괴수" 또는 "파괴수"마법 / 함정 카드 １장을 패에 넣는다。
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：몬스터의 효과가 발동된 경우에 발동할 수 있다。
PRINTL ＥＸ덱에서 ＥＸ몬스터 이외의 "괴수" 또는 "파괴수" 몬스터 １장을 특수 소환한다。
CALLFORM CARD_ABLE(3,필드起動)
PRINTL ③：자신 메인 페이즈에、이 턴에 자신이 『초월』하지 않은 경우에、
PRINTL ＥＸ덱의 ＥＸ몬스터 이외의 몬스터 １장을 묘지로 보내고、
PRINTL 패 / 필드（앞면 표시）의 이 카드 이외의 "괴수" 또는 "파괴수" 몬스터 １장을 ＥＸ덱으로 보내고 발동할 수 있다。
PRINTL ＥＸ덱의 "괴수는 낙원을 파괴한다 아르키테" １장을 이 카드에『초월』한다。
PRINTL （이 효과는 선공 １턴째에도 발동할 수 있다）

@CARDCAN_56580(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,56580)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX소환時
	SIF 발동済_1(듀얼리스트,56580)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ:0 = 괴수
	효과条件カテゴリ:1 = 파괴수
	효과条件종류 = 마함全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트,56580)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"효과발동",2)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件カテゴリ:0 = 괴수
	효과条件カテゴリ:1 = 파괴수
	효과条件종류 = EX以外全般
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 발동済_3(듀얼리스트,56580)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_超越済") != 0
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = EX以外全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲필드 = 1
	효과条件カテゴリ:0 = 괴수
	효과条件カテゴリ:1 = 파괴수
	효과条件종류 = EX以外全般
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件名前 = 괴수는 낙원을 파괴한다 아르키테
	CALL CARD_CHECK_ADV(듀얼리스트)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_56580(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,56580,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ:0 = 괴수
		효과条件カテゴリ:1 = 파괴수
		효과条件종류 = 마함全般
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,56580,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件カテゴリ:0 = 괴수
		효과条件カテゴリ:1 = 파괴수
		효과条件종류 = EX以外全般
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,56580,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件종류 = EX以外全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲손패 = 1
			효과条件カテゴリ:0 = 괴수
			효과条件カテゴリ:1 = 파괴수
			효과条件표시 = 表側표시
			효과条件他所 = 1
			효과条件종류 = EX以外全般
			효과条件行先플래그 = EX덱行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,소멸行き)
				CALL FULLRESET
				효과条件名前 = 괴수는 낙원을 파괴한다 아르키테
				CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
				IF RESULT != 9999
					選択カード = RESULT
					選択カードID = 56580
					CALL CARD_LOADUP
					PRINTFORML
					PRINTFORML
					PRINTFORML 초월《스트라이드》、제너레이션！
					RESETCOLOR
					CALL PRINT_STATE_DUEL(選択カードID)
					CALL FULLRESET
					CALL CARD_EX_SUMMON(듀얼리스트,"EX덱",選択カード,"攻撃표시")
					SETVAR @"%듀얼리스트%_MZ_変化元ID:カード소환先", 選択カードID
					CALL SET_PLAYER_INFO(듀얼리스트,"超越済",1)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
