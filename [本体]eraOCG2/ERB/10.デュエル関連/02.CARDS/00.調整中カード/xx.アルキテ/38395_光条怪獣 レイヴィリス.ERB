@CARDNAME_38395,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 광망괴수 레이빌리스
	CASE "略称"
		RESULTS = 레이빌리스
	CASE "カテゴリ"
		RESULTS:0 = 괴수
		RESULTS:1 = 브랜트 게이트
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_38395(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 3200
	CASE "守備力"
		RETURN 3200
	CASE "성별"
		RETURN 無性
ENDSELECT
RETURN 0

@CARD_EXPLANATION_38395(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：이 카드는 대상 내성을 갖는다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：ＥＸ덱에서 특수 소환된 이 몬스터가 필드에 앞면 표시로 존재하는 한、
PRINTL 자신 필드에 "아르키테" 몬스터는 공격 회피를 얻는다。
CALLFORM CARD_ABLE(1,발동誘発)
PRINTL ③：자신 필드에 "아르키테" 몬스터가 존재하는 상태로、몬스터의 효과가 발동했을 때에、
PRINTL ＥＸ덱의 ＥＸ몬스터 이외의 몬스터 １장을 묘지로 보내고、상대 필드의 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터의 효과를 턴 종료시까지 무효로 하고、공격력 / 수비력을 １０００내린다。


@CARDCAN_38395(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,38395)
SIF RESULT == 1
	RETURN 0


IF 종류 == 발동誘発
	SIF 발동済_1(듀얼리스트,38395)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 아르키테
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = EX以外全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,2)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件除去種 = 選択
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_38395(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 修正値


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,38395,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件종류 = EX以外全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"無効")
			IF RESULT == 1
				CALL CARD_SELECT(듀얼리스트,RESULT:1)
				選択カード = 選択カード（CS）
				CALL SET_FIELD_INFO(対面者,"필드",選択カード,"一攻",-1000)
				CALL SET_FIELD_INFO(対面者,"필드",選択カード,"一守",-1000)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"対耐")
	IF GETVAR(@"%듀얼리스트%_MZ_召種:場所") == 召種EX덱
		CALL FULLRESET
		효과条件カテゴリ = 아르키테
		CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"攻避")
	ENDIF
ENDIF
