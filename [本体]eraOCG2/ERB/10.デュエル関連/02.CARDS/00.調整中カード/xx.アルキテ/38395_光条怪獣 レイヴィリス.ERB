@CARDNAME_38395,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 광망괴수 레이빌리스
	CASE "略称"
		RESULTS = 레이빌리스
	CASE "カテゴリ"
		RESULTS:0 = 괴수
		RESULTS:1 = 브랜트 게이트
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_38395(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 3200
	CASE "守備力"
		RETURN 3200
	CASE "성별"
		RETURN 無性
ENDSELECT
RETURN 0

@CARD_EXPLANATION_38395(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の③の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：このカードは대상耐性を持つ。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：ＥＸ덱から특수소환されたこのモンスターがフィールドに表側표시で存在する限り、
PRINTL 자신フィールドに「아르키테」モンスターは攻撃回避を得る。
CALLFORM CARD_ABLE(1,발동誘発)
PRINTL ③：자신フィールドに「아르키테」モンスターが存在する状態で、モンスターの효과が발동した時に、
PRINTL ＥＸ덱のＥＸモンスター以外のモンスター１体を묘지に送り、상대フィールドのモンスター１体を대상として발동できる。
PRINTL そのモンスターの효과をターン終了時まで無効にし、攻撃力・守備力を１０００ダウンする。


@CARDCAN_38395(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,38395)
SIF RESULT == 1
	RETURN 0


IF 종류 == 발동誘発
	SIF 발동済_1(듀얼리스트,38395)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 아르키테
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = EX以外全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,2)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件除去種 = 選択
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_38395(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 修正値


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,38395,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件종류 = EX以外全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"無効")
			IF RESULT == 1
				CALL CARD_SELECT(듀얼리스트,RESULT:1)
				選択カード = 選択カード（CS）
				CALL SET_FIELD_INFO(対面者,"필드",選択カード,"一攻",-1000)
				CALL SET_FIELD_INFO(対面者,"필드",選択カード,"一守",-1000)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"対耐")
	IF GETVAR(@"%듀얼리스트%_MZ_召種:場所") == 召種EX덱
		CALL FULLRESET
		효과条件カテゴリ = 아르키테
		CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"攻避")
	ENDIF
ENDIF
