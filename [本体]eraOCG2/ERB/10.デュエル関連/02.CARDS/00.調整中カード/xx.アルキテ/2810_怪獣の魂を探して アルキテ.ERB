@CARDNAME_2810,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 괴수의 혼을 찾아서 아르키테
	CASE "略称"
		RESULTS = 아르키테
	CASE "カテゴリ"
		RESULTS:0 = 아르키테
		RESULTS:1 = 괴수
		RESULTS:2 = 브랜트 게이트
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_2810(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 사이킥족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 500
	CASE "성별"
		RETURN 牝性
ENDSELECT
RETURN 0

@CARD_EXPLANATION_2810(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時,특수소환時)
PRINTL ①：이 카드가 소환 / 특수 소환된 경우에、패를 １장 버리고 발동할 수 있다。
PRINTL 덱에서 "괴수" 또는 "파괴수" 마법 / 함정 카드 １장을 패에 넣는다。
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：이 카드명 이외의 자신의 "괴수" 또는 "파괴수" 카드의 효과가 발동된 경우에、
PRINTL 패 / 묘지의 ＥＸ몬스터 이외의 몬스터 １장을 ＥＸ덱으로 보내고 발동할 수 있다。
PRINTL 자신 또는 상대 필드에 "마기카라이트 결정 토큰" １장을 수비 표시로 특수 소환한다。

@CARDCAN_2810(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,2810)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,2810)
		RETURN 0
	SIF 손패数(듀얼리스트) < 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ:0 = 괴수
	효과条件カテゴリ:1 = 파괴수
	효과条件종류 = 마함全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트,2810)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲묘지 = 1
	효과条件종류 = EX以外全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과条件固名前 = 괴수의 혼을 찾아서 아르키테
	효과条件カテゴリ:0 = 괴수
	효과条件カテゴリ:1 = 파괴수
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"효과발동")
	SIF RESULT != 1
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,102810)
	SIF RESULT == 0
		条件달성 = 1
	CALL CARD_SS_CHECK(듀얼리스트,102810,,,1)
	SIF RESULT == 0
		条件달성 = 1
	SIF 条件달성 != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_2810(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件A
#DIM DYNAMIC 条件B
#DIM DYNAMIC 選択효과


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,2810,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ:0 = 괴수
			효과条件カテゴリ:1 = 파괴수
			효과条件종류 = 마함全般
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,2810,2)
	IF RESULT == 0
		CALL CARD_SS_CHECK(듀얼리스트,102810)
		SIF RESULT == 0
			条件A = 1
		CALL CARD_SS_CHECK(듀얼리스트,102810,,,1)
		SIF RESULT == 0
			条件B = 1
		IF 条件A || 条件B
			CALL FULLRESET
			효과範囲손패 = 1
			효과範囲묘지 = 1
			효과条件종류 = EX以外全般
			효과条件行先플래그 = EX덱行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				IF 条件A == 1 && 条件B == 1
					CALL YN_CHOICE(듀얼리스트,"자신 필드에 「마기카라이트 결정」토큰을 수비 표시로 특수 소환한다。","상대 필드에 「마기카라이트 결정」토큰을 수비 표시로 특수 소환한다。")
					選択효과 = RESULT
				ELSEIF 条件A == 1
					選択효과 = はい
				ELSEIF 条件B == 1
					選択효과 = いいえ
				ENDIF
				IF 選択효과 == はい
					CALL CARD_GENERATE(듀얼리스트,102810,"守備표시")
				ELSE
					CALL CARD_GENERATE(듀얼리스트,102810,"守備표시",1)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF

