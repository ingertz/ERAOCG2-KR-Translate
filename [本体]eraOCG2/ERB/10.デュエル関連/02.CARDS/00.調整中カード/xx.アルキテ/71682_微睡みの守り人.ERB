@CARDNAME_71682,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 겉잠의 수호자
	CASE "略称"
		RESULTS = 겉잠의 수호자
	CASE "カテゴリ"
		RESULTS:0 = 아르키테
		RESULTS:1 = 괴수
		RESULTS:2 = 파괴수
		RESULTS:3 = 브랜트 게이트
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_71682(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 지속마법
ENDSELECT

RETURN 0

@CARD_EXPLANATION_71682(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 카드는 １턴에 １장밖에 발동할 수 없으며、③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①：이 카드의 발동시의 효과처리로서、
PRINTL 덱에서 "괴수" 또는 "파괴수" 몬스터 １장을 묘지로 보낼 수 있다。
CALLFORM CARD_ABLE(0,소환強制誘発)
PRINTL ②：자신 필드에 ＥＸ덱에서 "괴수" 또는 "파괴수" 몬스터가 특수 소환될 때 마다、
PRINTL 이 카드에 개별 카운터를 １개 놓는다。（최대 ５개）
CALLFORM CARD_ABLE(2,마함起動)
PRINTL ③：자신 메인 페이즈에、이 카드에 놓인 개별 카운터를 ２개 제거하고 발동할 수 있다。
PRINTL 묘지에서 이 카드명 이외의 "괴수" 또는 "파괴수"카드 １장을 패에 넣는다。

@CARDCAN_71682(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,71682)
SIF RESULT == 1
	RETURN 0


IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 발동済_2(듀얼리스트,71682)
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_個Ｃ:場所") < 2
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ:0 = 괴수
	효과条件カテゴリ:1 = 파괴수
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환強制誘発
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	SIF 最終소환決者 != 듀얼리스트
		RETURN 0
	SIF 最終소환타입 != "특수"
		RETURN 0
	CALL CAT_CHECK("괴수",듀얼리스트,最終소환場所)
	SIF RESULT == 1
		条件달성 = 1
	CALL CAT_CHECK("파괴수",듀얼리스트,最終소환場所)
	SIF RESULT == 1
		条件달성 = 1
	SIF 条件달성 == 0
		RETURN 0
	SIF GETVAR (@"%듀얼리스트%_MZ_召種:最終소환場所") != 召種EX덱
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_個Ｃ:場所") >= 5
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,71682)
		RETURN 0
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_71682(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71682,2)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"個Ｃ",-2)
		PRINTFORML 겉잠의 수호자『{場所}』에게서 개별 카운터가 ２개 제거되었습니다。
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ:0 = 괴수
		효과条件カテゴリ:1 = 파괴수
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 소환強制誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71682,0)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"個Ｃ",1)
		PRINTFORML 겉잠의 수호자『{場所}』에게 개별 카운터가 １개 놓였습니다。
	ENDIF
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71682,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ:0 = 괴수
		효과条件カテゴリ:1 = 파괴수
		효과条件종류 = モン全般
		효과条件任意 = 1
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF