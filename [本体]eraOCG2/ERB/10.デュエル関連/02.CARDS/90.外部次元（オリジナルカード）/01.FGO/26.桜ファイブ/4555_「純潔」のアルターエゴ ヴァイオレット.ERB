@CARDNAME_4555,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 「순결」의 얼터에고 바이올렛
	CASE "略称"
		RESULTS = 바이올렛
	CASE "カテゴリ"
		RESULTS:0 = 영령
		RESULTS:1 = SE.RA.PH
		RESULTS:2 = 얼터에고
	CASE "出典作品"
		RESULTS:0 = FATE
ENDSELECT


@CARD_4555(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 사이버스족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 2100
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251225
ENDSELECT
RETURN 0

@CARD_EXPLANATION_4555(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,필드→묘지,戦闘→묘지,破壊→묘지,손패→묘지,덱→묘지,제외時)
PRINTL ①：이 카드가 묘지로 보내진 경우、또는 제외된 경우에 발동할 수 있다。
PRINTL 이 카드를 특수 소환한다。
PRINTL 이 효과로 특수 소환된 이 카드의 레벨은 ６이 된다。
PRINTL 이 턴、자신은 EX덱에서 "영령" 몬스터밖에 특수 소환할 수 없다。
CALLFORM CARD_ABLE(2,특수소환時)
PRINTL ②：이 카드가 특수 소환된 경우에 발동할 수 있다。
PRINTL "「순결」의 얼터에고 바이올렛"을 제외한 "영령" 카드 １장을 덱에서 패에 넣는다。


@CARDSUMMON_AA_4555


@CARDCAN_4555(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,4555)
SIF RESULT == 1
	RETURN 0

IF GROUPMATCH(종류,필드→묘지,戦闘→묘지,破壊→묘지,손패→묘지,덱→묘지,제외時)
	SIF 발동済_1(듀얼리스트,4555)
		RETURN 0
	; 이 카드가 묘지로 보내진 경우、または제외된 경우에 발동할 수 있다。
	IF 종류 == 제외時
		CALL CARD_SS_CHECK(듀얼리스트,4555,"제외")
		SIF RESULT == 1
			RETURN 0
	ELSE
		CALL CARD_SS_CHECK(듀얼리스트,4555,"묘지")
		SIF RESULT == 1
			RETURN 0
	ENDIF
	RETURN 1
ELSEIF 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,4555)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 영령
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_4555(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 元攻撃力
#DIM DYNAMIC 元守備力

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF GROUPMATCH(종류,필드→묘지,戦闘→묘지,破壊→묘지,손패→묘지,덱→묘지)
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4555,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 「순결」의 얼터에고 바이올렛
		; 이 효과로 특수 소환된 이 카드의 レベルは６になる。
		효과추가종류 = 140 + 6
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		CALL CARD_EX_RESTRICTION(듀얼리스트,"영령")
	ENDIF
ELSEIF 종류 == 제외時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4555,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲제외 = 1
		효과条件名前 = 「순결」의 얼터에고 바이올렛
		; 이 효과로 특수 소환된 이 카드의 レベルは６になる。
		효과추가종류 = 140 + 6
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		CALL CARD_EX_RESTRICTION(듀얼리스트,"영령")
	ENDIF
ELSEIF 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4555,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 영령
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF



