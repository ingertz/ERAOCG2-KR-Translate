@CARDNAME_64500,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 영령 소환 시스템
	CASE "略称"
		RESULTS = 영령 소환
	CASE "カテゴリ"
		RESULTS:0 = 이문대
	CASE "出典作品"
		RESULTS:0 = FATE
ENDSELECT


@CARD_64500(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 通常마법
	CASE "추가日"
		RETURN 250412
ENDSELECT

RETURN 0

@CARD_EXPLANATION_64500(종류)
#DIM DYNAMIC 종류

;１プレイいくらかわかんないからとりあえず１０００
PRINTL 이 카드명의 ①의 효과는 1턴에 한 번밖에 사용할 수 없다.
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①：1000LP를 지불하고 발동할 수 있다.
PRINT 덱의 위에서 ３장보고、그 안에서 "영령" 카드를 ２장까지 패에 넣는을 수 있다。
PRINT 패에 넣지 못했을 경우、추가로 １０００포인트 지불하고、덱을 셔플하고、이 효과를 반복한다。
PRINT 

@CARDCAN_64500(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,64500)
SIF RESULT == 1
	RETURN 0

;汎用処理
IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,64500)
		RETURN 0
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"ライフ_%듀얼리스트%") <= 1000
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT <= 3
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_64500(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 破壊횟수


IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,64500,1)
	IF RESULT == 0
		$REPEAT_TO
		CALL LIFE_CHANGE(듀얼리스트,"減少","コスト",1000)
		CALL FULLRESET
		효과条件カテゴリ = 영령
		효과条件複数 = 98
		효과条件任意 = 1
		CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所,3)
		IF RESULT == 0
			PRINTL 한 번 더 사용하시겠습니까?
			CALL YN_CHOICE(듀얼리스트)
			IF RESULT == 0
				CALL SHUFFLE(듀얼리스트)
				GOTO REPEAT_TO
			ENDIF
		ENDIF
	ENDIF
ENDIF
