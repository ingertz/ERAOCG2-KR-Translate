@CARDNAME_205550,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 비술 그레이 서머터지
	CASE "略称"
		RESULTS = 비술 그레이 서머터지
	CASE "カテゴリ"
		RESULTS:0 = 스펠 카드
ENDSELECT


@CARD_205550(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 速攻마법
	CASE "トークン"
		RETURN 1
ENDSELECT

RETURN 0

@CARD_EXPLANATION_205550(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(10,마함起動 ,손패起動)
PRINTL ①：자신 필드의 몬스터는 이 턴 중 １번만 전투、효과로는 파괴되지 않는다。
PRINTL 자신 필드의 "기적의 무녀 사나에"가 파괴된 경우、
PRINTL 자신의 묘지에서 "기적의 무녀 사나에"를 특수 소환하고, 이 카드는 "라스트 워드"가 된다。
CALL TEXT_DECORATION("LASTWORD")
PRINTL ●패 / 묘지에서 바람속성 의식 몬스터를 ２장까지 소환 조건을 무시하고 특수 소환한다。


@CARDCAN_205550(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,205550)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,205550)
		RETURN 0
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_205550(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC ダメージ量

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,205550,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		
		CALL FULLRESET
		효과条件名前 = 기적의 무녀 사나에
		CALL CARD_CHECK_FIN_DATA(듀얼리스트,"破壊全般")
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件名前 = 기적의 무녀 사나에
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)

			CALLFORM CHARA_CUTIN("Last Word","모 세 의 기 적",,,,,1)
			CALL FULLRESET
			효과範囲손패 = 1
			효과範囲묘지 = 1
			효과条件종류 = 의식
			효과条件속성 = 바람속성
			효과条件特不無視 = 1
			효과条件複数 = 98
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ELSE			
			CALLFORM CHARA_CUTIN("Spell Card","「비술」그레이 서머터지",,,,,1)
		ENDIF
		CALL FULLRESET
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"一破",1)

	ENDIF
ENDIF
