@CARDNAME_5540,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 까마귀천구 날조기자 아야
	CASE "略称"
		RESULTS = 샤메이마루 아야
	CASE "カテゴリ"
		RESULTS:0 = 요괴의 산
		RESULTS:1 = 환상소녀
	CASE "出典作品"
		RESULTS:0 = 동방 Project
ENDSELECT


@CARD_5540(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 비행야수족
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 2300
	CASE "守備力"
		RETURN 2100
	CASE "성별"
		RETURN 牝性
	CASE "生成カード"
		RETURN 205540
	CASE "추가日"
		RETURN 251130
ENDSELECT

RETURN 0

@CARD_EXPLANATION_5540(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,손패起動,フリー誘発)
PRINTL ①：いずれかのプレイヤーが덱からカードを３枚以上손패に加えたターンに발동できる。
PRINTL このカードを손패から특수소환する。
CALLFORM CARD_ABLE(2,발동誘発)
PRINTL ②：상대が효과を발동した場合に발동できる。
PRINTL 상대フィールドのモンスターを最大１体を選び、このカードを손패に戻す。
PRINTL こうして選んだモンスターの효과を次のフェイズまで無効にし、자신はカードを１枚ドローする。


@CARDCAN_5540(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,5540)
SIF RESULT == 1
	RETURN 0
IF 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,5540)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,5540,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과추가종류 = 1
	효과条件CNT = 3
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"취득이력",2)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF 발동済_2(듀얼리스트,5540)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_5540(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5540,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트, ゾーン, 場所)
	ENDIF
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5540,2)
	IF RESULT == 0
		CALL FULLRESET
		효과추가종류 = 9
		효과条件任意 = 1
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"표시변경")
		SIF RESULT == 1
			CALL CARDDRAW_BASIC(듀얼리스트,1)
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,손패行き)
	ENDIF
ENDIF
