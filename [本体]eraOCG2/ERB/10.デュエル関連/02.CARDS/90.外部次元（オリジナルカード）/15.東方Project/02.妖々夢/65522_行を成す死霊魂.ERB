@CARDNAME_65522,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 생을 이룬 사령혼
	CASE "略称"
		RESULTS = 생을 이룬 사령혼
	CASE "カテゴリ"
		RESULTS:0 = 백옥루
	CASE "出典作品"
		RESULTS:0 = 동방 Project
ENDSELECT

@CARD_65522(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 通常마법
	CASE "生成カード"
		RETURN 165522
	CASE "추가日"
		RETURN 250808
ENDSELECT
RETURN 0


@CARD_EXPLANATION_65522(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,손패起動,마함起動,フリー誘発)
PRINTL ①：자신의 패에서 몬스터 카드 1장을 버리고 발동할 수 있다。
PRINTL 서로의 제외되어 있는 몬스터를 모두 묘지로 되돌린다。
CALL CARD_ABLE(2,필드→묘지,破壊→묘지,손패→묘지,덱→묘지)
PRINTL ②：이 카드가 카드의 효과로 묘지로 보내진 경우에 발동할 수 있다。
PRINTL 자신의 묘지에서, 레벨4 이하의 언데드족 몬스터 1장을 패에 넣는다。

@CARDCAN_65522(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ数

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,65522)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,65522)
		RETURN 0
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲제외 = 1
	효과範囲상대제외 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 破壊→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지
	SIF 발동済_2(듀얼리스트,65522)
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종족 = 언데드족
	CALL 효과条件レベル_ADV(4, "以下")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_65522(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 戦闘カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,65522,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件종류 = モン全般
			CALL CARD_HYPER_DISPOSE(듀얼리스트,"제외",묘지行き)

			CALL FULLRESET
			효과条件종류 = モン全般
			CALL CARD_HYPER_DISPOSE(듀얼리스트,"상대제외",묘지行き)
		ENDIF
	ENDIF
ELSEIF 종류 == 필드→묘지 || 종류 == 破壊→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,65522,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종족 = 언데드족
		CALL 효과条件レベル_ADV(4, "以下")
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF
