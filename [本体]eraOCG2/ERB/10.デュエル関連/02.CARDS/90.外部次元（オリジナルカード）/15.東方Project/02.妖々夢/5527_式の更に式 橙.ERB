@CARDNAME_5527,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 식의 식 첸
	CASE "略称"
		RESULTS = 식신 첸
	CASE "カテゴリ"
		RESULTS:0 = 환상소녀
		RESULTS:4 = 동방 Project
ENDSELECT


@CARD_5527(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 야수족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1400
	CASE "守備力"
		RETURN 1600
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 250927
ENDSELECT

RETURN 0

@CARD_EXPLANATION_5527(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動,フリー誘発)
PRINTL ①：서로의 메인 페이즈에 필드에 수비력 １５００ 이하의 몬스터가 존재하는 경우에 발동한다。
PRINTL 패의 이 카드를 특수 소환한다。
PRINTL 그 후、덱에서 "스키마 요괴의 식 란"을 찾아、덱 가장 위에 놓는다。
CALLFORM CARD_ABLE(2,身代효과)
PRINTL ②：이 카드가 전투 / 효과로 파괴될 경우에 발동할 수 있다。
PRINTL 자신의 덱 가장 위의 카드를 뒤집어、그 카드가 "스키마 요괴의 식 란"일 경우、
PRINTL 카드를 １장 드로우하고、이 턴 이 카드는 전투 / 효과파괴 내성을 얻는다。



@CARDCAN_5527(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,5527)
SIF RESULT == 1
	RETURN 0
IF 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,5527)
		RETURN 0
	SIF ゾーン != "손패"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,5527,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件守備力 = 1500
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 身代효과
	SIF 발동済_2(듀얼리스트,5527)
		RETURN 0
	SIF !GROUPMATCH(ゾーン,"필드")
		RETURN 0
	SIF 破壊대상ゾーン != "필드"
		RETURN 0
	SIF 破壊대상場所 != 場所
		RETURN 0
	SIF !GROUPMATCH(破壊종류,"효과","戦闘")
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_5527(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5527,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트, ゾーン, 場所)
	ENDIF
ELSEIF 종류 == 身代효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5527,2)
	IF RESULT == 0
		TRYCALLFORM CARD_UI(GETVAR(@"%듀얼리스트%_덱:0"))
		PRINTW
		TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_덱:0")}("名前")
		IF RESULTS == "스키마 요괴의 식 란" 
			CALL CARDDRAW_BASIC(듀얼리스트,1)
			CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"破耐",1)
			CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"戦耐",1)
			RETURN 1
		ENDIF
	ENDIF
	RETURN 0
ENDIF

