@CARDNAME_96500,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = Ｘ항체
	CASE "略称"
		RESULTS = Ｘ항체
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
		RESULTS:1 = Ｘ항체
ENDSELECT


@CARD_96500(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 251230
ENDSELECT

RETURN 0

@CARD_EXPLANATION_96500(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動,フリー誘発)
PRINTL ①：자신 필드에 레벨 / 랭크가 ９이상인 "Ｘ항체"가 아닌 "디지몬" 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터와 종족 / 속성이 같고、그 몬스터의 레벨 / 랭크가 １개 높은 랭크를 가진 "Ｘ항체" X몬스터 １장을
PRINTL 대상 몬스터 위에 겹쳐서 Ｘ소환 취급으로 ＥＸ덱에서 특수 소환한다。
PRINTL 이 효과로 특수 소환한 몬스터는 일시파괴내성을 가지며,Ｘ소재를 1개 늘린다。
CALLFORM CARD_ABLE(2,묘지起動,フリー誘発)
PRINTL ②：이 카드가 묘지에 존재하는 경우、묘지의 "Ｘ항체" X몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 이 카드를 덱으로 되돌리고、대상의 카드를 EX덱으로 되돌린다。
PRINTL 

@CARDCAN_96500(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,96500)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")
	SIF 발동済_1(듀얼리스트,96500)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	CALL FULLRESET
	효과範囲필드 = 1
	CALL 효과条件レベル_ADV(9, "以上")
	효과条件종류 = 링크以外
	효과条件カテゴリ = 디지몬
	효과条件固カテゴリ = Ｘ항체
	효과条件RUM = 96500
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 묘지起動 || (종류 == フリー誘発 && ゾーン == "묘지")
	SIF 발동済_2(듀얼리스트,96500)
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	CALL FULLRESET

	효과範囲묘지 = 1
	효과条件カテゴリ = Ｘ항체
	효과条件종류 = 엑시즈
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_96500(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード,5
#DIM DYNAMIC 選択カードB
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC 選択名前
#DIM DYNAMIC 紋章場所
#DIM DYNAMIC 설정レベル
#DIM DYNAMIC 条件속성
#DIM DYNAMIC 条件종족

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,96500,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)

		CALL FULLRESET
		CALL 효과条件レベル_ADV(9, "以上")
		효과条件カテゴリ = 디지몬
		효과条件종류 = 링크以外
		효과条件固カテゴリ = Ｘ항체
		효과条件RUM = 96500
		효과条件표시 = 表側표시
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			選択カード_ID = RESULT:99

			설정レベル = GETVAR(@"%듀얼리스트%_MZ_星:選択カード")
			TRYCALLFORM CARD_{選択カード_ID}("속성")
			条件속성 = RESULT
			TRYCALLFORM CARD_{選択カード_ID}("종족")
			条件종족 = RESULT

			CALL FULLRESET
			효과条件カテゴリ = Ｘ항체
			효과条件종류 = 엑시즈
			효과条件レベル:0 = 설정レベル
			효과条件レベル:1 = 설정レベル + 1
			효과条件종족 = 条件종족
			효과条件속성 = 条件속성
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
			選択カードB = RESULT
			;戻る
			IF 選択カードB != 9999
				TRYCALLFORM CARDSUMMON_{GETVAR(@"%듀얼리스트%_EX덱:{選択カードB}")}(듀얼리스트,選択カードB)
				
				CALL RESETCONDITION_MAT(1)
				代替素材数 = 1
				重ねてＸ = 1
				효과추가종류:0 = 57
				효과추가종류:1 = 効追Ｘ素
				素材条件固定 = 選択カード
				TRYCALLFORM XYZSUMMON(듀얼리스트,選択カードB)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,96500,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,덱行き)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ= Ｘ항체
		효과条件종류 = 엑시즈	
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF

@CARDRUM_96500(듀얼리스트,ゾーン,場所,カードID)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カードID
#DIM DYNAMIC 설정カードID
#DIM DYNAMIC 素材レベル
#DIM DYNAMIC 素材속성
#DIM DYNAMIC 素材종족

VARSET RESULT

IF ゾーン == "필드"
	素材レベル = GETVAR(@"%듀얼리스트%_MZ_星:場所")
	素材속성 = GETVAR(@"%듀얼리스트%_MZ_属:場所")
	素材종족 = GETVAR(@"%듀얼리스트%_MZ_種:場所")
ELSE
	RETURN 0
ENDIF

FOR カウンタ,0,現EX山札数(듀얼리스트)
	설정カードID = GETVAR(@"%듀얼리스트%_EX덱:カウンタ")
	SIF 설정カードID == -1 
		CONTINUE
	TRYCALLFORM CARD_{설정カードID}("종족")
	SIF !MATCH(RESULT,素材종족)
		CONTINUE
	TRYCALLFORM CARD_{설정カードID}("속성")
	SIF !MATCH(RESULT,素材속성)
		CONTINUE
	TRYCALLFORM CARDNAME_{설정カードID}("カテゴリ")
	SIF !MATCH(RESULTS,"Ｘ항체")
		CONTINUE
	TRYCALLFORM CARD_{설정カードID}("종류")
	SIF RESULT != 엑시즈
		CONTINUE
	TRYCALLFORM CARD_{설정カードID}("レベル")
	SIF !GROUPMATCH(RESULT,素材レベル,素材レベル+1)
		CONTINUE
	VARSET RESULT
	RETURN 1
NEXT
	
VARSET RESULT
RETURN 0
