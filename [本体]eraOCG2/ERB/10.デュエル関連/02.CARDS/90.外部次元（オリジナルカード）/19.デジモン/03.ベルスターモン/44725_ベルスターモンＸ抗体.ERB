@CARDNAME_44725,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 베르스타몬Ｘ항체
	CASE "略称"
		RESULTS = 베르스타Ｘ
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
		RESULTS:1 = 삼총사
		RESULTS:2 = Ｘ항체
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_44725(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RESULT:1 = 사이버스족
		RETURN 악마족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 3300
	CASE "守備力"
		RETURN 2800
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251230
ENDSELECT

RETURN 0

@CARDSUMMON_44725(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 9
;추가효과用

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,44725) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_44725(종류)
#DIM DYNAMIC 종류

PRINTL 레벨９ 몬스터×２
PRINTL 디지몬 카드는 사이버스족으로도 취급한다。
PRINTL 이 카드명의 ①②③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,EX덱起動)
PRINTL ①："Ｘ항체"를 발동한 턴、이 카드는 자신 필드의 "베르스타몬"의 위에 겹쳐 X소환할 수 있다。
CALLFORM CARD_ABLE(2,EX소환時,특수소환時)
PRINTL ②：이 카드가 특수 소환에 성공한 경우에 발동할 수 있다。
PRINTL 자신의 패 / 덱 / 묘지에서 "디지몬" 마법 / 함정 카드 １장을 자신 필드에 세트한다。
PRINTL 이 효과로 세트한 속공 마법 / 함정 카드는 이 턴에 발동할 수 있다。
CALLFORM CARD_ABLE(3,필드起動,フリー誘発)
PRINTL ③：이 카드의 X소재를 １개 제거하고 발동할 수 있다。
PRINTL 상대 필드의 몬스터 카드와 마법 / 함정 카드를 각각 １장까지 파괴한다。
PRINTL 

@CARDCAN_44725(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성



CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,44725)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF 발동済_1(듀얼리스트,44725)
		RETURN 0
	SIF !발동済_1(듀얼리스트,34308)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,44725)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件名前 = 베르스타몬
	효과条件重ねてＸ = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == EX소환時 || 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,44725)
		RETURN 0

	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 디지몬
	효과条件종류 = 마함全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_3(듀얼리스트,44725)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0

	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0

	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_44725(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード生成カード
#DIMS DYNAMIC 選択カード生成カード名
#DIM DYNAMIC 選択カード生成カード１
#DIMS DYNAMIC 選択カード生成カード名１
#DIM DYNAMIC 選択カード生成カード２
#DIMS DYNAMIC 選択カード生成カード名２
#DIM DYNAMIC 選択カード生成カード３
#DIMS DYNAMIC 選択カード生成カード名３
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,44725,1)
	IF RESULT == 0
		CALL RESETCONDITION_MAT
		必要素材数 = 1
		효과条件名前 = 베르스타몬
		重ねてＸ = 1
		TRYCALLFORM XYZSUMMON(듀얼리스트,場所)
	ENDIF
ELSEIF 종류 == EX소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,44725,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 디지몬
		효과条件종류 = 마함全般
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"使化裏側표시")
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,44725,3,X消費1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件任意 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")

		CALL FULLRESET
		효과範囲상대마함 = 1
		효과条件任意 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
	ENDIF
ENDIF
