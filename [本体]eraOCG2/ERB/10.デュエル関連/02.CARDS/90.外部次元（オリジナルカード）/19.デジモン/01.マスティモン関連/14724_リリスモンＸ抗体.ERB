@CARDNAME_14724,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 리리스몬Ｘ항체
	CASE "略称"
		RESULTS = 리리스몬Ｘ
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_14724(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RESULT:1 = 사이버스족
		RETURN 악마족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 3200
	CASE "守備力"
		RETURN 2800
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		RETURN 4724
	CASE "추가日"
		RETURN 260120
ENDSELECT

RETURN 0

@CARD_EXPLANATION_14724(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드는 「Ｘ항체」の효과でしか특수 소환할 수 없다。
PRINTL 디지몬カードは사이버스족としても扱う。
PRINTL 이 카드명의 ②③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,지속효과)
PRINTL ①：이 카드가 Ｘ素材を持つ限り、상대는 이 카드를 攻撃・효과の대상にできない。
CALLFORM CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ②：자신 / 상대의 메인 페이즈에 발동할 수 있다。
PRINTL 상대필드에 存在する몬스터 １장の효과를 턴 종료시까지 無効にし、その컨트롤을 얻는다。
CALLFORM CARD_ABLE(3,발동誘発)
PRINTL ③：상대가 카드의 효과를 발동했을 때에 발동할 수 있다。
PRINTL 자신 필드에 存在する元々の持ち主が상대である몬스터 １장을 릴리스하고 그 발동을 무효로 한다。
PRINTL 그 후、상대필드에 存在する몬스터 １장までの효과를 턴 종료시까지 無効にし、その컨트롤을 얻는다。

@CARDCAN_14724(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성



CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,14724)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과 
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_2(듀얼리스트,14724)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件除去種 = 強奪
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF 발동済_3(듀얼리스트,14724)
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件所有 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_14724(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"攻避")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"対耐")
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,14724,2)
	IF RESULT == 0
		CALL FULLRESET
		효과추가종류:0 = 返却行き
		효과추가종류:1 = 22
		효과추가종류:2 = 26
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"強奪")
	ENDIF
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,14724,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件所有 = 2
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")
			IF RESULT == 1
				CALL FULLRESET
				효과추가종류:0 = 返却行き
				효과추가종류:1 = 22
				효과추가종류:2 = 26
				CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"強奪")
			ENDIF
		ENDIF
	ENDIF
ENDIF
