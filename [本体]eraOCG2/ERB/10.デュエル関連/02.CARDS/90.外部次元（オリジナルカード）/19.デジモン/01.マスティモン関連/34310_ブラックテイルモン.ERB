@CARDNAME_34310,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 블랙가트몬
	CASE "略称"
		RESULTS = Ｂ가트몬
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_34310(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RESULT:1 = 빛속성
		RETURN 어둠속성
	CASE "종족"
		RESULT:1 = 사이버스족
		RETURN 야수족
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 1800
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 260111
ENDSELECT

RETURN 0

@CARD_EXPLANATION_34310(종류)
#DIM DYNAMIC 종류

PRINTL 디지몬カードは사이버스족としても扱う。
PRINTL 이 카드는 빛속성としても扱う。
PRINTL 이 카드명의 ①의 효과는 デュエル中に１度しか使用できず、
PRINTL 이 카드명의 ②③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：패의 이 카드를 상대에게 보여주고 발동할 수 있다。
PRINTL 「블랙가트몬」を除く、レベル５以上の빛속성または어둠속성「디지몬」몬스터를 １体を덱에서 묘지로 보내고、
PRINTL 이 카드를 특수 소환한다。
CALLFORM CARD_ABLE(2,소환時,특수소환時)
PRINTL ②：이 카드가 소환 / 특수 소환된 경우에 발동할 수 있다。
PRINTL 패에서 「디지몬」몬스터를 １体を묘지로 보내고、묘지에서 「디지몬」카드 １장을 패로 되돌린다。
CALLFORM CARD_ABLE(3,필드起動,フリー誘発)
PRINTL ③：자신 / 상대 턴에 발동することができる。
PRINTL 이 카드를 묘지に送り、묘지에서 レベル７か８の빛속성「디지몬」モンスター1体を특수 소환한다。


@CARDCAN_34310(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성



CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,34310)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_D1(듀얼리스트,34310)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,34310,"손패")
	SIF RESULT == 1
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件속성:0 = 빛속성
	효과条件속성:1 = 어둠속성
	CALLFORM 효과条件レベル_ADV(5,"以上")
	효과条件カテゴリ = 디지몬
	효과条件固名前 = 블랙가트몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,34310)
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件カテゴリ = 디지몬
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 디지몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_3(듀얼리스트,34310)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 디지몬
	효과条件종류 = モン全般
	효과条件속성 = 빛속성
	효과条件レベル:0 = 7
	효과条件レベル:1 = 8
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_34310(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34310,20)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件속성:0 = 빛속성
		효과条件속성:1 = 어둠속성
		CALLFORM 효과条件レベル_ADV(5,"以上")
		효과条件カテゴリ = 디지몬
		효과条件固名前 = 블랙가트몬
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트,"손패",場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34310,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件カテゴリ = 디지몬
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件カテゴリ = 디지몬
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34310,3)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		효과範囲묘지 = 1
		효과条件カテゴリ = 디지몬
		효과条件종류 = モン全般
		효과条件속성 = 빛속성
		효과条件レベル:0 = 7
		효과条件レベル:1 = 8
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF

