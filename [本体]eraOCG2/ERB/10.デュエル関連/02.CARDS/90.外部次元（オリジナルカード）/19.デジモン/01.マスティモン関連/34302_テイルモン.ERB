@CARDNAME_34302,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 가트몬
	CASE "略称"
		RESULTS = 가트몬
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_34302(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RESULT:1 = 사이버스족
		RETURN 천사족
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 2000
	CASE "守備力"
		RETURN 1800
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251130
ENDSELECT

RETURN 0

@CARD_EXPLANATION_34302(종류)
#DIM DYNAMIC 종류

PRINTL 디지몬 카드는 사이버스족으로도 취급한다。
PRINTL 이 카드명의 ①②③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,효과소환)
PRINTL ①：이 카드는 릴리스 없이 소환할 수 있다。
PRINTL 그 경우、자신은 １０００데미지를 받는다。
CALLFORM CARD_ABLE(2,소환時,특수소환時)
PRINTL ②：이 카드가 소환 / 특수 소환에 성공했을 때에 발동할 수 있다。
PRINTL 덱에서 "가트몬" 이외의 레벨５~８ 인 빛 / 어둠속성 "디지몬" 몬스터 １장을 패에 넣거나 묘지로 보낸다。
CALLFORM CARD_ABLE(3,필드起動,フリー誘発)
PRINTL ③：자신 / 상대 턴에 발동할 수 있다。
PRINTL 이 카드를 묘지로 보내고、패에서 레벨７ 또는 ８인 빛속성 "디지몬" 몬스터를 １장을 특수 소환한다。
PRINTL 

@CARDCAN_34302(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성



CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,34302)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과소환
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 소환権 == 0
		RETURN 0
	SIF モンスター数(듀얼리스트) == 5
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,34302)
		RETURN 0

	CALL FULLRESET
	효과範囲덱 = 1
	효과条件속성:0 = 빛속성
	효과条件속성:1 = 어둠속성
	효과条件カテゴリ= 디지몬
	효과条件固名前 = 가트몬
	효과条件レベル:0 = 5
	효과条件レベル:1 = 6
	효과条件レベル:2 = 7
	효과条件レベル:3 = 8	
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動 || 종류 == フリー誘発
	SIF 발동済_3(듀얼리스트,34302)
		RETURN 0

	SIF ゾーン != "묘지"
		RETURN 0

	CALL FULLRESET
	효과範囲손패 = 1
	효과条件カテゴリ= 디지몬
	효과条件종류 = モン全般
	효과条件속성 = 빛속성
	효과条件レベル:0 = 7
	효과条件レベル:1 = 8
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_34302(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 효과소환
	CALL LIFE_CHANGE(듀얼리스트,"減少","효과",1000)

	RETURN 1
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34302,2)
	IF RESULT == 0
		PRINTL 덱에서 특정 카드를 패에 넣으시겠습니까？（아니오로 묘지행）
		CALL YN_CHOICE(듀얼리스트)
		IF RESULT == はい
			CALL FULLRESET
			효과条件속성:0 = 빛속성
			효과条件속성:1 = 어둠속성
			효과条件カテゴリ= 디지몬
			효과条件固名前 = 가트몬
			효과条件レベル:0 = 5
			효과条件レベル:1 = 6
			효과条件レベル:2 = 7
			효과条件レベル:3 = 8
			CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所)
		ELSEIF RESULT == いいえ
		CALL FULLRESET
			효과条件속성:0 = 빛속성
			효과条件속성:1 = 어둠속성
			효과条件カテゴリ= 디지몬
			효과条件固名前 = 가트몬
			효과条件レベル:0 = 5
			효과条件レベル:1 = 6
			효과条件レベル:2 = 7
			효과条件レベル:3 = 8
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"덱",ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 묘지起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34302,3)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		효과範囲손패 = 1
		효과条件カテゴリ= 디지몬
		효과条件종류 = モン全般
		효과条件속성 = 빛속성
		효과条件レベル:0 = 7
		효과条件レベル:1 = 8
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF

