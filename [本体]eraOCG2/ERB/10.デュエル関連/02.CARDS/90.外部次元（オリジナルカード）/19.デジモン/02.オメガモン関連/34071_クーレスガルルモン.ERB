@CARDNAME_34071,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 크레스가루몬
	CASE "略称"
		RESULTS = 크레스가루몬
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_34071(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RESULT:1 = 사이버스족
		RETURN 야수족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 2900
	CASE "守備力"
		RETURN 2300
	CASE "レア度"
		RETURN SPR
ENDSELECT

RETURN 0

@CARDSUMMON_34071(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 7
素材条件カテゴリ = 디지몬

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,34071) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_34071(종류)
#DIM DYNAMIC 종류

PRINTL レベル７「디지몬」×２
PRINTL 디지몬カードは사이버스족としても扱う。
CALLFORM CARD_ABLE(1,EX덱起動)
PRINTL ①：이 카드는 자신필드 / 묘지に「디지몬」が３종류以上존재하는 경우、
PRINTL 이 카드는 자신의 レベル７・８の야수족「디지몬」の上に重ねてＸ소환できる。
PRINTL 이 효과로 Ｘ소환した이 카드의 Ｘ素材は２つ増える。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：자신의 メインフェイズに、이 카드의 Ｘ素材を１つ取り除いて발동할 수 있다。
PRINTL 상대필드에 存在する몬스터 １장을 골라、このカードとダメージ計算を行う。


@CARDCAN_34071(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성



CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,34071)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF 발동済_1(듀얼리스트,34071)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,34071)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 디지몬
	효과条件レベル:0 = 7
	효과条件レベル:1 = 8
	효과条件종족 = 야수족
	효과条件重ねてＸ = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件除去種 = 戦闘
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_34071(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34071,0)
	IF RESULT == 0
		CALL RESETCONDITION_MAT
		必要素材数 = 1
		素材条件カテゴリ = 디지몬
		素材条件종족 = 야수족
		효과条件レベル:0 = 7
		효과条件レベル:1 = 8
		효과추가종류 = 効追Ｘ素 + 2
		TRYCALLFORM XYZSUMMON(듀얼리스트,場所)
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34071,0,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT:50
			CALL CARD_FIGHT(듀얼리스트,場所,選択カード)
		ENDIF
	ENDIF
ENDIF

