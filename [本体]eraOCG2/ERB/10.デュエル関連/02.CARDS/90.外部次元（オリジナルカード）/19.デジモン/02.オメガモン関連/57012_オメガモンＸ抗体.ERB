@CARDNAME_57012,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 오메가몬Ｘ항체
	CASE "略称"
		RESULTS = 오메가몬Ｘ
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
		RESULTS:1 = Ｘ항체
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_57012(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RESULT:1 = 화염속성
		RESULT:2 = 물속성
		RETURN 빛속성
	CASE "종족"
		RESULT:1 = 사이버스족
		RETURN 전사족
	CASE "レベル"
		RETURN 12
	CASE "攻撃力"
		RETURN 4000
	CASE "守備力"
		RETURN 4000
	CASE "특수制限"
		RETURN 1
	CASE "レア度"
		RETURN ULR
	CASE "추가日"
		RETURN 260111
ENDSELECT

RETURN 0

@CARD_EXPLANATION_57012(종류)
#DIM DYNAMIC 종류

PRINTL 「ウォーグレイモンＸ항체」＋「メタルガルルモンＸ항체」
;엑시즈なのに素材の名称지정してるのは別にガバじゃなく意図
PRINTL 디지몬カードは사이버스족としても扱う。
PRINTL 자신은 「오메가몬Ｘ항체」を１턴에 １번しか특수 소환할 수 없다。
PRINTL 이 카드명의 ②의 효과는 １턴에 １번しか使用できず、
PRINTL ③의 효과는 デュエル中に１度しか使用できない。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：이 카드는 상대モンスター・마법카드의 효과를 受けない。
CALLFORM CARD_ABLE(2,발동誘発)
PRINTL ②：상대가 카드의 효과를 발동했을 때에 、이 카드의 Ｘ素材を１つ取り除いて발동할 수 있다。
PRINTL その발동を無効にし、제외する。
CALLFORM CARD_ABLE(20,필드起動,フリー誘発)
PRINTL ③：자신 / 상대 턴에 、이 카드가 Ｘ素材を持たないなら발동할 수 있다。
PRINTL 이 카드의 Ｘ素材を２つ増やし、상대 필드의 モンスターゾーンまたは마법＆함정 존의 카드를 全て제외する。
PRINTL こ의 효과는 耐性で防げない。
PRINTL 그 후、상대の묘지에서 카드를 全て제외する。


@CARDSUMMON_57012(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2
なんでもＸ = 1
素材条件名前:0 = ウォーグレイモンＸ항체
素材条件名前:1 = メタルガルルモンＸ항체
素材条件固名前起動 = 1

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,57012) 
	RETURN RESULT
ENDIF



@CARDCAN_57012(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,57012)
SIF RESULT == 1
	RETURN 0

IF 종류 == 발동誘発
	SIF 발동済_2(듀얼리스트,57012)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_D1(듀얼리스트,57012)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") != -1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF




@CARDEFFECT_57012(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 選択カード名前
#DIM DYNAMIC 同名枚数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57012,2,X消費1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"제외")
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57012,20)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"Ｘ",2)
		PRINTFORMW 「オールデリート！」
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			CALL CARD_SELECT(듀얼리스트,選択カード)
			IF 参照先（CS） == "마함"
				CALL FULLRESET
				CALL CARD_HYPER_DISPOSE(듀얼리스트,"상대마함",제외行き)
			ELSE
				CALL FULLRESET
				CALL CARD_HYPER_DISPOSE(듀얼리스트,"상대필드",제외行き)
			ENDIF
			CALL FULLRESET
			CALL CARD_HYPER_DISPOSE(듀얼리스트,"상대묘지",제외行き)
			
        ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"モ耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"魔耐")
ENDIF
