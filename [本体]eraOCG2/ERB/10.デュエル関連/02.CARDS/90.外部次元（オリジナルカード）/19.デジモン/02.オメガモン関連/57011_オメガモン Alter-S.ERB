@CARDNAME_57011,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 오메가몬 Alter-S
	CASE "略称"
		RESULTS = 오메가몬AlterS
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_57011(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RESULT:1 = 화염속성
		RESULT:2 = 물속성
		RETURN 빛속성
	CASE "종족"
		RESULT:1 = 사이버스족
		RETURN 전사족
	CASE "レベル"
		RETURN 11
	CASE "攻撃力"
		RETURN 3500
	CASE "守備力"
		RETURN 3500
	CASE "특수制限"
		RETURN 1
	CASE "レア度"
		RETURN ULR
ENDSELECT

RETURN 0

@CARD_EXPLANATION_57011(종류)
#DIM DYNAMIC 종류

PRINTL 「블리츠그레이몬」＋「크레스가루몬」
PRINTL 디지몬カードは사이버스족としても扱う。
CALLFORM CARD_ABLE(1,EX덱起動)
PRINTL 이 카드는 자신필드 / 묘지의 上記の素材２体、
PRINTL または「오메가몬」１体を제외することでEX덱에서 특수소환することもできる。
PRINTL 자신が「오메가몬」몬스터를 특수소환したターン、こ의 효과는 使用できない。
PRINTL 자신은 「오메가몬 Alter-S」を１턴에 １번しか특수소환できず、
PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １번しか使用できず、
PRINTL 자신 필드에 「오메가몬」が존재하는 경우、제외状態でも발동할 수 있다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：이 카드는 대상・破壊耐性を持つ。
CALLFORM CARD_ABLE(2,발동誘発)
PRINTL ②：상대가 마법・함정の효과를 발동했을 때에 발동할 수 있다。
PRINTL その발동を無効する。그 후、상대 필드의 카드 １장을 파괴할 수 있다。
CALLFORM CARD_ABLE(3,필드起動 ,フリー誘発)
PRINTL ③：자신 / 상대 턴에 발동할 수 있다。
PRINTL 상대마법＆함정 존의 카드를 全て파괴한다。

@CARDSUMMON_57011(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材条件名前 = 블리츠그레이몬
ELSEIF EX参照 >= 10
	素材条件名前 = 크레스가루몬
ENDIF

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,57011) 
	RETURN RESULT
ENDIF



@CARDCAN_57011(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,57011)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과条件名前:0 = 오메가몬
	효과条件名前:1 = 오메가몬 Alter-S
	효과条件名前:2 = 오메가몬Ｘ항체
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"SS이력")
	SIF RESULT == 1
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,57011)
	SIF RESULT == 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件名前 = 오메가몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 1
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件名前 = 블리츠그레이몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件名前 = 크레스가루몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF 발동済_2(듀얼리스트,57011)
		RETURN 0
	CALL FULLRESET
	효과条件종류 = 마함全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	IF ゾーン == "제외"
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件名前 = 오메가몬
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			RETURN 1
	ENDIF
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_3(듀얼리스트,57011)
		RETURN 0
	CALL FULLRESET
	효과範囲상대마함 = 1
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	IF ゾーン == "제외"
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件名前 = 오메가몬
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			RETURN 1
	ENDIF
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF




@CARDEFFECT_57011(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 選択カード名前
#DIM DYNAMIC 同名枚数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57011,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件名前:0 = 블리츠그레이몬
		효과条件名前:1 = 오메가몬
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			選択カード_ID = RESULT:1
			IF 選択カード_ID != 57010
				CALL FULLRESET
				효과範囲필드 = 1
				효과範囲묘지 = 1
				효과条件名前:0 = 크레스가루몬
				효과条件行先플래그 = 제외行き
				CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
				IF RESULT == 1
					CALL FULLRESET
					CALL CARD_SP_SUMMON(듀얼리스트,"EX덱",場所)
				ENDIF
			ELSE
				CALL FULLRESET
				CALL CARD_SP_SUMMON(듀얼리스트,"EX덱",場所)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57011,2)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57011,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"묘지")
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"破耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"対耐")
ENDIF
