@CARDNAME_76501,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 초진화의 문장
	CASE "略称"
		RESULTS = 초진화의 문장
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_76501(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 速攻마법
	CASE "レア度"
		RETURN SPR
ENDSELECT

RETURN 0

@CARD_EXPLANATION_76501(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動,손패起動,フリー誘発)
PRINTL ①：자신 / 상대의 메인 페이즈에 발동할 수 있다。
PRINTL 덱에서 레벨７ / ８인 "디지몬" 몬스터 １장을 패에 넣는다。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②：자신 메인 페이즈에 이 카드가 묘지에 존재하고、
PRINTL 자신의 필드에 레벨３ / ４인 "디지몬" 몬스터가 존재하는 경우、
PRINTL 이 카드를 제외하고、이하의 효과에서 １개를 선택해서 발동할 수 있다。
PRINTL ●덱에서 레벨 ３ / ４인 "디지몬" 몬스터를 １장 고른다。
PRINTL 　그 카드와 같은 속성 / 종족인 랭크９ "디지몬" X 몬스터 １장을 그 카드 위에 겹쳐서 특수 소환한다。
PRINTL ●덱 / 묘지에서 "캡슐" 카드 １장을 자신 필드에 세트한다。

@CARDCAN_76501(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 발동불가,2

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,76501)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,76501)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 디지몬
	효과条件종류 = モン全般
	효과条件レベル:0 = 7
	효과条件レベル:1 = 8
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF 발동済_2(듀얼리스트,76501)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 디지몬
	효과条件종류 = モン全般
	효과条件レベル:0 = 3
	효과条件レベル:1 = 4
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 디지몬
	효과条件종류 = 엑시즈
	효과条件レベル = 9
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1

	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件名前 = 캡슐
	효과条件セット = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:1 = 1
	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_76501(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC EX参照
#DIM DYNAMIC 묘지送カード,10
#DIM DYNAMIC 손패묘지送カード,10
#DIM DYNAMIC 素材数
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードB
#DIM DYNAMIC 選択済カード
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件속성,7
#DIM DYNAMIC 속성条件
#DIM DYNAMIC 종족条件
#DIM DYNAMIC 条件달성,2
#DIM DYNAMIC 발동불가,2
#DIM DYNAMIC 選択속성
#DIM DYNAMIC 選択종족
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC EX選択カード
#DIMS DYNAMIC EX選択カード名

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,76501,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ= 디지몬
		효과条件종류 = モン全般
		효과条件レベル:0 = 7
		효과条件レベル:1 = 8
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,76501,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 디지몬
		효과条件종류 = 엑시즈
		효과条件レベル = 9
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:0 = 1

		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件名前 = 캡슐
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:1 = 1

		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)

		IF 발동불가:0 == 0 && 발동불가:1 == 0
			CALL YN_CHOICE(듀얼리스트,"랭크９인「디지몬」X몬스터를 특수 소환한다。","「캡슐」카드를 세트한다。")
		ELSEIF 발동불가:1 == 1
			RESULT = 0
		ELSEIF 발동불가:0 == 1
			RESULT = 1
		ENDIF

		IF RESULT == 0
			CALL FULLRESET
			효과条件표시 = 表側표시
			효과条件カテゴリ= 디지몬
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
			IF RESULT != 9999
				CALL FULLRESET
				효과範囲필드 = 1
				효과条件カテゴリ = 디지몬
				효과条件종류 = モン全般
				효과条件レベル:0 = 3
				효과条件レベル:1 = 4
				CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
				IF RESULT != 9999
					選択カード_ID = RESULT:99
					CALLFORM CARDNAME_{選択カード_ID}("名前")
					選択カード名 = %RESULTS%
					CALLFORM CARD_{選択カード_ID}("종족")
					選択종족 = RESULT
					CALLFORM CARD_{選択カード_ID}("속성")
					選択속성 = RESULT
					SELECTCASE 選択カード名
					CASE "アグモン"
						SETCOLOR C_ORANGE
					CASE "ガブモン"
						SETCOLOR C_BLUE
					ENDSELECT
					PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
					PRINTFORML
					PRINTFORML %選択カード名%、초특급 진화！
					PRINTFORML 
					RESETCOLOR
					CALL FULLRESET
					효과範囲EX덱 = 1
					효과条件カテゴリ = 디지몬
					효과条件종류 = 엑시즈
					효과条件レベル = 9
					효과条件종족 = 選択종족
					효과条件속성 = 選択속성
					CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
					EX選択カード = RESULT
					IF EX選択カード != 9999
						CALLFORM CARDNAME_{選択カード_ID}("名前")
						EX選択カード名 = %RESULTS%
						CALL RESETCONDITION_MAT
						代替素材数 = 1
						효과条件名前 = %選択カード名%
						重ねてＸ = 1
						CALL XYZSUMMON(듀얼리스트, EX選択カード)

						SELECTCASE EX選択カード名 
						CASE "ウォーグレイモン"
							SETCOLOR C_ORANGE
						CASE "メタルガルルモン"
							SETCOLOR C_BLUE
						ENDSELECT
						PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
						PRINTFORML
						PRINTFORML %EX選択カード名%！！
						PRINTFORML 
						RESETCOLOR
					ENDIF
				ENDIF
			ENDIF
		ELSEIF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲묘지 = 1
			효과条件名前 = 캡슐
			CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF
