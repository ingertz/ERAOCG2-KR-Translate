@CARDNAME_34070,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 블리츠그레이몬
	CASE "略称"
		RESULTS = 블리츠그레이몬
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_34070(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RESULT:2 = 사이버스족
		RETURN 기계족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 2200
	CASE "守備力"
		RETURN 3000
	CASE "レア度"
		RETURN SPR
ENDSELECT

RETURN 0

@CARDSUMMON_34070(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 7
素材条件カテゴリ = 디지몬

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,34070) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_34070(종류)
#DIM DYNAMIC 종류

PRINTL レベル７「디지몬」×２
PRINTL 디지몬カードは사이버스족としても扱う。
PRINTL 이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,EX덱起動)
PRINTL ①：자신의 ライフポイントが상대のライフポイントより低い場合、
PRINTL 이 카드는 자신의 レベル７・８の화염속성「디지몬」の上に重ねてＸ소환할 수 있다。
PRINTL 이 효과로 Ｘ소환한 이 카드의 Ｘ素材は２つ増える。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：자신 / 상대의 메인 페이즈에、이 카드의 Ｘ素材を１つ取り除いて발동할 수 있다。
PRINTL 자신의 묘지・제외状態に存在する화염속성の「디지몬」の数×３００ダメージを상대에게 与える。


@CARDCAN_34070(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 발동불가,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,34070)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,34070)
	SIF RESULT == 1
		RETURN 0
	SIF GETVAR(@"ライフ_%듀얼리스트%") >= GETVAR(@"ライフ_%対面者%")
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 디지몬
	효과条件속성 = 화염속성
	효과条件レベル:0 = 7
	효과条件レベル:1 = 8
	효과条件重ねてＸ = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_2(듀얼리스트,34070)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件종류 = モン全般
	효과条件カテゴリ = 디지몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_34070(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 破壊횟수
#DIM DYNAMIC 발동불가,2

IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34068,0)
	IF RESULT == 0
		CALL RESETCONDITION_MAT
		必要素材数 = 1
		素材条件カテゴリ = 디지몬
		素材条件속성 = 화염속성
		효과条件レベル:0 = 7
		효과条件レベル:1 = 8
		효과추가종류 = 効追Ｘ素 + 2
		TRYCALLFORM XYZSUMMON(듀얼리스트,場所)
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34070,2,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲제외 = 1
		효과条件종류 = モン全般
		효과条件カテゴリ = 디지몬
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		カウンタ = RESULT
		CALL LIFE_CHANGE(듀얼리스트,"減少","효과",カウンタ*300,1)
	ENDIF
ENDIF

