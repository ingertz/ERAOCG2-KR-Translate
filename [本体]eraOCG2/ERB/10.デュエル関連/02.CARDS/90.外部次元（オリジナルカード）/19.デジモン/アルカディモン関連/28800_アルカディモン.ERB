		RETURN 0
	SIF 발동済_2(듀얼리스트,328800)
		RETURN 0
	SIF 발동済_2(듀얼리스트,228800)
		RETURN 0
	SIF 발동済_2(듀얼리스트,428800)
		RETURN 0
