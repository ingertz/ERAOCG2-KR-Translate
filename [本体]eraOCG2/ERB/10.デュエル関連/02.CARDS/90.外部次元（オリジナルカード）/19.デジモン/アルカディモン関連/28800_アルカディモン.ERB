@CARDCAN_328800(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,328800)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1

ELSEIF 종류 == 발동誘発
	SIF 발동済_1(듀얼리스트,328800)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_2(듀얼리스트,28800)
		RETURN 0
	SIF 발동済_2(듀얼리스트,128800)
		RETURN 0
	SIF 발동済_2(듀얼리스트,328800)
		RETURN 0
	SIF 발동済_2(듀얼리스트,228800)
		RETURN 0
	SIF 발동済_2(듀얼리스트,428800)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_328800(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 選択カード攻撃力
#DIM DYNAMIC 효과条件BIT
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 条件달성

IF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"対耐")

	CALL FULLRESET
	효과範囲상대필드 = 1
	CALLFORM 효과条件レベル_ADV(9,"以上")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT != 1
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"モ耐")
	ENDIF

ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,328800,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"묘지")
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"永攻",500)
			RETURN 1
		ENDIF
	ENDIF
	RETURN 0

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,328800,2)
	IF RESULT == 0
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
		IF RESULT == 1
			選択カードID = RESULT:1
			CALLFORM CARD_{選択カードID}("종류")
			IF RESULT <= モン全般
				CALL FULLRESET
				효과条件표시 = 表側표시
				효과条件종류 = 링크以外
				CALLFORM 효과条件レベル_ADV(8,"以下")
				CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드全体",場所,"묘지")
				SIF RESULT == 1
					攻撃力修正 = RESULT:1
				攻撃力修正 = 攻撃力修正 * 500
				CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"永攻",攻撃力修正)
			ELSEIF RESULT >= 20
				CALL FULLRESET
				CALL CARD_REMOVAL_BASIC(듀얼리스트,"마함全体",場所,"묘지")
				SIF RESULT == 1
					攻撃力修正 = RESULT:1
				攻撃力修正 = 攻撃力修正 * 500
				CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"永攻",攻撃力修正)
			ENDIF

			TRYCALLFORM CARDNAME_{選択カードID}("カテゴリ")
			IF MATCH(RESULTS,"캡슐")
				条件달성 = 1
			ELSEIF MATCH(RESULTS,"디지몬")
				CALLFORM CARD_{選択カードID}("종족")
				SIF RESULT == 악마족
				条件달성 = 1
			ENDIF
			IF 条件달성 == 1
				CALL CARD_RECONSTRUCT(듀얼리스트,ゾーン,場所,428800)
			ENDIF
		ENDIF
	ENDIF
ENDIF

