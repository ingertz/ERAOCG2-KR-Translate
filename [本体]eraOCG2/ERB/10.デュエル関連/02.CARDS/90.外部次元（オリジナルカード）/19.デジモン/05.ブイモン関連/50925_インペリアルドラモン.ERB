@CARDNAME_50925,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 황제드라몬：드래곤모드
	CASE "略称"
		RESULTS = ＩＰ드라몬ＤＭ
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_50925(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RESULT:1 = 사이버스족
		RETURN 드래곤족
	CASE "レベル"
		RETURN 11
	CASE "攻撃力"
		RETURN 3500
	CASE "守備力"
		RETURN 2000
	CASE "レア度"
		RETURN ULR
	CASE "특수불가"
		RETURN 1
	CASE "추가日"
		RETURN 260122
ENDSELECT

RETURN 0

@CARDSUMMON_50925(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 3
素材条件レベル = 9
素材条件속성 = 바람속성
素材条件カテゴリ = 디지몬

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,50925)
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_50925(종류)
#DIM DYNAMIC 종류

PRINTL 바람속성・レベル９「디지몬」×３
PRINTL 디지몬カードは사이버스족としても扱う。
PRINTL 이 카드는 자신 필드의 レベル９・드래곤족・바람속성の「디지몬」１体の上に重ねてＸ소환できる。
PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,필드起動)
PRINTL ①：자신 / 상대のメインフェイズに발동할 수 있다。
PRINTL 자신의 묘지 / 제외 상태인 「디지몬」카드 １장을 덱に戻し、자신은 １장 드로우하고、손패１장을 選んで묘지へ送る。
CALL CARD_ABLE(0,효과後誘発)
PRINTL ②：자신의 손패が묘지へ送られる場合に、이 카드의 Ｘ素材を１つ取り除いて발동할 수 있다。
PRINTL 상대 필드의 카드를 １장까지덱に戻す。
PRINTL 戻さなかった場合、상대のライフを半分にする。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：バトルフェイズ中、モンスターゾーンの이 카드의 カード名は「황제드라몬：ファイターモード」として扱い、
PRINTL 이 카드의 공격력은 倍になる。


@CARDCAN_50925(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 발동불가,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50925)
SIF RESULT == 1
	RETURN 0


IF 종류 == EX덱起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,50925)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件レベル = 8
	효과条件종족 = 드래곤족
	효과条件속성 = 바람속성
	효과条件カテゴリ = 디지몬
	효과条件重ねてＸ = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트,50924)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件カテゴリ = 디지몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"손패墓送")
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") < 0
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과 || 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_50925(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 素材数
#DIM DYNAMIC 발동불가,2


IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50925)
	IF RESULT == 0
		CALL RESETCONDITION_MAT
		必要素材数 = 1
		효과条件レベル = 9
		효과条件종족 = 드래곤족
		효과条件속성 = 바람속성
		효과条件カテゴリ = 디지몬
		효과条件종류 = レベル持ち
		重ねてＸ = 1
		TRYCALLFORM XYZSUMMON(듀얼리스트,場所)
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50925,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 디지몬
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL SHUFFLE(듀얼리스트)
			CALL CARDDRAW_BASIC(듀얼리스트,1)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲손패 = 1
				CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50925,,1)
	IF RESULT == 0
		CALL CARDDRAW_BASIC(듀얼리스트,1)
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과条件任意 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"손패")
		IF RESULT != 1
			CALL LIFE_CHANGE(듀얼리스트,"半分","변경",0,1)
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	IF バトルフェイズ == 1
		CALL FULLRESET
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"変化元ID",150925)
		CALL FULLRESET
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"貫通")
	ELSE
		CALL FULLRESET
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"変化元ID",-1)
	ENDIF
ELSEIF 종류 == 攻守変動
	IF バトルフェイズ == 1
		CALL STATCHANGE_BASIC(듀얼리스트,"自身",場所,3500,0)
	ENDIF
ENDIF

