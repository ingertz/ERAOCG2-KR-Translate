@CARDNAME_34095,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 데롱몬
	CASE "略称"
		RESULTS = 데롱몬
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
		RESULTS:1 = 디지몬알
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_34095(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RESULT:1 = 사이버스족
		RETURN 곤충족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 100
	CASE "守備力"
		RETURN 0
	CASE "レア度"
		RETURN CMN
	CASE "추가日"
		RETURN 260117
ENDSELECT

RETURN 0

@CARD_EXPLANATION_34095(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드는 L소환할 수 없다。
PRINTL 디지몬カードは사이버스족としても扱う。
PRINTL 자신은 １턴에 １번しか「디지몬알」몬스터를 특수소환할 수 없다。
PRINTL 이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,EX덱起動)
PRINTL ①：자신의 패에서 곤충족「디지몬」または바람속성「디지몬」１体を묘지に送って발동할 수 있다。
PRINTL EX덱의 이 카드를 특수 소환한다。
CALLFORM CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ②：자신 / 상대 턴에 발동することができる。
PRINTL 이 카드를 소멸させ、패 / 덱에서 レベル３の바람속성「디지몬」１体を특수 소환한다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：モンスターゾーンの이 카드는 素材불가を持つ。


@CARDSUMMON_34095(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 1
素材条件カテゴリ = 디지몬
素材条件종류 = 링크以外
RETURN 0
IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,34095) 
	RETURN RESULT
ENDIF

@CARDCAN_34095(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성



CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,34095)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과条件カテゴリ = 디지몬알
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"SS이력")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	CALL CARD_EX_CHECK(듀얼리스트,34095)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件スーパー속성 = 바람속성
	효과条件スーパーカテゴリ = 디지몬
	효과条件スーパー종류 = モン全般
	효과条件종족 = 곤충족
	효과条件カテゴリ = 디지몬
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_2(듀얼리스트,34095)
		RETURN 0

	SIF ゾーン != "필드"
		RETURN 0

	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과条件속성 = 바람속성
	효과条件カテゴリ= 디지몬
	효과条件종류 = モン全般
	효과条件レベル = 3
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_34095(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34095,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件スーパー속성 = 바람속성
		효과条件スーパーカテゴリ = 디지몬
		효과条件スーパー종류 = モン全般
		효과条件종족 = 곤충족
		효과条件カテゴリ= 디지몬
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트,"EX덱",場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34095,2)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,소멸行き)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲손패 = 1
			효과範囲덱 = 1
			효과条件속성 = 바람속성
			효과条件カテゴリ= 디지몬
			효과条件종류 = モン全般
			효과条件レベル = 3
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"不材")
ENDIF

