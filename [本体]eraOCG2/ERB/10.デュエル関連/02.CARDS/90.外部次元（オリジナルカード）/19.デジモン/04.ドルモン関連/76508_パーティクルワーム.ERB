@CARDNAME_76508,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 파티클 웜
	CASE "略称"
		RESULTS = 입자화 웜
	CASE "カテゴリ"
		RESULTS:0 = 웜
		;디지몬カードとしてサーチできるのもあれだったので디지몬カテゴリはない
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_76508(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
	CASE "추가日"
		RETURN 260111
ENDSELECT

RETURN 0

@CARD_EXPLANATION_76508(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動 ,손패起動)
PRINTL ①：상대필드 / 묘지に存在する「Ｘ항체」を持たない사이버스족몬스터를 全て제외する。
PRINTL 그 후、상대は덱에서 「Ｘ항체」마법 / 함정 카드 １장을 필드에 세트할 수 있다。
CALLFORM CARD_ABLE(2,발동誘発)
PRINTL ②：상대가 「Ｘ항체」カード이외의 「디지몬」마법・함정の효과를 발동했을 때에 、묘지의 이 카드를 제외하고 발동할 수 있다。
PRINTL 그 효과를 無効にし、제외する。

@CARDCAN_76508(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,76508)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,76508)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件固カテゴリ = Ｘ항체
	효과条件종족 = 사이버스족
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF 발동済_2(듀얼리스트,76508)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과条件固カテゴリ = Ｘ항체
	효과条件カテゴリ = 디지몬
	효과条件종류 = 마함全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_76508(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,76508,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件固カテゴリ = Ｘ항체
		효과条件종족 = 사이버스족
		효과条件종류 = モン全般
		CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"제외")
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件종류 = 마함全般
			효과条件カテゴリ = Ｘ항체
			CALL CARD_SET_ADV(対面者,ゾーン,場所,"裏側표시")
		ENDIF
	ENDIF

ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,76508,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"제외")
	ENDIF
ENDIF