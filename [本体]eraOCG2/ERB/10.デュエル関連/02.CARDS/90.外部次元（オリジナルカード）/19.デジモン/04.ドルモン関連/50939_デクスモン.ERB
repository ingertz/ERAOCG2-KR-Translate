@CARD_EXPLANATION_1050939(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("D_HEART_C")
PRINTL 이 카드명의 몬스터의 ③④의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
PRINTL 상대は이 카드명의 몬스터의 특수소환・효과の발동に対して효과를 발동できない。
CALLFORM CARD_ABLE(0,EX소환時強制,특수소환時強制)
PRINTL ①：『Ｘライフ』
PRINTL 이 카드는 Ｘ素材を持つことができ、Ｘ素材を１つ持った状態で특수소환される。
PRINTL 이 카드가 モンスターゾーンを離れる場合、대신에 このＸ素材を取り除く。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：이 카드의 공격력 / 수비력은 お互いの제외状態の카드의 수×５００오르고、
PRINTL 이 카드는 대상耐性・마법耐性・攻撃阻害を持ち、상대は제외状態の카드의 효과를 발동できない。
CALLFORM CARD_ABLE(1,필드起動,フリー誘発)
PRINTL ③：자신 / 상대 턴에 발동할 수 있다。
PRINTL 상대は自身のモンスターゾーン・마법＆함정ゾーン・묘지에서 각각 １枚ずつ카드를 제외しなければならない。
CALLFORM CARD_ABLE(2,발동誘発)
PRINTL ④：상대가 마법・함정・몬스터의 효과를 발동했을 때、묘지의 「Ｘ항체」카드 １장을 제외하고 발동할 수 있다。
PRINTL その발동を無効にし제외する。
CALL TEXT_DECORATION("D_HEART_2")


@CARDCAN_1050939(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,1050939)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과 || 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_1(듀얼리스트,1050939)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 발동誘発
	SIF 발동済_2(듀얼리스트,1050939)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0

	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = Ｘ항체
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	CALL FULLRESET
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == EX소환時強制 || 종류 == 특수소환時強制

	RETURN 1

ELSEIF 종류 == 身代효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF 破壊대상ゾーン != "필드"
		RETURN 0
	SIF 破壊대상場所 != 場所
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	RETURN 1
ELSEIF 종류 == チェーン可否
	RETURN 1
ENDIF

@CARDEFFECT_1050939(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"対耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"魔耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦阻")
	CALL FULLRESET
	CALL SET_PLAYER_INFO(듀얼리스트,"제외_無効",3,1)

ELSEIF 종류 == 攻守変動
	攻撃力修正 = 500 * (제외数(듀얼리스트) + 제외数(対面者))
	CALL STATCHANGE_BASIC(듀얼리스트,"自身",場所,攻撃力修正,攻撃力修正)

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1050939,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(対面者,ゾーン,場所)
		CALL FULLRESET
		효과範囲마함 = 1
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(対面者,ゾーン,場所)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(対面者,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1050939,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = Ｘ항체
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"묘지",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"제외")
			RETURN 1
		ENDIF
	ENDIF
	RETURN 0
ELSEIF 종류 == EX소환時強制 || 종류 == 특수소환時強制
	CALL SET_FIELD_INFO(듀얼리스트,"필드",カード소환先,"戦耐",1,1)
	CALL SET_FIELD_INFO(듀얼리스트,"필드",カード소환先,"破耐",1,1)
	CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"Ｘ",1)

ELSEIF 종류 == 身代효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1050939,0,X消費1)
	IF RESULT == 0
		RETURN 1
	ENDIF
	RETURN 0
ENDIF
