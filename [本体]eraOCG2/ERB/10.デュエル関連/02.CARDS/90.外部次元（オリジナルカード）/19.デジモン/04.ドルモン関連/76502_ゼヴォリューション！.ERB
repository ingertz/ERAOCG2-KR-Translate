@CARDNAME_76502,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 제볼루션！
	CASE "略称"
		RESULTS = X-Evolution!
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
		RESULTS:1 = Ｘ항체
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_76502(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
	CASE "추가日"
		RETURN 260120
ENDSELECT

RETURN 0

@CARD_EXPLANATION_76502(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 １턴에 １번、いずれか１つしか使用できない。
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①：자신의 패 / 덱에서 「Ｘ항체」１장을 묘지로 보내고、그 효과를 적용한다。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②：이 카드를 묘지에서 제외하고 발동할 수 있다。
PRINTL 자신의 덱에서 「Ｘ항체」카드 １장을 패에 넣는다。


@CARDCAN_76502(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,76502)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,76502)
		RETURN 0
	SIF 발동済_2(듀얼리스트,76502)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	CALL 효과条件レベル_ADV(9, "以上")
	효과条件종류 = 링크以外
	효과条件カテゴリ = 디지몬
	효과条件固カテゴリ = Ｘ항체
	효과条件RUM = 96500
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과条件名前 = Ｘ항체
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,76502)
		RETURN 0
	SIF 발동済_2(듀얼리스트,76502)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = Ｘ항체
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_76502(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード,5
#DIM DYNAMIC 選択カードB
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC 選択名前
#DIM DYNAMIC 紋章場所
#DIM DYNAMIC 설정レベル
#DIM DYNAMIC 条件속성
#DIM DYNAMIC 条件종족

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,76502,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲덱 = 1
		효과条件名前 = Ｘ항체
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			TRYCALLFORM CARDEFFECT_{RESULT:1}(듀얼리스트,마함起動,"효과処理")
		ENDIF
	ENDIF
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,76502,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = Ｘ항체
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF
