@CARDNAME_50942,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 카오스드라몬Ｘ항체
	CASE "略称"
		RESULTS = 카오스드라몬Ｘ
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
		RESULTS:1 = 카오스
		RESULTS:2 = Ｘ항체
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_50942(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RESULT:1 = 사이버스족
		RESULT:2 = 드래곤족
		RETURN 기계족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 3400
	CASE "守備力"
		RETURN 3500
	CASE "レア度"
		RETURN SPR
	CASE "추가日"
		RETURN 260106
ENDSELECT

RETURN 0

@CARDSUMMON_50942(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 4
素材条件レベル = 10
素材条件종족 = 기계족

지정素材名前 = 카오스드라몬

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,50942)
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_50942(종류)
#DIM DYNAMIC 종류

PRINTL 기계족レベル１０モンスター×４
PRINTL 디지몬カードは사이버스족としても扱う。이 카드는 드래곤족としても扱う。
PRINTL 이 카드는 손패・필드의 「Ｘ항체」１장을 묘지に送り、자신 필드의 「카오스드라몬」１体の上に重ねてＸ소환できる。
PRINTL 「카오스드라몬」をＸ素材としている이 카드는 「각성」する。
PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：이 카드는 貫通攻撃を持ち、각성状態の이 카드는 破壊耐性・함정耐性・戦闘阻害を持つ。
CALLFORM CARD_ABLE(1,특수소환時,EX소환時,攻撃時誘発)
PRINTL ②：이 카드가 특수 소환된 경우、または이 카드의 攻撃宣言時に이 카드의 Ｘ素材を１つ取り除いて발동할 수 있다。
PRINTL 상대 필드의 카드를 全て파괴한다。
PRINTL 이 카드가 각성状態なら、상대に이 효과로 破壊したカードの枚数×５００ダメージを与える。
CALLFORM CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ③：자신 / 상대 턴에 、상대 필드의 表側표시の카드 １장을 대상として발동할 수 있다。
PRINTL その카드의 효과를 無効にし、その카드가 モンスターである場合、さらに攻撃力・守備力を０にする。
PRINTL 

@CARDCAN_50942(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 발동불가,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50942)
SIF RESULT == 1
	RETURN 0


IF 종류 == EX덱起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲마함 = 1
	효과条件名前 = Ｘ항체
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件名前 = 카오스드라몬
	효과条件重ねてＸ = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 특수소환時 || 종류 == EX소환時
	SIF 발동済_1(듀얼리스트,50942)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時誘発
	SIF 발동済_1(듀얼리스트,50942)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_2(듀얼리스트,50942)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 無効
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_50942(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 破壊횟수
#DIM DYNAMIC 발동불가,2


IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50942)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲마함 = 1
		효과条件名前 = Ｘ항체
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL RESETCONDITION_MAT(1)
			必要素材数 = 1
			素材条件名前 = 카오스드라몬
			重ねてＸ = 1
			TRYCALLFORM XYZSUMMON(듀얼리스트,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 특수소환時 || 종류 == 攻撃時誘発 || 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50942,1,X消費1)
	IF RESULT == 0
		IF GETVAR(@"%듀얼리스트%_MZ_条達:場所") >= 1
			CALL FULLRESET
			효과추가종류 = 3
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"全場全体",場所,"묘지",500)
		ELSE
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"全場全体",場所,"묘지")
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50942,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件표시 = 表側표시
		효과추가종류 = 23
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"全場単体",場所,"지속無効",99999)
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"貫通")
	IF GETVAR(@"%듀얼리스트%_MZ_条達:場所") >= 1
		CALL FULLRESET
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦阻")
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"破耐")
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"함정耐")
	ENDIF
ENDIF


