CALLFORM CARD_ABLE(1,손패起動,フリー誘発)
PRINTL ①：자신 / 상대 턴에 발동할 수 있다。
PRINTL 이 카드를 패에서 특수 소환한다。
PRINTL 몬스터를 リリースせずこの효과를 발동した場合、자신 묘지의 「Ｘ항체」카드를 ５枚덱に戻す。
CALLFORM CARD_ABLE(0,지속효과,攻守変動)
PRINTL ②：이 카드는 戦闘阻害を持ち、
PRINTL 이 카드의 공격력 / 수비력은 자신 묘지의 「Ｘ항체」카드의 수×１００오른다。
PRINTL さらに、묘지의 「Ｘ항체」카드가 ５枚以上なら、이 카드는 대상 내성을 얻는다。
CALLFORM CARD_ABLE(2,특수소환時,攻撃時誘発)
PRINTL ③：이 카드가 특수 소환된 경우、または이 카드의 攻撃宣言時に발동할 수 있다。
PRINTL 상대 필드의 카드를 ２장 まで選んで파괴한다。
PRINTL 

@CARDCAN_134084(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 발동불가,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,134084)
SIF RESULT == 1
	RETURN 0


IF 종류 == 특수소환時強制
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF !GROUPMATCH(ゾーン,"필드","손패","묘지","덱","제외")
		RETURN 0
	RETURN 1
ELSEIF 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,34084)
		RETURN 0
	SIF 발동済_2(듀얼리스트,134084)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時誘発
	SIF 발동済_2(듀얼리스트,34084)
		RETURN 0
	SIF 발동済_2(듀얼리스트,134084)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_134084(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 攻撃力修正

IF 종류 == 특수소환時強制
	CALL SET_FIELD_INFO(듀얼리스트,"필드",カード소환先,"戦耐",1,1)
ELSEIF 종류 == 특수소환時 || 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,134084,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과条件複数 = 98
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
	ENDIF
ELSEIF 종류 == 지속효과
	IF GROUPMATCH(ゾーン,"손패","묘지","덱","제외")
		CALL CARD_RECONSTRUCT(듀얼리스트,ゾーン,場所,34084)
	ELSEIF ゾーン == "필드"
		CALL FULLRESET
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦阻")

		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = Ｘ항체
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT >= 5
			CALL FULLRESET
			CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"対耐")
		ENDIF
	ENDIF

ELSEIF 종류 == 攻守変動
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = Ｘ항체
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	攻撃力修正 = RESULT * 100
	CALL STATCHANGE_BASIC(듀얼리스트,"自身",場所,攻撃力修正)
ENDIF
