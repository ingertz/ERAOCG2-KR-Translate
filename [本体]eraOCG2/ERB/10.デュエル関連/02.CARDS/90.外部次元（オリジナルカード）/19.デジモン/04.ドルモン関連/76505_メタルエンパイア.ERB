@CARDNAME_76505,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 메탈 엠파이어
	CASE "略称"
		RESULTS = 메탈 엠파이어
	CASE "カテゴリ"
		RESULTS:0 = 디지몬
	CASE "出典作品"
		RESULTS:0 = 디지몬
ENDSELECT


@CARD_76505(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN フィールド
	CASE "レア度"
		RETURN RARE
	CASE "추가日"
		RETURN 260106
ENDSELECT

RETURN 0

@CARD_EXPLANATION_76505(종류)
#DIM DYNAMIC 종류

PRINTL 자신 필드는 「메탈 엠파이어"가 된다。
PRINTL 이 카드명의 カードは１턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①：자신 필드에 기계족の「디지몬」モンスターが존재하는 경우、
PRINTL 이 카드의 발동時の処理として、덱에서 「디지몬」마법 / 함정 카드 １장을 패에 加えてもよい。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ②：자신 필드의 기계족の「디지몬」몬스터의 공격력 / 수비력은 ３００ポイント오르고、
PRINTL レベル・ランクが７以上の기계족の「디지몬」몬스터는 마법耐性を얻는다。
CALLFORM CARD_ABLE(10,마함起動)
PRINTL ②：１턴에 １번、자신 필드의 レベル・ランクが８以下の기계족の「디지몬」몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL その몬스터의 レベル・ランクより２つ高いランクを持つ기계족の「디지몬」몬스터 １장을 、
PRINTL 대상の몬스터의 上に重ねてX소환扱いとしてEX덱에서 특수 소환한다。

@CARDCAN_76505(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,76505)
SIF RESULT == 1
	RETURN 0


IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	CALL 효과条件レベル_ADV(8, "以下")
	효과条件종류 = 링크以外
	효과条件カテゴリ = 디지몬
	효과条件종족 = 기계족
	효과条件RUM = 76505
	효과条件표시 = 表側표시
	효과条件重ねてＸ = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,76505)
		RETURN 0
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과 || 종류 == 攻守変動
	SIF ゾーン != "마함" 
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_76505(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードB
#DIM DYNAMIC 설정レベル

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,76505,10)
	IF RESULT == 0
		CALL FULLRESET
		CALL 효과条件レベル_ADV(8, "以下")
		효과条件カテゴリ = 디지몬
		효과条件종족 = 기계족
		효과条件종류 = 링크以外
		효과条件RUM = 76505
		효과条件표시 = 表側표시
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			설정レベル = GETVAR(@"%듀얼리스트%_MZ_星:選択カード") + 2
			
			CALL FULLRESET
			효과条件カテゴリ = 디지몬
			효과条件종족 = 기계족
			효과条件종류 = 엑시즈
			효과条件レベル = 설정レベル
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
			選択カードB = RESULT
			;戻る
			IF 選択カードB != 9999
				TRYCALLFORM CARDSUMMON_{GETVAR(@"%듀얼리스트%_EX덱:{選択カードB}")}(듀얼리스트,選択カードB)

				CALL RESETCONDITION_MAT(1)
				代替素材数 = 1
				重ねてＸ = 1
				素材条件固定 = 選択カード
				TRYCALLFORM XYZSUMMON(듀얼리스트,選択カードB)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,76505,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)

		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 디지몬
		효과条件종족 = 기계족
		효과条件표시 = 表側표시
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件カテゴリ = 디지몬
			효과条件종류 = 마함全般
			효과条件任意 = 1
			CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所)
		ENDIF
	ENDIF

ELSEIF 종류 == 攻守変動
	CALL FULLRESET
	효과条件カテゴリ = 디지몬
	효과条件종족 = 기계족
	CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,300,300)

ELSEIF 종류 == 지속효과
	CALL SET_FIELD_MAGIC_INFO(듀얼리스트, "메탈 엠파이어")
	CALL FULLRESET
	효과条件カテゴリ = 디지몬
	효과条件종류 = 링크以外
	CALL 효과条件レベル_ADV(7,"以上")
	효과条件종족 = 기계족
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"魔耐")
ENDIF

@CARDRUM_76505(듀얼리스트,ゾーン,場所,カードID)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カードID
#DIM DYNAMIC 설정カードID
#DIM DYNAMIC 素材レベル

VARSET RESULT

IF ゾーン == "필드"
	素材レベル = GETVAR(@"%듀얼리스트%_MZ_星:場所")
ELSE
	RETURN 0
ENDIF

FOR カウンタ,0,現EX山札数(듀얼리스트)
	설정カードID = GETVAR(@"%듀얼리스트%_EX덱:カウンタ")
	SIF 설정カードID == -1 
		CONTINUE
	TRYCALLFORM CARD_{설정カードID}("종족")
	SIF !MATCH(RESULT,기계족)
		CONTINUE
	TRYCALLFORM CARDNAME_{설정カードID}("カテゴリ")
	SIF !MATCH(RESULTS,"디지몬")
		CONTINUE
	TRYCALLFORM CARD_{설정カードID}("종류")
	SIF RESULT != 엑시즈
		CONTINUE
	TRYCALLFORM CARD_{설정カードID}("レベル")
	SIF RESULT != 素材レベル + 2
		CONTINUE
	VARSET RESULT
	RETURN 1
NEXT
	
VARSET RESULT
RETURN 0
