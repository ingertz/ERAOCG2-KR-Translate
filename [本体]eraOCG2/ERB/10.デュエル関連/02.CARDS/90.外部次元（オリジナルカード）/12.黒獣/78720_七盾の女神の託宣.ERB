@CARDNAME_78720,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 7방패 여신의 신탁
	CASE "略称"
		RESULTS = 7방패여신신탁
	CASE "カテゴリ"
		RESULTS:0 = 7방패 동맹
	CASE "出典作品"
		RESULTS:0 = 쿠로이누
ENDSELECT

@CARD_78720(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 速攻마법
ENDSELECT
RETURN 0

@CARDSUMMON_78720(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
RETURN 0

@CARD_EXPLANATION_78720(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ① 효과는 1턴에 1번밖에 사용할 수 없다.
CALL CARD_ABLE(1,마함起動,손패起動,フリー誘発)
PRINTL ①：아래 효과 중 1개를 선택해서 발동할 수 있다.
PRINTL ●자신 필드에 "7방패 동맹의 상징 셀레스틴"이 존재하지 않는 경우에 선택할 수 있다.
PRINTL 덱에서 "7방패 동맹의 상징 셀레스틴" 1장을 자신의 마법&함정존에 앞면 표시로 놓는다.
PRINTL ●덱에서 "7방패 동맹"P몬스터 1장을 EX덱에 보낸다.
; CALL CARD_ABLE(2,신대효과)
CALL CARD_ABLE(0,身代효과)
PRINTL ②：자신 필드의 "7방패 동맹의 상징 셀레스틴"이 전투 / 효과로 파괴되었을 때, 대신에 묘지의 이 카드를 제외할 수 있다.

@CARDCAN_78720(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

#DIMS DYNAMIC 대상ゾーン
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,78720)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 발동済_1(듀얼리스트,78720)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과条件名前 = 7방패 동맹의 상징 셀레스틴
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT != 1
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件名前 = 7방패 동맹의 상징 셀레스틴
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1 && 마함数(듀얼리스트) < 5
			条件달성++
	ENDIF
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 7방패 동맹
	효과条件分割 = 펜듈럼
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		条件달성++
	SIF 条件달성 < 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 身代효과
	; SIF 발동済_2(듀얼리스트,78720)
	; 	RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	IF 破壊대상ゾーン == "필드"
		대상ゾーン = MZ
	ELSE
		대상ゾーン = 魔
	ENDIF
	IF 대상ゾーン != ""
		SIF 破壊대상ID != 4716 && GETVAR(@"%듀얼리스트%_%대상ゾーン%_変化元ID:破壊대상場所") != 4716
			RETURN 0
	ENDIF
	SIF !GROUPMATCH(破壊종류,"효과","戦闘")
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_78720(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

#DIM DYNAMIC 条件Ａ
#DIM DYNAMIC 条件Ｂ
#DIM DYNAMIC 選択효과

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,78720,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과条件名前 = 7방패 동맹의 상징 셀레스틴
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT != 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件名前 = 7방패 동맹의 상징 셀레스틴
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1 && 마함数(듀얼리스트) < 5
				条件Ａ++
		ENDIF
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 7방패 동맹
		효과条件分割 = 펜듈럼
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件Ｂ++
		IF 条件Ａ != 0 && 条件Ｂ != 0
			CALL YN_CHOICE(듀얼리스트,"●덱에서 「7방패 동맹의 상징 셀레스틴」１장을 자신의 마법＆함정존에 앞면 표시로 둔다。","●덱에서 「7방패 동맹」Ｐ몬스터 １장을 ＥＸ덱으로 보낸다。")
			選択효과 = RESULT
		ELSEIF 条件Ｂ == 1 && 条件Ａ == 0
			選択효과 = いいえ
		ELSEIF 条件Ａ == 1 && 条件Ｂ == 0
			選択효과 = はい
		ENDIF
		IF 選択효과 == はい
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件名前 = 7방패 동맹의 상징 셀레스틴
			CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"表側표시")
		ELSEIF 選択효과 == いいえ
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 7방패 동맹
			효과条件分割 = 펜듈럼
			효과条件行先플래그 = EX덱行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 身代효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,78720,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		RETURN 1
	ENDIF
	RETURN 0
ENDIF