@CARDNAME_5345,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 전투교관 아레인
	CASE "略称"
		RESULTS = 전투교관 아레인
	CASE "カテゴリ"
		RESULTS:0 = 미투사
	CASE "出典作品"
		RESULTS:0 = 퀸즈 블레이드
ENDSELECT


@CARD_5345(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 2400
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251215
ENDSELECT

RETURN 0

@CARD_EXPLANATION_5345(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,효과後誘発)
PRINTL ①：이 카드가 ドロー이외의 方法で손패に加わった場合に발동할 수 있다。
PRINTL 이 카드를 특수 소환한다。
CALLFORM CARD_ABLE(2,소환時,攻撃時誘発)
PRINTL ②：이 카드의 공격 선언시、または필드에 モンスターが특수 소환된 경우에 발동할 수 있다。
PRINTL 자신의 덱の一番上の카드를 めくる。そのカードの종류によって이하의 효과를 適用する。
PRINTL ●モンスター：상대 필드의 몬스터 １장을 守備표시にし、효과를 무효로 한다。
PRINTL ●마법・함정　：자신필드 / 묘지의 바람속성몬스터 １장을 패로 되돌린다。



@CARDCAN_5345(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,5345)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과後誘発
	SIF 발동済_1(듀얼리스트,5345)
		RETURN 0
	IF ゾーン == "손패"
		CALL CARD_SS_CHECK(듀얼리스트,5345,"손패")
		SIF RESULT == 1
			RETURN 0
		CALL FULLRESET
		효과条件名前 = 전투교관 아레인
		CALL CARD_CHECK_FIN_DATA(듀얼리스트,"손패취득")
		SIF RESULT != 1
			RETURN 0
	ELSEIF ゾーン == "필드"
		SIF 발동済_2(듀얼리스트,5345)
			RETURN 0

		CALL FULLRESET
		CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환",2)
		SIF RESULT != 1
			RETURN 0

		CALL FULLRESET
		효과範囲덱 = 1
		효과条件うらら解除 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ELSE
		RETURN 0
	ENDIF
	RETURN 1
ELSEIF 종류 == 攻撃時誘発
	SIF 발동済_2(듀얼리스트,5345)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件うらら解除 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK

	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_5345(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5345,1)
	IF RESULT == 0
		IF ゾーン == "손패"
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)

		ELSEIF ゾーン == "필드"
			TRYCALLFORM CARD_UI(GETVAR(@"%듀얼리스트%_덱:0"))
			TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_덱:0")}("종류")
			IF RESULT <= モン全般
				CALL FULLRESET
				효과추가종류 = 5
				CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"표시변경")
			ELSEIF RESULT >= 20
				CALL FULLRESET
				효과範囲필드 = 1
				효과範囲묘지 = 1
				효과条件속성 = 바람속성
				CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5345,2)
	IF RESULT == 0
		TRYCALLFORM CARD_UI(GETVAR(@"%듀얼리스트%_덱:0"))
		TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_덱:0")}("종류")
		IF RESULT <= モン全般
			CALL FULLRESET
			효과추가종류 = 5
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"표시변경")
		ELSEIF RESULT >= 20
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲묘지 = 1
			효과条件속성 = 바람속성
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF
