@CARDNAME_64822,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 긴급 헌터
	CASE "略称"
		RESULTS = 난입연속수렵
	CASE "カテゴリ"
		RESULTS:0 = 헌터
	CASE "出典作品"
		RESULTS:0 = Monster Hunter
ENDSELECT

@CARD_64822(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 速攻마법
ENDSELECT

RETURN 0

@CARD_EXPLANATION_64822(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 ①②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動, 손패起動,フリー誘発)
PRINTL ①: 자신 필드에 "헌터" 카드가 앞면 표시로 존재할 경우, 메인 페이즈에 발동할 수 있다.
PRINTL 상대는 자신의 EX덱에서 레벨 6 이상의 『렵수』인 몬스터를 3장까지 고른다.
PRINTL 그 중에서 무작위로 １장을 상대 필드에 공격 표시로 특수 소환한다.
PRINTL 그 후, 자신의 제외 상태인 『렵수』 몬스터 １장을 상대 필드에 공격 표시로 특수 소환할 수 있다.
PRINTL 그렇게 한 경우, 상대 필드의 『렵수』 가 아닌 몬스터를 모두 패로 되돌린다.
PRINTL (『렵수』란, 드래곤족 야수족 비행야수족 비늘야수족 악마족 곤충족 바다생물족 미확인족 원소정령족 몬스터를 가리킨다.)



@CARDCAN_64822(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,64822)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 발동済_1(듀얼리스트,64822)
		RETURN 0
	SIF モンスター数(対面者) >= 5
		RETURN 0

	CALL FULLRESET
	효과範囲EX덱 = 1
	CALL SET_MONSTER_HUNTER
	CALL 효과条件レベル_ADV(6, "以上")
	효과条件固名前起動 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT <= 2
		RETURN 0

	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 헌터
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_64822(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード,10
#DIM DYNAMIC ランダム

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,64822,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲상대EX덱 = 1
		효과条件複数 = 3
		CALL SET_MONSTER_HUNTER
		CALL 효과条件レベル_ADV(6, "以上")
		효과条件固名前選択 = 1
		효과条件RND = 1
		CALL CARD_SP_SUMMON_ADV(対面者,ゾーン,場所,"攻撃표시")
		IF RESULT
			CALL FULLRESET
			효과範囲제외 = 1
			CALL SET_MONSTER_HUNTER
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"攻撃표시",1)
			IF RESULT == 1
				CALL FULLRESET
				효과条件종족:0 = 마법사족
				효과条件종족:1 = 언데드족
				효과条件종족:2 = 전사족
				효과条件종족:3 = 기계족
				효과条件종족:4 = 악마족
				효과条件종족:5 = 천사족
				효과条件종족:6 = 식물족
				효과条件종족:7 = 사이킥족
				효과条件종족:8 = 사이버스족
					CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드全体",場所,"손패")
			ENDIF
		ENDIF	
	ENDIF
ENDIF
