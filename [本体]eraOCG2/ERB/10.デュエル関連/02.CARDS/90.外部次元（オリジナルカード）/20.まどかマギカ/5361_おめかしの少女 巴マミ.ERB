@CARDNAME_5361,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 멋부린 소녀 토모에 마미
	CASE "略称"
		RESULTS = 소녀 마미
	CASE "カテゴリ"
		RESULTS:0 = 푸엘라 마기
	CASE "出典作品"
		RESULTS:0 = 마법소녀 마도카☆마기카
ENDSELECT


@CARD_5361(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"	
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 700
	CASE "守備力"
		RETURN 200
	CASE "성별"
		RETURN 牝性
	CASE "生成カード"
		RETURN 105361
	CASE "추가日"
		RETURN 251202
ENDSELECT

RETURN 0

@CARD_EXPLANATION_5361(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時,특수소환時)
PRINTL ①：이 카드가 소환 / 특수 소환에 성공한 경우、패를 １장 버리고 발동할 수 있다。
PRINTL 자신 필드에 "소울젬" １장을 특수 소환한다。
PRINTL 이 턴 자신은 S몬스터밖에 EX덱에서 특수 소환할 수 없다。
SETCOLOR C_D_GRAY
PRINTL 그 후、이 카드는 언데드족이 된다。
RESETCOLOR
CALLFORM CARD_ABLE(2,S素材時효과)
PRINTL ②：이 카드가 S소재로서 묘지로 보내진 경우에 발동할 수 있다。
PRINTL 필드의 "금색의 마법소녀 토모에 마미" １장을 골라、그 카드에 "소울젬"을 장착한다。
PRINTL 그 후、덱에서 이 카드명 이외의 "푸엘라 마기" 몬스터 １장을 패에 넣는다。
PRINTL 
PRINTL "소울젬"
PRINTL （마법사족 / 튜너 / 물 / 레벨１ / 공／수０）


@CARDCAN_5361(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,5361)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,5361)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,105361,"")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == S素材時효과
	SIF 발동済_2(듀얼리스트,5361)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 푸엘라 마기
	효과条件종류 = モン全般
	효과条件固名前 = 멋부린 소녀 토모에 마미
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_5361(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5361,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		CALL CARD_ADD_GY_BASIC(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_GENERATE(듀얼리스트,105361)
			EX소환可能종류 = 싱크로
			CALL CARD_EX_RESTRICTION(듀얼리스트)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"永種",언데드족,1)
		ENDIF
	ENDIF
ELSEIF 종류 == S素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,5361,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件名前 = 금색의 마법소녀 토모에 마미
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			CALL CARD_GENERATE_MAGIC(듀얼리스트,105361,1,選択カード)
		ENDIF
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 푸엘라 마기
		효과条件종류 = モン全般
		효과条件固名前 = 멋부린 소녀 토모에 마미
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF




@CARDNAME_105361,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 금색의 소울젬
	CASE "略称"
		RESULTS = 소울젬
	CASE "カテゴリ"
		RESULTS:0 = 푸엘라 마기
ENDSELECT


@CARD_105361(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常モン
	CASE "トークン"
		RETURN 1
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	CASE "튜너"
		RETURN 1
	CASE "自動소멸"
		RETURN 1
ENDSELECT

@CARD_EXPLANATION_105361(종류)
#DIM DYNAMIC 종류

;共通戦破耐性
PRINTL 이 카드가 몬스터 존을 벗어날 경우、이 카드는 소멸한다（게임에서 제거된다）
PRINTL ①：이 카드를 장착한 몬스터는 파괴 내성을 얻는다。


@CARDCAN_105361(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC 装備者
#DIM DYNAMIC 装備先

CALL 装備판정(듀얼리스트,場所,ゾーン)
装備者 = %RESULTS%
装備先 = RESULT

IF 종류 == 지속효과
	SIF ゾーン == "마함"
		RETURN 0
	SIF 装備先 != 5
		RETURN 1
	RETURN 0
ENDIF


@CARDEFFECT_105361(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 装備者
#DIM DYNAMIC 装備先

CALL 装備판정(듀얼리스트,場所,ゾーン)
装備者 = %RESULTS%
装備先 = RESULT

IF 종류 == 지속효과
	IF ゾーン == "마함"
		CALL FULLRESET
		CALL STATCHANGE_EFFECT(듀얼리스트,"装備",場所,"戦耐")
		CALL FULLRESET
		CALL STATCHANGE_EFFECT(듀얼리스트,"装備",場所,"破耐")
	ENDIF
ENDIF
