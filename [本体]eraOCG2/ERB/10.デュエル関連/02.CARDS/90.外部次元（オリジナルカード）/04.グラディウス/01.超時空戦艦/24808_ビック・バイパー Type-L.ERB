@CARDNAME_24808,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 빅 바이퍼 Type-L
	CASE "略称"
		RESULTS = VIC VIPER Type-L
	CASE "カテゴリ"
		RESULTS:0 = 시공 전투기
	CASE "出典作品"
		RESULTS:0 = Gradius
ENDSELECT


@CARD_24808(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1200
	CASE "守備力"
		RETURN 800
	CASE "추가日"
		RETURN 251114
ENDSELECT
RETURN 0

@CARD_EXPLANATION_24808(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,バトル開始時)
PRINTL ①：자신 배틀 페이즈 개시시、이하의 효과에서 １개를 선택해서 발동할 수 있다。
PRINTL ●패에서 기계족 몬스터 １장을 특수 소환한다。
PRINTL ●덱에서 레벨４ 이하의 기계족 / 빛속성 몬스터 １장을 묘지로 보낸다。
CALLFORM CARD_ABLE(2,戦闘→묘지,破壊→묘지)
PRINTL ②：이 카드가 파괴된 경우、자신 묘지의 기계족 / 빛속성 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터를 특수 소환한다。이 효과로 "시공 전투기" 몬스터 또는
PRINTL 원래 공격력이 １２００ 이하인 몬스터를 특수 소환한 경우、그 공격력은 １２００ 업한다。


@CARDCAN_24808(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,24808)
SIF RESULT == 1
	RETURN 0

IF 종류 == バトル開始時
	SIF 발동済_1(듀얼리스트,24808)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지
	SIF 발동済_2(듀얼리스트,24808)
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종족 = 기계족
	효과条件속성 = 빛속성
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_24808(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성,2
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 選択カテゴリ
#DIM DYNAMIC 選択カード_A

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == バトル開始時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24808,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件종족 = 기계족
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1 && モンスター数(듀얼리스트) < 5
			条件달성:0 = 1
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종족 = 기계족
		효과条件속성 = 빛속성
		CALL 효과条件レベル_ADV(4, "以下")
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件달성:1 = 1
		IF 条件달성:0 == 1 && 条件달성:1 == 1
			PRINTL 어느 효과를 발동하시겠습니까？
			CALL YN_CHOICE(듀얼리스트,"●패에서 기계족 몬스터 １장을 특수 소환한다。","●덱에서 레벨４ 이하의 기계족 / 빛속성 몬스터 １장을 묘지로 보낸다。")
		ELSEIF 条件달성:0 == 1 && 条件달성:1 == 0
			RESULT = 0
		ELSEIF 条件달성:0 == 0 && 条件달성:1 == 1
			RESULT = 1
		ENDIF
		IF RESULT == 0
			CALL FULLRESET
			효과範囲손패 = 1
			효과条件종족 = 기계족
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ELSE
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件종족 = 기계족
			효과条件속성 = 빛속성
			CALL 효과条件レベル_ADV(4, "以下")
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"덱",ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24808,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종족 = 기계족
		효과条件속성 = 빛속성
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT
			選択カード_ID = RESULT:1
			TRYCALLFORM CARDNAME_{選択カード_ID}("カテゴリ")

			選択カテゴリ = %RESULTS%
			TRYCALLFORM CARD_{選択カード_ID}("攻撃力")
			選択カード_A = RESULT
			SIF 選択カテゴリ == "시공 전투기" || 選択カード_A <= 1200
				CALL SET_FIELD_INFO(듀얼리스트,"필드",カード소환先,"永攻",1200)
		ENDIF
	ENDIF
ENDIF


