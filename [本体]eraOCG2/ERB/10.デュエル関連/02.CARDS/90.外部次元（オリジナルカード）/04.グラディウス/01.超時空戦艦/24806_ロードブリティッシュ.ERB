PRINTL ●상대 필드의 카드 １장을 골라 파괴한다。
PRINTL ●자신 필드에 "멀티플 토큰" １장을 특수 소환한다。
PRINTL 
PRINTL "멀티플 토큰"
PRINTL 기계족 / 빛 / 레벨４ / 공／수１２００

@CARDCAN_24806(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,24806)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_戦闘カード") != 場所
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_24806(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성,2
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"追戦",1)
ELSEIF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24806)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件달성:0 = 1
		SIF モンスター数(듀얼리스트) < 5
			条件달성:1 = 1
		IF 条件달성:0 == 1 && 条件달성:1 == 1
			PRINTL 어느 효과를 발동합니까?
			CALL YN_CHOICE(듀얼리스트,"●상대 필드의 카드 １장을 골라 파괴한다.","●자신 필드에 「멀티플 토큰」 １장을 특수 소환한다.")
		ELSEIF 条件달성:0 == 1 && 条件달성:1 != 1
			RESULT = 0
		ELSEIF 条件달성:0 != 1 && 条件달성:1 == 1
			RESULT = 1
		ENDIF
		IF RESULT == 0
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과範囲상대마함 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
		ELSE
			CALL FULLRESET
			CALL CARD_GENERATE(듀얼리스트,124806)
		ENDIF
	ENDIF
ENDIF


