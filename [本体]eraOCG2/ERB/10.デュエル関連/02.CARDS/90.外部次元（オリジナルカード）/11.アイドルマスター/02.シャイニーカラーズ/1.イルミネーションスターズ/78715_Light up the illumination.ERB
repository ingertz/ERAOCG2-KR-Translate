@CARDNAME_78715,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = Light up the illumination
	CASE "略称"
		RESULTS = 반짝임의 시작
	CASE "カテゴリ"
		RESULTS:0 = 일루미네이션 스타즈
	CASE "出典作品"
		RESULTS:0 = THE IDOLM@STER
		RESULTS:1 = SHINY COLORS
ENDSELECT

@CARD_78715(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 通常마법
ENDSELECT
RETURN 0

@CARDSUMMON_78715(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
RETURN 0

@CARD_EXPLANATION_78715(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드 이름의 효과는 각각 1턴에 1번밖에 사용할 수 없다.
CALL CARD_ABLE(1,손패起動,마함起動)
PRINTL ①: 패에서 "일루미네이션 스타즈" 몬스터 １장을 상대에게 보여준다。
PRINTL 그 후、덱 / 묘지에서 "사쿠라기 마노" "카자노 히오리" "하치미야 메구루" 몬스터 중、
PRINTL 이 효과로 상대에게 보여준 카드와 다른 카테고리의 몬스터 １장을 패에 넣는다。
PRINTL 이 효과의 발동 후、자신은 "일루미네이션 스타즈" 몬스터밖에 특수 소환할 수 없다。

@CARDCAN_78715(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

#DIM DYNAMIC 条件달성,3
#DIMS DYNAMIC 条件カテゴリ = "사쿠라기 마노", "카자노 히오리", "하치미야 메구루"

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,78715)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,78715)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	FOR カウンタ, 0, 3
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件カテゴリ = %条件カテゴリ:カウンタ%
		효과条件종류 = モン全般
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ:0 = %条件カテゴリ:((カウンタ + 1) % 3)%
			효과条件カテゴリ:1 = %条件カテゴリ:((カウンタ + 2) % 3)%
			효과条件종류 = モン全般
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				条件달성:カウンタ += 1
		ENDIF
	NEXT
	SIF !MATCH(条件달성,1)
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_78715(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 選択カテゴリ
#DIM DYNAMIC 条件달성,3
#DIMS DYNAMIC 条件カテゴリ = "사쿠라기 마노", "카자노 히오리", "하치미야 메구루"

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,78715,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
			FOR カウンタ, 0, 3
				CALL FULLRESET
				효과範囲손패 = 1
				효과条件カテゴリ = %条件カテゴリ:カウンタ%
				효과条件종류 = モン全般
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT == 1
					CALL FULLRESET
					효과範囲덱 = 1
					효과範囲묘지 = 1
					효과条件カテゴリ:0 = %条件カテゴリ:((カウンタ + 1) % 3)%
					효과条件カテゴリ:1 = %条件カテゴリ:((カウンタ + 2) % 3)%
					효과条件종류 = モン全般
					CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
					SIF RESULT == 1
						条件달성:カウンタ += 1
				ENDIF
			NEXT
			CALL FULLRESET
			효과範囲손패 = 1
			FOR カウンタ, 0, 3
				SIF 条件달성:カウンタ
					효과条件カテゴリ:カウンタ = %条件カテゴリ:カウンタ%
			NEXT
			CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
			選択カードID = RESULT:99
			IF RESULT != 9999
				選択カテゴリ = -1
				TRYCALLFORM CARDNAME_{選択カードID}("カテゴリ")
				FOR カウンタ, 0, 3
					IF MATCH(RESULTS,条件カテゴリ:カウンタ)
						選択カテゴリ = カウンタ
						BREAK
					ENDIF
				NEXT
				SIF 選択カテゴリ == -1
					RETURN
				CALL FULLRESET
				효과範囲덱 = 1
				효과範囲묘지 = 1
				FOR カウンタ, 0, 2
					효과条件カテゴリ:カウンタ = %条件カテゴリ:((選択カテゴリ + 1 + カウンタ) % 3)%
				NEXT
				효과条件종류 = モン全般
				CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
		CALL CARD_SS_RESTRICTION(듀얼리스트,"일루미네이션 스타즈")
	ENDIF
ENDIF