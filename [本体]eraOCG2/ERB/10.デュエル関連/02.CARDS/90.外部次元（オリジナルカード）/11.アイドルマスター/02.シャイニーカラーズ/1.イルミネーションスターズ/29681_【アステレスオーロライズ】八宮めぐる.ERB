@CARDNAME_29681,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 【아스텔레스오로라이즈】하치미야 메구루
	CASE "略称"
		RESULTS = ＡＡ메구루
	CASE "カテゴリ"
		RESULTS:0 = 일루미네이션 스타즈
		RESULTS:1 = 하치미야 메구루
		RESULTS:2 = 샤이니 컬러즈
ENDSELECT

@CARD_29681(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 1500
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		RETURN 4662
ENDSELECT
RETURN 0

@CARD_EXPLANATION_29681(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,소환時,특수소환時)
PRINTL ①：이 몬스터가 소환 / 특수 소환된 경우에 발동할 수 있다。
PRINTL 패를 １장 버리고、덱에서 이 효과로 버린 카드명 이외이면서 이 카드명 이외의 "일루미네이션 스타즈" 몬스터 １장을 패에 넣는다。
CALL CARD_ABLE(11,필드起動,フリー誘発)
PRINTL ②：이 카드가 필드에 앞면 표시로 존재하는 한 １번만、이 카드가 맥시멈 상태인 경우에 발동할 수 있다。
PRINTL 이 턴、자신 필드의 "일루미네이션 스타즈" 몬스터는 대상 내성을 얻고、
PRINTL 자신 필드의 맥시멈 상태의 "카자노 히오리" "하치미야 메구루" 몬스터는 전투 내성을 얻는다。

@CARDCAN_29681(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,29681)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,29681)
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 일루미네이션 스타즈
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	CALL CARDCAN_29681(듀얼리스트,맥시멈条件,ゾーン,場所)
	SIF !RESULT
		RETURN 0
	RETURN 1
ELSEIF 종류 == 短紋章起動
	RETURN 1
ELSEIF 종류 == 맥시멈条件
	SIF ゾーン != "필드"
		RETURN 0
	CALL CARD_CHECK_MAXX(듀얼리스트,ゾーン,場所,"일루미네 코어")
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_29681(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,29681,1)
	IF RESULT == 0
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
		IF RESULT == 1
			選択カードID = RESULT:1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 일루미네이션 스타즈
			효과条件固ID = 選択カードID
			효과条件固名前 = 【아스텔레스오로라이즈】하치미야 메구루
			효과条件종류 = モン全般
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 短紋章起動
	FOR カウンタ, 0, 5
		選択カードID = GETVAR(@"%듀얼리스트%_필드:カウンタ")
		TRYCALLFORM CARDNAME_{選択カードID}("カテゴリ")
		IF MATCH(RESULTS,"일루미네이션 스타즈")
			CALL STATCHANGE_EFFECT(듀얼리스트,"自身",カウンタ,"対耐")
		ENDIF
		IF MATCH(RESULTS,"카자노 히오리") || MATCH(RESULTS,"하치미야 메구루")
			TRYCALLFORM CARDCAN_{選択カードID}(듀얼리스트,맥시멈条件,"필드",カウンタ)
			SIF RESULT == 1
				CALL STATCHANGE_EFFECT(듀얼리스트,"自身",カウンタ,"戦耐")
		ENDIF
	NEXT
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,29681,11)
	IF RESULT == 0
		CALL CARD_RESERV(듀얼리스트,29681,短紋章予約)
	ENDIF
ELSEIF 종류 == 맥시멈条件
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦無")
ENDIF