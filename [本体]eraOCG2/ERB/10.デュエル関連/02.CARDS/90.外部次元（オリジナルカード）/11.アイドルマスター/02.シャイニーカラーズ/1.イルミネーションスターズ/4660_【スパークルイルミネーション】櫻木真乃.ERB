@CARDNAME_4660,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 【스파클 일루미네이션】사쿠라기 마노
	CASE "略称"
		RESULTS = SI 마노
	CASE "カテゴリ"
		RESULTS:0 = 일루미네이션 스타즈
		RESULTS:1 = 사쿠라기 마노
	CASE "맥시멈"
		RESULTS = 일루미네 코어
	CASE "出典作品"
		RESULTS:0 = THE IDOLM@STER
		RESULTS:1 = SHINY COLORS
ENDSELECT

@CARD_4660(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 牝性
ENDSELECT
RETURN 0

@CARD_EXPLANATION_4660(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：자신 메인 페이즈에、이 카드가 패에 존재하는 경우에 발동할 수 있다。
PRINTL 자신 필드의 몬스터를 전부 패로 되돌리고、패의 이 카드를 공격 표시로 특수 소환한다。
PRINTL 그 후、패에서 "카자노 히오리" 몬스터와 "하치미야 메구루" 몬스터를 각각 １장까지 공격 표시로 특수 소환할 수 있다。
PRINTL 이 효과를 발동한 턴、자신은 "일루미네이션 스타즈" 몬스터밖에 특수 소환할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：이 카드가 몬스터 존의 중앙에 존재하는 경우、
PRINTL 이 카드와 인접한 "카자노 히오리" "하치미야 메구루" 몬스터와 맥시멈 상태가 될 수 있다。
CALLFORM CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ③：자신 / 상대 턴에 발동할 수 있다。
PRINTL 자신 필드의 "카자노 히오리" "하치미야 메구루" 몬스터중 １장을 패로 되돌린다。
PRINTL 그 후、패에서 "카자노 히오리" "하치미야 메구루" 몬스터 중、
PRINTL 이 효과로 패로 되돌린 카드명이 아니면서 그 카드와 같은 카테고리의 몬스터 １장을 공격 표시로 특수 소환한다。

@CARDCAN_4660(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC カウンタC
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 存在ひおり,5
#DIM DYNAMIC 存在めぐる,5
#DIM DYNAMIC 条件달성ひおり
#DIM DYNAMIC 条件달성めぐる

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,4660)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,4660)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,4660,ゾーン,1)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과条件固カテゴリ = 일루미네이션 스타즈
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"SS이력")
	SIF RESULT != 0
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF 場所 != 2
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_2(듀얼리스트,4660)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	FOR カウンタ, 0, 5
		選択カードID = GETVAR(@"%듀얼리스트%_필드:カウンタ")
		SIF 選択カードID < 1
			CONTINUE
		TRYCALLFORM CARDNAME_{選択カードID}("カテゴリ")
		IF MATCH(RESULTS,"카자노 히오리")
			存在ひおり:カウンタB = 選択カードID
			カウンタB++
		ELSEIF MATCH(RESULTS,"하치미야 메구루")
			存在めぐる:カウンタC = 選択カードID
			カウンタC++
		ENDIF
	NEXT
	IF カウンタB
		FOR カウンタ, 0, VARSIZE("存在ひおり")
			SIF 存在ひおり:カウンタ < 1
				CONTINUE
			CALL FULLRESET
			효과範囲손패 = 1
			효과条件固ID:カウンタ = 存在ひおり:カウンタ
			효과条件カテゴリ = 카자노 히오리
			효과条件소환可 = 2
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				条件달성ひおり = 1
		NEXT
	ENDIF
	IF カウンタC
		FOR カウンタ, 0, VARSIZE("存在めぐる")
			SIF 存在めぐる:カウンタ < 1
				CONTINUE
			CALL FULLRESET
			효과範囲손패 = 1
			효과条件固ID:カウンタ = 存在めぐる:カウンタ
			효과条件カテゴリ = 하치미야 메구루
			효과条件소환可 = 2
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				条件달성めぐる = 1
		NEXT
	ENDIF
	SIF !条件달성ひおり && !条件달성めぐる
		RETURN 0
	RETURN 1
ELSEIF 종류 == 맥시멈条件
	SIF ゾーン != "필드"
		RETURN 0
	CALL CARD_CHECK_MAXX(듀얼리스트,ゾーン,場所,"일루미네 파츠")
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_4660(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC カウンタC
#DIM DYNAMIC カウンタD
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 存在ひおり,5
#DIM DYNAMIC 存在めぐる,5
#DIM DYNAMIC 条件달성ひおり
#DIM DYNAMIC 条件달성めぐる
#DIM DYNAMIC 候補カード,10

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4660,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"손패")
		IF RESULT == 1
			CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所,"攻撃표시")
			IF RESULT == 1
				CALL FULLRESET
				효과範囲손패 = 1
				효과条件カテゴリ = 카자노 히오리
				효과条件소환可 = 1
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				SIF RESULT == 1
					CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"攻撃표시")
				CALL FULLRESET
				효과範囲손패 = 1
				효과条件カテゴリ = 하치미야 메구루
				효과条件소환可 = 1
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				SIF RESULT == 1
					CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"攻撃표시")
			ENDIF
		ENDIF
		CALL CARD_SS_RESTRICTION(듀얼리스트,"일루미네이션 스타즈")
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4660,2)
	IF RESULT == 0
		FOR カウンタ, 0, 5
			選択カードID = GETVAR(@"%듀얼리스트%_필드:カウンタ")
			TRYCALLFORM CARDNAME_{選択カードID}("カテゴリ")
			IF MATCH(RESULTS,"카자노 히오리")
				存在ひおり:カウンタB = 選択カードID
				カウンタB++
			ELSEIF MATCH(RESULTS,"하치미야 메구루")
				存在めぐる:カウンタC = 選択カードID
				カウンタC++
			ENDIF
		NEXT
		IF カウンタB
			FOR カウンタ, 0, VARSIZE("存在ひおり")
				SIF 存在ひおり:カウンタ < 1
					CONTINUE
				CALL FULLRESET
				효과範囲손패 = 1
				효과条件固ID:カウンタ = 存在ひおり:カウンタ
				효과条件カテゴリ = 카자노 히오리
				효과条件소환可 = 2
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT == 1
					条件달성ひおり = 1
					候補カード:カウンタD = 存在ひおり:カウンタ
					カウンタD++
				ENDIF
			NEXT
		ENDIF
		IF カウンタC
			FOR カウンタ, 0, VARSIZE("存在めぐる")
				SIF 存在めぐる:カウンタ < 1
					CONTINUE
				CALL FULLRESET
				효과範囲손패 = 1
				효과条件固ID:カウンタ = 存在めぐる:カウンタ
				효과条件カテゴリ = 하치미야 메구루
				효과条件소환可 = 2
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT == 1
					条件달성めぐる = 1
					候補カード:カウンタD = 存在めぐる:カウンタ
					カウンタD++
				ENDIF
			NEXT
		ENDIF
		IF 条件달성ひおり || 条件달성めぐる
		CALL FULLRESET
		SIF 条件달성ひおり
				효과条件カテゴリ = 카자노 히오리
			IF 条件달성めぐる
				IF 효과条件カテゴリ != ""
					효과条件カテゴリ:1 = 하치미야 메구루
				ELSE
					효과条件カテゴリ:0 = 하치미야 메구루
				ENDIF
			ENDIF
			FOR カウンタ, 0, カウンタD
				SIF 候補カード:カウンタ < 1
					BREAK
				효과条件ID:カウンタ = 候補カード:カウンタ
			NEXT
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
			IF RESULT != 9999
				選択カードID = RESULT:99
				CALL CARD_DISPOSE(듀얼리스트,"필드",RESULT,손패行き)
				IF RESULT == 1
					CALL FULLRESET
					효과範囲손패 = 1
					효과条件固ID = 選択カードID
					TRYCALLFORM CARDNAME_{選択カードID}("カテゴリ")
					IF MATCH(RESULTS,"카자노 히오리")
						효과条件カテゴリ = 카자노 히오리
					ELSEIF MATCH(RESULTS,"하치미야 메구루")
						효과条件カテゴリ = 하치미야 메구루
					ENDIF
					CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"攻撃표시")
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
