@CARDNAME_98716,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = Star n dew by me
	CASE "略称"
		RESULTS = Star n dew by me
	CASE "カテゴリ"
		RESULTS:0 = 일루미네이션 스타즈
	CASE "出典作品"
		RESULTS:0 = THE IDOLM@STER
		RESULTS:1 = SHINY COLORS
ENDSELECT

@CARD_98716(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 通常함정
ENDSELECT
RETURN 0

@CARDSUMMON_98716(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
RETURN 0

@CARD_EXPLANATION_98716(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 １턴에 어느것인가 １개밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,발동誘発)
PRINTL ①：상대의 효과가 발동한 경우에 발동할 수 있다。
PRINTL 자신의 맥시멈 상태인 "일루미네이션 스타즈" 몬스터 １장을 덱으로 되돌리고、
PRINTL 그 효과를 무효로 하고 덱으로 되돌린다。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②：자신 메인 페이즈에、자신 필드에 맥시멈 상태인 몬스터가 존재하는 경우에 발동할 수 있다。
PRINTL 묘지의 이 카드를 제외하고、덱에서 이 카드명 이외의 "일루미네이션 스타즈" 마법 / 함정카드 １장을 세트한다。

@CARDCAN_98716(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,98716)
SIF RESULT == 1
	RETURN 0

IF 종류 == 발동誘発
	SIF 발동済_1(듀얼리스트,98716)
		RETURN 0
	SIF 발동済_2(듀얼리스트,98716)
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1	
		RETURN 0
	FOR カウンタ, 1, 3
		選択カードID = GETVAR(@"%듀얼리스트%_필드:カウンタ")
		SIF 選択カードID < 1
			CONTINUE
		TRYCALLFORM CARDNAME_{選択カードID}("カテゴリ")
		SIF !MATCH(RESULTS,"일루미네이션 스타즈")
			CONTINUE
		TRYCALLFORM CARDCAN_{選択カードID}(듀얼리스트,맥시멈条件,"필드",カウンタ)
		IF RESULT == 1
			条件달성++
			BREAK
		ENDIF
	NEXT
	SIF 条件달성 < 1
		RETURN 0
	CALL FULLRESET
	효과条件종류 = 마함全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 0
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,98716)
		RETURN 0
	SIF 발동済_2(듀얼리스트,98716)
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	FOR カウンタ, 1, 3
		選択カードID = GETVAR(@"%듀얼리스트%_필드:カウンタ")
		SIF 選択カードID < 1
			CONTINUE
		TRYCALLFORM CARDCAN_{選択カードID}(듀얼리스트,맥시멈条件,"필드",カウンタ)
		IF RESULT == 1
			条件달성++
			BREAK
		ENDIF
	NEXT
	SIF 条件달성 < 1
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 일루미네이션 스타즈
	효과条件종류 = 마함全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_98716(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 候補カード,3

#DIM DYNAMIC 손패起動효과

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,98716,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		FOR カウンタ, 1, 3
			選択カードID = GETVAR(@"%듀얼리스트%_필드:カウンタ")
			SIF 選択カードID < 1
				CONTINUE
			TRYCALLFORM CARDNAME_{選択カードID}("カテゴリ")
			SIF !MATCH(RESULTS,"일루미네이션 스타즈")
				CONTINUE
			TRYCALLFORM CARDCAN_{選択カードID}(듀얼리스트,맥시멈条件,"필드",カウンタ)
			IF RESULT == 1
				候補カード:カウンタB = カウンタ
				カウンタB++
			ENDIF
		NEXT
		CALL FULLRESET
		효과範囲필드 = 1
		FOR カウンタ, 0, カウンタB
			효과条件固定 = 候補カード
		NEXT
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"덱")
			RETURN 1
		ENDIF
	ENDIF
	RETURN 0
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,98715,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 일루미네이션 스타즈
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"裏側표시")
	ENDIF
ENDIF

