@CARDNAME_78716,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 눈동자에 빛나는、무한한 가능성
	CASE "略称"
		RESULTS = 눈동자에 가능성
	CASE "カテゴリ"
		RESULTS:0 = 일루미네이션 스타즈
		RESULTS:1 = 샤이니 컬러즈
ENDSELECT

@CARD_78716(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "종류"
		RETURN 지속마법
ENDSELECT
RETURN 0

@CARDSUMMON_78716(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
RETURN 0

@CARD_EXPLANATION_78716(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,마함起動,손패起動)
PRINTL ①：이 카드의 발동시의 효과처리로서、덱에서 "일루미네이션 스타즈" 몬스터 １장을 패에 넣을 수 있다。
CALL CARD_ABLE(0,소환強制誘発)
PRINTL ②：자신 필드에 "일루미네이션 스타즈" 몬스터가 소환 / 특수 소환될 때마다、이 카드에 개별 카운터를 １개 놓는다。
CALL CARD_ABLE(0,身代효과)
PRINTL ③：자신 필드의 "일루미네이션 스타즈" 몬스터가 전투 / 효과에 의해 파괴될 경우、
PRINTL 대신에 이 카드에 놓인 개별 카운터를 ３개 제거할 수 있다。

@CARDCAN_78716(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,78716)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ゾーン == "마함" && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
		RETURN 0
	SIF 발동済_1(듀얼리스트,78716)
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환強制誘発
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2
		RETURN 0
	SIF 最終소환決者 != 듀얼리스트
		RETURN 0
	SIF !GROUPMATCH(最終소환타입,"특수","EX특수")
		RETURN 0
	TRYCALLFORM CARDNAME_{最終소환ID}("カテゴリ")
	SIF !MATCH(RESULTS,"일루미네이션 스타즈")
		RETURN 0
	RETURN 1
ELSEIF 종류 == 身代효과
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2
		RETURN 0
	SIF !GROUPMATCH(破壊종류,"戦闘","효과")
		RETURN 0
	SIF 破壊대상ゾーン != "필드"
		RETURN 0
	TRYCALLFORM CARDNAME_{破壊대상ID}("カテゴリ")
	SIF !MATCH(RESULTS,"일루미네이션 스타즈")
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_個Ｃ:場所") < 3
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_78716(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 候補カードID,紙束最大値
#DIM DYNAMIC カウンタB

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,78716,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 일루미네이션 스타즈
		효과条件종류 = モン全般
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 일루미네이션 스타즈
			효과条件종류 = モン全般
			효과条件任意 = 1
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 소환強制誘発
	PRINTFORMW "눈동자에 빛나는、무한한 가능성"『{場所}』에 카운터가 놓였습니다。
	CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"個Ｃ",1)
ELSEIF 종류 == 身代효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,78716)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,"마함",場所,"個Ｃ",-3)
		PRINTFORMW "눈동자에 빛나는、무한한 가능성"『{場所}』이 카운터를 ３개 제거함으로써 파괴를 방지했습니다。
		RETURN 1
	ENDIF
	RETURN 0
ENDIF