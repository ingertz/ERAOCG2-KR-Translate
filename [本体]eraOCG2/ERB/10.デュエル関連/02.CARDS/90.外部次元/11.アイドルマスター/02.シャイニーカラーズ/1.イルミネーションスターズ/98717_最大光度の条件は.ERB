@CARDNAME_98717,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 최대광도의 조건은
	CASE "略称"
		RESULTS = 최대광도의 조건
	CASE "カテゴリ"
		RESULTS:0 = 일루미네이션 스타즈
		RESULTS:1 = 샤이니 컬러즈
ENDSELECT

@CARD_98717(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "종류"
		RETURN 지속함정
ENDSELECT
RETURN 0

@CARDSUMMON_98717(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
RETURN 0

@CARD_EXPLANATION_98717(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(0,소환強制誘発)
PRINTL ①：자신 필드에 "일루미네이션 스타즈" 몬스터가 소환 / 특수 소환될때 마다、이 카드에 개별 카운터를 １개 놓는다。
CALL CARD_ABLE(1,마함起動,フリー誘発)
PRINTL ②：자신 / 상대 턴에 발동할 수 있다。
PRINTL 자신 필드의 몬스터 １장을 패로 되돌리고、
PRINTL 패에서 이 효과로 패로 되돌린 카드 명 이외의 "사쿠라기 마노" "카자노 히오리" "하치미야 메구루" 몬스터 １장을 공격 표시로 특수 소환한다。
CALL CARD_ABLE(2,攻撃時誘発)
PRINTL ③：자신 필드의 "일루미네이션 스타즈" 몬스터가 전투를 하는 공격 선언시에、전투를 하는 그 자신의 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 이 카드의 개별 카운터를 원하는 만큼 제거하고、그 몬스터의 공격력은 엔드 페이즈까지 이 효과로 제거한 개별 카운터의 수×２００오른다。

@CARDCAN_98717(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 存在カードID,5
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,98717)
SIF RESULT == 1
	RETURN 0

IF (종류 == 마함起動 || (ゾーン == "마함" && 종류 == フリー誘発)) && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 발동済_1(듀얼리스트,78716)
		RETURN 0
	FOR カウンタ, 0, 5
		選択カードID = GETVAR(@"%듀얼리스트%_필드:カウンタ")
		SIF 選択カードID < 1
			CONTINUE
		存在カードID:カウンタB = 選択カードID
		カウンタB++
	NEXT
	IF カウンタB
		FOR カウンタ, 0, VARSIZE("存在カードID")
			SIF 存在カードID:カウンタ
				CONTINUE
			CALL FULLRESET
			효과範囲손패 = 1
			효과条件固ID:カウンタ = 存在カードID:カウンタ
			효과条件カテゴリ:0 = 사쿠라기 마노
			효과条件カテゴリ:1 = 카자노 히오리
			효과条件カテゴリ:2 = 하치미야 메구루
			효과条件소환可 = 2
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1
				条件달성 = 1
				BREAK
			ENDIF
		NEXT
	ENDIF
	SIF !条件달성
		RETURN 0
	RETURN 1
ELSEIF (종류 == 마함起動 || 종류 == フリー誘発)
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") == 3	
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時誘発
	SIF 발동済_2(듀얼리스트,78716)
		RETURN 0
	SIF ゾーン != "마함" 
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	TRYCALLFORM CARDNAME_{戦闘カードID(듀얼리스트)}("カテゴリ")
	SIF RESULTS != "일루미네이션 스타즈"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_個Ｃ:場所") < 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환強制誘発
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2
		RETURN 0
	SIF !GROUPMATCH(最終소환타입,"특수","EX특수")
		RETURN 0
	TRYCALLFORM CARDNAME_{最終소환ID}("カテゴリ")
	SIF !MATCH(RESULTS,"일루미네이션 스타즈")
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_98717(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC カウンタC
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 存在カードID,5
#DIM DYNAMIC 候補カードID,5
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF (종류 == 마함起動 || (ゾーン == "마함" && 종류 == フリー誘発)) && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,98717,1)
	IF RESULT == 0
		FOR カウンタ, 0, 5
			選択カードID = GETVAR(@"%듀얼리스트%_필드:カウンタ")
			SIF 選択カードID < 1
				CONTINUE
			存在カードID:カウンタB = 選択カードID
			カウンタB++
		NEXT
		IF カウンタB
			FOR カウンタ, 0, VARSIZE("存在カードID")
				SIF 存在カードID:カウンタ
					CONTINUE
				CALL FULLRESET
				효과範囲손패 = 1
				효과条件固ID:カウンタ = 存在カードID:カウンタ
				효과条件カテゴリ:0 = 사쿠라기 마노
				효과条件カテゴリ:1 = 카자노 히오리
				효과条件カテゴリ:2 = 하치미야 메구루
				효과条件소환可 = 2
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT == 1
					候補カードID:カウンタC = 存在カードID:カウンタ
					カウンタC++
				ENDIF
			NEXT
		ENDIF
		CALL FULLRESET
		FOR カウンタ, 0, カウンタC
			SIF 候補カードID:カウンタ < 1
				BREAK
			효과条件ID:カウンタ = 候補カードID:カウンタ
		NEXT
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT != 9999
			選択カードID = RESULT:99
			CALL CARD_DISPOSE(듀얼리스트,"필드",RESULT,손패行き)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲손패 = 1
				효과条件固ID = 選択カードID
				효과条件カテゴリ:0 = 사쿠라기 마노
				효과条件カテゴリ:1 = 카자노 히오리
				효과条件カテゴリ:2 = 하치미야 메구루
				CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"攻撃표시")
			ENDIF
		ENDIF
	ENDIF
ELSEIF (종류 == 마함起動 || 종류 == フリー誘発)
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,98717)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		FOR カウンタ, 0, 5
			選択カードID = GETVAR(@"%듀얼리스트%_필드:カウンタ")
			SIF 選択カードID < 1
				CONTINUE
			存在カードID:カウンタB = 選択カードID
			カウンタB++
		NEXT
		IF カウンタB
			FOR カウンタ, 0, VARSIZE("存在カードID")
				SIF 存在カードID:カウンタ
					CONTINUE
				CALL FULLRESET
				효과範囲손패 = 1
				효과条件固ID:カウンタ = 存在カードID:カウンタ
				효과条件カテゴリ:0 = 사쿠라기 마노
				효과条件カテゴリ:1 = 카자노 히오리
				효과条件カテゴリ:2 = 하치미야 메구루
				효과条件소환可 = 2
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT == 1
					候補カードID:カウンタC = 存在カードID:カウンタ
					カウンタC++
				ENDIF
			NEXT
		ENDIF
		IF カウンタC && !발동済_1(듀얼리스트,98717)
			PRINTL そのまま①の효과を使用しますか？
			CALL YN_CHOICE(듀얼리스트)
			IF RESULT == はい
				CALL CARD_EFFECT_USE(듀얼리스트,98717,1)
				CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
				IF RESULT != 9999
					選択カードID = RESULT:99
					CALL CARD_DISPOSE(듀얼리스트,"필드",RESULT,손패行き)
					IF RESULT == 1
						CALL FULLRESET
						효과範囲손패 = 1
						효과条件固ID = 選択カードID
						효과条件カテゴリ:0 = 사쿠라기 마노
						효과条件カテゴリ:1 = 카자노 히오리
						효과条件カテゴリ:2 = 하치미야 메구루
						CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"攻撃표시")
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,98717,2)
	IF RESULT == 0
		PRINTL 제거할 카운터의 수를 선택해주세요。
		FOR カウンタ, 1, GETVAR(@"%듀얼리스트%_魔_個Ｃ:場所") + 1
			SIF カウンタ > 1 && カウンタ % 10 == 1
				PRINTL
			PRINTBUTTON @"[{カウンタ}]", カウンタ
		NEXT
		BINPUT
		CALL SET_FIELD_INFO(듀얼리스트,"필드",戦闘場所(듀얼리스트),"一攻",RESULT * 200)
	ENDIF
ELSEIF 종류 == 소환強制誘発
	PRINTFORMW "최대광도의 조건은"『{場所}』에 카운터가 놓였습니다。
	CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"個Ｃ",1)
ENDIF