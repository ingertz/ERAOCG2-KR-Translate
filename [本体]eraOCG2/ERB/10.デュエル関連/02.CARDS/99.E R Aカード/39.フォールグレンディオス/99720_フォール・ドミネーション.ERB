@CARD_EXPLANATION_99720(종류)
#DIM DYNAMIC 종류

; PRINTL 자신の마법＆함정カードの「함락주박」カード１枚を裏側표시にすることで、このカードは손패からも발동할 수 있다。
PRINTL 이 카드명의 효과는 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,마함起動,손패起動,フリー誘発)
PRINTL ①：자신 필드에 "GⱤꓤendios" 몬스터가 존재하는 경우에 발동할 수 있다。
PRINTL 자신의 덱 / 패 / 묘지 또는 상대의 묘지에서 "Ɽꓤ" 카드 이외의 암컷 몬스터 １장을 "함락주박" 카드로서 자신의 마법＆함정 존에 앞면 표시로 놓고、
PRINTL 자신의 ＥＸ덱 / 묘지의 "Ɽꓤ" 초차원 몬스터 １장을 특수 소환한다。
PRINTL 이 효과로 특수 소환된 몬스터는、이 효과로 마법＆함정 존에 놓은 카드와 같은 카드명으로도 취급한다、
PRINTL 이 효과로 마법＆함정 존에 놓인 카드는、이 효과로 특수 소환된 몬스터가 필드에서 벗어난 경우에 묘지로 보내진다。

@CARDCAN_99720(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ数

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,99720)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == フリー誘発 ;|| 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,99720)
		RETURN 0
	IF ゾーン == "마함"
		CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	; ELSEIF ゾーン == "손패"
	; 	SIF GETVAR(@"%듀얼리스트%_手_発可:場所") == 0
	; 		RETURN 0
	ELSE
		RETURN 0
	ENDIF
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = GⱤꓤendios
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲손패 = 1
	효과範囲묘지 = 1
	효과範囲상대묘지 = 1
	효과条件固カテゴリ = Ɽꓤ
	효과条件성별 = 牝性
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5 && ゾーン != "마함"
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과範囲묘지 = 1
	효과条件소환可 = 1
	효과条件カテゴリ = Ɽꓤ
	효과条件종류 = 초차원
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "손패"
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件カテゴリ = 함락주박
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
    RETURN 1
ENDIF

@CARDEFFECT_99720(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIMS DYNAMIC 選択ゾーン
#DIM DYNAMIC 修正値
#DIM DYNAMIC 상대カード使用
#DIM DYNAMIC 僕存在

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発 ;|| 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99720,1)
	IF RESULT == 0
		; IF ゾーン == "손패"
		; 	CALL FULLRESET
		; 	효과条件カテゴリ = 함락주박
		; 	효과条件표시 = 表側표시
		; 	CALL CARD_CHOOSE_BASIC(듀얼리스트,"마함",ゾーン,場所)
		; 	IF RESULT != 9999
		; 		選択カードID = RESULT:99
		; 		CALL SET_FIELD_INFO(듀얼리스트,"마함",RESULT,"表",3,上書きモード)
		; 		CALL KOJO_FARRGRENDIOS_BASE("함락주박",듀얼리스트,選択カードID)
		; 	ELSE
		; 		RETURN 0
		; 	ENDIF
		; ENDIF
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件固カテゴリ = GⱤꓤendios
		효과条件カテゴリ = Ɽꓤ
		효과条件종류 = 초차원
		CALL CARD_CHECK_ADV(듀얼리스트)
		SIF RESULT == 1
			僕存在 = 1
		選択カード = 現마함(듀얼리스트)
		CALL FULLRESET
		효과条件固カテゴリ = Ɽꓤ
		효과範囲덱 = 1
		효과範囲손패 = 1
		효과範囲묘지 = 1
		효과範囲상대묘지 = 1
		효과条件성별 = 牝性
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 9999
			選択カードID = RESULT:99
			CALL CARD_SELECT(듀얼리스트,RESULT)
			SIF 대상者（CS） != 듀얼리스트
				상대カード使用 = 1
			CALL CARD_ADD(듀얼리스트,本参照先（CS）,"마함",選択カード（CS）)
			CALL CARD_SET_CATEGORY(듀얼리스트,"마함",選択カード,"함락주박")
			;필드番号は+1で記録しないといけない(필드汎数の初期値は0のため)
			CALL SET_FIELD_INFO(듀얼리스트,"마함",選択カード,"汎数",現필드(듀얼리스트) + 1,上書きモード)
			CALL KOJO_FARRGRENDIOS_BASE("陥落超越_前",듀얼리스트,選択カードID,상대カード使用)
			CALL FULLRESET
			효과範囲EX덱 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ = Ɽꓤ
			효과条件종류 = 초차원
			효과추가종류 = 1000000 + 選択カードID
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			SIF 僕存在 != 1
				CALL KOJO_FARRGRENDIOS_BASE("陥落超越_後",듀얼리스트,選択カードID)
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_HAND(듀얼리스트,"지정",場所,"発可")
ENDIF