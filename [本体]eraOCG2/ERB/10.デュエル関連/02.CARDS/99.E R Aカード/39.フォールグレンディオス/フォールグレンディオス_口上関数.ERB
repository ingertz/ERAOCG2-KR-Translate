@TEXT_DECORATION_FARRGRENDIOS
ALIGNMENT CENTER
SETCOLOR C_RED
PRINTL ⱤOGUE CAꓤD ⱤOGUE CAꓤD ⱤOGUE CAꓤD ⱤOGUE CAꓤD ⱤOGUE CAꓤD ⱤOGUE CAꓤD ⱤOGUE CAꓤD ⱤOGUE CAꓤD ⱤOGUE CAꓤD ⱤOGUE CAꓤD ⱤOGUE CAꓤD ⱤOGUE CAꓤD ⱤOGUE CAꓤD ⱤOGUE CAꓤD
RESETCOLOR
ALIGNMENT LEFT

@KOJO_FARRGRENDIOS_BASE(シチュ,듀얼리스트,カードID = -1,상대カード使用 = 0,場所 = -1)
#DIMS DYNAMIC シチュ
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カードID
#DIM DYNAMIC 캐릭터ID
#DIMS DYNAMIC 캐릭터名
#DIM DYNAMIC 主存在
#DIM DYNAMIC 僕存在
#DIM DYNAMIC 상대カード使用
#DIM DYNAMIC 場所

SIF 듀얼리스트 != "자신"
	RETURN

SIF カードID == -1
	RETURN

CALL FULLRESET
효과範囲필드 = 1
효과条件カテゴリ = GⱤꓤendios
CALL CARD_CHECK_ADV(듀얼리스트)
SIF RESULT == 1
	主存在 = 1

CALL FULLRESET
효과範囲필드 = 1
효과範囲묘지 = 1
효과条件固カテゴリ = GⱤꓤendios
효과条件カテゴリ = Ɽꓤ
효과条件종류 = 초차원
CALL CARD_CHECK_ADV(듀얼리스트)
SIF RESULT == 1
	僕存在 = 1

CALL CARD_EROTICS(カードID,듀얼리스트)
캐릭터ID = RESULT

IF 캐릭터ID == -1
    TRYCALLFORM CARDNAME_{カードID}("略称")
    캐릭터名 = %RESULTS%
ELSE
    캐릭터名 = %CALLNAME:RESULT%
ENDIF

SELECTCASE シチュ
    CASE "ライド" ;グレンディオスライド時
    CASE "寵悦" ;主グレンディオス超越時
		CALL KOJO_FARRGRENDIOS_FARRSTRIDE_URRTIMATE(듀얼리스트)
    CASE "陥落超越_前" ;悪堕ちユニットＳＳ前
		CALL KOJO_FARRGRENDIOS_FARRSTRIDE_BEFORE(듀얼리스트,캐릭터ID,캐릭터名,상대カード使用,僕存在)
    CASE "陥落超越_後" ;悪堕ちユニットＳＳ後
		CALL KOJO_FARRGRENDIOS_FARRSTRIDE_AFTER(듀얼리스트,캐릭터名)
    CASE "함락주박" ;함락주박カードを裏返した時
		CALL KOJO_FARRGRENDIOS_FARR_RROCK(듀얼리스트,캐릭터ID,캐릭터名,상대カード使用)
    ; CASE "陥落解呪" ;함락주박カードが表に戻った時
    CASE "陥落連鎖" ;フィールド起動효과での悪堕ちＳＳ時
		CALL KOJO_FARRGRENDIOS_FARRSTRIDE_RRELICS(듀얼리스트,캐릭터ID,캐릭터名)
    CASE "陥獄" ;フィールドエンドステップ효과
		CALL KOJO_FARRGRENDIOS_FARREND_RRELICS(듀얼리스트,캐릭터ID,캐릭터名,主存在)
    CASE "勅令奉仕" ;勅令グレンディオス強化효과
		CALL KOJO_FARRGRENDIOS_FARREDICT_MASTER(듀얼리스트,캐릭터ID,캐릭터名,場所)
    CASE "勅令조교" ;勅令悪堕ち強化효과
		CALL KOJO_FARRGRENDIOS_FARREDICT_UNIT(듀얼리스트,캐릭터ID,캐릭터名,場所)
ENDSELECT

@KOJO_FARRGRENDIOS_FARRSTRIDE_BEFORE(듀얼리스트,캐릭터ID,캐릭터名,상대カード使用,僕存在)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 캐릭터ID
#DIMS DYNAMIC 캐릭터名
#DIM DYNAMIC 상대カード使用
#DIM DYNAMIC 僕存在

PRINTFORML %CALLNAME:MASTER%가 카드를 마법＆함정 존에 놓자, %캐릭터名%의 모습이 필드에 나타나──
PRINTFORMW ──그와 동시에 %캐릭터名%는 검은 고리 형태의 에너지에 손발이 구속되어, 대(大)자로 공중에 고정된다!
IF 캐릭터ID != -1 && (TALENT:캐릭터ID:연모 || TALENT:캐릭터ID:굴복됨)
	IF 상대カード使用
		PRINTFORMW 눈앞의 %CALLNAME:MASTER%를 홱 쏘아보는 %캐릭터名%였지만, 그 눈동자 속에는 확실한 기대의 빛이 떠올라 있다……
	ELSE
		PRINTFORMW 갑작스러운 구속에 %캐릭터名%는 놀란 기색이었지만, %CALLNAME:MASTER%의 모습을 확인하자 그 얼굴에 어두운 기대의 빛이 떠오른다……
	ENDIF
ELSE
	PRINTFORMW 갑작스러운 구속에 %캐릭터名%는 놀라, \@ 상대カード使用 == 0 ? 무심코 # \@구속을 풀려고 하지만, 고리 모양의 수갑과 족쇄는 꿈쩍도 않고 공중에 정지해 있다……
ENDIF
IF HAS_PENIS(MASTER)
    PRINTL
	PRINTFORML 이윽고 %CALLNAME:MASTER%는 그 강직함에 검고 꿈틀거리는 오라를 두르더니,
    PRINTFORMW 몸을 움직일 수 없는 %캐릭터名%를 난폭하게 범하기 시작했다……!
    IF 캐릭터ID != -1 && (TALENT:캐릭터ID:연모 || TALENT:캐릭터ID:굴복됨)
    	IF 상대カード使用
    		PRINTFORML 노골적으로 싫어하며 구속된 손발을 버둥거리는 %캐릭터名%였지만,
            PRINTFORMW 그 목소리에는 달콤함이 섞여 있고, 허리도 쾌락을 맛보려는 듯 추삽에 맞춰 움직이고 있다……
    	ELSE
    		PRINTFORMW %캐릭터名%는 그 능욕을 환희의 목소리로 맞이하며, 오히려 좁은 가동 범위에서 필사적으로 허리를 마주 흔들려 하고 있다……
    	ENDIF
    ELSE
    	PRINTFORMW 구속에서 벗어날 수도 없는 %캐릭터名%는 속수무책으로 유린당하고……
    ENDIF
    PRINTFORMW 그리고 %CALLNAME:MASTER%가 한층 더 강하게 남근을 비틀어 넣자──
    CALL FLASH()
    PRINTFORMW ──특농의 에너지와 함께 정액을 맨 안쪽에 분출했다……!
    PRINTFORMW 정액에 제압당하는 자궁에 호응하듯, 『함락/FaⱤꓤ』의 힘이 %캐릭터名%의 몸을, 마음을 물들여간다……!
    PRINTL
    IF 캐릭터ID != -1
		BASE:MASTER:절정 = 15000
        CALL EROTIC_MOVE("前穴凌辱",캐릭터ID,MASTER,100)
    ENDIF
    PRINTL
    PRINTFORML ──이윽고, %CALLNAME:MASTER%가 흘러넘치는 정액과 함께 %캐릭터名%에게서 떨어지자,
ELSE
    PRINTL
	PRINTFORML 이윽고 %CALLNAME:MASTER%는 그 몸에 검고 꿈틀거리는 오라를 두르고,
    PRINTFORMW 몸을 움직일 수 없는 %캐릭터名%에게 입을 맞추며 정성껏 애무하기 시작했다……!
    IF 캐릭터ID != -1 && (TALENT:캐릭터ID:연모 || TALENT:캐릭터ID:굴복됨)
    	IF 상대カード使用
    		PRINTFORML 노골적으로 싫어하며 구속된 손발을 버둥거리는 %캐릭터名%였지만,
            PRINTFORMW 달콤한 한숨을 내쉬며, 이쪽의 혀에 자신의 것을 얽어오고 있다……
    	ELSE
    		PRINTFORMW %캐릭터名%는 그 능욕을 환희의 목소리로 맞이하며, 오히려 좁은 가동 범위에서 필사적으로 허리를 마주 흔들려 하고 있다……
    	ENDIF
    ELSE
    	PRINTFORMW 구속에서 벗어날 수도 없는 %캐릭터名%는 속수무책으로 유린당하고……
    ENDIF
    PRINTFORMW 그리고 %CALLNAME:MASTER%가 구강과 비밀스러운 곳 깊숙이 각각의 침략자를 비틀어 넣자──
    CALL FLASH()
    PRINTFORMW ──특농의 에너지를 위에서도 아래에서도 주입한다……!
    PRINTFORML 삼켜버린 침이 목을 타고 흘러내릴 때마다, 손끝이 질벽에 파고들 때마다,
	PRINTFORMW 『함락/FaⱤꓤ』의 힘이 %캐릭터名%의 몸을, 마음을 물들여간다……!
    PRINTL
    IF 캐릭터ID != -1
        CALL EROTIC_MOVE("全身애무",캐릭터ID,MASTER,100)
    ENDIF
    PRINTL
    PRINTFORML ──이윽고, %CALLNAME:MASTER%가 입가의 은색으로 반짝이는 타액의 다리와 함께 %캐릭터名%에게서 떨어지자,
ENDIF
PRINTFORMW 넋이 나간 채 구속되어 있는 %캐릭터名%의 바로 아래와 그 앞쪽에, 한층 더 큰 검은 고리가 나타난다.
PRINTFORMW %캐릭터名% 아래의 검은 고리가, 스캔하는 듯한 움직임으로 발끝부터 천천히 그 몸을 통과해 가자,
IF 僕存在
	PRINTFORMW 그것에 호응하듯 앞쪽의 검은 고리가 상승해가고, 마침내 %캐릭터名%와 같은 용모의 Ɽꓤ 유닛이 소환되었다!
ELSE
	PRINTFORMW 그것에 호응하듯 앞쪽의 검은 고리가 상승해가고, 이쪽은 발끝부터 서서히 사람의 그림자가 나타나기 시작한다……
ENDIF

@KOJO_FARRGRENDIOS_FARRSTRIDE_AFTER(듀얼리스트,캐릭터名)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 캐릭터名

PRINTFORMW 이윽고 검은 고리가 완전히 올라가자 나타난 것은, %캐릭터名%와 같은 용모를 가진 유닛.
PRINTFORML 보디라인이 선명하게 드러나는 밀착성 높은 슈트를 입은 몸 곳곳에,
PRINTFORMW 뒤의 %캐릭터名%를 구속하고 있는 것과 같은 검은 고리를 띄우고 있다.
PRINTFORMW 그것과는 별개로 몸 곳곳에서 검은 고리가 이어진 사슬이 뻗어 나와, 뒤에서 책형에 처해진 %캐릭터名%와 연결되어 있었다.
PRINTL
PRINTFORML 그 표정은 마치 감정 따위는 없는 것처럼 차가웠지만,
PRINTFORMW %CALLNAME:MASTER%를 돌아보자, 돌변하여 아양을 떨듯 고혹적인 미소를 머금으며 절을 해왔다……

@KOJO_FARRGRENDIOS_FARR_RROCK(듀얼리스트,캐릭터ID,캐릭터名,상대カード使用)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 캐릭터ID
#DIMS DYNAMIC 캐릭터名
#DIM DYNAMIC 상대カード使用

#DIMS DYNAMIC 呪縛候補 = "搾乳","脳波","삽입","電撃","光線"
#DIMS DYNAMIC 조교内容

조교内容 = %呪縛候補:(RAND:VARSIZE("呪縛候補"))%

SELECTCASE 조교内容
	CASE "搾乳"
		PRINTFORML 공중에 구속되어 있는 %캐릭터名%의 유두와 국부에 컵 모양의 기계 팔이 눌려지고,
		PRINTFORMW 강렬한 진동과 함께 %캐릭터名%의 에너지를 흡수하기 위해 가동하기 시작한다……!
	    IF 캐릭터ID != -1
        	CALL EROTIC_MOVE("バスト凌辱",캐릭터ID,MASTER,300)
        	CALL EROTIC_MOVE("Ｃ애무",캐릭터ID,MASTER,300)
    	ENDIF
	CASE "脳波"
		PRINTFORML 공중에 구속되어 있는 %캐릭터名%의 머리에 헬멧 형태의 기계가 장착되고,
		PRINTFORMW 연속 클릭 같은 날카로운 구동음과 함께 %캐릭터名%의 정신에 직접 쾌락을 입력해간다……!
	    IF 캐릭터ID != -1
        	CALL EROTIC_MOVE("淫紋の疼き",캐릭터ID,MASTER,300)
    	ENDIF
	CASE "삽입"
		PRINTFORML 공중에 구속되어 있는 %캐릭터名%의 사타구니에 실린더를 갖춘 장치가 장착되고,
		PRINTFORMW 모터 같은 구동음과 함께 %캐릭터名%의 비밀스러운 곳을 피스톤 운동으로 유린해간다……!
	    IF 캐릭터ID != -1
        	CALL EROTIC_MOVE("前穴凌辱",캐릭터ID,MASTER,150)
    	ENDIF
	CASE "電撃"
		PRINTFORML 공중에 구속되어 있는 %캐릭터名%를 안테나나 전극 모양의 장치가 둘러싸고,
		PRINTFORMW 특수한 검은 전류로 %캐릭터名%의 성감대를 자극해간다……!
	    IF 캐릭터ID != -1
        	CALL EROTIC_MOVE("절정光線",캐릭터ID,MASTER,150)
    	ENDIF
	CASE "光線"
		PRINTFORML 공중에 구속되어 있는 %캐릭터名%를 무언가를 발사하는 듯한 형태의 장치가 둘러싸고,
		PRINTFORMW 검붉은 광선을 %캐릭터名%의 온갖 성감대에 쬐어간다……!
	    IF 캐릭터ID != -1
        	CALL EROTIC_MOVE("절정光線",캐릭터ID,MASTER,150)
    	ENDIF
ENDSELECT

IF 캐릭터ID != -1 && (TALENT:캐릭터ID:연모 || TALENT:캐릭터ID:굴복됨)
	IF 상대カード使用
		PRINTFORML 이를 악물고 버티는 %캐릭터名%였지만,
        PRINTFORMW 그런 필사적인 모습과는 반대로 생산 에너지를 나타내는 미터기는 고음의 관측음을 계속 울리고 있다……
	ELSE
		PRINTFORMW %캐릭터名%는 침이나 애액과 함께, 환희와 성애의 에너지를 계속 흘려보내고 있다……
	ENDIF
ELSE
	PRINTFORMW 구속에서 벗어날 수도 없는 %캐릭터名%는 속수무책으로 에너지를 계속 생산하고 있다……
ENDIF

@KOJO_FARRGRENDIOS_FARRSTRIDE_RRELICS(듀얼리스트,캐릭터ID,캐릭터名)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 캐릭터ID
#DIMS DYNAMIC 캐릭터名
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 候補ユニット,5
#DIM DYNAMIC 選択ユニット
#DIM DYNAMIC 조교캐릭터ID
#DIMS DYNAMIC 조교캐릭터名

VARSET 候補ユニット,-1
FOR カウンタ, 0, 5
	CALL CAT_CHECK("Ɽꓤ",듀얼리스트,カウンタ)
	SIF RESULT != 1
		CONTINUE
	CALL CAT_CHECK("GⱤꓤendios",듀얼리스트,カウンタ)
	SIF RESULT == 1
		CONTINUE
	TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_필드:カウンタ")}("종류")
	SIF RESULT != 초차원
		CONTINUE
	候補ユニット:カウンタB = カウンタ
	カウンタB++
NEXT

SIF カウンタB == 0
	RETURN

選択ユニット = 候補ユニット:(RAND:カウンタB)

CALL CARD_EROTICS_FIELD(듀얼리스트,"필드",選択ユニット)
조교캐릭터ID = RESULT

IF 조교캐릭터ID == -1
    TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_필드:選択ユニット")}("略称")
    조교캐릭터名 = %RESULTS%
ELSE
    조교캐릭터名 = %CALLNAME:RESULT%
ENDIF

PRINTFORML %CALLNAME:MASTER%가 카드를 마법＆함정 존에 놓자, %캐릭터名%의 모습이 필드에 나타나──
PRINTFORMW ──그와 동시에 %캐릭터名%는 검은 고리 형태의 에너지에 손발이 구속되어, 대(大)자로 공중에 고정된다!
PRINTL
PRINTFORMW 그렇게 몸을 움직일 수 없는 %캐릭터名%의 앞에, %조교캐릭터名%“Ɽꓤ”가 나타난다……
PRINTFORML 그 기이한 모습과 표정에 짧게 소리를 지른 %캐릭터名%를 아랑곳하지 않고,
PRINTFORMW %조교캐릭터名%는 온몸에 검은 오라를 두르더니, %캐릭터名%의 온몸을 애무하기 시작했다……!
PRINTL
PRINTFORML %조교캐릭터名%는 교묘한 수완으로 %캐릭터名%의 몸을 희롱하며, 주인의 위대함을 끊임없이 설파해간다……
PRINTFORML 그 속삭임이 귓가를 떨리게 할 때마다, 입술을 겹칠 때마다, 유두를 손톱이 스칠 때마다, 여음이 희롱당할 때마다,
PRINTFORMW %캐릭터名%의 마음을 어두운 에너지가 좀먹어간다……!
IF 캐릭터ID != -1
	IF 조교캐릭터ID != -1
    	CALL EROTIC_MOVE("全身애무",캐릭터ID,조교캐릭터ID,100)
	ELSE
    	CALL EROTIC_MOVE("全身애무",캐릭터ID,,100)
	ENDIF
ENDIF
PRINTFORML 이윽고 시점을 고정할 수도 없어, %캐릭터名%가 사지 구속에 체중을 맡길 수밖에 없게 되었을 무렵,
PRINTFORMW %조교캐릭터名%는 마침내 %캐릭터名%에게서 떨어져, 거대한 검은 고리를 출현시키더니, %캐릭터名%를 통과시킨다……
PRINTL
PRINTFORMW 완전히 통과한 검은 고리를 눈앞으로 이동시키고, %조교캐릭터名%가 서서히 양손을 펼치자──
PRINTFORMW 날카로운 비명 같은 소리와 함께 검은 고리가 산산조각 나고, 그 중심에서 %캐릭터名%의 모습을 한 Ɽꓤ 유닛이 나타났다!

@KOJO_FARRGRENDIOS_FARREND_RRELICS(듀얼리스트,캐릭터ID,캐릭터名,主存在)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 캐릭터ID
#DIMS DYNAMIC 캐릭터名
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC カウンタC
#DIM DYNAMIC 選択INDEX
#DIM DYNAMIC 候補行為数
#DIM DYNAMIC 候補ユニット数,2 ;0次元が可変、1次元が보존
#DIMS DYNAMIC 候補行為,20
#DIM DYNAMIC 候補ユニット,5
#DIM DYNAMIC 主存在
#DIM DYNAMIC 選択ユニット,5
#DIM DYNAMIC 選択캐릭터名,5
#DIMS DYNAMIC 選択行為,5 ;選択ユニットと選択行為は同一INDEX同士で結合
#DIM DYNAMIC 자위描写済INDEX,5 ;자위は連続したINDEXに格納されない場合があるので보존
#DIM DYNAMIC 촉수描写済INDEX,5 ;촉수は連続したINDEXに格納されない場合があるので보존
#DIM DYNAMIC 애무描写済INDEX,5 ;애무は連続したINDEXに格納されない場合があるので보존
#DIM DYNAMIC スキップ変数 ;FOR内のスキップに使用

FOR カウンタ, 0, 5
	CALL CAT_CHECK("Ɽꓤ",듀얼리스트,カウンタ)
	SIF RESULT != 1
		CONTINUE
	CALL CAT_CHECK("GⱤꓤendios",듀얼리스트,カウンタ)
	SIF RESULT == 1
		CONTINUE
	TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_필드:カウンタ")}("종류")
	SIF RESULT != 초차원
		CONTINUE
	候補ユニット:(候補ユニット数:0) = カウンタ
	候補ユニット数:0++
NEXT

SIF 候補ユニット数:0 == 0
	RETURN

候補ユニット数:1 = 候補ユニット数:0

DO
	カウンタ++
	SIF カウンタ > 10
		BREAK
	VARSET 候補行為
	VARSET 候補行為数
	候補行為:候補行為数 = 자위
	候補行為数++
	IF 候補ユニット数:0 > 1 && MATCH(選択行為,"레즈") == 0
		候補行為:候補行為数 = 레즈
		候補行為数++
	ENDIF
	IF 主存在 > 0
		候補行為:候補行為数 = 촉수
		候補行為数++
		IF MATCH(選択行為,"키스") == 0
			候補行為:候補行為数 = 키스
			候補行為数++
		ENDIF
		IF MATCH(選択行為,"애무") < 2
			候補行為:候補行為数 = 애무
			候補行為数++
		ENDIF
		IF MATCH(選択行為,"펠라") == 0 && MATCH(選択行為,"파이즈리") == 0
			候補行為:候補行為数 = 펠라
			候補行為数++
		ENDIF
		IF HAS_PENIS(MASTER) && MATCH(選択行為,"펠라") == 0 && MATCH(選択行為,"파이즈리") == 0
			候補行為:候補行為数 = 파이즈리
			候補行為数++
		ENDIF
	ENDIF

	SELECTCASE 選択行為:(カウンタB)
		CASE "레즈" ;레즈は相方を決定
			REPEAT 2
				選択行為:カウンタB = 레즈
				選択INDEX = RAND:(候補ユニット数:0)
				選択ユニット:カウンタB = 候補ユニット:選択INDEX
				ARRAYREMOVE 候補ユニット,選択INDEX,1
				候補ユニット数:0--
				カウンタB++
			REND
		CASE "펠라" ;펠라なら35%でダブル、15%でトリプル(人数がトリプルに足りないならダブルに置換)
			IF 候補ユニット数:0 > 1 && HAS_PENIS(MASTER)
				SELECTCASE RAND:100
					CASE IS < 50
						カウンタC = 1
					CASE IS < 85
						カウンタC = 2
					CASEELSE
						IF 候補ユニット数:0 > 2
							カウンタC = 3
						ELSE
							カウンタC = 2
						ENDIF
				ENDSELECT
			ENDIF
			REPEAT カウンタC
				選択行為:カウンタB = 펠라
				選択INDEX = RAND:(候補ユニット数:0)
				選択ユニット:カウンタB = 候補ユニット:選択INDEX
				ARRAYREMOVE 候補ユニット,選択INDEX,1
				候補ユニット数:0--
				カウンタB++
			REND
		CASE "파이즈리" ;50%でダブル
			IF 候補ユニット数:0 > 1 && HAS_PENIS(MASTER)
				SELECTCASE RAND:2
					CASE 0
						カウンタC = 1
					CASEELSE
						カウンタC = 2
				ENDSELECT
			ENDIF
			REPEAT カウンタC
				選択行為:カウンタB = 파이즈리
				選択INDEX = RAND:(候補ユニット数:0)
				選択ユニット:カウンタB = 候補ユニット:選択INDEX
				ARRAYREMOVE 候補ユニット,選択INDEX,1
				候補ユニット数:0--
				カウンタB++
			REND
		CASEELSE
			選択INDEX = RAND:(候補ユニット数:0)
			選択ユニット:カウンタB = 候補ユニット:選択INDEX
			ARRAYREMOVE 候補ユニット,選択INDEX,1
			候補ユニット数:0--
			選択行為:カウンタB = %候補行為:(RAND:候補行為数)%
			カウンタB++
	ENDSELECT
LOOP 候補ユニット数:0 > 0

PRINTW テスト2

VARSET 자위描写済INDEX,-1
VARSET 촉수描写済INDEX,-1
VARSET 애무描写済INDEX,-1
PRINTFORMW 함락의 힘에 사로잡힌 희생자들의 교성이 메아리치는 감옥, 그 안에서 Ɽꓤ 유닛\@ 候補ユニット数:1 > 1 ? 들 # \@은 각자의 방법으로 주인을 위해 몸을 바치고 있다……
FOR カウンタ, 0, 候補ユニット数:1
	VARSET カウンタC
	IF スキップ変数 > 0
		スキップ変数--
		CONTINUE
	ENDIF
	SIF MATCH(자위描写済INDEX,カウンタ) > 0 || MATCH(촉수描写済INDEX,カウンタ) > 0 || MATCH(애무描写済INDEX,カウンタ) > 0
		CONTINUE
	SELECTCASE 選択行為:カウンタ
		CASE "자위"
			자위描写済INDEX:カウンタC = カウンタ
			カウンタC++
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%
			;자위をまとめて描写
			FOR カウンタB, 0, 候補ユニット数:1
				SIF カウンタB == カウンタ
					CONTINUE
				SIF 選択行為:カウンタB != "자위"
					CONTINUE
				CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタB)
				PRINTFORM 、%RESULTS%
				자위描写済INDEX:カウンタC = カウンタB
				カウンタC++
			NEXT
			PRINTFORM 은(는),
			IF 主存在 != 0
				PRINTFORM %CALLNAME:MASTER%의 명령에 따라
			ELSE
				PRINTFORM 부재중인 주인을 생각하며
			ENDIF
			PRINTFORM 스스로의 육체를 위로하고 있다……
		CASE "레즈"
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%、
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%은(는)
			IF 主存在 != 0
				PRINTFORM %CALLNAME:MASTER%의 명령에 따라
			ELSE
				PRINTFORM 부재중인 주인을 생각하며
			ENDIF
			PRINTFORM 서로의 몸을 위로하고 있다……
			スキップ変数 = 1
		CASE "촉수"
			촉수描写済INDEX:カウンタC = カウンタ
			カウンタC++
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%
			;촉수をまとめて描写
			FOR カウンタB, 0, 候補ユニット数:1
				SIF カウンタB == カウンタ
					CONTINUE
				SIF 選択行為:カウンタB != "촉수"
					CONTINUE
				CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタB)
				PRINTFORM 、%RESULTS%
				촉수描写済INDEX:カウンタC = カウンタB
				カウンタC++
			NEXT
			PRINTFORM 은(는), %CALLNAME:MASTER%에게서 뻗어 나오는 기계 팔에 희롱당하는 쾌락을 누리고 있다……
		CASE "키스"
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%은(는) %CALLNAME:MASTER%와 혀를 얽으며 입맞춤 봉사를 하고 있다……
		CASE "애무"
			애무描写済INDEX:カウンタC = カウンタ
			カウンタC++
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%
			;애무をまとめて描写
			FOR カウンタB, 0, 候補ユニット数:1
				SIF カウンタB == カウンタ
					CONTINUE
				SIF 選択行為:カウンタB != "애무"
					CONTINUE
				CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタB)
				PRINTFORM 、%RESULTS%
				애무描写済INDEX:カウンタC = カウンタB
				カウンタC++
			NEXT
			PRINTFORM 은(는), %CALLNAME:MASTER%의 \@ カウンタC == 2 ? 각각의 # \@손에 그 몸이 희롱당하며 달콤한 목소리를 내고 있다……
		CASE "펠라"
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%
			REPEAT 2
				カウンタC++
				SIF カウンタ + カウンタC >= 5 || 選択行為:(カウンタ + カウンタC) != "펠라"
					BREAK
				CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:(カウンタ + カウンタC))
				PRINTFORM 、%RESULTS%
				スキップ変数 = カウンタC
			REND
			PRINTFORM 은(는),
			IF HAS_PENIS(MASTER)
				PRINTFORM %CALLNAME:MASTER%の
				IF スキップ変数 > 0
					PRINTFORM 페니스를 둘러싸고, 남김없이 핥고 빨고 있다……
				ELSE
					PRINTFORM 의 사타구니에 얼굴을 묻고 그 페니스를 정성껏 핥고 빨고 있다……
				ENDIF
			ELSE
				PRINTFORM 의 사타구니에 얼굴을 묻고 그 비밀스러운 입술의 물방울을 정성껏 핥아내고 있다……
			ENDIF
		CASE "파이즈리"
			CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:カウンタ)
			PRINTFORM %RESULTS%
			REPEAT 1
				SIF カウンタ + 1 >= 5 || 選択行為:(カウンタ + 1) != "파이즈리"
					BREAK
				CALL KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,選択ユニット:(カウンタ + 1))
				PRINTFORM 、%RESULTS%
				スキップ変数 = 1
			REND
			PRINTFORM 은(는), %CALLNAME:MASTER%
			IF スキップ変数 > 0
				PRINTFORM 의 페니스를 양쪽에서 끼우고, 호흡이 맞는 동작으로 주인을 즐겁게 하고 있다……
			ELSE
				CALL CARD_EROTICS_FIELD(듀얼리스트,"필드",選択ユニット:カウンタ)
				IF RESULT != -1
					SELECTCASE TALENT:RESULT:가슴사이즈
						CASE IS >= 2 ;폭유 이상
							PRINTFORM 의 페니스를 자신의 유방으로 감싸고, 헌신적으로 봉사하고 있다……
						CASE IS >= 0 ;보통 가슴 이상
							PRINTFORM 의 페니스를 자신의 가슴에 끼우고, 헌신적으로 봉사하고 있다……
						CASEELSE ;빈유 이하
							PRINTFORM 의 페니스를 자신의 가슴에 비비며, 헌신적으로 봉사하고 있다……
					ENDSELECT
				ELSE
					PRINTFORM 의 페니스를 자신의 가슴에 끼우고, 헌신적으로 봉사하고 있다……
				ENDIF
			ENDIF
	ENDSELECT
	PRINTL
NEXT
PRINTFORMW Ɽꓤ 유닛들의 달콤한 \@ 候補ユニット数:1 > 1 ? 합창소리 # 목소리\@가, 그에 따른 육욕의 고조가, 감옥 안의 공기를 더욱 찬란하게 붉게 물들여간다……!
;조교 결과
FOR カウンタ, 0, 候補ユニット数:1
	CALL CARD_EROTICS_FIELD(듀얼리스트,"필드",選択ユニット:カウンタ)
	IF RESULT != -1
		캐릭터ID = RESULT
		SELECTCASE 選択行為:カウンタ
			CASE "자위"
				CALL EROTIC_MOVE("최면自発자위",캐릭터ID,,100)
			CASE "레즈","촉수" ;めんどくさいので레즈相方판정はなし
				CALL EROTIC_MOVE("全身애무",캐릭터ID,,100)
			CASE "키스"
				CALL EROTIC_MOVE("딥키스",캐릭터ID,MASTER,100)
			CASE "펠라"
				CALL EROTIC_MOVE("憑依펠라",캐릭터ID,MASTER,100)
			CASE "파이즈리"
				CALL EROTIC_MOVE("憑依파이즈리",캐릭터ID,MASTER,100)
		ENDSELECT
	ENDIF
	;攻撃力の1/20だけ체력・기력회복
	CALL RECOVER_PERMIL(MASTER,GETVAR(@"%듀얼리스트%_MZ_攻:{候補ユニット:カウンタ}") / 20,"체력",1)
	CALL RECOVER_PERMIL(MASTER,GETVAR(@"%듀얼리스트%_MZ_攻:{候補ユニット:カウンタ}") / 20,"기력",1)
NEXT

@KOJO_FARRGRENDIOS_GET_FIELD_CALLNAME(듀얼리스트,場所)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 場所

CALL CARD_EROTICS_FIELD(듀얼리스트,"필드",場所)
IF RESULT != -1
	RESULTS = %CALLNAME:RESULT%“Ɽꓤ”
ELSE
	TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_MZ_変化元ID:場所")}("略称")
	RESULTS = %RESULTS%“Ɽꓤ”
ENDIF

RETURN

@KOJO_FARRGRENDIOS_FARREDICT_MASTER(듀얼리스트,캐릭터ID,캐릭터名,場所 = -1)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 캐릭터ID
#DIMS DYNAMIC 캐릭터名
#DIM DYNAMIC 場所

#DIMS DYNAMIC 候補行為,10
#DIM DYNAMIC 候補行為数
#DIMS DYNAMIC 조교内容

캐릭터名 = %캐릭터名%“Ɽꓤ”

候補行為:候補行為数 = 搾乳
候補行為数++
候補行為:候補行為数 = 키스
候補行為数++
候補行為:候補行為数 = 펠라
候補行為数++
IF HAS_PENIS(MASTER)
	候補行為:候補行為数 = 파이즈리
	候補行為数++
ENDIF
조교内容 = %候補行為:(RAND:候補行為数)%

PRINTFORML %CALLNAME:MASTER%가 부르자, 냉담무쌍한 얼굴로 적을 향하던 %캐릭터名%가 환하게 웃으며 가까이 다가온다.
SELECTCASE 조교内容
	CASE "搾乳"
		PRINTFORML 그 몸을 수많은 기계 팔로 얽어매자, %캐릭터名%는 몸을 맡기듯 가만히 있다……
		PRINTFORMW 이윽고 컵 형태의 기구가 가슴과 비밀스러운 곳에 부착되자, 강렬한 진동과 함께 %캐릭터名%의 에너지를 흡수하기 위해 가동하기 시작한다……!
	    IF 캐릭터ID != -1
        	CALL EROTIC_MOVE("バスト凌辱",캐릭터ID,MASTER,200)
        	CALL EROTIC_MOVE("Ｃ애무",캐릭터ID,MASTER,200)
    	ENDIF
		PRINTFORML 그렇게 에너지를 흡수당하고 땅에 내려진 %캐릭터名%는,
		PRINTFORMW 자신의 헌신으로 그 오라를 짙게 만드는 %CALLNAME:MASTER%를 황홀한 표정으로 올려다보고 있었다……
	CASE "키스"
		PRINTFORML 강제로 몸을 끌어당겨 입술을 포개자, %캐릭터名%도 공손히 눈을 감고 혀를 내밀어 온다……
		PRINTFORMW 이윽고 소리를 내며 서로를 탐하는 듯한 구욕 교미에 한동안 힘썼다……
