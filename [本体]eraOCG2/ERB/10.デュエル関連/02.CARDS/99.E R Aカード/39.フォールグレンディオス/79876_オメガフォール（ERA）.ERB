@CARDNAME_79876,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = “OMEGA FaⱤꓤ”
	CASE "略称"
		RESULTS = OMEGA FaⱤꓤ
	CASE "カテゴリ"
		RESULTS:0 = Ɽꓤ
		RESULTS:1 = E.R.A
ENDSELECT

@CARD_79876(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 速攻마법
ENDSELECT
RETURN 0

