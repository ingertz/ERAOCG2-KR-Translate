@CARDNAME_39896,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 폴스타베이더 “Ɽꓤubidium”
	CASE "略称"
		RESULTS = Ɽꓤubidium
	CASE "カテゴリ"
		RESULTS:0 = Ɽꓤ
		RESULTS:1 = E.R.A
ENDSELECT

@CARD_39896(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 無性
ENDSELECT
RETURN 0

@CARD_EXPLANATION_39896(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 효과는 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,발동誘発)
PRINTL ①：상대가 마법 / 함정 카드의 효과를 발동한 경우에 발동할 수 있다。
PRINTL 패의 이 카드를 묘지로 보내고、자신의 마법＆함정 존의 "함락주박" 카드 １장을 주박하고、
PRINTL 그 발동을 무효로 한다。

@CARDCAN_39896(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,39896)
SIF RESULT == 1
	RETURN 0
IF 종류 == 발동誘発
	SIF 발동済_2(듀얼리스트,39896)
		RETURN 0
	SIF ゾーン != "손패"
		RETURN 0
	CALL FULLRESET
	효과条件종류 = 마함全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件カテゴリ = 함락주박
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_39896(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

#DIM DYNAMIC 選択カードID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39896,2)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件カテゴリ = 함락주박
			효과範囲마함 = 1
			효과条件표시 = 表側표시
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"마함",ゾーン,場所)
			IF RESULT != 9999
				選択カードID = RESULT:99
				CALL SET_FIELD_INFO(듀얼리스트,"마함",RESULT,"表",3,上書きモード)
				CALL KOJO_FARRGRENDIOS_BASE("함락주박",듀얼리스트,選択カードID)
				CALL FULLRESET
				CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")
				RETURN 1
			ENDIF
		ENDIF
	ENDIF
ENDIF