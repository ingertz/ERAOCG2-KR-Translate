@CARDNAME_59813,参照先
;ココで지정 카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 오나 홀－시트리스
	CASE "略称"
		RESULTS = 예문의 시트리스
	CASE "カテゴリ"
		RESULTS:0 = 함정 속으로
		RESULTS:1 = 충혹마
		RESULTS:2 = E.R.A
ENDSELECT


@CARD_59813(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RETURN 식물족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 300
	CASE "連動ID"
		RETURN 1385
ENDSELECT

RETURN 0

@CARD_EXPLANATION_59813(종류)
#DIM DYNAMIC 종류
#DIMS DYNAMIC ゾーン

CALL TEXT_DECORATION("ROGUE")
PRINTL "충혹마" 몬스터 4장
PRINTL 이 카드의 ①의 효과는 1턴에 1번밖에 사용할 수 없다.
CALLFORM CARD_ABLE(1,戦破壊→묘지)
PRINTL ①：이 카드가 필드에서 묘지로 보내졌을 경우에 발동할 수 있다.
PRINTL 상대의 마법 & 함정 존의 카드를 전부 파괴한다.
;PRINTL 상대フィールドの특수소환されたモンスター１体を選んで묘지へ送る。
SIF ゾーン == "묘지"
	CALLFORM CARD_ABLE(2,지속효과);이 카드自体に효과는 無く、다른 カード側で묘지에 シトリスがあったら～をしている。
PRINTL ②：이 카드가 묘지에 존재하는 동안, 마법 & 함정 존의 앞면 표시의 "함정 속으로" 몬스터는,
PRINTL "상대 몬스터가 전투를 실행하는 공격 선언시에 발동할 수 있다.
PRINTL 그 상대 몬스터는 공격력이 0이 되고, 표시 형식을 변경할 수 없으며, 효과는 무효화된다.” 효과를 가진다.
SIF ゾーン == "필드"
	CALLFORM CARD_ABLE(3,지속효과)
PRINTL ③：이 카드는 함정 내성을 갖는다.
CALL TEXT_DECORATION("ROGUE")



@CARDSUMMON_59813(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC ゾーン

CALL RESETCONDITION_MAT
必要素材数 = 4
素材条件カテゴリ = 충혹마

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,59813) 
	RETURN RESULT
ENDIF



@CARDCAN_59813(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 戦闘カード
#DIM DYNAMIC 효과先

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,59813)
SIF RESULT == 1
	RETURN 0


IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時誘発
;シトリス묘지효과
	SIF ゾーン != "마함"
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件名前 = 오나 홀－시트리스
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0	
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") == 3
		RETURN 0
	SIF バトルフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	SIF 戦闘場所(듀얼리스트,1) == 5
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後誘発
;フレシア묘지효과
	SIF ゾーン != "마함"
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件名前 = 글로리 홀－플레시아
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0	
	SIF FINAL_SUMMON_TARGET(듀얼리스트,1) == 5 
		RETURN 0
	RETURN 1
ELSEIF 종류 == 戦破壊→묘지
	SIF !GROUPMATCH(묘지送り종류,"リリース","破壊","戦闘破壊")
		RETURN 0
	SIF 발동済_1(듀얼리스트,59813)
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件召種 = 召種全특수
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == リアクション효과
	SIF ゾーン != "마함"
		RETURN 0
	RETURN 1	
ENDIF




@CARDEFFECT_59813(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC ダメージ
#DIM DYNAMIC 戦闘カード
#DIM DYNAMIC 효과先
#DIM DYNAMIC 조교대상

#DIM DYNAMIC 조교대상캐릭터ID



CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"함정耐")
ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59813,1)
	IF RESULT == 0
		PRINTFORML 시트리스는 필드를 떠날 때 상대 마법 & 함정 존의 카드를 삼켜버렸다！
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"마함全体",場所,"묘지")
	ENDIF
	; IF RESULT == 0
	; 	CALL FULLRESET
	; 	효과条件召種 = 召種全특수
	; 	효과条件除去種 = 묘지
	; 	CALL CARD_ADD_GY_BASIC(듀얼리스트,"상대필드",ゾーン,場所)
	; 	PRINTFORML シトリスはフィールドを離れる際、%NAME:조교대상%をも묘지へと引きずり込んだ！
	; ENDIF
ELSEIF 종류 == 攻撃時誘発
	;シトリス묘지효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59813)
	IF RESULT == 0
		;通常마법汎用処理
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		戦闘カード = 戦闘場所(듀얼리스트,1)
		CALL FULLRESET
		효과추가종류 = 6
		조교대상캐릭터ID = GETVAR(@"%対面者%_필드:효과先")
		CALL CARD_EROTICS(조교대상캐릭터ID)
		조교대상 = RESULT
		IF 조교대상 != -1
		;ムシトリスミレは粘液での捕虫なので粘液ﾊﾞｼｬｰ
			PRINTFORML 攻撃の瞬間、シトリスは%NAME:조교대상%に濃厚な媚毒を浴びせかけた！
			PRINTFORMW %TEXTR("躱そうとして体勢を崩した/回避に気を取られた/突然のことに怯んだ")%%NAME:조교대상%はシトリス自身が仕掛けた落とし穴を踏み抜き、動きを封じられてしまった！
		ELSE
		PRINTFORMW 시트리스는 시트리스의 큰 구멍으로…
		PRINTFORMW ！？
		ENDIF
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"自動処理",戦闘カード,"永攻DOWN")
	ENDIF

ELSEIF 종류 == 효과後誘発
	;フレシア묘지효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59813)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		戦闘カード = 戦闘場所(듀얼리스트,1)
		조교대상캐릭터ID = GETVAR(@"%対面者%_필드:戦闘カード")
		CALL FULLRESET
		CALL CARD_EROTICS(조교대상캐릭터ID)
		조교대상 = RESULT
		IF 조교대상 != -1
			PRINTFORML 立ちこめる甘く濃厚な媚香に%CALLNAME:조교대상%が気を取られた隙をついて、
			PRINTFORMW シトリスは%CALLNAME:조교대상%をフレシアの大穴に引きずり込んだ！
			PRINTL
			PRINTFORMW 悲鳴をあげながら逃れようともがく상대モンスターを眺めながら、シトリスは嗜虐的な笑みをうかべて舌なめずりをした……
			CALL PREDATION_RAFFLESIA(듀얼리스트,종류,ゾーン,場所,조교대상)
		ELSE
			PRINTFORMW 시트리스는 플레시아의 큰 구멍으로 유도했다…
		ENDIF
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"自動処理",효과先,"묘지")
	ENDIF
ELSEIF 종류 == リアクション효과
	SETCOLOR C_PINK
	PRINTFORML 
	PRINTFORMW ”穴”として설치されたシトリスは%CALLNAME:MASTER%に%TEXTR("蜜濡れの/ドロドロの")%穴を向けて誘惑している…
	PRINTFORMW 誘惑に堪えきれず、%CALLNAME:MASTER%はシトリスの穴に욕망のまま情欲をぶつけた…
	RESETCOLOR
	CALL EROTIC_MOVE("충혹마의 착정",NO_TO_CHARANUM(1385),MASTER,100)
	IF RESULT:2 >= 1
		SETCOLOR C_PINK
		PRINTFORML 
		PRINTFORMW シトリスは%CALLNAME:MASTER%から搾り取った精気を巣穴に溜め込んだ…
		RESETCOLOR
		CALL CARD_GENERATE_GY(듀얼리스트,99823)
	ENDIF
ENDIF
