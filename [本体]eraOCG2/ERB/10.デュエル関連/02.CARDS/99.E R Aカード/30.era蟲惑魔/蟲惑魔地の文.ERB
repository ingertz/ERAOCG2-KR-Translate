@KOWAKUMA_RAPE(조교대상,조교者)
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 조교者

IF TALENT:조교대상:성별 == 1
	SELECTCASE RAND:5
	CASE 0
		PRINTFORML %CALLNAME:조교대상%の胸を乱暴に%TEXTR("揉ん/噛ん")%だり吸ったりして遊びながら精気を吸っている……。
		;분유경험入るからこっちで
		CALL EROTIC_MOVE("バスト凌辱",조교대상,조교者,100)
	CASE 1
		PRINTFORML %CALLNAME:조교대상%にむりやり키스をして、舌を絡めとって唾液と精気を貪っている……。
		CALL EROTIC_MOVE("딥키스",조교대상,조교者,100)
	CASE 2
		PRINTFORML %CALLNAME:조교대상%の陰唇に口をつけ、溢れ出る愛液と精気を啜っている……。
		CALL EROTIC_MOVE("Ｃ単発",조교대상,조교者,100)
	CASE 3
		PRINTFORML %CALLNAME:조교대상%の膣口を指でぐちゃぐちゃとかき回し、溢れ出る愛液と精気を啜っている……。
		CALL EROTIC_MOVE("指入れ",조교대상,조교者,100)
	CASE 4
		PRINTFORML 嗤いながら%CALLNAME:조교대상%のクリトリスを媚毒粘液にまみれた指でぐちゃぐちゃに揉み潰し、吹き出す潮と精気を浴びている……。
		CALL EROTIC_MOVE("クリトリス凌辱",조교대상,조교者,100)
	ENDSELECT
ELSEIF TALENT:조교대상:성별 == 2
	SELECTCASE RAND:5
	CASE 0
		PRINTFORML %CALLNAME:조교대상%にむりやり키스をして、舌を絡めて唾液と精気を貪っている……。
		CALL EROTIC_MOVE("딥키스",조교대상,조교者,100)
	CASE 1
		PRINTFORML %CALLNAME:조교대상%のペニスをしゃぶり、精気と정액を搾り取っている……。
		CALL EROTIC_MOVE("受펠라",조교대상,조교者,100)
	CASE 2
		;受기승위は新設した
		PRINTFORML %CALLNAME:조교대상%にまたがって기승위で腰を振り、精気と정액を搾り取っている……。
		;CALL EROTIC_MOVE("受기승위",조교대상,-1,300)
		CALL EROTIC_MOVE("기승위",조교者,조교대상,100)
	CASE 3
		PRINTFORML 嗤いながら%CALLNAME:조교대상%の亀頭を媚毒粘液にまみれた指でぐちゃぐちゃに揉み潰し、吹き出す潮と精気を浴びている……。
		CALL EROTIC_MOVE("Ｃ単発",조교대상,조교者,100)
	CASE 4
		PRINTFORML 媚毒でおかしくなった%CALLNAME:조교대상%のペニス%TEXTR("にがぶりと噛みついて/を踏みつけて")%、痛みで사정する様を嘲笑いながら精気を奪っている……。
		CALL EROTIC_MOVE("Ｃ単発",조교대상,조교者,100)
	ENDSELECT
ENDIF