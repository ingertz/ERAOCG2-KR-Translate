@CARDNAME_59530, 参照先
;ココで지정 카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = E.R.A.ShadDOLL.Midrash
	CASE "略称"
		RESULTS = ERA 미도라시
	CASE "カテゴリ"
		RESULTS:0 = 섀도르
		RESULTS:1 = ShadDOLL
		;RESULTS:2 = 윈다
		RESULTS:3 = E.R.A
ENDSELECT


@CARD_59530(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 1850
	CASE "守備力"
		RETURN 1500
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		;カード所持してないと連動しない설정に（入手前はALT화상に설정できない処置）
		IF ITEM:59530 >= 1
			RETURN 1830
		ENDIF
ENDSELECT

RETURN 0

@CARD_EXPLANATION_59530(종류)
#DIM DYNAMIC 종류
#DIMS DYNAMIC HTML_STR0
#DIMS DYNAMIC HTML_STR1
#DIMS DYNAMIC HTML_COLOR

TRYCALL ERASHADDOLLTEXT_PRINT(79531)
HTML_STR0 = %RESULTS%
TRYCALL ERASHADDOLLTEXT_PRINT(59530)
HTML_STR1 = %RESULTS%
TRYCALL ERASHADDOLLTEXT_PRINT(1)
HTML_COLOR = %RESULTS%

CALL TEXT_DECORATION("ROGUE")
PRINTL "섀도르" 몬스터 ＋"영뢰주박의 암컷노예" 또는 "ShadDOLL" 몬스터
PRINTL 이 카드명의 ③의 효과는 １턴에 １번밖에 사용할 수 없다。
;PRINTL 이 카드는 융합소환으로만 엑스트라 덱에서 특수 소환할 수 있다。
CALLFORM CARD_ABLE(0, 지속효과)
PRINTL ①：필드의 이 카드는 효과로는 파괴되지 않는다。
PRINT 또한、상대 플레이어가 
HTML_PRINT @"<nonbutton title='%HTML_ESCAPE(HTML_STR0)%'><font color='#%HTML_COLOR%'><nobr>■■■■■■■■■■■■■</nobr></font></nonbutton>",1
PRINTL 인 경우、이하의 효과도 적용된다。
CALLFORM CARD_ABLE(0, 攻守変動)
PRINTL ●이 몬스터가 필드에 존재하는 한、그 동안 상대 플레이어는 "특수소환권"을 빼앗겨、１턴에 １번밖에 몬스터를 특수 소환할 수 없다。
CALLFORM CARD_ABLE(0, 攻撃時誘発)
PRINTL ②：이 카드가 전투를 행하는 공격선언시、상대 필드의 카드 １장을 대상으로 하고 발동할 수 있다。그 카드를 패로 되돌린다。
PRINT 또한、상대 플레이어가
HTML_PRINT @"<nonbutton title='%HTML_ESCAPE(HTML_STR0)%'><font color='#%HTML_COLOR%'><nobr>■■■■■■■■■■■■■</nobr></font></nonbutton>",1
PRINT 인 한、이 카드가 상대에게 전투 데미지를 줄 때、상대 플레이어에게
SETCOLOR C_WIND_T
PRINT 열풍 데미지
RESETCOLOR
PRINTL 를 준다。
CALLFORM CARD_ABLE(3, 필드起動, 묘지起動)
PRINTL ②：자신 메인 페이즈 및 배틀 페이즈에 필드 / 묘지의 이 카드를 제외하고 발동할 수 있다.。
PRINT 상대 플레이어는
HTML_PRINT @"<nonbutton title='%HTML_ESCAPE(HTML_STR1)%'><font color='#%HTML_COLOR%'><nobr>■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■</nobr></font></nonbutton>",1
PRINTL 가 된다。
CALL TEXT_DECORATION("ROGUE")

;CALL XON_FONT_DEMO()

;상대 플레이어가 조교 가능하고 MASTER가 아닌 경우, 특수 소환 봉인+파괴 내성 떡
;기동 효과로 상대 플레이어의 반발계의 ERA 파라미터를 모두 리셋 한다

;2025/8/23 能力修正
;名称をWindaからMidrashにし、完全に윈다とは別の存在として扱うようにする。レベルを５→６に。융합素材条件も手直しして出しにくくする。
;③は起動효과가 使えるタイミングでいつでも撃てるようになっていたのを条件修正。OCG本家にはない挙動だが、자신バトルフェイズ中も起動효과で撃てる。
;상대だけSS封じは元のミドラと同じく１回許容というほんのり이성的に（欺瞞でしかない）。戦闘耐性もなくして、효과破壊耐性のみに변경。
;１턴에 １번という本来のミドラの挙動に近づける（やりたくてやってるだけ）ために、T1汎数を入れている。자신への適用もいつでも可能にしておく。
;「CARD_ABLE(0, 攻守変動)」の記載は、カード閲覧時にミドラのＳＳ封じが適用されているか視認しやすくするために추가している。
;→SS封じの条件を満たしてると、이 카드의 攻守変動が適用中になる条件を入れる仕組みが入っている。攻守変動の処理は空白で何も適用されない。
;②의 효과로 바람속성の面影を宿した攻撃宣言時のバウンス효과를 추가。戦闘に関連した효과를 付与하는 것으로、이 카드에 戦闘させる意味合いを多少補強する。
;素の공격력은 低めなのがネックだが、バウンスのために攻撃する機会が出れば多少このカードで데미지를 준다機会も増えるだろう。
;また、女性캐릭터に戦闘데미지를 준다と상대プレイヤーに바람속성に関連した責め苦を行うようにしてテーマに一貫性を持たせる方針に。（これが重要）
;男캐릭터を대상から外しちゃったのは、文章텍스트を記述するうえで改めて自己を見つめ直した結果、男への조교がそもそも趣味じゃないなと悟ったため。
;성별で限定しないほうがいいのだが、男상대でも流れる事を意識した文章にするのが難しいため발동条件で足切りした。ShadDOLLはそういうもんだと思ってください。


;以下、まったく読む必要のない、ふわふわShadDOLL설정（結局のところ、このERAバージョンのミドラはなんなんだ編）
;
;ミドラはターミナルワールドの時間軸では基本的に存在が소멸しており、正しい歴史では精霊獣使い윈다が普通に生きている。
;ただ섀도르のデータの残骸はどこか（撤去されて打ち棄てられたDuelTerminalのアーケード筐体の片隅とか）に残っており、それがeraOCG2の世界に流れ着いた。
;再生されたミドラは作戦目的も未설정（元々は神星樹の探索が目的）の状態であり、何らかの使命を帯びて産み出された存在であると自己を認識しているものの、
;行動原理となる命令が無いため何をすればいいか分からず、とりあえずカードの精霊の本能としてカードの持ち主である「あなた」に仕える状態になっている。
;普通のエル섀도르・ミドラーシュは一般的な유희왕プレイヤーの考えるミドラ像を反映しており、とりあえず상대プレイヤーのＳＳ封じをしてくれる。
;それだけだったらそんなに害はない（対戦상대는 ムカつくでしょうけど）存在なのだが、「あなた」がE.R.Aカードによる조교に興味が있었을 경우、
;ミドラは作戦目的を「女性の상대プレイヤーを牝奴隷に조교してMASTERに献上すること」と설정し、それに相応しい能力と姿を持った存在として自己を定義し直す。
;それがE.R.A.ShadDOLL体の存在。人の形をした牝奴隷조교用の조교道具。人形なので加減も知らず、生きものは死ぬまで痛めつければ굴복するという情報で動いている。
;牝奴隷の候補となる対戦상대プレイヤーへの風を操る타입の責め苦を担当している。風鞭プレイ・窒息プレイ・鳥葬プレイ・等活地獄プレイの担当。


@CARDSUMMON_59530(듀얼리스트, 소환カード, EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要素材数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = 섀도르
ELSEIF EX参照 >= 10
	素材条件カテゴリ = ShadDOLL
	素材条件スーパー名前 = 영뢰주박의 암컷노예
ENDIF

IF EX参照 == 1
	;PRINTL サモンまでは言ってるよ
	CALL FUSCAN(듀얼리스트, 소환カード, 59530) 
	RETURN RESULT
ENDIF


@CARDCAN_59530(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 효과制限달성
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 조교대상 = -1

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트, 종류, ゾーン, 場所, 59530)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動 || 종류 == 묘지起動
	SIF 발동済_3(듀얼리스트, 59530)
		RETURN 0
	SIF !GROUPMATCH(ゾーン, "필드", "묘지")
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF メインフェイズ != 1 && バトルフェイズ != 1
		RETURN 0
	
	CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
	IF RESULT != -1
		조교대상 = RESULT
		;상대가 あなた（＝MASTER）の場合は발동불가。
		SIF 조교대상 == MASTER
			RETURN 0
	ELSE
		;상대プレイヤーが조교대상でない場合は발동불가
		RETURN 0
	ENDIF
	RETURN 1
ELSEIF 종류 == 攻撃時誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 손패
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == ライフ変強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF ダメージ受者 == 듀얼리스트
		RETURN 0
	SIF !GROUPMATCH(ダメージ종류, "戦闘", "直接戦闘")
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	
	CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
	IF RESULT != -1
		조교대상 = RESULT
		;상대가 あなた（＝MASTER）の場合は발동불가、男性の場合も발동불가。
		SIF 조교대상 == MASTER
			RETURN 0
		SIF TALENT:조교대상:성별 == 2
			RETURN 0
	ELSE
		;상대プレイヤーが조교대상でない場合は발동불가
		RETURN 0
	ENDIF
	RETURN 1
ELSEIF 종류 == 효과後強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	;SIF GETVAR(@"%듀얼리스트%_最召場所") == 場所
	;	RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_T1汎数:場所") == 3
		RETURN 0
	;ミドラちゃんスペシャル　（효과後強制誘発のチェックが走るタイミングでSSチェックして、そのままMZのミドラの場所のT1汎数に数字を代入しちゃう）
	;こういう想定しない箇所での想定外の処理は、簡単な動作でも入念にデバッグ確認出来ない場合やるべきではない
	CALL FULLRESET
	CALL CARD_CHECK_FIN_DATA(듀얼리스트, "특수소환",1)
	IF RESULT == 1
		IF GETVAR(@"%듀얼리스트%_MZ_T1汎数:場所") & 2
			SETVAR @"%듀얼리스트%_MZ_T1汎数:場所", 3
		ELSE
			SETVAR @"%듀얼리스트%_MZ_T1汎数:場所", 1
		ENDIF
	ENDIF
	CALL FULLRESET
	효과条件固名前 = E.R.A.ShadDOLL.Midrash
	CALL CARD_CHECK_FIN_DATA(듀얼리스트, "특수소환")
	IF RESULT == 1
		IF GETVAR(@"%듀얼리스트%_MZ_T1汎数:場所") & 1
			SETVAR @"%듀얼리스트%_MZ_T1汎数:場所", 3
		ELSE
			SETVAR @"%듀얼리스트%_MZ_T1汎数:場所", 2
		ENDIF
	ENDIF
	RETURN 0
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
	IF RESULT != -1
		조교대상 = RESULT
		;상대가 あなた（＝MASTER）の場合は지속無効
		SIF 조교대상 == MASTER
			RETURN 0
	ELSE
		;상대プレイヤーが조교대상でない場合は발동불가
		RETURN 0
	ENDIF
	RETURN 1
ENDIF

@CARDEFFECT_59530(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 与ダメージ量
#DIM DYNAMIC 조교대상 = -1

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動 || 종류 == 묘지起動
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 59530, 3)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트, ゾーン, 場所, 제외行き)
		CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
		IF RESULT != -1
			조교대상 = RESULT
			;MASTER상대だと何も起きない
			SIF 조교대상 == MASTER
				RETURN 0
			;상대プレイヤーの반발각인が消え去る
			MARK:조교대상:반발각인 = 0
			TCVAR:조교대상:반발각인취득 = 0
			;분노状態も解除
			CFLAG:조교대상:극대노 = 0
			CFLAG:조교대상:기분나쁨 = 0
			TCVAR:조교대상:기분나쁨 = 0
			BASE:조교대상:분노 = 0
			;부정系のPALAMも全て0にリセットされる
			PALAM:조교대상:반감 = 0
			PALAM:조교대상:불쾌 = 0
			PALAM:조교대상:억울 = 0
			PALAM:조교대상:부정 = 0

			;憑依状態も考えたけど、다른 エロ行為と変に競合する可能性あるのでコメントアウト
			;命令に従うようになるor최면暗示にかかりやすい状態になるとかあったら状態変化としてつけたい
			;CFLAG:조교대상:빙의중 = 1

			;フレ-バ-텍스트
			PRINTFORML 미도라시의 모습이 그림자 실로 변해, %CALLNAME:조교대상%의 몸과 마음을 붙잡아 버렸다！
			PRINTFORML 그림자 실에 구속되어 불쾌감에 고뇌의 표정을 짓고 있던 %CALLNAME:조교대상%였지만,
			PRINTFORMW 질척질척 %CALLNAME:조교대상%의 피부에 그림자 실이 스며듦에 따라, 고뇌하던 얼굴에서도 서서히 감정이 사라져가고, 인형처럼 움직임을 멈췄다……
			PRINTFORML 
			PRINTFORML ・
			PRINTFORML ・・
			PRINTFORMW ・・・
			PRINTFORML 잠시동안 초점이 맞지 않는 공허한 눈동자로 이쪽을 향하던 %CALLNAME:조교대상%가, 움찔거리며 크게 어깨를 떨었다.
			PRINTFORMW 갑자기 표정이 돌아온 %CALLNAME:조교대상%는 방금까지의 사건이 기억에서 빠진 것처럼 듀얼을 재개했다……

		ENDIF
	ENDIF
ELSEIF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 59530)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트, "単体除去", 場所, "손패")
	ENDIF
	ELSEIF 종류 == ライフ変強制誘発
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 59530)
	IF RESULT == 0
		CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
		IF RESULT != -1
			조교대상 = RESULT
			;MASTER상대だと何も起きない
			SIF 조교대상 == MASTER
				RETURN 0
			;상대プレイヤーに戦闘ダメージに応じた강도の「拷問処理」を実施
			;	DOWNBASE:조교대상:체력 += (80 * 実보정) / 100
			;	DOWNBASE:조교대상:기력 += (50 * 実보정) / 100
