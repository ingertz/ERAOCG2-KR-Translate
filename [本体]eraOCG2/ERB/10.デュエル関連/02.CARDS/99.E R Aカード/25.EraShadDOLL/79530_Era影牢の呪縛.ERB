@CARDCAN_179530(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성 = 0
#DIM DYNAMIC 조교대상 = -1

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트, 종류, ゾーン, 場所, 179530)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動
	SIF 발동済_2(듀얼리스트, 179530)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件名前 = ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	IF RESULT != 1
		;상대プレイヤーが조교대상か確認。조교대상でない場合は발동できない。
		CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
		IF RESULT != -1
			조교대상 = RESULT
			;상대가 あなた（＝MASTER）の場合は추가条件を満たさない。
			SIF 조교대상 == MASTER
				RETURN 0
		ELSE
			RETURN 0
		ENDIF
		;代わりに섀도르마법が덱 / 묘지に存在するか確認
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 섀도르
		효과条件종류 = 마법全般
		CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
		SIF RESULT != 1
			RETURN 0
	ENDIF
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "마함"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_179530(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성 = 0
#DIM DYNAMIC 조교대상 = -1

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 179530)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트, ゾーン, 場所, 마함行き)
	ENDIF
ELSEIF 종류 == 마함起動
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 179530, 2)
	IF RESULT == 0
		;条件달성を確認
		CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
		IF RESULT != -1
			조교대상 = RESULT
			;상대가 あなた（＝MASTER）ではない場合は条件달성
			SIF 조교대상 != MASTER
				条件달성 = 1
		ENDIF
		
		CALL CARD_DISPOSE(듀얼리스트, ゾーン, 場所, 破壊行き)
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件名前 = ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
		IF 条件달성 == 1
			효과条件スーパーカテゴリ = 섀도르
			효과条件スーパー종류 = 마법全般
		ENDIF
		CALL CARD_ADD_ADV(듀얼리스트, ゾーン, 場所)
	ENDIF
ELSEIF 종류 == 지속효과
	CALL SET_TMP_EX_RST_CAT(듀얼리스트, "섀도르")
ENDIF


