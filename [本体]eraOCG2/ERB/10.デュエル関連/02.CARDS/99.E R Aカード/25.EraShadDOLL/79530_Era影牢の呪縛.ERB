@CARDNAME_179530, 参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		;影牢呪縛のライフ変強制誘発（자신은 마함から～～）に続けた表記で参照する用途で使うため、それに合わせた表記になっている。
		RESULTS = 늘어난 그림자 실에 지배되고있는、「영뢰에 주박당한 암컷 노예」
	CASE "略称"
		RESULTS = 영뢰주박의 암컷노예
	CASE "カテゴリ"
		RESULTS:0 = ShadDOLL
		RESULTS:1 = 섀도르
		;RESULTS:2 = 『　　　　』
		RESULTS:3 = E.R.A
		;RESULTS:4 = ＊＊＊＊＊＊＊＊
ENDSELECT


@CARD_179530(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 의식
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 牝性
	CASE "分割"
		RETURN 펜듈럼
ENDSELECT


