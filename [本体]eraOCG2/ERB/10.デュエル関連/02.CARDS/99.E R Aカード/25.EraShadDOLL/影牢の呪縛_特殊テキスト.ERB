;-------------------------------------------------------------------------------------------------
;-------------------------------------------------------------------------------------------------
@PULSATE_TEXT_PRINT(カードID,TEXT番号)
#DIM DYNAMIC カードID
#DIM DYNAMIC TEXT番号

#DIM DYNAMIC 조교대상
#DIM DYNAMIC 복종レベル
#DIM DYNAMIC 조교강도レベル
VARSET RESULT
VARSET RESULTS

;-------------------------------------------------------------------------------------------------
;ERA影牢の呪縛で使用する특수판정用の텍스트
;대상の조교상황に応じて、デュエル조교の前後のメッセージを変化して出力させる。
;ここは一部の「シャドール」モンスターへのデュエル조교のための표시部分

;복종レベル：캐릭터の精神面のレベル（デュエル조교に対する캐릭터の受容度）、主に마조끼を参照する
;조교강도レベル：拘束조교の激しさのレベル、eraの조교が進んでABLがレベルアップしていくことで강도が上昇する
;조교後は복종と조교강도の２軸で拷問조교の事後の反応を설정。いわゆる「マトリクスシステム」形式

;ID:41830 エルシャドール・メシャフレール用の処理
;RESULT:1 조교강도　RESULT:2 魔石카운터の취득成功판정結果

;-------------------------------------------------------------------------------------------------

;조교대상のCSV番号の취득
CALL CARD_EROTICS(カードID, "자신")
IF RESULT != -1
	조교대상 = RESULT
ELSE
	RETURN 0
ENDIF

IF カードID == 41830
	;エルシャドール・メシャフレールの拘束조교
	
	;복종レベルの판정
	IF TALENT:조교대상:복종 >= 2
		복종レベル = 3
	ELSEIF ABL:조교대상:마조끼 >= 5
		복종レベル = 2
	ELSEIF ABL:조교대상:마조끼 >= 2
		복종レベル = 1
	ELSE
		복종レベル = 0
	ENDIF
	
	;조교강도レベルはCSVのいろいろなABLデータやTALENTを参照する
	;数値は1000まではそのままだが、1000以上は1/10に鈍化する。（MAXで1900）
	조교강도レベル = 50
	조교강도レベル += GETPALAMLV(CFLAG:조교대상:호감도,5) * 50
	조교강도レベル += LIMIT(ABL:조교대상:마조끼, 0, 10) * 50
	조교강도レベル += LIMIT(ABL:MASTER:기교, 0, 10) * 50
	SIF ABL:조교대상:순종 >= 5
		조교강도レベル *= LIMIT(ABL:조교대상:순종, 5, 20) / 5
	SIF TALENT:MASTER:새드
		조교강도レベル *= 2
	
	조교강도レベル = LIMIT(조교강도レベル, 0, 10000)
	SIF 조교강도レベル >= 1000
		조교강도レベル = 900 + (조교강도レベル / 10)
	
	SELECTCASE TEXT番号
		CASE 1
			;조교前の텍스트
			IF 복종レベル >= 3
				IF RAND:3 == 0
					PRINTFORML %CALLNAME:조교대상%は、己を淫らな拘束조교の題材に選んでいただいた『MASTER』に感謝するように微笑し、影糸の拘束を受け容れていく……
				ELSEIF RAND:2 == 0
					PRINTFORML %CALLNAME:조교대상%は影糸の群れが己をどのように飾り立てて『MASTER』に饗してくれるのか、試すような目つきで拘束を眺めている……
				ELSE
					PRINTFORML %CALLNAME:조교대상%はニヤリと邪悪な笑みを浮かべると、影糸が締め付けやすいように身じろぎし、慣れた動きで拘束を促していく……
				ENDIF
			ELSEIF 복종レベル == 2
				IF RAND:3 == 0
					PRINTFORML %CALLNAME:조교대상%は、ただ影糸の拘束が己を"この世界"に固定しているような錯覚が与える酩酊感で、呆けたような表情を浮かべている……
				ELSEIF RAND:2 == 0
					PRINTFORML %CALLNAME:조교대상%は、使役していた影糸の群れが己の肢体を求めて殺到してくる光景に、奇妙な만족感を覚えてしまっている……
				ELSE
					PRINTFORML %CALLNAME:조교대상%は、자신をモノ同然に扱ってくる影糸の群れの姿に、期待感を抱いていることに気がつき、頬を紅潮させている……
				ENDIF
			ELSEIF 복종レベル == 1
				IF RAND:3 == 0
					PRINTFORML %CALLNAME:조교대상%は、影糸の拘束がもたらす圧迫感とともに、奇妙な熱が自身から湧き上がる違和感に戸惑っている……
				ELSEIF RAND:2 == 0
					PRINTFORML %CALLNAME:조교대상%は、使役していたはずの影糸が己を苦しめている倒錯的な상황に、うめきともあえぎともつかない声を漏らす……
				ELSE
					PRINTFORML %CALLNAME:조교대상%は、影糸の群れが冷徹に突きつけてくる、"자신은 ただの道具に過ぎない"という現実に반발しようともがいている……
				ENDIF
			ELSE
				IF RAND:3 == 0
					PRINTFORML %CALLNAME:조교대상%は、四肢を拘束している影糸によって無理矢理に手足を動かされる不쾌감に顔を歪ませている……
				ELSEIF RAND:2 == 0
					PRINTFORML %CALLNAME:조교대상%は、己が使役していたはずの影糸の群れに呪縛され、思い通りにならない歯痒さに身をよじっている……
				ELSE
					PRINTFORML %CALLNAME:조교대상%は、彼女の意志を無視して只の道具としてぞんざいに扱ってくる影糸の動きに苦悶の表情を浮かべている……
				ENDIF
			ENDIF
			
			RESULT:1 = 조교강도レベル
		CASE 2
			;조교後の텍스트
			;RESULT:2の魔石카운터판정は、叫声を絞り出せたかどうかが판정基準なので、逆に복종レベルが高いほうが必要な조교강도の数値が高くなっていく仕様
			IF 복종レベル >= 3
				IF 조교강도レベル >= 1200
					PRINTFORML 球体関節がおぞましい方向にひしゃげられていき、人間ではあり得ない方向に曲げられた四肢がぎりぎりと影糸に締め付け絞られていく。
					PRINTFORML 壊れた人形のような無様な姿と고통に啼く声で『MASTER』を愉しませることが出来た%CALLNAME:조교대상%は、만족そうに影糸を愛撫した……
					RESULT:2 = 1
				ELSEIF 조교강도レベル >= 800
					PRINTFORML 四肢がバラバラに引き裂かれるような締め付けは、ようやく人形の眠っていた마조性をゆっくり目覚めさせる刺激となった。
					PRINTFORML %CALLNAME:조교대상%は、常人では到底耐えられない고통を浴びて、心地よさそうな喘ぎ声と少し紅潮した妖艶な表情を『MASTER』に捧げた……
					RESULT:2 = 1
				ELSEIF 조교강도レベル >= 400
					PRINTFORML 大した고통を与えられない影糸の拘束に拍子抜けした%CALLNAME:조교대상%は、不満げな表情で影糸の群れを見つめていた。
				ELSE
					PRINTFORML てんで物足りない拘束で『MASTER』に嬌声を捧げる機会を逸した%CALLNAME:조교대상%は、すごすごと引き下がる影糸の群れを悔しそうに睨んでいた。
				ENDIF
			ELSEIF 복종レベル == 2
				IF 조교강도レベル >= 1000
					PRINTFORML おびただしい量の影糸の群れは、彼女の全てを覆い付くさんばかりに殺到して、その四肢を完全に拘束していく。
					PRINTFORML 既に마조性を開花させている%CALLNAME:조교대상%であっても耐えきれぬ고통を受け、泣き叫ぶような悲鳴を影牢に捧げた……
					RESULT:2 = 1
				ELSEIF 조교강도レベル >= 500
					PRINTFORML ギリギリと締め上げる影糸の拘束は、まさに操り人形といった様相のオブジェへと彼女を飾り立てていく。
					PRINTFORML %CALLNAME:조교대상%は、身動きが取れないままに与えられる고통を甘美な表情で受け止め、奇妙な喘ぎ声を影牢に捧げた……
					RESULT:2 = 1
				ELSEIF 조교강도レベル >= 250
					PRINTFORML 影糸の고통が不思議な心地よさになる寸前に締め付けが終わり、解かれる影糸に伸ばされた%CALLNAME:조교대상%の手は影糸には届かなかった。
				ELSE
					PRINTFORML 影糸による고통は思ったよりも軽く、%CALLNAME:조교대상%は不思議そうな眼差しで帰っていく影糸を見つめていた。
				ENDIF
			ELSEIF 복종レベル == 1
				IF 조교강도レベル >= 600
					PRINTFORML 人形を支配して굴복させるために蠢く影糸の群れは、彼女の全身を逃げられぬよう拘束していった。
					PRINTFORML その拘束が与える絶え間ない고통に、%CALLNAME:조교대상%は為す術なく悲痛な叫び声を絞り出されてしまった……
					RESULT:2 = 1
				ELSEIF 조교강도レベル >= 300
					PRINTFORML 徹底的に彼女を『モノ扱い』するために暴れ回る影糸の暴威に、%CALLNAME:조교대상%は고통の声を漏らしていた……
					RESULT:2 = 1
				ELSEIF 조교강도レベル >= 150
					PRINTFORML 고통を与えられたが、%CALLNAME:조교대상%は言葉一つ発さずにその不当な仕打ちを耐え抜いた。
				ELSE
					PRINTFORML 影糸による고통な時間が終わって影糸の拘束も僅かに緩み、%CALLNAME:조교대상%は一息ついた。
				ENDIF
			ELSE
				PRINTFORML 彼女の意志を挫こうと締め付けてくる影糸が与える고통に、%CALLNAME:조교대상%は思わず呻き声をあげてしまった……
				RESULT:2 = 1
			ENDIF
			
			RESULT:1 = 조교강도レベル
		CASEELSE
			RESULT:1 = 조교강도レベル
	ENDSELECT
ENDIF

RETURN 1



