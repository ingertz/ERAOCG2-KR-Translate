@CARDNAME_59533, 参照先
;ココで지정 카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = E.R.A.ShadDOLL.Wendigo
	CASE "略称"
		RESULTS = ERA 웬디고
	CASE "カテゴリ"
		RESULTS:0 = 섀도르
		RESULTS:1 = ShadDOLL
		;RESULTS:2 = ウェン
		RESULTS:3 = E.R.A
ENDSELECT


@CARD_59533(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 사이킥족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 200
	CASE "守備力"
		RETURN 2800
	CASE "성별"
		RETURN 牝性
	CASE "특수制限"
		RETURN 1
	CASE "連動ID"
		;カード所持してないと連動しない설정に（入手前はALT화상に설정できない処置）
		IF ITEM:59533 >= 1
			RETURN 1833
		ENDIF
ENDSELECT

RETURN 0

@CARD_EXPLANATION_59533(종류)
#DIM DYNAMIC 종류
#DIM DYNAMIC 조교대상 = -1

CALL TEXT_DECORATION("ROGUE")
PRINTL "섀도르" 몬스터 ＋ 융합 몬스터
;PRINTL 이 카드는 융합 소환으로만 엑스트라 덱에서 특수 소환할 수 있다。
PRINTL 자신은 "E.R.A.ShadDOLL.Wendigo"를 １턴에 １번밖에 특수 소환할 수 없다。
PRINTL 이 카드명의 ①②의 효과는 각각 1턴에 1번밖에 사용할 수 없고,
PRINTL 상대 플레이어가■■■■■■■■■■■■■인 경우, 이 카드의 효과 발동에 대해 상대는 효과를 발동할 수 없다。
CALL CARD_ABLE(1, EX덱起動)
PRINTL ①：상대 플레이어가 ■■■■■■■■■■■■■인 경우,
PRINTL 자신 메인 페이즈에 이 카드를 엑스트라 덱에서 묘지에 보내 발동할 수 있다。
PRINTL 자신의 덱에서 "E.R.A"카드를
IF 듀얼モード == 0
	PRINT ■
ELSE
	;デュエル中に텍스트を確認すると、상대プレイヤーに応じたサーチ枚数の텍스트に変化します。
	CALL CARD_EROTICS(상대プレイヤー, "자신")
	조교대상 = RESULT
	IF 조교대상 <= -1 || 조교대상 == MASTER
		PRINT ０
	ELSE
		;상대プレイヤーの조교상황を確認
		IF MARK:조교대상:고통각인 >= 3
			SETCOLOR C_D_RED
			PRINT ３
			RESETCOLOR
		ELSEIF MARK:조교대상:고통각인 == 2
			SETCOLOR C_RED
			PRINT ２
			RESETCOLOR
		ELSEIF MARK:조교대상:고통각인 || MARK:조교대상:굴복각인
			SETCOLOR C_PINK
			PRINT １
			RESETCOLOR
		ELSE
			PRINT ０
		ENDIF
	ENDIF
ENDIF
PRINTL 장까지 골라 패에 넣는다（같은 이름의 카드는 １장까지）。
CALL CARD_ABLE(2, EX소환時 , 특수소환時)
PRINTL ②：이 카드가 특수 소환했을 경우에 1000LP를 지불하고, 상대 필드의 카드 1장을 대상으로 하고 발동할 수 있다.
PRINTL 그 카드를 제외한다。
CALL TEXT_DECORATION("ROGUE")

;EX덱起動효과は상대プレイヤーが조교可能でMASTERでない場合、かつ굴복각인Lv1以上を持っている경우에 발동可能
;상대プレイヤーの굴복각인Lvの数まで、덱에서 「E.R.A」カードをサーチできる（最大3枚）

;2025.8 효과텍스트を修正
;チェーン불가の条件に、상대プレイヤーが조교可能캐릭터クターで고통각인と굴복각인を획득しているかの판정を추가。
;①が単純なループ文になってた部分を修正し、デュエル中は枚数確認可能に修正。サーチ処理を任意で終えられるようにも변경している。
;カードサーチの条件を再検討し、１枚のみは굴복각인Lv1以上or고통각인Lv1以上でOK、２枚目以降は『고통각인』のLv2、Lv3を必要なようにする。
;굴복각인だけでも１枚はERAカードをサーチできるが、それ以上はハードな조교をして고통を稼がないと취득しにくい고통각인レベルを要求する設計に。
;ShadDOLLが非純愛路線の拷問処理を専門に扱うERAカテゴリであるため、そういう方針にしました。まあ쾌락조교でも突き抜ければ고통각인を取れそうだが。
;ちなみに現状(2025/10)の고통각인Lv3취득は、一回の조교行為で고통8000以上を稼ぐ必要がある様子なので、結構無茶しないと取れないバランス。その想定での설정。
;②を사이킥족っぽい雰囲気づくりのためにLPコストを支払う形に修正。PUNKあるから完全なデメリットではないけどほぼフレーバー。


;以下、まったく読む必要のない、ふわふわShadDOLL설정（こいつは拷問プレイしないんですね編）
;
;こいつ何なの？の回答は、元々のエル섀도르・ウェンディゴは효과が貧弱なためＥＸ덱に採用することがまずないカードで、
;ウェンディゴを活躍できるようにする事は難しいので、いっそE.R.Aカードとして入れやすい新規を作ればいいじゃんと。そういう身も蓋もない発想。
;ちなみにウェンディゴは링크体もしれっと存在しているので、섀도르덱のウェンとウェンディゴの比率はバカにできない程度に多い。
;風サイキックのままだし、拷問しないし、フィールドに出てくる事も殆ど無いしと「ShadDOLL」テーマで見ると余りにも奇妙な立ち位置の存在。
;화상では太い注射器を抱えているが、あれは「エネマシリンジ」というお尻向けの조교道具らしい。eraOCG2のガスタの里のデータが悪影響を与えている説がある。
;ERAカードによるデュエル조교の好みはプレイヤーによって多種多様である事を配慮し、自己主張しない慎ましい화상を설정。大抵のエロジャンルに程よく馴染むはず。
;
;無理矢理に産み出された理由をつけるなら、ERAミドラが섀도르のデータの残骸を漁った時に御主人様に仕えるに相応しい子として目に留まった、
;ウェンディゴちゃんを再生・お粧しして連れてきた感じかと思われる。ウェンちゃんとは別個体で、"本物"が存在していることには全然頓着してないと思う。
;（逆にミドラは자신がどこまでいっても윈다のコピー人形でしかないという事実に、物凄くコンプレックスを感じてると思う。感じてて澱んでて欲しい。）
;조교という名の拷問を상대プレイヤーに行う担当ではなく、シンプルに御主人様の小間使いであり、他のShadDOLLの『妹分』としての役割を与えられた人形。
;「ウェン」には興味は示さないけど、「ピリカ」って子を見てると不思議と心の中に黒々とした靄みたいなものが溜まり始めることに戸惑っているらしい。不穏不穏。
;※※あえて言語化するなら、「ウェン」に成り代わる欲求はないけど、「ピリカのともだち」に成り代わりたいという欲求は存在しているとかそういう感じ。
;　　突き詰めた時、자신が「精霊獣使いウェンディゴ」になりたいのか、それともピリカを「섀도르・ピリカ」に堕としたいのかは分からん。ガチで分からん。


@CARDSUMMON_59533(듀얼리스트, 소환カード, EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

;素材条件

CALL RESETCONDITION_MAT
必要素材数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = 섀도르
ELSEIF EX参照 >= 10
	素材条件종류 = 융합
ENDIF

IF EX参照 == 1
	;PRINTL 분명 소환되는 장면까지 보고 있었다
	CALL FUSCAN(듀얼리스트, 소환カード, 59533) 
	RETURN RESULT
ENDIF

@CARDCAN_59533(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 효과制限달성
#DIM DYNAMIC 조교대상 = -1
#DIM DYNAMIC 상대굴복각인レベル
#DIM DYNAMIC 상대고통각인レベル
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트, 종류, ゾーン, 場所, 59533)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF 발동済_1(듀얼리스트, 59533)
		RETURN 0
	SIF メインフェイズ != 1
			RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
			RETURN 0
	CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
	IF RESULT != -1
		조교대상 = RESULT
		;상대가 あなた（＝MASTER）の場合は발동불가（対NPC専用효과）
		SIF 조교대상 == MASTER
			RETURN 0
		상대굴복각인レベル = MARK:조교대상:굴복각인
		상대고통각인レベル = MARK:조교대상:고통각인
		;상대プレイヤーの굴복각인Lv1以上でないと발동불가
		SIF 상대굴복각인レベル < 1 && 상대고통각인レベル < 1
			RETURN 0
	ELSE
		;상대プレイヤーが조교대상でない場合は발동불가
		RETURN 0
	ENDIF
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = E.R.A
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == EX소환時 || 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트, 59533)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	SIF GETVAR(@"ライフ_%듀얼리스트%") <= 1000
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 제외
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == チェーン可否
	CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
	IF RESULT != -1
		조교대상 = RESULT
		;상대가 あなた（＝MASTER）または男性の조교대상ならチェーン可能
		SIF 조교대상 == MASTER
			RETURN 0
		SIF TALENT:조교대상:성별 == 2
			RETURN 0
		상대굴복각인レベル = MARK:조교대상:굴복각인
		상대고통각인レベル = MARK:조교대상:고통각인
		;상대プレイヤーの굴복각인と고통각인のどちらかがLv0の場合はチェーン可能
		SIF 상대굴복각인レベル < 1 || 상대고통각인レベル < 1
			RETURN 0
	ELSE
		;상대プレイヤーが조교대상でない場合はチェーン可能
		RETURN 0
	ENDIF
	RETURN 1
ENDIF

@CARDEFFECT_59533(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 묘지送カード,5
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 조교대상 = -1
#DIM DYNAMIC 상대굴복각인レベル
#DIM DYNAMIC 상대고통각인レベル

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX덱起動
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 59533, 1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트, ゾーン, 場所, 묘지行き)
		
		CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
		IF RESULT != -1
			조교대상 = RESULT
			;상대가 あなた（＝MASTER）の場合は발동불가（対NPC専用효과）
			SIF 조교대상 == MASTER
				RETURN 0
			상대굴복각인レベル = MARK:조교대상:굴복각인
			상대고통각인レベル = MARK:조교대상:고통각인
		ELSE
			;상대プレイヤーが조교대상でない場合は발동불가
			RETURN 0
		ENDIF
		
		IF 상대고통각인レベル >= 2
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = E.R.A
			효과条件複数 = 100 - 상대고통각인レベル
			효과条件固名前選択 = 1
			CALL CARD_ADD_ADV(듀얼리스트, ゾーン, 場所)
		ELSEIF 상대굴복각인レベル || 상대고통각인レベル
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = E.R.A
			CALL CARD_ADD_ADV(듀얼리스트, ゾーン, 場所)
		ENDIF
	ENDIF
ELSEIF 종류 == EX소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 59533, 2)
	IF RESULT == 0
		CALL LIFE_CHANGE(듀얼리스트, "減少", "コスト", 1000)
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트, "全場単体", 場所, "제외")
	ENDIF
ENDIF
