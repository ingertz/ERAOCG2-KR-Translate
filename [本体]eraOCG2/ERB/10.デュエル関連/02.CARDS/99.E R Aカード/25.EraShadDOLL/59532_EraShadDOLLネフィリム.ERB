		PRINT_PALAM 조교대상
		
		;사정ゲージの代わりに만족度[0-1000]なる謎の概念を표시（とくにいみはないし決してMAXにならない、チーム만족とも無関係）・・・とても長いバー표시
		;文字の色が変わっていくファンサービス(100-300:黄色　300-999:赤色　1000:黒赤色)
		IF 만족度 >= 1000
			SETCOLOR C_D_RED
		ELSEIF 만족度 >= 300
			SETCOLOR C_RED
		ELSEIF 만족度 >= 100
			SETCOLOR C_YELLOW
		ELSE
			;SETCOLOR C_RED
		ENDIF
			PRINTFORML 
		PRINT 만족도
		SIF 만족度 > 1000
			만족度 = 1000
		BAR 만족度, 1024, 64
		PRINTFORML ({만족度}/1024)
			PRINTFORML 
		RESETCOLOR
		
		;コマンド何個ごとに並べる？　誰もそんなレガシー설정は気にしてない？　それはそう
		PRINTCPERLINE
		표시列数 = RESULT
		
		FOR コマンド数カウンタ, 19, 24
			PRINT 　　　
			TRYCALL ERASHADDOLLCOM_PRINT(コマンド数カウンタ)
			
			改行カウンタ ++
			IF 改行カウンタ == 표시列数
				PRINTL 
				改行カウンタ = 0
			ENDIF
		NEXT
		改行カウンタ = 0
		
		PRINTFORML 
		PRINTL 　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　오토모드[102]
		
		PRINTL 
		IF オートモード != 1
			BINPUT
		ELSE
			;オートモードだとボタンインプットを飛ばしてくれる。
			PRINTFORML ・・・오토모드 중입니다。（%CALLNAME:MASTER%님이 조작할 필요는 없습니다）
			RESULT = RAND:4 + 20
			TWAIT 3, 0
		ENDIF
		
		;조교メニューの選択後まで
		$ERALOOP59532_TARINCOM
		IF RESULT == 102
			PRINTFORMW ・・・오토모드로 전환합니다。（%CALLNAME:MASTER%님은 잠시 구경해 주세요）
			オートモード = 1
			RESULT = RAND:4 + 20
		ENDIF
		
		SELECTCASE RESULT
			CASE 19
				;スパンキング
				CALL EROTIC_MOVE("拷問処理", 조교대상, -1, 300)
				만족度　+= 50
			CASE 20
				;鞭
				CALL EROTIC_MOVE("拷問処理", 조교대상, -1, 600)
				만족度　+= 120
			CASE 21
				;針
				CALL EROTIC_MOVE("拷問処理", 조교대상, -1, 1200)
				만족度　+= 250
			CASE 22
				;ナイフ
				;체력そのものを割合で削る処理を入れる（조교대상の체력が莫大な数値の場合でもループを終えるためのコマンド）
				ゴア行為消費체력 = MAXBASE:조교대상:체력
				TIMES ゴア行為消費체력 , 0.1
				BASE:조교대상:체력 -= ゴア行為消費체력
				CALL EROTIC_MOVE("拷問処理", 조교대상, -1, 1500)
				만족度　+= 50
			CASE 23
				;鉈
				;체력そのものを割合で削る処理を入れる（조교대상の체력が莫大な数値の場合でもループを終えるためのコマンド）
				ゴア行為消費체력 = MAXBASE:조교대상:체력
				TIMES ゴア行為消費체력 , 0.5
				BASE:조교대상:체력 -= ゴア行為消費체력
				CALL EROTIC_MOVE("拷問処理", 조교대상, -1, 3000)
				만족度　+= 50
			CASEELSE
				PRINTFORMW ・・・부정한 커맨드가 입력되었습니다。시스템을 정지합니다。
				RETURN 0
		ENDSELECT
		
		;無限ループ（！？）　조교대상の체력を０にするまで止めることはできません。
		GOTO ERALOOP59532
	ENDIF
ENDIF

RETURN 1

@ERASHADDOLLCOM_PRINT(COM番号)
#DIM DYNAMIC COM番号

;[19]スパンキング [20]鞭 [21]針 [22]ナイフ [23]鉈　の5つだけ。全部「拷問処理」で計算
SELECTCASE COM番号
	CASE 19
		PRINT 스팽킹[ 19]
	CASE 20
		PRINT 　채찍[ 20]
	CASE 21
		PRINT 　바늘[ 21]
	CASE 22
		PRINT 나이프[ 22]
	CASE 23
		PRINT 　나대[ 23]
	CASEELSE
		;PRINT この地獄を終わらせる[XXX]
		RETURN 0
ENDSELECT

RETURN 1

@ERASHADDOLLSTR_PRINT(STR番号, 조교대상)
#DIM DYNAMIC STR番号
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 조교대상名前文字数
#DIMS DYNAMIC マスク名前 = ""

STRLENFORMU %CALLNAME:조교대상%
조교대상名前文字数 = RESULT
REPEAT 조교대상名前文字数
	マスク名前 '= マスク名前 + "■"
REND

;STR番号で呼べるようにしているが、実際は1個しか표시しない。
SELECTCASE STR番号
	CASE 59532
		;「あなた」は、このメッセージがどんな世界にあったものを模倣しているか、知っているだろうか？
		PRINTFORML 
		PRINTFORMW ・・・・・・・・・
		PRINTFORMW ・・・・・・
		PRINTFORMW ・・・
		PRINTFORMW ---%CALLNAME:조교대상%은 ■■했습니다.
		PRINTFORML 
		PRINTFORMW 아ー, 또 실패해 버렸네.
		PRINTFORMW "이런이런 %マスク名前%. 또 ■해 버린 게냐?"
		PRINTFORMW 갑자기 뒤에서 목소리가 들려왔다.
		PRINTFORMW 뒤돌아본 목소리의 주인은, 엄청나게 큰 마녀 모자에 마이크로 비키니를 입은 백발 갈색 피부의 빈유 로리바바다.
		PRINTFORMW "……꽤 비싸단다, 그 인형은"
		PRINTFORMW 비싸다고?　그렇다기엔 몇 번이고 몇 번이고 꺼내 주잖아.
		PRINTFORMW 방구석에 대량으로 버려져 있는, %CALLNAME:조교대상%『이었던』 인형의 산을 가리킨다.
		PRINTFORML 
		PRINTFORMW "뭐, 그렇지. %マスク名前%, 여기는 네가 즐기기 위한 세계니까……"
		PRINTFORMW 그렇게 투덜거리면서도, 새로운 %CALLNAME:조교대상%을 꺼내 주었다.
		PRINTFORML 여느 때처럼 신선한 곤혹스러움을 보이는 %CALLNAME:조교대상%의 모습에, 나도 모르게 입맛을 다셨다.
		PRINTFORMW 
		SETCOLOR C_RED
		PRINTFORMW 이번에는 어떻게 "부숴서" 놀아볼까……
		RESETCOLOR
		PRINTFORML 
		PRINTFORML 
		PRINTFORMW "슬슬 조교도 끝이 보이는구나……%マスク名前%여, 마음껏 즐기는 게 좋을 게다"
		CALL FLASH(1)
		WAIT
		CALL FLASH(2)
		WAIT
		CALL FLASH(4)
		CLEARLINE 1
		;グラデーションフォントにしようかしらん
		PRINTFORM "슬슬 조교도 끝이 보이는구나……
		SETCOLOR C_RED
		PRINTFORM %CALLNAME:조교대상%
		SETCOLOR C_D_PINK
		PRINTFORMW 여, 마음껏 즐기는 게 좋을 게다"
		PRINTFORMW 
		RESETCOLOR
	CASEELSE
		;PRINT この地獄を終わらせる[XXX]
		RETURN 0
ENDSELECT

RETURN 1


