@CARDNAME_59532, 参照先
;ココで지정 카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = E.R.A.ShadDOLL.Construct
	CASE "略称"
		RESULTS = ERA 네피림
	CASE "カテゴリ"
		RESULTS:0 = 섀도르
		RESULTS:1 = ShadDOLL
		;RESULTS:2 = 젬나이트 라피스
		RESULTS:3 = E.R.A
ENDSELECT


@CARD_59532(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"	
		RETURN 융합
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 2500
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		;カード所持してないと連動しない설정に（入手前はALT화상に설정できない処置）
		;※ネフィリムのデータとの連動は封鎖中
		;IF ITEM:59532 >= 1
		;	RETURN 1832
		;ENDIF
ENDSELECT

RETURN 0

