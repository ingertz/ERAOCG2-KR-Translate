CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX소환時強制
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59532)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲제외 = 1
		효과条件종류 = 마함全般
		효과条件カテゴリ = 섀도르
		효과条件固名前起動 = 1
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
		条件合致数 = RESULT
		IF 条件合致数 != 0
			CALL FULLRESET
			CALL SET_FIELD_INFO(듀얼리스트, "필드", 場所, "戦", 条件合致数)
		ENDIF
	ENDIF
ELSEIF 종류 == ライフ変強制誘発
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 59532)
	IF RESULT == 0
		CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
		IF RESULT != -1
