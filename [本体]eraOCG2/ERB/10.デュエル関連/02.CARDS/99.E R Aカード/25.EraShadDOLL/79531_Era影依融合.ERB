@CARDNAME_79531, 参照先
;ココで지정 카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = E.R.A.ShadDOLL.Fusion
		;RESULTS = 사악한 그림자 저주
	CASE "略称"
		RESULTS = ERA섀도르 퓨전
	CASE "カテゴリ"
		RESULTS:0 = 섀도르
		RESULTS:1 = ShadDOLL
		RESULTS:2 = 융합
		RESULTS:3 = E.R.A
ENDSELECT


@CARD_79531(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속마법
ENDSELECT
RETURN 0

@CARD_EXPLANATION_79531(종류)
#DIM DYNAMIC 종류
#DIMS DYNAMIC HTML_STR0
#DIMS DYNAMIC HTML_COLOR

TRYCALL ERASHADDOLLTEXT_PRINT(79531)
HTML_STR0 = %RESULTS%
TRYCALL ERASHADDOLLTEXT_PRINT(1)
HTML_COLOR = %RESULTS%

CALL TEXT_DECORATION("ROGUE")
PRINTL 이 카드명의 ①③의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1, 마함起動)
PRINTL ①：자신 메인 페이즈에 발동할 수 있다。자신의 패 / 필드의 "섀도르" 몬스터를 융합 소재로 해
PRINTL "섀도르" 융합 몬스터 1장을 융합 소환한다. 필드 / 묘지에 여성 몬스터가 존재할 경우,
PRINTL 자신의 엑스트라 덱에 "섀도르" 몬스터도 융합 소재로 할 수 있다。
CALLFORM CARD_ABLE(0, 지속효과)
PRINTL ②：자신 필드에 「섀도르」융합 몬스터가 존재하는 한,
PRINTL 공격 가능한 상대 몬스터는 "섀도르" 융합 몬스터 또는 뒷면 수비표시인 몬스터를 공격해야만 한다。
CALLFORM CARD_ABLE(3, 身代효과)
PRINTL ③：자신 필드의 "섀도르" 카드가 전투 / 효과로 파괴될 경우,
PRINTL 대신에 패 / 필드의 이 카드 이외의 "섀도르" 카드 1장을 묘지로 보낼 수 있다。
PRINT 상대 플레이어가
HTML_PRINT @"<nonbutton title='%HTML_ESCAPE(HTML_STR0)%'><font color='#%HTML_COLOR%'><nobr>■■■■■■■■■■■■■</nobr></font></nonbutton>",1
PRINTL 인 경우, 덱 / 엑스트라 덱에서도 보낼 수 있다。
PRINTL 이 효과로 묘지로 보내진 카드의 효과는 유발하지 않는다。
CALL TEXT_DECORATION("ROGUE")

;2025.10 효과修正
;융합素材側のカテゴリ지정を발동条件側にも記載추가。지속효과를 整理。攻撃誘導の지정条件を見直して条件の誤り部分も修正、텍스트で対応。
;簡単な条件でEX덱에서 융합素材を落とせる都合上、「～を含む」ではなく「섀도르」몬스터밖에 융합素材に出来ない厳しめの制約に。
;ダメージ反射はテーマの설정と関連性が薄く、ただ強いだけの효과なので削除。대신에 擬似的な전투 / 효과破壊耐性を身代효과として설정。
;조교可能なプレイヤーが상대의 場合は、덱 / ＥＸ덱에서도 落とすことが可能になり、묘지肥やしとしてテーマのギミックに絡められるように調整。
;本来の「섀도르」のメインギミックとの噛み合いは悪くなるが、身代효과でのカード送りは本家OCGの処理としては
;효과による묘지送り扱いではなさそうなので、完全묘지送りにして섀도르の共通효과는 誘発しないよう설정。
;テーマのギミックと相反しており、パッと見で묘지送り효과가 誘発するものと誤解しそうなので、텍스트にも誘発しない事は明記しておく。
;※これは덱에서 リザードを落とすよりERAミドラたち상대プレイヤー조교補助の묘지효과持ちを送るほうがバリューが出るようにする意図で설정。
;　影依융합や접촉、偽典などの마법함정を묘지로 보내고、섀도르융합体の共通효과でサルベージ、というテクニックは許容。（自力で気付いた人はえらい）


@CARDCAN_79531(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 조교대상 = -1
#DIM DYNAMIC EX条件달성
#DIM DYNAMIC 条件달성 = 0

CALL CARD_NEGATE(듀얼리스트, 종류, ゾーン, 場所, 79531)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 발동済_1(듀얼리스트, 79531)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	;필드 / 묘지에 牝性 몬스터가 いる場合の条件달성。
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲묘지 = 1
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과範囲상대묘지 = 1
	효과条件성별 = 牝性
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT == 1
		EX条件달성 = 1
	CALL RESETAREA_MAT
	SIF EX条件달성 == 1
		素材範囲EX덱 = 1
	素材範囲필드 = 1
	素材範囲손패 = 1
	素材条件カテゴリ = 섀도르
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = 융합
	효과条件カテゴリ = 섀도르
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 섀도르
	효과条件종류 = 융합
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 身代효과
	SIF ゾーン != "마함"
		RETURN 0
	SIF !GROUPMATCH(破壊종류, "효과", "戦闘")
		RETURN 0
	VARSET RESULTS
	TRYCALLFORM CARDNAME_{破壊대상ID}("カテゴリ")
	SIF !MATCH(RESULTS, "섀도르")
		RETURN 0
	CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
	IF RESULT != -1
		조교대상 = RESULT
		;상대가 あなたではなく（!=MASTER）男性でもない（성별!=2）조교대상なら条件달성
		SIF 조교대상 != MASTER && TALENT:조교대상:성별 != 2
			条件달성 = 1
	ENDIF
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲필드 = 1
	효과範囲마함 = 1
	IF 条件달성 != 0
		효과範囲덱 = 1
		효과範囲EX덱 = 1
	ENDIF
	효과条件他所 = 1
	효과条件カテゴリ = 섀도르
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_79531(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC EX参照
#DIM DYNAMIC 묘지送カード,10
#DIM DYNAMIC 손패묘지送カード,10
#DIM DYNAMIC 素材数
#DIM DYNAMIC 조교대상 = -1
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択済カード
#DIM DYNAMIC EX条件달성 = 0
#DIM DYNAMIC 条件달성 = 0
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
;융합소환
#DIMS DYNAMIC 対面者

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 79531, 1)
	IF RESULT == 0
		;CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과範囲묘지 = 1
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과範囲상대묘지 = 1
		효과条件성별 = 牝性
		효과条件종류 = モン全般
		CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
		SIF RESULT == 1
			EX条件달성 = 1
		;EX덱確認
		CALL RESETAREA_MAT
		SIF EX条件달성 == 1
			素材範囲EX덱 = 1
		素材範囲필드 = 1
		素材範囲손패 = 1
		素材条件カテゴリ = 섀도르
		CALL FULLRESET
		효과条件종류 = 융합
		효과条件カテゴリ = 섀도르
		효과条件소환可 = 1	
		CALL CARD_CHOOSE_BASIC(듀얼리스트, "EX덱", ゾーン, 場所)
		選択カード = RESULT
		;돌아간다
		IF 選択カード != 9999
			;마법 카드를 묘지送り
			TRYCALLFORM CARDSUMMON_{GETVAR(@"%듀얼리스트%_EX덱:{選択カード}")}(듀얼리스트, 選択カード)
			;素材処理を読み込む
			CALL FUSSUMMON(듀얼리스트, 選択カード)
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트, "상대필드", 場所, "戦狂")
	CALL STATCHANGE_EFFECT(듀얼리스트, "상대필드", 場所, "直無")
	
	CALL FULLRESET
	효과条件固カテゴリ = 섀도르
	효과条件スーパーカテゴリ = 섀도르
	효과条件スーパー종류 = 융합以外
	CALL STATCHANGE_EFFECT(듀얼리스트, "필드", 場所, "攻避")
ELSEIF 종류 == 身代효과
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 79531, 3)
	IF RESULT == 0
		CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
		IF RESULT != -1
			조교대상 = RESULT
			;상대가 あなたではなく（!=MASTER）男性でもない（성별!=2）조교대상なら条件달성
			SIF 조교대상 != MASTER && TALENT:조교대상:성별 != 2
				条件달성 = 1
		ENDIF
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲필드 = 1
		효과範囲마함 = 1
		IF 条件달성 == 1
			효과範囲덱 = 1
			효과範囲EX덱 = 1
		ENDIF
		효과条件他所 = 1
		효과条件カテゴリ = 섀도르
		효과条件行先플래그 = 完全묘지行き
		CALL CARD_ADD_GY_ADV(듀얼리스트, ゾーン, 場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件カテゴリ = 섀도르
			CALL STATCHANGE_EFFECT(듀얼리스트, "필드", 場所, "破耐", 6)
			CALL FULLRESET
			효과条件カテゴリ = 섀도르
			CALL STATCHANGE_EFFECT(듀얼리스트, "마함", 場所, "破耐", 6)
			RETURN 1
		ENDIF
	ENDIF
	RETURN 0
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 79531)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트, ゾーン, 場所, 마함行き)
	ENDIF
ENDIF
