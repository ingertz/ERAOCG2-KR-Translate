@CARDNAME_39904,参照先
;여기서 지정 카드의 이름, 약칭을 반환할 예정
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 이쿠기어 아쿠메 레이저 폰
	CASE "略称"
		RESULTS = 광서의정광병
	CASE "カテゴリ"
		RESULTS:0 = 광서의 기계
		RESULTS:1 = E.R.A
ENDSELECT


@CARD_39904(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1600
	CASE "守備力"
		RETURN 1000
	CASE "성별"
		RETURN 牝性
ENDSELECT

RETURN 0

@CARD_EXPLANATION_39904(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL 이 카드명의 ①②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다.
CALLFORM CARD_ABLE(1,손패起動,묘지起動)
PRINTL ①：이 카드가 패 / 묘지에 존재하고, 자신 필드에 "광서의 기계" 카드가 존재할 경우에 발동할 수 있다.
PRINTL 이 카드를 특수 소환한다.
CALLFORM CARD_ABLE(2,소환時,특수소환時)
PRINTL ②：이 카드가 소환 / 특수 소환한 경우에 발동할 수 있다.
PRINTL 덱에서 "광서의 기계" 마법 / 함정 카드 １장을 패에 넣는다.
CALLFORM CARD_ABLE(3,필드起動)
PRINTL ③：자신 / 상대의 메인 페이즈에 １번, 상대 필드의 앞면 표시 몬스터 １장을 대상으로 하고 발동할 수 있다.
PRINTL 그 몬스터의 공격력 / 수비력은 이 카드의 공격력만큼 다운하고, 발정시킨다.
PRINTL 그 후, 필드의 "광서의 기계" 카드를 １장 선택하여, 그 카드에 미약 카운터를 １개 놓는다.
PRINTL
SETCOLOR C_RED
PRINTL ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊ーー경고ーー＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
PRINTL ④：이 카드가 암컷 몬스터의 능력을 내릴 때、
PRINTL 절정광선을 맞게해、강제적으로 절정아쿠메를 정해버린다。
CALL CARD_ABLE(4,攻撃後誘発)
PRINTL ⑤：이 카드가 공격으로 암컷 몬스터를 파괴한 경우에 발동할 수 있다。
PRINTL 파괴한 몬스터에게 절정광선을 연사하여 몇번이나 절정시킨다。
PRINTL ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊ーー주의ーー＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
PRINTL
RESETCOLOR
CALL TEXT_DECORATION("ROGUE")


@CARDCAN_39904(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 조교대상

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,39904)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動 || 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,39904)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,39904,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
    효과範囲마함 = 1
	효과条件カテゴリ = 광서의 기계
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
    
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,39904)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = 마함全般
	효과条件カテゴリ = 광서의 기계
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動
	SIF 발동済_3(듀얼리스트,39904)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
    효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
	
ELSEIF 종류 == 攻撃後誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF 直前戦闘破壊ID(듀얼리스트,1) == 0
		RETURN 0	
	CALLFORM CARD_{直前戦闘破壊ID(듀얼리스트,1)}("성별")
	SIF RESULT != 牝性
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_39904(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 減少値




IF 종류 == 손패起動 || 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39904,1)
	IF RESULT == 0
		CALL FULLRESET
		효과추가종류:0 = 24
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39904,2)
	IF RESULT == 0
		CALL FULLRESET
        효과範囲덱 = 1
		효과条件カテゴリ = 광서의 기계
        효과条件종류 = 마함全般
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39904,3)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종류 = モン全般
		효과条件표시 = 表側표시
        減少値 = GETVAR(@"%듀얼리스트%_MZ_攻:場所")
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"永攻DOWN",減少値)
		IF RESULT == 1
			CALL CARD_EROTICS(RESULT:2)
				IF RESULT != -1
				조교대상 = RESULT
				IF NO: 조교대상 == 2130

					PRINTFORMW 기계정광병에게 갑자기 꿰뚫린 프리메라의 육체는 온몸을 움찔움찔 떨게 된다,
					PRINTFORMW 그 반응에 늦어 분홍색 광선에 꿰뚫린 프리메라는 몸에 두른 갑옷 하반신에 애액과 흥건하게 젖어 흩뿌리면서,
					PRINTFORMW 곤혹을 쾌락과 신음소리로 덮어쓰고, 덜덜 무릎을 떨며 땅에 쓰러져, 절정을 반복해버린다……

					CALL MADORGASM_RAND_ROB_TXT(1,1)
					CALL EROTIC_MOVE("절정光線",조교대상,-1,300)

				ELSE
				SELECTCASE RAND:3
					CASE 0
					PRINTFORMW 기계정광병은 오른쪽 어깨에 탑재된 강제 절정 광선을 발사하기 위한 저격포를 %CALLNAME:조교대상%에게 발사한다.
					PRINTFORMW 몇 콤마 정도의 차이로, 분홍색 광선에 관통당한 %CALLNAME:조교대상%은 그 자리에서 갑자기 애액과 조수를 뿜어내며,
					PRINTFORMW 뒤늦게 애액을 흘리듯이 신음소리를 퍼뜨리며 절정했다……
					CASE 1
					PRINTFORMW 기계정광병이 쏘는 절정 광선에 관통당한 %CALLNAME:조교대상%의 몸은 그 자리에서 애액과 조수를 뿜어내며 절정한다.
					PRINTFORMW 육체에 무슨 일이 일어났는지도 모르는 %CALLNAME:조교대상%은 뜻밖의 사태에 대응할 수도 없고,
					PRINTFORMW 그저 그 자리에서 육체를 『움찔❤움찔”❤』하고 튀어 오르며 계속 절정할 수밖에 없다……
					CASE 2
					PRINTFORMW %CALLNAME:조교대상%은 갑자기 자신의 육체를 관통한 분홍색 광선을 감지했다,
					PRINTFORMW 그것을 자각하면서 몸이 계속 이키고 있다는 것을 인식한 %CALLNAME:조교대상%에게 몸에 받은 절정 광선에 대해 할 수 있는 것은 없었고,
					PRINTFORMW 그저 가버리는 목소리를 내며, 절정할 때마다 "간다♡"라고 보고할 뿐인 비참한 암컷이 되어버렸다……
				ENDSELECT

				CALL MADORGASM_ORGASMLASER_TXT(1,0)
				CALL MADORGASM_ORGASMLASER_TXT(1,1)
				CALL MADORGASM_ORGASMLASER_TXT(1,2)
				CALL EROTIC_MOVE("절정光線",조교대상,-1,200)
				ENDIF
			ENDIF
        	CALL STATCHANGE_EFFECT(듀얼리스트,"필드単体",場所,"発情")
			ENDIF
    	CALL FULLRESET
        SETCOLOR C_PINK
		PRINTFORML
		PRINTFORML
		PRINTFORML 　　　"광서의 기계" 에 미약 카운터를 １개 올릴 수 있습니다, 대상을 선택해주세요.
		PRINTFORML
		RESETCOLOR
		효과範囲필드 = 1
		효과条件カテゴリ = 광서의 기계
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		選択カード = RESULT
			IF 選択カード != 9999
				CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"薬Ｃ",1)
				ENDIF
	ENDIF

ELSEIF 종류 == 攻撃後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39904)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_EROTICS(直前戦闘破壊ID(듀얼리스트,1))
		IF RESULT != -1
			조교대상 = RESULT
			SELECTCASE RAND:3
				CASE 0
				PRINTFORMW 기계정광병은 강제 절정시키는 광선을 발사하기 위한 저격포를 쓰러진 %CALLNAME:조교대상%를 향해 몇 번이고 쏘기 시작한다.
				PRINTFORMW 너덜너덜해진 %CALLNAME:조교대상%는 억지로 절정시키는 광선을 맞고 땅바닥을 구르기 시작했다,
				PRINTFORMW 애액과 조수를 흩뿌리면서 필사적으로 용서를 비는 %CALLNAME:조교대상%에게, 기계정광병은 가차없이 방아쇠를 계속 당긴다……
				CASE 1
				PRINTFORMW 기계정광병이 쏘는 절정 광선에 꿰뚫린 %CALLNAME:조교대상%의 몸은 뒤로 젖혀지면서 애액과 조수를 뿜어내며 절정한다.
				PRINTFORMW %CALLNAME:조교대상%는, 갑자기 튀어 오르듯 반응한 육체에서 전해지는 쾌락에 아무것도 하지 못하고,
				PRINTFORMW 그저 그 자리에서 육체를 『움찔❤움찔❤』하며 들썩이고 손발 끝까지 흣❤하고 뻗으며 계속 절정할 수밖에 없다……
				CASE 2
				PRINTFORMW %CALLNAME:조교대상%는 기계정광병에게 쓰러져, 무방비하게 땅에 쓰러진 모습을 드러내고 만다.
				PRINTFORMW 절호의 먹잇감이 되어버린 %CALLNAME:조교대상%는 가차없이 기계정광병이 쏘는 절정 광선에 의해 가버리기 시작했다,
				PRINTFORMW %CALLNAME:조교대상%는, 그저 아크메 소리를 지르며, 절정할 때마다 "가버렷♡"이라고 보고할 뿐인 비참한 암컷이 되어간다……
			ENDSELECT

			FOR 카운터,0,3
				CALL MADORGASM_ORGASMLASER_TXT(1,0)
				CALL MADORGASM_ORGASMLASER_TXT(1,1)
				CALL MADORGASM_ORGASMLASER_TXT(1,3)
				CALL EROTIC_MOVE("절정光線",조교대상,-1,200)
			NEXT

			SELECTCASE RAND:3
				CASE 0
				PRINTFORMW 몇 번이고 절정하게 된 %CALLNAME:조교대상%는 온몸을 자신의 애액으로 적신 채 쓰러져,
				PRINTFORMW 변변한 저항도 하지 못한 채, 기계정광병에게 다리를 붙잡혀, 다리가 벌려진 채로 질질 끌려가고 만다,
				PRINTFORMW 드러난 양쪽 구멍에서는 아직도 절정의 여운으로 조수를 "철썩❤ 철철❤"하고 땅에 흩뿌리고 있었다……
				CASE 1
				PRINTFORMW 몇 번이고 절정을 반복하며 온몸에서 체액을 흘리고, "아…… 아”에… 아…❤"라는 한심한 소리를 내버리는 %CALLNAME:조교대상%,
				PRINTFORMW 육체는 움찔움찔 아직도 계속 튀어 오르고, %CALLNAME:조교대상%도 그 표정은 녹아내려, 쾌락을 탐하는 암컷의 표정을 짓고 있다.
				PRINTFORMW 그 자리에서 %CALLNAME:조교대상%는 시오후키를 하며 실질적인 패배 선언을 몸으로 해버린다……
				CASE 2
				PRINTFORMW %CALLNAME:조교대상%는 몇 번이고 절정 광선을 맞고, 계속 가버린 결과 안짱다리 모습으로 암컷 구멍을 드러내는 체위를 하고 있었다,
				PRINTFORMW "철철철”❤❤" 소리를 내며 조수를 땅에 흩뿌리는 %CALLNAME:조교대상%는
				PRINTFORMW "아❤에아……❤아”～～…❤" 하고 녹아내려 넋이 나간 표정을 지으며 절정의 여운을 맛보고 있다……

			ENDSELECT
		ENDIF
	ENDIF
	
ENDIF




