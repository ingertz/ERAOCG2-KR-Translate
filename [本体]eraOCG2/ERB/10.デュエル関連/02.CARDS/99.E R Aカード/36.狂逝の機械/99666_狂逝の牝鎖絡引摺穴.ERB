@CARDNAME_99666,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 이쿠기어 슬레이브 체인 홀
	CASE "略称"
		RESULTS = 광서의 암락접혈
	CASE "カテゴリ"
		RESULTS:0 = 광서의 기계
		RESULTS:1 = E.R.A
ENDSELECT


@CARD_99666(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속함정
ENDSELECT

RETURN 0

@CARD_EXPLANATION_99666(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL
PRINTL 이 카드명의 ①②의 효과는 각각 1턴에 1번밖에 발동할 수없다。
CALLFORM CARD_ABLE(1,마함起動)
PRINTL ①：자신 / 상대 턴에 필드 위의 성별을 가진 몬스터 １장을 대상으로 발동할 수 있다。
PRINTL 그 몬스터에게 미약 카운터를 １개 놓는다。
PRINTL 이 때、미약 카운터가 ３개 이상이 되면 그 몬스터의 효과를 무효로 하고、필드 위의 "광서의 기계" 몬스터 전부에게 미약 카운터를 １개 놓는다。
CALLFORM CARD_ABLE(2,バトル開始時)
PRINTL ②：자신 / 상대의 배틀 페이즈 개시시에 발동할 수 있다、
PRINTL 필드 위의 성별을 가진 모든 몬스터에게 미약 카운터를 １개 놓고、발정시킨다。
CALLFORM CARD_ABLE(3,손패起動)
PRINTL ③：자신 메인 페이즈에 패의 이 카드를 묘지로 보내고 발동할 수 있다、
PRINTL 자신 / 상대의 덱 / 자신 / 상대의 덱・ＥＸ덱에서 암컷 몬스터 1장을 효과를 무효로 하고 상대의 필드에 특수 소환한다。
PRINTL 이 효과를 발동한 턴 종료시까지 상대는 전투 데미지를 받지 않는다。
SETCOLOR C_RED
PRINTL ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊ーー경고ーー＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
CALLFORM CARD_ABLE(2,バトル開始時)
PRINTL ④：②의 효과의 대상이 된 암컷 몬스터는 미약에 의한 조교와 세뇌를 받아、
PRINTL 상대의 덱 안에 암컷 몬스터가 존재할 때 그 몬스터를 붙잡아、미독을 만들기 위한 구멍 취급으로 묘지로 보낸다。
CALLFORM CARD_ABLE(3,손패起動)
PRINTL ⑤：③의 효과의 대상이 된 암컷 몬스터는 필드에 나올 때、
PRINTL 옷이 벗겨져、접촉이 가능해진다。
CALLFORM CARD_ABLE(4,ターン終了時)
PRINTL ⑥：자신의 엔드 페이즈시에 발동할 수 있다。
PRINTL 기계성에 붙잡혀 있는 암컷 구멍들을 범하고、기계를 계속 활성화시키며、
PRINTL 상대 플레이어의 패에 강제력을 가진 패를 넣는다。
PRINTL ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊ーー주의ーー＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
PRINTL
RESETCOLOR
CALL TEXT_DECORATION("ROGUE")


@CARDCAN_99666(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 효과条件플래그 = 0
#DIM DYNAMIC 装備先
#DIMS DYNAMIC 装備者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,99666)
SIF RESULT == 1
RETURN 0

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF ゾーン != "마함"
		RETURN 0
	SIF 발동済_1(듀얼리스트,99666)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件성별 = 성별在
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == バトル開始時
	SIF ゾーン != "마함"
		RETURN 0
	SIF 발동済_2(듀얼리스트,99666)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
    효과範囲상대필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
    
ELSEIF 종류 == 손패起動
	SIF 발동済_3(듀얼리스트,99666)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲상대덱 = 1
	효과条件성별 = 牝性
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == ターン終了時
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	SIF 발동済_4(듀얼리스트,99666)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 마함起動
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_99666(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 戦闘カードID
#DIM DYNAMIC 효과条件플래그 = 0
#DIMS DYNAMIC 装備者
#DIM DYNAMIC 装備先
#DIM DYNAMIC 媚薬카운터プレイヤー
#DIM DYNAMIC 媚薬카운터対面者
#DIM DYNAMIC 選択結果
#DIM DYNAMIC 捕縛대상
#DIM DYNAMIC 捕縛場所,紙束最大値
#DIM DYNAMIC 捕縛場所B
#DIM DYNAMIC 捕縛候補,紙束最大値
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 절정횟수
#DIM DYNAMIC 묘지送り位置

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99666,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"選択")
		IF RESULT == 1
			CALL CARD_SELECT(듀얼리스트,RESULT:1)
			選択カード = RESULT
			CALL CARD_EROTICS(選択カード)
			IF RESULT != -1
				조교대상 = RESULT
				PRINTFORML 
				SETCOLOR C_PINK 
				PRINTFORML %NAME:조교대상%は狂逝の淫刑機人が撃った媚薬注入のための注射器を受け、発情してしまう……
				RESETCOLOR
				CALL EROTIC_MOVE("媚毒汚染",조교대상,-1,500)
			ENDIF
			CALL SET_FIELD_INFO(対面者,"필드",選択カード,"薬Ｃ",1)
			カウンタ = GETVAR(@"%対面者%_MZ_薬Ｃ:選択カード")
			IF カウンタ >= 3
				CALL SET_FIELD_INFO(대상者（CS）,"필드",選択カード,"無効",2,1)
				CALL FULLRESET
				FOR カウンタ,0,5
					SIF GETVAR(@"%듀얼리스트%_필드:カウンタ") == -1
						CONTINUE
    				효과条件종류 = モン全般
					효과条件カテゴリ = 광서의 기계
					CALL SET_FIELD_INFO(듀얼리스트,"필드",カウンタ,"薬Ｃ",1)
				NEXT
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 마함起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99666)
	IF RESULT == 0
	ENDIF

ELSEIF 종류 == バトル開始時
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99666,2)
		IF RESULT == 0
			CALL FULLRESET
			FOR カウンタ,0,5
			SIF GETVAR(@"%듀얼리스트%_필드:カウンタ") == -1
			CONTINUE
			효과条件성별 = 성별在
			CALL SET_FIELD_INFO(듀얼리스트,"필드",カウンタ,"薬Ｃ",1)
			NEXT
			FOR カウンタ,0,5
			SIF GETVAR(@"%対面者%_필드:カウンタ") == -1
			CONTINUE
			효과条件성별 = 성별在
			CALL SET_FIELD_INFO(対面者,"필드",カウンタ,"薬Ｃ",1)
			NEXT
			CALL FULLRESET
			효과条件성별 = 성별在
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"両필드全体",場所,"発情",2)
			CALL FULLRESET
        	효과範囲필드 = 1
    		효과条件종류 = モン全般
			효과条件カテゴリ = 광서의 기계
        	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"発情",100)
		CALL FULLRESET
		FOR カウンタ,0,現山札数(対面者)
		捕縛대상 = GETVAR(@"%対面者%_덱:カウンタ") ;0→カウンタ
		SIF 捕縛대상 == -1 ;念のため-1の場合は次へ
			CONTINUE
			CALLFORM CARD_{捕縛대상}("성별")
			SIF RESULT == 無性 || RESULT == 雄性
				CONTINUE
				CALL CARD_EROTICS(捕縛대상)
			SIF RESULT < 1 ;CSV持ち以外は제외
				CONTINUE
				捕縛候補:カウンタB = 捕縛대상 ;牝性を候補に格納
				捕縛場所:カウンタB = カウンタ
				カウンタB++ ;候補数加算
			NEXT
			SIF カウンタB < 1 ;カウンタが0以下=候補0
				RETURN
				묘지送り位置 = (RAND:カウンタB)
				捕縛대상 = 捕縛候補:묘지送り位置 ;カウンタBまでの乱数で捕縛候補の中からランダムに捕縛대상を決定
				捕縛場所B = 捕縛場所:묘지送り位置
				CALL CARD_EROTICS(捕縛대상) ;必ずCARD_EROTICSを挟む
				조교대상 = RESULT
				IF 조교대상 > 0 ;조교대상条件はあなたを想定しないなら>0で
					SELECTCASE RAND:4
						CASE 0
							PRINTFORML
							PRINTFORML 牝鎖絡引摺穴を動かすための糧を得るべく、牝穴たちは加工され尽くされた肉体を犯され続けている、
							PRINTFORML 捕らえられている%CALLNAME:조교대상%も気づけばその１つとされていた。
							PRINTFORMW 機械城の施設の１つである密閉され媚薬が詰め込まれたカプセルの中で、%CALLNAME:조교대상%は凌辱され続けている……
						CASE 1
							PRINTFORML
							PRINTFORML 牝鎖絡引摺穴を動かすためのエネルギーを得るべく、%CALLNAME:조교대상%を含めた牝肉は犯され続けていた
							PRINTFORML 절정と発狂を繰り返し、精神が壊れそうになれば無理矢理に補強され正気を保たされ続ける。
							PRINTFORMW %CALLNAME:조교대상%は、終わる事のない性的蹂躙に절정と喘ぎ声を返し、광서의 기계に捧げている……
						CASE 2
							PRINTFORML
							PRINTFORML %CALLNAME:조교대상%は牝鎖絡引摺穴を作動させるためのエネルギー源を生み出すために、
							PRINTFORML 四肢を切断され、機械城の施設の中で延々と犯されるための牝穴として組み込まれてしまっていた。
							PRINTFORMW %CALLNAME:조교대상%を含めた無数の牝穴たちの喘ぎ声が機械城に響き渡る……
						CASE 3
							PRINTFORML
							PRINTFORML 既に捕縛されていた牝の１つが機械兵として手元に写される
							PRINTFORML 手足を切断され、責め苦を与えられ続ける機械に頼らないと動くこともできない、そんな牝肉。
							PRINTFORMW %CALLNAME:조교대상%、機械に組み込まれた牝の腹部にその中が刻まれていた。
					ENDSELECT
						FOR カウンタ,0,4
							PRINTFORML 
							CALL MADORGASM_RAND_ROB_TXT(1,0)
							CALL MADORGASM_RAND_ROB_TXT(1,3)
							PRINTFORML
							CALL EROTIC_MOVE("全身凌辱",조교대상,MASTER,500)
						NEXT
							CALL MADORGASM_RAND_ROB_TXT(1,5);うるさい鳴き声
							PRINTFORML %CALLNAME:조교대상%は体中から体液を耐え流し、涙を溢れさせながら必死に救いを求めている中で
							PRINTFORMW 牝鎖絡引摺穴に備えられた機械の数々は次の牝を求めて蠢き続ける……
						ENDIF
					CALL CARD_DISPOSE(対面者,"덱",捕縛場所B)
		ENDIF

ELSEIF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99666,3)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
	    	효과範囲덱 = 1
        	효과範囲EX덱 = 1
	    	효과範囲상대덱 = 1
        	효과範囲상대EX덱 = 1
	    	효과条件종류 = モン全般
        	효과条件特不無視 = 1
			효과추가종류:0 = 効追全裸
			효과추가종류:1 = 効追접촉
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"",0,1)
			選択カード_ID = RESULT:1
			CALL CARD_EROTICS(選択カード_ID)
			IF RESULT != -1
				조교대상 = RESULT
				PRINTFORML
				PRINTFORML %CALLNAME:조교대상%は触手蠢く穴に引きずり込まれ、조교を受けてしまう……
				PRINTFORMW
				CALL EROTIC_MOVE("全身凌辱",조교대상,-1,300)
			ENDIF
		ENDIF
		CALL SET_PLAYER_INFO(듀얼리스트,"ダメージ無効",1,1)
	ENDIF
ELSEIF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99666)
    IF RESULT == 0
        CALL CARD_EROTICS(상대プレイヤー,듀얼리스트)
		조교대상 = RESULT
        IF 조교대상 != -1 && TALENT:조교대상:성별 == 1
			PRINTFORML 場に充満する淫らな成分を含めている蒸気が牝弄箱に溜まり、
			PRINTFORMW %CALLNAME:조교대상%の손패に一つの카드를 形成する……
			SELECTCASE RAND:9
				CASE 0
					CALL CARD_GENERATE_HAND(対面者,79840)
				CASE 1
					CALL CARD_GENERATE_HAND(対面者,79841)
				CASE 2
					CALL CARD_GENERATE_HAND(対面者,79842)
				CASE 3
					CALL CARD_GENERATE_HAND(対面者,79843)
				CASE 4
					CALL CARD_GENERATE_HAND(対面者,79844)
				CASE 5
					CALL CARD_GENERATE_HAND(対面者,79845)
				CASE 6
					CALL CARD_GENERATE_HAND(対面者,79846)
				CASE 7
					CALL CARD_GENERATE_HAND(対面者,79847)
				CASE 8
					CALL CARD_GENERATE_HAND(対面者,79848)
				ENDSELECT
		ENDIF
		
	ENDIF

ENDIF




