@CARDNAME_39908,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 이쿠기어 리트센트 에스코트노이드
	CASE "略称"
		RESULTS = 광서의 과묵검객
	CASE "カテゴリ"
		RESULTS:0 = 광서의 기계
		RESULTS:1 = E.R.A
ENDSELECT


@CARD_39908(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 1900
	CASE "守備力"
		RETURN 3000
	CASE "성별"
		RETURN 牝性
ENDSELECT
RETURN 0

@CARD_EXPLANATION_39908(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL
PRINTL "광서의 기계" 몬스터 ＋ 암컷 몬스터 １장
PRINTL 이 카드는 융합 소환 및 이하의 방법으로 EX덱에서 특수 소환할 수 있다。
CALLFORM CARD_ABLE(0,EX덱起動)
PRINTL 자신 필드의 "광서의 기계" 몬스터 １장과 、기계족 / 암컷 몬스터 １장을 릴리스했을 때、이 카드를 EX덱에서 수비 표시로 특수 소환할 수 있다。
PRINTL 이 카드명의 ②③의 효과는 １턴에 어느쪽인가 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,지속효과)
PRINTL ①：앞면 수비 표시의 이 카드는 공격 유도를 가지며、１턴에 １번 전투 / 효과로 파괴되지 않는다。
PRINTL    또한、이 카드는 앞면 수비 표시인채로 공격할 수 있다。
PRINTL    그 경우、이 카드는 수비력을 공격력으로 취급해 데미지 계산을 한다。
CALLFORM CARD_ABLE(2,攻撃時誘発)
PRINTL ②：상대 몬스터의 공격 선언시에、자신의 묘지에서 기계족 / 암컷 몬스터를 제외하고 발동할 수 있다。
PRINTL    그 공격을 무효로 하고、수비 표시로 한다。
CALLFORM CARD_ABLE(3,발동誘発)
PRINTL ③：상대가 마법 / 함정 카드를 발동했을 때에 패에서 "광서의 기계" 카드를 묘지로 보내고 발동할 수 있다。
PRINTL    그 발동을 무효로 한다。
PRINTL
SETCOLOR C_RED
PRINTL ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊ーー경고ーー＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
CALLFORM CARD_ABLE(1,지속효과)
PRINTL ⑤：융합 소환한 이 카드에는、２장째 소재로 사용한 암컷 몬스터 １장이 끼워진다。
PRINTL ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊ーー주의ーー＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
PRINTL
RESETCOLOR
CALL TEXT_DECORATION("ROGUE")

@CARDSUMMON_39908(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件素材ID起動 = 2

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = 광서의 기계
ELSEIF EX参照 >= 10
    素材条件성별 = 牝性
ENDIF

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,39908) 
	RETURN RESULT
ENDIF


@CARDCAN_39908(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 조교대상

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,39908)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
    효과範囲필드 = 1
	효과条件종족 = 기계족
	효과条件성별 = 牝性
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT <= 1
		RETURN 0
	CALL FULLRESET
    효과範囲필드 = 1
	효과条件カテゴリ = 광서의 기계
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_表:場所") == 3
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃時誘発
	SIF 발동済_2(듀얼리스트,39908)
		RETURN 0
	SIF 발동済_3(듀얼리스트,39908)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
    CALL FULLRESET
    효과範囲묘지 = 1
    효과条件カテゴリ = 광서의 기계
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 발동誘発
	SIF 발동済_2(듀얼리스트,39908)
		RETURN 0
	SIF 발동済_3(듀얼리스트,39908)
		RETURN 0
    SIF ゾーン != "필드"
	 	RETURN 0
	CALL FULLRESET
	효과条件종류 = 마함全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과条件종족 = 기계족
	효과条件성별 = 牝性
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
    RETURN 1

ENDIF

@CARDEFFECT_39908(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 戦闘カード
#DIM DYNAMIC 제외カードID
#DIM DYNAMIC 破壊カードID
#DIMS DYNAMIC 제외カード名
#DIM DYNAMIC 残り횟수
#DIM DYNAMIC 取込カードID
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39908)
		IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 광서의 기계
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
        CALL FULLRESET
		효과範囲필드 = 1
		효과条件성별 = 牝性
		효과条件종족 = 기계족
        CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				CALL CARD_EX_SUMMON(듀얼리스트,"EX덱",場所,"守備표시")
			ENDIF
		ENDIF

ELSEIF 종류 == 지속효과
	IF GETVAR(@"%듀얼리스트%_MZ_表:場所") == 守備표시
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"攻誘")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"一破")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"守戦")
	ENDIF

	IF GETVAR(@"%듀얼리스트%_MZ_汎数:場所") > 0
		;汎数読み込み
		取込カードID = GETVAR(@"%듀얼리스트%_MZ_汎数:場所")
		;記録した素材の성별をチェック
		TRYCALLFORM CARD_{取込カードID}("성별")
		;♀かふたなりなら続行
		選択カード = NO_TO_CHARANUM(取込カードID)
		IF 選択カード >= 1 && オプション_성별
			RESULT = TALENT:選択カード:성별
		ENDIF
		IF GETBIT(RESULT,0)
			;変化元IDに汎数を打ち込み
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"変化元ID",取込カードID,上書きモード)
			;フレーバー、캐릭터リスト読み込み
			CALL CARD_EROTICS(取込カードID)
			IF RESULT != -1
				조교대상 = RESULT
					SELECTCASE RAND:3
						CASE 0
						PRINTFORMW 소쇄봉사기인으로 개조되기 위한 사전 준비로서, %CALLNAME:조교대상%은 온몸을 능욕하기 위한 기계에 달라붙게 된다.
						PRINTFORMW 성기를 깎아 부수기 위한 드릴 바이브나 실리콘 전기톱, 자궁을 두드려 부수기 위한 수많은 형상의 딜도, 머리를 감싸듯이 장착된 세뇌 장치,
						PRINTFORMW 수많은 암컷을 망가뜨리기 위해서만 고안된 조교를 위한 기기에, %CALLNAME:조교대상%은 얼굴이 파랗게 질려 공포에 떨게 된다……
						CASE 1
						PRINTFORMW 붙잡힌 %CALLNAME:조교대상%은, 자신에게 연결된 광서의 기계에 구속되어 온몸을 능욕하기 위한 기계에 편입된다,
						PRINTFORMW 실오라기 하나 걸치지 않은 모습으로 양손은 등 뒤로 돌려지고, 다리를 벌린 자세로 삽입을 대기하게 되며, 온몸은 꼼짝 하나 할 수 없이 구속되고,
						PRINTFORMW 일체의 저항도 허용되지 않는 상태가 된 끝에, %CALLNAME:조교대상%은 기계에 의한 유린을 받기 시작한다……
						CASE 2
						PRINTFORMW %CALLNAME:조교대상%은 광서의 기계의 일부로서 범해지기 위해서만 편입되고 만다,
						PRINTFORMW 다양한 암컷들이, 헐떡이고, 몸부림치고, 괴로워하며, 교성을 지르며 절정을 반복하는 광서의 기계의 동력이 된 자들을 떠올리자, %CALLNAME:조교대상%의 표정은 파랗게 질려간다
						PRINTFORMW %CALLNAME:조교대상%은 자신도 그렇게 될 것이라는 공포로부터 발버둥치며 벗어나려 하지만, 그 인격을 없애기 위한 기계가 장착되고 만다……
					ENDSELECT

					PRINTFORMW %CALLNAME:조교대상%의 머리 위에 설치된 세뇌 장치도 『키이이이이…』 하는 소리를 내며 움직이기 시작한다

					FOR カウンタ,0,4
					SELECTCASE RAND:4
						CASE 0
						CALL MADORGASM_BRAINWASHING_TXT(1,0)
						PRINTFORML %CALLNAME:조교대상%은, %CALLNAME:MASTER%의 자지님에게 적합한 봉사 방법을 뇌에 직접 새겨진다……
						CALL MADORGASM_BRAINWASHING_TXT(1,1)
						CALL EROTIC_MOVE("최면펠라",조교대상,-1,200)
						CASE 1
						CALL MADORGASM_BRAINWASHING_TXT(1,0)
						PRINTFORML %CALLNAME:조교대상%은, 무의식적으로 혀를 입 밖으로 내밀어, 뇌로의 직접적인 정보 제공으로 %CALLNAME:MASTER%의 정액 맛을 기억해버리고 만다……
						CALL MADORGASM_BRAINWASHING_TXT(1,2)
						CALL EROTIC_MOVE("최면정음",조교대상,-1,200)
						CASE 2
						CALL MADORGASM_BRAINWASHING_TXT(1,0)
						PRINTFORML %CALLNAME:조교대상%은, 꼴사납고 한층 더 음탕한 자위 방법이 뇌 속에 각인되어 간다……
						CALL MADORGASM_BRAINWASHING_TXT(1,3)
						CALL EROTIC_MOVE("최면自発자위",조교대상,-1,200)
						CASE 3
						CALL MADORGASM_BRAINWASHING_TXT(1,0)
						PRINTFORML %CALLNAME:조교대상%은 %CALLNAME:MASTER%의 자지님이 어떻게 암컷을 타락시키는지라는 지식을 기억에 새겨진다……
						CALL MADORGASM_BRAINWASHING_TXT(1,4)
						CALL EROTIC_MOVE("최면自発기승위",조교대상,-1,200)
					ENDSELECT
					NEXT

					SELECTCASE RAND:3
						CASE 0
						PRINTFORMW %CALLNAME:조교대상%은, 기계로부터 해방됨과 동시에 %CALLNAME:MASTER%의 앞에서 몸에 걸친 의복을 벗어 던지기 시작한다.
						PRINTFORMW 그리고, 준비되어 있던 롱스커트의 메이드복을 스스로 걸치고, 자신의 키만 할 정도의 전투용 의수를 장비하고,
						PRINTFORMW %CALLNAME:조교대상%은 몸에 걸치고 있던 것을 짓밟으면서 정숙하게 입을 연다……
						CASE 1
						PRINTFORMW %CALLNAME:조교대상%은 세뇌를 마치고, 기계에서 해방되자 공허한 눈으로 비틀비틀 머리를 흔들면서 준비된 의복으로 갈아입기 시작한다.
						PRINTFORMW %CALLNAME:MASTER%가 보고 있는 눈앞에서, 실오라기 하나 걸치지 않은 모습이 되어, 범해지기 쉽도록 중요 부위를 가리지 않는 속옷을 몸에 걸치고, 그것을 숨기듯이 메이드복을 입는다.
						PRINTFORMW 그리고 %CALLNAME:조교대상%은, %CALLNAME:MASTER%를 향해 스커트를 집어 올리면서 입을 연다,
						CASE 2
						PRINTFORMW 참혹한 능욕을 받아 온몸이 희롱당한 끝에, 갖가지 음구가 온몸을 계속 희롱하는 광서의 기계에 편입된 %CALLNAME:조교대상%.
						PRINTFORMW 장착된 『뀨폿❤뀨보봇❤』 소리와 함께 양쪽 구멍에 삽입된 딜도 피스톤 장치로 복부가 부풀려지고, 거기에 반응해 애액을 흩뿌리면서
						PRINTFORMW %CALLNAME:조교대상%은 %CALLNAME:MASTER%를 향해 경례를 하면서 입을 연다.
					ENDSELECT
						PRINTFORML
						PRINTFORMW "『%CALLNAME:조교대상%』는 지금부터, 소쇄봉사기인으로서 %CALLNAME:MASTER%님을 모시겠습니다, 무엇이든 명령해주십시오"
						PRINTFORML
						CALL EROTIC_MOVE("생체파츠",조교대상,-1,200)
				CALL EROTIC_MOVE("拷問処理",조교대상,-1,200)
			ENDIF
		ENDIF
		;使い終わった汎数を削除
		SIF GETVAR(@"%듀얼리스트%_MZ_汎数:場所") >= 1000
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"汎数",0,上書きモード)
	ENDIF

ELSEIF 종류 == 攻撃後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39908,2)
		IF RESULT == 0
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件종족 = 기계족
			효과条件성별 = 牝性
			효과条件行先플래그 = 제외行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL EVADE_ATTACK(듀얼리스트)
				CALL FULLRESET
				효과추가종류 = 5
	    		CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"표시변경")
			ENDIF
        ENDIF

ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39908,3)
    	IF RESULT == 0
			CALL FULLRESET
			효과条件カテゴリ = 광서의 기계
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")
				RETURN 1
			ENDIF
        ENDIF
ENDIF







