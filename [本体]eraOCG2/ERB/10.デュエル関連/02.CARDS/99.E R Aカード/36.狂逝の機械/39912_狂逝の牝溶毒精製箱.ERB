@CARDNAME_39912,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 이쿠기어 드러그 플랜트 박스
	CASE "略称"
		RESULTS = 광서의 음독제상
	CASE "カテゴリ"
		RESULTS:0 = 광서의 기계
		RESULTS:1 = E.R.A
ENDSELECT


@CARD_39912(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 800
	CASE "守備力"
		RETURN 2400
	CASE "성별"
		RETURN 牝性
ENDSELECT
RETURN 0

@CARD_EXPLANATION_39912(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：자신 필드 위에 "광서의 기계" 카드가 존재할 때、패에서 발동할 수 있다、
PRINTL 자신의 패 / 덱、또는 상대의 덱에서 암컷 몬스터를 묘지로 보내고 이 카드를 패에서 특수 소환할 수 있다、
PRINTL 그 후 필드 위의 성별을 가진 몬스터 모두를 발정시키고 미약 카운터를 １개 놓는다。
PRINTL 이 효과로 발정한 "광서의 기계" 몬스터는 무조건 공격할 수 있다。
CALLFORM CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ②：자신 / 상대 메인 페이즈에 발동할 수 있다、이 카드에 미약 카운터를 １개 놓고、
PRINTL 이 때 미약 카운터가 ２개 이상이라면、미약 카운터를 전부 제거하고 덱에서 １장 카드를 드로우한다。
CALLFORM CARD_ABLE(3,효과後強制誘発)
PRINTL ③：이 카드가 몬스터 존에 존재하는 상태로、상대 필드 위에 성별을 가진 몬스터가 소환 / 특수 소환되었을 때、
PRINTL 그 몬스터를 발정시켜 미약 카운터를 １개 놓는다。
PRINTL
SETCOLOR C_RED
PRINTL ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊ーー경고ーー＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ④：①의 효과 사용시、묘지로 보낸 암컷 몬스터를 대상으로 발동한다、
PRINTL 『상자』의 １개로서 구속되어 광서의 기계를 움직이기 위한 양식이 되기 위해 가공을 한다。
CALLFORM CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ⑤：②의 효과 사용 시、암용독정제함이 관리하는『상자』에 대해 발동한다、
PRINTL 강제절정광선을 쏜것에 의한 공격으로 패 증강을 행사하기 위한 에너지를 무수히 절정을 반복시켜 회수한다。
CALLFORM CARD_ABLE(3,효과後強制誘発)
PRINTL ⑥：③의 효과 사용시、암용독정제함이 관리하는 『상자』가 필드에 나타나 암컷 몬스터에 대해 발동한다、
PRINTL 『상자』의 구멍에서 뿜어져나오는 미독이 섞인 애액을 맞게해、발정시킨다。
CALLFORM CARD_ABLE(4,ターン終了時強制)
PRINTL ④：이 카드에 끼워진 암컷 몬스터는、자신 / 상대턴 종료시에 음독제상에 의해 조교를 받는다。
PRINTL ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊ーー주의ーー＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
PRINTL
RESETCOLOR
CALL TEXT_DECORATION("ROGUE")


@CARDCAN_39912(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 효과先
#DIM DYNAMIC 条件달성
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,39912)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,39912)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,39912,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 광서의 기계
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲손패 = 1
	효과範囲상대덱 = 1
	효과条件성별 = 牝性
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
    SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_2(듀얼리스트,39912)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 효과後強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과条件성별 = 牝性
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"소환全般",1)
	SIF RESULT != 1
		RETURN 0
	효과先 = FINAL_SUMMON_TARGET(듀얼리스트,1)
	SIF GETVAR(@"%対面者%_MZ_モ耐:효과先") > 0
		RETURN 0
	RETURN 1

ELSEIF 종류 == ターン終了時強制
	SIF ゾーン != "필드"
		RETURN 0
	SIF	GETVAR(@"%듀얼리스트%_MZ_汎数:場所") > 0
		RETURN 1
	SIF	GETVAR(@"%듀얼리스트%_MZ_変化元ID:場所") >= 0
		RETURN 1
	RETURN 1


ENDIF

@CARDEFFECT_39912(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 捕縛대상
#DIM DYNAMIC 捕縛場所,紙束最大値
#DIM DYNAMIC 捕縛場所B
#DIM DYNAMIC 捕縛候補,紙束最大値
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 절정횟수
#DIM DYNAMIC 묘지送り位置

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39912,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲덱 = 1
		효과範囲상대덱 = 1
		효과条件성별 = 牝性
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			選択カードID = RESULT:1
			CALL FULLRESET
			효과추가종류 = 1000000 + 選択カードID
			CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
CALL CARD_EROTICS(選択カードID)
			IF RESULT != -1
				조교대상 = RESULT
				SETCOLOR C_PINK
				SELECTCASE RAND:3
					CASE 0 
					PRINTFORML
					PRINTFORMW 引きずり出された%CALLNAME:조교대상%は、まんぐり返し체위で自身の肉体がぴったり隙間なく収まる『箱』に収納させられてしまう、
					PRINTFORML 身をよじり、動かすことも一切できない『箱』に、尻と両穴だけを노출させられた姿で拘束された%CALLNAME:조교대상%は
					PRINTFORML 閉じた『箱』を開かないようにする拘束具の役割を持つ外装に取り付けられた淫具による加工を受ける事となる……
					PRINTFORMW 
					CASE 1
					PRINTFORML
					PRINTFORML 捕らわれた%CALLNAME:조교대상%が目にした自身を収納しようとする『箱』の内側は牝を犯すためだけの物であった、
					PRINTFORMW 媚毒を肉体に注入する針が無数にあり、肌が접촉する表面にはびっしりと蠢く肉肉しいヒダが貼られてもおり、
					PRINTFORMW 胸・尻・おまんこは『箱』外部へ노출するようになっているが、『箱』を覆う外装に、노출した部位を犯すための淫具が供えられていた。
					PRINTFORML %CALLNAME:조교대상%は抵抗も許されないまま、その『箱』に収納され、穴として扱われてしまう……
					PRINTFORMW
					CASE 2
					PRINTFORML
					PRINTFORMW 引きずり出された%CALLNAME:조교대상%は、광서의 기계たちが用意した『箱』に収められ、身動き１つとる事も出来なくなってしまった、
					PRINTFORML 体の各所に刺された針から注入される淫毒によって、%CALLNAME:조교대상%の体液をその淫毒を造るための物へと変えていき
					PRINTFORMW 全身を肉ヒダで擦られ淫毒を肌から吸収させながら肌に空気が触れるだけでイけるように加工していっている。
					PRINTFORMW 口・おまんこ・尻穴には人には使うべきではないであろう형태や機構を持った淫具が삽입されピストン運動を繰り返す。
					PRINTFORML それらの責め苦によって絶え間なく嬲られる%CALLNAME:조교대상%の声は外に漏れることなく、ただ愛液を垂れ流す『箱』の穴としての役割を果たさせられる……
					PRINTFORMW
				ENDSELECT
				CALL MADORGASM_RAND_ROB_TXT(1,6)
				CALL MADORGASM_RAND_ROB_TXT(1,4)
				CALL EROTIC_MOVE("묘상捕縛",조교대상,-1,200)
				SELECTCASE RAND:2
					CASE 0 
					SELECTCASE RAND:6
						CASE 0 
						PRINTFORML
						PRINTFORML 馬並みの長さのディルドが『箱』の穴に根元まで삽입されては先端の膨らんだコブの部分まで抜かれるのを、
						PRINTFORMW ずんっ”❤ずずっ……ずっ”……どぢゅっ”❤………と子宮を押しつぶしながら繰り返す。
						CASE 1
						PRINTFORML
						PRINTFORML 表面が凹凸とイボまみれのディルドが『箱』の%TEXTR("牝穴/痴肉/愛液製造牝口/牝まんこ/無抵抗の加工用まんこ")%を%TEXTR("膣肉を削り取るかのように激しく/ぽっかりと穴の空いた淫らな蜜穴にしようと/愛液を垂れ流す淫穴に墜とすべく")%、
						PRINTFORMW 『箱』に収められた牝穴の膣肉を耕し、雄のおちんぽ様を包み奉仕するためだけの穴に変えるべく犯しつづけている。
						CASE 2
						PRINTFORML
						PRINTFORML 太く、長く、硬い。魔羅と形容し得るような牝の%TEXTR("牝穴/痴肉/愛液製造牝口/牝まんこ/無抵抗の加工用まんこ")%を犯して壊すためだけのディルドが、『箱』の穴に根元までねじこまれ、
						PRINTFORMW %TEXTR("ずぐっ”❤ずずっ”❤ぶぢっ”❤ぶぢゅっ”❤/ごぢゅ”❤ごっ”❤どぢっ”❤どっ””❤どっ”❤ど”ぢ”ゅ”❤ど”っ❤/どぢゅ”❤どぢゅ”❤どっ”❤どぢ”ゅ❤/ずる～～～－－っ”❤ずっ”❤ずぢゅ”❤/ごづっ”❤ごっ”❤ごぢゅ”❤ごっ”❤")%と、『箱』の穴が子宮の奥まで衝撃を受け突き潰される音が鳴る中、
						CASE 3
						PRINTFORML
						PRINTFORML 中央全体が横に回転する機構を持つ棘まみれのディルドが『箱』の%TEXTR("牝穴/痴肉/愛液製造牝口/牝まんこ/無抵抗の加工用まんこ")%にねじこまれ、
						PRINTFORMW 膣肉にねじこまれたまま回転と振動の運動を『箱』の牝肉へ絶えず与え続け始める。
						PRINTFORMW %TEXTR("ぎゅぶぶぶぶぶっ”❤ぎゅぶぶぶっ”❤/ぎゃるる”る”❤ゅる”❤ぎゅる”❤ぎゅっ”❤/ぢゅぞ”❤ぞっ”❤ぞるっ”❤ぞるるるるっ”❤")%と、機械の駆動音に加え『箱』の穴からは延々と音が鳴る、
						CASE 4
						PRINTFORML
						PRINTFORML 鱗のような返しが表面にびっしりと張り付いたディルドが『箱の』%TEXTR("牝穴/痴肉/愛液製造牝口/牝まんこ/無抵抗の加工用まんこ")%の肉を捲り、膣肉のヒダを剥ぐかのように擦りながら犯し潰す、
						PRINTFORMW %TEXTR("ぞりっ”❤じょり”❤ぞりっ”❤ぞりっ”❤/ぞるる”❤ぞる”❤ぞる”❤ぞっ”❤/ぢゅぞ”❤ぞっ”❤ぞるっ”❤ぞるるるるっ”❤")%と『箱』の穴の肉が擦られ、削られるかのように刺激され愛液をかきだされる音が鳴る、
						CASE 5
						PRINTFORML
						PRINTFORML 各所に凹凸が有りピンク色の光の절정光線を放つ機構を持ったディルドが、『箱』の%TEXTR("牝穴/痴肉/愛液製造牝口/牝まんこ/無抵抗の加工用まんこ")%の奥深くにまで삽입され、作動する、
						PRINTFORMW %TEXTR("ばぢっぢ”❤ばぢっ”❤/ぢっ”❤っっぢぢぢぢ”❤っ”❤ぢっ”/ぢ”－－－っ”❤ぢっ”❤ぢぢぢ”❤")%と、電流が放出されるような音が鳴るたびに『箱』の穴は痙攣を繰り返し절정しているかのような反応をしめす。
					ENDSELECT
					SELECTCASE RAND:5
						CASE 0 
						PRINTFORML 『箱』に収められた%TEXTR("牝穴/痴肉/愛液製造牝口/牝まんこ/無抵抗の加工用まんこ")%からは、
						PRINTFORML %TEXTR("ずぐっ”❤ずずっ”❤ぶぢっ”❤ぶぢゅっ”❤/じゅぷっ”❤じゅるっ”❤じゅっ”❤/ずる～～～－－っ”❤ずっ”❤ずぢゅ”❤")%……と、ディルドによって穴を膣肉を耕され子宮を打ちのめされる音が鳴り続ける……。
						PRINTFORMW
						CASE 1
						PRINTFORML %TEXTR("ずぐっ”❤ずずっ”❤ぶぢっ”❤ぶぢゅっ”❤/どぢゅ”❤どぢゅ”❤どっ”❤どぢ”ゅ❤/ずる～～～－－っ”❤ずっ”❤ずぢゅ”❤/ごづっ”❤ごっ”❤ごぢゅ”❤ごっ”❤")%……と、『箱』の穴からは擦られ愛液をまき散らす音ばかり鳴る……。
