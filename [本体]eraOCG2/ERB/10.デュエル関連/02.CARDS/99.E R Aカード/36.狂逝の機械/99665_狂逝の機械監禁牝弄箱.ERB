@CARDNAME_99665,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 이쿠기어 프리즈너 컨테이너
	CASE "略称"
		RESULTS = 광서 암괴농상
	CASE "カテゴリ"
		RESULTS:0 = 광서의 기계
		RESULTS:1 = E.R.A
ENDSELECT


@CARD_99665(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속함정
ENDSELECT

RETURN 0

@CARD_EXPLANATION_99665(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL
PRINTL 이 카드명의 ①②③의 효과는 각각 1턴에 1번밖에 사용할 수 없다.
CALLFORM CARD_ABLE(1,마함起動)
PRINTL ①: 자신 / 상대 턴에 자신 / 상대 묘지의 암컷 몬스터를 제외하고 발동할 수 있다,
PRINTL 자신 필드 위의 "광서의 기계" 몬스터 1장에게 미약카운터를 2개 놓고, 효과파괴 내성을 부여한다.
CALLFORM CARD_ABLE(2,攻撃時誘発)
PRINTL ②: 상대의 배틀 페이즈중에 "광서의 기계" 몬스터가 전투할 때 발동할 수 있다,
PRINTL 전투를 하는 "광서의 기계" 몬스터에는 미약카운터가 1개 놓이고, 1번만 전투 / 효과로는 파괴되지 않는다.
CALLFORM CARD_ABLE(3,손패起動)
PRINTL ③: 자신 메인 페이즈에 패의 이 카드를 묘지로 보내고 발동할 수 있다,
PRINTL 자신 / 상대의 덱에서 암컷 몬스터를 묘지로 보낸다.
PRINTL 이 효과를 발동한 후, 턴 종료시까지 자신은 "광서의 기계" 몬스터밖에 EX 덱에서 특수 소환할 수 없다.
PRINTL
SETCOLOR C_RED
PRINTL ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊ーー경고ーー＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
CALLFORM CARD_ABLE(1,마함起動)
PRINTL ④：①의 효과로 암컷 몬스터를 제외했을 때、미독정제의 원재료인 암컷구멍의 체액을 채집하기 위해、
PRINTL 제외할 암컷 몬스터에 대해 기계에 의한 능욕을 한 뒤에 제외한다。
CALLFORM CARD_ABLE(4,ターン終了時)
PRINTL ④: 자신의 엔드 페이즈시에 발동할 수 있다.
PRINTL 기계성에 붙잡혀 있는 암컷 구멍들을 범해, 기계를 계속 활성화시키며,
PRINTL 상대 플레이어의 패에 강제력을 가진 패를 넣는다.
PRINTL ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊ーー주의ーー＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
PRINTL
RESETCOLOR
CALL TEXT_DECORATION("ROGUE")


@CARDCAN_99665(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 효과条件플래그 = 0

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,99665)
SIF RESULT == 1
RETURN 0

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 발동済_1(듀얼리스트,99665)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	SIF 발동済_1(듀얼리스트,99665)
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲상대묘지 = 1
	효과条件성별 = 牝性
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 광서의 기계
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃時誘発
	SIF 발동済_2(듀얼리스트,99665)
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	SIF バトルフェイズ != 1
		RETURN 0
	TRYCALLFORM CARDNAME_{戦闘カードID(듀얼리스트)}("カテゴリ")
	SIF RESULTS != "광서의 기계"
		RETURN 0
	RETURN 1

ELSEIF 종류 == 손패起動
	SIF 발동済_3(듀얼리스트,99665)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲상대덱 = 1
	효과条件성별 = 牝性
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == ターン終了時
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	SIF 발동済_4(듀얼리스트,99665)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 마함起動 
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_99665(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 戦闘カードID
#DIM DYNAMIC 효과条件플래그 = 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99665,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲상대묘지 = 1
		효과条件성별 = 牝性
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			選択カード_ID = RESULT:1
			CALL CARD_EROTICS(選択カード_ID)
			IF RESULT != -1
				조교대상 = RESULT
				PRINTFORML
				PRINTFORML %CALLNAME:조교대상%는 광서의 기계에 이끌려、미독을 만들기 위한 "상자"로 가공되어버린다……
				PRINTFORMW
				CALL EROTIC_MOVE("全身凌辱",조교대상,-1,300)
			ENDIF
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件カテゴリ = 광서의 기계
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
			選択カード = RESULT
			IF 選択カード != 9999
				CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"薬Ｃ",2)
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99665,2)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_EROTICS(戦闘場所(듀얼리스트))
		IF RESULT != -1
			조교대상 = RESULT
			PRINTFORML 
			SETCOLOR C_PINK 
			PRINTFORML
			PRINTFORML %CALLNAME:조교대상%는 미독이 쑤셔박아져、육체를 절정과 발광을 반복시켜 강제적으로 활성화시킨다……
			PRINTFORMW
			RESETCOLOR
			CALL EROTIC_MOVE("媚毒汚染",조교대상,-1,500)
		ENDIF
		CALL SET_FIELD_INFO(듀얼리스트,"필드",戦闘場所(듀얼리스트),"薬Ｃ",1)
		CALL STATCHANGE_EFFECT(듀얼리스트,"필드",戦闘場所(듀얼리스트),"一破")
	ENDIF

ELSEIF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99665,3)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件성별 = 牝性
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"덱",ゾーン,場所)
			選択カード_ID = RESULT:1
			CALL CARD_EROTICS(選択カード_ID)
			IF RESULT != -1
				조교대상 = RESULT
				PRINTFORML
				PRINTFORML %CALLNAME:조교대상%는 광서의 기계에게 붙잡혀、미독을 만들기 위할 뿐인 구멍으로 사용되고 버려져버린다……
				PRINTFORMW
				CALL EROTIC_MOVE("全身凌辱",조교대상,-1,300)
			ENDIF
		ENDIF
		CALL CARD_EX_RESTRICTION(듀얼리스트,"광서의 기계")
	ENDIF

ELSEIF 종류 == 마함起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99665)
	IF RESULT == 0
	ENDIF

ELSEIF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,99665)
    	IF RESULT == 0
        	CALL CARD_EROTICS(상대プレイヤー,듀얼리스트)
			조교대상 = RESULT
            IF 조교대상 != -1 && TALENT:조교대상:성별 == 1
				PRINTFORMW 장소에 충만한 음란한 성분을 포함한 증기가 암농상에 채워져、
				PRINTFORMW %CALLNAME:조교대상%의 패에 한 장의 카드를 형성한다……
				SELECTCASE RAND:9
					CASE 0
						CALL CARD_GENERATE_HAND(対面者,79840)
					CASE 1
						CALL CARD_GENERATE_HAND(対面者,79841)
					CASE 2
						CALL CARD_GENERATE_HAND(対面者,79842)
					CASE 3
						CALL CARD_GENERATE_HAND(対面者,79843)
					CASE 4
						CALL CARD_GENERATE_HAND(対面者,79844)
					CASE 5
						CALL CARD_GENERATE_HAND(対面者,79845)
					CASE 6
						CALL CARD_GENERATE_HAND(対面者,79846)
					CASE 7
						CALL CARD_GENERATE_HAND(対面者,79847)
					CASE 8
						CALL CARD_GENERATE_HAND(対面者,79848)
				ENDSELECT
            ENDIF

        ENDIF

ENDIF




