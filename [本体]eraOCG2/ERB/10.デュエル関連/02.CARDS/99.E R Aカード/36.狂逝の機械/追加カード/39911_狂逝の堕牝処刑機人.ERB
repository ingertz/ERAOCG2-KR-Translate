@CARDNAME_39911,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 이쿠기어 스플렌드 버틀러노이드
	CASE "略称"
		RESULTS = 광서의 음형기인
	CASE "カテゴリ"
		RESULTS:0 = 광서의 기계
		RESULTS:1 = E.R.A
ENDSELECT


@CARD_39911(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 1600
	CASE "守備力"
		RETURN 2900
	CASE "성별"
		RETURN 牝性
	CASE "성별"
		RETURN 260101
ENDSELECT
RETURN 0

@CARD_EXPLANATION_39911(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL
PRINTL レベル６以上の「광서의 기계」モンスター＋牝性モンスター２体。
PRINTL このカードは융합소환及び以下の方法でもEX덱から특수소환できる。
CALLFORM CARD_ABLE(1,EX덱起動)
PRINTL 자신フィールドのレベル６以上の「광서의 기계」モンスター１体と、기계족・牝性モンスター2体をリリースした時、このカードをEX덱から특수소환できる。
PRINTL このカード名の①③の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ①：자신・상대メインフェイズに１度、フィールド上のモンスター１体に媚薬카운터を１つ乗せる。
PRINTL この時、媚薬카운터が４つ以上であればそのモンスターを자신・상대の마법・함정ゾーンに置き、
PRINTL 「狂逝の淫罰十字架」として扱う。
CALLFORM CARD_ABLE(3,효과後誘発)
PRINTL ②：상대フィールド上に성별を持つモンスターが특수소환された時に발동できる、
PRINTL そのモンスターの효과を無効にし媚薬카운터を１つ乗せ、ターン終了時まで특수소환のための素材にできない。
CALLFORM CARD_ABLE(4,ターン終了時)
PRINTL ③：자신・상대ターン終了時、자신・상대フィールド・마법함정ゾーンの「狂逝の淫罰磔柱」を묘지に送り발동できる、
PRINTL 덱・손패・묘지から「광서의 기계」モンスターを특수소환する。
PRINTL この효과で특수소환したモンスターは묘지に送ったモンスターとしても扱う
PRINTL
SETCOLOR C_RED
PRINTL ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊ーー警告ーー＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
CALLFORM CARD_ABLE(5,지속효과)
PRINTL ⑤：융합소환したこのカードには、２体目の素材に使用した牝性モンスター１体が組み込まれる。
CALL CARD_ABLE(6,ターン終了時強制)
PRINTL ⑧：자신・상대ターンの終了時、狂逝の淫刑機人に組み込まれている牝は、
PRINTL 感覚共有されている状態で보존されているおまんこの模造品が詰まった箱を使われてしまう。
PRINTL ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊ーー注意ーー＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
PRINTL
RESETCOLOR
CALL TEXT_DECORATION("ROGUE")

@CARDSUMMON_39911(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 3
素材条件素材ID起動 = 2

IF EX参照 == 0 || EX参照 == 1
	CALLFORM 素材条件レベル_ADV(6, "以上")
	素材条件カテゴリ = 광서의 기계
ELSEIF EX参照 >= 10
    素材条件성별 = 牝性
ENDIF

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,39907) 
	RETURN RESULT
ENDIF


@CARDCAN_39911(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 조교대상

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,39911)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
    효과範囲필드 = 1
	효과条件종족 = 기계족
	효과条件성별 = 牝性
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT <= 2
		RETURN 0
	CALL FULLRESET
    효과範囲필드 = 1
	효과条件カテゴリ = 광서의 기계
	CALL 효과条件レベル_ADV(6, "以上")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_2(듀얼리스트,39911)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 효과後誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_3(듀얼리스트,39911)
		RETURN 0
	CALL FULLRESET
	효과条件성별 = 牝性
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환",1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == ターン終了時
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件固名前 = 狂逝の淫罰磔柱
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_表:場所") == 3
		RETURN 0
	RETURN 1

ELSEIF 종류 == ターン終了時強制
	SIF ゾーン != "필드"
		RETURN 0
	SIF	GETVAR(@"%듀얼리스트%_MZ_汎数:場所") > 0
		RETURN 1
	SIF	GETVAR(@"%듀얼리스트%_MZ_変化元ID:場所") >= 0
		RETURN 1
	RETURN 1

ENDIF

@CARDEFFECT_39911(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 戦闘カード
#DIM DYNAMIC 選択カード_場所
#DIM DYNAMIC 破壊カードID
#DIMS DYNAMIC 제외カード名
#DIM DYNAMIC 残り횟수
#DIM DYNAMIC 取込カードID
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39911)
		IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 광서의 기계
		CALL 효과条件レベル_ADV(6, "以上")
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
        CALL FULLRESET
		효과範囲필드 = 1
		효과条件성별 = 牝性
		효과条件종족 = 기계족
		효과条件複数 = 2
        CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				CALL CARD_EX_SUMMON(듀얼리스트,"EX덱",場所)
			ENDIF
		ENDIF

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39911,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"選択")
		IF RESULT == 1
			CALL CARD_SELECT(듀얼리스트,RESULT:1)
			選択カード = RESULT
			CALL CARD_EROTICS(選択カード)
			IF RESULT != -1
				조교대상 = RESULT
				PRINTFORML 
				SETCOLOR C_PINK 
				PRINTFORML %NAME:조교대상%は狂逝の淫刑機人が撃った媚薬注入のための注射器を受け、発情してしまう……
				RESETCOLOR
				CALL EROTIC_MOVE("媚毒汚染",조교대상,-1,500)
			ENDIF
			CALL SET_FIELD_INFO(対面者,"필드",選択カード,"薬Ｃ",1)
			カウンタ = GETVAR(@"%対面者%_MZ_薬Ｃ:選択カード")
			IF カウンタ >= 4
				CALL CARD_RECONSTRUCT(対面者,"필드",選択カード,139911)
				CALL CARD_REMOVAL_BASIC(듀얼리스트,"自動処理",選択カード,"마함")
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39911,3)
	IF RESULT == 0
		CALL FULLRESET
		選択カード = FINAL_SUMMON_TARGET(듀얼리스트,1)
		CALL SET_FIELD_INFO(対面者,"필드",選択カード,"無効",2,1)
		CALL SET_FIELD_INFO(対面者,"필드",選択カード,"薬Ｃ",1)
		CALL SET_FIELD_INFO(対面者,"필드",選択カード,"不材",1)
    ENDIF

ELSEIF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39911,4)
    	IF RESULT == 0
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲마함 = 1
			효과範囲상대필드 = 1
			효과範囲상대마함 = 1
			효과条件固名前 = 狂逝の淫罰磔柱
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲손패 = 1
				효과範囲덱 = 1
				효과範囲묘지 = 1
				효과条件カテゴリ= 광서의 기계
				CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
        ENDIF


ELSEIF 종류 == 지속효과
	IF GETVAR(@"%듀얼리스트%_MZ_汎数:場所") > 0
		;汎数読み込み
		取込カードID = GETVAR(@"%듀얼리스트%_MZ_汎数:場所")
		;記録した素材の성별をチェック
		TRYCALLFORM CARD_{取込カードID}("성별")
		;♀かふたなりなら続行
		選択カード = NO_TO_CHARANUM(取込カードID)
		IF 選択カード >= 1 && オプション_성별
			RESULT = TALENT:選択カード:성별
		ENDIF
		IF GETBIT(RESULT,0)
			;変化元IDに汎数を打ち込み
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"変化元ID",取込カードID,上書きモード)
			;フレーバー、캐릭터リスト読み込み
			CALL CARD_EROTICS(取込カードID)
			IF RESULT != -1
				조교대상 = RESULT
					SELECTCASE RAND:3
						CASE 0
						PRINTFORMW 堕牝処刑機人として造り変えられる前準備として、%CALLNAME:조교대상%は全身を犯す尽くすための機械に張り付かれてしまう。
						PRINTFORMW 性器を削り壊すためのドリルバイブやシリコンチェーンソー、子宮を叩き潰すための数々の形状のディルド、頭を囲うように取り付けられた洗脳装置、
						PRINTFORMW 数々の牝を壊し尽くすためだけに考えられた조교のための機器に、%CALLNAME:조교대상%は顔を青ざめさせ恐怖していく……
						CASE 1
						PRINTFORMW 捕らえられた%CALLNAME:조교대상%は、自身に繋がれてしまう광서의 기계に拘束され全身を犯すための機械に組み込まれる、
						PRINTFORMW 一糸纏わぬ姿で両手は背に回され、ガニ股姿勢で挿入を待機させられ、全身は身動き一つできない拘束、
						PRINTFORMW 一切の抵抗を許さない状態にされた挙句、%CALLNAME:조교대상%は機械による蹂躙を受け始める……
						CASE 2
						PRINTFORMW %CALLNAME:조교대상%は광서의 기계の一部として犯されるためだけに組み込まれてしまう、
						PRINTFORMW 様々な牝たちが、喘ぎ、悶え、苦しみ、嬌声をあげ絶頂を繰り返す광서의 기계の動力となった者たちを思い浮かべ、%CALLNAME:조교대상%の表情は青ざめていく
						PRINTFORMW %CALLNAME:조교대상%は자신もそうされてしまうであろう恐怖からもがき逃れようとするが、その人格を無くすための機械が備え付けられてしまう……
					ENDSELECT

					PRINTFORMW %CALLNAME:조교대상%の頭上に取り付けられた洗脳装置も『キィィィィィ…』と音を鳴らしながら動き始める

					FOR カウンタ,0,4
					SELECTCASE RAND:4
						CASE 0
						CALL MADORGASM_BRAINWASHING_TXT(1,0)
						PRINTFORML %CALLNAME:조교대상%は、%CALLNAME:MASTER%のおちんぽ様に適したご奉仕の仕方を脳に直接刻まれる……
						CALL MADORGASM_BRAINWASHING_TXT(1,1)
						CALL EROTIC_MOVE("최면펠라",조교대상,-1,200)
						CASE 1
						CALL MADORGASM_BRAINWASHING_TXT(1,0)
						PRINTFORML %CALLNAME:조교대상%は、無意識に舌を口から出して伸ばし、脳への直接的な情報の提供で%CALLNAME:MASTER%の精液の味を覚えてしまう……
						CALL MADORGASM_BRAINWASHING_TXT(1,2)
						CALL EROTIC_MOVE("최면정음",조교대상,-1,200)
						CASE 2
						CALL MADORGASM_BRAINWASHING_TXT(1,0)
						PRINTFORML %CALLNAME:조교대상%は、無様にかつより淫猥な자위の仕方を脳内に刻まれていく……
						CALL MADORGASM_BRAINWASHING_TXT(1,3)
						CALL EROTIC_MOVE("최면自発자위",조교대상,-1,200)
						CASE 3
						CALL MADORGASM_BRAINWASHING_TXT(1,0)
						PRINTFORML %CALLNAME:조교대상%は%CALLNAME:MASTER%のおちんぽ様が如何に牝を墜とすかという知識を記憶に刻まれる……
						CALL MADORGASM_BRAINWASHING_TXT(1,4)
						CALL EROTIC_MOVE("최면自発기승위",조교대상,-1,200)
					ENDSELECT
					NEXT

					SELECTCASE RAND:3
						CASE 0
						PRINTFORMW %CALLNAME:조교대상%は、機械から解放されると共に%CALLNAME:MASTER%の前で身に纏う衣服を脱ぎ捨て始める。
						PRINTFORMW そして、用意されていたロングスカートのメイド服を自ら纏い、身の丈程はあろうかという戦闘用の義手を装備し、
						PRINTFORMW %CALLNAME:조교대상%は身に纏っていた物を踏みつけながら淑やかに口を開く……
						CASE 1
						PRINTFORMW %CALLNAME:조교대상%は洗脳を終え、機械から解放されると虚ろな目でふらふらと頭を揺らしながら用意された衣服に着替え始める。
						PRINTFORMW %CALLNAME:MASTER%が見ている目の前で、一糸纏わぬ姿となり、犯されやすいよう要所を隠さない下着を身に着け、それを隠すようにメイド服を着る。
						PRINTFORMW そして%CALLNAME:조교대상%は、%CALLNAME:MASTER%に向けてスカートを摘まみ上げながら口を開く、
						CASE 2
						PRINTFORMW 凄惨な洗脳凌辱を受け全身を嬲り物にされた挙句、人格までも書き換えられた%CALLNAME:조교대상%。
						PRINTFORMW 機械に解放され、%CALLNAME:MASTER%の目の前で元々来ていた装いを脱ぎ捨てながら用意されていたメイド服を纏い身の丈ほどある義手を装備し終える。
						PRINTFORMW %CALLNAME:조교대상%は%CALLNAME:MASTER%に向けて頭を下げながら口を開く。
					ENDSELECT
						PRINTFORML
						PRINTFORMW 「『%CALLNAME:조교대상%』はこれより、堕牝処刑機人として%CALLNAME:MASTER%様にお仕えいたします、なんなりとご命令を」
						PRINTFORML
						CALL EROTIC_MOVE("생체파츠",조교대상,-1,200)
			ENDIF
		ENDIF
		;使い終わった汎数を削除
		SIF GETVAR(@"%듀얼리스트%_MZ_汎数:場所") >= 1000
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"汎数",0,上書きモード)
	ENDIF
ENDIF


@CARDNAME_139911,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 광서의 음벌책주
	CASE "略称"
		RESULTS = 광서의 음벌책주
	CASE "カテゴリ"
		RESULTS:0 = 광서의 기계
		RESULTS:1 = E.R.A
ENDSELECT

@CARD_139911(参照先)

#DIMS DYNAMIC 参照先
