@CARDNAME_39910,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 이쿠기어 슬레이브 체인풀 머신
	CASE "略称"
		RESULTS = 광서의 암뢰인기
	CASE "カテゴリ"
		RESULTS:0 = 광서의 기계
		RESULTS:1 = E.R.A
ENDSELECT


@CARD_39910(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 300
	CASE "守備力"
		RETURN 1500
	CASE "성별"
		RETURN 牝性
	CASE "성별"
		RETURN 260101
ENDSELECT
RETURN 0

@CARD_EXPLANATION_39910(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：자신メインフェイズに、손패から발동できる、
PRINTL 자신のフィールド・묘지もしくは상대묘지の牝性モンスターを효과を無効にして자신の場に특수소환する、
PRINTL その後このカードを특수소환したモンスターに装備する。
CALLFORM CARD_ABLE(2,필드起動,마함起動)
PRINTL ②：フィールド・마법함정ゾーンにこのカードが表側표시で存在する時、자신メインフェイズに발동できる
PRINTL 손패・フィールド・마법함정ゾーンのモンスターを素材に융합소환を行う。
CALLFORM CARD_ABLE(3,지속효과)
PRINTL ③：このカードを装備したモンスターは「광서의 기계」として扱う。
PRINTL
SETCOLOR C_RED
PRINTL ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊ーー警告ーー＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
CALLFORM CARD_ABLE(4,ターン終了時強制)
PRINTL ⑤：このカードを装備した牝性モンスターは、자신・상대のターン終了時牽引用の牝牛として洗脳と조교を受ける。
PRINTL ＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊ーー注意ーー＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊
PRINTL
RESETCOLOR
CALL TEXT_DECORATION("ROGUE")





@CARDCAN_39910(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 装備先
#DIMS DYNAMIC 装備者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL 装備판정(듀얼리스트,場所,ゾーン)
装備者 = %RESULTS%
装備先 = RESULT

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,39910)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,39910)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 마함数(듀얼리스트) == 5
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲상대묘지 = 1
	효과条件소환可 = 1
	효과条件성별 = 牝性
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動 || 종류 == 마함起動
	SIF 발동済_2(듀얼리스트,39910)
		RETURN 0
	SIF !GROUPMATCH(ゾーン,"필드","마함")
		RETURN 0
    SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
    CALL FULLRESET
	素材範囲손패 = 1
	素材範囲필드 = 1
	素材範囲마함 = 1
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = 융합
	효과条件カテゴリ = 광서의 기계
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "마함"
		RETURN 0
	SIF 装備先 == 5
		RETURN 0
	RETURN 1

ELSEIF 종류 == ターン終了時強制
	SIF ゾーン != "마함"
		RETURN 0
	SIF 装備先 == 5
		RETURN 0
	SIF GETVAR(@"%装備者%_필드:装備先") == -1
		RETURN 0
	RETURN 1

ENDIF

@CARDEFFECT_39910(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 装備者
#DIM DYNAMIC 装備先
#DIM DYNAMIC 攻撃力판정
#DIM DYNAMIC 설정場所

VARSET 攻撃力판정, -1
VARSET 설정場所, -1

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL 装備판정(듀얼리스트,場所,ゾーン)
装備者 = %RESULTS%
装備先 = RESULT


IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39910,1)
	IF RESULT == 0
		CALL FULLRESET
	    효과範囲묘지 = 1
	    효과範囲상대묘지 = 1
        효과条件성별 = 牝性
		효과추가종류 = 効追無効
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件固定 = カード소환先
			CALLFORM CARD_EQUIP_ADV(듀얼리스트,場所,ゾーン)
			CALL FULLRESET
			CALL CARD_EROTICS_FIELD(装備者,"필드",装備先)
			IF RESULT != -1
				조교대상 = RESULT
				PRINTFORML
				PRINTFORMW %CALLNAME:조교대상%は광서의 기계の武装を運ぶための車両を引く家畜として扱われる……
				PRINTFORML
				CALL EROTIC_MOVE("생체파츠",조교대상,-1,200)
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 필드起動 || 종류 == 마함起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39910,2)
	IF RESULT == 0
		CALL RESETAREA_MAT
		素材範囲손패 = 1
		素材範囲필드 = 1
		素材範囲마함 = 1
		CALL FULLRESET
		효과条件종류 = 융합
		효과条件カテゴリ = 광서의 기계
		효과条件소환可 = 1
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			TRYCALLFORM CARDSUMMON_{GETVAR(@"%듀얼리스트%_EX덱:{選択カード}")}(듀얼리스트,選択カード)
			CALL FUSSUMMON(듀얼리스트,選択カード)
		ENDIF
	ENDIF

ELSEIF 종류 == 지속효과
    CALL CARD_SET_CATEGORY(듀얼리스트,"필드",装備先,"광서의 기계")

ELSEIF 종류 == ターン終了時強制
	CALL CARD_EROTICS_FIELD(装備者,"필드",装備先)
	IF RESULT != -1
		조교대상 = RESULT
		PRINTFORML
		PRINTFORMW %CALLNAME:조교대상%は牝牛としての洗脳を受け続ける……
		PRINTFORML
		CALL EROTIC_MOVE("생체파츠",조교대상,-1,200)
	ENDIF

ENDIF







