@CARDNAME_59521,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 예점술공주 코인노마
	CASE "略称"
		RESULTS = 예 코인노마
	CASE "カテゴリ"
		RESULTS:0 = 예점술공주
		RESULTS:1 = 점술공주
		RESULTS:3 = E.R.A
ENDSELECT


@CARD_59521(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 800
	CASE "守備力"
		RETURN 1400
	CASE "성별"
		RETURN 牝性
	CASE "分割"
		RETURN 펜듈럼
	CASE "의식代用"
		RETURN 어둠속성

	CASE "추가日"
		RETURN 251109
ENDSELECT
RETURN 0

@CARD_EXPLANATION_59521(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
CALL TEXT_DECORATION("P_MAGIC")
CALL CARD_ABLE(0,손패起動)
PRINTL 
PRINTL 이 카드명의 Ｐ효과는 １턴에 ３번까지 사용할 수 있다。
CALL CARD_ABLE(P3,마함起動)
PRINTL ①：자신 필드에 "예점술공주 코인노마" 이외의 "예점술공주" 몬스터 카드가 존재하는 경우、필드의 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터의 표시 형식에 따라、이하의 효과를 적용한다。필드에 "예점술공주 비블리오무사"가 존재하는 경우、상대 플레이어도 대상으로 할 수 있다。
PRINTL ●뒷면표시：앞면 수비 표시로 변경한다。
PRINTL ●앞면표시：뒷면 수비 표시로 변경한다。
CALL TEXT_DECORATION("P_MAGIC_2")
PRINTL 이 카드명의 ②의 몬스터 효과는 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(0,지속효과)
PRINTL ①：어둠속성의 의식 소환 소재로서 릴리스 될 경우、이 카드 １장으로 의식 소환에 필요한 릴리스 소재로 취급되며、
PRINTL 자신 필드의 이 카드 이외의 "점술공주" 몬스터 카드가 존재하는 한、몬스터 존의 이 카드의 레벨은 ９가 된다。
CALL CARD_ABLE(2,소환時,특수소환時,R素材時효과)
PRINTL ②：이 카드가 소환 / 특수 소환된 경우 또는 의식 소재로서 릴리스 된 경우에 발동할 수 있다。동전을 ３번 던진다。
PRINTL 뒷면이 나온 숫자만큼 상대의 마법＆함정 존의 카드를 골라 원래 주인의 패로 되돌리고、
PRINTL 앞면이 나온 숫자 만큼、상대 플레이어는 뒷면 표시인 부분을 앞면 수비 표시로 한다。
CALL TEXT_DECORATION("ROGUE")

;상대プレイヤーの隠している部分を顕わにするERAテーマ「예점술공주」の基礎的なシステムモンスター。
;표시形式を操作するＰ能力が優秀で、起動효과ではあるものの서로의 モンスターから自由に대상を選べて、かつ表裏を自在に변경できる。１ターンに３回も撃てる。
;とはいえ、발동条件の都合上このＰカードだけをリバーステーマに便利に出張という使い方は難しい。あくまで「예점술공주」で使うことを想定した性能。
;隷ビブリオムーサが居れば、상대プレイヤーを대상にできるというのがERA的に最も重要な部分で、ぼかしているが「パンツ見せ」を強制する효과である。
;이 카드가 出たときのコイントス효과も、表の枚数ぶん「パンツ見せ」を상대プレイヤーにさせる효과である。
;デュエル조교するだけのカードに見えるが、実際その通りである。テーマの展開で余裕があったら貼るカードで、下級なのに展開の最後にサーチするカードである。
;「예점술공주」はリバース誘発を今更つけられない대신에 、色々なものが反転した構造になっている。コイントス효과も裏側から記述しており反転している。
;※Ｐ텍스트とモンスター효과の順序も反転した記述にしようかなと思ったが、思ったより違和感が先に来て読みにくかったのでそれはやめておく。


@CARDSUMMON_AA_59521


@CARDCAN_59521(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성 = 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,59521)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 발동済_P3(듀얼리스트,59521)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과条件カテゴリ = 예점술공주
	효과条件표시 = 表側표시
	효과条件固名前 = 예점술공주 코인노마
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件除去種 = 표시변경
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		条件달성 |= 1
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件표시 = 表側표시
	효과条件名前 = 예점술공주 비블리오무사
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		条件달성 |= 2
	SIF 条件달성 & 1 && 条件달성 & 2
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과条件カテゴリ = 점술공주
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환時 || 종류 == 특수소환時 || 종류 == R素材時효과
	SIF 발동済_2(듀얼리스트,59521)
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_59521(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성 = 0
#DIM DYNAMIC 選択結果 = 1
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 조교강도
#DIM DYNAMIC TEXT番号
#DIM DYNAMIC 表횟수

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59521)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF
ELSEIF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	;이 카드명의 Ｐ효과は１ターンに３度まで 사용할 수 있다。
	IF 발동済_P3(듀얼리스트,59521)
		RETURN 0
	ELSEIF 발동済_P2(듀얼리스트,59521)
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59521,P3)
	ELSEIF 발동済_P1(듀얼리스트,59521)
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59521,P2)
	ELSE
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59521,P1)
	ENDIF
	IF RESULT == 0
		CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
		IF RESULT != -1
			조교대상 = RESULT
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲마함 = 1
			효과範囲상대필드 = 1
			효과範囲상대마함 = 1
			효과条件표시 = 表側표시
			효과条件名前 = 예점술공주 비블리오무사
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1
				IF 듀얼리스트 == "자신"
					PRINTL 상대 플레이어를 표시 형식을 변경할 대상으로 하시겠습니까？
					CALL YN_CHOICE(듀얼리스트)
					選択結果 = RESULT
				ELSE
					;CPUは상대プレイヤーを대상にとる효과를 優先する。
					選択結果 = はい
				ENDIF
			ELSE
				選択結果 = いいえ
			ENDIF
		ELSE
			選択結果 = いいえ
		ENDIF
		
		IF 選択結果 == はい
			;エロ行為
			PRINTFORML 코인노마가 동전을 1개 던져 올리자, 빙글빙글 회전하던 금색 동전은 앞면을 보이며 땅에 떨어졌다.
			PRINTFORMW 앞면이 나왔다는 것은…… %CALLNAME:조교대상%가 거기까지 생각하자 그 눈동자에서 휙 하고 빛이 사라졌다……
			PRINTFORML
			CALL ROSYUTSU_LV_CHECK(조교대상)
			TEXT番号 = RESULT:1 + RAND:25 + 1
			SETCOLOR C_PINK
			CALL BIBLIOMUSE_TEXT_PRINT(59526,TEXT番号)
			WAIT
			PRINTFORML 
			RESETCOLOR
			PRINTFORML 『예점술공주』비블리오무사가 주입한 암시에 완전히 지배된 %CALLNAME:조교대상%는,
			PRINTFORMW 초점이 맞지 않는 공허한 눈동자에 미소를 머금은 표정으로, 대전 상대에게도 잘 보이도록 팬티를 보여주었다……
			;텍스트番号で강도は4段階変動
			IF TEXT番号 >= 90
				조교강도 = 500
			ELSEIF TEXT番号 >= 60
				조교강도 = 300
			ELSEIF TEXT番号 >= 30
				조교강도 = 200
			ELSE
				조교강도 = 150
			ENDIF
			CALL EROTIC_MOVE("최면パンツ晒し", 조교대상, -1, 조교강도)
		ELSE
			;通常の표시변경
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲상대필드 = 1
			CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT != 9999
				CALL CARD_SELECT(듀얼리스트,RESULT)
				IF GETVAR(@"%대상者（CS）%_MZ_表:{選択カード（CS）}") == 3
					CALL SET_FIELD_INFO(대상者（CS）,参照先（CS）,選択カード（CS）,"表",2,1)
				ELSE
					CALL SET_FIELD_INFO(대상者（CS）,参照先（CS）,選択カード（CS）,"表",3,1)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"星",9)
ELSEIF 종류 == 소환時 || 종류 == 특수소환時 || 종류 == R素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59521,2)
	IF RESULT == 0
		;コイントス３回行って、裏の枚数まで상대마함を패로 되돌리고、表の枚数「최면パンツ晒し」をする。
		CALL COIN_TOSS(3)
		表횟수 = RESULT
		
		;裏の枚数まで상대의 마함を패에 戻す。
		IF 表횟수 != 3
			CALL FULLRESET
			효과条件複数 = 97 + 表횟수
			효과条件任意 = 1
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"마함単体",場所,"손패")
		ENDIF
		;表の횟수、상대プレイヤーに「최면パンツ晒し」を行う。
		IF 表횟수 != 0
			CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
			IF RESULT != -1
				조교대상 = RESULT
				
				PRINTFORML 코인노마에 의한 코인 점의 결과,
				PRINTFORMW 앞면이 나온 횟수만큼 상대 플레이어는 숨겨진 부분을 앞면으로 해야만 한다……
				PRINTFORML 
				
				;필드에 隷ビブリオムーサが존재하는 경우、暗示が深くかかることで조교강도が오른다。（笑顔パンツ晒しに変化）
				CALL FULLRESET
				효과範囲필드 = 1
				효과範囲마함 = 1
				효과範囲상대필드 = 1
				효과範囲상대마함 = 1
				효과条件표시 = 表側표시
				효과条件名前 = 예점술공주 비블리오무사
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT == 1
					CALL ROSYUTSU_LV_CHECK(조교대상)
					TEXT番号 = RESULT:1 + RAND:25 + 1
					SETCOLOR C_PINK
					CALL BIBLIOMUSE_TEXT_PRINT(59526,TEXT番号)
					WAIT
					PRINTFORML 
					RESETCOLOR
					PRINTFORML 암시를 걸어 유도하는 비블리오무사의 달콤한 속삭임에 귀가 녹아내린 %CALLNAME:조교대상%는,
					PRINTFORMW 초점이 맞지 않는 공허한 눈동자에 미소를 머금은 표정으로, 대전 상대에게도 잘 보이도록 팬티를 보여주었다……
					;텍스트番号で강도は4段階変動
					IF TEXT番号 >= 90
						조교강도 = 500
					ELSEIF TEXT番号 >= 60
						조교강도 = 300
					ELSEIF TEXT番号 >= 30
						조교강도 = 200
					ELSE
						조교강도 = 150
					ENDIF
				ELSE
					PRINTFORMW 점괘 결과에는 따라야만 한다. 그렇게 암시에 걸린 %CALLNAME:조교대상%는, 공허한 눈으로 팬티를 보여주었다……
					조교강도 = 100
				ENDIF
				
				FOR カウンタ,0,表횟수
					CALL EROTIC_MOVE("최면パンツ晒し", 조교대상, -1, 조교강도)
				NEXT
			ENDIF
		ENDIF
	ENDIF
ENDIF

