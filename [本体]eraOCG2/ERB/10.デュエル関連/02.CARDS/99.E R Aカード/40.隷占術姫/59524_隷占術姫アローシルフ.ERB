@CARDNAME_59524,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 예점술공주 애로우 실프
	CASE "略称"
		RESULTS = 예 애로우 실프
	CASE "カテゴリ"
		RESULTS:0 = 예점술공주
		RESULTS:1 = 점술공주
		RESULTS:3 = E.R.A
ENDSELECT


@CARD_59524(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 1000
	CASE "守備力"
		RETURN 2400
	CASE "성별"
		RETURN 牝性
	CASE "分割"
		RETURN 펜듈럼

	CASE "추가日"
		RETURN 251109
ENDSELECT
RETURN 0

@CARD_EXPLANATION_59524(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
CALL TEXT_DECORATION("P_MAGIC")
CALL CARD_ABLE(0,손패起動)
PRINTL 
PRINTL 이 카드명의 ②의 Ｐ효과는 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(0,지속효과)
PRINTL ①：상대 필드에 "예점술공주 비블리오무사" 이외의 앞면 표시 몬스터가 존재하지 않고、이 카드가 마법＆함정존에 존재하는 한、
PRINTL 자신 필드의 "점술공주" 몬스터는 직접 공격을 얻는다。
CALL CARD_ABLE(P2,마함起動)
PRINTL ②：자신의 패 / ＥＸ덱（앞면 표시）의 "점술공주" 몬스터 １장을 특수 소환한다。그 후、자신의 몬스터 존에 앞면 표시인
PRINTL 레벨９ "점술공주" 몬스터가 존재하는 경우、상대의 메인 덱 가장 위의 카드를 확인하고、그 카드를 덱가장 아래에 놓을 수 있다。
;PRINTL 필드에 「예점술공주 비블리오무사」が존재하는 경우、상대プレイヤーの裏側수비 표시인 部分も確認する。
CALL TEXT_DECORATION("P_MAGIC_2")
PRINTL 이 카드명의 ①의 몬스터 효과는 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,소환時,특수소환時,R素材時효과)
PRINTL ①：이 카드가 소환 / 특수 소환된 경우 또는 의식 소재로서 릴리스 된 경우에 발동할 수 있다。
PRINTL 자신의 덱에서 "예점술공주" Ｐ몬스터 １장을 ＥＸ덱에 앞면으로 넣는다。
PRINTL 그 후、필드 / ＥＸ덱（앞면 표시）의 "예점술공주 애로우 실프" １장을 마법＆함정 존에 놓을 수 있다。
CALL TEXT_DECORATION("ROGUE")

;最上級の「예점술공주」Ｐ몬스터의 １体。もともとはレベル４で、レベル５のＣウンディーネと一緒に의식素材になるモンスターだったが、
;現代유희왕で덱などから送れない２장素材の의식소환は流石に暢気すぎるので、レベル９にして１枚で점술공주의식ができるように설정。
;
;점술공주Ｐ몬스터의 共通효과でNS・SS・의식素材の발동条件で、自身をＰゾーンに置きつつ덱에서 몬스터를 EX덱に送れる。
;Ｐ효과もようやくＰ소환に相当する특수소환효과になっており、スタンダードな現代유희왕展開の윤활油的な役割のＰカードといった立ち位置。
;지속효과で直接攻撃ができるようになるため、상대에게 送りつけた隷ビブリオムーサを除去しなくても전투로 ライフカットに行ける。
;
;Ｐ소환のおまけ효과가 そこそこ強烈で、これは상대의 덱トップを１枚ピーピングして、任意に덱トップか덱ボトムに置く효과。
;いわゆるMTGにおける「消術」のキーワード能力に相当する효과で、英語では「Fateseal」運命封じという意味合いで「悪の占術」のイメージなのだとか。
;「점술공주」なら当然MTGにおける「占術」효과であるべきだが、ERAテーマでモチーフを反転させているので「消術」のほうが雰囲気が出ていいだろう。
;※MTGのトップデザイナーは「消術」を「全く楽しくないメカニズム」と断じている。ごもっともなご意見。


@CARDSUMMON_AA_59524


@CARDCAN_59524(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,59524)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 발동済_P2(듀얼리스트,59524)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲EX덱 = 1
	효과条件カテゴリ = 점술공주
	효과条件종류 = EX以外全般
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件固名前 = 예점술공주 비블리오무사
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환時 || 종류 == 특수소환時 || 종류 == R素材時효과
	SIF 발동済_1(듀얼리스트,59524)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 예점술공주
	효과条件종류 = モン全般
	효과条件分割 = 펜듈럼
	효과条件行先플래그 = EX덱行き
	효과条件うらら解除 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_59524(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 조교강도
#DIM DYNAMIC 条件달성
#DIM DYNAMIC TEXT番号

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59524)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF
ELSEIF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59524,P2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲EX덱 = 1
		효과条件カテゴリ = 점술공주
		효과条件종류 = EX以外全般
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 0
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件レベル = 9
			효과条件カテゴリ = 점술공주
			효과条件종류 = モン全般
			효과条件표시 = 表側표시
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1
				;상대의 メイン덱の덱トップを確認し、任意で덱ボトムに送る処理。
				PRINTFORML 상대의 덱탑 카드를 확인하고 있습니다。
				PRINTFORML 덱 바텀으로 보낼 경우엔 카드를 선택해주세요。（보낼 필요가 없는 경우엔 [9999] - 돌아간다 를 선택해주세요。）
				PRINTL 
				CALL FULLRESET
				효과条件行先플래그 = 소멸行き
				효과条件山切り無し = 1
				효과条件任意 = 1
				CALL CARD_ADD_GY_BASIC(듀얼리스트,"상대덱",ゾーン,場所,1)
				IF RESULT != 0
					選択カードID = RESULT:1
					CALL CARD_GENERATE_DECK(対面者,選択カードID)
				ENDIF
				;エロ효과処理
				;필드에 隷ビブリオムーサが존재하는 경우、暗示をかけて상대プレイヤーの裏側部分を確認できる。
				CALL FULLRESET
				효과範囲필드 = 1
				효과範囲마함 = 1
				효과範囲상대필드 = 1
				효과範囲상대마함 = 1
				효과条件표시 = 表側표시
				효과条件名前 = 예점술공주 비블리오무사
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT == 1
					CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
					IF RESULT != -1
						조교대상 = RESULT
						
						PRINTFORML 애로우 실프의 효과로 덱탑을 확인할 때에는、
						PRINTFORMW 상대 플레이어도 숨겨진 부분을 공개해야 한다……
						PRINTFORML 
						CALL ROSYUTSU_LV_CHECK(조교대상)
						TEXT番号 = RESULT:1 + RAND:25 + 1
						SETCOLOR C_PINK
						CALL BIBLIOMUSE_TEXT_PRINT(59526,TEXT番号)
						WAIT
						PRINTFORML 
						RESETCOLOR
						PRINTFORML 비블리오무사의 암시에 의해, 초점이 맞지 않는 공허한 눈의 %CALLNAME:조교대상%는,
						PRINTFORMW %CALLNAME:MASTER%가 덱을 확인하는 동안, 미소를 띤 표정으로 옷을 내려 팬티를 계속 보여주었다……
						;텍스트番号で강도は4段階変動
						IF TEXT番号 >= 90
							조교강도 = 500
						ELSEIF TEXT番号 >= 60
							조교강도 = 300
						ELSEIF TEXT番号 >= 30
							조교강도 = 200
						ELSE
							조교강도 = 150
						ENDIF
						CALL EROTIC_MOVE("최면パンツ晒し", 조교대상, -1, 조교강도)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件カテゴリ = 점술공주
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"直攻")
ELSEIF 종류 == 소환時 || 종류 == 특수소환時 || 종류 == R素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59524,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 예점술공주
		효과条件종류 = モン全般
		효과条件分割 = 펜듈럼
		효과条件行先플래그 = EX덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 0 && 마함数(듀얼리스트) <= 4
			;
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲EX덱 = 1
			효과条件名前 = 예점술공주 애로우 실프
			효과条件任意 = 1
			CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"表側표시")
		ENDIF
	ENDIF
ENDIF


