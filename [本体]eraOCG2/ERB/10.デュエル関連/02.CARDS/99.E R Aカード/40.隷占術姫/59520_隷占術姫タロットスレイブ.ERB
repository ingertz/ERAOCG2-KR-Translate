@CARDNAME_59520,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 예점술공주 타로슬레이브
	CASE "略称"
		RESULTS = 타로슬레이브
	CASE "カテゴリ"
		RESULTS:0 = 예점술공주
		RESULTS:1 = 점술공주
		RESULTS:3 = E.R.A
ENDSELECT


@CARD_59520(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 1000
	CASE "守備力"
		RETURN 2900
	CASE "성별"
		RETURN 牝性
		
	CASE "추가日"
		RETURN 251109
ENDSELECT

RETURN 0

@CARDSUMMON_59520(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件종족 = 천사족
素材条件レベル = 9

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,59520) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_59520(종류)
#DIM DYNAMIC 종류


CALL TEXT_DECORATION("ROGUE")
PRINTL 천사족 레벨９ 몬스터×２
CALLFORM CARD_ABLE(1,EX덱起動)
PRINTL "예점술공주 타로슬레이브"는 １턴에 １번、
PRINTL 자신 필드의 뒷면 수비 표시인 "점술공주" 의식 몬스터 １장 위에 겹쳐서 Ｘ소환할 수 있다。
CALLFORM CARD_ABLE(0,EX소환時強制,특수소환時強制)
PRINTL ①：이 카드가 특수 소환된 경우에 발동한다。필드의 뒷면 수비 표시인 몬스터를 전부 앞면 수비 표시로 한다。
PRINTL 그 후、필드에 "예점술공주 비블리오무사" 가 앞면 표시로 존재하는 경우、상대 플레이어의 뒷면 수비 표시도 앞면 수비 표시로 한다。
CALLFORM CARD_ABLE(10,ターン開始時)
PRINTL ②：１턴에 １번、턴 개시시에 Ｘ소재를 １개 제거하고 발동할 수 있다。
PRINTL 상대 플레이어를 앞면 앞면 수비 표시로 하고 패를 확인하여、그 안에서 １장을 골라 덱으로 되돌린다。
CALLFORM CARD_ABLE(3,발동誘発)
PRINTL ③：필드에 "예점술공주 비블리오무사"가 앞면 표시로 존재하는 상태에서 、자신이 "점술공주" 의식 마법 카드 및
PRINTL "점술공주" 몬스터 카드의 효과를 발동했을 때에 발동할 수 있다。상대 플레이어는 앞면 공격 표시가 되어 자신에게 공격을 하지 않으면 안된다。
PRINTL "예점술공주 타로슬레이브"의 효과는、１턴에 １０번까지 사용할 수 있다。
CALL TEXT_DECORATION("ROGUE")

;「예점술공주」の着地点となる邪悪なE.R.Aのエースモンスター。もともと「점술공주」は由緒正しい의식テーマであるのだが、
;레벨９몬스터를 並べやすいというテーマの特徴を加味すると、의식素材に使えないランク９のＸ体をゴールにすれば
;テーマの全体的な流れとして綺麗に収まるので、엑시즈体をERAテーマ版の「예점술공주」展開の到達点に설정することにした。
;ARC-Vのテーマなので펜듈럼化は良いとして、スタンダード次元の「점술공주」が엑시즈を使うのは悩ましいところではある。
;
;의식テーマに、펜듈럼と엑시즈と표시변경の３要素を突っ込んでおり、テーマとしての複雑さは飛躍的に上昇している。
;展開ルート自体はほぼ固定なため一回覚えればスムーズに動かせると思うが、デュエル조교目的でこんな面倒な展開を覚えたいかは知らない。
;だが簡単展開で의식を出せるようにすると、덱의식や１枚で２～３枚をサーチリクルートしたりするしかないので、ある程度の複雑化は避けられない。
;
;상대 필드에 隷ビブリオムーサを置きつつこいつを出せれば、後は凄まじい勢いで③の발동誘発でデュエル조교ができる。
;１턴에 １０度とかいうふざけきった텍스트にもしており、もう好きなだけデュエル조교효과를 使用してくれという感じ。
;表側攻撃표시になって自身に攻撃というのは「노출자위」を指している。羞恥と자위경험を稼げるデュエル조교テーマという位置づけ。
;조교としては「최면パンツ晒し」と「최면자위」の２つを実行している。他のパンツ見せる系統はすべて「최면パンツ晒し」である。
;
;デュエル조교に紛れてしれっと書いているが、②の손패確認して１枚ハンデスは割と凄い。やってることは「強引な番兵」と同じ。
;なので汎用で使いにくいよう正規Ｘ条件には종족지정を入れて、상대ターンまで필드에 置いておく必要があるようにもしている。
;これはもとのOCGの「점술공주」では「禁忌の壺」のリバース時のハンデス효과를 フリチェで使うことができるため、そこから引用している。
;「점술공주」といえばイタチや番犬をリバースしてロックかけるイメージだが、個人的には禁忌の壺や엑스크롤러を愛用していたのでそっちに寄せている。
;占いやミエルちゃん自体に「見通す」イメージがあるので、ピーピング효과를 駆使して情報アドで対応する戦い方ができるテーマに仕上げている。


;<ゆるふわ妄想>
;			PRINTFORMW 「ミエルは裏側守備표시になった「점술공주」의식몬스터 １장でオーバーレイネットワークを構築するわ……
;			PRINTFORMW 　運命に隷する禁忌の巫女よ。まどろみより目覚めて愚者を導かん……降臨せよ！　ランク９、예점술공주 타로슬레이브！」

;			PRINTFORMW 「예점술공주 타로슬레이브의 효과를 발동するわ！　ターン開始時に自身のオーバーレイユニットを１つ使い、
;			PRINTFORMW 　カード名を１つ宣言する。그 카드가 상대의 패에 ある場合、상대는 그 카드를 덱に戻さなければならない！」
;			PRINTFORMW 　『透視能力でもあるのかよ……』『おまえミエルちゃんの占いの的中率知らないのかよ』『一滴で終わりじゃね？』
;			PRINTFORMW 　「……あなたの패의 一番右のカード『サンダー・ボルト』ね。그 카드를 덱に戻しなさい」
;			PRINTFORMW 　『マジかよ位置まで見えてるじゃん』『エスパー絽場みたいなイカサマじゃねえの？』『これ後攻で何すんの？』


@CARDCAN_59520(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,59520)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF 발동済_1(듀얼리스트,59520)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,59520)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = 의식
	효과条件カテゴリ = 점술공주
	효과条件표시 = 裏側표시
	효과条件重ねてＸ = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == EX소환時強制 || 종류 == 특수소환時強制
	RETURN 1
ELSEIF 종류 == ターン開始時
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF 발동済_3(듀얼리스트,59520)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件名前 = 예점술공주 비블리오무사
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과条件カテゴリ = 점술공주
	효과条件종류 = モン全般
	효과条件他所 = 1
	효과条件スーパーカテゴリ = 점술공주
	효과条件スーパー종류 = 通常마법
	CALL CARD_CHECK_START_DATA(듀얼리스트)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_59520(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 조교강도
#DIM DYNAMIC TEXT番号
#DIM DYNAMIC 추가효과플래그 = 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59520,1)
	IF RESULT == 0
		;뒷면 수비 표시 몬스터의 重ねて엑시즈。参考：ゴーストリック・アルカード
		CALL RESETCONDITION_MAT
		必要素材数 = 1
		素材条件カテゴリ = 仮置き
		素材条件スーパー종류 = 의식
		素材条件スーパーカテゴリ = 점술공주
		素材条件スーパー표시 = 裏側守備표시
		重ねてＸ = 1
		TRYCALLFORM XYZSUMMON(듀얼리스트,場所)
	ENDIF
ELSEIF 종류 == EX소환時強制 || 종류 == 특수소환時強制
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59520)
	IF RESULT == 0
		;필드의 裏側→表側に
		CALL FULLRESET
		효과条件표시 = 裏側표시
		효과추가종류 = 2
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"両필드全体",場所,"표시변경")
		;그 후、隷ビブリオムーサが居れば추가효과
		;（卑劣なE.R.Aカードなので、↑の処理の成功失敗は見ない：たとえ표시변경された카드가 なくても後続のエロ효과를 実行してくれる）
		
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과条件名前 = 예점술공주 비블리오무사
		효과条件표시 = 表側표시
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			;エロ효과
			CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
			IF RESULT != -1
				조교대상 = RESULT
				PRINTFORML 『예점술공주 타로슬레이브』가 강림한 여파로, 필드의 몬스터 카드가 뒤집혀간다!
				PRINTFORMW 감춰져 있던 몬스터가 공개되는 모습을 본 %CALLNAME:조교대상%에게, 비블리오무사가 상냥하게 귓속말을 건넸다……
				PRINTFORML 
				;필드에 隷ビブリオムーサが存在する前提なのでチェック不要でメッセージを표시する판정に
				CALL ROSYUTSU_LV_CHECK(조교대상)
				TEXT番号 = RESULT:1 + RAND:25 + 1
				SETCOLOR C_PINK
				CALL BIBLIOMUSE_TEXT_PRINT(59526,TEXT番号)
				WAIT
				PRINTFORML 
				RESETCOLOR
				PRINTFORML 비블리오무사의 달콤한 속삭임에 귀가 녹아내린 %CALLNAME:조교대상%는,
				PRINTFORMW 자신도 앞면 표시가 되어야 한다는 암시에 걸려, 옷을 풀어헤치고 대전 상대에게 비밀스러운 부위를 드러냈다……
				
				;텍스트番号で강도は4段階変動
				IF TEXT番号 >= 90
					조교강도 = 500
				ELSEIF TEXT番号 >= 60
					조교강도 = 300
				ELSEIF TEXT番号 >= 30
					조교강도 = 200
				ELSE
					조교강도 = 150
				ENDIF
				
				CALL EROTIC_MOVE("최면パンツ晒し", 조교대상, -1, 조교강도)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == ターン開始時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59520,10,X消費1)
	IF RESULT == 0
		;強引な番兵
		CALL FULLRESET
		효과範囲상대손패 = 1
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		SIF RESULT == 1
			;エロ효과（身体のシャッフル）
			CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
			IF RESULT != -1
				조교대상 = RESULT
				
				PRINTFORML 타로슬레이브의 효과로 패를 확인하게 될 때에는,
				PRINTFORMW 상대 플레이어는 숨겨진 부분을 전부 드러내어 공개해야만 한다……
				
				CALL FULLRESET
				효과範囲필드 = 1
				효과範囲마함 = 1
				효과範囲상대필드 = 1
				효과範囲상대마함 = 1
				효과条件名前 = 예점술공주 비블리오무사
				효과条件표시 = 表側표시
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT == 1
					추가효과플래그 = 1
					PRINTFORML 『예점술공주 타로슬레이브』와 『예점술공주 비블리오무사』가 옅은 미소를 띠며 사냥감에게 다가가자,
					PRINTFORMW 이미 운명의 포로로 타락한 %CALLNAME:조교대상%는, 의지의 빛이 사라진 눈동자를 이쪽으로 향하며, 저항 없이 패를 공개했다.
					PRINTFORML 
					CALL ROSYUTSU_LV_CHECK(조교대상)
					TEXT番号 = RESULT:1 + RAND:25 + 1
					SETCOLOR C_PINK
					CALL BIBLIOMUSE_TEXT_PRINT(59526,TEXT番号)
					WAIT
					PRINTFORML 
					RESETCOLOR
					PRINTFORML 『예점술공주』들이, "공개해야 하는 것은 패뿐만이 아니다"라고 암시를 걸어간다……
					PRINTFORMW %CALLNAME:조교대상%는, 그 암시의 이끌림에 따라, 텅 빈 눈동자로 옷을 내려 비밀스러운 부위를 드러내 보였다……
				
					;텍스트番号で강도は4段階変動（タロットスレイブのメイン효과なので他よりも強めの조교강도の설정）
					IF TEXT番号 >= 90
						조교강도 = 1200
						추가효과플래그 = 2
					ELSEIF TEXT番号 >= 60
						조교강도 = 800
					ELSEIF TEXT番号 >= 30
						조교강도 = 500
					ELSE
						조교강도 = 300
					ENDIF
				ELSE
					PRINTFORMW 점의 결과에는 따라야만 한다. 그렇게 암시에 걸린 %CALLNAME:조교대상%는, 텅 빈 눈으로 팬티를 보여주었다……
					조교강도 = 150
				ENDIF
				CALL EROTIC_MOVE("최면パンツ晒し", 조교대상, -1, 조교강도)
				;ノーマル자위、C자위、B자위の３종류。※V자위、A자위はV,A경험の想定が面倒なので省略
				;隷ビブリオムーサが存在する場合は、추가で자위。
				IF 추가효과플래그 >= 1
					PRINTFORML 드러내고 있는 비밀스러운 부위에 자위를 하도록 암시를 추가할 수는 없을까?
					PRINTFORMW 그 의도를 알아차린 『예점술공주』는 요염한 미소를 이쪽으로 되돌려주고는, 추가로 %CALLNAME:조교대상%에게 암시를 겹쳐 걸었다……
					PRINTFORML 
					EXP:조교대상:조교자위경험 += 1
					SELECTCASE RAND:3
						CASE 0
							CALL EROTIC_MOVE("최면Ｂ자위", 조교대상, -1, 조교강도)
						CASE 1
							CALL EROTIC_MOVE("최면Ｃ자위", 조교대상, -1, 조교강도)
						CASEELSE
							CALL EROTIC_MOVE("최면자위", 조교대상, -1, 조교강도)
					ENDSELECT
				ENDIF
			ENDIF
			
			IF 추가효과플래그 >= 2
				PRINTFORML 덱에 카드를 되돌린 후에 컷과 셔플을 요구해 온 %CALLNAME:조교대상%는, 아직 텅 빈 표정 그대로다.
				PRINTFORMW ……지금이라면, 그 전설의 듀얼리스트만이 할 수 있다는 「몸의 셔플」도 가능하지 않을까?
				PRINTFORML 
				PRINTL [0] - (헤헤, 오늘은 운이 최고로 좋은걸)
				BINPUT
				PRINTFORML 
				PRINTFORMW ・・・
				PRINTFORMW ・・
				PRINTFORMW ・
				조교강도 = 400
				CALL EROTIC_MOVE("全身愛撫", 조교대상, -1, 조교강도)
				
			ENDIF
			
			CALL SHUFFLE(対面者)
			
	ENDIF
ELSEIF 종류 == 발동誘発
	IF GETVAR(@"%듀얼리스트%_MZ_T1汎数:場所") >= 9
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59520,3)
	ELSE
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59520)
	ENDIF
	IF RESULT == 0
		;T1汎数を加算
		CALL FULLRESET
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"T1汎数",1)
		;エロ효과
		CALL CARD_EROTICS(상대プレイヤー, 듀얼리스트)
		IF RESULT != -1
			조교대상 = RESULT
			PRINTFORML 「점술공주」 몬스터의 점치는 행동을 방패 삼아, 『예점술공주 타로슬레이브』와 『예점술공주 비블리오무사』가,
			PRINTFORMW %CALLNAME:조교대상%의 양옆에 살며시 다가서서는, 무방비해진 귀에 달콤한 한숨과 함께 목소리를 불어넣어 간다……
			PRINTFORML 
			;필드에 隷ビブリオムーサが存在する前提なのでチェック不要でメッセージを표시する판정に
			CALL ROSYUTSU_LV_CHECK(조교대상)
			TEXT番号 = RESULT:1 + RAND:25 + 1
			SETCOLOR C_PINK
			CALL BIBLIOMUSE_TEXT_PRINT(59526,TEXT番号)
			WAIT
			PRINTFORML 
			RESETCOLOR
			PRINTFORML 『예점술공주』들의, 태고의 비술이 담긴 속삭임을 정면으로 받아버린 %CALLNAME:조교대상%는,
			PRINTFORMW 그 암시에 전혀 저항하지 못한 채, 옷을 내려 비밀스러운 부위를 드러내고는, 그대로 천천히 스스로를 위로하기 시작했다……
			
			;텍스트番号で강도は4段階変動
			IF TEXT番号 >= 90
				조교강도 = 500
			ELSEIF TEXT番号 >= 60
				조교강도 = 300
			ELSEIF TEXT番号 >= 30
				조교강도 = 200
			ELSE
				조교강도 = 150
			ENDIF
			
			CALL EROTIC_MOVE("최면パンツ晒し", 조교대상, -1, 조교강도)
			;ノーマル자위、C자위、B자위の３종류。※V자위、A자위はV,A경험の想定が面倒なので省略
			EXP:조교대상:조교자위경험 += 1
			SELECTCASE RAND:3
				CASE 0
					CALL EROTIC_MOVE("최면Ｂ자위", 조교대상, -1, 조교강도)
				CASE 1
					CALL EROTIC_MOVE("최면Ｃ자위", 조교대상, -1, 조교강도)
				CASEELSE
					CALL EROTIC_MOVE("최면자위", 조교대상, -1, 조교강도)
			ENDSELECT
		ENDIF
	ENDIF
ENDIF

