@CARDNAME_59783,参照先
;ココで지정 카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 카타르시스터 마르파스
	CASE "略称"
		RESULTS = 마르파스
	CASE "カテゴリ"
		RESULTS:0 = 카타르시스터
		RESULTS:1 = E.R.A
ENDSELECT


@CARD_59783(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 12
	CASE "攻撃力"
		RETURN 3600
	CASE "守備力"
		RETURN 2600
	CASE "성별"
		RETURN 牝性
ENDSELECT
RETURN 0

@CARDSUMMON_59783(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 12

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,59783) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_59783(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL 레벨 12 몬스터×2
PRINTL 이 카드는 자신 필드 / 묘지의 "카타르시스터" S몬스터 2장을 X소재로 하고 EX덱에서 특수 소환할 수 있으며、
PRINTL 자신 필드의 "크라이시스터 마르파"또는 "엑소시스터 카르마엘" 1장 위에 겹쳐 X소환할 수 있다。
PRINTL 이 카드의 효과 발동에 대해 상대는 카드 효과를 발동할 수 없다。
CALL CARD_ABLE(1,필드起動)
PRINTL ①：이 카드의 Ｘ소재를 １개 제거하고 발동할 수 있다。
PRINTL 상대 필드 / 묘지의 몬스터 １장을 소멸시킨다。
PRINTL 이 효과는 내성으로 막을 수 없다。
CALL CARD_ABLE(0,지속효과)
PRINTL ②：이카드는 일반 공격에 더해、
PRINTL 자신의 마법＆함정 존에 존재하는 몬스터로서 특수 소환할 수 있는 "악령" 카드의 수만큼 공격할 수 있다。
CALL CARD_ABLE(3,バトル終了時)
PRINTL ③：배틀 페이즈 종료시에 발동할 수 있다。
PRINTL 이 카드를 EX덱으로 되돌리고、자신의 EX덱 / 묘지에서 "카타르시스터" Ｓ몬스터를 ２장까지 수비 표시로 특수 소환할 수 있다。
CALL TEXT_DECORATION("ROGUE")

@CARDCAN_59783(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,59783)
SIF RESULT == 1
	RETURN 0


IF 종류 == EX덱起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,50865)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 카타르시스터
	효과条件종류 = 싱크로
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件名前:0 = 크라이시스터 마르파
	효과条件名前:1 = 엑소시스터 카르마엘
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과範囲상대묘지 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == バトル終了時
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과範囲묘지 = 1
	효과条件종류 = 싱크로
	효과条件カテゴリ = 카타르시스터
	효과条件소환可 = 2
	효과条件特不無視 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == チェーン可否
	RETURN 1
ENDIF

@CARDEFFECT_59783(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 설정타입
#DIM DYNAMIC 조교대상
#DIM DYNAMIC 攻撃횟수

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59783)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 카타르시스터
		효과条件종류 = 싱크로
		효과条件行先플래그 = 덱行き
		효과条件複数 = 2
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL RESETCONDITION_MAT
			必要素材数 = 1
			素材条件名前:0 = 크라이시스터 마르파
			素材条件名前:1 = 엑소시스터 카르마엘
			효과추가종류:0 = 効追Ｘ素 + 1
			重ねてＸ = 1
			TRYCALLFORM XYZSUMMON(듀얼리스트,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59783,1,X消費1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과範囲상대묘지 = 1
		효과条件行先플래그 = 소멸行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == バトル開始時強制
	CALL FULLRESET
	효과範囲마함 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 악령
	효과条件分割 = 효과なし
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	攻撃횟수 = RESULT
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"追戦",攻撃횟수)
ELSEIF 종류 == バトル終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,59783,3)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,EX덱行き)
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과範囲묘지 = 1
		효과条件종류 = 싱크로
		효과条件カテゴリ = 카타르시스터
		효과条件特不無視 = 1
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"守備표시")
		IF モンスター数(듀얼리스트) < 5
			CALL FULLRESET
			효과範囲EX덱 = 1
			효과範囲묘지 = 1
			효과条件종류 = 싱크로
			효과条件カテゴリ = 카타르시스터
			효과条件特不無視 = 1
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"守備표시")
		ENDIF
	ENDIF
ENDIF

