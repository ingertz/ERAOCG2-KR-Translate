@CARDNAME_79911,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 퍼실리즘의 유혹
	CASE "略称"
		RESULTS = Pha유혹
	CASE "カテゴリ"
		RESULTS:0 = 퍼실리즘
		RESULTS:1 = E.R.A
ENDSELECT


@CARD_79911(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
	CASE "추가日"
		RETURN 251010
ENDSELECT

RETURN 0

@CARD_EXPLANATION_79911(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
PRINTL 자신 필드에 "어신체" 카드가 존재하는 경우、상대는 이 카드의 효과 발동에 대해서 마법 / 함정 / 몬스터의 효과를 발동할 수 없다。
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①："퍼실리즘" 카드 １장을 버리고 발동할 수 있다。암컷 카드 １장을 덱에서 묘지로 보낸다。
PRINTL 그 후、상대는 덱에서 암컷 몬스터 １장을 패에 넣는다。
PRINTL 이 턴、"퍼실리즘" 몬스터에 의해 행해지는 조교의 횟수를 ５회 추가한다。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②：자신 필드에 "어신체" 카드가 존재하는 경우에 묘지에서 이 카드를 제외하고 발동할 수 있다。
PRINTL "퍼실리즘의 유혹" 이외의 제외 상태의 "퍼실리즘" 카드를 １장을 덱에 되돌린다。
PRINTL 그 후、상대의 엑스트라 덱의 암컷 몬스터 ２장을 선택하여 묘지로 보내고、"어신체" 카드에 신앙 카운터를 ２개 놓는다。
CALL TEXT_DECORATION("ROGUE")


@CARDCAN_79911(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 조교대상


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,79911)
SIF RESULT == 1
	RETURN 0
;①のドロー효과
IF 종류 == 마함起動 || 종류 == 손패起動
	;ターン制限あり
	SIF 발동済_1(듀얼리스트,79911)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	;条件を지정して一致するか確認
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件カテゴリ = 퍼실리즘
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所,1281)
	SIF RESULT < 1
		RETURN 0
    ;상대の덱に牝性몬스터가 あるかは確認しない
	RETURN 1
;②の묘지효과
ELSEIF 종류 == 묘지起動
	;ターン制限あり。제외できないなら발동불가
	SIF 발동済_2(듀얼리스트,79911)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	;条件を지정して一致するか確認
	CALL FULLRESET
	효과範囲제외 = 1
    효과条件固名前 = 퍼실리즘의 유혹
	효과条件カテゴリ = 퍼실리즘
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과条件カテゴリ = 어신체
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
;②は条件次第でチェーン불가
ELSEIF 종류 == チェーン可否
	;条件を지정して一致するか確認
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과条件カテゴリ = 어신체
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_79911(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 破壊枚数


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

;①の효과（ドロー）
IF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,79911,1)
	IF RESULT == 0
		;通常마법汎用발동後묘지送り処理
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
        ;うららチェック
        CALL URARA_CHANCE(듀얼리스트,,"덱")
		IF RESULT == 1
			CALL SHUFFLE(듀얼리스트)
			CALL SHUFFLE(対面者)
			RETURN 0
		ENDIF
        ;묘지送り処理
		CALL FULLRESET
		효과条件カテゴリ = 퍼실리즘
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
		IF RESULT == 1
            CALL FULLRESET
            효과条件성별 = 牝性 
            CALL CARD_ADD_GY_BASIC(듀얼리스트,"덱",ゾーン,場所)
        ENDIF
        ;그 후、상대は덱에서 牝性몬스터 １장을 손패に加える
        CALL FULLRESET
		효과範囲덱 = 1
        효과条件종류 = モン全般
		효과条件성별 = 牝性 
		CALL CARD_ADD_BASIC(対面者,"덱",ゾーン,場所)
	ENDIF
;②の효과（除去효과）
ELSEIF 종류 == 묘지起動
	;カード발동確認
	CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,79911,2)
	IF RESULT == 0
        ;제외状態の「퍼실리즘」カードを１枚を덱に戻す
		CALL FULLRESET
		효과範囲제외 = 1
		효과条件カテゴリ = 퍼실리즘
        효과条件固名前 = 퍼실리즘의 유혹
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
        ;그 후、상대のエクストラ덱の牝性モンスター１枚を選んで묘지に送る
        CALL FULLRESET
        효과範囲상대EX덱 = 1
        효과条件성별 = 牝性
        효과条件複数 = 2
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		;카운터を乗せる
		CALL CARD_COUNTER_SYMMETRIA(듀얼리스트,종류,ゾーン,場所,2)
	ENDIF
ENDIF