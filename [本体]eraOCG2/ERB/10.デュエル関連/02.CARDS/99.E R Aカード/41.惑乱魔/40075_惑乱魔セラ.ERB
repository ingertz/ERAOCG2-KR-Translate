@CARDNAME_40075,参照先
;ココで지정卡片の名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 혹란마 세라
	CASE "略称"
		RESULTS = 란 세라
	CASE "カテゴリ"
		RESULTS:0 = 혹란마
		RESULTS:1 = E.R.A
	CASE "検索カテゴリ"
		RESULTS:0 = 꿀구멍
ENDSELECT


@CARD_40075(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 식물족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 400
	CASE "守備力"
		RETURN 2400
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		RETURN 1370
ENDSELECT

RETURN 0

@CARDSUMMON_40075(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 1
素材条件종류 = 링크以外
素材条件カテゴリ:0 = 충혹마
素材条件カテゴリ:1 = 혹란마

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,40075) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_40075(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("ROGUE")
PRINTL 링크 몬스터 이외의 "충혹마" 몬스터 또는 "혹란마" 몬스터 １장
PRINTL 이 카드명의 ①③④의 효과는 각각 １턴에 １번 사용할 수 있다。
CALLFORM CARD_ABLE(1,EX소환時)
PRINTL ①：이 카드가 링크소환에 성공한 경우에 발동할 수 있다。
PRINTL 상대 덱의 몬스터 １장을 골라、상대 필드에 특수 소환한다。그 몬스터에게 이 카드의 벌레 문양을 새긴다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：자신 필드에 이 카드명 이외의 "혹란마" 몬스터가 존재하는 한、이 카드는 공격 대상이 되지 않는다。
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ③：상대가 몬스터를 소환 / 특수 소환한 경우、필드의 이 카드를 릴리스하고 발동할 수 있다。
PRINTL 덱에서 "혹란마" 몬스터 １장을 특수 소환하고、상대 몬스터에게、자신이 특수 소환한 몬스터의 벌레 문양을 새긴다。
CALLFORM CARD_ABLE(3,攻撃後誘発)
PRINTL ④：이 카드가 묘지에 존재하고、
PRINTL 상대 몬스터의 공격으로 데미지 스텝 종료시까지 "혹란마" 몬스터가 필드에서 벗어나지 않았을 경우에 발동할 수 있다。
PRINTL 이 카드를 특수 소환하거나 엑스트라 덱으로 되돌린다。
PRINTL 엑스트라 덱으로 되돌린 경우、덱에서 "함정 속으로" 일반 함정 카드 또는 "꿀구멍" 일반 함정 카드 １장을 자신 필드에 세트할 수 있다。
CALL TEXT_DECORATION("ROGUE")


@CARDCAN_40075(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件达成

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,40075)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX소환時
	SIF 발동済_1(듀얼리스트,40075)
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1

ELSEIF 종류 == 효과後誘発
	;对方把怪兽双召时,从卡组특수召唤혹란마怪兽的效果检测。
	SIF 발동済_2(듀얼리스트,40075)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"소환全般",1)
	SIF RESULT != 1
		RETURN 0

	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = モン全般
	효과条件カテゴリ = 혹란마
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃後誘発
	SIF 발동済_3(듀얼리스트,40075)
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0

  	CALL FULLRESET
	효과条件カテゴリ = 혹란마
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"필드離れ")
	SIF RESULT == 1
		RETURN 0      
	RETURN 1

ENDIF


@CARDEFFECT_40075(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 選択カード,2
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 蟲紋종류
#DIM DYNAMIC 效果先
#DIM DYNAMIC 选择対面選択カード
#DIM DYNAMIC 条件达成,3
#DIM DYNAMIC 조교대상

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,40075,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대덱 = 1
		효과条件종류 = モン全般
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"攻击표시",,1)
		SIF カード소환先 != 5
			;与赋予蟲紋相关的效果
			CALL TRAPSEX_GIVE_FIXED(듀얼리스트,ゾーン,종류,場所,カード소환先,9)
	ENDIF

ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 혹란마
	효과条件표시 = 表側표시
	효과条件固名前 = 혹란마 세라
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"攻避")

ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,40075,2)
	IF RESULT == 0
		效果先 = FINAL_SUMMON_TARGET(듀얼리스트,1)
		조교대상 = GETVAR(@"%対面者%_필드:效果先")

		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)

		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 혹란마
		효과条件종류 = モン全般
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		選択カード_ID = RESULT:1
		IF 選択カード_ID != -1
			;与赋予蟲紋相关的效果
			CALL TRAPSEX_GIVE_OTHER(듀얼리스트,ゾーン,종류,場所,效果先,選択カード_ID)
			CALL SEXTEXT_40075_2_1(듀얼리스트,조교대상)
		ENDIF
	ENDIF
ELSEIF 종류 == 攻撃後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,40075,3)
	IF RESULT == 0
		SIF モンスター数(듀얼리스트) <= 4
			条件达成:0 = 1
		SIF 마함数(듀얼리스트) <= 4
			条件达成:1 = 1
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종류 = モン全般
		효과条件カテゴリ = 혹란마
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件达成:2 = 1

		IF (条件达成:0) == 1
			CALL FULLRESET
			PRINTL 세라를 특수 소환 하시겠습니까、덱으로 되돌리시겠습니까？
			PRINTL [1] - 특수 소환
			PRINTL [2] - EX덱으로 되돌리기
			BINPUT
			IF RESULT == 1
				CALL FULLRESET
				CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
			ELSEIF RESULT == 2
				$TRAPSEX_40075_4
				CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,EX덱行き)
				IF RESULT == 1 && (条件达成:1) == 1 && (条件达成:2) == 1
					CALL FULLRESET
					PRINTL 덱에서 일반 함정 카드 "함정 속으로" 또는 "꿀구멍" １장을 자신 필드에 세트하시겠습니까？
					PRINTL [1] - ★YEAH!★
					PRINTL [2] - NO
					BINPUT
					IF RESULT == 1
						CALL FULLRESET
						효과条件カテゴリ:0 = 함정 속으로
						효과条件カテゴリ:1 = 꿀구멍
						효과条件종류 = 通常함정
						CALL CARD_SET_BASIC(듀얼리스트,"덱",ゾーン,場所,"裏側표시")
					ENDIF
				ENDIF
			ENDIF
		ELSE
			GOTO TRAPSEX_40075_4
		ENDIF
	ENDIF
ENDIF

