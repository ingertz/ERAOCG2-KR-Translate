@CARDNAME_39690,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 만지기머신　조물조물 핸드
	CASE "略称"
		RESULTS = 조물손
	CASE "カテゴリ"
		RESULTS:0 = 만지기머신
		RESULTS:2 = E.R.A
ENDSELECT


@CARD_39690(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 미확인족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 500
	CASE "守備力"
		RETURN 500
	CASE "추가日"
		RETURN 250804
ENDSELECT

RETURN 0

@CARD_EXPLANATION_39690(종류)
#DIM DYNAMIC 종류

CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：이 카드가 몬스터와 전투를 행하는 경우、그 ２장은 그 전투에선 파괴되지 않는다。
CALLFORM CARD_ABLE(10,필드起動,フリー誘発)
PRINTL ②：자신 / 상대턴에 １번、상대 필드의 암컷 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터의 공격력 / 수비력은 ５００내리고、턴 종료시까지 공격할 수 없다。
CALLFORM CARD_ABLE(0,戦破壊→묘지)
PRINTL ③：이 카드가 몬스터 존에서 묘지로 보내진 경우、상대 필드의 암컷 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 이 카드를 그 몬스터에게 장착한다。
CALLFORM CARD_ABLE(0,攻撃時強制誘発)
PRINTL ④：이 카드를 장착하고 있는 상대 몬스터의 공격 선언시에 발동한다。
PRINTL 그 공격을 무효로 한다。


@CARDCAN_39690(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 装備先
#DIMS DYNAMIC 装備者

CALL 装備판정(듀얼리스트,場所,ゾーン)
装備先 = RESULT	
装備者 = %RESULTS%

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,39690)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件성별 = 牝性
	효과条件표시 = 表側표시
	효과条件除去種 = 選択
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 戦破壊→묘지
	SIF ゾーン != "필드"
		RETURN 0
	SIF !GROUPMATCH(묘지送り종류,"戦闘破壊","破壊","リリース")
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件성별 = 牝性
	효과条件표시 = 表側표시
	효과条件除去種 = 選択
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃時強制誘発
	SIF ゾーン != "마함"
		RETURN 0
	SIF 装備者 == 듀얼리스트
		RETURN 0
	SIF 装備先 == 5
		RETURN 0
	SIF 戦闘場所(듀얼리스트,1) != 装備先
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃後強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	IF 戦闘場所(듀얼리스트,1) == 5
		CALL CARD_EROTICS(상대プレイヤー,対面者)
		SIF RESULT == -1
			RETURN 0
	ELSE
		TRYCALLFORM CARD_{戦闘カードID(듀얼리스트,1)}("성별")
		SIF RESULT == 雄性
			RETURN 0
	ENDIF
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트,1) == 5
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	RETURN 1

ELSEIF 종류 == リアクション효과
	SIF ゾーン != "마함"
		RETURN 0
	SIF 装備先 == 5
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_39690(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 装備場所
#DIM DYNAMIC 조교대상
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 装備先
#DIMS DYNAMIC 装備者

CALL 装備판정(듀얼리스트,場所,ゾーン)
装備先 = RESULT	
装備者 = %RESULTS%

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39690,10)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件성별 = 牝性
		효과条件표시 = 表側표시
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"選択")
		IF RESULT == 1
			CALL CARD_SELECT(듀얼리스트,RESULT:1)
			選択カード = 選択カード（CS）
			CALL CARD_EROTICS_FIELD(듀얼리스트,"필드",選択カード,1)
			IF RESULT != -1
				조교대상 = RESULT
				PRINTFORMW 조물조물 핸드는 %CALLNAME:조교대상%에게 날아가, 그 가슴을 주물주물 주물렀다!
				CALL EROTIC_MOVE("Ｂ単発",조교대상,-1,1000)
			ELSE
				TRYCALLFORM CARDNAME_{GETVAR(@"%対面者%_필드:選択カード")}("名前")
				PRINTFORML 조물조물 핸드는 %RESULTS%에게 날아가, 그 가슴을 주물주물 주물렀다!
				PRINTFORMW %RESULTS%는 핸드의 교묘한 애무에 흥분하여, 눈 깜짝할 사이에 절정해버렸다.
			ENDIF
			CALL SET_FIELD_INFO(対面者,"필드",選択カード,"戦無",1,1)
			CALL SET_FIELD_INFO(対面者,"필드",選択カード,"永攻",-500)
			CALL SET_FIELD_INFO(対面者,"필드",選択カード,"永守",-500)
		ENDIF
	ENDIF

ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39690)
	IF RESULT == 0
		CALL FULLRESET
		효과条件名前 = 만지기머신　조물조물 핸드
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"묘지",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과条件성별 = 牝性
			효과条件표시 = 表側표시
			CALLFORM CARD_EQUIP_ADV(듀얼리스트,選択カード,"묘지")
			IF RESULT == 1
				装備場所 = RESULT:2 - 6
				CALL CARD_EROTICS_FIELD(듀얼리스트,"필드",装備場所,1)
				IF RESULT != -1
					조교대상 = RESULT
					PRINTFORMW 조물조물 핸드는 %CALLNAME:조교대상%의 가슴에 달라붙어, 서서히 주무르기 시작했다!
					CALL EROTIC_MOVE("Ｂ単発",조교대상,-1,10)
				ELSE
					TRYCALLFORM CARDNAME_{GETVAR(@"%対面者%_필드:装備場所")}("名前")
					PRINTFORMW 조물조물 핸드는 %RESULTS%의 가슴에 달라붙어, 서서히 주무르기 시작했다!
				ENDIF
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 攻撃時強制誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,39690)
	IF RESULT == 0
		CALL CARD_EROTICS_FIELD(듀얼리스트,"필드",装備先,1)
		IF RESULT != -1
			조교대상 = RESULT
			PRINTFORML %CALLNAME:조교대상%가 움직이기 시작한 순간, 조물조물 핸드가 가슴을 으스러뜨릴 듯이 주물주물 주무르기 시작했다!
			PRINTFORMW %CALLNAME:조교대상%는 가슴에서 터져 나오는 쾌감에 견디지 못하고, 그 자리에 무릎을 꿇고 말았다.
			CALL EROTIC_MOVE("Ｂ単発",조교대상,-1,1000)
		ELSE
			TRYCALLFORM CARDNAME_{GETVAR(@"%対面者%_필드:装備先")}("名前")
			PRINTFORML %RESULTS%가 움직이기 시작한 순간, 조물조물 핸드가 가슴을 으스러뜨릴 듯이 주물주물 주무르기 시작했다!
			PRINTFORMW %RESULTS%는 가슴에서 터져 나오는 쾌감에 견디지 못하고, 그 자리에 무릎을 꿇고 말았다.
		ENDIF
		CALL EVADE_ATTACK(듀얼리스트)
	ENDIF

ELSEIF 종류 == 攻撃後強制誘発
	IF 戦闘場所(듀얼리스트,1) == 5
		CALL CARD_EROTICS(상대プレイヤー,対面者)
		조교대상 = RESULT
		PRINTFORMW %CALLNAME:조교대상%는 가슴을 꽉 주물러졌다!
		CALL EROTIC_MOVE("Ｂ単発",조교대상,-1,200)
	ELSE
		CALL CARD_EROTICS(戦闘カードID(듀얼리스트,1))
		IF RESULT != -1
			조교대상 = RESULT
			PRINTFORMW %CALLNAME:조교대상%는 가슴을 꽉 주물러졌다!
			CALL EROTIC_MOVE("Ｂ単発",조교대상,-1,200)
		ELSE
			TRYCALLFORM CARDNAME_{戦闘カードID(듀얼리스트,1)}("名前")
			PRINTFORMW %RESULTS%는 가슴을 꽉 주물러졌다!
		ENDIF
	ENDIF

ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦耐")
	CALL STATCHANGE_EFFECT(対面者,"自身",戦闘場所(듀얼리스트,1),"戦耐")

ELSEIF 종류 == リアクション효과
	CALL CARD_EROTICS(GETVAR(@"%装備者%_필드:装備先"))
	IF RESULT != -1
		조교대상 = RESULT
		PRINTFORMW %CALLNAME:조교대상%는 끈적한 손길로 가슴을 주물러지고 있다……
		CALL EROTIC_MOVE("Ｂ単発",조교대상,-1,50)
	ENDIF
ENDIF
