@CARDCAN_58067(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,58067)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF メインフェイズ２ == 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_58067(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 다이스目
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 다이스合計,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,58067,10,X消費2)
	IF RESULT == 0
		SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") >= 0
			条件달성 = 1
		REPEAT 2
			CALL DICE_ROLL(듀얼리스트,1)
			다이스目 = RESULT
			IF 条件달성 == 1
				IF 듀얼리스트 == "자신"
					PRINTL 눈을 ７로 하시겠습니까？
					CALL YN_CHOICE(듀얼리스트)
					IF RESULT == 0
						CALL DICE_ROLL_7(다이스目)
						다이스目 = 7
					ENDIF
				ENDIF
			ENDIF
			다이스合計:0 += 다이스目
		REND

		REPEAT 2
			CALL DICE_ROLL(対面者,1)
			다이스目 = RESULT
			IF 条件달성 == 1
				IF 듀얼리스트 == "자신"
					PRINTL 눈을 ７로 하시겠습니까？
					CALL YN_CHOICE(듀얼리스트)
					IF RESULT == 0
						CALL DICE_ROLL_7(다이스目)
						다이스目 = 7
					ENDIF

				ELSEIF 듀얼리스트 != "자신" && RESULT < 5
					다이스目 = 7
				ENDIF
			ENDIF
			다이스合計:1 += 다이스目
		REND

		PRINTFORMW %듀얼리스트%：{다이스合計:0}　　ＶＳ　　%対面者%：{:다이스合計:1}

		IF 다이스合計:0 > 다이스合計:1
			PRINTFORMW %対面者%의 승리！
			CALL SET_PLAYER_INFO(듀얼리스트,"モン효과無効",4)
			CALL SET_PLAYER_INFO(듀얼리스트,"バトルスキップ",1)
		ELSEIF 다이스合計:0 < 다이스合計:1
			PRINTFORMW %듀얼리스트%의 승리！
			CALL SET_PLAYER_INFO(듀얼리스트,"モン효과無効",4,1)
			CALL SET_PLAYER_INFO(듀얼리스트,"バトルスキップ",1,1)
		ELSE
			PRINTW 비김！
		ENDIF
	ENDIF
ENDIF

@DICE_ROLL_7(다이스目)
#DIM DYNAMIC 다이스目

SELECTCASE 다이스目
	CASE 1,6
		PRINTL ┌───┐　┌───┐
		PRINTL │  ＿  │　│●●●│
		PRINTL │＜◎＞│　│　　　│
		PRINTL │  ￣  │　│●●●│
		PRINTL └───┘　└───┘
	CASE 2,5
		PRINTL ┌───┐　┌───┐
		PRINTL │●　　│　│●　●│
		PRINTL │　　　│　│　●　│
		PRINTL │　　●│　│●　●│
		PRINTL └───┘　└───┘
	CASE 3,4
		PRINTL ┌───┐　┌───┐
		PRINTL │●　　│　│●　●│
		PRINTL │　●　│　│　　　│
		PRINTL │　　●│　│●　●│
		PRINTL └───┘　└───┘
ENDSELECT
