@CARDNAME_4429,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 모멸의 재앙 가르미유
	CASE "略称"
		RESULTS = 가르미유
	CASE "カテゴリ"
		RESULTS:0 = 드래곤 클래스
		RESULTS:4 = Shadowverse
ENDSELECT


@CARD_4429(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 1500
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 250909
ENDSELECT

RETURN 0

@CARDSUMMON_4429(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 5

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,4429) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_4429(종류)
#DIM DYNAMIC 종류

PRINTL 레벨５ 몬스터×２
PRINTL 이 카드명의 ①②③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,EX덱起動)
PRINTL ①：이 카드는 ６이상의 코스트를 가진、자신 필드의 드래곤족몬스터 １장을 파괴하고
PRINTL EX덱에서 X소환 취급으로 특수 소환할수도 있다。
PRINTL 이렇게 X소환에 성공한 경우、이 카드의 X소재를 １개 늘린다。
CALL CARD_ABLE(2,특수소환時)
PRINTL ②：필드의 이 카드의 코스트 미만이고、이 카드의 공격력 이상인 몬스터가 존재하는 경우에 발동한다。
PRINTL 덱에서 "드래곤 클래스" 마법카드 １장을 패에 넣는다。
CALL CARD_ABLE(10,발동誘発)
PRINTL ③：１턴에 １번、상대 필드의 몬스터가 효과를 발동했을 때、
PRINTL 이 카드의 X소재를 １개 제거하고 발동할 수 있다、상대 필드의 카드를 １개 파괴한다。

@CARDCAN_4429(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIM DYNAMIC 지정攻撃力
#DIM DYNAMIC 지정コスト


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,4429)
SIF RESULT == 1
	RETURN 0


IF 종류 == EX덱起動
	SIF 발동済_1(듀얼리스트,4429)
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,4429)
	SIF RESULT == 1
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	CALLFORM 효과条件レベル_ADV(6,"以上")
	효과条件종족 = 드래곤족 
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,4429)
		RETURN 0
	지정攻撃力 = GETVAR(@"%듀얼리스트%_MZ_攻:場所")
	지정コスト = GETVAR(@"%듀얼리스트%_MZ_星:場所") - 1
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件以攻撃力 = 지정攻撃力
	CALLFORM 효과条件レベル_ADV(지정コスト,"以下")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF 발동済_3(듀얼리스트,4429)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_4429(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC ドロー枚数
#DIM DYNAMIC 破壊数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4429,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		CALLFORM 효과条件レベル_ADV(6,"以上")
		효과条件종족 = 드래곤족 
		효과条件行先플래그 = 破壊行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과추가종류 = 40000
			CALL CARD_EX_SUMMON(듀얼리스트, "EX덱", 場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4429,2)
	IF RESULT == 0	
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 드래곤 클래스
		효과条件종류 = 마법全般
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4429,3,X消費1)
	IF RESULT == 0	
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
	ENDIF
ENDIF
