@CARDNAME_74430,参照先
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 용의 신탁
	CASE "略称"
		RESULTS = 용의 신탁
	CASE "カテゴリ"
		RESULTS:0 = 드래곤 클래스
	CASE "出典作品"
		RESULTS:0 = Shadowverse
ENDSELECT


@CARD_74430(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 通常마법
	CASE "추가日"
		RETURN 251004
ENDSELECT

RETURN 0

@CARD_EXPLANATION_74430(종류)
#DIM DYNAMIC 종류

CALL CARD_ABLE(0,마함起動,손패起動)
PRINTL ①：이 듀얼 중、자신의 패의 드래곤족 몬스터를 소환할 때의 레벨은 １내린다。
PRINTL 현재가 ２턴째 이후라면、추가로 카드를 １장 드로우한다。
PRINTL 


@CARDCAN_74430(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,74430)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ELSEIF 종류 == 永攻紋章起動
	RETURN 1
ENDIF



@CARDEFFECT_74430(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,74430)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL CARD_RESERV(듀얼리스트,74430,永攻紋章予約)
		IF ターン数 >= 2
			CALL CARDDRAW_BASIC(듀얼리스트,1)
		ENDIF
	ENDIF
ELSEIF 종류 == 永攻紋章起動
	CALL FULLRESET
	효과条件종족 = 드래곤족
	CALL STATCHANGE_HAND(듀얼리스트,"全体",場所,"一星",1)
ENDIF
