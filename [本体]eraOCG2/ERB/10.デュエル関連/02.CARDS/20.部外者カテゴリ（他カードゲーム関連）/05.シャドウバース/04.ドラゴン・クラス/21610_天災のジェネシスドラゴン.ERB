@CARDNAME_21610,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 천재지변의 시작 창세의 용
	CASE "略称"
		RESULTS = 천재지변창세의용
	CASE "カテゴリ"
		RESULTS:0 = 드래곤 클래스
		RESULTS:4 = Shadowverse
ENDSELECT


@CARD_21610(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 3000
	CASE "守備力"
		RETURN 4000
	CASE "추가日"
		RETURN 251004
ENDSELECT

RETURN 0

@CARD_EXPLANATION_21610(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ①：이 카드를 소환 할대의 레벨은、현재의 턴의 수 만큼 내려간다。
PRINTL 이렇게 소환할 때、레벨이 １이하인 한 "진화"된 상태로 필드에 소환되며、소환권을 소비하지 않는다。
CALLFORM CARD_ABLE(2,손패起動)
PRINTL ②：상대가 ４장 이상 몬스터를 소환 / 특수 소환한 상대 턴의 메인 페이즈에 발동할 수 있다。
PRINTL 패의 이 카드를 버리고、필드의 수비력 ２０００ 이하인 몬스터를 전부 파괴한다。
PRINTL 이 효과의 발동 후、다음 엔드 페이즈까지 자신은 드래곤족 몬스터 이외를 특수 소환할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：특수 소환된 이 카드는 공격할 수 없다。


@CARDCAN_21610(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,21610)
SIF RESULT == 1
	RETURN 0
IF 종류 == 攻守変動
	SIF ゾーン != "손패"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과소환
	SIF GETVAR(@"%듀얼리스트%_手_一星:場所") < 9
		RETURN 0
	RETURN 1
ELSEIF 종류 == 손패起動 || 종류 == フリー誘発
	SIF ゾーン != "손패"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	SIF 발동済_2(듀얼리스트,21610)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,21610,"손패")
	SIF RESULT == 1
		RETURN 0
	SIF GETVAR(@"%対面者%_モン出現数") < 4
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン開始時予約
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_召種:場所") == 召種通常
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_21610(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 守備力修正

IF 종류 == 攻守変動
	CALL FULLRESET
	CALL STATCHANGE_HAND(듀얼리스트,"지정",場所,"一星",ターン数)
ELSEIF 종류 == 효과소환
	RETURN 2
ELSEIF 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,21610,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件守備力 = 2000
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드全体",場所,"묘지")
		SS소환可能종족 = 드래곤족
		CALL CARD_SS_RESTRICTION(듀얼리스트)
		CALL CARD_RESERV(듀얼리스트,21610,スタン予約)
	ENDIF
ELSEIF 종류 == ターン開始時予約
	SS소환可能종족 = 드래곤족
	CALL CARD_SS_RESTRICTION(듀얼리스트)
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦無")
ENDIF

