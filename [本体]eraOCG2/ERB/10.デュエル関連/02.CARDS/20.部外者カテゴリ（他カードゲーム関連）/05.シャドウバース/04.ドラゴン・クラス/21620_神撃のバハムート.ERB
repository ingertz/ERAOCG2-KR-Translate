@CARDNAME_21620,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 신격의 바하무트
	CASE "略称"
		RESULTS = 바하무트
	CASE "カテゴリ"
		RESULTS:0 = 없음
		RESULTS:1 = 진화가능
		RESULTS:4 = Shadowverse
ENDSELECT


@CARD_21620(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 11
	CASE "攻撃力"
		RETURN 4000
	CASE "守備力"
		RETURN 4000
	CASE "추가日"
		RETURN 251004
ENDSELECT

RETURN 0

@CARD_EXPLANATION_21620(종류)
#DIM DYNAMIC 종류
PRINTL このカードはこのカードの효과以外では특수소환できない。
PRINTL 「進化(覚醒)」は１ターンに１度しか行えない。
CALLFORM CARD_ABLE(0,소환時)
PRINTL ①：このカードが소환に成功した場合に발동する。
PRINTL 상대フィールドのモンスターをすべて破壊する。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：このカードは直接攻撃できない。
CALLFORM CARD_ABLE(10,필드起動)
PRINTL ③：このデュエル中使用したカードが１０종류以上である場合、자신メインフェイズに발동できる。
PRINTL そうした場合、このカードの攻撃力・守備力は１０００アップする。
PRINTL さらに、このデュエル中、자신は以下の能力を持つ。（重複불가）
PRINTL ●자신のターンのスタンバイフェイズに進化状態の「바하무트」１体を덱から특수소환する。


@CARDCAN_21620(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,21620)
SIF RESULT == 1
	RETURN 0


;PRINTFORML 一星{GETVAR(@"%듀얼리스트%_手_一星:場所")}
IF 종류 == 소환時
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 발동済_1(듀얼리스트,覚醒발동)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과条件固名前起動 = 1
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"효과이력",0,1)
	SIF RESULT < 10
		RETURN 0
	RETURN 1
ELSEIF 종류 == 時限紋章起動
	SIF スタンバイフェイズ != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件名前 = 바하무트
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_21620(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 守備力修正

IF 종류 == 소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,21620)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드全体",場所,"묘지")
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,覚醒발동,1)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"条達",2,1)
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"永攻",1000)
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"永守",1000)
		CALL CARD_RESERV(듀얼리스트,21620,時限紋章予約)
	ENDIF
ELSEIF 종류 == 時限紋章起動
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件名前 = 바하무트
	효과추가종류:0 = 9
	효과추가종류:1 = 200000 + 1000
	효과추가종류:2 = 250000 + 1000
	CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"直無")
ENDIF


