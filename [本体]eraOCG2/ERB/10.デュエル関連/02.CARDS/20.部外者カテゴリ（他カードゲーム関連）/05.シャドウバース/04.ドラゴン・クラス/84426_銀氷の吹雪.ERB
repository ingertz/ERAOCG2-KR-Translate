@CARDNAME_84426,参照先
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 은빛 얼음의 눈보라
	CASE "略称"
		RESULTS = 은빙의 눈보라
	CASE "カテゴリ"
		RESULTS:0 = 드래곤 클래스
		RESULTS:4 = Shadowverse
ENDSELECT


@CARD_84426(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 251004
ENDSELECT

RETURN 0

@CARD_EXPLANATION_84426(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALL CARD_ABLE(1,마함起動)
PRINTL ①：상대フィールドに存在するモンスター１体を選ぶ、そのカードはこのターン攻撃できない。
PRINTL 자신フィールドに進化（覚醒）後モンスターが存在する場合、상대フィールドの最も攻撃力が高いモンスターと最も低いモンスターを破壊する。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②：자신メインフェイズに、자신フィールドに進化（覚醒）後モンスターが存在する場合、
PRINTL 묘지のこのカードを제외して발동できる。
PRINTL 次の상대のターン中、상대の손패のモンスターの소환する際のレベルは１上がる。

@CARDCAN_84426(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,84426)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")
	SIF 발동済_1(듀얼리스트,84426)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 10
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動 || (종류 == フリー誘発 && ゾーン == "묘지")
	SIF 발동済_2(듀얼리스트,84426)
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件条件達生 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン開始時予約
	RETURN 1
ELSEIF 종류 == 攻紋章起動
	RETURN 1

ENDIF



@CARDEFFECT_84426(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 발동数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,84426,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과条件종류 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"戦無効")
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件条件達生 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"最高自動処理",場所,"묘지")
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"最低自動処理",場所,"묘지")
		ENDIF
	ENDIF
ELSEIF 종류 == 묘지起動 || (종류 == フリー誘発 && ゾーン == "묘지")
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,84426,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL CARD_RESERV(듀얼리스트,84426,スタン予約)
	ENDIF
ELSEIF 종류 == ターン開始時予約
	CALL CARD_RESERV(듀얼리스트,84426,攻紋章起動)
ELSEIF 종류 == 攻紋章起動
	CALL FULLRESET
	CALL STATCHANGE_HAND(対面者,"全体",場所,"一星",-1)
ENDIF
