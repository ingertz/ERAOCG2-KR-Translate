@CARDNAME_4427,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 깊은 유대의 용기사 아일라
	CASE "略称"
		RESULTS = 용기사 아일라
	CASE "カテゴリ"
		RESULTS:0 = 드래곤 클래스
	CASE "出典作品"
		RESULTS:0 = Shadowverse
ENDSELECT


@CARD_4427(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 1200
	CASE "守備力"
		RETURN 2100
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251004
ENDSELECT

RETURN 0

@CARD_EXPLANATION_4427(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ①：이 카드를 소환할 때의 레벨은、현재의 턴의 수만큼 내려간다。
PRINTL 이렇게 소환할 때、레벨이 １이하인 한 소환권을 소비하지 않는다。
CALLFORM CARD_ABLE(2,소환時,특수소환時)
PRINTL ②：이 카드가 소환 / 특수 소환된 경우에 발동할 수 있다。
PRINTL 덱에서 이 카드명 이외의 레벨６ 이하의 "드래곤 클래스" 몬스터 １장을 특수 소환한다。
PRINTL 이 카드가 소환되어있던 경우、
PRINTL 이 듀얼 중、자신 패의 드래곤족 몬스터의 소환하는 때의 레벨은 １내려간다。

@CARDCAN_4427(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,4427)
SIF RESULT == 1
	RETURN 0
IF 종류 == 攻守変動
	SIF ゾーン != "손패"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과소환
	SIF GETVAR(@"%듀얼리스트%_手_一星:場所") < 5
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,4427)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 드래곤 클래스
	CALLFORM 효과条件レベル_ADV(6,"以下")
	효과条件固名前 = 깊은 유대의 용기사 아일라
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 永攻紋章起動
	RETURN 1
ENDIF

@CARDEFFECT_4427(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 守備力修正

IF 종류 == 攻守変動
	CALL FULLRESET
	CALL STATCHANGE_HAND(듀얼리스트,"지정",場所,"一星",ターン数)
ELSEIF 종류 == 효과소환
	RETURN 2
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4427,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 드래곤 클래스
		CALLFORM 효과条件レベル_ADV(6,"以下")
		효과条件固名前 = 깊은 유대의 용기사 아일라
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF 종류 == 소환時
			CALL CARD_RESERV(듀얼리스트,4427,永攻紋章予約)
		ENDIF
	ENDIF
ELSEIF 종류 == 永攻紋章起動
	CALL FULLRESET
	효과条件종족 = 드래곤족
	CALL STATCHANGE_HAND(듀얼리스트,"全体",場所,"一星",1)
ENDIF
