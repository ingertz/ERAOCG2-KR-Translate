@CARDNAME_4418,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 타천사 올리비에
	CASE "略称"
		RESULTS = 올리비에
	CASE "カテゴリ"
		RESULTS:0 = 없음
		RESULTS:1 = 진화가능
	CASE "出典作品"
		RESULTS:0 = Shadowverse
ENDSELECT


@CARD_4418(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 2400
	CASE "守備力"
		RETURN 2400
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251202
ENDSELECT
RETURN 0

@CARD_EXPLANATION_4418(종류)
#DIM DYNAMIC 종류


PRINTL 이 카드명의 ①②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：자신 필드에 몬스터가 존재하지 않는 경우、자신 메인 페이즈에 발동할 수 있다。
PRINTL 이 카드를 패에서 특수 소환한다。
CALLFORM CARD_ABLE(2,소환時,특수소환時)
PRINTL ②：이 카드가 소환 / 특수 소환에 성공한 경우에 발동한다。
PRINTL 덱에서 "진화가능"한 몬스터 １장을 패에 넣는다。
CALLFORM CARD_ABLE(3,필드起動)
PRINTL ③：이 카드는、자신 메인 페이즈에 １번만 "진화"할 수 있다。
PRINTL 그렇게 한 경우、이 카드의 공격력 / 수비력은 ５００오른다。
PRINTL 그 후、자신의 다른 앞면 표시인 몬스터 １장을 골라、그 몬스터를 "진화（각성상태）"로 하여、공격력을 ５００올린다。
PRINTL 이 듀얼중에 "자신의 몬스터가 진화（각성）한 횟수"가 ３번 이상이라면、대신에 １０００오르고、관통 공격을 얻는다。
PRINTL "진화（각성）"은 １턴에 １번밖에 할 수 없다。

@CARDSUMMON_AA_4418

@CARDCAN_4418(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,4418)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,4418)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,4418,"손패")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,4418)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = モン全般
	효과条件カテゴリ = 진화가능
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF GETVAR(@"%듀얼리스트%_MZ_条達:場所") != 0
		RETURN 0
	SIF 발동済_1(듀얼리스트,각성발동)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_4418(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%



IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4418,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,"손패",場所)
	ENDIF
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4418,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종류 = モン全般
		효과条件カテゴリ = 진화가능
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,각성발동,1)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"条達",2,1)
		IF 각성횟수(듀얼리스트) >= 3
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"永攻",1000)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"永守",1000)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"貫通",2)
		ELSE
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"永攻",500)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"永守",500)
		ENDIF			
        CALL FULLRESET
		효과条件종류 = モン全般
		효과条件他所 = 1
		효과条件任意 = 1
        CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
        IF RESULT != 9999
			選択カード = RESULT
			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"条達",2,1)
			IF 각성횟수(듀얼리스트) >= 3
				CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"永攻",1000)
				CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"永守",1000)
				CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"貫通",2)
			ELSE
				CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"永攻",500)
				CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"永守",500)
			ENDIF		
		ENDIF
	ENDIF
ENDIF
