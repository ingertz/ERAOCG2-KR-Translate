@CARDNAME_23229,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 블래스터 다크
	CASE "略称"
		RESULTS = 블래스터 DK
	CASE "カテゴリ"
		RESULTS:0 = 쉐도우 팔라딘
		RESULTS:1 = 블래스터 다크
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_23229(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
	
		RETURN 通常モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 2400
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 雄性
	CASE "レア度"
		RETURN RARE
ENDSELECT

RETURN 0

