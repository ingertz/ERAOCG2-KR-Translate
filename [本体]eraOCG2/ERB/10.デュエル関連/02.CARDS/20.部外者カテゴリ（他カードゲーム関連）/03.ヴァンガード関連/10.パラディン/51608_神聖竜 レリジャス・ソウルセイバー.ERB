@CARDNAME_51608,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 신성룡 릴리저스 소울 세이버
	CASE "略称"
		RESULTS = R소울 세이버
	CASE "カテゴリ"
		RESULTS:0 = 로열 팔라딘
		RESULTS:1 = 블래스터 블레이드
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_51608(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 초차원
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 牝性
	CASE "특수불가"
		RETURN 1
	CASE "レア度"
		RETURN ULR

ENDSELECT

RETURN 0

@CARDSUMMON_51608(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要素材数 = 1
素材条件カテゴリ = 블래스터 블레이드

IF EX参照 == 1
	CALL STRIDECAN(듀얼리스트,소환カード,51608) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_51608(종류)
#DIM DYNAMIC 종류

CALL PRINT_STRIDETEXT("블래스터 블레이드")
PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,EX소환時)
PRINTL ①：이 카드가 『초월』한 경우、EX덱에서 "신성룡 릴리저스 소울 세이버" １장을 제외하고 발동할 수 있다。
PRINTL 이 턴、자신 필드의 몬스터의 공격력은 １２００오른다。
PRINTL 그 후、자신의 묘지에 "블래스터 블레이드" 카드와 "블래스터 다크" 카드가 존재하는 경우、
PRINTL 자신은 １장 드로우한다。



@CARDCAN_51608(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,51608)
SIF RESULT == 1
	RETURN 0


IF 종류 == EX덱起動
	SIF 발동済_3(듀얼리스트,51608)
		RETURN 0
	SIF ターン数 <= 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트)
	SIF RESULT != 1
		RETURN 0
	SIF ゾーン != "EX덱"
		 RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 블래스터 블레이드
	CALL CARD_CHECK_ADV(듀얼리스트)
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_超越済") != 0
		RETURN 0
	SIF 듀얼리스트 != "상대"
		RETURN 0
	RETURN 1
ELSEIF 종류 == EX소환時
	SIF 발동済_1(듀얼리스트,51608)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件名前 = 신성룡 릴리저스 소울 세이버
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻紋章起動
	RETURN 1
ENDIF

@CARDEFFECT_51608(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 효과先
#DIM DYNAMIC モンスター数
#DIM DYNAMIC ダメージ量
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%



IF 종류 == EX덱起動
 	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51608,3)
 	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件カテゴリ = 블래스터 블레이드
			효과条件行先플래그 = 소멸行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				選択カードID = RESULT:1
				CALL CARD_LOADUP
				PRINTFORML
				PRINTFORML
				PRINTFORML 초월《스트라이드》、제너레이션！
				RESETCOLOR
				CALL PRINT_STATE_DUEL(選択カードID)
				CALL FULLRESET
				CALL CARD_EX_SUMMON(듀얼리스트,"EX덱",場所,"攻撃표시")
				SETVAR @"%듀얼리스트%_MZ_変化元ID:カード소환先", 選択カードID
				CALL SET_PLAYER_INFO(듀얼리스트,"超越済",1)
			ELSE
				RETURN 0
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51608,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件名前 = 신성룡 릴리저스 소울 세이버
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL CARD_RESERV(듀얼리스트,51608,攻紋章予約)
	
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件カテゴリ = 블래스터 블레이드
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				条件달성 += 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件カテゴリ = 블래스터 다크
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				条件달성 += 1

			IF 条件달성 >= 2
				CALL CARDDRAW_BASIC(듀얼리스트,1)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 攻紋章起動
	CALL FULLRESET
	CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,1200)
ENDIF



