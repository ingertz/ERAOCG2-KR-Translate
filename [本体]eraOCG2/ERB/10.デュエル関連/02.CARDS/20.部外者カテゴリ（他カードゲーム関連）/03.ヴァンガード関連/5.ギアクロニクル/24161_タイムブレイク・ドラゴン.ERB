@CARDNAME_24161,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 타임 브레이크 드래곤
	CASE "略称"
		RESULTS = 타임 브레이크
	CASE "カテゴリ"
		RESULTS:0 = 기어 크로니클
		RESULTS:5 = 다크 스테이츠
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_24161(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RESULT:1 = 드래곤족
		RETURN 기계족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1300
	CASE "守備力"
		RETURN 1200
	CASE "성별"
		RETURN 雄性	
	CASE "レア度"
		RETURN RARE
	CASE "추가日"
		RETURN 251224
ENDSELECT

RETURN 0

@CARD_EXPLANATION_24161(종류)
#DIM DYNAMIC 종류


PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,효과後誘発)
PRINTL ①：자신 필드에 "기어 크로니클" 몬스터가 존재하는 경우에 발동할 수 있다。
PRINTL 이 카드를 패 / 묘지에서 특수 소환한다。
PRINTL 이 효과로 특수 소환한 이 카드는、필드에서 벗어날 경우에 제외된다。
CALLFORM CARD_ABLE(2,소환時,특수소환時)
PRINTL ②：이 카드가 패에서 소환 / 특수 소환된 경우에 발동할 수 있다。
PRINTL 자신 필드의 다른 몬스터 １장을 타임리프 시킨다。
CALL PRINT_VTIMELEEPTEXT


@CARDCAN_24161(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,24161)
SIF RESULT == 1
	RETURN 0


IF 종류 == 손패起動 || 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,24161)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,24161,ゾーン)
	SIF RESULT == 1
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 기어 크로니클
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == 소환時
	SIF 발동済_2(듀얼리스트,24161)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件他所 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
	ELSEIF 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,24161)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_召種:場所") != 召種손패
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件他所 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_24161(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択レベル
#DIM DYNAMIC 選択カードB
#DIM DYNAMIC 選択カードID
#DIMS DYNAMIC 選択カード名前
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動 || 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24161,1)
	IF RESULT == 0
		CALL FULLRESET
		효과추가종류:0 = 効追除処
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24161,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件他所 = 1
		효과条件종류 = モン全般
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			選択レベル = GETVAR(@"%듀얼리스트%_MZ_星:選択カード") + 2
			CALL CARD_DISPOSE(듀얼리스트,"필드",選択カード,제외行き,1)
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 기어 크로니클
			효과条件レベル = 選択レベル
			효과条件종류 = モン全般
			효과条件소환可 = 1
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲덱 = 1
				효과条件カテゴリ = 기어 크로니클
				효과条件任意 = 1
				효과条件レベル = 選択レベル
				효과条件종류 = モン全般
				효과추가종류 = 10 + 덱行き
				CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)	
			ENDIF
		ENDIF
	ENDIF
ENDIF



