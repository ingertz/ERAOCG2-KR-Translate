@CARDNAME_91660,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 각성의 시공룡
	CASE "略称"
		RESULTS = 각성의 시공룡
	CASE "カテゴリ"
		RESULTS:0 = 기어 크로니클
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_91660(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 通常함정
ENDSELECT
RETURN 0

@CARD_EXPLANATION_91660(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか발동できない。
CALL CARD_ABLE(1,마함起動 ,フリー誘発)
PRINTL ①：「기어 크로니클」モンスターを含むフィールドの表側표시モンスター２体を대상として발동できる。
PRINTL そのモンスターを손패・EX덱に戻す。
PRINTL その後、戻したモンスターのコストの合計以下のレベルを持つ「기어 크로니클」モンスター１体を손패・덱から특수소환できる。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②：자신フィールドにレベル８の「기어 크로니클」モンスターが存在する場合、
PRINTL 자신メインフェイズに묘지のこのカードを제외し、손패からモンスター１体を묘지に送って발동できる。
PRINTL 자신は덱から１枚ドローし、자신フィールドのレベル８の「기어 크로니클」モンスター１体は자신のターン終了時まで攻撃力が１５００アップする。
PRINTL （この효과は先攻１ターン目には使用できない。）

@CARDCAN_91660(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,91660)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == フリー誘発
	SIF ゾーン != "마함"
		RETURN 0
	SIF 발동済_1(듀얼리스트,91660)
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과条件カテゴリ = 기어 크로니클
	효과条件종류 = モン全般
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	효과条件除去種 = 덱
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF 발동済_2(듀얼리스트,91660)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	SIF ターン数 <= 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件レベル = 8
	효과条件カテゴリ = 기어 크로니클
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF

@CARDEFFECT_91660(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC EX参照
#DIM DYNAMIC 묘지送カード,10
#DIM DYNAMIC 손패묘지送カード,10
#DIM DYNAMIC 素材数
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 選択レベル
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91660,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)

		CALL FULLRESET
		효과条件カテゴリ = 기어 크로니클
		효과条件종류 = モン全般
		효과範囲필드 = 1
		효과範囲상대필드 = 1
		효과条件行先플래그 = 덱行き
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"덱")
		IF RESULT == 1
			選択カード_ID = RESULT:2
			TRYCALLFORM CARD_{選択カード_ID}("レベル")
			選択レベル = RESULT

			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲상대필드 = 1
			효과条件표시 = 表側표시
			효과条件行先플래그 = 破壊行き
			효과条件複数 = 2
			CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"덱")
			IF RESULT == 1
				選択カード_ID = RESULT:2
				TRYCALLFORM CARD_{選択カード_ID}("レベル")
				選択レベル += RESULT

				CALL FULLRESET
				효과範囲손패 = 1
				효과範囲덱 = 1
				효과条件カテゴリ = 기어 크로니클
				효과条件종류 = モン全般
				CALL 효과条件レベル_ADV(選択レベル, "以下")
				효과条件소환可 = 1
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT == 1
					CALL FULLRESET
					효과範囲손패 = 1
					효과範囲덱 = 1
					효과条件カテゴリ = 기어 크로니클
					효과条件종류 = モン全般
					CALL 효과条件レベル_ADV(選択レベル, "以下")
					CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
				ENDIF	
			ENDIF
		ENDIF
	ENDIF		
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91660,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL CARDDRAW_BASIC(듀얼리스트,1)
			CALL FULLRESET
			효과条件レベル = 8
			효과条件カテゴリ = 기어 크로니클
			효과条件종류 = モン全般
			CALL CARD_CHOOSE_BASIC(듀얼리스트, "필드",ゾーン,場所)
			選択カード = RESULT
			IF 選択カード != 9999
				CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"一攻",1500)
			ENDIF
		ENDIF
	ENDIF
ENDIF
