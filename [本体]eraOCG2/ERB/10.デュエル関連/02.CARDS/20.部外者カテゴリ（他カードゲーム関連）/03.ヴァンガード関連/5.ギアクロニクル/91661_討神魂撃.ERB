@CARDNAME_91661,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 토신혼격
	CASE "略称"
		RESULTS = 토신혼격
	CASE "カテゴリ"
		RESULTS:0 = 기어 크로니클
		RESULTS:5 = 십이지각수
		RESULTS:6 = 다크 스테이츠
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_91661(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 通常함정
	CASE "レア度"
		RETURN RARE
	CASE "추가日"
		RETURN 251224
ENDSELECT
RETURN 0

@CARD_EXPLANATION_91661(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 1턴에 각각 1번밖에 발동할 수 없다.
CALLFORM CARD_ABLE(1,마함起動 ,フリー誘発)
PRINTL ①：자신 필드의 "기어 크로니클" 몬스터를 임의의 수 만큼 소실시킨다。
PRINTL 그 후、이 효과로 제외한 몬스터의 수 만큼 상대 필드의 앞면 표시 카드를 덱으로 되돌릴 수 있다。
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：이 카드가 묘지에 존재하고、덱 / EX덱에서 몬스터가 특수 소환된 경우에 발동할 수 있다。
PRINTL 이 카드를 자신 필드에 세트한다。
PRINTL 이 효과로 세트한 이 카드는 필드에서 벗어날 경우에 제외된다。

@CARDCAN_91661(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,91661)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == フリー誘発
	SIF ゾーン != "마함"
		RETURN 0
	SIF 발동済_1(듀얼리스트,91661)
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	IF 듀얼리스트 != "자신"
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과条件표시 = 表側표시
		효과条件除去種 = 덱
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ENDIF
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 기어 크로니클
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF 발동済_2(듀얼리스트,91661)
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	CALL CARD_CHECK_FIN_BIT(듀얼리스트,"소환出処",5,2)
	SIF RESULT == 1
		条件달성 = 1
	CALL CARD_CHECK_FIN_BIT(듀얼리스트,"소환出処",4,2)
	SIF RESULT == 1
		条件달성 = 1
	SIF 条件달성 != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_91661(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC EX参照
#DIM DYNAMIC 묘지送カード,10
#DIM DYNAMIC 손패묘지送カード,10
#DIM DYNAMIC 素材数
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC カードID
#DIM DYNAMIC 지정속성
#DIM DYNAMIC 제외횟수
;융합소환
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91661,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		$INPUTLOOP
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 기어 크로니클
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			CALL CARD_DISPOSE(듀얼리스트,"필드",選択カード,제외行き,1)
			제외횟수 ++
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件カテゴリ = 기어 크로니클
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1
				PRINTL 이어서 제외하시겠습니까？
				CALL YN_CHOICE(듀얼리스트)
				IF RESULT == 0
					GOTO INPUTLOOP
				ENDIF
			ENDIF
		ENDIF
		IF 제외횟수 >= 1
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과範囲상대마함 = 1
			효과条件표시 = 表側표시
			효과条件除去種 = 덱
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲상대필드 = 1
				효과範囲상대마함 = 1
				효과条件표시 = 表側표시
				효과条件複数 = 100 - 제외횟수
				CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"덱")
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91661,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과追加종류 = 500
		효과条件名前 = 토신혼격
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"裏側표시")
	ENDIF
ENDIF
