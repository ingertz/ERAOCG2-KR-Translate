@CARDNAME_50741,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 창람수룡 어드미럴 메일스트롬
	CASE "略称"
		RESULTS = A 메일
	CASE "カテゴリ"
		RESULTS:0 = 아쿠아포스
		RESULTS:1 = 메일스트롬
		RESULTS:2 = 창람
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_50741(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 초차원
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RETURN 바다생물족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 雄性
	CASE "특수불가"
		RETURN 1
	CASE "レア度"
		RETURN ULR

ENDSELECT

RETURN 0


@CARDSUMMON_50741(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件


CALL RESETCONDITION_MAT
必要素材数 = 1
素材条件カテゴリ = 메일스트롬

IF EX参照 == 1
	CALL STRIDECAN(듀얼리스트,소환カード,50741) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_50741(종류)
#DIM DYNAMIC 종류

CALL PRINT_STRIDETEXT("메일스트롬")
CALLFORM CARD_ABLE(1,攻撃後誘発)
PRINTL ①：이 카드가 이 턴의 ４번째 이후의 공격선언한 데미지 스탭 종료시에 발동할 수 있다。
PRINTL EX덱에서 "아쿠아포스" 초차원몬스터 １장을 제외하고、덱에서 １장 드로우한다。
PRINTL 그 후、제외상태인 "창람수룡 어드미럴 메일스트롬"의 수＋１까지 상대 필드의 카드를 고르고 파괴한다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：이 카드가 몬스터 존에 존재하는 한、상대는 배틀 페이즈 중에 효과를 발동할 수 없다。

@CARDCAN_50741(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50741)
SIF RESULT == 1
	RETURN 0

IF 종류 == 攻撃後誘発 && ゾーン == "필드"
	SIF 발동済_1(듀얼리스트,50741)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターン中攻撃횟수 < 4
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件カテゴリ = 아쿠아포스
	효과条件종류 = 초차원
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF バトルフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_50741(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 효과先
#DIM DYNAMIC カードID
#DIM DYNAMIC 選択カードID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 攻撃後誘発 && ゾーン == "필드"
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50741,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件カテゴリ = 아쿠아포스
		효과条件종류 = 초차원
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL CARDDRAW_BASIC(듀얼리스트,1)
			CALL FULLRESET
			효과範囲제외 = 1
			효과条件名前 = 창람수룡 어드미럴 메일스트롬
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			カウンタ = RESULT+1
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과範囲상대마함 = 1
			효과条件複数 = 100 - カウンタ
			CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")

		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"不材")
	IF バトルフェイズ == 1
		CALL SET_PLAYER_INFO(対面者,"モン효과無効",3)
		CALL SET_PLAYER_INFO(対面者,"마함無効",3)
	ENDIF
ENDIF



