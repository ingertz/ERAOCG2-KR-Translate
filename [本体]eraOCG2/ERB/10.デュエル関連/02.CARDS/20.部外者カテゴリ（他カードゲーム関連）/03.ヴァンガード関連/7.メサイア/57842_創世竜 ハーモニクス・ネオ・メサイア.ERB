@CARDNAME_57842,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 창세룡 하모닉스 네오 메사이어
	CASE "略称"
		RESULTS = 하모닉스
	CASE "カテゴリ"
		RESULTS:0 = 얼터에고
		RESULTS:1 = 메사이어
		RESULTS:2 = 링크 조커
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_57842(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 초차원
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 미확인족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 0
	CASE "특수불가"
		RETURN 1
	CASE "レア度"
		RETURN ULR

ENDSELECT

RETURN 0


@CARDSUMMON_57842(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件


CALL RESETCONDITION_MAT
必要素材数 = 1
素材条件カテゴリ = 얼터에고

IF EX参照 == 1
	CALL STRIDECAN(듀얼리스트,소환カード,57842) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_57842(종류)
#DIM DYNAMIC 종류

CALL PRINT_STRIDETEXT("얼터에고")
CALLFORM CARD_ABLE(1,攻撃時誘発)
PRINTL ①: 이 카드의 공격 선언 시에 발동할 수 있다.
PRINTL 이 카드의 공격력은 턴 종료 시까지, 필드의 주박 상태의 몬스터의 수× 1000 올라간다.
PRINTL 필드의 주박 상태의 몬스터가 5체 이상 존재할 경우,
PRINTL 이 턴의 엔드 페이즈에 상대 필드의 카드를 전부 제외한다.
PRINTL 그 후, 필드의 주박 상태의 몬스터를 전부 표시 형식을 변경한다.
PRINTL 이 턴, 상대가 받는 전투 데미지는 절반이 된다.
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ②: 자신 필드의 다른 몬스터의 공격력은 1000 올라간다.
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③: 이 카드가 공격할 경우, 데미지 스텝 종료 시까지 상대는 카드의 효과를 발동할 수 없다.


@CARDCAN_57842(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,57842)
SIF RESULT == 1
	RETURN 0

IF 종류 == 攻撃時誘発
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF 발동済_1(듀얼리스트,57842)
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件カテゴリ = 링크 조커
	효과条件종류 = 초차원
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件표시 = 裏側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 裏側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 0

	TRYCALLFORM CARDNAME_{戦闘カードID(듀얼리스트)}("カテゴリ")
	IF !MATCH(RESULTS,"링크 조커")
		RETURN 0
	ENDIF
	RETURN 1
ELSEIF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン終了時予約
	RETURN 1
ENDIF

@CARDEFFECT_57842(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 효과先
#DIM DYNAMIC モンスター数
#DIM DYNAMIC ダメージ量
#DIM DYNAMIC 条件カード数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57842,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件カテゴリ = 링크 조커
		효과条件종류 = 초차원
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲필드 = 1
				효과範囲상대필드 = 1
				효과条件표시 = 裏側표시
				효과条件CNT = 1
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"一攻",1000*RESULT)
			IF RESULT >= 5
				CALL CARD_RESERV(듀얼리스트,57842)
			ENDIF

			FOR カウンタ,0,5
				SIF GETVAR(@"%듀얼리스트%_필드:カウンタ") == -1
					CONTINUE
				SIF GETVAR(@"%듀얼리스트%_MZ_表:カウンタ") != 3
					CONTINUE
				CALL SET_FIELD_INFO(듀얼리스트,"필드",カウンタ,"表",1,1)
			NEXT
			FOR カウンタ,0,5
				SIF GETVAR(@"%対面者%_필드:カウンタ") == -1
					CONTINUE
				SIF GETVAR(@"%対面者%_MZ_表:カウンタ") != 3
					CONTINUE
				CALL SET_FIELD_INFO(対面者,"필드",カウンタ,"表",1,1)
			NEXT
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件표시 = 裏側표시
	CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"攻避",3)

	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 0
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"直攻")
	ENDIF
ELSEIF 종류 == 攻撃時強制誘発
	CALL SET_PLAYER_INFO(듀얼리스트,"ダメージ半化",3,1)
ELSEIF 종류 == 攻守変動
	CALL FULLRESET
	효과条件他所 = 1
	CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,1000)
ELSEIF 종류 == ターン終了時予約
	CALL FULLRESET
	CALL CARD_REMOVAL_BASIC(듀얼리스트,"全場全体",場所,"제외",57842)
ENDIF



