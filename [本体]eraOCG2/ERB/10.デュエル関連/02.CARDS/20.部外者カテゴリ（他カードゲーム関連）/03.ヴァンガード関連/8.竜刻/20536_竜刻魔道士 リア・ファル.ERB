@CARDNAME_20536,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 용각마도사 리어 팔
	CASE "略称"
		RESULTS = 리어 팔
	CASE "カテゴリ"
		RESULTS:0 = 용각
		RESULTS:1 = 쉐도우 팔라딘
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_20536(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 2100
	CASE "守備力"
		RETURN 1300
ENDSELECT

RETURN 0

@CARD_EXPLANATION_20536(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時,특수소환時)
PRINTL ①："용각마도사 리어 팔" 이외의 드래곤족 / 마법사족인 어둠속성 몬스터가 묘지로 보내진 경우、
PRINTL 패를 １장 버리고 발동할 수 있다。이 카드를 패 / 묘지에서 특수 소환한다。
PRINTL 그 후、덱에서 의식 마법 １장을 패에 넣을 수 있다。
CALLFORM CARD_ABLE(2,破壊→묘지)
PRINTL ②：『의식３』
SETCOLOR C_L_GRAY
PRINTFORML （자신 묘지의 드래곤족 / 마법사족인 어둠속성 몬스터가 ３장 이상인 경우、이하의 효과를 적용한다。）
RESETCOLOR
PRINTL 이 카드가 효과로 파괴되어 묘지로 보내진 경우에 발동할 수 있다。
PRINTL 상대 필드의 카드 １장을 골라 파괴한다。


@CARDCAN_20536(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,20536)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과後誘発
	SIF 발동済_1(듀얼리스트,20536)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,20536,ゾーン)
	SIF RESULT == 1
		RETURN 0
	SIF ゾーン != "손패" && ゾーン != "묘지"
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과条件속성 = 어둠속성
	효과条件종족:0 = 마법사족
	효과条件종족:1 = 드래곤족
	효과条件固名前 = 용각마도사 리어 팔
	효과条件종류 = モン全般
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"묘지送り全般+H")
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 破壊→묘지
	SIF 발동済_2(듀얼리스트,20536)
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件속성 = 어둠속성
	효과条件종족:0 = 드래곤족
	효과条件종족:1 = 마법사족
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 3
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_20536(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,20536,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件他所 = 1
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트, ゾーン, 場所)

			CALL FULLRESET
			효과範囲덱 = 1
			효과条件종류 = 마법全般
			효과条件カテゴリ = 의식마법
			효과条件任意 = 1
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,20536,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
	ENDIF
ENDIF

