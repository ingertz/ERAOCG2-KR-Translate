@CARDNAME_50091,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 드래그스트라이더 루아드
	CASE "略称"
		RESULTS = 각성 루아드
	CASE "カテゴリ"
		RESULTS:0 = 루아드
		RESULTS:1 = 용각
		RESULTS:2 = 쉐도우 팔라딘
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_50091(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 초차원
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RESULT:1 = 드래곤족
		RETURN 마법사족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 雄性
	CASE "특수불가"
		RETURN 1
	CASE "レア度"
		RETURN ULR
	CASE "連動ID"
		RETURN 4047

ENDSELECT

RETURN 0


@CARDSUMMON_50091(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件


CALL RESETCONDITION_MAT
必要素材数 = 1
素材条件カテゴリ = 루아드

IF EX参照 == 1
	CALL STRIDECAN(듀얼리스트,소환カード,50091) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_50091(종류)
#DIM DYNAMIC 종류

CALL PRINT_STRIDETEXT("루아드")
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ①：『의식３』
SETCOLOR C_L_GRAY
PRINTFORML （자신の묘지の드래곤족・마법사족で어둠속성のモンスターが３体以上の場合、以下の효과を適用する。）
RESETCOLOR
PRINTL このカードが『超越』した場合、EX덱から「쉐도우 팔라딘」초차원モンスター１体を제외して발동できる。
PRINTL 덱から드래곤족・마법사족で어둠속성のモンスターを제외状態の「드래그스트라이더 루아드」の数まで특수소환する。
PRINTL その後、このカードの攻撃力はターン終了時まで자신の묘지の드래곤족・마법사족で어둠속성のモンスターモンスターの数×２００アップする。

@CARDCAN_50091(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50091)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF 발동済_3(듀얼리스트,50091)
		RETURN 0
	SIF ターン数 <= 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트)
	SIF RESULT != 1
 		RETURN 0
	SIF ゾーン != "EX덱"
		 RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
 	SIF ターンプレイヤー != 듀얼리스트
 		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 루아드
	CALL CARD_CHECK_ADV(듀얼리스트)
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_超越済") != 0
		RETURN 0
	SIF 듀얼리스트 != "상대"
		RETURN 0
 	RETURN 1
ELSEIF 종류 == EX소환時
	SIF 발동済_1(듀얼리스트,50091)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件カテゴリ = 쉐도우 팔라딘
	효과条件종류 = 초차원
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件속성 = 어둠속성
	효과条件종족:0 = 드래곤족
	효과条件종족:1 = 마법사족
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 3
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件속성 = 어둠속성
	효과条件종족:0 = 드래곤족
	효과条件종족:1 = 마법사족
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_50091(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 효과先
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC カードID
#DIM DYNAMIC 選択カードID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX덱起動
 	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50091,1)
 	IF RESULT == 0
	CALL FULLRESET
	효과範囲손패 = 1
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件カテゴリ = 루아드
			효과条件行先플래그 = 소멸行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
				IF RESULT == 1
					選択カードID = RESULT:1
					CALL CARD_LOADUP
					PRINTFORML
					PRINTFORML
					PRINTFORML 초월《스트라이드》、제너레이션！
					RESETCOLOR
					CALL PRINT_STATE_DUEL(選択カードID)
					CALL FULLRESET
					CALL CARD_EX_SUMMON(듀얼리스트,"EX덱",場所,"攻撃표시")
					SETVAR @"%듀얼리스트%_MZ_変化元ID:カード소환先", 選択カードID
					CALL SET_PLAYER_INFO(듀얼리스트,"超越済",1)
			ELSE
				RETURN 0
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50091,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件カテゴリ = 쉐도우 팔라딘
		효과条件종류 = 초차원
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲제외 = 1
			효과条件名前 = 드래그스트라이더 루아드
			효과条件CNT = 1
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			カウンタ = RESULT

			CALL FULLRESET
			효과範囲덱 = 1
			효과条件속성 = 어둠속성
			효과条件종족:0 = 드래곤족
			효과条件종족:1 = 마법사족
			효과条件複数 = 100 - カウンタ
			효과条件任意 = 1
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)	

			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件속성 = 어둠속성
			효과条件종족:0 = 드래곤족
			효과条件종족:1 = 마법사족
			효과条件CNT = 1
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			攻撃力修正 = RESULT * 200
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"一攻",攻撃力修正)
		ENDIF
	ENDIF
ENDIF