@CARDNAME_20533,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 용각마도사 모르펫사
	CASE "略称"
		RESULTS = 모르펫사
	CASE "カテゴリ"
		RESULTS:0 = 용각
		RESULTS:1 = 쉐도우 팔라딘
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_20533(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 2400
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 雄性
ENDSELECT

RETURN 0

@CARD_EXPLANATION_20533(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,손패起動)
PRINTL ①：이 카드를 패에서 버리고 발동할 수 있다。
PRINTL "용각마도사 모르펫사" 이외의 자신의 묘지 / 제외 상태인 드래곤족 / 마법사족인 어둠속성 몬스터 １장을 특수 소환한다。
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：이 카드가 패 / 묘지에 존재하고、자신이 "루아드" 몬스터를 소환 / 특수 소환된 경우에 발동할 수 있다。
PRINTL 이 카드를 특수 소환한다。
CALLFORM CARD_ABLE(3,필드起動)
PRINTL ③：『의식３』
SETCOLOR C_L_GRAY
PRINTFORML （자신 묘지의 드래곤족 / 마법사족인 어둠속성 몬스터가 ３장 이상인 경우、이하의 효과를 적용한다。）
RESETCOLOR
PRINTL 패를 １장 버리고 발동할 수 있다。"용각마도사 모르펫사"를 제외한、
PRINTL 드래곤족 / 마법사족인 어둠속성 몬스터 １장을 패 / 덱에서 특수 소환한다。
PRINTL 이 턴、자신은 초차원 몬스터밖에 EX덱에서 특수 소환할 수 없다。


@CARDCAN_20533(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,20533)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,20533)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件속성 = 어둠속성
	효과条件종족:0 = 드래곤족
	효과条件종족:1 = 마법사족
	효과条件固名前 = 용각마도사 모르펫사
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트,20533)
		RETURN 0
	IF ゾーン == "손패"
		CALL CARD_SS_CHECK(듀얼리스트,20533,"손패")
		SIF RESULT == 1
			RETURN 0
	ELSEIF ゾーン == "묘지"
		CALL CARD_SS_CHECK(듀얼리스트,20533,"묘지")
		SIF RESULT == 1
			RETURN 0
	ELSE
		RETURN 0
	ENDIF
	CALL FULLRESET
	효과条件カテゴリ = 루아드
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"소환全般")
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 발동済_3(듀얼리스트,20533)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件속성 = 어둠속성
	효과条件종족:0 = 드래곤족
	효과条件종족:1 = 마법사족
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 3
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件속성 = 어둠속성
	효과条件종족:0 = 드래곤족
	효과条件종족:1 = 마법사족
	효과条件固名前 = 용각마도사 모르펫사
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_20533(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,20533,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲제외 = 1
		효과条件속성 = 어둠속성
		효과条件종족:0 = 드래곤족
		효과条件종족:1 = 마법사족
		효과条件固名前 = 용각마도사 모르펫사
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,20533,2)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン, 場所)
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,20533,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲덱 = 1
			효과条件속성 = 어둠속성
			효과条件종족:0 = 드래곤족
			효과条件종족:1 = 마법사족
			효과条件固名前 = 용각마도사 모르펫사
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			EX소환可能종류 = 초차원
			CALL CARD_EX_RESTRICTION(듀얼리스트)
		ENDIF
	ENDIF
ENDIF
