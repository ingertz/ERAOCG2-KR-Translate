@CARDNAME_4047,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 드래그하트 루아드
	CASE "略称"
		RESULTS = 와룡 루아드
	CASE "カテゴリ"
		RESULTS:0 = 루아드
		RESULTS:1 = 용각
		RESULTS:2 = 쉐도우 팔라딘
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_4047(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 의식
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 2100
	CASE "성별"
		RETURN 雄性
	CASE "특수制限"
		RETURN 1
	CASE "レア度"
		RETURN ULR
ENDSELECT
RETURN 0

@CARDSUMMON_4047(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要レベル数 = 8

IF EX参照 == 1
	CALL RITCAN(듀얼리스트,소환カード,4047) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_4047(종류)
#DIM DYNAMIC 종류

PRINTL "룡마도의 의식"에 의해 강림. 
PRINTL 이 카드명의 ①의 효과는 듀얼중에 1번밖에 사용할 수 없으며, ②③의 효과는 각각 1턴에 1번밖에 사용할 수 없다.
CALLFORM CARD_ABLE(20,손패起動)
PRINTL ①: 패의 이 카드를 상대에게 보여주고 발동할 수 있다.
PRINTL 패를 1장 골라 버리고, 덱에서 "용각" 몬스터 1장 특수 소환한다.
PRINTL 이 턴, 자신은 초차원 몬스터밖에 EX덱에서 특수 소환할 수 없다.
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②:『의식３』
SETCOLOR C_L_GRAY
PRINTFORML （자신 묘지의 드래곤족 / 마법사족인 어둠 속성 몬스터가 ３장 이상인 경우、이하의 효과를 적용한다。）
RESETCOLOR
PRINTL 묘지의 드래곤족 / 마법사족인 어둠 속성 몬스터 2장을 덱으로 되돌리고 발동할 수 있다.
PRINTL "루아드" 초차원 몬스터 1장의 『초월』을 한다. （코스트는 필요로하지 않는다）
PRINTL (이 효과는 선공 1턴째엔 사용할 수 없다.)
CALLFORM CARD_ABLE(3,필드起動)
PRINTL ③: 자신 / 상대의 메인 페이즈에 발동할 수 있다。자신 필드의 이 카드 이외의 몬스터 １장을 파괴하고、
PRINTL 패 / 덱에서 드래곤족 . 마법사족인 어둠속성 몬스터 １장을 특수 소환한다。
PRINTL 그 후、자신은 １장 드로우 한다。

@CARDCAN_4047(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 발동불가,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,4047)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_D1(듀얼리스트,4047)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 용각
	효과条件종류 = 의식以外
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_2(듀얼리스트,4047)
		발동불가:0 = 1
	SIF 발동済_3(듀얼리스트,4047)
		발동불가:1 = 1
	SIF ターン数 <= 1
		발동불가:0 = 1
	SIF GETVAR(@"%듀얼리스트%_超越済") != 0
		발동불가:0 = 1
	SIF ターンプレイヤー != 듀얼리스트
		발동불가:0 = 1
	SIF メインフェイズ != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件속성 = 어둠속성
	효과条件종족:0 = 드래곤족
	효과条件종족:1 = 마법사족
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 3
		발동불가:0 = 1
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = 초차원
	효과条件カテゴリ = 루아드
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1
	CALL FULLRESET
	효과条件他所 = 1
	효과範囲필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:1 = 1
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과条件종족:0 = 드래곤족
	효과条件종족:1 = 마법사족
	효과条件속성 = 어둠속성
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:1 = 1
	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_4047(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 발동불가,2
#DIM DYNAMIC 효과先
#DIM DYNAMIC カードID
#DIM DYNAMIC 選択カードID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4047,20)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 용각
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			EX소환可能종류 = 초차원
			CALL CARD_EX_RESTRICTION(듀얼리스트)
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4047)
	IF RESULT == 0
		SIF 발동済_2(듀얼리스트,4047)
			발동불가:0 = 1
		SIF 발동済_3(듀얼리스트,4047)
			발동불가:1 = 1
		SIF ターン数 <= 1
			발동불가:0 = 1
		SIF GETVAR(@"%듀얼리스트%_超越済") != 0
			발동불가:0 = 1
		SIF ターンプレイヤー != 듀얼리스트
			발동불가:0 = 1
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件속성 = 어둠속성
		효과条件종족:0 = 드래곤족
		효과条件종족:1 = 마법사족
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT < 3
			발동불가:0 = 1
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件종류 = 초차원
		효과条件カテゴリ = 루아드
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:0 = 1
		CALL FULLRESET
		효과条件他所 = 1
		효과範囲필드 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:1 = 1
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲덱 = 1
		효과条件종족:0 = 드래곤족
		효과条件종족:1 = 마법사족
		효과条件속성 = 어둠속성
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:1 = 1

		IF 듀얼리스트 == "자신"
			PRINTL 효과를 선택해주세요
			PRINTL
			IF 발동불가:0 != 1
				PRINTL [0] - ●노코스트로 『초월』한다。
			ELSE
				SETCOLOR C_GRAY
				PRINTL ［X］- 발동 조건을 만족하지 못했습니다！
				RESETCOLOR
			ENDIF
			IF 발동불가:1 != 1
				PRINTL [1] - ●드래곤족 / 마법사족으로 어둠 속성 몬스터를 특수 소환한다。
			ELSE
				SETCOLOR C_GRAY
				PRINTL ［X］- 발동 조건을 만족하지 못했습니다！
				RESETCOLOR
			ENDIF
			BINPUT
		ELSE
			IF 발동불가:1 != 1
				RESULT = 1
			ELSEIF 발동불가:0 != 1
				RESULT = 0
			ENDIF
		ENDIF

		IF RESULT == 0
			CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4047,2)
			IF RESULT == 0
				CALL FULLRESET
				효과範囲묘지 = 1
				효과条件속성 = 어둠속성
				효과条件종족:0 = 드래곤족
				효과条件종족:1 = 마법사족
				효과条件複数 = 2
				효과条件行先플래그 = 덱行き
				CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
				IF RESULT == 1
					CALL FULLRESET
					효과範囲필드 = 1
					효과条件カテゴリ = 루아드
					효과条件行先플래그 = 소멸行き
					CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
					IF RESULT == 1
						選択カードID = RESULT:1
						CALL CARD_LOADUP
						PRINTFORML
						PRINTFORML
						PRINTFORML 초월《스트라이드》、제너레이션！
						CALL PRINT_STATE_DUEL(選択カードID)
						CALL FULLRESET
						효과範囲EX덱 = 1
						효과条件종류 = 초차원
						효과条件カテゴリ = 루아드
						효과条件特不無視 = 1
						CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
						IF RESULT != 9999
							選択カード = RESULT
							CALL FULLRESET
							CALL CARD_EX_SUMMON(듀얼리스트,"EX덱",選択カード,"攻撃표시")
							SETVAR @"%듀얼리스트%_MZ_変化元ID:カード소환先", 選択カードID
							CALL SET_PLAYER_INFO(듀얼리스트,"超越済",1)
						ENDIF
					ELSE
						RETURN 0
					ENDIF
				ENDIF
			ENDIF
		ELSEIF RESULT == 1
			CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4047,3)
			IF RESULT == 0
				CALL FULLRESET
				효과条件他所 = 1
				효과範囲필드 = 1
				효과条件行先플래그 = 破壊行き
				CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
				IF RESULT == 1
						CALL FULLRESET
						효과範囲손패 = 1
					효과範囲덱 = 1
					효과条件속성 = 어둠속성
					효과条件종족:0 = 드래곤족
					효과条件종족:1 = 마법사족
						CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
						CALL CARDDRAW_BASIC(듀얼리스트,1)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF