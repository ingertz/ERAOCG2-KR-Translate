@CARDNAME_4265,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 애타는 라넌큘러스 아샤
	CASE "略称"
		RESULTS = 아샤
	CASE "カテゴリ"
		RESULTS:0 = 아샤
		RESULTS:1 = 네오 넥타르
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_4265(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 식물족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 2300
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 牝性
	CASE "レア度"
		RETURN SPR
ENDSELECT

RETURN 0

@CARDSUMMON_4265(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要링크数 = 3
素材条件종족 = 식물족

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,4265) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_4265(종류)
#DIM DYNAMIC 종류

PRINTL 식물족 몬스터 2장 이상
PRINTL 이 카드명의 ①의 효과는 1턴에 1번만 사용할 수 있다.
CALLFORM CARD_ABLE(1,ターン開始時)
PRINTL ①：자신 / 상대의 스탠바이 페이즈에 발동할 수 있다。
PRINTL 패에서 식물족 몬스터 １장을 특수 소환한다。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：패를 １장 버리고、자신 필드의 초차원 몬스터 이외의 "네오 넥타르" 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 같은 이름의 몬스터 １장을 덱 / ＥＸ덱에서 특수 소환한다。
PRINTL 그 후、자신 필드에 다른 "애타는 라넌큘러스 아샤"가 존재하는 경우、
PRINTL 자신은 덱에서 １장 드로우한다。

@CARDCAN_4265(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,4265)
SIF RESULT == 1
	RETURN 0
IF 종류 == ターン開始時
	SIF 발동済_1(듀얼리스트,4265)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件종족 = 식물족
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트,4265)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 네오 넥타르
	효과条件종류:0 = 효과モン
	효과条件종류:1 = 링크
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_4265(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM 選択カード


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == ターン開始時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4265,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件종족 = 식물족
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,4265,2)
	IF RESULT == 0
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件カテゴリ = 네오 넥타르
			효과条件종류:0 = 효과モン
			효과条件종류:1 = 링크
			CALL CARD_CHOOSE_BASIC(듀얼리스트, "필드",ゾーン,場所)	
			選択カード = RESULT
			IF 選択カード != 9999
				CALL FULLRESET
				TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_필드:{選択カード}")}("名前")
				효과条件名前 = %RESULTS%
				효과範囲덱 = 1
				효과範囲EX덱 = 1
				CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)	

				CALL FULLRESET
				효과範囲필드 = 1
				효과条件他所 = 1
				효과条件名前 = 애타는 라넌큘러스 아샤
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT == 1
					CALL FULLRESET
					CALL CARDDRAW_BASIC(듀얼리스트,1)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF