@CARDNAME_55070,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 길티 엠프레스 다크페이스 그레도라
	CASE "略称"
		RESULTS = 죄괴 그레도라
	CASE "カテゴリ"
		RESULTS:0 = 메가 콜로니
		RESULTS:1 = 다크페이스
		RESULTS:2 = 그레도라
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_55070(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 초차원
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 곤충족 
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 牝性
	CASE "특수불가"
		RETURN 1
	CASE "連動ID"
		RETURN 2795
ENDSELECT

RETURN 0


@CARDSUMMON_55070(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件


CALL RESETCONDITION_MAT
必要素材数 = 1
素材条件カテゴリ = 그레도라

IF EX参照 == 1
	CALL STRIDECAN(듀얼리스트,소환カード,55070) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_55070(종류)
#DIM DYNAMIC 종류

CALL PRINT_STRIDETEXT("그레도라")
PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(0,지속효과,攻守変動)
PRINTL ①：상대 필드의 악성 카운터가 놓인 몬스터는 발동 무효를 얻는다。
CALL CARD_ABLE(1,EX소환時)
PRINTL ②：이 카드가 초월한 경우에 발동할 수 있다。
PRINTL ＥＸ덱의 "길티 엠프레스 다크페이스 그레도라" １장을 제외하고、
PRINTL 상대는 가능하면 덱에서 몬스터 1장을 악성 카운터가 1개 놓인 상태로 특수 소환한다。
PRINTL 그 후, 다음 상대의 턴 종료시까지 이하의 효과를 전부 적용한다。
PRINTL ●상대 필드에 악성 카운터가 놓인 몬스터가 있는 한、자신 필드의 곤충족 몬스터는 대상 내성을 얻는다。
CALL CARD_ABLE(0,短紋章起動,攻紋章起動)
PRINTL ●상대 필드의 악성 카운터가 놓인 몬스터는 공격력이 원래 공격력만큼 내리고、발동 무효 / 소재 불가를 얻는다。
CALL CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ③：자신 턴에, 상대의 악성 카운터가 놓여있는 몬스터 1장을 대상으로 하고 발동할 수 있다。
PRINTL 대상 몬스터를 완전 제외한다.
PRINTL 그 후, 덱 / 묘지에서 레벨８ 이하의 곤충족 몬스터 １장을 특수 소환한다。
PRINTL 이 효과로 특수 소환한 몬스터는, 이 효과로 제외한 몬스터와 같은 이름의 카드로도 취급한다。

@CARDCAN_55070(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,55070)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF 발동済_3(듀얼리스트,55070)
		RETURN 0
	SIF ターン数 <= 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트)
	SIF RESULT != 1
		RETURN 0
	SIF ゾーン != "EX덱"
		 RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 그레도라
	CALL CARD_CHECK_ADV(듀얼리스트)
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_超越済") != 0
		RETURN 0
	SIF 듀얼리스트 != "상대"
		RETURN 0
	RETURN 1
ELSEIF 종류 == EX소환時
	SIF 발동済_1(듀얼리스트,55070)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件名前 = 길티 엠프레스 다크페이스 그레도라
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_2(듀얼리스트,55070)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	효과条件悪Ｃ所持 = 999
	효과条件除去種 = 제외
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件종족 = 곤충족
	CALL 효과条件レベル_ADV(8,"以下")
	효과条件소환可 = 1
	효과条件종류 = レベル持ち
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과 || 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 短紋章起動 || 종류 == 攻紋章起動
	RETURN 1
ELSEIF 종류 == ターン開始時予約
	RETURN 1
ENDIF

@CARDEFFECT_55070(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC カードID
#DIM DYNAMIC 条件カード数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX덱起動
 	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55070,3)
 	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件カテゴリ = 그레도라
			효과条件行先플래그 = 소멸行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				選択カードID = RESULT:1
				CALL CARD_LOADUP
				PRINTFORML
				PRINTFORML
				PRINTFORML 초월《스트라이드》、제너레이션！
				RESETCOLOR
				CALL PRINT_STATE_DUEL(選択カードID)
				CALL FULLRESET
				CALL CARD_EX_SUMMON(듀얼리스트,"EX덱",場所,"攻撃표시")
				SETVAR @"%듀얼리스트%_MZ_変化元ID:カード소환先", 選択カードID
				CALL SET_PLAYER_INFO(듀얼리스트,"超越済",1)
			ELSE
				RETURN 0
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55070,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件名前 = 길티 엠프레스 다크페이스 그레도라
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			IF モンスター数(対面者) < 5
				CALL FULLRESET
				효과範囲덱 = 1
				CALL CARD_SP_SUMMON_ADV(対面者,ゾーン,場所)
				IF RESULT == 1
					CALL SET_FIELD_INFO(対面者,"필드",カード소환先,"悪Ｃ",1)
				ENDIF
			ENDIF

			CALL CARD_RESERV(듀얼리스트,55070,短紋章予約)
			CALL CARD_RESERV(듀얼리스트,55070,攻紋章予約)
			CALL CARD_RESERV(듀얼리스트,55070,スタン予約)
			CALL SET_PLAYER_INFO(듀얼리스트,"SS소환禁止묘지",1,1)
			CALL SET_PLAYER_INFO(듀얼리스트,"SS소환禁止덱",1,1)
			CALL SET_PLAYER_INFO(듀얼리스트,"SS소환禁止EX덱",1,1)
			CALL SET_PLAYER_INFO(듀얼리스트,"SS소환禁止제외",1,1)
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55070,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件悪Ｃ所持 = 999
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"完全제외")
		IF RESULT == 1
			選択カードID = RESULT:2
			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲묘지 = 1
			효과条件종족 = 곤충족
			CALL 효과条件レベル_ADV(8,"以下")
			효과条件종류 = レベル持ち
			효과추가종류 = 1000000 + 選択カードID
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件悪Ｃ所持 = 999
	CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"発無")
ELSEIF 종류 == 攻守変動
	FOR カウンタ, 0, 5
		選択カードID = GETVAR(@"%対面者%_필드:カウンタ")
		SIF 選択カードID < 1
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_悪Ｃ:カウンタ") < 1
			CONTINUE
		TRYCALLFORM CARD_{選択カードID}("攻撃力")
		攻撃力修正 = RESULT
		SIF 攻撃力修正 > 0
			CALL STATCHANGE_BASIC(対面者,"自身",カウンタ,-(攻撃力修正))
	NEXT
ELSEIF 종류 == ターン開始時予約
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55070,0)
	IF RESULT == 0
		CALL CARD_RESERV(듀얼리스트,55070,短紋章予約)
		CALL CARD_RESERV(듀얼리스트,55070,攻紋章予約)
		CALL SET_PLAYER_INFO(듀얼리스트,"SS소환禁止묘지",1,1)
		CALL SET_PLAYER_INFO(듀얼리스트,"SS소환禁止덱",1,1)
		CALL SET_PLAYER_INFO(듀얼리스트,"SS소환禁止EX덱",1,1)
		CALL SET_PLAYER_INFO(듀얼리스트,"SS소환禁止제외",1,1)
	ENDIF
ELSEIF 종류 == 短紋章起動
	CALL FULLRESET
	효과条件悪Ｃ所持 = 999
	CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"発無")
	CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"不材")
ELSEIF 종류 == 攻紋章起動
	FOR カウンタ, 0, 5
		選択カードID = GETVAR(@"%対面者%_필드:カウンタ")
		SIF 選択カードID < 1
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_悪Ｃ:カウンタ") < 1
			CONTINUE
		TRYCALLFORM CARD_{選択カードID}("攻撃力")
		攻撃力修正 = RESULT
		SIF 攻撃力修正 > 0
			CALL STATCHANGE_BASIC(対面者,"自身",カウンタ,-(攻撃力修正))
	NEXT
ENDIF