@CARDNAME_71671,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 내 손이 짜내는건 무진의 실
	CASE "略称"
		RESULTS = 짜내는건무진의실
	CASE "カテゴリ"
		RESULTS:0 = 메가 콜로니
		RESULTS:4 = 뱅가드
ENDSELECT

@CARD_71671(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 速攻마법
	CASE "추가日"
		RETURN 251010
ENDSELECT
RETURN 0

@CARDSUMMON_71671(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
RETURN 0

@CARD_EXPLANATION_71671(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 효과는 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,마함起動,손패起動,フリー誘発)
PRINTL ①：자신 필드 / 묘지에 "그레도라" 몬스터가 존재하는 경우에 발동할 수 있다。
PRINTL 이하의 효과에서 ２회까지 선택하여 적용할 수 있다。
PRINTL ●상대 필드의 몬스터에 놓인 악성 카운터를 １개 제거하고, 묘지에서 "메가 콜로니" 몬스터 １장을 특수 소환한다。
PRINTL ●묘지에서 "메가 콜로니" 몬스터 １장을 패에 넣는다。

@CARDCAN_71671(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ数

#DIM DYNAMIC 条件달성

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,71671)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,71671)
		RETURN 0
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 그레도라
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 메가 콜로니
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_71671(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC 条件A
#DIM DYNAMIC 条件B
#DIM DYNAMIC 選択효과

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71671,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		FOR カウンタ, 0, 2
			VARSET 条件A
			VARSET 条件B
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件カテゴリ = 메가 콜로니
			효과条件종류 = モン全般
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				条件A = 1
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과条件悪Ｃ所持 = 999
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲묘지 = 1
				효과条件カテゴリ = 메가 콜로니
				효과条件소환可 = 1
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				SIF RESULT == 1
					条件B = 1
			ENDIF
			IF 条件A == 1 && 条件B == 0 && カウンタ == 0
				選択효과 = 1
			ELSE
				IF 듀얼리스트 != "자신"
					選択효과 = 0
				ELSE
					PRINTFORML 효과를 선택해주세요。
					SIF 条件B == 1
						PRINTL [0] - ●상대 필드의 몬스터에게 놓인 악성 카운터를 １개 제거하고、묘지에서 "메가 콜로니" 몬스터 １장을 특수 소환한다。
					SIF 条件A == 1
						PRINTL [1] - ●묘지에서 "메가 콜로니" 몬스터 １장을 패에 넣는다。
					SIF カウンタ > 0
						PRINTL [2] - 선택하지 않는다
					BINPUT
					選択효과 = RESULT	
				ENDIF
			ENDIF
			IF 選択효과 == 1
				CALL FULLRESET
				효과範囲묘지 = 1
				효과条件カテゴリ = 메가 콜로니
				효과条件종류 = モン全般
				CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
			ELSEIF 選択효과 == 0
				PRINTL 악성 카운터를 제거할 몬스터를 선택해주세요。
				CALL FULLRESET
				효과条件悪Ｃ所持 = 999
				CALL CARD_CHOOSE_BASIC(듀얼리스트,"상대필드",ゾーン,場所)
				IF RESULT != 9999
					CALL SET_FIELD_INFO(対面者,"필드",RESULT,"悪Ｃ",-1)
					CALL FULLRESET
					효과範囲묘지 = 1
					효과条件カテゴリ = 메가 콜로니
					CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
				ENDIF
			ELSEIF 選択효과 == 2
				BREAK
			ENDIF
		NEXT
	ENDIF
ENDIF