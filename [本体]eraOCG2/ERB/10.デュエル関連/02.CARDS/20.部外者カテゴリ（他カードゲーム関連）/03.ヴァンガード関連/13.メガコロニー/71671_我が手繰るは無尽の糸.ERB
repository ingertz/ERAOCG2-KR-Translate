@CARDNAME_71671,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 내 손이 짜내는건 무진의 실
	CASE "略称"
		RESULTS = 짜내는건무진의실
	CASE "カテゴリ"
		RESULTS:0 = 메가 콜로니
		RESULTS:4 = 뱅가드
ENDSELECT

@CARD_71671(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "종류"
		RETURN 速攻마법
	CASE "추가日"
		RETURN 251010
ENDSELECT
RETURN 0

@CARDSUMMON_71671(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
RETURN 0

@CARD_EXPLANATION_71671(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の효과は１ターンに１度しか使用できない。
CALL CARD_ABLE(1,마함起動,손패起動,フリー誘発)
PRINTL ①：자신フィールド・묘지に「그레도라」モンスターが存在する場合に발동できる。
PRINTL 以下の효과から２回まで選んで適用する。
PRINTL ●상대フィールドのモンスターに置かれた悪性카운터を１つ取り除き、묘지から「메가 콜로니」モンスター１体を특수소환する。
PRINTL ●묘지から「메가 콜로니」モンスター１体を손패に加える。

@CARDCAN_71671(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ数

#DIM DYNAMIC 条件달성

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,71671)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,71671)
		RETURN 0
	IF ゾーン == "손패"
		SIF ターンプレイヤー != 듀얼리스트
			RETURN 0
	ELSEIF ゾーン == "마함"
		SIF 손패数(듀얼리스트) == 0
			RETURN 0
		SIF GETVAR(@"%듀얼리스트%_魔_表:場所") == 3
			RETURN 0
	ELSE
		RETURN 0
	ENDIF
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 그레도라
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 메가 콜로니
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_71671(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC 条件A
#DIM DYNAMIC 条件B
#DIM DYNAMIC 選択효과

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71671,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		FOR カウンタ, 0, 2
			VARSET 条件A
			VARSET 条件B
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件カテゴリ = 메가 콜로니
			효과条件종류 = モン全般
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				条件A = 1
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과条件悪Ｃ所持 = 999
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲묘지 = 1
				효과条件カテゴリ = 메가 콜로니
				효과条件소환可 = 1
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				SIF RESULT == 1
					条件B = 1
			ENDIF
			IF 条件A == 1 && 条件B == 0 && カウンタ == 0
				選択효과 = 1
			ELSE
				IF 듀얼리스트 != "자신"
					選択효과 = 0
				ELSE
					PRINTFORML 효과を選択してください。
					SIF 条件B == 1
						PRINTL [0] - ●상대フィールドのモンスターに置かれた悪性카운터を１つ取り除き、묘지から「메가 콜로니」モンスター１体を특수소환する。
					SIF 条件A == 1
						PRINTL [1] - ●묘지から「메가 콜로니」モンスター１体を손패に加える。
					SIF カウンタ > 0
						PRINTL [2] - 選択しない
					BINPUT
					選択효과 = RESULT	
				ENDIF
			ENDIF
			IF 選択효과 == 1
				CALL FULLRESET
				효과範囲묘지 = 1
				효과条件カテゴリ = 메가 콜로니
				효과条件종류 = モン全般
				CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
			ELSEIF 選択효과 == 0
				PRINTL 悪性카운터を取り除くモンスターを選択してください。
				CALL FULLRESET
				효과条件悪Ｃ所持 = 999
				CALL CARD_CHOOSE_BASIC(듀얼리스트,"상대필드",ゾーン,場所)
				IF RESULT != 9999
					CALL SET_FIELD_INFO(対面者,"필드",RESULT,"悪Ｃ",-1)
					CALL FULLRESET
					효과範囲묘지 = 1
					효과条件カテゴリ = 메가 콜로니
					CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
				ENDIF
			ELSEIF 選択효과 == 2
				BREAK
			ENDIF
		NEXT
	ENDIF
ENDIF