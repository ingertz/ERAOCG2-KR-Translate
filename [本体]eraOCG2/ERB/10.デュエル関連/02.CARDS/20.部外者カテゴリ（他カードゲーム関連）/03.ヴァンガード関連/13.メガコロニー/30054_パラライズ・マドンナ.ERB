@CARDNAME_30054,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 패럴라이즈 마돈나
	CASE "略称"
		RESULTS = Plyz 마돈나
	CASE "カテゴリ"
		RESULTS:0 = 메가 콜로니
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_30054(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 곤충족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 800
	CASE "성별"
		RETURN 牝性
ENDSELECT

RETURN 0

@CARD_EXPLANATION_30054(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,발동誘発)
PRINTL ①：상대 몬스터의 효과가 발동한 경우에 발동할 수 있다。
PRINTL 패 / 필드（앞면표시）의 이 몬스터와 이 카드 이외의 곤충족 몬스터 １장을 묘지로 보내고、그 발동을 무효로 한다。
CALL CARD_ABLE(2,필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지)
PRINTL ②：이 카드가 묘지에 보내진 경우에 발동할 수 있다。
PRINTL 덱에서 이 카드명 이외의 레벨４ 이하의 "메가 콜로니" 몬스터 １장을 패에 넣고、패를 １장 골라서 버린다。
PRINTL 이 효과를 발동하는 턴과 다음 턴、자신은 곤충족 몬스터밖에 특수 소환할 수 없다。

@CARDCAN_30054(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件A
#DIM DYNAMIC 条件B

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,30054)
SIF RESULT == 1
	RETURN 0
	
IF 종류 == 발동誘発
	SIF 발동済_1(듀얼리스트,30054)
		RETURN 0
	SIF !GROUPMATCH(ゾーン,"필드","손패")
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲필드 = 1
	효과条件他所 = 1
	효과条件표시 = 表側표시
	효과条件종족 = 곤충족
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	SIF 발동済_2(듀얼리스트,30054)
		RETURN 0
	CALL FULLRESET
	CALL 효과条件종족_ADV(곤충족, "以外")
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"SS이력")
	SIF RESULT != 0
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件固名前 = 패럴라이즈 마돈나
	효과条件カテゴリ = 메가 콜로니
	CALL 효과条件レベル_ADV(4,"以下")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン開始時予約
	RETURN 1
ENDIF

@CARDEFFECT_30054(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 最高攻撃力
#DIM DYNAMIC ドロー枚数
#DIM DYNAMIC 候補カード,5

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30054,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲필드 = 1
		효과条件他所 = 1
		효과条件표시 = 表側표시
		효과条件종족 = 곤충족
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")
			RETURN 1
		ENDIF
		RETURN 0
	ENDIF
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30054,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 메가 콜로니
		효과条件固名前 = 패럴라이즈 마돈나
		CALL 효과条件レベル_ADV(4,"以下")
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
		ENDIF
		CALL FULLRESET
		SS소환可能종족 = 곤충족
		CALL CARD_SS_RESTRICTION(듀얼리스트)
		CALL CARD_RESERV(듀얼리스트,30054,スタン予約)
	ENDIF
ELSEIF 종류 == ターン開始時予約
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30054)
	IF RESULT == 0
		CALL FULLRESET
		SS소환可能종족 = 곤충족
		CALL CARD_SS_RESTRICTION(듀얼리스트)
	ENDIF
ENDIF