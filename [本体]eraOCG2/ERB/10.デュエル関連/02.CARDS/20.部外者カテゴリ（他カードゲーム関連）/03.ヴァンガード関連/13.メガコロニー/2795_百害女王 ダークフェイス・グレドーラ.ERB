@CARDNAME_2795,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 이빌거버너 다크페이스 그레도라
	CASE "略称"
		RESULTS = 백해 그레도라
	CASE "カテゴリ"
		RESULTS:0 = 메가 콜로니
		RESULTS:1 = 다크페이스
		RESULTS:2 = 그레도라
		RESULTS:4 = 뱅가드
ENDSELECT


@CARD_2795(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 곤충족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 3000
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251010
ENDSELECT

RETURN 0

@CARDSUMMON_2795(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要링크数 = 3
素材条件종족 = 곤충족

IF EX参照 == 0 || EX参照 == 1 || EX参照 == 10
	素材条件링크:0 = 1
	素材条件링크:1 = 2
ENDIF

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = 메가 콜로니
ELSE
ENDIF

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,2795) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_2795(종류)
#DIM DYNAMIC 종류

PRINTL 「메가 콜로니」モンスターを含む곤충족モンスター３体
PRINTL このカード名の②③の효과はそれぞれ１ターンに１度しか使用できない。
CALL CARD_ABLE(0,지속효과,攻守変動)
PRINTL ①：상대フィールドの悪性카운터が置かれたモンスターは攻撃力が元々の攻撃力分ダウンし、발동無効を得る。
CALL CARD_ABLE(2,효과後誘発)
PRINTL ②：モンスターが특수소환した場合に、상대フィールドの表側표시のモンスター１体を대상として발동できる。
PRINTL 손패・フィールド（表側표시）の곤충족モンスター１体を묘지に送り、대상のモンスターに悪性카운터を１つ置く。
CALL CARD_ABLE(3,필드起動,フリー誘発)
PRINTL ③：자신・상대ターンに、以下の효과からいずれか１つを選択して발동できる。
PRINTL ●손패・フィールド（表側표시）のこのカード以外の곤충족モンスター１体を묘지に送り、
PRINTL 덱・묘지からレベル５以上の「메가 콜로니」モンスター１体を특수소환する。
PRINTL ●상대フィールドの悪性카운터が置かれたモンスター１体を대상として묘지に送り、
PRINTL 덱・묘지からレベル４以下の「메가 콜로니」モンスター１体を특수소환する。

@CARDCAN_2795(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件A
#DIM DYNAMIC 条件B

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,2795)
SIF RESULT == 1
	RETURN 0
	
IF 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트,2795)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환",2)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲필드 = 1
	효과条件표시 = 表側표시
	효과条件종족 = 곤충족
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	효과条件除去種 = 選択
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_3(듀얼리스트,2795)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	SIF モンスター数(듀얼리스트) < 5
		효과範囲손패 = 1
	효과範囲필드 = 1
	효과条件표시 = 表側표시
	효과条件종족 = 곤충족
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 1
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 메가 콜로니
		CALL 효과条件レベル_ADV(5,"以上")
		효과条件소환可 = 2
		효과条件종류 = レベル持ち
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件A = 1
	ENDIF
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	효과条件悪Ｃ所持 = 999
	효과条件除去種 = 選択
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 1
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 메가 콜로니
		CALL 효과条件レベル_ADV(4,"以下")
		효과条件소환可 = 1
		효과条件종류 = レベル持ち
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件B = 1
	ENDIF
	SIF 条件A + 条件B < 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과 || 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_2795(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC ドロー枚数
#DIM DYNAMIC 条件A
#DIM DYNAMIC 条件B
#DIM DYNAMIC 選択효과

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,2795,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲필드 = 1
		효과条件표시 = 表側표시
		효과条件종족 = 곤충족
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件표시 = 表側표시
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"選択")
			IF RESULT == 1
				CALL SET_FIELD_INFO(対面者,"필드",RESULT:1,"悪Ｃ",1)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,2795,3)
	IF RESULT == 0
		CALL FULLRESET
		SIF モンスター数(듀얼리스트) < 5
			효과範囲손패 = 1
		효과範囲필드 = 1
		효과条件표시 = 表側표시
		효과条件종족 = 곤충족
		효과条件他所 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ = 메가 콜로니
			CALL 효과条件レベル_ADV(5,"以上")
			효과条件소환可 = 2
			효과条件종류 = レベル持ち
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				条件A = 1
		ENDIF
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件표시 = 表側표시
		효과条件悪Ｃ所持 = 999
		효과条件除去種 = 選択
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ = 메가 콜로니
			CALL 효과条件レベル_ADV(4,"以下")
			효과条件소환可 = 1
			효과条件종류 = レベル持ち
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				条件B = 1
		ENDIF
		IF 条件A != 0 && 条件B != 0
			CALL YN_CHOICE(듀얼리스트,"●손패・場（表側표시）の他の곤충족モンスター１体묘지送り、덱・묘지からレベル５以上「메가 콜로니」モンスター１体특수소환","●상대の悪性카운터が置かれたモンスター１体대상묘지送り、덱・묘지からレベル４以下の「메가 콜로니」モンスター１体특수소환")
			選択효과 = RESULT
		ELSEIF 条件B == 1 && 条件A == 0
			選択효과 = いいえ
		ELSEIF 条件A == 1 && 条件B == 0
			選択효과 = はい
		ENDIF
		IF 選択효과 == はい
			CALL FULLRESET
			SIF モンスター数(듀얼리스트) < 5
				효과範囲손패 = 1
			효과範囲필드 = 1
			효과条件표시 = 表側표시
			효과条件종족 = 곤충족
			효과条件他所 = 1
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲덱 = 1
				효과範囲묘지 = 1
				효과条件カテゴリ = 메가 콜로니
				CALL 효과条件レベル_ADV(5,"以上")
				효과条件종류 = レベル持ち
				CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
		ELSEIF 選択효과 == いいえ
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과条件悪Ｃ所持 = 999
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"リリース")
			IF RESULT == 1
				CALL FULLRESET
				효과範囲덱 = 1
				효과範囲묘지 = 1
				효과条件カテゴリ = 메가 콜로니
				CALL 효과条件レベル_ADV(4,"以下")
				효과条件종류 = レベル持ち
				CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件悪Ｃ所持 = 999
	CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"発無")
ELSEIF 종류 == 攻守変動
	FOR カウンタ, 0, 5
		選択カードID = GETVAR(@"%対面者%_필드:カウンタ")
		SIF 選択カードID < 1
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_悪Ｃ:カウンタ") < 1
			CONTINUE
		TRYCALLFORM CARD_{選択カードID}("攻撃力")
		攻撃力修正 = RESULT
		SIF 攻撃力修正 > 0
			CALL STATCHANGE_BASIC(対面者,"自身",カウンタ,-(攻撃力修正))
	NEXT
ENDIF