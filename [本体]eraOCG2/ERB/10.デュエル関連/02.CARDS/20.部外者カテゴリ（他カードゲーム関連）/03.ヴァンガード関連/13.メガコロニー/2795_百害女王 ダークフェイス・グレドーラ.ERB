@CARDNAME_2795,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 이빌거버너 다크페이스 그레도라
	CASE "略称"
		RESULTS = 백해 그레도라
	CASE "カテゴリ"
		RESULTS:0 = 메가 콜로니
		RESULTS:1 = 다크페이스
		RESULTS:2 = 그레도라
		RESULTS:4 = 뱅가드
ENDSELECT


@CARD_2795(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 곤충족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 3000
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251010
ENDSELECT

RETURN 0

@CARDSUMMON_2795(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要링크数 = 3
素材条件종족 = 곤충족

IF EX参照 == 0 || EX参照 == 1 || EX参照 == 10
	素材条件링크:0 = 1
	素材条件링크:1 = 2
ENDIF

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = 메가 콜로니
ELSE
ENDIF

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,2795) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_2795(종류)
#DIM DYNAMIC 종류

PRINTL "메가 콜로니" 몬스터를 포함하는 곤충족 몬스터 ３장
PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(0,지속효과,攻守変動)
PRINTL ①：상대 필드의 악성 카운터가 놓인 몬스터는 공격력이 원래의 공격력 만큼 내리고 발동 무효를 얻는다.
CALL CARD_ABLE(2,효과後誘発)
PRINTL ②：몬스터가 특수 소환된 경우에 、상대 필드의 앞면 표시인 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 패 / 필드（앞면표시）의 곤충족 몬스터 １장을 묘지로 보내고、대상 몬스터에게 악성 카운터를 １개 놓는다。
CALL CARD_ABLE(3,필드起動,フリー誘発)
PRINTL ③：자신 / 상대 턴에、이하의 효과에서 １개를 선택하여 발동할 수 있다。
PRINTL ●패 / 필드（앞면표시）의 이 카드 이외의 곤충족 몬스터 １장을 묘지로 보내고、
PRINTL 덱 / 묘지에서 레벨５ 이상의 "메가 콜로니" 몬스터 １장을 특수 소환한다。
PRINTL ●상대 필드의 악성 카운터가 놓인 몬스터 １장을 대상으로 하여 묘지로 보내고、
PRINTL 덱 / 묘지에서 레벨４ 이하의 "메가 콜로니" 몬스터 １장을 특수 소환한다。

@CARDCAN_2795(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件A
#DIM DYNAMIC 条件B

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,2795)
SIF RESULT == 1
	RETURN 0
	
IF 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트,2795)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환",2)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲필드 = 1
	효과条件표시 = 表側표시
	효과条件종족 = 곤충족
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	효과条件除去種 = 選択
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_3(듀얼리스트,2795)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	SIF モンスター数(듀얼리스트) < 5
		효과範囲손패 = 1
	효과範囲필드 = 1
	효과条件표시 = 表側표시
	효과条件종족 = 곤충족
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 1
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 메가 콜로니
		CALL 효과条件レベル_ADV(5,"以上")
		효과条件소환可 = 2
		효과条件종류 = レベル持ち
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件A = 1
	ENDIF
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	효과条件悪Ｃ所持 = 999
	효과条件除去種 = 選択
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 1
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 메가 콜로니
		CALL 효과条件レベル_ADV(4,"以下")
		효과条件소환可 = 1
		효과条件종류 = レベル持ち
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件B = 1
	ENDIF
	SIF 条件A + 条件B < 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과 || 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_2795(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC ドロー枚数
#DIM DYNAMIC 条件A
#DIM DYNAMIC 条件B
#DIM DYNAMIC 選択효과

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,2795,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲필드 = 1
		효과条件표시 = 表側표시
		효과条件종족 = 곤충족
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件표시 = 表側표시
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"選択")
			IF RESULT == 1
				CALL SET_FIELD_INFO(対面者,"필드",RESULT:1,"悪Ｃ",1)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,2795,3)
	IF RESULT == 0
		CALL FULLRESET
		SIF モンスター数(듀얼리스트) < 5
			효과範囲손패 = 1
		효과範囲필드 = 1
		효과条件표시 = 表側표시
		효과条件종족 = 곤충족
		효과条件他所 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ = 메가 콜로니
			CALL 효과条件レベル_ADV(5,"以上")
			효과条件소환可 = 2
			효과条件종류 = レベル持ち
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				条件A = 1
		ENDIF
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件표시 = 表側표시
		효과条件悪Ｃ所持 = 999
		효과条件除去種 = 選択
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ = 메가 콜로니
			CALL 효과条件レベル_ADV(4,"以下")
			효과条件소환可 = 1
			효과条件종류 = レベル持ち
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				条件B = 1
		ENDIF
		IF 条件A != 0 && 条件B != 0
			CALL YN_CHOICE(듀얼리スト,"●패 / 필드（앞면표시）의 다른 곤충족 몬스터 １장 묘지보내고、덱 / 묘지에서 레벨５ 이상「메가 콜로니」몬스터 １장 특수 소환","●상대의 악성 카운터가 놓인 몬스터 １장을 대상으로 하여 묘지로 보내고、덱 / 묘지에서 레벨４ 이하의 「메가 콜로니」몬스터 １장을 특수 소환")
			選択효과 = RESULT
		ELSEIF 条件B == 1 && 条件A == 0
			選択효과 = いいえ
		ELSEIF 条件A == 1 && 条件B == 0
			選択효과 = はい
		ENDIF
		IF 選択효과 == はい
			CALL FULLRESET
			SIF モンスター数(듀얼리스트) < 5
				효과範囲손패 = 1
			효과範囲필드 = 1
			효과条件표시 = 表側표시
			효과条件종족 = 곤충족
			효과条件他所 = 1
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲덱 = 1
				효과範囲묘지 = 1
				효과条件カテゴリ = 메가 콜로니
				CALL 효과条件レベル_ADV(5,"以上")
				효과条件종류 = レベル持ち
				CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
		ELSEIF 選択효과 == いいえ
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과条件悪Ｃ所持 = 999
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"リリース")
			IF RESULT == 1
				CALL FULLRESET
				효과範囲덱 = 1
				효과範囲묘지 = 1
				효과条件カテゴリ = 메가 콜로니
				CALL 효과条件レベル_ADV(4,"以下")
				효과条件종류 = レベル持ち
				CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件悪Ｃ所持 = 999
	CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"発無")
ELSEIF 종류 == 攻守変動
	FOR カウンタ, 0, 5
		選択カードID = GETVAR(@"%対面者%_필드:カウンタ")
		SIF 選択カードID < 1
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_悪Ｃ:カウンタ") < 1
			CONTINUE
		TRYCALLFORM CARD_{選択カードID}("攻撃力")
		攻撃力修正 = RESULT
		SIF 攻撃力修正 > 0
			CALL STATCHANGE_BASIC(対面者,"自身",カウンタ,-(攻撃力修正))
	NEXT
ENDIF