@CARDNAME_30053,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 신성괴인 리틀 돌카스
	CASE "略称"
		RESULTS = 리틀 돌카스
	CASE "カテゴリ"
		RESULTS:0 = 메가 콜로니
		RESULTS:4 = 뱅가드
ENDSELECT


@CARD_30053(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 곤충족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1300
	CASE "守備力"
		RETURN 800
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251010
ENDSELECT

RETURN 0

@CARD_EXPLANATION_30053(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALL CARD_ABLE(1,소환時,특수소환時)
PRINTL ①：このカードが소환・특수소환した場合に발동できる。
PRINTL 덱からレベル４以下のこのカード名以外の곤충족モンスター１体を攻撃力０・守備力０・효과無効状態で특수소환する。
PRINTL この효과の발동後、자신は「다크페이스」モンスターしかＥＸ덱から특수소환できない。
CALL CARD_ABLE(2,필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지,제외時)
PRINTL ②：このカードが묘지に送られた、または제외された場合に발동できる。
PRINTL 묘지または제외状態の「신성괴인 리틀 돌카스」１体を손패に戻す。
PRINTL その後、자신フィールドに超越モンスターまたは「다크페이스」モンスターが存在しない場合、손패を１枚捨てる。
PRINTL この효과を발동するターン、자신は곤충족モンスターしか특수소환できない。

@CARDCAN_30053(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件A
#DIM DYNAMIC 条件B

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,30053)
SIF RESULT == 1
	RETURN 0
	
IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,30053)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종족 = 곤충족
	효과条件固名前 = 신성괴인 리틀 돌카스
	CALL 효과条件レベル_ADV(4,"以下")
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지 || 종류 == 제외時
	SIF 발동済_2(듀얼리스트,30053)
		RETURN 0
	CALL FULLRESET
	CALL 효과条件종족_ADV(곤충족, "以外")
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"SS이력")
	SIF RESULT != 0
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件名前 = 신성괴인 리틀 돌카스
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_30053(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 最高攻撃力
#DIM DYNAMIC ドロー枚数
#DIM DYNAMIC 候補カード,5

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30053,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종족 = 곤충족
		CALL 효과条件レベル_ADV(4,"以下")
		효과추가종류:0 = 効追無効
		효과추가종류:1 = 効追攻守０
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		CALL CARD_EX_RESTRICTION(듀얼리스트,"다크페이스")
	ENDIF
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30053,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲제외 = 1
		효과条件名前 = 신성괴인 리틀 돌카스
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件カテゴリ = 다크페이스
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT != 1
				CALL FULLRESET
				효과範囲필드 = 1
				효과条件カテゴリ = 뱅가드
				효과条件종류 = 초차원
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT != 1 && 손패数(듀얼리스트) >= 1
					CALL FULLRESET
					CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",場所)
				ENDIF
			ENDIF
		ENDIF
		CALL FULLRESET
		SS소환可能종족 = 곤충족
		CALL CARD_SS_RESTRICTION(듀얼리스트)
	ENDIF
ENDIF