@CARDNAME_30050,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 위압괴왕 다크페이스 알키데스
	CASE "略称"
		RESULTS = 알키데스
	CASE "カテゴリ"
		RESULTS:0 = 메가 콜로니
		RESULTS:1 = 다크페이스
		RESULTS:4 = 뱅가드
ENDSELECT


@CARD_30050(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 곤충족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 2800
	CASE "守備力"
		RETURN 2800
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251010
ENDSELECT

RETURN 0

@CARD_EXPLANATION_30050(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②③の효과はそれぞれ１ターンに１度しか使用できない。
CALL CARD_ABLE(1,필드起動,フリー誘発)
PRINTL ①：このモンスターが소환・특수소환したターンのメインフェイズに발동できる。
PRINTL 상대フィールドの悪性카운터が置かれていないモンスターの内、
PRINTL 最も攻撃力の高いモンスターに悪性카운터を１つ置き、ターン終了時まで발동無効を付与する。
CALL CARD_ABLE(2,효과後誘発)
PRINTL ②：モンスターの효과が발동した場合に、상대フィールドのカード１枚を대상として발동できる。
PRINTL 상대フィールドのモンスター１体に置かれた悪性카운터１つを取り除き、대상のカードを破壊する。
PRINTL その後、このカードの攻撃力を５００アップする。
CALL CARD_ABLE(3,필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지)
PRINTL ③：このカードが묘지に送られた場合に、자신フィールドに「그레도라」モンスターが存在する場合に발동できる。
PRINTL 손패・フィールド（表側표시）の「그레도라」モンスター以外の곤충족モンスター１体を묘지に送り、
PRINTL 묘지の「위압괴왕 다크페이스 알키데스」１体を특수소환する。

@CARDCAN_30050(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件A
#DIM DYNAMIC 条件B

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,30050)
SIF RESULT == 1
	RETURN 0
	
IF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,30050)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_条達:場所") < 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件悪Ｃ所持 = 888
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트,30050)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"효과발동",2)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件悪Ｃ所持 = 999
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환時強制 || 종류 == 특수소환時強制
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	SIF 발동済_3(듀얼리스트,30050)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 그레도라
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET	
	효과範囲필드 = 1
	SIF モンスター数(듀얼리스트) < 5
		효과範囲손패 = 1
	효과条件표시 = 表側표시
	효과条件固カテゴリ = 그레도라
	효과条件종족 = 곤충족
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件名前 = 위압괴왕 다크페이스 알키데스
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_30050(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 最高攻撃力
#DIM DYNAMIC ドロー枚数
#DIM DYNAMIC 候補カード,5

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30050,1)
	IF RESULT == 0
		FOR カウンタ, 0, 5
			選択カードID = GETVAR(@"%対面者%_필드:カウンタ")
			SIF 選択カードID < 1
				CONTINUE
			SIF GETVAR(@"%対面者%_MZ_悪Ｃ:カウンタ") > 0
				CONTINUE
			IF 最高攻撃力 == GETVAR(@"%対面者%_MZ_攻:カウンタ")
				候補カード:カウンタB = カウンタ
				カウンタB++
			ELSEIF 最高攻撃力 < GETVAR(@"%対面者%_MZ_攻:カウンタ")
				VARSET 候補カード
				VARSET カウンタB
				最高攻撃力 = GETVAR(@"%対面者%_MZ_攻:カウンタ")
				候補カード:カウンタB = カウンタ
				カウンタB++
			ENDIF
		NEXT
		選択カード = 候補カード:(RAND:カウンタB)
		CALL SET_FIELD_INFO(対面者,"필드",選択カード,"悪Ｃ",1)
		SIF GETVAR(@"%対面者%_MZ_発無:RESULT") < 1
			CALL SET_FIELD_INFO(対面者,"필드",RESULT,"発無",1,上書きモード)
	ENDIF
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30050,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件悪Ｃ所持 = 999
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"상대필드",ゾーン,場所)
		IF RESULT != 9999
			CALL SET_FIELD_INFO(対面者,"필드",RESULT,"悪Ｃ",-1)
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"全場単体",場所,"묘지")
			IF RESULT == 1
				CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"永攻",500)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 소환時強制 || 종류 == 특수소환時強制
	CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"条達",1,1)
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30050,3)
	IF RESULT == 0
		CALL FULLRESET
		SIF モンスター数(듀얼리스트) < 5
			효과範囲손패 = 1
		효과範囲필드 = 1
		효과条件표시 = 表側표시
		효과条件종족 = 곤충족
		효과条件固カテゴリ = 그레도라
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件名前 = 위압괴왕 다크페이스 알키데스
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF