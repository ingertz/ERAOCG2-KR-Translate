@CARDNAME_30050,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 위압괴왕 다크페이스 알키데스
	CASE "略称"
		RESULTS = 알키데스
	CASE "カテゴリ"
		RESULTS:0 = 메가 콜로니
		RESULTS:1 = 다크페이스
	CASE "出典作品"
		RESULTS:0 = 뱅가드
ENDSELECT


@CARD_30050(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 곤충족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 2800
	CASE "守備力"
		RETURN 2800
	CASE "성별"
		RETURN 雄性
ENDSELECT

RETURN 0

@CARD_EXPLANATION_30050(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,필드起動,フリー誘発)
PRINTL ①：이 몬스터가 소환 / 특수 소환된 턴의 메인 페이즈에 발동할 수 있다。
PRINTL 상대 필드의 악성 카운터가 놓이지 않은 몬스터 중、
PRINTL 가장 공격력이 높은 몬스터에게 악성 카운터를 １개 놓아、턴 종료시 까지 발동무효를 부여한다。
CALL CARD_ABLE(2,효과後誘発)
PRINTL ②：몬스터의 효과가 발동된 경우에、상대 필드의 카드 １장을 대상으로 하고 발동할 수 있다。
PRINTL 상대 필드의 몬스터 １장에게 놓인 악성 카운터 １개 제거하고、대상 카드를 파괴한다。
PRINTL 그 후、이 카드의 공격력을 ５００올린다。
CALL CARD_ABLE(3,필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지)
PRINTL ③：이 카드가 묘지로 보내진 경우에、자신 필드에 "그레도라" 몬스터가 존재하는 경우에 발동할 수 있다。
PRINTL 패 / 필드（앞면표시）의 "그레도라" 몬스터 이외의 곤충족 몬스터 １장을 묘지로 보내고、
PRINTL 묘지의 "위압괴왕 다크페이스 알키데스" １장을 특수 소환한다。

@CARDCAN_30050(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件A
#DIM DYNAMIC 条件B

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,30050)
SIF RESULT == 1
	RETURN 0
	
IF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,30050)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_条達:場所") < 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件悪Ｃ所持 = 888
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트,30050)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"효과발동",2)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件悪Ｃ所持 = 999
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환時強制 || 종류 == 특수소환時強制
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	SIF 발동済_3(듀얼리스트,30050)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 그레도라
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET	
	효과範囲필드 = 1
	SIF モンスター数(듀얼리스트) < 5
		효과範囲손패 = 1
	효과条件표시 = 表側표시
	효과条件固カテゴリ = 그레도라
	효과条件종족 = 곤충족
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件名前 = 위압괴왕 다크페이스 알키데스
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_30050(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 最高攻撃力
#DIM DYNAMIC ドロー枚数
#DIM DYNAMIC 候補カード,5

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30050,1)
	IF RESULT == 0
		FOR カウンタ, 0, 5
			選択カードID = GETVAR(@"%対面者%_필드:カウンタ")
			SIF 選択カードID < 1
				CONTINUE
			SIF GETVAR(@"%対面者%_MZ_悪Ｃ:カウンタ") > 0
				CONTINUE
			IF 最高攻撃力 == GETVAR(@"%対面者%_MZ_攻:カウンタ")
				候補カード:カウンタB = カウンタ
				カウンタB++
			ELSEIF 最高攻撃力 < GETVAR(@"%対面者%_MZ_攻:カウンタ")
				VARSET 候補カード
				VARSET カウンタB
				最高攻撃力 = GETVAR(@"%対面者%_MZ_攻:カウンタ")
				候補カード:カウンタB = カウンタ
				カウンタB++
			ENDIF
		NEXT
		選択カード = 候補カード:(RAND:カウンタB)
		CALL SET_FIELD_INFO(対面者,"필드",選択カード,"悪Ｃ",1)
		SIF GETVAR(@"%対面者%_MZ_発無:選択カード") < 1
			CALL SET_FIELD_INFO(対面者,"필드",選択カード,"発無",1,上書きモード)
		TRYCALLFORM CALLNAME_{GETVAR(@"%対面者%_필드:選択カード")}("名前")
		PRINTFORMW %RESULTS%『{選択カード}』에 악성 카운터가 １개 놓였습니다。
	ENDIF
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30050,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件悪Ｃ所持 = 999
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"상대필드",ゾーン,場所)
		IF RESULT != 9999
			CALL SET_FIELD_INFO(対面者,"필드",RESULT,"悪Ｃ",-1)
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"全場単体",場所,"묘지")
			IF RESULT == 1
				CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"永攻",500)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 소환時強制 || 종류 == 특수소환時強制
	CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"条達",1,1)
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30050,3)
	IF RESULT == 0
		CALL FULLRESET
		SIF モンスター数(듀얼리스트) < 5
			효과範囲손패 = 1
		효과範囲필드 = 1
		효과条件표시 = 表側표시
		효과条件종족 = 곤충족
		효과条件固カテゴリ = 그레도라
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件名前 = 위압괴왕 다크페이스 알키데스
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF