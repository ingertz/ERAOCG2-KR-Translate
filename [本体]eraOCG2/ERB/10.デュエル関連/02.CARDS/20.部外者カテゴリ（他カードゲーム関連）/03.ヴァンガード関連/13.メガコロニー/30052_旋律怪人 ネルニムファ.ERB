@CARDNAME_30052,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 선율괴인 넬님파
	CASE "略称"
		RESULTS = 넬님파
	CASE "カテゴリ"
		RESULTS:0 = 메가 콜로니
		RESULTS:4 = 뱅가드
ENDSELECT


@CARD_30052(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 곤충족
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 1300
	CASE "守備力"
		RETURN 2600
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251010
ENDSELECT

RETURN 0

@CARD_EXPLANATION_30052(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,손패起動,묘지起動)
PRINTL ①：자신 메인 페이즈에、상대 필드에 악성 카운터가 놓인 몬스터가 존재하는 경우에 발동할 수 있다。
PRINTL 패 / 묘지의 이 몬스터를 특수 소환한다。
PRINTL 그 후、묘지에서 이 몬스터를 특수 소환한 경우、패를 １장 버린다。
CALL CARD_ABLE(2,소환時,특수소환時)
PRINTL ②：이 카드가 소환 / 특수 소환된 경우에 발동할 수 있다。
PRINTL 상대는 자신의 필드의 몬스터 １장을 선택하고、악성 카운터를 １개 놓고、턴 종료시 까지 효과 무효를 부여한다。
PRINTL 이때、상대 필드에 악성 카운터가 놓여 있지 않은 몬스터가 존재하는 경우、상대는 그 몬스터를 선택해야 한다。
CALL CARD_ABLE(3,필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지)
PRINTL ③：이 카드가 묘지로 보내진 경우에 발동할 수 있다。
PRINTL 덱에서 레벨４ 이하의 곤충족 몬스터 １장을 특수 소환한다。
PRINTL 그 후、상대는 덱에서 레벨４ 이하의 몬스터 １장을 악성 카운터가 １개 놓인 상태로 특수 소환한다。
PRINTL 이 효과로 특수 소환된 몬스터는 효과 무효를 얻는다。
PRINTL 이 효과를 발동하는 턴、자신은 곤충족 몬스터밖에 특수 소환할 수 없다。

@CARDCAN_30052(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件A
#DIM DYNAMIC 条件B

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,30052)
SIF RESULT == 1
	RETURN 0
	
IF 종류 == 손패起動 || 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,30052)
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,30052,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件悪Ｃ所持 = 999
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,30052)
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	SIF 발동済_3(듀얼리스트,30052)
		RETURN 0
	CALL FULLRESET
	CALL 효과条件종족_ADV(곤충족, "以外")
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"SS이력")
	SIF RESULT != 0
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종족 = 곤충족
	CALL 효과条件レベル_ADV(4,"以下")
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_30052(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 最高攻撃力
#DIM DYNAMIC ドロー枚数
#DIM DYNAMIC 候補カード,5

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 손패起動 || 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30052,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
		IF ゾーン == "묘지"
			CALL FULLRESET
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30052,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件悪Ｃ所持 = 888
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件悪Ｃ所持 = 888
		ELSE
			CALL FULLRESET
		ENDIF
		CALL CARD_CHOOSE_BASIC(対面者,"필드",ゾーン,場所)
		IF RESULT != 9999
			CALL SET_FIELD_INFO(対面者,"필드",RESULT,"悪Ｃ",1)
			SIF GETVAR(@"%対面者%_MZ_無効:RESULT") < 1
				CALL SET_FIELD_INFO(対面者,"필드",RESULT,"無効",1,上書きモード)
		ENDIF
	ENDIF
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30052,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종족 = 곤충족
		CALL 효과条件レベル_ADV(4,"以下")
		효과추가종류 = 効追無効
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			CALL 효과条件レベル_ADV(4,"以下")
			효과추가종류 = 効追無効
			CALL CARD_SP_SUMMON_ADV(対面者,ゾーン,場所)
			IF RESULT == 1
				CALL SET_FIELD_INFO(対面者,"필드",カード소환先,"悪Ｃ",1)
			ENDIF
		ENDIF
		CALL FULLRESET
		SS소환可能종족 = 곤충족
		CALL CARD_SS_RESTRICTION(듀얼리스트)
	ENDIF
ENDIF