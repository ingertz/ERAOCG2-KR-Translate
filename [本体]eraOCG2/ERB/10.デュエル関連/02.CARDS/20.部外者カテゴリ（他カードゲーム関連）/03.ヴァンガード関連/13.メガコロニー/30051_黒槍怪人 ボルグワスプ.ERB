@CARDNAME_30051,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 흑창괴인 볼그 와스프
	CASE "略称"
		RESULTS = 볼그 와스프
	CASE "カテゴリ"
		RESULTS:0 = 메가 콜로니
		RESULTS:4 = 뱅가드
ENDSELECT


@CARD_30051(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 곤충족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 2600
	CASE "守備力"
		RETURN 1300
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251010
ENDSELECT

RETURN 0

@CARD_EXPLANATION_30051(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,손패起動,묘지起動)
PRINTL ①：자신 메인 페이즈에 발동할 수 있다。
PRINTL 패 / 필드（앞면표시）의 "그레도라" 몬스터 이외의 곤충족 몬스터 １장을 묘지로 보내고、
PRINTL 패 / 묘지의 이 몬스터를 특수 소환한다。
CALL CARD_ABLE(0,지속효과)
PRINTL ②：자신 필드의 "다크페이스" 몬스터는 파괴 내성을 얻는다。
CALL CARD_ABLE(2,필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지)
PRINTL ③：이 카드가 묘지로 보내진 경우에 발동할 수 있다。
PRINTL 묘지에서 곤충족 몬스터 ２장을 제외하고、덱에서 "흑창괴인 볼그 와스프" １장을 특수 소환한다。


@CARDCAN_30051(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件A
#DIM DYNAMIC 条件B

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,30051)
SIF RESULT == 1
	RETURN 0
	
IF 종류 == 손패起動 || 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,30051)
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,30051,ゾーン,1)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET	
	효과範囲필드 = 1
	SIF モンスター数(듀얼리스트) < 5
		효과範囲손패 = 1
	효과条件표시 = 表側표시
	효과条件固カテゴリ = 그레도라
	효과条件종족 = 곤충족
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	SIF 발동済_2(듀얼리스트,30051)
		RETURN 0
	CALL FULLRESET	
	효과範囲묘지 = 1
	효과条件종족 = 곤충족
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件名前 = 흑창괴인 볼그 와스프
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_30051(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 最高攻撃力
#DIM DYNAMIC ドロー枚数
#DIM DYNAMIC 候補カード,5

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 손패起動 || 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30051,1)
	IF RESULT == 0
		CALL FULLRESET
		SIF モンスター数(듀얼리스트) < 5
			효과範囲손패 = 1
		효과範囲필드 = 1
		효과条件표시 = 表側표시
		효과条件종족 = 곤충족
		효과条件固カテゴリ = 그레도라
		효과条件他所 = 1
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件カテゴリ = 다크페이스
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"破耐")
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30051,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종족 = 곤충족
		효과条件行先플래그 = 제외行き
		효과条件複数 = 2
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件名前 = 흑창괴인 볼그 와스프
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF