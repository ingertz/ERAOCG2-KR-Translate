@CARDNAME_73987,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 영혼을 꿰뚫는 황세의 정재
	CASE "略称"
		RESULTS = 황세의 정재
	CASE "カテゴリ"
		RESULTS:0 = 심판의 문장
		RESULTS:4 = DUEL MASTERS
	CASE "検索カテゴリ"
		RESULTS:0 = 메탈리카
ENDSELECT


@CARD_73987(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 지속마법
	CASE "추가日"
		RETURN 251018
ENDSELECT
RETURN 0


@CARD_EXPLANATION_73987(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 카드는 １턴에 １번밖에 발동할 수 없으며、이 카드명의 ②③의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動 ,손패起動)
PRINTL ①：이 카드의 발동시의 효과 처리로서、상대 필드 위의 코스트８ 이하의 몬스터 １장을 원래 주인의 마법&함정 존에 놓는다。
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：이 카드가 패에 존재하고、"영혼을 꿰뚫는 황세의 정재" 이외의 "심판의 문장" 카드가 드로우 이외의 방법으로 패에 넣어진 경우、
PRINTL 패의 "영혼을 꿰뚫는 황세의 정재" 이외의 "심판의 문장" 카드 １장을 묘지로 보내고 발동할 수 있다。
PRINTL 이 카드의 ①의 효과를 적용하고、가능하면 이 카드를 마법&함정 존에 앞면 표시로 놓고、놓지 못하는 경우엔 묘지로 보낸다。
CALLFORM CARD_ABLE(3,발동誘発)
PRINTL ③：상대가 몬스터의 효과를 발동했을 때、필드의 이 카드를 패로 되돌리고 발동할 수 있다。
PRINTL 상대 필드 위의 앞면 표시 몬스터를 １장까지 고르고、그 코스트를 １로 한다。
PRINTL 자신 필드 위에 드래곤족인 "메탈리카" 몬스터가 존재하는 경우、추가로 이 카드가 체인한 효과를 무효로 한다。


@CARDCAN_73987(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,73987)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	IF 종류 == 마함起動
		SIF GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
			RETURN 0
	ENDIF
	SIF 발동済_1(듀얼리스트,73987)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	CALL 효과条件レベル_ADV(8,"以下")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트,73987)
		RETURN 0
	SIF ゾーン != "손패"
		RETURN 0
	CALL FULLRESET
	효과条件カテゴリ = 심판의 문장
	효과条件固ID = 73987
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"효과手送")
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	CALL 효과条件レベル_ADV(8,"以下")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 발동誘発
	SIF 발동済_3(듀얼리스트,73987)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0	
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ENDIF


@CARDEFFECT_73987(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73987,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		CALL FULLRESET
		효과条件표시 = 表側표시
		CALL 효과条件レベル_ADV(8,"以下")
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"마함")
	ENDIF

ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73987,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件カテゴリ = 심판의 문장
		효과条件固ID = 73987
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件표시 = 表側표시
			CALL 효과条件レベル_ADV(8,"以下")
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"마함")
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		ENDIF
	ENDIF

ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73987,3)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,손패行き)
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件종족 = 드래곤족
		효과条件カテゴリ = メタリカ
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")	
		ENDIF
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件표시 = 表側표시
		효과条件任意 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"選択")
		IF RESULT == 1
			CALL CARD_SELECT(듀얼리스트, RESULT:1)
			選択カード = RESULT
			CALL SET_FIELD_INFO(対面者,"필드",選択カード,"永星",1,1)
		ENDIF
	ENDIF
	
ENDIF
