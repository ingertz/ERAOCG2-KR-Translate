@CARDNAME_30791,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = DG-인류가 만들어낸 것-
	CASE "略称"
		RESULTS = 인류가 만든것
	CASE "カテゴリ"
		RESULTS:0 = 메탈리카
		RESULTS:4 = DUEL MASTERS
	CASE "検索カテゴリ"
		RESULTS:0 = 심판의 문장
ENDSELECT


@CARD_30791(参照先)
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 1900
	CASE "守備力"
		RETURN 2100
	CASE "추가日"
		RETURN 251018
ENDSELECT
RETURN 0


@CARD_EXPLANATION_30791(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②③의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,攻守変動,손패起動)
PRINTL ①：이 카드를 소환할 때의 레벨은、자신 / 상대의 마법&함정 존의 몬스터 카드 또는 "심판의 문장" 카드의 수 만큼 내려간다。
PRINTL 이 카드의 소환하는 레벨이 ３이하인 경우、이 카드를 패에서 특수 소환할 수 있다。
CALLFORM CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ②：서로의 메인 페이즈에 발동할 수 있다。
PRINTL 자신 마법&함정 존의 앞면 표시인 "심판의 문장" 카드 １장과、상대 필드의 카드 １장을 패로 되돌린다。
CALLFORM CARD_ABLE(3,ターン終了時)
PRINTL ③：서로의 턴 종료시에、자신 / 상대의 마법&함정 존의 몬스터 카드 또는
PRINTL "심판의 문장" 카드가 합계 ２장 이상 존재하는 경우에 발동할 수 있다。
PRINTL 이 카드를 파괴하고、자신의 패 / 덱에서 "DG-인류가 만들어낸 것-" 이외의 원소정령족인 "메탈리카" 몬스터 １장을 특수 소환한다。

@CARDCAN_30791(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 攻撃力판정

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,30791)
SIF RESULT == 1
	RETURN 0

IF 종류 == 攻守変動
	SIF ゾーン != "손패"
		RETURN 0
	RETURN 1

ELSEIF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,30791)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_手_一星:場所") <= 2
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,30791,"손패")
	SIF RESULT == 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_2(듀얼리스트,30791)
		RETURN 0	
	SIF ゾーン != "필드"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件カテゴリ = 심판의 문장
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == ターン終了時
	SIF 발동済_3(듀얼리스트,30791)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과条件종족 = 원소정령족
	효과条件カテゴリ = 메탈리카
	효과条件固ID = 30791
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과範囲상대마함 = 1
	효과条件종류 = モン全般
	효과条件スーパーカテゴリ = 심판의 문장
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0
	RETURN 1

ENDIF


@CARDEFFECT_30791(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 軽減数

IF 종류 == 攻守変動
	CALL FULLRESET
	효과範囲마함 = 1
	효과範囲상대마함 = 1
	효과条件표시 = 表側표시
	효과条件종류 = モン全般
	효과条件スーパーカテゴリ = 심판의 문장
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所,30791)
	軽減数 = RESULT
	CALL FULLRESET
	CALL STATCHANGE_HAND(듀얼리스트,"지정",場所,"一星",軽減数)

ELSEIF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30791,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트, "손패", 場所)
	ENDIF

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30791,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲마함 = 1
		효과条件표시 = 表側표시
		효과条件カテゴリ = 심판의 문장
		효과条件行先플래그 = 손패行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"全場単体",場所,"손패")
		ENDIF
	ENDIF

ELSEIF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30791,3)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,破壊行き)
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲덱 = 1
		효과条件종족 = 원소정령족
		효과条件カテゴリ = 메탈리카
		효과条件固ID = 30791
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ENDIF
