@CARDNAME_30790,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 삿바크DG
	CASE "略称"
		RESULTS = 삿바크DG
	CASE "カテゴリ"
		RESULTS:0 = 메탈리카
		RESULTS:4 = DUEL MASTERS
	CASE "検索カテゴリ"
		RESULTS:0 = 심판의 문장
ENDSELECT


@CARD_30790(参照先)
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"

		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 2400
	CASE "守備力"
		RETURN 2300
	CASE "추가日"
		RETURN 251018
ENDSELECT
RETURN 0


@CARD_EXPLANATION_30790(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②③의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時 ,특수소환時)
PRINTL ①：이 카드가 소환 / 특수 소환된 경우에 발동할 수 있다。
PRINTL 자신의 덱 위에서 카드를 ２장 뒤집고、그 안에서 "메탈리카" "심판의 문장" 카드를 전부 패에 넣는다。
CALLFORM CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ②：서로의 메인 페이즈에、자신 / 상대의 마법&함정 존의 몬스터 카드 또는
PRINTL "심판의 문장" 카드가 합계 ３장 이상 존재하는 경우에 발동할 수 있다。
PRINTL 이 카드를 파괴하고、자신의 패 / 덱에서 드래곤족 / 빛속성 몬스터 １장을 특수 소환한다。
CALLFORM CARD_ABLE(3,ターン終了時)
PRINTL ③：서로의 턴 종료시에 발동할 수 있다。이하의 효과에서 １개를 선택해서 적용한다。
PRINTL ●자신 마법&함정 존의 앞면 표시의 "심판의 문장" 카드 １장을 패로 되돌린다。
PRINTL ●자신 패의 "심판의 문장" 카드 １장을 、마법&함정 존에 앞면표시로 놓는다。


@CARDCAN_30790(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성,2

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,30790)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,30790)
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_2(듀얼리스트,30790)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과条件속성 = 빛속성
	효과条件종족 = 드래곤족
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과範囲상대마함 = 1
	효과条件종류 = モン全般
	효과条件スーパーカテゴリ = 심판의 문장
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 3
		RETURN 0
	RETURN 1

ELSEIF 종류 == ターン終了時
	SIF 발동済_3(듀얼리스트,30790)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件カテゴリ = 심판의 문장
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		条件달성:0 = 1
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件カテゴリ = 심판의 문장
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		条件달성:1 = 1
	SIF 条件달성:0 != 1 && 条件달성:1 != 1
		RETURN 0
	RETURN 1

ENDIF


@CARDEFFECT_30790(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 選択結果

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30790,1)
	IF RESULT == 0
		CALL FULLRESET
		효과条件カテゴリ = 메탈리카
		효과条件スーパーカテゴリ = 심판의 문장
		효과条件複数 = 98
		CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所,2)
	ENDIF

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30790,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,破壊行き)
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲덱 = 1
		효과条件속성 = 빛속성
		효과条件종족 = 드래곤족
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,30790,3)
		CALL FULLRESET
		효과範囲마함 = 1
		효과条件표시 = 表側표시
		효과条件カテゴリ = 심판의 문장
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件달성 |= 1
		
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件カテゴリ = 심판의 문장
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件달성 |= 2

		IF 条件달성 & 1 && 条件달성 & 2
			IF 듀얼리스트 == "상대"
				選択結果 = はい
			ELSE
				PRINTL 어느 효과를 사용하시겠습니까？
				CALL YN_CHOICE(듀얼리스트,"●자신 마법&함정 존의 앞면표시의「심판의 문장」카드 １장을 패로 되돌린다。","●자신 패의「심판의 문장」카드 １장을、마법&함정 존에 앞면표시로 놓는다。")
				選択結果 = RESULT
			ENDIF
		ELSEIF 条件달성 & 1
			選択結果 = はい
		ELSE
			選択結果 = いいえ
		ENDIF

		IF 選択結果 == はい
			CALL FULLRESET
			효과範囲마함 = 1
			효과条件표시 = 表側표시
			효과条件カテゴリ = 심판의 문장
			효과条件行先플래그 = 손패行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		ELSE
			CALL FULLRESET
			효과範囲손패 = 1
			효과条件カテゴリ = 심판의 문장
			CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"表側표시")
		ENDIF

ENDIF
