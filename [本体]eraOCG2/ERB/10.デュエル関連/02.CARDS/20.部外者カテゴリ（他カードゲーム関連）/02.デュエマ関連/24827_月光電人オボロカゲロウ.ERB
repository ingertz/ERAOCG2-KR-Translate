@CARDNAME_24827,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 월광전인 오보로 카게로우
	CASE "略称"
		RESULTS = 오보로 카게로우
	CASE "カテゴリ"
		RESULTS:0 = 그레이트 메카오
		RESULTS:4 = DUEL MASTERS
ENDSELECT


@CARD_24827(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"

		RETURN 효과モン
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 600
	CASE "守備力"
		RETURN 600
ENDSELECT

RETURN 0

@CARD_EXPLANATION_24827(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時,특수소환時)
PRINTL ①：이 카드가 소환 / 특수 소환된 경우에 발동할 수 있다。
PRINTL 자신 필드 / 묘지의 몬스터의 속성 종류의 수 만큼 자신은 드로우한다。
PRINTL 그 후、드로우 한 수만큼 자신의 패를 골라 원하는 순서대로 덱아래로 되돌린다。

@CARDCAN_24827(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,24827)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,24827)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_24827(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC ドロー数
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24827,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件속성 = 빛속성
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			ドロー数 ++
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件속성 = 바람속성
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			ドロー数 ++
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件속성 = 물속성
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			ドロー数 ++
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件속성 = 땅속성
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			ドロー数 ++
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件속성 = 화염속성
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			ドロー数 ++
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件속성 = 어둠속성
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			ドロー数 ++
		CALL CARDDRAW_BASIC(듀얼리스트,ドロー数)
		;うららとかで止められたらおわり
		SIF 손패数(듀얼리스트) < ドロー数
			RETURN 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件複数 = ドロー数
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF
