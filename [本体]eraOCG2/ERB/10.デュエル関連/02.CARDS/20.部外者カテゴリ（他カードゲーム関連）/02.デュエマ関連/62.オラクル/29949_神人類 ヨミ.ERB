@CARD_EXPLANATION_29949(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動,필드起動)
PRINTL ①：【G・MAXIMUM！！】「오라클」モンスターまたは「갓 노바」モンスター×２
PRINTL 손패・フィールドに存在するほかの「오라클」モンスターまたは「갓 노바」モンスター２枚を書き換え、맥시멈소환を行う。
PRINTL 맥시멈소환は無効化されない。
CALLFORM CARD_ABLE(2,특수소환時)
PRINTL ②：このカードが특수소환した場合に발동できる。
PRINTL 자신フィールドの「오라클」モンスターまたは「갓 노바」モンスターの종류の数だけ자신の덱の上からカードをめくる。
PRINTL その中のカード１枚を選んで손패に加え、残りのカードは덱に戻す。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：このカードは攻撃誘導を持ち、他の「오라클」モンスターまたは「갓 노바」モンスターは대상耐性を得る。
PRINTL このカードが맥시멈状態の場合、자신は효과ダメージを受けない。


@CARDCAN_29949(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,29949)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動 || 종류 == 필드起動
	SIF 발동済_1(듀얼리스트,29949)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲필드 = 1
	효과条件他所 = 1
	효과条件カテゴリ:0 = 오라클
	효과条件カテゴリ:1 = 갓 노바
	효과条件CNT = 1	
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0
	RETURN 1
ELSEIF 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,29949)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ:0 = 오라클
	효과条件カテゴリ:1 = 갓 노바
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 맥시멈条件
	SIF GETVAR(@"%듀얼리스트%_필드:2") != 29949
		RETURN 0
	TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_필드:1")}("カテゴリ")
	SIF !MATCH(RESULTS,"좌G 링크")
		RETURN 0
	TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_필드:3")}("カテゴリ")
	SIF !MATCH(RESULTS,"우G 링크")
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_29949(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC めくり数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動 || 종류 == 필드起動
	효과無効不能 = 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,29949,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲필드 = 1
		효과条件他所 = 1
		효과条件カテゴリ:0 = 오라클
		효과条件カテゴリ:1 = 갓 노바
		효과条件複数 = 2
		효과条件行先플래그 = 소멸行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,소멸行き)
			FOR カウンタ,0,5
				SIF GETVAR(@"%듀얼리스트%_필드:カウンタ") == -1
					CONTINUE
				CALL CARD_DISPOSE(듀얼리스트,"필드",カウンタ)
			NEXT
			CALL FULLRESET
			CALL CARD_GENERATE(듀얼리스트,29949,"攻撃표시")
			IF 듀얼리스트 == "자신"
				PRINTL どのモンスターを특수소환しますか？
				PRINTL
				PRINTL [0] - 봉마좌신 리버틴즈
				PRINTL [1] - 妖精左神パールジャム
				PRINTL [2] - 성령좌신 저스티스
				BINPUT
			ELSE
				RESULT = RAND:3
			ENDIF

			IF RESULT == 0
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,129948,"守備표시")
			ELSEIF RESULT == 1
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,229945,"守備표시")
			ELSEIF RESULT == 2
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,229948,"守備표시")
			ENDIF

			IF 듀얼리스트 == "자신"
				PRINTL どのモンスターを특수소환しますか？
				PRINTL
				PRINTL [0] - 폭렬우신 스트록스
				PRINTL [1] - 戦攻右神マッシヴ・アタック
				PRINTL [2] - 악마우신 다프트 펑크
				BINPUT
			ELSE
				RESULT = RAND:3
			ENDIF

			IF RESULT == 0
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,129950,"守備표시")
			ELSEIF RESULT == 1
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,229947,"守備표시")
			ELSEIF RESULT == 2
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,229950,"守備표시")
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,29949,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ:0 = 오라클
		효과条件カテゴリ:1 = 갓 노바
		효과条件固名前起動 = 1;CARDCHECK_ADV専用
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		めくり数 = RESULT

		CALL FULLRESET
		CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所,めくり数)
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件カテゴリ:0 = 오라클
	효과条件カテゴリ:1 = 갓 노바
	효과条件他所 = 1
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"対耐")
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"攻誘")
ELSEIF 종류 == 맥시멈条件
	CALL SET_PLAYER_INFO(듀얼리스트,"효과ダメージ無効",3)
ENDIF




