		RESULTS = 신인류 요미
	CASE "略称"
		RESULTS = 신인류요미
	CASE "カテゴリ"
		RESULTS:0 = 오라클
		RESULTS:1 = 갓 노바
		RESULTS:4 = DUEL MASTERS
		RESULTS:5 = 갓
		RESULTS:6 = 중앙G 링크
	CASE "맥시멈"
		RESULTS = 중앙G 링크
ENDSELECT


@CARD_29949(参照先)

#DIMS DYNAMIC 参照先
