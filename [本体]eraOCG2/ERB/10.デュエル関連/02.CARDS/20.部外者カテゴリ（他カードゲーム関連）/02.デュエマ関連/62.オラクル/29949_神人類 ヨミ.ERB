VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"

		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 3000
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 雄性
	CASE "レア度"
		RETURN SPR
	CASE "生成カード"
		RESULT:3 = 229950
		RESULT:2 = 229948
		RESULT:1 = 129950
		RETURN 129948
ENDSELECT
RETURN 0

@CARD_EXPLANATION_29949(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動,필드起動)
PRINTL ①：【G・MAXIMUM！！】"오라클" 몬스터 또는 "갓 노바" 몬스터×２
PRINTL 패 / 필드에 존재하는 다른 "오라클" 몬스터 또는 "갓 노바" 몬스터 ２장을 덮어씌워、맥시멈 소환한다。
PRINTL 맥시멈 소환은 무효화 되지 않는다。
CALLFORM CARD_ABLE(2,특수소환時)
PRINTL ②：이 카드가 특수 소환된 경우에 발동할 수 있다。
PRINTL 자신 필드의 "오라클" 몬스터 또는 "갓 노바" 몬스터의 종류의 수 만큼 자신의 덱 위에서 카드를 뒤집는다。
PRINTL 그 안에서 카드 １장을 골라 패에 넣고、남은 카드는 덱으로 되돌린다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：이 카드는 공격 유도를 가지며、다른 "오라클" 몬스터 또는 "갓 노바" 몬스터는 대상내성을 얻는다。
PRINTL 이 카드가 맥시멈 상태인 경우、자신은 효과 데미지를 받지 않는다。


@CARDCAN_29949(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,29949)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動 || 종류 == 필드起動
	SIF 발동済_1(듀얼리스트,29949)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲필드 = 1
	효과条件他所 = 1
	효과条件カテゴリ:0 = 오라클
	효과条件カテゴリ:1 = 갓 노바
	효과条件CNT = 1	
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0
	RETURN 1
ELSEIF 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,29949)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ:0 = 오라클
	효과条件カテゴリ:1 = 갓 노바
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 맥시멈条件
	SIF GETVAR(@"%듀얼리스트%_필드:2") != 29949
		RETURN 0
	TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_필드:1")}("カテゴリ")
	SIF !MATCH(RESULTS,"좌G 링크")
		RETURN 0
	TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_필드:3")}("カテゴリ")
	SIF !MATCH(RESULTS,"우G 링크")
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_29949(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC めくり数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動 || 종류 == 필드起動
	효과無効不能 = 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,29949,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲필드 = 1
		효과条件他所 = 1
		효과条件カテゴリ:0 = 오라클
		효과条件カテゴリ:1 = 갓 노바
		효과条件複数 = 2
		효과条件行先플래그 = 소멸行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,소멸行き)
			FOR カウンタ,0,5
				SIF GETVAR(@"%듀얼리스트%_필드:カウンタ") == -1
					CONTINUE
				CALL CARD_DISPOSE(듀얼리스트,"필드",カウンタ)
			NEXT
			CALL FULLRESET
			CALL CARD_GENERATE(듀얼리스트,29949,"攻撃표시")
			IF 듀얼리스트 == "자신"
				PRINTL 어느 몬스터를 특수 소환하시겠습니까？
				PRINTL
				PRINTL [0] - 봉마좌신 리버틴즈
				PRINTL [1] - 요정좌신 펄 잼
				PRINTL [2] - 성령좌신 저스티스
				BINPUT
			ELSE
				RESULT = RAND:3
			ENDIF

			IF RESULT == 0
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,129948,"守備표시")
			ELSEIF RESULT == 1
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,229945,"守備표시")
			ELSEIF RESULT == 2
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,229948,"守備표시")
			ENDIF

			IF 듀얼리스트 == "자신"
				PRINTL 어느 몬스터를 특수 소환하시겠습니까？
				PRINTL
				PRINTL [0] - 폭렬우신 스트록스
				PRINTL [1] - 전공우신 매시브 어택
				PRINTL [2] - 악마우신 다프트 펑크
				BINPUT
			ELSE
				RESULT = RAND:3
			ENDIF

			IF RESULT == 0
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,129950,"守備표시")
			ELSEIF RESULT == 1
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,229947,"守備표시")
			ELSEIF RESULT == 2
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,229950,"守備표시")
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,29949,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ:0 = 오라클
		효과条件カテゴリ:1 = 갓 노바
		효과条件固名前起動 = 1;CARDCHECK_ADV専用
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		めくり数 = RESULT

		CALL FULLRESET
		CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所,めくり数)
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件カテゴリ:0 = 오라클
	효과条件カテゴリ:1 = 갓 노바
	효과条件他所 = 1
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"対耐")
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"攻誘")
ELSEIF 종류 == 맥시멈条件
	CALL SET_PLAYER_INFO(듀얼리스트,"효과ダメージ無効",3)
ENDIF




