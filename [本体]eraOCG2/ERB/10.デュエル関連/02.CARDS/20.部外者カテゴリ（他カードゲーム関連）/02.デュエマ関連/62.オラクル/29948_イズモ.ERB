CALLFORM CARD_ABLE(1,손패起動,필드起動)
PRINTL ①：【G・MAXIMUM！！】"오라클" 몬스터 또는 "갓 노바" 몬스터×２
PRINTL 패 / 필드에 존재하는 다른 "오라클" 몬스터 또는 "갓 노바" 몬스터 ２장을 덮어씌워、맥시멈 소환한다。
PRINTL 맥시멈 소환은 무효화되지 않는다。


@CARDCAN_29946(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,29946)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動 || 종류 == 필드起動
	SIF 발동済_1(듀얼리스트,29946)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲필드 = 1
	효과条件他所 = 1
	효과条件カテゴリ:0 = 오라클
	효과条件カテゴリ:1 = 갓 노바
	효과条件CNT = 1	
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0
	RETURN 1
ELSEIF 종류 == 맥시멈条件
	SIF GETVAR(@"%듀얼리스트%_필드:2") != 29946
		RETURN 0
	TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_필드:1")}("カテゴリ")
	SIF !MATCH(RESULTS,"좌G 링크")
		RETURN 0
	TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_필드:3")}("カテゴリ")
	SIF !MATCH(RESULTS,"우G 링크")
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_29946(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC めくり数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動 || 종류 == 필드起動
	효과無効不能 = 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,29946,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲필드 = 1
		효과条件他所 = 1
		효과条件カテゴリ:0 = 오라클
		효과条件カテゴリ:1 = 갓 노바
		효과条件複数 = 2
		효과条件行先플래그 = 소멸行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,소멸行き)
			FOR カウンタ,0,5
				SIF GETVAR(@"%듀얼리스트%_필드:カウンタ") == -1
					CONTINUE
				CALL CARD_DISPOSE(듀얼리스트,"필드",カウンタ)
			NEXT
			CALL FULLRESET
			CALL CARD_GENERATE(듀얼리스트,29946,"攻撃표시")
			IF 듀얼리스트 == "자신"
				PRINTL 어느 몬스터를 특수 소환하시겠습니까？
				PRINTL
				PRINTL [0] - 쌍마좌신 디보
				PRINTL [1] - 요정좌신 펄 잼
				BINPUT
			ELSE
				RESULT = RAND:2
			ENDIF

			IF RESULT == 0
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,129945,"守備표시")
			ELSEIF RESULT == 1
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,229945,"守備표시")
			ENDIF

			IF 듀얼리스트 == "자신"
				PRINTL 어느 몬스터를 특수 소환하시겠습니까？
				PRINTL
				PRINTL [0] - 쌍천우신 크라프트베르크
				PRINTL [1] - 전공우신 매시브 어택
				BINPUT
			ELSE
				RESULT = RAND:2
			ENDIF

			IF RESULT == 0
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,129947,"守備표시")
			ELSEIF RESULT == 1
				CALL FULLRESET
				CALL CARD_GENERATE(듀얼리스트,229947,"守備표시")
			ENDIF
		ENDIF
	ENDIF
ENDIF




