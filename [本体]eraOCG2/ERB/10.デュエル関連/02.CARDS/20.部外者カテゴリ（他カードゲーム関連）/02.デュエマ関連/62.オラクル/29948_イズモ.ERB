	CASE "略称"
		RESULTS = 매시브 어택
	CASE "カテゴリ"
		RESULTS:0 = 어스 이터
		RESULTS:1 = 갓 노바
		RESULTS:4 = DUEL MASTERS
		RESULTS:5 = 갓
		RESULTS:6 = 우G 링크
	CASE "맥시멈"
		RESULTS = 우G 링크
ENDSELECT


@CARD_229947(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 1000
	CASE "守備力"
		RETURN 1500
	CASE "파츠"
		RETURN 1
ENDSELECT
RETURN 0

@CARD_EXPLANATION_229947(종류)
#DIM DYNAMIC 종류

PRINTL （맥시멈 상태인 이 카드는 공격할 수 없다）
PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
