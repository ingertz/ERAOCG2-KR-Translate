@CARDNAME_73991,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 월하卍괴 가 류미즈
	CASE "略称"
		RESULTS = 가 류미즈
	CASE "カテゴリ"
		RESULTS:0 = 돌스자크
	CASE "出典作品"
		RESULTS:0 = DUEL MASTERS
ENDSELECT


@CARD_73991(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"

		RETURN 通常마법
	CASE "レア度"
		RETURN ULR
ENDSELECT

RETURN 0

@CARD_EXPLANATION_73991(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드는 다른 카드의 효과로만 발동할 수 있다。
CALLFORM CARD_ABLE(0,마함起動 ,손패起動)
PRINTL ①：패 / 묘지 / EX덱에서 "돌스자크" 몬스터를 ４장까지 특수 소환한다。
PRINTL 그 후、다음 상대 턴을 스킵한다。

@CARDCAN_73991(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,73991)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_73991(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

IF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73991)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		SETCOLOR C_BLUE
		PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
		PRINTL
		PRINTFORML 『월하卍괴 가 류미즈 卍！！』
		PRINTL
		CUSTOMDRAWLINE ―
		RESETCOLOR
		PRINTFORMW 
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲묘지 = 1
		효과範囲EX덱 = 1
		효과範囲제외 = 1
		효과条件任意 = 1
		효과条件カテゴリ = 돌스자크
		효과条件複数 = 96
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		SETCOLOR C_BLUE
		PRINTFORML >>——MESSAGE:——————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————————>>>
		PRINTL
		PRINTFORML %듀얼리스트%는 추가 턴을 얻었습니다。
		PRINTL
		CUSTOMDRAWLINE ―
		RESETCOLOR
		PRINTFORMW 
		CALL FULLRESET
		CALL SET_PLAYER_INFO(듀얼리스트,"ターンスキップ",1,1)
	ENDIF
ENDIF
