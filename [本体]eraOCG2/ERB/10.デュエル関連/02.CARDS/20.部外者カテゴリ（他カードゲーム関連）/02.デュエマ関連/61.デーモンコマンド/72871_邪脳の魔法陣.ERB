@CARDNAME_72871,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 사뇌의 마법진
	CASE "略称"
		RESULTS = 사뇌
	CASE "カテゴリ"
		RESULTS:0 = 사신
	CASE "出典作品"
		RESULTS:0 = DUEL MASTERS
ENDSELECT


@CARD_72871(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 1
	CASE "종류"
		RETURN 지속마법
	CASE "生成カード"
		RETURN 172871
ENDSELECT

RETURN 0

@CARD_EXPLANATION_72871(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 １턴에 １번、어느쪽인가 １개밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動,마함起動)
PRINTL ①：자신의 덱 위에서 카드를 ３장 묘지로 보낸다。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②：자신 필드의 앞면 표시 몬스터가 존재하지 않는 경우、또는 악마족 몬스터만인 경우、
PRINTL 묘지의 이 카드를 제외하고 발동할 수 있다。자신 필드에 "락식 토큰" １장을 특수 소환한다。
PRINTL 이 턴、자신은 악마족 몬스터밖에 특수 소환할 수 없다。

@CARDCAN_72871(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72871)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,72871)
		RETURN 0
	SIF 발동済_2(듀얼리스트,72871)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 3
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,72871)
		RETURN 0
	SIF 발동済_2(듀얼리스트,72871)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	SIF モンスター数(듀얼리스트) != 0
		条件달성 ++
	CALL FULLRESET
	효과範囲필드 = 1
	CALLFORM 효과条件종족_ADV(악마족, "以外")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		条件달성 ++
	SIF 条件달성 >= 2
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_72871(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72871,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL CARD_DECK_DISPOSE(듀얼리스트,"덱",3)
	ENDIF
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72871,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		CALL CARD_GENERATE(듀얼리스트,172871)
		SS소환可能종족 = 악마족
		CALL CARD_SS_RESTRICTION(듀얼리스트)
	ENDIF
ENDIF

