@CARDNAME_2337,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 로렐 라이미
	CASE "略称"
		RESULTS = 로렐 라이미
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_2337(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 0
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 바다생물족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1100
	CASE "守備力"
		RETURN 500
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251201
ENDSELECT
RETURN 0

@CARD_EXPLANATION_2337(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,손패起動,묘지起動)
PRINTL ①：제외状態のカードが５枚以上存在する場合に발동できる。
PRINTL 손패・묘지のこのカードを특수소환する。
CALLFORM CARD_ABLE(2,소환時,특수소환時)
PRINTL ②：このカードが소환・특수소환した場合、상대の묘지のカード１枚を대상として발동できる。
PRINTL そのカードを제외する。
PRINTL この효과でモンスターを제외した場合、さらにその同名モンスターをお互いの손패・덱・묘지からすべて제외する。


@CARDCAN_2337(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,2337)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動 || 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,2337)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,2337,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲제외 = 1
	효과範囲상대제외 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 5
		RETURN 0
	RETURN 1

ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,2337)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대묘지 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_2337(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード_ID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動 || 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,2337,1)
	IF RESULT == 0
		CALL FULLRESET
		IF ゾーン == "손패"
			효과範囲손패 = 1
		ELSEIF ゾーン == "묘지"
			효과範囲묘지 = 1
		ENDIF
		효과条件名前 = 로렐 라이미
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,2337,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대묘지 = 1
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			選択カード_ID = RESULT:1
			TRYCALLFORM CARD_{RESULT:1},"종류"
			SIF RESULT < モン全般
				RETURN 0

			FOR カウンタ,0,紙束最大値
				SIF GETVAR(@"%듀얼리스트%_손패:カウンタ") != 選択カード_ID
					CONTINUE
				CALL CARD_DISPOSE(듀얼리스트,"손패",カウンタ,제외行き)
			NEXT
			FOR カウンタ,0,紙束最大値
				SIF GETVAR(@"%듀얼리스트%_덱:カウンタ") != 選択カード_ID
					CONTINUE
				CALL CARD_DISPOSE(듀얼리스트,"덱",カウンタ,제외行き)
			NEXT
			FOR カウンタ,0,紙束最大値
				SIF GETVAR(@"%듀얼리스트%_묘지:カウンタ") != 選択カード_ID
					CONTINUE
				CALL CARD_DISPOSE(듀얼리스트,"묘지",カウンタ,제외行き)
			NEXT
			
			FOR カウンタ,0,紙束最大値
				SIF GETVAR(@"%対面者%_손패:カウンタ") != 選択カード_ID
					CONTINUE
				CALL CARD_DISPOSE(対面者,"손패",カウンタ,제외行き)
			NEXT
			FOR カウンタ,0,紙束最大値
				SIF GETVAR(@"%対面者%_덱:カウンタ") != 選択カード_ID
					CONTINUE
				CALL CARD_DISPOSE(対面者,"덱",カウンタ,제외行き)
			NEXT
			FOR カウンタ,0,紙束最大値
				SIF GETVAR(@"%対面者%_묘지:カウンタ") != 選択カード_ID
					CONTINUE
				CALL CARD_DISPOSE(対面者,"묘지",カウンタ,제외行き)
			NEXT
		ENDIF
	ENDIF
ENDIF


