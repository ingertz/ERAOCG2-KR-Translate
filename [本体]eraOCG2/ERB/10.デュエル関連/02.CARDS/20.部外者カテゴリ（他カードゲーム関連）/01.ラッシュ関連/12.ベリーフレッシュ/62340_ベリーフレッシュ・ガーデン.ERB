@CARDNAME_62340,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 베리프레쉬 가든
	CASE "略称"
		RESULTS = Berry 가든
	CASE "カテゴリ"
		RESULTS:0 = 베리프레쉬
ENDSELECT


@CARD_62340(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN フィールド
	CASE "추가日"
		RETURN 251012
ENDSELECT

RETURN 0

@CARD_EXPLANATION_62340(종류)
#DIM DYNAMIC 종류

PRINTL 자신 필드는 "베리프레쉬 가든"이 된다。
PRINTL 이 카드명의 카드는 １턴에 １장밖에 발동할 수 없다。
CALLFORM CARD_ABLE(1,마함起動 ,손패起動)
PRINTL ①：이 카드의 발동시의 효과 처리로서、덱에서 「베리프레쉬」카드 １장을 패에 넣을 수 있다。
CALLFORM CARD_ABLE(10,지속효과)
PRINTL ②：자신의 묘지에 "베리프레쉬" 몬스터가 ４장 이상 존재하는 경우、
PRINTL 자신의 "베리프레쉬" Ｘ몬스터는 상대 몬스터의 효과를 받지 않는다。

@CARDCAN_62340(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,62340)
SIF RESULT == 1
	RETURN 0
IF 종류 == 마함起動 || 종류 == 손패起動
	IF 종류 == 마함起動
		SIF GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
			RETURN 0
	ENDIF
	SIF 발동済_1(듀얼리스트,62340)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_62340(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 選択カード名

IF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,62340,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		CALL FULLRESET
		효과条件カテゴリ = 베리프레쉬
		효과条件任意 = 1
		CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所)
	ENDIF
ELSEIF 종류 == 지속효과
	CALL SET_FIELD_MAGIC_INFO(듀얼리스트, "베리프레쉬 가든")
	
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 베리프레쉬
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT > 3
		CALL FULLRESET
		효과条件종류 = 엑시즈
		효과条件カテゴリ = 베리프레쉬
		CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"モ耐")
	ENDIF
ENDIF

