@CARDNAME_62309,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 레전드 어드벤트
	CASE "略称"
		RESULTS = 영혼의 강림
	CASE "カテゴリ"
		RESULTS:0 = 레전드
		RESULTS:1 = 의식 마법
ENDSELECT


@CARD_62309(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 0
	CASE "종류"
		RETURN 通常마법
	CASE "추가日"
		RETURN 20251201
ENDSELECT

RETURN 0

@CARD_EXPLANATION_62309(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①：자신 필드의 몬스터를 소재로서 릴리스하고、
PRINTL "레전드" 리추얼 몬스터 １장을 ＥＸ덱에서 의식 소환한다。
PRINTL 자신의 필드 / 묘지에 레벨７ 이상인 "레전드" 몬스터가 존재하는 경우、덱의 몬스터도 소재로 할 수 있다。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②："레전드 어드벤트" 이외의 자신 묘지의 "레전드" 카드 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 카드를 덱 가장 아래로 되돌리고、묘지의 이 카드를 패에 넣는다。


@CARDCAN_62309(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,62309)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,62309)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 레전드
	CALLFORM 효과条件レベル_ADV(7,"以上")
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		条件달성 = 1

	CALL RESETAREA_MAT
	素材範囲필드 = 1
	SIF 条件달성 == 1
		素材範囲덱 = 1
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件カテゴリ = 레전드
	효과条件종류 = 초차원
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 묘지起動
	SIF 발동済_2(듀얼리스트,72160)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 레전드
	효과条件固名前 = 레전드 어드벤트
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_62309(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID



IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,62309,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과条件カテゴリ = 레전드
		효과条件종류 = 초차원
		효과条件소환可 = 2
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			選択カード_ID = RESULT:99
			CALL RESETAREA_MAT
			TRYCALLFORM CARDSUMMON_{選択カード_ID}(듀얼리스트,選択カード)
			素材範囲필드 = 1
			TRYCALLFORM RITSUMMON(듀얼리스트, 選択カード,"EX덱")
		ENDIF
	ENDIF

ELSEIF 종류 == ターン開始時	
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,62309,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 레전드
		효과条件固名前 = 레전드 어드벤트
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件名前 = 레전드 어드벤트
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF
