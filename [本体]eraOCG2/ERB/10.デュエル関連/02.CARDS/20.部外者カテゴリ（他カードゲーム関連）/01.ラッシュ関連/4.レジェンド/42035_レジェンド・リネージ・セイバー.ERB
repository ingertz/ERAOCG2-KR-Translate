@CARDNAME_42035,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 레전드 리니지 세이버
	CASE "略称"
		RESULTS = R 세이버
	CASE "カテゴリ"
		RESULTS:0 = 레전드
		RESULTS:1 = 리추얼
ENDSELECT


@CARD_42035(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 0
	CASE "종류"
		RETURN 초차원
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RESULT:1 = 천사족
		RETURN 전사족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 3000
	CASE "守備力"
		RETURN 300
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251201
ENDSELECT

RETURN 0


@CARD_EXPLANATION_42035(종류)
#DIM DYNAMIC 종류

PRINTL "레전드" 의식 마법 카드에 의해 강림。
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,필드起動)
PRINTL ①：덱 가장 위의 카드를 묘지로 보내고 발동할 수 있다。
PRINTL 이 턴、자신 필드의 "레전드" 몬스터의 공격력은 ５００오른다。
PRINTL 그 후、자신의 묘지에 몬스터（빛속성／레벨７）가 ３장 이상 존재하는 경우、
PRINTL 자신 묘지의 "레전드" 몬스터 １장을 특수 소환할 수 있다。
CALLFORM CARD_ABLE(2,戦破壊→묘지)
PRINTL ②：이 카드가 상대에 의해 필드에서 벗어난 경우에 발동할 수 있다。
PRINTL 덱 / 묘지에서 전사족 "레전드" 몬스터 １장을 특수 소환한다。

@CARDSUMMON_42035(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要レベル数 = 10

IF EX参照 == 1
	CALL RITCAN(듀얼리스트,소환カード,42035) 
	RETURN RESULT
ENDIF

@CARDCAN_42035(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,42035)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動
	SIF 발동済_1(듀얼리스트,42035)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 現山札数(듀얼리스트) == 0
		RETURN 0
	RETURN 1

ELSEIF 종류 == 戦破壊→묘지
	SIF 발동済_2(듀얼리스트,42035)
		RETURN 0
	SIF 処理中_듀얼리스트 != 対面者 && 묘지送り종류 != "戦闘"
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 레전드
	효과条件종족 = 전사족
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻紋章起動
	RETURN 1
ENDIF

@CARDEFFECT_42035(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,42035,1)
	IF RESULT == 0
		CALL CARD_DECK_DISPOSE(듀얼리스트,"덱",1)
		CALL CARD_RESERV(듀얼리스트,42035,攻紋章予約)

		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件속성 = 빛속성
		효과条件レベル = 7
		효과条件종류 = モン全般
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT < 3
			RETURN 0
		
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 레전드
		효과条件任意 = 1
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,42035,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 레전드
		효과条件종족 = 전사족
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 攻紋章起動
	CALL FULLRESET
	효과条件カテゴリ = 레전드
	CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,500)
ENDIF