@CARDNAME_73656,参照先
;ココで지정カードの名前、略称を返す予定6
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 트랜잠 네뷸라 퓨전
	CASE "略称"
		RESULTS = 성운 융합
	CASE "カテゴリ"
		RESULTS:0 = 트랜잠
		RESULTS:1 = 융합
ENDSELECT


@CARD_73656(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
	CASE "추가日"
		RETURN 260109
ENDSELECT
RETURN 0

@CARD_EXPLANATION_73656(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,마함起動,손패起動)
PRINTL ①：자신의 패 / 필드의 몬스터를 융합素材として、융합モンスター（미확인족・빛속성）１体をＥＸ덱에서 융합 소환한다。
PRINTL このターン中、이 카드의 ②の효과를 使用している場合、대신에 이하의 효과를 適用する。
PRINTL ●자신의 묘지 / 제외 상태인 몬스터를 융합素材として덱に戻し、융합モンスター（미확인족）１体をＥＸ덱에서 융합 소환한다。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②：자신 묘지의 융합몬스터 １장을 제외하고 발동할 수 있다。
PRINTL 묘지의 이 카드를 패에 넣는다。

@CARDCAN_73656(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,73656)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0

	IF 발동済_2(듀얼리스트,73656)
		CALL RESETAREA_MAT
		素材範囲묘지 = 1
		素材範囲제외 = 1
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件종류 = 융합
		효과条件종족 = 미확인족
		효과条件소환可 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ELSE
		CALL RESETAREA_MAT
		素材範囲필드 = 1
		素材範囲손패 = 1
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件종류 = 융합
		효과条件속성 = 빛속성
		효과条件종족 = 미확인족
		효과条件소환可 = 2
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ENDIF
	RETURN 1

ELSEIF 종류 == 묘지起動
	SIF 발동済_2(듀얼리스트, 73656)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종류 = 융합
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_73656(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 選択カード名前

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73656)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		IF 발동済_2(듀얼리스트,73656)
			CALL RESETAREA_MAT
			素材範囲묘지 = 1
			素材範囲제외 = 1
			CALL FULLRESET
			효과条件종류 = 융합
			효과条件종족 = 미확인족
			효과条件소환可 = 1
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
			IF 選択カード != 9999
				選択カード = RESULT
				TRYCALLFORM CARDSUMMON_{RESULT:99}(듀얼리스트,選択カード)
				CALL FUSSUMMON(듀얼리스트,選択カード,덱行き)
			ENDIF
		ELSE
			CALL RESETAREA_MAT
			素材範囲필드 = 1
			素材範囲손패 = 1
			CALL FULLRESET
			효과条件종류 = 융합
			효과条件속성 = 빛속성
			효과条件종족 = 미확인족
			효과条件소환可 = 2
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
			IF 選択カード != 9999
				選択カード = RESULT
				TRYCALLFORM CARDSUMMON_{RESULT:99}(듀얼리스트,選択カード)
				CALL FUSSUMMON(듀얼리스트,選択カード)
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73656,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종류 = 융합
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件名前 = 트랜잠 네뷸라 퓨전
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF
