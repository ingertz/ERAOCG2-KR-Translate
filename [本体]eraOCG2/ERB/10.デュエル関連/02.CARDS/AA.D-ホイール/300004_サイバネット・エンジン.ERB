@CARDNAME_300004,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 사이바넷 엔진
	CASE "略称"
		RESULTS = 사이바넷 엔진
	CASE "カテゴリ"
		RESULTS:0 = 엔진
ENDSELECT


@CARD_300004(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN システム
ENDSELECT

RETURN 0

@CARD_EXPLANATION_300004(종류)
#DIM DYNAMIC 종류

CALLFORM CARD_ABLE(0,소환強制誘発)
PRINTL ①：자신이 L소환할 때마다 스피드 카운터를 １개 늘린다。
PRINTL 
PRINTL 비고：시간이 허락하는 한 무한히 사고하는 AI를 동력원으로 하여、적은 에너지로 최고율의 결과를 뽑아내는 기계엔진。
PRINTL 　　　링크 소환할 때엔 데이터 부하가 발생하기 때문에、그 때에 이상 출력을 허가한다。



@CARDCAN_300004(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,300004)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환強制誘発
	SIF 最終소환決者 != 듀얼리스트
		RETURN 0
	SIF 最終소환타입 != "EX특수"
		RETURN 0
	TRYCALLFORM CARD_{最終소환ID}("종류")
	SIF !GROUPMATCH(RESULT,싱크로)
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_300004(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択肢

IF 종류 == 소환強制誘発
	CALL SET_PLAYER_INFO(듀얼리스트,"SpＣ",1,0,1)
ENDIF
