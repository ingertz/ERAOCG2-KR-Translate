@CARDNAME_58247,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = CNo.39 유토피아 레이 빅토리
	CASE "略称"
		RESULTS = C#39 레이 Vic
	CASE "カテゴリ"
		RESULTS:0 = 넘버즈
		RESULTS:1 = 유토피아
		RESULTS:2 = 카오스
ENDSELECT


@CARD_58247(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 전사족 
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 2800
	CASE "守備力"
		RETURN 2500
	CASE "추가日"
		RETURN 251002
ENDSELECT
RETURN 0

@CARDSUMMON_58247(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 3
素材条件レベル = 5
;추가효과用
지정素材カテゴリ = 希望皇ホープ

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,58247) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_58247(종류)
#DIM DYNAMIC 종류

PRINTL レベル５モンスター×３
CALLFORM CARD_ABLE(0,EX소환時)
PRINTL ①：자신の묘지に「ＲＵＭ」カードが存在し、このカードがＸ소환した場合に발동できる。
PRINTL このカード以外のフィールドの全てのカードの효과を無効にする。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：このカードが攻撃する場合、상대はダメージステップ終了時までカードの효과を발동できない。
CALLFORM CARD_ABLE(0,攻撃時誘発)
PRINTL ③：このカードが表側표시モンスターと戦闘を行う攻撃宣言時に、このカードのＸ素材を１つ取り除いて발동できる。
PRINTL ターン終了時まで、このカードの攻撃力はその상대モンスターの攻撃分アップし、その상대モンスターの효과は無効化される。
PRINTL このカードが「希望皇ホープ」モンスターをＸ素材としてＸ소환している場合、
PRINTL さらに손패・덱・묘지から「ＺＷ」モンスター１体をこのカードに装備できる。

@CARDCAN_58247(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,58247)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX소환時
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = RUM
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	IF 듀얼리스트 == "자신"
		효과範囲필드 = 1
		효과範囲마함 = 1
	ENDIF
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件표시 = 表側표시
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃時誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF 戦闘場所(듀얼리스트,1) == 5
		RETURN 0
	SIF GETVAR(@"%対面者%_MZ_表:戦闘場所(듀얼리스트,1)") == 3
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_58247(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,58247)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"지속無効")
	ENDIF

ELSEIF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,58247,0,X消費1)
	IF RESULT == 0
		攻撃力修正 = GETVAR(@"%対面者%_MZ_攻:戦闘場所(듀얼리스트,1)")
		CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"一攻",攻撃力修正)
		IF GETVAR(@"%対面者%_MZ_無効:戦闘場所(듀얼리스트,1)") < 1
			CALL SET_FIELD_INFO(対面者,"필드",戦闘場所(듀얼리스트,1),"無効",1)
		ENDIF
		SIF GETVAR(@"%듀얼리스트%_MZ_条達:場所") < 1 || 마함数(듀얼리스트) >= 5
			RETURN 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = ゼアル・ウェポン
		효과条件任意 = 1
		CALL CARD_EQUIP_MONSTER_ADV(듀얼리스트,ゾーン,場所,,58247)
	ENDIF

ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦阻")
ENDIF