@CARDNAME_58230,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = No.39 유토피아 루츠
	CASE "略称"
		RESULTS = #39 루츠
	CASE "カテゴリ"
		RESULTS:0 = 넘버즈
		RESULTS:1 = 유토피아
ENDSELECT


@CARD_58230(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 전사족 
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 500
	CASE "守備力"
		RETURN 100
	CASE "추가日"
		RETURN 250927
ENDSELECT

RETURN 0
@CARDSUMMON_58230(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 99

素材条件レベル = 1
素材条件数自由 = 1

;추가효과用

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,58230) 
	RETURN RESULT
ENDIF



