@CARDNAME_38182,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 가디언 실
	CASE "略称"
		RESULTS = Guardian 실
	CASE "カテゴリ"
		RESULTS:0 = 가디언
ENDSELECT


@CARD_38182(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1700
	CASE "守備力"
		RETURN 1400
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 250931
ENDSELECT
RETURN 0

@CARD_EXPLANATION_38182(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の③の효과は１ターンに１度しか使用できない。
CALL CARD_ABLE(0,손패起動)
PRINTL ①：자신のフィールド・묘지に「유성의 활－실」が存在する場合に발동できる。
PRINTL このカードを손패から특수소환する。
CALL CARD_ABLE(0,소환時,특수소환時)
PRINTL ②：このカードが소환・특수소환した場合に발동できる。
PRINTL 덱・묘지から「유성의 활－실」１枚をこのカードに装備する。
CALL CARD_ABLE(3,필드起動,フリー誘発,ライフ変強制誘発)
PRINTL ③：お互いのターンに、자신フィールドの装備마법カード１枚を묘지へ送るか、このカードが直接攻撃した場合に발동できる。
PRINTL 상대フィールドのカード１枚を破壊する。


@CARDSUMMON_AA_38182


@CARDCAN_38182(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,38182)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,38182,"손패")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件표시 = 表側표시
	효과条件名前 = 유성의 활－실
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件名前 = 유성의 활－실
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発 || 종류 == ライフ変強制誘発
	SIF 발동済_3(듀얼리스트,38182)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	IF 종류 == 필드起動 || 종류 == フリー誘発
		CALL FULLRESET
		효과範囲마함 = 1
		효과条件종류 = 装備마법
		효과条件표시 = 表側표시
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	
	ELSEIF 종류 == ライフ変強制誘発
		SIF ダメージ受者 == 듀얼리스트
			RETURN 0
		SIF ダメージ종류 != "直接戦闘"
			RETURN 0
		SIF 戦闘場所(듀얼리스트) != 場所
			RETURN 0
	ENDIF
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_38182(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名前

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,38182)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン, 場所)
	ENDIF

ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,38182)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件名前 = 유성의 활－실
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)	
		IF RESULT != 9999
			CALL CARD_SELECT(듀얼리스트,RESULT)
			選択カード = RESULT
			CALL CARD_EQUIP_MONSTER(듀얼리스트,場所,参照先（CS）,選択カード)
		ENDIF
	ENDIF

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発 || 종류 == ライフ変強制誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,38182,3)
	IF RESULT == 0
		IF 종류 == 필드起動 || 종류 == フリー誘発
			CALL FULLRESET
			효과範囲마함 = 1
			효과条件종류 = 装備마법
			효과条件표시 = 表側표시
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			SIF RESULT != 1
				RETURN 0
		ENDIF
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
	ENDIF
ENDIF


