@CARDNAME_38183,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 가디언 바오우
	CASE "略称"
		RESULTS = 바오우
	CASE "カテゴリ"
		RESULTS:0 = 가디언
ENDSELECT


@CARD_38183(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 800
	CASE "守備力"
		RETURN 400
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 250931
ENDSELECT
RETURN 0

@CARD_EXPLANATION_38183(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①の효과は１ターンに１度しか使用できない。
CALL CARD_ABLE(1,묘지起動)
PRINTL ①：자신のフィールド・묘지に「파사의 대검－바오우」が存在する場合に발동できる。
PRINTL このカードを묘지から특수소환する。
CALL CARD_ABLE(0,소환時,특수소환時)
PRINTL ②：このカードが소환・특수소환した場合に발동できる。
PRINTL 덱・묘지から「파사의 대검－바오우」１枚をこのカードに装備する。
CALL CARD_ABLE(10,攻撃後誘発)
PRINTL ③：１ターンに１度、このカードが戦闘でモンスターを破壊した場合に발동できる。
PRINTL このカードの攻撃力はそのモンスターの元々の攻撃分アップし、このターンもう一度攻撃できる。


@CARDSUMMON_AA_38183


@CARDCAN_38183(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,38183)
SIF RESULT == 1
	RETURN 0

IF 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,38183)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,38183,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件표시 = 表側표시
	효과条件名前 = 파사의 대검－바오우
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件名前 = 파사의 대검－바오우
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃後誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF 直前戦闘破壊ID(듀얼리스트,1) == 0
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_38183(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名前

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,38183,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 가디언 바오우
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン, 場所)
	ENDIF

ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,38183)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件名前 = 파사의 대검－바오우
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)	
		IF RESULT != 9999
			CALL CARD_SELECT(듀얼리스트,RESULT)
			選択カード = RESULT
			CALL CARD_EQUIP_MONSTER(듀얼리스트,場所,参照先（CS）,選択カード)
		ENDIF
	ENDIF

ELSEIF 종류 == 攻撃後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,38183,10)
	IF RESULT == 0
		TRYCALLFORM CARD_{直前戦闘破壊ID(듀얼리스트,1)},"攻撃力"
		CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"永攻",RESULT)
		CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"戦",1)
	ENDIF
ENDIF


