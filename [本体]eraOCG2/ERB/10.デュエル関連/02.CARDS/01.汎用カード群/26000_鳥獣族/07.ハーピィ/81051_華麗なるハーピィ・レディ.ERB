@CARDNAME_81051,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 화려한 해피 레이디
	CASE "略称"
		RESULTS = 화려한 해피
	CASE "カテゴリ"
		RESULTS:0 = 해피
ENDSELECT


@CARD_81051(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 251114
ENDSELECT

RETURN 0

@CARD_EXPLANATION_81051(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動,フリー誘発)
PRINTL ①：자신 필드의 "해피 레이디 세자매" １장을 골라 원래 주인의 덱으로 되돌린다。
PRINTL 그 후、자신의 패 / 덱 / 묘지에서 "해피 레이디 세자매" 이외의
PRINTL "해피" 몬스터 ３장을 특수 소환할 수 있다（같은 이름은 １장까지）。
PRINTL 이 카드의 발동 후、턴 종료시가지 자신은 바람속성 몬스터밖에 특수 소환할 수 없다。
CALLFORM CARD_ABLE(2,破壊→묘지,戦闘→묘지)
PRINTL ②：마법＆함정 존의 이 카드가 효과로 파괴된 경우에 발동할 수 있다。
PRINTL 덱에서 "해피" 몬스터 １장을 패에 넣는다。



@CARDCAN_81051(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,81051)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == フリー誘発
	SIF ゾーン != "마함"
		RETURN 0
	SIF 발동済_1(듀얼리스트,81051)
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件名前 = 해피 레이디 세자매
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	SIF 발동済_2(듀얼리스트,81051)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 해피
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_81051(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

IF 종류 == 마함起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,81051,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件名前 = 해피 레이디 세자매
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲손패 = 1
			효과範囲덱 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ = 해피
			효과条件종류 = モン全般
			효과条件固名前起動 = 1
			효과条件소환可 = 1
			효과条件CNT = 1
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT > 2 && モンスター数(듀얼리스트) < 3
				PRINTL "해피" 몬스터 ３장을 특수 소환하시겠습니까？
				CALL YN_CHOICE(듀얼리스트)
				IF RESULT == はい
					CALL FULLRESET
					효과範囲손패 = 1
					효과範囲덱 = 1
					효과範囲묘지 = 1
					효과条件カテゴリ = 해피
					효과条件複数 = 3
					효과条件固名前 = 해피 레이디 세자매
					효과条件固名前選択 = 1
					CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
				ENDIF
			ELSE
				PRINTL "해피" 몬스터 ３장을 특수 소환할 수 없습니다。
			ENDIF
			SS소환可能속성 = 바람속성
			CALL CARD_SS_RESTRICTION(듀얼리스트)
		ENDIF
	ENDIF
ELSEIF 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,81051,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 해피
		효과条件종류 = モン全般
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF
