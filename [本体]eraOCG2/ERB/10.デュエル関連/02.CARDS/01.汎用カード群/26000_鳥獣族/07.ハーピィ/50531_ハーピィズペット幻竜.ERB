@CARDNAME_50531,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 해피의 애완 미라지 드래곤
	CASE "略称"
		RESULTS = Hp미라지드래곤
	CASE "カテゴリ"
		RESULTS:0 = 해피
ENDSELECT


@CARD_50531(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 2000
	CASE "守備力"
		RETURN 2500
	CASE "성별"
		RETURN 0
	CASE "추가日"
		RETURN 251114
ENDSELECT

RETURN 0

@CARDSUMMON_50531(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 3
素材条件속성 = 바람속성
素材条件レベル = 4

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,50531) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_50531(종류)
#DIM DYNAMIC 종류

PRINTL 바람속성 레벨４ 몬스터×３
CALLFORM CARD_ABLE(3,EX덱起動)
PRINTL 이 카드명의 카드는 １턴에 １번、자신의 패 / 필드의 마법 카드 ２장을 파괴하는 것으로、
PRINTL 자신 필드의 "해피" 몬스터 １장 위에 겹쳐서 Ｘ소환할 수 있다。
PRINTL 이 방법으로 Ｘ소환한 이 카드의 Ｘ소재는 ２개 늘어난다。

CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：Ｘ소재를 갖고있는 이 카드는 직접 공격할 수 있다。

CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：Ｘ소재를 갖고있는 이 카드가 몬스터 존에 존재하는 한、
PRINTL 자신 필드의 "해피" 몬스터는 공격 회피와 대상 내성을 얻는다
PRINTL （자신 필드에 "해피" 몬스터밖에 존재하지 않는 경우、상대는 직접 공격할 수 없다）。

CALLFORM CARD_ABLE(0,ターン終了時強制)
PRINTL ③：자신 엔드 페이즈에 발동한다。이 카드의 Ｘ소재를 １개 제거한다。

@CARDCAN_50531(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50531)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF 발동済_1(듀얼리스트,50531)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,50531)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲마함 = 1
	효과条件종류 = 마법全般
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 해피
	효과条件重ねてＸ = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン終了時強制
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_50531(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM 選択カード


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50531,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲마함 = 1
		효과条件종류 = 마법全般
		효과条件複数 = 2
		효과条件行先플래그 = 破壊行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL RESETCONDITION_MAT
			必要素材数 = 1
			효과条件カテゴリ = 해피
			重ねてＸ = 1
			효과추가종류 = 効追Ｘ素 + 2
			TRYCALLFORM XYZSUMMON(듀얼리스트,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"直攻")
	CALL FULLRESET
	효과条件カテゴリ = 해피
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"攻避")
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"対耐")
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件固カテゴリ = 해피
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"直無")
ELSEIF 종류 == ターン終了時強制
	CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"Ｘ",-1)
ENDIF