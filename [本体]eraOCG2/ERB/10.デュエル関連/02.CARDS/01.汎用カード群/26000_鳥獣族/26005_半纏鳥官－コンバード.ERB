@CARDNAME_26005,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 반전조관－콘버드
	CASE "略称"
		RESULTS = 콘버드
	CASE "カテゴリ"
		RESULTS:0 = 없음
		RESULTS:1 = 리버스
ENDSELECT


@CARD_26005(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 비행야수족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 1400
	CASE "守備力"
		RETURN 2800
	CASE "추가日"
		RETURN 260125
ENDSELECT
RETURN 0

@CARD_EXPLANATION_26005(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1, 손패起動, フリー誘発)
PRINTL ①：이 카드가 손패に존재하는 경우、자신 / 상대のバトルフェイズに발동할 수 있다。
PRINTL 필드의 裏側표시몬스터 １장을 묘지へ送り、이 카드를 裏側守備표시で특수 소환한다。
CALL CARD_ABLE(2, リバース誘発)
PRINTL ②：이 카드가 リバースした場合に발동할 수 있다。
PRINTL 「반전조관－콘버드」を除く、レベル５以上のリバース몬스터 １장을 덱에서 裏側守備표시で특수 소환한다。


@CARDCAN_26005(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 효과先

CALL CARD_NEGATE(듀얼리스트, 종류, ゾーン, 場所, 26005)
SIF RESULT == 1
	RETURN 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트, 26005)
		RETURN 0
	SIF ゾーン != "손패"
		RETURN 0
	SIF バトルフェイズ != 1
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트, 26005, "손패", 1)
	SIF RESULT == 1
		RETURN 0
	
	CALL CARD_SS_CHECK(듀얼리스트, 26005, "손패")
	IF RESULT == 1
		CALL FULLRESET
		효과範囲필드 = 1
	ELSE
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲상대필드 = 1
	ENDIF
	효과条件표시 = 裏側표시
	효과条件除去種 = リリース
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == リバース誘発
	SIF 발동済_2(듀얼리스트, 26005)
		RETURN 0
	
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件固名前 = 반전조관－콘버드
	CALL 효과条件レベル_ADV(5, "以上")
	효과条件カテゴリ = リバース
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ENDIF

@CARDEFFECT_26005(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 26005, 1)
	IF RESULT == 0
		CALL CARD_SS_CHECK(듀얼리스트, 26005, "손패")
		IF RESULT == 1
			CALL FULLRESET
			효과範囲필드 = 1
		ELSE
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲상대필드 = 1
		ENDIF
		효과条件표시 = 裏側표시
		CALL CARD_REMOVAL_ADV(듀얼리스트, "単体除去", 場所, "リリース")
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트, ゾーン, 場所, "裏側守備표시")
		ENDIF
	ENDIF
ELSEIF 종류 == リバース誘発
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 26005, 2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件固名前 = 반전조관－콘버드
		CALL 효과条件レベル_ADV(5, "以上")
		효과条件カテゴリ = リバース
		CALL CARD_SP_SUMMON_ADV(듀얼리스트, ゾーン, 場所, "裏側守備표시")
	ENDIF
ENDIF


