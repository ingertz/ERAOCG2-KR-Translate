@CARDNAME_72224,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 더블 트리거
	CASE "略称"
		RESULTS = 더블 트리거
	CASE "カテゴリ"
		RESULTS:0 = 없음
	CASE "検索用カテゴリ"
		RESULTS = 바렛
ENDSELECT


@CARD_72224(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
ENDSELECT

RETURN 0

@CARD_EXPLANATION_72224(종류)
#DIM DYNAMIC 종류

PRINTL ①：以下の효과から１つを選択して발동できる（このカード名の以下の효과はそれぞれ１ターンに１度しか選択できない）。
CALLFORM CARD_ABLE(1,손패起動,마함起動)
PRINTL ●자신の묘지の드래곤족・어둠속성モンスターを융합素材として제외し、
PRINTL 융합モンスター１体を융합소환する。
CALLFORM CARD_ABLE(2,손패起動,마함起動)
PRINTL ●レベルの合計が의식소환するモンスターのレベル以上になるように、
PRINTL 자신の묘지の드래곤족・어둠속성モンスターを제외し、손패から의식モンスター１体を의식소환する。


@CARDCAN_72224(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 발동불가,2

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72224)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	
	SIF 발동済_1(듀얼리스트,72224)
		발동불가:0 = 1
	SIF 발동済_2(듀얼리스트,72224)
		발동불가:1 = 1

	CALL RESETAREA_MAT
	素材範囲묘지 = 1
	素材条件종족 = 드래곤족
	素材条件속성 = 어둠속성
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = 융합
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1

	CALL RESETAREA_MAT
	素材範囲묘지 = 1
	素材条件종족 = 드래곤족
	素材条件속성 = 어둠속성
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件종류 = 의식
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:1 = 1
	
	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_72224(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 발동불가,2
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,72224)
		발동불가:0 = 1
	SIF 발동済_2(듀얼리스트,72224)
		발동불가:1 = 1

	CALL RESETAREA_MAT
	素材範囲묘지 = 1
	素材条件종족 = 드래곤족
	素材条件속성 = 어둠속성
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = 융합
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1

	CALL RESETAREA_MAT
	素材範囲묘지 = 1
	素材条件종족 = 드래곤족
	素材条件속성 = 어둠속성
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件종류 = 의식
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:1 = 1

	IF 발동불가:0 != 1 && 발동불가:1 != 1
		CALL YN_CHOICE(듀얼리스트,"●융합소환","●의식소환")
	ELSEIF 발동불가:0 != 1
		RESULT = 0
	ELSEIF 발동불가:1 != 1
		RESULT = 1
	ENDIF

	IF RESULT == 0
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72224,1)
		IF RESULT == 0
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)		
			CALL RESETAREA_MAT
			素材範囲묘지 = 1
			素材条件종족 = 드래곤족
			素材条件속성 = 어둠속성
			CALL FULLRESET
			효과条件종류 = 융합
			효과条件소환可 = 2
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
			IF RESULT != 9999
				選択カード = RESULT
				選択カード_ID = RESULT:1
				CALL RESETAREA_MAT
				TRYCALLFORM CARDSUMMON_{選択カード_ID}(듀얼리스트,選択カード)
				素材範囲묘지 = 1
				素材条件종족 = 드래곤족
				素材条件속성 = 어둠속성
				TRYCALLFORM FUSSUMMON(듀얼리스트, 選択カード)
			ENDIF
		ENDIF

	ELSEIF RESULT == 1
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72224,1)
		IF RESULT == 0
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)		
			CALL RESETAREA_MAT
			素材範囲묘지 = 1
			素材条件종족 = 드래곤족
			素材条件속성 = 어둠속성
			CALL FULLRESET
			효과条件종류 = 의식
			효과条件소환可 = 2
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"손패",ゾーン,場所)
			IF RESULT != 9999
				選択カード = RESULT
				選択カード_ID = RESULT:1
				CALL RESETAREA_MAT
				TRYCALLFORM CARDSUMMON_{選択カード_ID}(듀얼리스트,選択カード)
				素材範囲묘지 = 1
				素材条件종족 = 드래곤족
				素材条件속성 = 어둠속성
				TRYCALLFORM RITSUMMON(듀얼리스트, 選択カード,"손패")
			ENDIF
		ENDIF
	ENDIF
ENDIF

