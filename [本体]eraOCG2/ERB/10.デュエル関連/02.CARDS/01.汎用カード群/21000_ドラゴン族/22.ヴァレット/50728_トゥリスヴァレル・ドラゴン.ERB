@CARDNAME_50728,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 투리스바렐 드래곤
	CASE "略称"
		RESULTS = 투리스Ｂ
	CASE "カテゴリ"
		RESULTS:0 = 바렐
ENDSELECT


@CARD_50728(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 2300
	CASE "守備力"
		RETURN 1400
	CASE "추가日"
		RETURN 260119
ENDSELECT

RETURN 0

@CARDSUMMON_50728(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 3
素材条件종족 = 드래곤족
素材条件속성 = 어둠속성

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = 바렛
ENDIF

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,50728) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_50728(종류)
#DIM DYNAMIC 종류

PRINTL 「바렛」몬스터를 含む드래곤족・어둠속성モンスター２体以上
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,EX소환時)
PRINTL ①：이 카드가 Ｌ소환に成功した場合に발동할 수 있다。
PRINTL 덱에서 「라피도 트리거」「헤비 트리거」「더블 트리거」のいずれか１장을 패에 넣는다。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：자신 필드의 表側표시카드 １장을 대상として발동할 수 있다。
PRINTL 대상の카드를 破壊し、そのモンスターとはカード名の異なる자신 묘지의 드래곤족・어둠속성몬스터 １장을 패에 넣는다。


@CARDCAN_50728(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50728)
SIF RESULT == 1
	RETURN 0


IF 종류 == EX소환時
	SIF 발동済_1(듀얼리스트,50728)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件名前:0 = 라피도 트리거
	효과条件名前:1 = 헤비 트리거
	효과条件名前:2 = 더블 트리거
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트,50728)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件속성 = 어둠속성
	효과条件종족 = 드래곤족
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_50728(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名前
#DIMS DYNAMIC 対面者
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50728,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件名前:0 = 라피도 트리거
		효과条件名前:1 = 헤비 트리거
		효과条件名前:2 = 더블 트리거
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50728,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과条件표시 = 表側표시
		효과条件除去種 = 묘지
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			TRYCALLFORM CARDNAME_{RESULT:1},"名前"
			選択カード名前 = %RESULTS%
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件속성 = 어둠속성
			효과条件종족 = 드래곤족
			효과条件종류 = モン全般
			효과条件固名前 = %選択カード名前%
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF

