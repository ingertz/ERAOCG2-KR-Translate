@CARDNAME_50730,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 바렐슈라우드 드래곤
	CASE "略称"
		RESULTS = ＢＳＲ 드래곤
	CASE "カテゴリ"
		RESULTS:0 = 바렐
ENDSELECT


@CARD_50730(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 3500
	CASE "守備力"
		RETURN 2500
	CASE "추가日"
		RETURN 260119
ENDSELECT

RETURN 0

@CARDSUMMON_50730(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 5
素材条件종류 = 효과全般
IF EX参照 == 0 || EX参照 == 1 || EX参照 == 10
	素材条件L数制限 = 2
ENDIF

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,50730) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_50730(종류)
#DIM DYNAMIC 종류

PRINTL 효과モンスター２体以上
PRINTL 이 카드의 링크소환の１・２番目の素材に、링크３以上の몬스터는 使用できない。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：필드의 이 카드는 素材불가を持つ。
CALLFORM CARD_ABLE(10,필드起動,フリー誘発)
PRINTL ②：１턴에 １번、자신 / 상대의 메인 페이즈에 발동할 수 있다（この발동に対して、상대は카드의 효과를 발동できない）。
PRINTL 상대 필드의 表側표시カード１장 の효과를 무효로 한다。
PRINTL 그 후、자신 필드의 「바렛」몬스터 １장을 파괴한다。
CALLFORM CARD_ABLE(0,バトル開始時)
PRINTL ③：이 카드가 앞면 표시로 존재하는 한 １번만 、자신 / 상대の배틀 페이즈 개시시에 발동할 수 있다。
PRINTL ＥＸ덱에서 링크４以下の「바렐」Ｌ몬스터 １장을 특수 소환한다。

@CARDCAN_50730(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50730)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_1(듀얼리스트,50730)
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 無効
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 바렛
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == バトル開始時
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_汎数:場所") == 1
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件カテゴリ = 바렐
	효과条件종류 = 링크
	CALLFORM 효과条件レベル_ADV(4,"以下")
	효과条件소환可 = 1
	효과条件特不無視 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1

ELSEIF 종류 == チェーン可否
	SIF !GROUPMATCH(チェーン可否종류,필드起動,フリー誘発)
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_50730(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50730,10)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과条件종류 = 효과全般
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"지속無効")
		IF RESULT == 1
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件カテゴリ = 바렛
			효과条件표시 = 表側표시
			효과条件行先플래그 = 破壊行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF

ELSEIF 종류 == バトル開始時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50730)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件カテゴリ = 바렐
		효과条件종류 = 링크
		CALLFORM 효과条件レベル_ADV(4,"以下")
		효과条件소환可 = 1
		효과条件特不無視 = 1
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"汎数",1,1)
	ENDIF

ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"不材")
ENDIF

