@CARDNAME_50727,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 브리치바렐 드래곤
	CASE "略称"
		RESULTS = 브리치Ｂ
	CASE "カテゴリ"
		RESULTS:0 = 바렐
ENDSELECT


@CARD_50727(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 1200
	CASE "守備力"
		RETURN 1000
	CASE "추가日"
		RETURN 260124
ENDSELECT

RETURN 0

@CARDSUMMON_50727(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 2
素材条件종족 = 드래곤족
素材条件속성 = 어둠속성

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = 바렛
ENDIF

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,50727) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_50727(종류)
#DIM DYNAMIC 종류

PRINTL 「바렛」몬스터를 含む드래곤족・어둠속성モンスター２体
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,EX소환時)
PRINTL ①：이 카드가 Ｌ소환に成功した場合に발동할 수 있다。
PRINTL 덱에서 「바렐」마법 / 함정 카드 １장을 패에 넣는다。
CALLFORM CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ②：자신 / 상대 턴에、자신 필드의 어둠속성몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL その몬스터의 공격력은 ５００오른다。
PRINTL この효과に対して「바렛」몬스터의 효과が발동している場合、
PRINTL さらに덱에서 「바렛」몬스터 １장을 수비 표시로 특수 소환할 수 있다。


@CARDCAN_50727(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50727)
SIF RESULT == 1
	RETURN 0


IF 종류 == EX소환時
	SIF 발동済_1(듀얼리스트,50727)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 바렐
	효과条件종류 = 마함全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_2(듀얼리스트,50727)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_50727(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50727,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 바렐
		효과条件종류 = 마함全般
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50727,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件속성 = 어둠속성
		CALL CARD_GRANT_ADV(듀얼리스트,ゾーン,場所,"永攻",500)

		TRYCALLFORM CARDNAME_{効後_효과ID:(処理中番号 + 1)},"カテゴリ"
		IF MATCH(RESULTS,"바렛")
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 바렛
			효과条件任意 = 1
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"守備표시")
		ENDIF
	ENDIF
ENDIF

