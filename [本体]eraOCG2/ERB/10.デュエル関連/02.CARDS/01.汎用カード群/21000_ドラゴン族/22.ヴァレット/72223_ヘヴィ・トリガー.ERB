@CARDNAME_72223,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 헤비 트리거
	CASE "略称"
		RESULTS = 헤비 트리거
	CASE "カテゴリ"
		RESULTS:0 = 의식 마법
	CASE "検索用カテゴリ"
		RESULTS = 바렛
ENDSELECT


@CARD_72223(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
ENDSELECT

RETURN 0

@CARD_EXPLANATION_72223(종류)
#DIM DYNAMIC 종류

PRINTL 「바렐로드 Ｒ 드래곤」の降臨に必要。
CALLFORM CARD_ABLE(0,손패起動,마함起動)
PRINTL ①：レベルの合計が８以上になるように、자신의 패 / 필드의 몬스터를 破壊し、
PRINTL 패에서 「바렐로드 Ｒ 드래곤」１体を의식소환する。
PRINTL 이 효과로 특수소환した몬스터는 戦闘では破壊されず、상대몬스터의 효과를 受けない。
PRINTL

@CARDCAN_72223(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성,5

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72223)
SIF RESULT == 1
	RETURN 0
IF 종류 == 마함起動 || 종류 == 손패起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0

	CALL RESETAREA_MAT
	素材範囲손패 = 1
	素材範囲필드 = 1
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件名前 = 바렐로드 라이엇 드래곤
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_72223(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード


IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72223)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)		
		CALL RESETAREA_MAT
		素材範囲손패 = 1
		素材範囲필드 = 1
		CALL FULLRESET
		효과条件名前 = 바렐로드 라이엇 드래곤
		효과条件소환可 = 2
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"손패",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			CALL RESETAREA_MAT
			TRYCALLFORM CARDSUMMON_{GETVAR(@"%듀얼리스트%_손패:{選択カード}")}(듀얼리스트,選択カード)
			素材範囲필드 = 1
			素材範囲손패 = 1
			효과추가종류:0 = 効追戦耐
			효과추가종류:1 = 効追モ耐
			TRYCALLFORM RITSUMMON(듀얼리스트, 選択カード,"손패",,破壊行き)
		ENDIF
	ENDIF
ENDIF

