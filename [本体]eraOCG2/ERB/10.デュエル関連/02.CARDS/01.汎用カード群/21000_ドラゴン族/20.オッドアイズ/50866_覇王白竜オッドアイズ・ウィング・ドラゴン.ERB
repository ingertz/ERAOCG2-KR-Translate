@CARDNAME_50866,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 패왕백룡 오드아이즈 윙 드래곤
	CASE "略称"
		RESULTS = 패왕백룡ОＷＤ
	CASE "カテゴリ"
		RESULTS:0 = 오드아이즈
ENDSELECT


@CARD_50866(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 3000
	CASE "守備力"
		RETURN 2500
	CASE "성별"
		RETURN 雄性
	CASE "分割"
		RETURN 펜듈럼
ENDSELECT

RETURN 0

@CARDSUMMON_50866(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要レベル数 = 8

IF EX参照 == 0 || EX参照 == 1
	素材条件튜너 = 1
ELSEIF EX参照 >= 10
	素材条件튜너 = -1
	素材条件종족 = 드래곤족
	素材条件종류 = 싱크로
ENDIF

IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,50866) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_50866(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("SYN_P_MAGIC")
PRINTL 이 카드명의 Ｐ효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(3,발동誘発)
PRINTL ①：상대 필드의 몬스터가 효과를 발동했을 때에 발동할 수 있다。
PRINTL 그 발동을 무효로 하고 파괴한다。
CALL TEXT_DECORATION("SYN_P_MAGIC_2")

PRINTL 튜너＋튜너 이외의 드래곤족 Ｓ몬스터 １장 이상
CALLFORM CARD_ABLE(2,EX덱起動)
PRINTL ●１턴에 １번、자신 필드에 Ｐ 이외의 드래곤족 Ｓ몬스터가 존재하는 경우에 EX덱에서 발동할 수 있다。
PRINTL 자신 필드의 드래곤족 Ｐ몬스터 １장을 레벨 １튜너로서 취급한다。
PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,필드起動)
PRINTL ①：자신의 메인 페이즈、또는 자신 / 상대의 배틀 페이즈에 발동할 수 있다。
PRINTL 상대 필드의 레벨５ 이상인 몬스터 １장을 골라、상대 필드의 몬스터를 전부 효과를 무효로 하고 파괴한다。
PRINTL 그 후、이 카드의 공격력은 턴 종료시까지 고른 몬스터의 공격력 만큼 오른다。
CALLFORM CARD_ABLE(0,身代효과)
PRINTL ②：자신 몬스터 존의 드래곤족 Ｐ몬스터가 파괴될 경우、
PRINTL 대신에 이 카드를 자신의 마법＆함정 존에 앞면 표시로 놓는다。


@CARDCAN_50866(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50866)
SIF RESULT == 1
	RETURN 0

IF 종류 == 발동誘発
	SIF 발동済_3(듀얼리스트,50866)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == EX덱起動
	SIF 발동済_2(듀얼리스트,50866)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件分割 = 펜듈럼
	효과条件종족 = 드래곤족
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = 싱크로
	효과条件종족 = 드래곤족
	효과条件分割 = 50
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,50866)
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	CALLFORM 효과条件レベル_ADV(5,"以上")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	IF メインフェイズ == 1
		SIF ターンプレイヤー == 듀얼리스트
			RETURN 1
	ENDIF
	IF 종류 == フリー誘発
		SIF ゾーン != "필드"
			RETURN 0
		SIF バトルフェイズ == 1
			RETURN 1
	ENDIF
	SIF バトルフェイズ == 1
		RETURN 1
	RETURN 0
ELSEIF 종류 == 身代효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF 破壊대상ゾーン != "필드"
		RETURN 0
	TRYCALLFORM CARD_{破壊대상ID}("종족")
	SIF !MATCH(RESULT,드래곤족)
		RETURN 0
	TRYCALLFORM CARD_{破壊대상ID}("分割")
	SIF RESULT != 펜듈럼
		RETURN 0
	SIF !GROUPMATCH(破壊종류,"효과","戦闘")
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_50866(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50866,3)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"묘지")
	ENDIF
ELSEIF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50866,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件分割 = 펜듈럼
		효과条件종족 = 드래곤족
		CALL CARD_GRANT_ADV(듀얼리스트,ゾーン,場所,"一Ｔ",1)
		SIF RESULT == 1
			CALL SET_FIELD_INFO(듀얼리스트,"필드",RESULT:2,"一星",1,1)
	ENDIF

ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50866,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		CALLFORM 효과条件レベル_ADV(5,"以上")
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 9999
			選択カード_ID = RESULT:99
			TRYCALLFORM CARD_{選択カード_ID},"攻撃力"
			攻撃力修正 = RESULT
			CALL FULLRESET
			효과範囲상대필드 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"無効")
			CALL FULLRESET
			효과範囲상대필드 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"完全묘지")
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"一攻",攻撃力修正)
		ENDIF
	ENDIF
ELSEIF 종류 == 身代효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50866)
	IF RESULT == 0
		IF 破壊종류 == "戦闘"
			CALL CARD_FIN_ID_SET(듀얼리스트,50866,"戦闘破壊")
		ELSE
			CALL CARD_FIN_ID_SET(듀얼리스트,50866,"효과破壊")
		ENDIF
		CALL CARD_DISPOSE(듀얼리스트,"필드",場所,마함行き)
		RETURN 1
	ENDIF
	RETURN 0
ENDIF