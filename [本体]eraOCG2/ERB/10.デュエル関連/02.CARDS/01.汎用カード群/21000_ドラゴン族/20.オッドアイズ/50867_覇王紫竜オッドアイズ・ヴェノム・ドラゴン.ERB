@CARDNAME_50867,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 패왕자룡 오드아이즈 베놈 드래곤
	CASE "略称"
		RESULTS = 패왕자룡 ОＶＤ
	CASE "カテゴリ"
		RESULTS:0 = 오드아이즈
ENDSELECT


@CARD_50867(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 3300
	CASE "守備力"
		RETURN 2500
	CASE "성별"
		RETURN 雄性
	CASE "分割"
		RETURN 펜듈럼
ENDSELECT

RETURN 0

@CARDSUMMON_50867(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材条件종족 = 드래곤족
	素材条件종류 = 융합
ELSEIF EX参照 >= 10
	素材条件종족 = 드래곤족
	素材条件分割 = 펜듈럼
ENDIF

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,50867) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_50867(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("P_MAGIC")
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：このカードが마법＆함정ゾーンに表側표시で存在する限り、
PRINTL 자신のモンスターの戦闘で자신が受ける戦闘ダメージは０になる。
CALL TEXT_DECORATION("P_MAGIC_2")

PRINTL 드래곤족・융합モンスター＋드래곤족・Ｐモンスター
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(3,EX덱起動)
PRINTL ●１턴에 １번、EX덱から발동できる。
PRINTL 자신フィールドのモンスターを융합素材として、EX덱からこのカードを융합소환する。
PRINTL その後、このカードの攻撃力はターン終了時まで、상대フィールドのモンスターの攻撃力の合計分アップする。
CALLFORM CARD_ABLE(1,필드起動)
PRINTL ①：자신・상대のメインフェイズに발동できる。
PRINTL 상대フィールドのモンスター１体の효과をターン終了時まで無効にする。
CALLFORM CARD_ABLE(2,戦破壊→묘지)
PRINTL ②：このカードがモンスターゾーンからEX덱に加わった場合に발동できる。  
PRINTL 자신の마법＆함정ゾーンに表側표시で存在する드래곤족Ｐモンスター１体を특수소환し、
PRINTL このカードを자신の마법＆함정ゾーンに表側표시で置く。
PRINTL その後、상대フィールドのモンスターを全て破壊し、その攻撃力の合計分のダメージを상대に与える。


@CARDCAN_50867(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50867)
SIF RESULT == 1
	RETURN 0


IF 종류 == 지속효과
	SIF ゾーン != "마함"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == EX덱起動
	SIF 발동済_3(듀얼리스트,50867)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,50867)
	SIF RESULT == 1
		RETURN 0
	CALL RESETAREA_MAT
	素材範囲필드 = 1
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件固定 = 場所
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,50867)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0	
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	효과条件除去種 = 無効
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1	
ELSEIF 종류 == 戦破壊→묘지
	SIF 발동済_2(듀얼리스트,50867)
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件종족 = 드래곤족
	효과条件分割 = 펜듈럼
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_50867(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 지속효과
	CALL SET_PLAYER_INFO(듀얼리스트,"ダメージ無効",3)

ELSEIF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50867,3)
	IF RESULT == 0
		CALL RESETAREA_MAT
		素材範囲필드 = 1
		CALL FULLRESET
		TRYCALLFORM CARDSUMMON_50867(듀얼리스트,場所)
		CALL FUSSUMMON(듀얼리스트,場所)
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50867,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"無効")
	ENDIF
ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50867,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲마함 = 1
		효과条件종족 = 드래곤족
		효과条件分割 = 펜듈럼
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲EX덱 = 1
			효과条件名前 = 패왕자룡 오드아이즈 베놈 드래곤
			CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"表側표시")
			IF RESULT == 1
				CALL FULLRESET
				효과範囲상대필드 = 1
				효과추가종류 = 効追無効
				CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"묘지")
			ENDIF
		ENDIF
	ENDIF
ENDIF