@CARDNAME_50569,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 스카레드 하이퍼노바 드래곤
	CASE "略称"
		RESULTS = 하이퍼노바
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_50569(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 12
	CASE "攻撃力"
		RETURN 4500
	CASE "守備力"
		RETURN 3000
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 260124
ENDSELECT

RETURN 0

@CARDSUMMON_50569(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

RETURN 0

CALL RESETCONDITION_MAT
必要レベル数 = 12
IF EX参照 == 0 || EX参照 == 1
	素材条件튜너 = 1
ELSEIF EX参照 == 10
	素材条件カテゴリ:0 = 레드 데몬
	素材条件종류 = 싱크로
	素材条件튜너 = -1
ENDIF

IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,50569) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_50569(종류)
#DIM DYNAMIC 종류

CALLFORM CARD_ABLE(1,EX덱起動)
PRINTL 이 카드는 S소환できず、１턴에 １번、
PRINTL 자신 필드의 튜너モンスター４体と튜너이외의 「레드 데몬」S몬스터 １장을 묘지に送った場合のみ
PRINTL EX덱에서 S소환扱いで특수 소환할 수 있다。

CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ①：이 카드의 공격력은、자신 묘지의 튜너の数×５００오른다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：필드의 이 카드는 효과では破壊されず、
PRINTL 상대は필드의 이 카드를 효과の대상にできない。
CALLFORM CARD_ABLE(10,필드起動,フリー誘発)
PRINTL ③：자신 / 상대 턴에 １번、발동할 수 있다。
PRINTL このカード及び상대の필드 / 묘지의 카드를 全て제외한다。
PRINTL 그 후、EX덱에서 「스카레드 노바 드래곤」１장을 특수 소환할 수 있다。

@CARDCAN_50569(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50569)
SIF RESULT == 1
	RETURN 0


IF 종류 == EX덱起動
	SIF 발동済_3(듀얼리스트,50569)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,50569)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件튜너 = -1
	효과条件カテゴリ = 레드 데몬
	효과条件종류 = 싱크로
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件튜너 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 4
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과範囲상대묘지 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과 || 종류 == 攻守変動 
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1

ENDIF

@CARDEFFECT_50569(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM ダメージ量
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50569,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件튜너 = -1
		효과条件カテゴリ = 레드 데몬
		효과条件종류 = 싱크로
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1

			CALL FULLRESET
			효과範囲필드 = 1
			효과条件튜너 = 1
			효과条件複数 = 4
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				CALL CARD_EX_SUMMON(듀얼리스트,"EX덱",場所)
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
    CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50569,10)
	IF RESULT == 0
	    CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,제외行き)
	    CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"全場全体",場所,"제외")
			FOR カウンタ,0,紙束最大値
				SIF GETVAR(@"%対面者%_묘지:カウンタ") == -1
					CONTINUE
				CALL CARD_DISPOSE(対面者,"묘지",カウンタ)
			NEXT

		PRINTL 몬스터를 특수소환しますか？
		CALL YN_CHOICE(듀얼리스트)
		IF RESULT == はい
		    CALL FULLRESET
		    효과条件名前 = 스카레드 노바 드래곤
		    효과条件任意 = 1
		    CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
			選択カード = RESULT
			IF 選択カード != 9999
				CALL CARD_EX_SUMMON(듀얼리스트, "EX덱", 選択カード)
			ENDIF
		ENDIF
		
	ENDIF
		
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"対耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"破耐")

ELSEIF 종류 == 攻守変動 
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件튜너 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	攻撃力修正 = RESULT * 500
	CALL STATCHANGE_BASIC(듀얼리스트,"自身",場所,攻撃力修正)

ENDIF