@CARDNAME_50623,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 초정룡－디저스터
	CASE "略称"
		RESULTS = 디저스터
	CASE "カテゴリ"
		RESULTS:0 = 정룡
ENDSELECT


@CARD_50623(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RESULT:1 = 어둠속성
		RETURN 빛속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 雄性
	CASE "レア度"
		RETURN ULR
	CASE "추가日"
		RETURN 251125
ENDSELECT

RETURN 0

@CARDSUMMON_50623(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 7
素材条件종류 = 엑시즈
なんでもＸ = 1
;추가효과用
지정素材カテゴリ = 정룡

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,50623) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_50623(종류)
#DIM DYNAMIC 종류

PRINTL 랭크７ 몬스터×２
PRINTL "정룡" 몬스터를 Ｘ소재로 하고있는 이 카드는 각성 상태가 된다。
PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,EX소환時)
PRINTL ①：이 카드가 Ｘ소환된 경우、자신의 묘지 / 제외 상태인 레벨 / 랭크가 ７인 "정룡" 몬스터를 ６장까지 대상으로 하고 발동할 수 있다
PRINTL 그 몬스터를 덱으로 되돌리고、그 몬스터와 같은 속성을 가진 몬스터를 상대 필드 / 묘지에서 전부 제외할 수 있다。
PRINTL 이 효과로 땅 / 물 / 화염 / 바람속성 몬스터를 되돌린 경우、그 때마다 이 카드의 Ｘ소재를 １개 늘린다（같은 속성마다 １개까지）。
CALLFORM CARD_ABLE(0,攻守変動,지속효과)
PRINTL ②：Ｘ소재를 ６개 이상 가진 각성 상태인 이 카드는、공격력 / 수비력이 ４６００오르고、완전 내성을 얻는다。


@CARDCAN_50623(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50623)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX소환時
	SIF 발동済_1(듀얼리스트,50623)
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件レベル = 7
	효과条件カテゴリ = 정룡
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과 || 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= 4
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_条達:場所") == 0
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_50623(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタ2
#DIM DYNAMIC カウンタC
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID,20
#DIM DYNAMIC 選択カード속성
#DIM DYNAMIC 속성판정,4
#DIM DYNAMIC 確認カード_ID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50623,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲제외 = 1
		효과条件レベル = 7
		효과条件カテゴリ = 정룡
		효과条件行先플래그 = 덱行き
		효과条件任意 = 1
		효과条件複数 = 6
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			FOR カウンタ,0,6
				選択カード_ID:カウンタ = RESULT:(300 + カウンタ)
			NEXT
			FOR カウンタ,0,6
				SIF 選択カード_ID:カウンタ <= 0
					CONTINUE

				確認カード_ID = 選択カード_ID:カウンタ
				CALLFORM CARD_{確認カード_ID}("속성")

				選択カード속성 = RESULT
				IF GROUPMATCH(選択カード속성,땅속성,물속성,화염속성,바람속성)
					IF 속성판정:0 != 選択カード속성 && 속성판정:1 != 選択カード속성 && 속성판정:2 != 選択カード속성 && 속성판정:3 != 選択カード속성
						CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"Ｘ",1)
						속성판정:カウンタ2 = 選択カード속성
						カウンタ2 ++
					ENDIF
				ENDIF

				CALL FULLRESET
				효과条件속성 = 選択カード속성
				CALL CARD_REMOVAL_BASIC(듀얼리스트,"全場全体",場所,"제외")

				FOR カウンタC,0,紙束最大値
					SIF GETVAR(@"%対面者%_묘지:カウンタC") == -1
						CONTINUE
					TRYCALLFORM CARD_{GETVAR(@"%対面者%_묘지:カウンタC")}("속성")
					SIF RESULT == 選択カード속성
						CONTINUE
					CALL CARD_DISPOSE(対面者,"묘지",カウンタC)
				NEXT

			NEXT
		ENDIF
	ENDIF
ELSEIF 종류 == 攻守変動
	CALL STATCHANGE_BASIC(듀얼리스트,"自身",場所,4600,4600)
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"モ耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"魔耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"함정耐")
ENDIF

