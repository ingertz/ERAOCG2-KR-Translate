@CARDNAME_73187,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 섬멸의 타키온 스파이럴
	CASE "略称"
		RESULTS = 섬멸의시공나선류
	CASE "カテゴリ"
		RESULTS:0 = 타키온
	CASE "検索カテゴリ"
		RESULTS:0 = 갤럭시
ENDSELECT


@CARD_73187(参照先)
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
	CASE "추가日"
		RETURN 260102
ENDSELECT
RETURN 0


@CARD_EXPLANATION_73187(종류)
#DIM DYNAMIC 종류

PRINTL ①：以下の효과から１つを選択して발동できる
PRINTL （このカード名の以下の효과はそれぞれ１ターンに１度しか選択できない）。
CALLFORM CARD_ABLE(1,마함起動,손패起動,フリー誘発)
PRINTL ●자신フィールドに「갤럭시」Ｘモンスターが存在する場合に발동できる。
PRINTL 효과が無効化されている상대フィールドの表側표시カードを全て破壊する。
CALLFORM CARD_ABLE(2,마함起動,손패起動,フリー誘発)
PRINTL ●「섬멸의 타키온 스파이럴」以外の자신の묘지の「타키온」カード１枚を대상として발동できる。
PRINTL そのカードを손패に加える。
CALLFORM CARD_ABLE(3,마함起動,손패起動,フリー誘発)
PRINTL ●자신の묘지の드래곤족の「Ｎｏ.」モンスター１体を대상として발동できる。
PRINTL そのモンスターを守備표시で특수소환する。


@CARDCAN_73187(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,73187)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	IF !발동済_1(듀얼리스트,73187)
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 갤럭시
		효과条件종류 = 엑시즈
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			FOR カウンタ,0,5
				SIF GETVAR(@"%対面者%_필드:カウンタ") == -1
					CONTINUE
				SIF GETVAR(@"%対面者%_MZ_表:カウンタ") == 3
					CONTINUE
				SIF GETVAR(@"%対面者%_MZ_無効:カウンタ") == 0
					CONTINUE
				条件달성 = 1
			NEXT
			FOR カウンタ,0,5
				SIF GETVAR(@"%対面者%_마함:カウンタ") == -1
					CONTINUE
				SIF GETVAR(@"%対面者%_魔_表:カウンタ") == 3
					CONTINUE
				SIF GETVAR(@"%対面者%_魔_無効:カウンタ") == 0
					CONTINUE
				条件달성 = 1
			NEXT
		ENDIF
	ENDIF

	IF !발동済_2(듀얼리스트,73187)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 타키온
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件달성 = 1
	ENDIF

	IF !발동済_3(듀얼리스트,73187)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = ナンバーズ
		효과条件종족 = 드래곤족
		효과条件소환可 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件달성 = 1
	ENDIF

	SIF 条件달성 != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_73187(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 条件달성, 3
#DIM DYNAMIC 選択肢

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)

	IF !발동済_1(듀얼리스트,73187)
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 갤럭시
		효과条件종류 = 엑시즈
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			FOR カウンタ,0,5
				SIF GETVAR(@"%対面者%_필드:カウンタ") == -1
					CONTINUE
				SIF GETVAR(@"%対面者%_MZ_表:カウンタ") == 3
					CONTINUE
				SIF GETVAR(@"%対面者%_MZ_無効:カウンタ") == 0
					CONTINUE
				条件달성:0 = 1
			NEXT
			FOR カウンタ,0,5
				SIF GETVAR(@"%対面者%_마함:カウンタ") == -1
					CONTINUE
				SIF GETVAR(@"%対面者%_魔_表:カウンタ") == 3
					CONTINUE
				SIF GETVAR(@"%対面者%_魔_無効:カウンタ") == 0
					CONTINUE
				条件달성:1 = 1
			NEXT
		ENDIF
	ENDIF

	IF !발동済_2(듀얼리스트,73187)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 타키온
		효과条件固名前 = 섬멸의 타키온 스파이럴
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件달성:1 = 1
	ENDIF

	IF !발동済_3(듀얼리스트,73187)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = ナンバーズ
		효과条件종족 = 드래곤족
		효과条件소환可 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件달성:2 = 1
	ENDIF

	IF 듀얼리스트 == "자신"
		PRINTL 효과を選択してください。
		SIF 条件달성:0 == 1
			PRINTL [0] 효과が無効化されている상대フィールドの表側표시カードを全て破壊する。
		SIF 条件달성:1 == 1
			PRINTL [1] 묘지の「타키온」カード１枚を손패に加える。
		SIF 条件달성:2 == 1
			PRINTL [2] 묘지の드래곤족のナンバーズ１体を특수소환する。
		BINPUT
		選択肢 = RESULT
	ELSE
		SIF 条件달성:1 == 1
			選択肢 = 1
		SIF 条件달성:0 == 1
			選択肢 = 0
		SIF 条件달성:2 == 1
			選択肢 = 2
	ENDIF

	IF 選択肢 == 0
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73187,1)
		IF RESULT == 0
			FOR カウンタ,0,5
				SIF GETVAR(@"%対面者%_필드:カウンタ") == -1
					CONTINUE
				SIF GETVAR(@"%対面者%_MZ_表:カウンタ") == 3
					CONTINUE
				SIF GETVAR(@"%対面者%_MZ_無効:カウンタ") == 0
					CONTINUE
				CALL FULLRESET
				CALL CARD_REMOVAL_BASIC(듀얼리스트,"自動処理",カウンタ,"묘지")
			NEXT
			FOR カウンタ,0,5
				SIF GETVAR(@"%対面者%_마함:カウンタ") == -1
					CONTINUE
				SIF GETVAR(@"%対面者%_魔_表:カウンタ") == 3
					CONTINUE
				SIF GETVAR(@"%対面者%_魔_無効:カウンタ") == 0
					CONTINUE
				CALL FULLRESET
				CALL CARD_REMOVAL_BASIC(듀얼리스트,"魔自動処理",カウンタ,"묘지")
			NEXT
		ENDIF
	ELSEIF 選択肢 == 1
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73187,2)
		IF RESULT == 0
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件固名前 = 섬멸의 타키온 스파이럴
			효과条件カテゴリ = 타키온
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ELSEIF 選択肢 == 2
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73187,3)
		IF RESULT == 0
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件カテゴリ = ナンバーズ
			효과条件종족 = 드래곤족
			효과条件소환可 = 1
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"守備표시")
		ENDIF
	ENDIF
ENDIF