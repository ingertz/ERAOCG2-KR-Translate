@CARD_EXPLANATION_135000(종류)
#DIM DYNAMIC 종류

CALLFORM CARD_ABLE(0,특수소환時)
PRINTL ①：이 카드가 "메타파이즈" 카드의 효과로 특수 소환한 경우에 발동할 수 있다。
PRINTL 이 카드 이외의 필드의 특수 소환된 표면 표시 몬스터를 전부 제외한다。
CALLFORM CARD_ABLE(0,ターン開始時)
PRINTL ②：스탠바이 페이즈에 제외 상태인 이 카드를 덱으로 되돌리고 발동할 수 있다。
PRINTL 덱에서 이 카드명 이외의 "메타파이즈" 카드 １장을 제외한다。


@CARDCAN_135000(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,135000)
SIF RESULT == 1
	RETURN 0

IF 종류 == 특수소환時
	TRYCALLFORM CARDNAME_{処理中_효과ID}("カテゴリ")
	SIF !MATCH(RESULTS,"메타파이즈")
		RETURN 0
	CALL FULLRESET
	SIF 듀얼리스트 == "자신"
		효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	효과条件召種 = 召種全특수
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン開始時
	SIF ゾーン != "제외"
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 메타파이즈
	효과条件固名前 = 메타파이즈 다이달로스
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

