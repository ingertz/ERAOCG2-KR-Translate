@CARD_EXPLANATION_121956(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,소환時,특수소환時)
PRINTL ①：このカードが소환・특수소환した場合に발동できる。
PRINTL 자신の덱の上からカードを３枚제외する。このカードの攻撃力は、
PRINTL この효과で제외した드래곤족モンスター及び「메타파이즈」カードの数×３００アップする。
CALLFORM CARD_ABLE(2,ライフ変強制誘発)
PRINTL ②：このカードが상대に戦闘ダメージを与えた時に발동できる。
PRINTL 덱からレベル５以上の드래곤족モンスター１体を특수소환する。
PRINTL この효과で특수소환したモンスターはエンドフェイズに제외される。

@CARDCAN_121956(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,121956)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,121956)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 3
		RETURN 0
	RETURN 1
ELSEIF 종류 == ライフ変強制誘発
	SIF 발동済_2(듀얼리스트,50586)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF ダメージ受者 == 듀얼리스트
		RETURN 0
	SIF !GROUPMATCH(ダメージ종류,"戦闘", "直接戦闘")
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = モン全般
	효과条件종족 = 드래곤족
	효과条件소환可 = 1
	CALL 효과条件レベル_ADV(5, "以上")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_121956(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 強化値カウント
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,121956,1)
	IF RESULT == 0
		FOR カウンタ,0,3
			TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_덱:カウンタ")}("종족")
			SIF RESULT == 드래곤족
				強化値カウント ++
			TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_덱:カウンタ")}("カテゴリ")
			SIF !MATCH(RESULTS, "메타파이즈")
				強化値カウント ++
		NEXT
		CALL CARD_DECK_DISPOSE(듀얼리스트,"덱",3,제외行き)
		CALL FULLRESET
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"一攻",強化値カウント * 300)
	ENDIF
ELSEIF 종류 == ライフ変強制誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,121956,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종족 = 드래곤족
		CALL 효과条件レベル_ADV(5, "以上")
		효과추가종류 = 10 + 제외行き
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF

