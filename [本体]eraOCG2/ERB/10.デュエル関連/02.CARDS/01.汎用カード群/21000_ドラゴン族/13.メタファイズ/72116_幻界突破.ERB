@CARD_EXPLANATION_72116(종류)
#DIM DYNAMIC 종류

CALLFORM CARD_ABLE(10,마함起動)
PRINTL ①：１턴에 １번、자신 필드의 "메타파이즈" 이외의 몬스터 １장을 릴리스하고 발동할 수 있다。
PRINTL 릴리스 한 몬스터를 메타파이즈화 시켜、"메타파이즈" 몬스터 １장을 덱밖에서 특수 소환한다。
PRINTL 메타파이즈화 할 수 없는 몬스터를 릴리스한 경우、대신 원래 레벨이 같고
PRINTL 카드명이 다른 드래곤족 몬스터 １장을 덱에서 특수 소환한다。

@CARDCAN_72116(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72116)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = レベル持ち
	효과条件固カテゴリ = 메타파이즈
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_72116(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 選択カード名前
#DIMS DYNAMIC 選択カテゴリ
#DIM DYNAMIC 選択レベル
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72116,10)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종류 = レベル持ち
		효과条件固カテゴリ = 메타파이즈
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT == 1
			選択カード_ID = RESULT:1
			TRYCALLFORM CARDNAME_{選択カード_ID}("名前")
			選択カード名前 = %RESULTS%
			SELECTCASE 選択カード名前
				CASE "데코이 드래곤"
					CALL FULLRESET
					CALL CARD_GENERATE(듀얼리스트,121005)
				CASE "신룡 라그나로크"
					CALL FULLRESET
					CALL CARD_GENERATE(듀얼리스트,121956)
				CASE "타이란트 드래곤"
					CALL FULLRESET
					CALL CARD_GENERATE(듀얼리스트,121030)
				CASEELSE
					TRYCALLFORM CARDNAME_{選択カード_ID}("カテゴリ")
					選択カテゴリ = %RESULTS%
					TRYCALLFORM CARD_{選択カード_ID}("レベル")
					選択レベル = RESULT
					TRYCALLFORM CARD_{選択カード_ID}("종족")
					IF 選択カテゴリ == "암드 드래곤" && 選択レベル == 7
						CALL FULLRESET
						CALL CARD_GENERATE(듀얼리스트,121010)
					ELSEIF 選択カテゴリ == "다이달로스" && 選択レベル == 7
						CALL FULLRESET
						CALL CARD_GENERATE(듀얼리스트,135000)
					ELSEIF 選択カテゴリ == "네프티스" && 選択レベル == 8
						CALL FULLRESET
						CALL CARD_GENERATE(듀얼리스트,126350)
					ELSEIF 選択カテゴリ == "호루스" && (選択レベル == 4 || 選択レベル == 6 || 選択レベル == 8) && RESULT == 드래곤족
						CALL FULLRESET
						CALL CARD_GENERATE(듀얼리스트,521325)
					ELSE
						CALL FULLRESET
						효과範囲덱 = 1
						효과条件종족 = 드래곤족
						효과条件レベル = 選択レベル
						효과条件固名前 = 選択カード名前
						CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
					ENDIF
			ENDSELECT
		ENDIF
	ENDIF
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72116)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF
ENDIF

