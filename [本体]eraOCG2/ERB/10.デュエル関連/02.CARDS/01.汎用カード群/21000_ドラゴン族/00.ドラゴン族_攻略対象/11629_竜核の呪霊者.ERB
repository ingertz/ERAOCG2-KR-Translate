@CARDNAME_11629,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 용핵의 주령자
	CASE "略称"
		RESULTS = 용핵의 주령자
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_11629(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 2300
	CASE "守備力"
		RETURN 3000
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		RETURN 1629
	CASE "튜너"
		RETURN 1
ENDSELECT
RETURN 0

