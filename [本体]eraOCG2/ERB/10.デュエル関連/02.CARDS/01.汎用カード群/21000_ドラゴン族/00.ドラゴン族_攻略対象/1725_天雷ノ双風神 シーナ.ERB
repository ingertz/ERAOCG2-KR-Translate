@CARDNAME_1725,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 천뢰의 쌍풍신 시나
	CASE "略称"
		RESULTS = 쌍풍신 시나
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_1725(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 2900
	CASE "守備力"
		RETURN 1500
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251028
ENDSELECT
RETURN 0


@CARD_EXPLANATION_1725(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,발동誘発)
PRINTL ①：자신 필드에 바람속성 몬스터가 존재하고、
PRINTL 상대가 마법 / 함정 / 몬스터의 효과를 발동했을 때에 발동할 수 있다。
PRINTL 이 카드를 패에서 특수 소환한다。
PRINTL 그 후、그 상대의 효과의 종류에 따라 이하의 효과를 적용한다。
PRINTL ●몬스터："천뢰의 쌍풍신 시나" 이외의 필드의 앞면 표시 몬스터를 전부 패로 되돌린다。
PRINTL ●마법 / 함정：필드의 마법 / 함정 카드를 전부 패로 되돌린다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：이 카드는 １턴에 １번만 전투 / 효과로는 파괴되지 않는다。


@CARDCAN_1725(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,1725)
SIF RESULT == 1
	RETURN 0

IF 종류 == 발동誘発
	SIF 발동済_1(듀얼리스트,1725)
		RETURN 0
	SIF ゾーン != "손패"
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,1725,"손패")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件속성 = 바람속성
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_1725(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1725,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,"손패",場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件종류 = モン全般
			CALL CARD_CHECK_START_DATA(듀얼리스트,1,2)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲필드 = 1
				효과範囲상대필드 = 1
				효과条件固名前 = 천뢰의 쌍풍신 시나
				효과条件표시 = 表側표시
				CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"손패")
			ELSE
				CALL FULLRESET
				효과範囲마함 = 1
				효과範囲상대마함 = 1
				CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"손패")
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"一破")
ENDIF


