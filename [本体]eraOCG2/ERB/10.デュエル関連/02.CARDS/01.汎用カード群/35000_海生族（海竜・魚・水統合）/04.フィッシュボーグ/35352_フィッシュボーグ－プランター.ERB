@CARDNAME_35352,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 피시보그 플랜터
	CASE "略称"
		RESULTS = FB－플랜터
	CASE "カテゴリ"
		RESULTS:0 = 피시보그
ENDSELECT

@CARD_35352(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RETURN 바다생물족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 200
	CASE "守備力"
		RETURN 200
	CASE "추가日"
		RETURN 251127
ENDSELECT

RETURN 0

@CARD_EXPLANATION_35352(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 효과는 １턴에 １장밖에 사용할 수 없다。
CALL CARD_ABLE(1,묘지起動)
PRINTL ①：자신 메인 페이즈에 발동할 수 있다。덱 가장 위의 카드를 묘지로 보낸다。
PRINTL 그 카드가 물속성 몬스터였을 경우、이 카드를 묘지에서 특수 소환한다。
PRINTL 그렇지 않은 경우、묘지의 이 카드를 덱으로 되돌린다。


@CARDCAN_35352(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,35352)
SIF RESULT == 1
	RETURN 0

IF 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,35352)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,35352,"묘지")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_35352(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성


IF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,35352,1)
	IF RESULT == 0
		TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_덱:0")}("속성")
		SIF MATCH(RESULT,물속성)
			条件달성 ++
		CALL CARD_DECK_DISPOSE(듀얼리스트,"덱",1)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 피시보그 플랜터
		SIF 条件달성 != 0
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF 条件달성 == 0
			효과条件行先플래그 = 덱行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF

