@CARDNAME_92260,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 뱀파이어의 지배
	CASE "略称"
		RESULTS = Vmp 지배
	CASE "カテゴリ"
		RESULTS:0 = 뱀파이어
ENDSELECT


@CARD_92260(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
ENDSELECT

RETURN 0

@CARD_EXPLANATION_92260(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 1턴에 1장밖에 발동할 수 없다.
CALLFORM CARD_ABLE(1,발동誘発)
PRINTL ①：자신 필드에 "뱀파이어" 몬스터가 존재하고, 상대 몬스터의 효과 마법 / 함정 카드가 발동했을 때 발동할 수 있다.
PRINTL 그 발동을 무효로 하고 파괴한다. 그 후, 자신은 2000LP 회복한다.
CALLFORM CARD_ABLE(2,ターン終了時)
PRINTL ②：이 카드가 묘지에 존재하고、자신 필드에 "뱀파이어" 몬스터가 존재하며、
PRINTL 자신의 LP가 상대의 LP보다 적은 경우、엔드 페이즈에 발동할 수 있다。
PRINTL 이 카드를 자신 필드에 세트한다。
PRINTL 이 효과로 세트한 이 카드는 필드에서 벗어날 경우에 제외된다。



@CARDCAN_92260(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,92260)
SIF RESULT == 1
	RETURN 0

IF 종류 == 발동誘発
	SIF ゾーン != "마함"
		RETURN 0
	SIF 발동済_1(듀얼리스트,92260)
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0	

	CALL FULLRESET
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0

	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 뱀파이어
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン終了時
	SIF 발동済_2(듀얼리스트,92260)
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 뱀파이어
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"ライフ_%듀얼리스트%") >= GETVAR(@"ライフ_%対面者%")
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_92260(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 묘지送カード,5

#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92260,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"묘지")
		CALL LIFE_CHANGE(듀얼리스트,"増加","효과",2000)
		RETURN 1
	ENDIF
	RETURN 0
ELSEIF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92260,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件名前 = 뱀파이어의 지배
		효과추가종류 = 500
		CALL CARD_SET_BASIC(듀얼리스트,"묘지",ゾーン,場所,"裏側표시")
	ENDIF
ENDIF
