@CARDNAME_72203,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 고대거북의 저주
	CASE "略称"
		RESULTS = 고대거북의 저주
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_72203(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
	CASE "추가日"
		RETURN 251014
ENDSELECT
RETURN 0

@CARD_EXPLANATION_72203(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
CALL CARD_ABLE(1, 마함起動, 손패起動)
PRINTL ①：자신의 패 / 묘지에서 언데드족 몬스터 １장을 제외하고 발동할 수 있다。
PRINTL 덱에서 언데드족 몬스터 １장을 묘지로 보낸다。
CALL CARD_ABLE(2, 攻撃後誘発)
PRINTL ②：자신의 언데드족 몬스터가 전투로 파괴되었을 때、묘지의 이 카드를 제외하고 발동할 수 있다。
PRINTL 덱에서 수비력 ２０００이하의 언데드족 몬스터 １장을 특수 소환한다。


@CARDCAN_72203(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트, 종류, ゾーン, 場所, 72203)
SIF RESULT == 1
	RETURN 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트, 72203)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲묘지 = 1
	효과条件종족 = 언데드족
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종족 = 언데드족
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == 攻撃後誘発
	SIF 발동済_2(듀얼리스트, 72203)
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	SIF 直前戦闘破壊ID(듀얼리스트) == 0
		RETURN 0
	IF GETVARS(@"%듀얼리스트%_フィールド名") != "언데드 월드" && GETVARS(@"%対面者%_フィールド名") != "언데드 월드"
		TRYCALLFORM CARD_{直前戦闘破壊ID(듀얼리스트)}("종족")
		SIF RESULT != 언데드족
			RETURN 0
	ENDIF
	
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종족 = 언데드족
	효과条件종류 = モン全般
	효과条件守備力 = 2000
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ENDIF

@CARDEFFECT_72203(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 72203, 1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트, ゾーン, 場所)
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲묘지 = 1
		효과条件종족 = 언데드족
		효과条件종류 = モン全般
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트, ゾーン, 場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件종족 = 언데드족
			효과条件종류 = モン全般
			CALL CARD_ADD_GY_ADV(듀얼리스트, ゾーン, 場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 攻撃後誘発
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 72203, 2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트, ゾーン, 場所)
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종족 = 언데드족
		효과条件守備力 = 2000
		CALL CARD_SP_SUMMON_ADV(듀얼리스트, ゾーン, 場所)
	ENDIF
ENDIF


