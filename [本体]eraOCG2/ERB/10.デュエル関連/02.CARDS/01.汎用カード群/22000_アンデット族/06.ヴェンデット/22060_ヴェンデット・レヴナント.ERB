@CARDNAME_22060,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 벤데드 레버넌트
	CASE "略称"
		RESULTS = VD.Revenants
	CASE "カテゴリ"
		RESULTS:0 = 벤데드
ENDSELECT


@CARD_22060(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
	
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 언데드족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1800
	CASE "守備力"
		RETURN 200
	CASE "추가日"
		RETURN 250707
ENDSELECT

RETURN 0

@CARD_EXPLANATION_22060(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,묘지起動)
PRINTL ①：상대 필드에 몬스터가 존재하는 경우、１０００ＬＰ지불하고 발동할 수 있다。
PRINTL 이 카드를 묘지에서 특수 소환한다。
PRINTL 이 효과로 특수 소환한 이 카드는、필드에서 벗어난 경우에 제외된다。
CALLFORM CARD_ABLE(0,R素材時효과)
PRINTL ②：이 카드가 의식소환의 소재가 된 경우、
PRINTL 자신 필드의 "벤데드"의식몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터는 이하의 효과를 얻는다。
PRINTL ●자신 / 상대 턴에、상대 필드의 특수 소환된 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터를 제외한다。
PRINTL 이 카드명의 이 효과는 １턴에 １번밖에 사용할 수 없다。


@CARDCAN_22060(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,22060)
SIF RESULT == 1
	RETURN 0

IF 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,22060)
		RETURN 0
	SIF GETVAR(@"ライフ_%듀얼리스트%") <= 1000
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF モンスター数(対面者) < 1
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,22060,"묘지")
	SIF RESULT == 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == R素材時효과
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 벤데드
	효과条件종류 = 의식
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

;――――――――――――――――――――――――付与효과――――――――――――――――――――――――

ELSEIF 종류 == 필드起動付与
	SIF 발동済_2(듀얼리스트,29103)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件召種 = 召種全특수
	효과条件除去種 = 제외
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_22060(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 選択カード

IF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22060,1)
	IF RESULT == 0
		CALL LIFE_CHANGE(듀얼리스트,"減少","コスト",1000)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 벤데드 레버넌트
		효과추가종류 = 効追除処
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == R素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22060)
	IF RESULT == 0
		CALL FULLRESET
		효과条件カテゴリ = 벤데드
		효과条件종류 = 의식
		효과条件표시 = 表側표시
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			SIF GETBIT(GETVAR(@"%듀얼리스트%_MZ_汎数:選択カード"),1) != 1
				CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"汎数",2)
		ENDIF
	ENDIF

;――――――――――――――――――――――――付与효과――――――――――――――――――――――――

ELSEIF 종류 == 필드起動付与
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22060,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件召種 = 召種全특수
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"제외")
	ENDIF
ENDIF

