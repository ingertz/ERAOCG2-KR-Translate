@CARDNAME_22006,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 다크 비숍
	CASE "略称"
		RESULTS = 대시교
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_22006(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 언데드족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1000
	CASE "守備力"
		RETURN 1400
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251014
ENDSELECT
RETURN 0

@CARD_EXPLANATION_22006(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
CALL CARD_ABLE(1, 소환時, 특수소환時)
PRINTL ①：이 카드가 소환 / 특수 소환된 경우에 발동할 수 있다。
PRINTL 패 / 덱에서 악마족 / 언데드족의 의식 몬스터 １장을 묘지로 보낸다。그 후、덱에서 의식 마법 카드 １장을 패에 넣을 수 있다。
CALL CARD_ABLE(2, 제외時)
PRINTL ②：이 카드가 제외된 경우、자신의 제외 상태인 레벨４ 이하의 악마족 / 언데드족 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터를 특수 소환한다。


@CARDCAN_22006(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트, 종류, ゾーン, 場所, 22006)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트, 22006)
		RETURN 0
	
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과条件종족:0 = 악마족
	효과条件종족:1 = 언데드족
	효과条件종류 = 의식
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == 제외時
	SIF 발동済_2(듀얼리스트, 22006)
		RETURN 0
	
	CALL FULLRESET
	효과範囲제외 = 1
	효과条件종족:0 = 악마족
	효과条件종족:1 = 언데드족
	CALL 효과条件レベル_ADV(4, "以下")
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ENDIF

@CARDEFFECT_22006(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 22006, 1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲덱 = 1
		효과条件종족:0 = 악마족
		효과条件종족:1 = 언데드족
		효과条件종류 = 의식
		CALL CARD_ADD_GY_ADV(듀얼리스트, ゾーン, 場所)
		
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 의식 마법
		효과条件任意 = 1
		CALL CARD_ADD_ADV(듀얼리스트, ゾーン, 場所)
	ENDIF
ELSEIF 종류 == 제외時
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 22006, 2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲제외 = 1
		효과条件종족:0 = 악마족
		효과条件종족:1 = 언데드족
		CALL 효과条件レベル_ADV(4, "以下")
		CALL CARD_SP_SUMMON_ADV(듀얼리스트, ゾーン, 場所)
	ENDIF
ENDIF


