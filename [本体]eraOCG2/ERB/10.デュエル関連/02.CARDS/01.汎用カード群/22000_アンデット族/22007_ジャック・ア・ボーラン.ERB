@CARDNAME_22007,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 잭 어 보란
	CASE "略称"
		RESULTS = J O 보란
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_22007(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 화염속성

	CASE "종족"
		RETURN 언데드족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 2200
ENDSELECT
RETURN 0

@CARD_EXPLANATION_22007(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1, 손패起動)
PRINTL ①：패에서 언데드족 몬스터 １장을 버리고 발동할 수 있다。
PRINTL 이 카드를 패에서 특수 소환한다。
CALL CARD_ABLE(2, 필드起動, フリー誘発)
PRINTL ②：상대 메인 페이즈에、자신 또는 상대 묘지의 언데드족 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 필드가 "언데드 월드"인 경우、언데드족 이외도 대상으로 할 수 있다。
PRINTL 그 몬스터를 자신 필드에 특수 소환한다。그 후、이 카드는 소실한다。
PRINTL 이 효과로 특수 소환한 몬스터는、필드에서 벗어난 경우에 제외된다。


@CARDCAN_22007(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트, 종류, ゾーン, 場所, 22007)
SIF RESULT == 1
	RETURN 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트, 22007)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트, 22007, "손패")
	SIF RESULT == 1
		RETURN 0
	
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件종족 = 언데드족
	효과条件종류 = モン全般
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_2(듀얼리스트, 22007)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲상대묘지 = 1
	SIF GETVARS(@"%듀얼리스트%_フィールド名") != "언데드 월드" && GETVARS(@"%対面者%_フィールド名") != "언데드 월드"
		효과条件종족 = 언데드족
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ENDIF

@CARDEFFECT_22007(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 22007, 1)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종족 = 언데드족
		효과条件종류 = モン全般
		효과条件他所 = 1
		CALL CARD_ADD_GY_BASIC(듀얼리스트, "손패", ゾーン, 場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트, "손패", 場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 22007, 2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲상대묘지 = 1
		SIF GETVARS(@"%듀얼리스트%_フィールド名") != "언데드 월드" && GETVARS(@"%対面者%_フィールド名") != "언데드 월드"
			효과条件종족 = 언데드족
		효과추가종류 = 効追除処
		CALL CARD_SP_SUMMON_ADV(듀얼리스트, ゾーン, 場所)
		IF RESULT == 1
			CALL CARD_DISPOSE(듀얼리스트, ゾーン, 場所, 제외行き, 1)
		ENDIF
	ENDIF
ENDIF


