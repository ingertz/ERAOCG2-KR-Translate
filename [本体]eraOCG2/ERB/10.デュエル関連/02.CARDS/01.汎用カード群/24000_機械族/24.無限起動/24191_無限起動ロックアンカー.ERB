@CARDNAME_24191,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 무한기동 록앵커
	CASE "略称"
		RESULTS = 무한 록앵커
	CASE "カテゴリ"
		RESULTS:0 = 무한기동
ENDSELECT


@CARD_24191(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1800
	CASE "守備力"
		RETURN 500
	CASE "추가日"
		RETURN 251120
ENDSELECT

RETURN 0

@CARD_EXPLANATION_24191(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １장밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時 ,특수소환時)
PRINTL ①：이 카드가 소환 / 특수 소환한 경우에 발동할 수 있다。
PRINTL 패에서 "무한기동 록앵커" 이외의 기계족 / 땅 속성 몬스터 １장을 수비 표시로 특수 소환한다。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：이 카드 이외의 자신 필드의 기계족 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터와 이 카드는、턴 종료시까지 그 ２장의 원래 레벨을 합친 레벨이 된다。

@CARDCAN_24191(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,24191)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,24191)
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件속성 = 땅속성
	효과条件종족 = 기계족
	효과条件固名前 = 무한기동 록앵커
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트,24191)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0

	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종족 = 기계족
	효과条件종류 = レベル持ち
	효과条件표시 = 表側표시
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_24191(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 合計レベル

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24191,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件속성 = 땅속성
		효과条件종족 = 기계족
		효과条件固名前 = 무한기동 록앵커
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"守備표시")
	ENDIF

ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24191,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종족 = 기계족
		효과条件종류 = レベル持ち
		효과条件표시 = 表側표시
		효과条件他所 = 1
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			TRYCALLFORM CARD_{RESULT:99},"レベル"
			合計レベル = RESULT + 4
			CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"一星",合計レベル,1)
			CALL SET_FIELD_INFO(듀얼리스트,ゾーン,選択カード,"一星",合計レベル,1)
		ENDIF
	ENDIF
ENDIF



