@CARDNAME_52214,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 무한기동요새 메가톤게일
	CASE "略称"
		RESULTS = 무한톤게일
	CASE "カテゴリ"
		RESULTS:0 = 무한기동
ENDSELECT


@CARD_52214(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 4000
	CASE "守備力"
		RETURN 4000
	CASE "추가日"
		RETURN 251120
ENDSELECT
RETURN 0


@CARDSUMMON_52214(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要링크数 = 3
素材条件종류 = 엑시즈

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,52214) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_52214(종류)
#DIM DYNAMIC 종류

PRINTL Ｘ몬스터 ３장
PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １장밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：이 카드는 상대 몬스터의 효과를 받지 않고、Ｘ몬스터 이외와의 전투로는 파괴되지 않는다。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：자신 묘지의 Ｘ몬스터 １장과 상대 필드의 카드 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 묘지의 Ｘ몬스터를 특수 소환하고、그 상대의 카드를 묘지로 보낸다。
PRINTL 이 효과로 특수 소환한 Ｘ몬스터는 Ｘ소재를 １개 가진다。
CALLFORM CARD_ABLE(3,묘지起動)
PRINTL ③：자신 묘지의 기계족 Ｘ몬스터 １장을 제외하고 발동할 수 있다。
PRINTL 묘지의 이 카드를 특수 소환한다。

@CARDCAN_52214(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,52214)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動
    SIF 발동済_2(듀얼리스트,52214)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
    효과条件종류 = 엑시즈
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 0
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = リリース
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 0
		RETURN 0
	RETURN 1

ELSEIF 종류 == 묘지起動
    SIF 발동済_3(듀얼리스트,52214)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,52214,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종족 = 기계족
    효과条件종류 = 엑시즈
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 0
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_52214(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動
    CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52214,2)
	IF RESULT == 0
	    CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종류 = 엑시즈
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과範囲상대마함 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"リリース")
		ENDIF
	ENDIF

ELSEIF 종류 == 묘지起動
    CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52214,3)
	IF RESULT == 0
	    CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종족 = 기계족
		효과条件종류 = 엑시즈
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件名前 = 무한기동요새 메가톤게일
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF

ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"モ耐")

	SIF 戦闘場所(듀얼리스트,1) == 5
		RETURN 0
	TRYCALLFORM CARD_{戦闘カードID(듀얼리스트,1)},"종류"
	SIF !MATCH(RESULT,엑시즈)
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦耐")
ENDIF
