@CARDNAME_72442,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 헤비 포워드
	CASE "略称"
		RESULTS = 초중기회송
	CASE "カテゴリ"
		RESULTS:0 = 무한기동
ENDSELECT


@CARD_72442(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속마법
	CASE "추가日"
		RETURN 251120
ENDSELECT

RETURN 0

@CARD_EXPLANATION_72442(종류)
#DIM DYNAMIC 종류

PRINTL このカードはルール上「무한기동」カードとしても扱う。
PRINTL このカード名のカードは１ターンに１枚しか발동できない。
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①：このカードの발동時の효과処理として、
PRINTL 덱から「무한기동」モンスター１体を손패に加える事ができる。
CALLFORM CARD_ABLE(10,마함起動)
PRINTL ②：１ターンに１度、자신フィールドの기계족Ｘモンスター１体を대상とし、以下の효과から１つを選択して발동できる。
PRINTL ●そのモンスターの표시形式を변경する。
PRINTL ●このカードを묘지へ送り、そのモンスターのＸ素材を１つ増やす。

@CARDCAN_72442(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72442)
SIF RESULT == 1
	RETURN 0


IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종족 = 기계족
	효과条件종류 = 엑시즈
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,72442)
		RETURN 0
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF

@CARDEFFECT_72442(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72442,10)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종족 = 기계족
		효과条件종류 = 엑시즈
		효과条件표시 = 表側표시
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			IF 듀얼리스트 == "자신"
				CALL YN_CHOICE(듀얼리스트,"●표시形式を변경する。","●Ｘ素材を１つ増やす。")
			ELSE
				IF GETVAR(@"%듀얼리스트%_MZ_表:選択カード") != 1
					RESULT = 0
				ELSE
					RESULT = 1
				ENDIF
			ENDIF

			IF RESULT == 0
				IF GETVAR(@"%듀얼리스트%_MZ_表:選択カード") == 2
					CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"表",1,1)
				ELSEIF GETVAR(@"%듀얼리스트%_MZ_表:選択カード") == 1
					CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"表",2,1)
				ENDIF

			ELSEIF RESULT == 1
				CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
				CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"Ｘ",1)
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72442,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 무한기동
		효과条件종류 = モン全般
		효과条件任意 = 1
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF
