@CARDNAME_24408,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = SR 크래커넬
	CASE "略称"
		RESULTS = SR 크래커
	CASE "カテゴリ"
		RESULTS:0 = 스피드로이드
ENDSELECT


@CARD_24408(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 200
	CASE "守備力"
		RETURN 1800
	CASE "分割"
		RETURN 펜듈럼
	CASE "추가日"
		RETURN 251019
ENDSELECT

RETURN 0

@CARD_EXPLANATION_24408(종류)
#DIM DYNAMIC 종류
CALL TEXT_DECORATION("P_MAGIC")
PRINTL 이 카드명의 ①의 P효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動)
PRINTL ①：자신의 묘지에서 "스피드로이드" 카드 １장을 제외하고 발동할 수 있다。
PRINTL 덱에서 "스피드로이드" P몬스터 １장을 자신의 P존에 놓는다。
CALL TEXT_DECORATION("P_MAGIC_2")

PRINTL 이 카드명의 ①②의 몬스터 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(2,戦破壊→묘지)
PRINTL ①：필드의 이 카드가 전투 / 효과로 파괴된 경우에 발동할 수 있다。
PRINTL 자신의 패 / 덱 / 묘지에서 "SR 크래커넬" １장을 튜너 취급으로 특수 소환할 수 있다。
CALLFORM CARD_ABLE(3,攻撃時誘発)
PRINTL ②：이 카드가 EX덱에 앞면으로 존재하는 상태로、
PRINTL 자신의 "클리어윙" 몬스터가 전투를 행한 데미지 계산시에 발동할 수 있다。
PRINTL 이 카드를 제외하고、그 몬스터의 공격력을 ７００올린다。



@CARDCAN_24408(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성
#DIMS DYNAMIC 対面者


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,24408)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1

ELSEIF 종류 == 마함起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 발동済_1(듀얼리스트,24408)
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 스피드로이드
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 스피드로이드
	효과条件分割 = 펜듈럼
	효과条件うらら解除 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 戦破壊→묘지
	SIF !GROUPMATCH(묘지送り종류,"破壊","戦闘破壊")
		RETURN 0
	SIF 발동済_2(듀얼리스트,24408)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲손패 = 1
	효과範囲묘지 = 1
	효과条件名前 = SR 크래커넬
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時誘発
	SIF ゾーン != "EX덱"
		RETURN 0
	SIF 발동済_3(듀얼리스트,24408)
		RETURN 0
    TRYCALLFORM CARDNAME_{戦闘カードID(듀얼리스트)}("カテゴリ")
    SIF !MATCH(RESULTS, "클리어윙")
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0

	RETURN 1
ENDIF

@CARDEFFECT_24408(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24408)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF
ELSEIF 종류 == 마함起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24408,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 스피드로이드
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 스피드로이드
			효과条件分割 = 펜듈럼
			CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"表側표시")
		ENDIF
		SS소환可能속성 = 바람속성
		CALL CARD_SS_RESTRICTION(듀얼리스트)
	ENDIF
ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24408,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲손패 = 1
		효과範囲묘지 = 1
		효과条件名前 = SR 크래커넬
		효과추가종류 = 効追永Ｔ
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24408,3)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,제외行き)
		選択カード = 戦闘場所(듀얼리스트)
		CALL FULLRESET
		CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"永攻",700)
	ENDIF
ENDIF

