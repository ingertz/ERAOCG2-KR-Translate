@CARDNAME_93296,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = CONTAIN!
	CASE "略称"
		RESULTS = CONTAIN!
	CASE "カテゴリ"
		RESULTS:0 = 레스큐 에이스
ENDSELECT


@CARD_93296(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 250927
ENDSELECT

RETURN 0

@CARD_EXPLANATION_93296(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명은 룰 상 "레스큐 에이스" 카드로도 취급한다。
CALLFORM CARD_ABLE(0,마함起動)
PRINTL ①：자신 필드에 "레스큐 에이스" 몬스터가 존재하는 경우、상대 필드의 효과 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 이 턴、그 효과 몬스터는 공격할 수 없으며、효과는 무효화된다。
PRINTL 자신 필드에 "R-ACE 하이드런트"가 존재하는 경우、추가로 이 턴、대상의 몬스터는 특수 소환을 위한 소재로 할 수 없게 된다。
PRINTL

;레스큐 에이스の함정カードの１枚。妨害としては攻撃불가・효과無効とテーマでサーチ可能相応といった程度のスペックだが、
;하이드런트が存在していれば素材불가にもなるため、妨害としてはそこそこ優秀になる。


@CARDCAN_93296(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 하이드런트存在플래그

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,93296)
SIF RESULT == 1
	RETURN 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発
	;SIF 발동済_1(듀얼리스트,93296)
	;	RETURN 0
	;先に하이드런트の存在有無を確認しておいたほうが良さそうなのでここでチェック
	CALL FULLRESET
	효과範囲필드 = 1
	;효과範囲마함 = 1
	효과条件名前 = R-ACE 하이드런트
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		하이드런트存在플래그 = 1
	
	IF ゾーン == "마함"
		;「R-ACE 하이드런트」の②による、使用可能でない状態でセットされているカードの발동を판정する특수な処理
		IF GETVAR(@"%듀얼리스트%_魔_表:場所") == 3
			;そのターンの하이드런트(ID:24295)の②が발동済みである場合はもう발동できない。
			SIF 발동済_2(듀얼리스트,24295)
				RETURN 0
			;자신のフィールドに하이드런트が存在していない場合は발동できない。
			SIF 하이드런트存在플래그 != 1
				RETURN 0
			;이 카드가 「레스큐 에이스」カードの효과でセットされているかをT1汎数で確認
			;T1汎数に128(bit:7)がセットされていない状態では발동できない（터뷸런스、인트루더、EMERGENCY!、REINFORCE!でのセット時に설정する）
			IF GETBIT(GETVAR(@"%듀얼리스트%_魔_T1汎数:場所"),7) != 1
				RETURN 0
			ELSE
				;발동可能状態でのＣＰＵ側のための판정部分。基本的に使う상황は想定できないため、이 카드는 ②효과を消費しての발동はしない。
				IF 듀얼리스트 == "상대"
					RETURN 0
				ENDIF
			ENDIF
		ENDIF
	ELSE
		RETURN 0
	ENDIF
	
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件종류 = 효과全般
	효과条件除去種 = 無効
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_93296(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 효과先
#DIM DYNAMIC 하이드런트存在플래그

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発
	;하이드런트(ID:24295)の②の효과を用いてセットしたターンに발동したのかを確認。
	;마함起動で、表==3のカードがここを通過していたら、하이드런트の②を使用した扱いに。
	IF (종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")) && GETVAR(@"%듀얼리스트%_魔_表:場所") == 3
		SETCOLOR C_YELLOW
		PRINTFORML "R-ACE 하이드런트"의 능력에 의해 세트 카드 발동！！
		RESETCOLOR
		CALL CARD_EFFECT_USE(듀얼리스트,24295,2)
	ENDIF
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,93296,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과条件名前 = R-ACE 하이드런트
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			하이드런트存在플래그 = 1
		
		CALL FULLRESET
		효과条件종류 = 효과全般
		효과条件표시 = 表側표시
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"無効")
		IF RESULT == 1
			효과先 = RESULT:1
			CALL STATCHANGE_EFFECT(対面者,"필드",효과先,"戦無",1)
			SIF 하이드런트存在플래그 == 1
				CALL STATCHANGE_EFFECT(対面者,"필드",효과先,"不材",1)
		ENDIF
	ENDIF
ENDIF


