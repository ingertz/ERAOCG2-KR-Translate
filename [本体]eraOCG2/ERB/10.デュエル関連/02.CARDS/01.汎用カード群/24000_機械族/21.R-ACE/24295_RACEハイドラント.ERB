@CARDNAME_24295,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = R-ACE 하이드런트
	CASE "略称"
		RESULTS = RA하이드런트
	CASE "カテゴリ"
		RESULTS:0 = 레스큐 에이스
ENDSELECT


@CARD_24295(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 無性
	CASE "レア度"
		RETURN ULR
	CASE "추가日"
		RETURN 250927
ENDSELECT
RETURN 0

@CARD_EXPLANATION_24295(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：자신 필드에 "R-ACE 하이드런트" 이외의 "레스큐 에이스" 몬스터가 존재하는 한、이 카드는 공격 회피와 대상 내성을 얻는다。
CALLFORM CARD_ABLE(2,他효과起動)
PRINTL ②：이 카드가 몬스터 존에 존재하는 한、
PRINTL 자신의 세트되어있는 "레스큐 에이스" 속공 마법 / 함정 카드는、세트한 턴에도 발동할 수 있다。
CALLFORM CARD_ABLE(3,필드起動)
PRINTL ③：자신 메인 페이즈에 발동할 수 있다。
PRINTL 덱에서 "R-ACE 하이드런트" 이외의 "레스큐 에이스" 몬스터 １장을 패에 넣는다。

;レスキューエースの真の中核である기계족のシステムモンスター。テーマのリソース源であり、テーマ카드의 효과를 パワーアップする功労者でもある。
;このカードにアクセスできるように展開をすること、이 카드를 필드에 残せるように立ち回ることが레스큐 에이스を上手く使う秘訣。
;素のステータスが低いためCPUに上手く使わせることが難しいのが悩みのタネ。サーチの優先順位をＭＡＸにして１장 採用にしておくとかで調整している。
;この手の카드를 CPUに持たせるにあたり、意図的にピン採用にしてプレイヤーが狙って除去したら崩しやすくするようなバランスにしてるのは結構ある。
;
;CALLFORM CARD_ABLE(2,他효과起動)の記述は、②の효과の使用済みのチェックで用いるようにしている。実際に他효과起動しているわけではない。


@CARDSUMMON_AA_24295


@CARDCAN_24295(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,24295)
SIF RESULT == 1
	RETURN 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動
	SIF 발동済_3(듀얼리스트,24295)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 레스큐 에이스
	효과条件종류 = モン全般
	효과条件固名前 = R-ACE 하이드런트
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 他효과起動
	SIF 발동済_2(듀얼리스트,24295)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_24295(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24295,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 레스큐 에이스
		효과条件종류 = モン全般
		효과条件固名前 = R-ACE 하이드런트
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 레스큐 에이스
	효과条件종류 = モン全般
	효과条件固名前 = R-ACE 하이드런트
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 1
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"対耐")
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"攻避")
	ENDIF
	CALL FULLRESET
	효과条件표시 = 裏側표시
	효과条件カテゴリ = 레스큐 에이스
	효과条件종류 = 마함全般
	CALL STATCHANGE_EFFECT(듀얼리스트,"마함",場所,"発可",3)
ELSEIF 종류 == 他효과起動
	;효과記述なし
ENDIF
