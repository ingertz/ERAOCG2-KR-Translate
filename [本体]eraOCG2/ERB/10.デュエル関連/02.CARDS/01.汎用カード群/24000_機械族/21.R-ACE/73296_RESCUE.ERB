@CARDNAME_73296,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = RESCUE!
	CASE "略称"
		RESULTS = RESCUE!
	CASE "カテゴリ"
		RESULTS:0 = 레스큐 에이스
ENDSELECT


@CARD_73296(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
	CASE "추가日"
		RETURN 250927
ENDSELECT

RETURN 0

@CARD_EXPLANATION_73296(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명은 룰 상 "레스큐 에이스" 카드로도 취급한다。이 카드명의 카드는 １턴에 １장밖에 발동할 수 없다。
CALLFORM CARD_ABLE(1,손패起動,마함起動,フリー誘発)
PRINTL ①：자신 묘지의 "레스큐 에이스" 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL （자신 필드에 "R-ACE 하이드런트"가 존재하는 경우、대신 상대 묘지의 몬스터 １장을 대상으로 하는 것도 가능하다。）
PRINTL 그 몬스터를 자신 필드에 특수 소환한다。
PRINTL 
PRINTL 

;레스큐 에이스の速攻마법の１장 。テーマ専用の蘇生마법として見ると、それだけでなかなか強い효과를 している。
;そのうえ、필드에 「하이드런트」が存在していれば、상대 묘지의 몬스터를 蘇生する事ができる。
;상대依存で打ち所は難しいが、上手く使うことができれば思わぬ形で상대의 展開を阻止できることもある。


@CARDCAN_73296(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 효과使用플래그 = 0
#DIM DYNAMIC 하이드런트存在플래그
#DIM DYNAMIC 条件달성

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,73296)
SIF RESULT == 1
	RETURN 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,73296)
		RETURN 0
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	;先に하이드런트の存在有無を確認しておいたほうが良さそうなのでここでチェック
	CALL FULLRESET
	효과範囲필드 = 1
	;효과範囲마함 = 1
	효과条件名前 = R-ACE 하이드런트
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		하이드런트存在플래그 = 1

	;발동条件を満たしているかチェック
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 레스큐 에이스
	효과条件종류 = モン全般
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		条件달성 ++
	IF 하이드런트存在플래그 == 1
		CALL FULLRESET
		효과範囲상대묘지 = 1
		효과条件종류 = モン全般
		효과条件소환可 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件달성 ++
	ENDIF
	
	;발동条件をどちらも満たしていない(0)場合は발동불가
	SIF 条件달성 == 0
		RETURN 0
	
	RETURN 1
ENDIF

@CARDEFFECT_73296(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 효과使用플래그 = 0
#DIM DYNAMIC 選択結果
#DIM DYNAMIC 하이드런트存在플래그

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73296,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		
		;하이드런트の存在有無を確認
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과条件名前 = R-ACE 하이드런트
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			하이드런트存在플래그 = 1
		
		;발동条件を満たしているかチェック
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 레스큐 에이스
		효과条件종류 = モン全般
		효과条件소환可 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			효과使用플래그 |= 1
		
		IF 하이드런트存在플래그 == 1
			CALL FULLRESET
			효과範囲상대묘지 = 1
			효과条件종류 = モン全般
			효과条件소환可 = 1
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				효과使用플래그 |= 2
		ENDIF
		
		IF 효과使用플래그 & 2 && 효과使用플래그 & 1
			;両方使える場合、どちらを適用するか選択する。CPUは자신의 묘지에서 の레스큐 에이스の蘇生を優先する。
			IF 듀얼리스트 == "상대"
				選択結果 = はい
			ELSE
				PRINTL 어느 효과를 적용하시겠습니까？
				CALL YN_CHOICE(듀얼리스트,"●자신 묘지의「레스큐 에이스」몬스터 １장을 특수 소환한다。","●상대 묘지의 몬스터 １장을 특수 소환한다。")
				選択結果 = RESULT
			ENDIF
		ELSEIF 효과使用플래그 & 1
			選択結果 = はい
		ELSEIF 효과使用플래그 & 2
			選択結果 = いいえ
		ELSE
			;どちらの효과の条件も満たしていない場合、ここで이 효과의 処理は終了とする
			RETURN 0
		ENDIF
		
		IF 選択結果 == はい
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件カテゴリ = 레스큐 에이스
			효과条件종류 = モン全般
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ELSE
			CALL FULLRESET
			효과範囲상대묘지 = 1
			효과条件종류 = モン全般
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF

