@CARDNAME_73297,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ALERT!
	CASE "略称"
		RESULTS = ALERT!
	CASE "カテゴリ"
		RESULTS:0 = 레스큐 에이스
ENDSELECT


@CARD_73297(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
	CASE "추가日"
		RETURN 250927
ENDSELECT

RETURN 0

@CARD_EXPLANATION_73297(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명은 룰 상 "레스큐 에이스" 카드로도 취급한다。이 카드명의 카드는 １턴에 １장밖에 발동할 수 없다。
CALLFORM CARD_ABLE(1,손패起動,마함起動,フリー誘発)
PRINTL ①：자신의 묘지에서 "레스큐 에이스" 몬스터 １장을 패에 넣는다。
PRINTL 자신 필드에 "R-ACE 하이드런트"가 존재하는 경우、
PRINTL 대신에 덱에서 "레스큐 에이스" 몬스터 １체를 패에 넣을 수 있다。
PRINTL 
PRINTL 

;레스큐 에이스の速攻마법の１枚。テーマの몬스터를 묘지에서 サルベージする효과は、先攻展開で使うにはあまり強くない。
;하이드런트がフィールドに居れば덱에서 のサーチ효과になるため、条件を満たした状態で발동できるように立ち回りたい。
;발동時に条件を満たしていないとうららチェックが入らないが、효과処理時に条件を満たしているとうららチェックをスルーしてサーチできてしまう。
;かなり限定的なため、条件に関わらず常にチェックするよりは、多少甘くてもスルーするほうが丸いかと思い、認識はしてるが処置は入れていない。
;eraOCG2の場合、条件を満たしていない묘지サルベージしか行えない場合はうららが反応して投げても無効化できないという상황になるため。


@CARDCAN_73297(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 条件달성カード名,10
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 효과使用플래그 = 0
#DIM DYNAMIC 하이드런트存在플래그

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,73297)
SIF RESULT == 1
	RETURN 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,73297)
		RETURN 0
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	;先に하이드런트の存在有無を確認しておいたほうが良さそうなのでここでチェック
	CALL FULLRESET
	효과範囲필드 = 1
	;효과範囲마함 = 1
	효과条件名前 = R-ACE 하이드런트
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		하이드런트存在플래그 = 1
	;발동条件を満たしているかチェック
	CALL FULLRESET
	효과範囲묘지 = 1
	SIF 하이드런트存在플래그 == 1
		효과範囲덱 = 1
	효과条件カテゴリ = 레스큐 에이스
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ENDIF

@CARDEFFECT_73297(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 하이드런트存在플래그

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	;마함起動で、表==3のカードがここを通過していたら、하이드런트の②を使用した扱いに。
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73297,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		
		;하이드런트の存在有無を確認
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과条件名前 = R-ACE 하이드런트
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			하이드런트存在플래그 = 1
		
		CALL FULLRESET
		효과範囲묘지 = 1
		SIF 하이드런트存在플래그 == 1
			효과範囲덱 = 1
		효과条件カテゴリ = 레스큐 에이스
		효과条件종류 = モン全般
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF

