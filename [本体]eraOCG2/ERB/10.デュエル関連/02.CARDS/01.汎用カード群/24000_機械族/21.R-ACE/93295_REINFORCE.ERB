@CARDNAME_93295,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = REINFORCE!
	CASE "略称"
		RESULTS = REINFORCE!
	CASE "カテゴリ"
		RESULTS:0 = 레스큐 에이스
ENDSELECT


@CARD_93295(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 250927
ENDSELECT

RETURN 0

@CARD_EXPLANATION_93295(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명은 룰 상 "레스큐 에이스" 카드로도 취급한다。이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
PRINTL 이 카드명의 카드는 １턴에 １장밖에 발동할 수 없다。
CALLFORM CARD_ABLE(0,마함起動)
PRINTL ①：자신 필드의 "레스큐 에이스" 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 자신의 몬스터는 이 턴、공격력 / 수비력이 １５００ 오르고、상대 몬스터의 효과를 받지 않으며、１번만 전투에선 파괴되지 않는다。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②：묘지의 이 카드를 제외하고、자신 묘지의 "레스큐 에이스" 마법 카드 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 카드를 자신 필드에 세트한다。


;레스큐 에이스の함정カードの１枚。자신 필드의 テーマモンスターを強化しつつ、様々な耐性をつける事ができる。
;直接的な妨害にならず상대の動きに依存しがちな欠点はあるが、使えればなかなか頼もしい효과をしている。
;また、묘지효과で마법カードのセットも可能というのが地味ながらアド差を生み出す原動力になる事があり、馬鹿にできないスペックがある。


@CARDCAN_93295(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 추가条件플래그 = 0
#DIM DYNAMIC 하이드런트存在플래그

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,93295)
SIF RESULT == 1
	RETURN 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発

	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 레스큐 에이스
	효과条件종류 = モン全般
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF 발동済_2(듀얼리스트,93295)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 레스큐 에이스
	효과条件종류 = 마법全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ENDIF



@CARDEFFECT_93295(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIM DYNAMIC カード추가先

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,93295,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 레스큐 에이스
		효과条件종류 = モン全般
		효과条件표시 = 表側표시
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"一攻",1500)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"一守",1500)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"モ耐",1,上書きモード)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"一破",1,上書きモード)
		ENDIF
	ENDIF
ELSEIF 종류 == 묘지起動
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,93295,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,제외行き)
		;마함に直接セットする処理。T1汎数に128(bit:7)も설정する。
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 레스큐 에이스
		효과条件종류 = 마법全般
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"裏側표시")
		IF RESULT == 1
			;RESULT:2にカード추가先の情報がある。
			カード추가先 = RESULT:2
			CALL SET_FIELD_INFO(듀얼리스트,"마함",カード추가先,"T1汎数",128)
			;フィールド마법にもT1汎数がセットされるが、実害はないと思うので処理そのまま
		ENDIF
	ENDIF
ENDIF


