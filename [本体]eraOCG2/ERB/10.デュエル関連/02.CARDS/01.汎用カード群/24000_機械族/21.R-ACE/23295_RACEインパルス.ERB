@CARDNAME_23295,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = R-ACE 임펄스
	CASE "略称"
		RESULTS = RA임펄스
	CASE "カテゴリ"
		RESULTS:0 = 레스큐 에이스
ENDSELECT


@CARD_23295(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 1500
	CASE "성별"
		RETURN 雄性
	CASE "レア度"
		RETURN SPR
	CASE "추가日"
		RETURN 250927
ENDSELECT
RETURN 0

@CARD_EXPLANATION_23295(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時,특수소환時)
PRINTL ①：이 카드가 소환 / 특수 소환된 경우에 발동할 수 있다。
PRINTL 덱에서 "R-ACE 하이드런트" １장을 수비 표시로 특수 소환한다。
PRINTL 이 효과의 발동 후, 턴 종료 시까지 자신은 화염속성 몬스터밖에 특수 소환할 수 없다。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：자신 메인 페이즈에 발동할 수 있다。상대 필드의 공격력이 가장 높은 효과 몬스터 １장을 고른다。
PRINTL 이 턴、각 플레이어는 그 몬스터의 효과를 발동할 수 없다。
CALLFORM CARD_ABLE(3,발동誘発)
PRINTL ③：상대가 몬스터의 효과를 필드에서 발동했을 때、패 / 필드의 이 카드를 릴리스 하고 발동할 수 있다。
PRINTL 자신의 덱에서 기계족인 "레스큐 에이스" 몬스터 １장을 특수 소환한다。

;レスキューエースの基本となる전사족モンスター。攻守は物足りないが、손패誘発的な효과를 持っている下級モンスターと考えるとまあまあな性能。
;필드での起動효과は、墓穴と同様の同名발동불가의 효과를 서로의 プレイヤーに付与する효과に설정している。묘지送り時の효과とかも발동할 수 없다。
;①として소환 / 특수소환でレベル４以下をリクルートする효과를 추가しており、テーマ内の初動札として最優秀のポジションに就かせている。
;
;こいつに初動になれるように효과를 추가した意図は、攻守1500のこいつは火霊媒師ヒータでサーチ可能だからである。
;実用的な純레스큐 에이스のアイドル枠として霊媒ヒータ使ってほしいなあという気持ち故の処置。
;強力なぶん화염속성のＳＳ縛りがつくので、ジーランティスとかウーサとか、その辺りが使いにくくなる点は注意。


@CARDSUMMON_AA_23295


@CARDCAN_23295(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,23295)
SIF RESULT == 1
	RETURN 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,23295)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件名前 = R-ACE 하이드런트
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트,23295)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件종류 = 효과全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF 발동済_3(듀얼리스트,23295)
		RETURN 0
	SIF !GROUPMATCH(ゾーン,"필드","손패")
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 레스큐 에이스
	효과条件종족 = 기계족
	효과条件종류 = モン全般
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ENDIF

@CARDEFFECT_23295(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名
#DIM DYNAMIC 攻撃力판정
#DIM DYNAMIC 설정場所

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,23295,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件名前 = R-ACE 하이드런트
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"守備표시")
		CALL FULLRESET
		SS소환可能속성 = 화염속성
		CALL CARD_SS_RESTRICTION(듀얼리스트)
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,23295,2)
	IF RESULT == 0
		;상대 필드의 몬스터의 最大攻撃力を確認する。
		;参考：戦華の叛－呂奉
		FOR カウンタ,0,5
			SIF GETVAR(@"%対面者%_필드:カウンタ") == -1
				CONTINUE
			SIF GETVAR(@"%対面者%_MZ_表:カウンタ") == 3
				CONTINUE
			IF 攻撃力판정 < GETVAR(@"%対面者%_MZ_攻:カウンタ")
				攻撃力판정 = GETVAR(@"%対面者%_MZ_攻:カウンタ")
				설정場所 = カウンタ
			ENDIF
		NEXT
		IF 설정場所 >= 0
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과条件以攻撃力 = 攻撃力판정
			CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT != 9999
				選択カード = RESULT:99
				TRYCALLFORM CARDNAME_{選択カード}("名前")
				選択カード名 = %RESULTS%
				PRINTFORML 서로의 플레이어는 이 턴、「%選択カード名%」의 효과를 발동할 수 없게 되었다！
				CALL CARD_EFFECT_PROHIB(듀얼리스트, 選択カード,2,1)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,23295,3)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
	
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 레스큐 에이스
		효과条件종족 = 기계족
		효과条件종류 = モン全般
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF
