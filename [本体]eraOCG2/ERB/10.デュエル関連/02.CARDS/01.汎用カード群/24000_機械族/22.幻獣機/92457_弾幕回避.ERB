@CARDNAME_92457,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 배럴 롤
	CASE "略称"
		RESULTS = 배럴 롤
	CASE "カテゴリ"
		RESULTS:0 = 환상수기
ENDSELECT


@CARD_92457(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
ENDSELECT
RETURN 0

@CARD_EXPLANATION_92457(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명은 룰상 "환상수기" 카드로도 취급한다。
PRINTL 이 카드명의 ①②의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
;トークン万能無効
CALLFORM CARD_ABLE(1,발동誘発)
PRINTL ①：몬스터의 효과 / 마법 / 함정 카드가 발동했을 때、자신 필드의 토큰 １장을 릴리스 하고 발동할 수 있다。
PRINTL 그 발동을 무효로 하고 파괴한다。
;トークン再セット
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②：자신 메인페이즈에 자신 필드의 "환상수기" 몬스터 １장을 릴리스 하고 발동할 수 있다。
PRINTL 묘지의 이 카드를 자신 필드에 세트한다。
PRINTL 이 효과로 세트한 카드는 묘지로 보내질 경우에 제외된다。



@CARDCAN_92457(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,92457)
SIF RESULT == 1
	RETURN 0
;トークン万能無効
IF 종류 == 발동誘発
	SIF 발동済_1(듀얼리스트,92457)
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = トークン
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
;トークン再セット
ELSEIF 종류 == 묘지起動
	SIF 발동済_2(듀얼리스트,92457)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 환상수기
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ENDIF

@CARDEFFECT_92457(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%
;トークン万能無効
IF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92457,1)
	;参考：リフレーミングや空殺
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과条件종류 = トークン
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"묘지")
		ENDIF
	ENDIF
;トークン再セット
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92457,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件カテゴリ = 환상수기
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件名前 = 배럴 롤
			효과추가종류 = 500
			CALL CARD_SET_BASIC(듀얼리스트,"묘지",ゾーン,場所,"裏側표시")
		ENDIF
	ENDIF
ENDIF

