@CARDNAME_92455,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 에어리얼 차지
	CASE "略称"
		RESULTS = 에어리얼 차지
	CASE "カテゴリ"
		RESULTS:0 = 환상수기
ENDSELECT


@CARD_92455(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속함정
	CASE "生成カード"
		RETURN 124210
ENDSELECT
RETURN 0

@CARD_EXPLANATION_92455(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명은 룰상 "환상수기" 카드로도 취급한다。
PRINTL 이 카드명의 ②③의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
;トークン生成
CALLFORM CARD_ABLE(10,마함起動,フリー誘発)
PRINTL ①：１턴에 １번、자신 / 상대 턴에 발동할 수 있다。
PRINTL 자신 필드에 "환상수기 토큰" １장을 특수 소환한다。
;循環ドロー
CALLFORM CARD_ABLE(1,ターン終了時)
PRINTL ②：자신 / 상대의 엔드 페이즈에 발동할 수 있다。
PRINTL 자신의 묘지 / 제외 상태인 "환상수기" 카드 ３장을 덱으로 되돌리고、１장 드로우한다。
;묘지蘇生
CALLFORM CARD_ABLE(2,묘지起動,フリー誘発)
PRINTL ③：묘지의 이 카드를 제외하고 발동할 수 있다。
PRINTL 자신의 묘지에서 "환상수기" 몬스터 １장을 특수 소환한다。


@CARDCAN_92455(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,92455)
SIF RESULT == 1
	RETURN 0
;トークン生成
IF (종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1) || (종류 == フリー誘発 && ゾーン == "마함" && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1)
;IF 종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,124210,"")
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン終了時
	SIF 발동済_1(듀얼리스트,92455)
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件カテゴリ = 환상수기
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 3
		RETURN 0
	RETURN 1
;묘지蘇生
ELSEIF 종류 == 묘지起動 || (종류 == フリー誘発 && ゾーン == "묘지")
	SIF 발동済_2(듀얼리스트,92455)
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 환상수기
	효과条件종류 = モン全般
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0

	RETURN 1
ELSEIF 종류 == 마함起動
	SIF ゾーン != "마함"
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_92455(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択肢
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%
;トークン生成
;IF 종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")
IF (종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1) || (종류 == フリー誘発 && ゾーン == "마함" && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1)
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92455,10)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_GENERATE(듀얼리스트,124210)
	ENDIF
;循環ドロー
ELSEIF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92455,1)
	IF RESULT == 0
		;参考：貪壺・かくれんぼ・クラスター
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲제외 = 1
		효과条件カテゴリ = 환상수기
		효과条件複数 = 3
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL CARDDRAW_BASIC(듀얼리스트,1)
		ENDIF

	ENDIF
;묘지蘇生
ELSEIF 종류 == 묘지起動 || (종류 == フリー誘発 && ゾーン == "묘지")
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92455,2)
	IF RESULT == 0
		;参考：ホールティア
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 환상수기
		효과条件종류 = モン全般
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 마함起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92455)
	IF RESULT == 0
	ENDIF
ENDIF

