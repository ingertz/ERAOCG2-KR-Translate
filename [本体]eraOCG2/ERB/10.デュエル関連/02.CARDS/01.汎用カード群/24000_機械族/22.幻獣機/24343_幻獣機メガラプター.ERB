@CARDNAME_24343,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 환상수기 메가랩터
	CASE "略称"
		RESULTS = 메가랩터
	CASE "カテゴリ"
		RESULTS:0 = 환상수기
		RESULTS:1 = 환상수
ENDSELECT


@CARD_24343(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1900
	CASE "守備力"
		RETURN 1000
	CASE "生成カード"
		RETURN 124210
ENDSELECT
RETURN 0

@CARD_EXPLANATION_24343(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
;トークン生成
CALLFORM CARD_ABLE(1,효과後誘発)
PRINTL ①：자신 필드에 "환상수기 메가랩터" 이외의 몬스터가 특수소환 된 경우에 발동할 수 있다。
PRINTL 자신 필드에 "환상수기 토큰" １장을 특수 소환한다。
;トークンサーチ
CALLFORM CARD_ABLE(10,필드起動)
PRINTL ②：１턴에 １번、자신 메인페이즈에 자신 필드의 토큰 １장을 릴리스 하고 발동할 수 있다。
PRINTL 덱에서 「환상수기」カード １장을 패에 넣는다。
;PRINTL 그 후、자신は덱에서 １枚ドローできる。
;共通レベル変動・戦破耐性
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：자신 필드에 토큰이 존재하는 한
PRINTL 이 카드의 레벨은 ７이 되며、전투 / 효과로는 파괴되지 않는다。


@CARDCAN_24343(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,24343)
SIF RESULT == 1
	RETURN 0
;トークン生成
IF 종류 == 효과後誘発
	SIF 발동済_1(듀얼리스트,24343)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,124210,"")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과条件固名前 = 환상수기 메가랩터
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환")
	SIF RESULT != 1
		RETURN 0
	RETURN 1
;トークンサーチ
ELSEIF  종류 == 필드起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = トークン
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	효과範囲덱 = 1
	효과条件カテゴリ = 환상수기
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
;耐性レベル変動
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = トークン
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_24343(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

;トークン生成
IF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24343,1)
	IF RESULT == 0
		;参考：공아단
		CALL FULLRESET
		CALL CARD_GENERATE(듀얼리스트,124210)
	ENDIF
;トークンサーチ
ELSEIF  종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,24343,10)
	IF RESULT == 0
		;参考：エンゲージ
		CALL FULLRESET
		효과条件종류 = トークン
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件カテゴリ = 환상수기
			CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所)
			;추가ドロー！
			;CALL CARDDRAW_BASIC(듀얼리스트,1)
		ENDIF
	ENDIF

;耐性レベル変動
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"破耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"星",7)
ENDIF


