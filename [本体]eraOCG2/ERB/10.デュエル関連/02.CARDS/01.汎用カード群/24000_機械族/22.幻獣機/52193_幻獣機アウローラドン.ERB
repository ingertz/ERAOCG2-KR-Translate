@CARDNAME_52193,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 환상수기 아우로라돈
	CASE "略称"
		RESULTS = 아우로라돈
	CASE "カテゴリ"
		RESULTS:0 = 환상수기
		RESULTS:1 = 환상수
ENDSELECT


@CARD_52193(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 2100
	CASE "守備力"
		RETURN 0
	CASE "生成カード"
		RETURN 124210
ENDSELECT
RETURN 0

@CARDSUMMON_52193(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 3
素材条件종족 = 기계족

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,52193) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_52193(종류)
#DIM DYNAMIC 종류

PRINTL 기계족 몬스터 ２장 이상
;トークン生成
CALLFORM CARD_ABLE(0,EX소환時)
PRINTL ①：이 카드가 링크 소환에 성공한 경우에 발동할 수 있다。
PRINTL 자신 필드에 "환상수기 토큰" ３장까지、가능한 한 특수 소환한다。
PRINTL 이 턴、자신은 Ｌ소환 할 수 없다。
;トークン活用
CALLFORM CARD_ABLE(10,필드起動)
PRINTL ②：１턴에 １번、자신 필드의 몬스터를 ３장까지 릴리스 하고 발동할 수 있다。
PRINTL 릴리스한 몬스터의 수에 따라 이하의 효과를 적용한다。
PRINTL ●１장：필드의 카드 １장을 파괴한다。
PRINTL ●２장：덱에서 "환상수기" 몬스터 １장을 특수 소환한다。
PRINTL ●３장：자신의 묘지에서 함정 카드 １장을 패에 넣는다。


@CARDCAN_52193(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,52193)
SIF RESULT == 1
	RETURN 0
;トークン生成
IF 종류 == EX소환時
	;3体소환するから3体未満でないとダメ
	CALL CARD_SS_CHECK(듀얼리스트,124210,"")
	SIF RESULT == 1
		RETURN 0
	RETURN 1
;トークン活用
ELSEIF 종류 == 필드起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	RETURN 1
ENDIF

@CARDEFFECT_52193(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC リリース数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%
;トークン生成
IF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52193)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_GENERATE(듀얼리스트,124210,"",0,3)
		;링크불가→Ｆ・Ｓ / Ｘは可
		EX소환可能종류:0 = 융합
		EX소환可能종류:1 = 싱크로
		EX소환可能종류:2 = 엑시즈
		CALL CARD_EX_RESTRICTION(듀얼리스트)
	ENDIF
;トークン活用
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52193,10)
	IF RESULT == 0
		IF 듀얼리스트 == "자신"
			PRINTFORML 몬스터를 몇장 릴리스 하시겠습니까？
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件CNT = 1
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT >= 1
				PRINTL [1] - １장
			SIF RESULT >= 2
				PRINTL [2] - ２장
			SIF RESULT >= 3
				PRINTL [3] - ３장
			BINPUT
			リリース数 = RESULT
		ELSE
			IF モンスター数(듀얼리스트) == 1
				リリース数 = 1
			ELSEIF モンスター数(듀얼리스트) == 2
				リリース数 = 2
			ELSEIF モンスター数(듀얼리스트) >= 3
				リリース数 = 3
			ENDIF
		ENDIF
		CALL FULLRESET
		효과条件複数 = リリース数
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT == 1
			IF リリース数 == 1
				CALL FULLRESET
				효과範囲상대필드 = 1
				효과範囲상대마함 = 1
				CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
			ENDIF
			IF リリース数 == 2
				CALL FULLRESET
				효과範囲덱 = 1
				효과条件カテゴリ = 환상수기
				CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
			IF リリース数 == 3
				CALL FULLRESET
				효과条件종류 = 함정全般
				CALL CARD_ADD_BASIC(듀얼리스트,"묘지",ゾーン,場所)
			ENDIF
		ENDIF
	ENDIF
ENDIF

