@CARDNAME_52191,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 환상수기 야쿠루슬란
	CASE "略称"
		RESULTS = 야쿠루슬란
	CASE "カテゴリ"
		RESULTS:0 = 환상수기
		RESULTS:1 = 환상수
ENDSELECT

@CARDSUMMON_52191(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要レベル数 = 9
素材条件종족 = 기계족

IF EX参照 == 0 || EX参照 == 1
	素材条件튜너 = 1
ELSEIF EX参照 >= 10
	素材条件튜너 = -1
ENDIF

IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,52191) 
	RETURN RESULT
ENDIF

@CARD_52191(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 2700
	CASE "守備力"
		RETURN 2200

ENDSELECT
RETURN 0

@CARD_EXPLANATION_52191(종류)
#DIM DYNAMIC 종류

PRINTL 기계족 튜너＋튜너 이외의 기계족 몬스터 １장 이상
PRINTL 이 카드명의 ①③의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
;S時ハンデス
CALLFORM CARD_ABLE(1,EX소환時)
PRINTL ①：이 카드가 Ｓ소환된 경우에 자신 필드의 토큰 １장을 릴리스 하고 발동할 수 있다。
PRINTL 상대의 패를 무작위로 １장 버린다。
;耐性付与
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：이 카드가 몬스터 존에 존재하는 한、
PRINTL "환상수기 야쿠루슬란" 이외의 자신 필드의 "환상수기" 몬스터는 전투 / 효과로 파괴되지 않는다。
;破壊時함정セット
CALLFORM CARD_ABLE(2,戦闘→묘지 ,破壊→묘지)
PRINTL ③：이 카드가 전투 / 효과로 파괴된 경우에 발동할 수 있다。
PRINTL 덱에서 "환상수기" 마법 / 함정 카드 １장을 덱에서 자신 필드에 세트한다。
PRINTL 이 효과로 세트한 카드는 세트한 턴에도 발동할 수 있다。


@CARDCAN_52191(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,52191)
SIF RESULT == 1
	RETURN 0
;ハンデス
IF 종류 == EX소환時
	SIF 발동済_1(듀얼리스트,52191)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = トークン
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 손패数(対面者) == 0
		RETURN 0
	RETURN 1

;耐性付与
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
;破壊時함정セット
ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지
	SIF 발동済_2(듀얼리스트,52191)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 환상수기
	효과条件종류 = 마함全般
	효과条件セット = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_52191(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

;ハンデス
IF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52191,1)
	IF RESULT == 0
		;参考：ウロボロス、トリシューラ
		CALL FULLRESET
		효과条件종류 = トークン
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"손패破壊",場所,"묘지")
		ENDIF
	ENDIF
;耐性レベル変動
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件カテゴリ = 환상수기
	효과条件固名前 = 환상수기 야쿠루슬란
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"戦耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"破耐")
;破壊時함정セット
ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52191,2)
	IF RESULT == 0
		;参考：アリアス、トラップトリック
		효과範囲덱 = 1
		효과条件カテゴリ = 환상수기
		효과条件종류 = 마함全般
		CALL CARD_SET_BASIC(듀얼리스트,"덱",ゾーン,場所,"使化裏側표시")
	ENDIF
ENDIF




