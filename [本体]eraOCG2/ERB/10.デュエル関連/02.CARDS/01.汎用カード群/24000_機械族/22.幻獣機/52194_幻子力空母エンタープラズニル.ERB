@CARDNAME_52194,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 미라지포트리스 엔터프라즈닐
	CASE "略称"
		RESULTS = 프라즈닐
	CASE "カテゴリ"
		RESULTS:0 = 환상수기
ENDSELECT


@CARD_52194(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 2900
	CASE "守備力"
		RETURN 2500

ENDSELECT
RETURN 0

@CARDSUMMON_52194(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 9

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,52194) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_52194(종류)
#DIM DYNAMIC 종류

PRINTL 레벨９ 몬스터×２
PRINTL "미라지포트리스 엔터프라즈닐"은 자신 필드에 토큰이 존재하는 경우、
PRINTL 자신 필드의 "환상수기" Ｓ몬스터 위에 겹쳐서 Ｘ소환할수도 있다。
PRINTL 이 카드의 ①②의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
;제외
CALLFORM CARD_ABLE(1,필드起動)
PRINTL ①：이 카드의 Ｘ소재를 １장 제거하고、이하의 효과에서 １개 선택해서 발동할 수 있다。
PRINTL ●상대 필드의 카드 １장을 제외한다。
PRINTL ●상대의 패를 무작위로 １장 제외한다。
PRINTL ●상대 묘지의 카드 １장을 제외한다。
PRINTL ●상대의 덱 가장 위의 카드를 제외한다。
;共通戦破耐性
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：자신 필드에 토큰이 존재하는 한、이 카드는 전투 / 효과로는 파괴되지 않는다。

@CARDCAN_52194(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,52194)
SIF RESULT == 1
	RETURN 0
;重ねてX
IF 종류 == EX덱起動
	SIF 발동済_3(듀얼리스트,52194)
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,52194)
	SIF RESULT == 1
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = トークン
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 환상수기
	효과条件종류 = 싱크로
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

;色々제외
ELSEIF 종류 == 필드起動
	SIF 발동済_1(듀얼리스트,52194)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	;1つの場所でも제외できるなら使える
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT != 1 && 손패数(対面者) == 0 && 묘지数(対面者) == 0
		CALL FULLRESET
		효과範囲상대덱 = 1
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT < 1
			RETURN 0
	ENDIF
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = トークン
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_52194(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

;重ねてX
IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52194,3)
	IF RESULT == 0
		;参考：ジャムフィーバー、アライズハート
		CALL RESETCONDITION_MAT
		必要素材数 = 1
		素材条件カテゴリ = 환상수기
		素材条件종류 = 싱크로
		重ねてＸ = 1
		TRYCALLFORM XYZSUMMON(듀얼리스트,場所)
	ENDIF
;色々제외
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52194,2,X消費1)
	IF RESULT == 0
		;参考：ウロボロス、ライズハート
		IF 듀얼리스트 == "자신"
			PRINTL
			PRINTL 어느 효과를 발동하시겠습니까？
			PRINTL
			IF モンスター数(対面者) != 0 || 마함数(対面者) != 0
				PRINTL [ 1] - ●상대 필드의 카드 １장을 제외한다。
			ELSE
				PRINTL  --  - 상대 필드에 카드가 존재하지 않습니다。
			ENDIF
			IF 손패数(対面者) != 0
				PRINTL [ 2] - ●상대의 패를 무작위로 １장 제외한다。
			ELSE
				PRINTL  --  - 상대의 패에 카드가 존재하지 않습니다。
			ENDIF
			IF 묘지数(対面者) != 0
				PRINTL [ 3] - ●상대 묘지의 카드 １장을 제외한다。
			ELSE
				PRINTL  --  - 상대 묘지에 카드가 존재하지 않습니다。
			ENDIF
			CALL FULLRESET
			효과範囲상대덱 = 1
			효과条件CNT = 1
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT != 0
				PRINTL [ 4] - ●상대의 덱 가장 위의 카드를 제외한다。
			ELSE
				PRINTL  --  - 상대의 덱에 카드가 존재하지 않습니다。
			ENDIF
			BINPUT
		ELSEIF 듀얼리스트 == "상대"
			
			IF モンスター数(対面者) != 0 || 마함数(対面者) != 0
				RESULT = 1
			ELSEIF 손패数(対面者) != 0
				RESULT = 2
			ELSEIF 묘지数(対面者) != 0
				RESULT = 3
			ELSE
				CALL FULLRESET
				효과範囲상대덱 = 1
				효과条件CNT = 1
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				SIF RESULT < 1
					RESULT = 4
				
			ENDIF
		ENDIF
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"全場単体",場所,"제외")
		ELSEIF RESULT == 2
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"손패破壊",場所,"제외")
		ELSEIF RESULT == 3
			CALL FULLRESET
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"상대묘지",ゾーン,場所)
		ELSEIF RESULT == 4
			CALL FULLRESET
			CALL CARD_DECK_DISPOSE(듀얼리스트,"상대덱",1,제외行き)
		ENDIF
	ENDIF
;耐性レベル変動
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"破耐")
ENDIF
