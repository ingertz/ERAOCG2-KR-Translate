CALLFORM CARD_ABLE(10,필드起動,フリー誘発)
PRINTL ②：상대 턴에 １번、덱 / ＥＸ덱에서 카드 1장씩 제외하고 발동할 수 있다。 
PRINTL 상대 필드 / 묘지의 카드를 모두 제외한다。 


@CARDSUMMON_52356(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件
素材条件名前:0 = VWXYZ－드래곤 캐터펄트 캐논
素材条件名前:1 = 암드 드래곤 LV7

RETURN 0

@CARDCAN_52356(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 無効予定

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,52356)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,52356)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲묘지 = 1
	효과条件スーパー名前 = VWXYZ－드래곤 캐터펄트 캐논
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲묘지 = 1
	효과条件レベル = 7
	효과条件カテゴリ = 암드 드래곤
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 常在無効 
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF  종류 == 발동強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_START_DATA_2(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	無効予定 = 効後_효과ID:(効後_カウンタ - 1)
	CALL FULLRESET
	효과範囲제외 = 1
	효과範囲상대제외 = 1
	효과条件ID = 無効予定
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	RETURN 1
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲EX덱 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과範囲상대묘지 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_52356(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 제외カードA
#DIM DYNAMIC 제외カードB
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52356)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과範囲묘지 = 1
		효과条件行先플래그 = 제외行き
		효과条件スーパー名前 = VWXYZ－드래곤 캐터펄트 캐논
		효과条件レベル = 7
		효과条件カテゴリ = 암드 드래곤
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			제외カードA = RESULT:1
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲마함 = 1
			효과範囲묘지 = 1
			효과条件行先플래그 = 제외行き
			IF 제외カードA == 221190
				효과条件ID = 52355
			ELSEIF 제외カードA == 52355
				효과条件レベル = 7
				효과条件カテゴリ = 암드 드래곤
			ENDIF
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과条件特不無視 = 1
				CALL CARD_SP_SUMMON(듀얼리스트,"EX덱",場所)	
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 常在無効
	CALL SET_PLAYER_INFO(듀얼리스트,"제외_無効",3,1)
	FOR カウンタ,0,5
		SIF GETVAR(@"%対面者%_필드:カウンタ") == -1
			CONTINUE
		選択カード_ID = GETVAR(@"%対面者%_필드:カウンタ")
		CALL FULLRESET
		효과範囲제외 = 1
		효과範囲상대제외 = 1
		효과条件ID = 選択カード_ID
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件固定 = カウンタ
			효과条件표시 = 表側표시
			CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"無効")
		ENDIF
	NEXT
	FOR カウンタ,0,5
		SIF GETVAR(@"%対面者%_마함:カウンタ") == -1
			CONTINUE
		選択カード_ID = GETVAR(@"%対面者%_마함:カウンタ")
		CALL FULLRESET
		효과範囲제외 = 1
		효과範囲상대제외 = 1
		효과条件ID = 選択カード_ID
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件固定 = カウンタ
			효과条件표시 = 表側표시
			CALL STATCHANGE_EFFECT(듀얼리스트,"상대마함",場所,"無効")
		ENDIF
	NEXT
ELSEIF 종류 == 발동強制誘発
	CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効2",場所,"無効")
ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52356,10)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲EX덱 = 1
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"全場全体",場所,"제외")
			FOR カウンタ,0,紙束最大値
				SIF GETVAR(@"%対面者%_묘지:カウンタ") == -1
					CONTINUE
				CALL CARD_DISPOSE(対面者,"묘지",カウンタ)
			NEXT
		ENDIF
	ENDIF
ENDIF

