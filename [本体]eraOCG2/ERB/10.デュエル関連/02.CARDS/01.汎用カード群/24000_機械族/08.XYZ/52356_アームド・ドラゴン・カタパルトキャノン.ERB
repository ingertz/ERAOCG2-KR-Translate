@CARDNAME_52356,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 암드 드래곤 캐터펄트 캐논
	CASE "略称"
		RESULTS = 암드D CC
	CASE "カテゴリ"
		RESULTS:0 = 암드 드래곤
	CASE "検索カテゴリ"
		RESULTS:0 = 하이퍼 드래곤 캐논
ENDSELECT

@CARD_52356(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 3500
	CASE "守備力"
		RETURN 3000
	CASE "특수불가"
		RETURN 1
	CASE "추가日"
		RETURN 251125
ENDSELECT

RETURN 0

@CARD_EXPLANATION_52356(종류)
