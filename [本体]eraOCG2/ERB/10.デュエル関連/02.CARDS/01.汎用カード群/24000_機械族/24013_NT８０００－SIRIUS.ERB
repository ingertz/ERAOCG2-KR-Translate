@CARDNAME_24013,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = NT８０００－SIRIUS
	CASE "略称"
		RESULTS = NT8000－SIRIUS
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_24013(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 기계족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 2300
	CASE "守備力"
		RETURN 2500
ENDSELECT
RETURN 0

@CARD_EXPLANATION_24013(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(0, 지속효과)
PRINTL ①：자신 필드에 Ｌモンスターが存在する限り、このカードは戦闘では破壊されない。
CALL CARD_ABLE(2, 발동誘発, 효과後誘発)
PRINTL ②：Ｌモンスターの효과が발동した時、またはＬモンスターの효과が발동した場合、
PRINTL 자신及び상대フィールドの表側표시カードを１枚ずつ대상として발동できる。
PRINTL そのカード２枚を破壊する。
CALL CARD_ABLE(3, 손패→묘지, 덱→묘지)
PRINTL ③：このカードがフィールド以外から묘지へ送られた場合、자신 필드에 어둠속성Ｌモンスターが存在していれば발동できる。
PRINTL このカードを특수소환する。この효과で특수소환したこのカードは、フィールドから離れた場合に제외される。


@CARDCAN_24013(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트, 종류, ゾーン, 場所, 24013)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = 링크
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == 발동誘発 || 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트, 24013)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	
	IF 종류 == 발동誘発
		CALL FULLRESET
		효과条件종류 = 링크
		CALL CARD_CHECK_START_DATA(듀얼리스트, 2)
		SIF RESULT != 1
			RETURN 0
	ELSEIF 종류 == 효과後誘発
		CALL FULLRESET
		효과条件종류 = 링크
		CALL CARD_CHECK_FIN_DATA(듀얼리스트, "효과발동", 2)
		SIF RESULT != 1
			RETURN 0
	ENDIF
	
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件표시 = 表側표시
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == 손패→묘지 || 종류 == 덱→묘지
	SIF 발동済_3(듀얼리스트, 24013)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트, 24013, "묘지")
	SIF RESULT == 1
		RETURN 0
	
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件속성 = 어둠속성
	효과条件종류 = 링크
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ENDIF

@CARDEFFECT_24013(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트, "自身", 場所, "戦耐")
ELSEIF 종류 == 발동誘発 || 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 24013, 2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과条件표시 = 表側표시
		효과条件行先플래그 = 破壊行き
		CALL CARD_ADD_GY_ADV(듀얼리스트, ゾーン, 場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과範囲상대마함 = 1
			효과条件표시 = 表側표시
			CALL CARD_REMOVAL_ADV(듀얼리스트, "単体除去", 場所, "묘지")
		ENDIF
	ENDIF
ELSEIF 종류 == 손패→묘지 || 종류 == 덱→묘지
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 24013, 3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = NT８０００－SIRIUS
		효과추가종류 = 効追除処
		CALL CARD_SP_SUMMON_ADV(듀얼리스트, ゾーン, 場所)
	ENDIF
ENDIF


