@CARDNAME_29078,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 시계신 라피온
	CASE "略称"
		RESULTS = 시계신 라피온
	CASE "カテゴリ"
		RESULTS:0 = 시계신
ENDSELECT


@CARD_29078(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	CASE "추가日"
		RETURN 250630
ENDSELECT
RETURN 0

@CARD_EXPLANATION_29078(종류)
#DIM DYNAMIC 종류

CALLFORM CARD_ABLE(0,효과소환)
PRINTL ①：자신 필드에 몬스터가 존재하지 않는 경우, 이 카드는 릴리스 없이 소환할 수 있다.
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：이 카드는 전투/효과로 파괴되지 않으며, 이 카드의 전투로 발생하는 자신이 받는 전투 데미지는 0이 된다.
CALLFORM CARD_ABLE(0,バトル終了時)
PRINTL ③：이 카드가 전투를 실행한 배틀 페이즈 종료 시에 발동할 수 있다. 상대 필드의 앞면 표시 몬스터 1장을 선택하고, 그 공격력만큼의 데미지를 상대에게 준다.
PRINTL ④：자신 스탠바이 페이즈에 발동한다. 이 카드를 주인의 덱의 맨 아래로 되돌린다.
CALLFORM CARD_ABLE(0,ターン開始時強制)
PRINTL ④: 자신의 스탠바이 페이즈에 발동한다. 이 카드를 소유자의 덱의 가장 아래로 되돌린다.


@CARDCAN_29078(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 選択カード名前
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,29078)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과소환
	CALL FULLRESET
	효과範囲필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン開始時強制
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
효과条件名前 = 무한광 아인 소프 오르
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == バトル終了時
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_T1汎数:場所") == 0
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 10
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_29078(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 효과소환
	RETURN 1
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"破耐")
ELSEIF 종류 == 攻撃時強制誘発
	CALL SET_PLAYER_INFO(듀얼리스트,"ダメージ無効",1)
	CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"T1汎数",1)
ELSEIF 종류 == ターン開始時強制
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,덱行き)
ELSEIF 종류 == バトル終了時
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 10
	CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
	選択カード_ID = RESULT:99
	TRYCALLFORM CARD_{選択カード_ID}("攻撃力")
	カウンタ = RESULT
	CALL LIFE_CHANGE(듀얼리스트,"減少","효과",カウンタ,1)
ENDIF

