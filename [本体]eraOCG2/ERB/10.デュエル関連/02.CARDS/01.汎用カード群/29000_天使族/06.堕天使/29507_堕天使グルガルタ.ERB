@CARDNAME_29507,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 타락천사 굴갈타
	CASE "略称"
		RESULTS = 굴갈타
	CASE "カテゴリ"
		RESULTS:0 = 타락천사
ENDSELECT


@CARD_29507(参照先)
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 2400
	CASE "守備力"
		RETURN 800
	CASE "生成カード"
		RETURN 129507
	CASE "특수制限"
		RETURN 1
	CASE "추가日"
		RETURN 251025
ENDSELECT

RETURN 0

@CARD_EXPLANATION_29507(종류)
#DIM DYNAMIC 종류

PRINTL 자신은 "타락천사 굴갈타"를 １턴에 １번밖에 특수 소환할 수 없으며、
PRINTL 그 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(0,소환時,특수소환時)
PRINTL ①：이 카드가 특수 소환된 경우에 발동할 수 있다。
PRINTL 자신 필드에 "타락천사 토큰" ２장을 특수 소환한다。
PRINTL 이 효과의 발동 후、턴 종료시까지 자신은 천사족 몬스터밖에 특수 소환할 수 없다。
CALLFORM CARD_ABLE(2,필드→묘지 ,손패→묘지 ,덱→묘지 ,破壊→묘지 ,戦闘→묘지,X素材時효과)
PRINTL ②：이 카드가 묘지로 보내진 경우에 발동할 수 있다。
PRINTL 덱에서 "타락천사 굴갈타" 이외의 "타락천사" 카드 또는 "금지된" 속공 마법 카드 １장을 패에 넣는다。


@CARDCAN_29507(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,29507)
SIF RESULT == 1
	RETURN 0

IF 종류 == 특수소환時
	SIF モンスター数(듀얼리스트) >= 4
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,129507,"")
	SIF RESULT == 1
		RETURN 0
	RETURN 1

ELSEIF GROUPMATCH(종류,필드→묘지,손패→묘지 ,덱→묘지 ,破壊→묘지 ,戦闘→묘지,X素材時효과)
	SIF 발동済_2(듀얼리스트,29507)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ:0 = 타락천사
	효과条件カテゴリ:1 = 금지된
	효과条件固名前 = 타락천사 굴갈타
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_29507(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

IF 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,29507)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_GENERATE(듀얼리스트,129507)
		CALL CARD_GENERATE(듀얼리스트,129507)
		SS소환可能종족 = 천사족
		CALL CARD_SS_RESTRICTION(듀얼리스트)
	ENDIF

ELSEIF GROUPMATCH(종류,필드→묘지,손패→묘지 ,덱→묘지 ,破壊→묘지 ,戦闘→묘지,X素材時효과)
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,29507,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ:0 = 타락천사
		효과条件カテゴリ:1 = 금지된
		효과条件固名前 = 타락천사 굴갈타
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF

