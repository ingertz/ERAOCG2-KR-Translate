@CARDNAME_1672,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 단풍나무 아가씨
	CASE "略称"
		RESULTS = 단풍나무 아가씨
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_1672(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 2100
	CASE "守備力"
		RETURN 2600
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251222
ENDSELECT

RETURN 0

@CARD_EXPLANATION_1672(종류)
#DIM DYNAMIC 종류

PRINTL 튜너＋튜너以外のモンスター１体以上
PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,EX소환時,특수소환時)
PRINTL ①：このカードが특수소환に成功した場合、속성を１つ宣言して발동できる。
PRINTL このカードは以下の효과を得る。
PRINTL ●フィールドの全ての表側표시モンスターは宣言した속성になる。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：상대のフィールドのモンスター１体を대상として발동できる。
PRINTL 상대はそのモンスター以外の自身のフィールドのカード１枚を묘지へ送る。


@CARDSUMMON_1672(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要レベル数 = 7

;1体目の条件
IF EX参照 == 0 || EX参照 == 1
	素材条件튜너 = 1
ELSEIF EX参照 >= 10
	素材条件튜너 = -1
ENDIF

IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,1672) 
	RETURN RESULT
ENDIF

@CARDCAN_1672(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,1672)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,1672)
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_汎数:場所") < 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트,1672)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件除去種 = 選択
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_1672(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 설정속성
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1672,1)
	IF RESULT == 0
		IF 듀얼리스트 == "자신"
			PRINTL 효과를 선택해주세요
			PRINT [01] - 빛속성　
			PRINT [02] - 어둠속성　
			PRINTL [03] - 땅속성
			PRINT [04] - 물속성　　　
			PRINT [05] - 화염속성　　　
			PRINTL [06] - 바람속성
			PRINTL [07] - 신속성　　　
			BINPUT
		ELSE
			RESULT = RAND:7 + 1
		ENDIF
		IF RESULT == 1
			RESULTS =（빛）
		ELSEIF RESULT == 2
			RESULTS =（어둠）
		ELSEIF RESULT == 3
			RESULTS =（땅）
		ELSEIF RESULT == 4
			RESULTS =（물）
		ELSEIF RESULT == 5
			RESULTS =（화염）
		ELSEIF RESULT == 6
			RESULTS =（바람）
		ELSEIF RESULT == 7
			RESULTS =（신）
		ENDIF
		PRINTFORML %RESULTS% 속성이 선택되었습니다。
		CALL SET_FIELD_INFO(듀얼리스트,"마함",場所,"汎数",RESULT)
	ENDIF

ELSEIF 종류 == 지속효과
	설정속성 = GETVAR(@"%듀얼리스트%_魔_汎数:場所")
	CALL FULLRESET
	CALL STATCHANGE_OTHER(듀얼리스트,"필드",場所,"属",설정속성)
	CALL FULLRESET
	CALL STATCHANGE_OTHER(듀얼리스트,"상대필드",場所,"属",설정속성)

ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1672,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"選択")
		IF RESULT == 1
			選択カード = RESULT:1

			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲마함 = 1
			효과条件他所 = 1
			CALL CARD_ADD_GY_ADV(対面者,"필드",選択カード)
		ENDIF
	ENDIF
ENDIF
