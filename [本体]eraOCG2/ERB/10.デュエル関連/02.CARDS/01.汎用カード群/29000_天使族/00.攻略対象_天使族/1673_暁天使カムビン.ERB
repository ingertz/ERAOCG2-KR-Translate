@CARDNAME_1673,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 새벽천사 캄빈
	CASE "略称"
		RESULTS = 새벽천사 캄빈
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_1673(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"	
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 500
	CASE "守備力"
		RETURN 1800
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251005
ENDSELECT

RETURN 0

@CARD_EXPLANATION_1673(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)

PRINTL ①：자신 필드의 몬스터가、존재하지 않는 경우 또는 천사족 몬스터만인 경우에 발동할 수 있다。
PRINTL 이 카드를 패에서 특수 소환한다。

CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：이 카드를 포함한 자신 필드의 천사족 몬스터를 임의의 수 만큼 릴리스하고 발동할 수 있다.
PRINTL （이 효과를 발동한 턴、자신은 천사족 몬스터밖에 특수 소환할 수 없다）。
PRINTL 릴리스한 몬스터의 레벨의 합계와 같은 레벨을 가진 천사족 몬스터 １장을 덱에서 특수 소환한다。

@CARDCAN_1673(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 合計レベル
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,1673)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,1673)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,1673,"손패")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	CALLFORM 효과条件종족_ADV(천사족, "以外")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 0
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트,1673)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0

	CALL FULLRESET
	CALLFORM 효과条件종족_ADV(천사족,"以外")
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"SS이력")
	SIF RESULT != 0
		RETURN 0

	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종족 = 천사족
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	合計レベル = RESULT:2

	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종족 = 천사족
	효과条件소환可 = 2
	CALL 효과条件レベル_ADV(合計レベル,"以下")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_1673(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 合計レベル

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1673,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1673,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件종족 = 천사족
		효과条件複数 = 任意の数
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			合計レベル = RESULT:200 + 1
		ELSE
			合計レベル = 1
		ENDIF

		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종족 = 천사족
		CALL 효과条件レベル_ADV(合計レベル,"以下")
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF

