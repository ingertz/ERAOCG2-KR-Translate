@CARDNAME_1060,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 가디언 에아토스
	CASE "略称"
		RESULTS = 에아토스
	CASE "カテゴリ"
		RESULTS:0 = 가디언
ENDSELECT


@CARD_1060(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 牝性
	CASE "生成カード"
		RESULT:1 = 601060
		RETURN 101060
ENDSELECT
RETURN 0

@CARD_EXPLANATION_1060(종류)
#DIM DYNAMIC 종류

CALL CARD_ABLE(0,손패起動)
PRINTL ①: 자신의 묘지에 몬스터가 존재하지 않을 경우에 발동할 수 있다.
PRINTL 이 카드를 패에서 특수 소환한다.
CALL CARD_ABLE(0,필드起動)
PRINTL ②: 자신 필드의 장착 마법 카드 1장을 묘지로 보내고,
PRINTL 상대 묘지의 몬스터를 3체까지 대상으로 하여 발동할 수 있다.
PRINTL 그 몬스터를 제외한다.
PRINTL 이 카드의 공격력은 턴 종료시까지, 이 효과로 제외한 몬스터의 수× 500 상승한다.
CALL CARD_ABLE(0,戦破壊→묘지)
PRINTL ③：장착 카드를 장착하고 있는 이 카드가 상대에 의해 필드를 벗어난 경우에 발동할 수 있다。
PRINTL 덱 밖에서 "가디언 데스사이스"１장을 특수 소환한다。
PRINTL 그 후、덱 밖에서 "사신의 큰 낫－데스사이스" １장을 패에 생성하고、그 몬스터에게 장착한다。


@CARDSUMMON_AA_1060


@CARDCAN_1060(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,1060)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	CALL CARD_SS_CHECK(듀얼리스트,1060,"손패")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 0
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0

	CALL FULLRESET
	효과範囲마함 = 1
	효과条件종류 = 装備마법
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	CALL FULLRESET
	효과範囲상대묘지 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 戦破壊→묘지
	SIF ゾーン != "필드"
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,101060,"",1)
	SIF RESULT == 1
		RETURN 0
	SIF 処理中_듀얼리스트 != 対面者 && 묘지送り종류 != "戦闘破壊"
		RETURN 0
	CALL FULLRESET
	CALL CARD_EQUIP_CHECK(듀얼리스트,場所,ゾーン)
	SIF RESULT == 0
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_1060(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1060)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트, "손패", 場所)
	ENDIF

ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1060)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종류 = 装備마법
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"마함",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件종류 = モン全般
			효과条件複数 = 97
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"상대묘지",ゾーン,場所)
			攻撃力修正 = RESULT:2 * 500
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"一攻",攻撃力修正)
		ENDIF
	ENDIF

ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1060)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_GENERATE(듀얼리스트,101060)
		CALL CARD_GENERATE_HAND(듀얼리스트,601060)

		CALL FULLRESET
		효과条件名前 = 사신의 큰 낫－데스사이스
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"손패",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件名前 = 가디언 데스사이스
			효과条件표시 = 表側표시
			CALLFORM CARD_EQUIP_ADV(듀얼리스트,選択カード,"손패")
		ENDIF
	ENDIF
ENDIF

;──────────────────────────────────────────────────────

