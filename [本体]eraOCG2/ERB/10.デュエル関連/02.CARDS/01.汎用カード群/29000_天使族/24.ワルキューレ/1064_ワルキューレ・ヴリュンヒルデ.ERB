@CARDNAME_1064,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 왈큐레 브륜힐데
	CASE "略称"
		RESULTS = 브륜힐데
	CASE "カテゴリ"
		RESULTS:0 = 왈큐레
ENDSELECT


@CARD_1064(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 천사족 
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 1800
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251005
ENDSELECT

RETURN 0

@CARD_EXPLANATION_1064(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ③의 효과는 1턴에 1번만 사용할 수 있다.
CALLFORM CARD_ABLE(0,지속효과,攻守変動)
PRINTL ①: 이 카드의 공격력은, 상대 필드의 몬스터 수×500 올린다.
PRINTL ②: 이 카드는 마법 내성을 갖는다.
CALLFORM CARD_ABLE(3,발동誘発)
PRINTL ③: 상대가 카드의 효과를 발동한 경우、이 카드의 수비력을 １０００ 내리고 발동할 수 있다。
PRINTL 이 턴 자신 필드의 "왈큐레" 몬스터는 전투 / 효과로는 파괴되지 않는다。
PRINTL 추가로、상대 필드에 특수 소환된 몬스터가 존재하는 경우、그 １장을 골라、
PRINTL 그 몬스터 １장을 제외할 수 있다。



@CARDCAN_1064(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,1064)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과 || 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_表:場所") == 3
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_1(듀얼리스트,1064)
		RETURN 0
    SIF GETVAR(@"%듀얼리스트%_MZ_守:場所") < 1000
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_1064(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"魔耐")
ELSEIF 종류 == 攻守変動
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	攻撃力修正 = RESULT * 500
	CALL STATCHANGE_BASIC(듀얼리스트,"自身",場所,攻撃力修正)
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1064,3)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"永守",-1000)
		CALL FULLRESET
	    효과条件カテゴリ = 왈큐레
	    CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"戦耐",1)

		CALL FULLRESET
	    효과条件カテゴリ = 왈큐레
	    CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"破耐",1)

		CALL FULLRESET

		CALL FULLRESET
	    효과範囲상대필드 = 1
		효과条件召種 = 召種全특수
		효과条件任意 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"제외")
	ENDIF
ENDIF

