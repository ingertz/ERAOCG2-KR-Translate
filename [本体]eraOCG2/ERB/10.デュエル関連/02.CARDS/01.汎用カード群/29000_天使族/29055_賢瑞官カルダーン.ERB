@CARDNAME_29055,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 현서관 카르단
	CASE "略称"
		RESULTS = 카르단
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_29055(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성

	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1400
	CASE "守備力"
		RETURN 1000
ENDSELECT
RETURN 0

@CARD_EXPLANATION_29055(종류)
#DIM DYNAMIC 종류

CALL CARD_ABLE(0, 소환時)
PRINTL ①：이 카드가 소환되었을 때에 발동할 수 있다。
PRINTL 자신의 패 / 묘지에서 지속 함정 카드 １장을 자신 필드에 세트한다。이 효과로 세트한 카드는 세트한 턴에도 발동할 수 있다。
CALL CARD_ABLE(0, 필드→묘지, 손패→묘지, 덱→묘지, 破壊→묘지, 戦闘→묘지)
PRINTL ②：이 카드가 묘지로 보내진 경우에 발동할 수 있다。
PRINTL 이 턴、자신 필드의 앞면 표시인 함정 카드는 상대의 효과로는 파괴되지 않는다。
PRINTL 다음 스탠바이 페이즈부터 그 턴 종료시까지、자신 필드의 앞면 표시인 함정 카드는 상대의 효과로는 파괴되지 않는다。


@CARDCAN_29055(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트, 종류, ゾーン, 場所, 29055)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時
	SIF 마함数(듀얼리스트) == 5
		RETURN 0
	
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲묘지 = 1
	효과条件종류 = 지속함정
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	RETURN 1
ELSEIF 종류 == 短紋章起動
	RETURN 1
ELSEIF 종류 == ターン開始時予約
	RETURN 1
ENDIF

@CARDEFFECT_29055(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

IF 종류 == 소환時
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 29055, 1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲묘지 = 1
		효과条件종류 = 지속함정
		CALL CARD_SET_ADV(듀얼리스트, ゾーン, 場所, "使化裏側표시")
	ENDIF
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 29055, 2)
	IF RESULT == 0
		CALL CARD_RESERV(듀얼리스트, 29055, 短紋章予約)
		CALL CARD_RESERV(듀얼리스트, 29055, スタン予約)
	ENDIF
ELSEIF 종류 == 短紋章起動
	CALL FULLRESET
	효과条件종류 = 함정全般
	효과条件표시 = 表側표시
	CALL STATCHANGE_EFFECT(듀얼리스트, "필드", 場所, "破耐")
	CALL STATCHANGE_EFFECT(듀얼리스트, "마함", 場所, "破耐")
ELSEIF 종류 == ターン開始時予約
	CALL CARD_RESERV(듀얼리스트, 29055, 短紋章予約)
ENDIF


