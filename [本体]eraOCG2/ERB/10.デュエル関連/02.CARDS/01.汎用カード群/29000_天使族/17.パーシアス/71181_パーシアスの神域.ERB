@CARDNAME_71181,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 파샤스의 신역
	CASE "略称"
		RESULTS = 파샤스의 신역
	CASE "カテゴリ"
		RESULTS:0 = 천공의 성역
		RESULTS:1 = 파샤스
ENDSELECT


@CARD_71181(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN フィールド
	CASE "レア度"
		RETURN SPR
	CASE "추가日"
		RETURN 250915
ENDSELECT

RETURN 0

@CARD_EXPLANATION_71181(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：자신 필드는 "천공의 성역"이 된다。
PRINTL ②：자신 필드의 천사족 몬스터의 공격력 / 수비력은 ３００ 오른다、
PRINTL 악마족 몬스터의 공격력 / 수비력은 ３００내리고 효과가 무효화된다。	
PRINTL 상대 필드에 필드명칭이 존재하지 않는 경우、이 효과는 상대 필드에도 적용된다。
CALLFORM CARD_ABLE(3,ターン終了時)
PRINTL ③：자신 / 상대 엔드 페이즈시에 발동할 수 있다。
PRINTL 자신의 묘지 / 제외 상태인 천사족 몬스터 １장 또는 일반 함정 카드 １장을 골라 자신의 덱 가장 위에 놓는다。

;「천공의 성역」として扱う마법カード。フィールド名を설정する処理を扱う都合上、지속마법からフィールド마법に변경。
;카드의 효과処理ではフィールド名やカテゴリ・종류を参照するため、마함や묘지でのカード名の名称변경までは行わない。

;파샤스カードはフィールドに천공의 성역を要求する효과발동条件が多いので、展開ルートで貼ればより盤石な盤面になる。
;元々のカード同様、初動となる효과は持たないが、【エンジェル・パーミッション】としてはより扱いやすいリソース回収효과に변경している。
;セット状態の마함を保護する효과をオミットした대신에 、악마족専用スキドレという強烈なメタ효과を추가。덱の相性関係をより鮮明にする狙い。
;昔ながらのフィールド마법の趣を出すため、強化・弱体효과はどちらも両プレイヤーに효과が及ぶ。자신의 악마족モンスターも弱体化する点は注意。
;상대 필드에 효과を及ぼす部分を、상대 필드에 フィールド마법による名称が存在しない場合という条件に설정。
;もともと【ラビュリンス】を意識した악마족メタだったが、상대側も「白銀の迷宮城」を貼ることで「천공의 성역」の影響を押し返せるような処理に。


@CARDCAN_71181(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 条件달성カード名,10
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,71181)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン終了時
	SIF 발동済_3(듀얼리스트,71181)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件종류 = モン全般
	효과条件종족 = 천사족
	효과条件スーパー종류 = 通常함정
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻守変動 || 종류 == 지속효과 || 종류 == 常在無効
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_71181(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 選択カード名前
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 条件달성カード名,10
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 条件달성数 = 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71181)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF
ELSEIF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71181,3)
	IF RESULT == 0
		;묘지 / 제외の천사족モンスター１体または通常함정１장을 덱トップに置く。
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲제외 = 1
		효과条件종족 = 천사족
		효과条件종류:0 = 효과モン
		효과条件종류:1 = 通常モン
		효과条件スーパー종류 = 通常함정
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 9999
			CALL CARD_SELECT(듀얼리스트,RESULT)
			CALL CARD_ADD_DECK_SPC(대상者（CS）,参照先（CS）,選択カード（CS）)
		ENDIF
	ENDIF
ELSEIF 종류 == 攻守変動
	CALL FULLRESET
	효과条件종족 = 천사족
	CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,300,300)
	CALL FULLRESET
	효과条件종족 = 악마족
	CALL STATCHANGE_BASIC(듀얼리스트,"상대필드",場所,-300,-300)
	IF GETVARS(@"%対面者%_フィールド名") == ""
		CALL FULLRESET
		효과条件종족 = 천사족
		CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,300,300)
		CALL FULLRESET
		효과条件종족 = 악마족
		CALL STATCHANGE_BASIC(듀얼리스트,"상대필드",場所,-300,-300)
	ENDIF
ELSEIF 종류 == 常在無効
	CALL FULLRESET
	효과条件종족 = 악마족
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"無効")
	IF GETVARS(@"%対面者%_フィールド名") == ""
		CALL FULLRESET
		효과条件종족 = 악마족
		CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"無効")
	ENDIF
ELSEIF 종류 == 지속효과
	CALL SET_FIELD_MAGIC_INFO(듀얼리스트, "천공의 성역")
ENDIF

