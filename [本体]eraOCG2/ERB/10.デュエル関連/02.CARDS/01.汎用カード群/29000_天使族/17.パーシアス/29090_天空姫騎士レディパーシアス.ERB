@CARDNAME_29090,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 천공공주기사 레이디 파샤스
	CASE "略称"
		RESULTS = 레이디 파샤스
	CASE "カテゴリ"
		RESULTS:0 = 파샤스
		RESULTS:1 = 게임 오리지널
ENDSELECT


@CARD_29090(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 2300
	CASE "守備力"
		RETURN 1800
	CASE "성별"
		RETURN 牝性
	CASE "レア度"
		RETURN SPR
	CASE "連動ID"
		RETURN 1301
	CASE "추가日"
		RETURN 250915
ENDSELECT
RETURN 0

@CARD_EXPLANATION_29090(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時,특수소환時,효과後誘発)
PRINTL ①：이 카드가 소환 / 특수 소환된 경우、또는 자신 필드가 "천공의 성역"인 상태에서
PRINTL 자신이 일반 함정 카드의 효과를 발동했을 경우에 발동할 수 있다。자신의 패 / 묘지에서 천사족 / 빛속성 몬스터 １체를 특수 소환한다。
PRINTL 이 효과의 발동 후, 턴 종료 시까지 자신은 EX덱에서 천사족 몬스터밖에 특수 소환할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：이 카드가 몬스터 존에 존재하는 한, 상대는 레벨４ 이하의 천사족 / 빛속성 몬스터를 공격 대상으로 선택할 수 없으며、
PRINTL 자신 필드의 천사족 / 빛속성 몬스터는 관통 능력을 얻는다。
CALLFORM CARD_ABLE(3,필드起動)
PRINTL ③：자신의 패의  일반 함정 카드 １장을 상대에게 보여주거나, 자신의 손패를 １장 버리고 발동할 수 있다。
PRINTL 덱에서 "천공의 성역" 필드 마법 카드 １장 또는 "천공공주기사 레이디 파샤스" 이외의 "파샤스" 카드 １장을 손패에 넣는다。

;【파샤스】の中心になる「파샤스」몬스터는、元々のOCGには천공기사 파샤스、天空勇士ネオ파샤스、天空聖騎士アーク파샤스、
;神聖騎士파샤스、天空神騎士ロード파샤스などが存在するが、正攻法で作ろうとすると前述の複数枚のモンスター間の強さを調整するのも大変だし、
;そもそも野郎（？）の天使が活躍するテーマを作るのもeraOCG2的にどうかなーと思っていたところ、そういえば勇気の天使ヴィクトリカは
;メチャクチャ可愛いけど덱に入れて活躍させる機会が今のところないんだよなーという考えと合流して、現代파샤스の暫定エースとしてジョグレス進化。
;最上級モンスターや高レベルの싱크로体、링크３などのエースモンスターポジションを作る余白が残っているが、強さ的には当分不要に思う。
;윤회의 파샤스という究極のリクルート효과持ち카드가 テーマにはあるので、環境が進んだら「神聖姫騎士マジェスティック파샤스」とか作ろう。

;性能のベースは天空勇士ネオ파샤스で、「파샤스」モンスターに多い貫通효과를 付与して戦闘ダメージを与えやすくするのが第一の효과。
;従来は戦闘ダメージを与えた場合の발동が多かったアド稼ぎ효과の발동条件を見直して、先攻１ターン目の展開にも使えるように調整。
;出たとき효과や효과後誘発で패 / 묘지의 몬스터를 특수소환できる효과もあるので、필드に出すことでアド稼ぎしつつ攻め手を増やせるのが強み。
;これに自己SS효과や耐性があったり、無効妨害を自前で備えてたら現代でも立派なエースモンスターになるのだけど、メイン덱の上級モンスターならこのぐらい。
;윤활役とエースの中間点ぐらいで、よく言えば扱いやすいが、悪く言えば初動にならないメイン덱の上級몬스터와 いう難点を抱えてて突き抜けた強みに欠ける。

;레벨４ 이하의 天使を攻撃대상にできなくする지속효과가 個人的な素敵おしゃれポイント。か弱い天使を"守護る"側の存在になれたというイメージでついている。
;まあ見た目はちょっと武装してるだけの変化で、眩しい脇を見せつける貧乳ロリっ娘のままなんですけどね。「そのままのヴィクトリカちゃんが良い」だろ？　ゴン。


@CARDSUMMON_AA_29090


@CARDCAN_29090(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,29090)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,29090)
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲묘지 = 1
	효과条件종류 = モン全般
	효과条件종족 = 천사족
	효과条件속성 = 빛속성
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF 발동済_1(듀얼리스트,29090)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVARS(@"%듀얼리스트%_フィールド名") != "천공의 성역"
		RETURN 0
	CALL FULLRESET
	효과条件종류 = 通常함정
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"효과발동")
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲묘지 = 1
	효과条件종류 = モン全般
	효과条件종족 = 천사족
	효과条件속성 = 빛속성
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 발동済_3(듀얼리스트,29090)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 파샤스
	효과条件固名前 = 천공공주기사 레이디 파샤스
	효과条件スーパー종류 = フィールド
	효과条件スーパーカテゴリ = 천공의 성역
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_29090(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択結果
#DIM DYNAMIC 成功판정 = 0


IF 종류 == 소환時 || 종류 == 특수소환時 || 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,29090,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲묘지 = 1
		효과条件종류 = モン全般
		효과条件종족 = 천사족
		효과条件속성 = 빛속성
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		
		;EX덱縛り（천사족縛り）
		CALL FULLRESET
		EX소환可能종족 = 천사족
		CALL CARD_EX_RESTRICTION(듀얼리스트)
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,29090,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件종류 = 通常함정
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			;패의 通常함정 카드를 見せるかの処理（CPUは条件を満たしたら必ず見せる）
			IF 듀얼리스트 == "상대"
				選択結果 = はい
			ELSE
				PRINTL 패의 일반 함정 카드 １장을 상대에게 보여주겠습니까？
				CALL YN_CHOICE(듀얼리스트)
				選択結果 = RESULT
			ENDIF
		ELSE
			選択結果 = いいえ
		ENDIF
		
		IF 選択結果 == はい
			;카드를 見せる処理（ヴァンキッシュソウル의 효과를 参考）
			CALL FULLRESET
			효과条件종류 = 通常함정
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"손패",ゾーン,場所)
			IF 選択カード != 9999
				成功판정 = 1
			ELSE
				;処理失敗した時に패를 １장 捨てる処理に合流するようなIF분기の構成にする（妙な親切心）
				選択結果 = いいえ
			ENDIF
		ENDIF
		
		IF 選択結果 == いいえ
			;패를 １장 捨てる処理
			CALL FULLRESET
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
			IF RESULT == 1
				成功판정 = 1
			ELSE
				成功판정 = 0
			ENDIF
		ENDIF
		
		;上の분기処理で通常함정を見せるか손패捨てが出来ていれば成功판정の変数が「1」の状態になり、後続処理を行う。
		IF 成功판정 == 1
			;덱에서 카드를 サーチする。
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 파샤스
			효과条件固名前 = 천공공주기사 레이디 파샤스
			효과条件スーパー종류 = フィールド
			효과条件スーパーカテゴリ = 천공의 성역
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	
	;貫通付与
	CALL FULLRESET
	효과条件종류 = モン全般
	효과条件종족 = 천사족
	효과条件속성 = 빛속성
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"貫通",3)
	
	;戦闘回避付与
	CALL FULLRESET
	효과条件종류 = モン全般
	효과条件종족 = 천사족
	효과条件속성 = 빛속성
	CALLFORM 효과条件レベル_ADV(4, "以下")
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"攻避",3)

ENDIF
