@CARDNAME_91163,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 티타노사이더
	CASE "略称"
		RESULTS = 티타노사이더
	CASE "カテゴリ"
		RESULTS:0 = 천공의 성역
		;RESULTS:1 = 파샤스
ENDSELECT


@CARD_91163(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "連動ID"
		RETURN 1631
	;アポロウーサ（ID:1631）と連動
	CASE "추가日"
		RETURN 250915
ENDSELECT

RETURN 0

@CARD_EXPLANATION_91163(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 １턴에 １번、어느쪽인가 １개밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動,마함起動,フリー誘発)
PRINTL ①：상대 필드의 융합 / Ｓ / Ｘ / Ｌ몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL （자신 필드가 "천공의 성역"인 경우、이 효과에 대해서 상대는 카드의 효과를 발동할 수 없다。）
PRINTL 그 몬스터의 공격력을 ０으로 하고、그 효과를 무효로 한다。
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：이 카드가 묘지에 존재하는 상태로、상대가 ＥＸ덱에서 몬스터를 특수 소환한 경우에 발동할 수 있다。
PRINTL 자신 묘지의 "티타노사이더" １장을 자신 필드에 세트한다。

;【エンジェル・パーミッション】と直接的な関連性は薄いが、ちょうどいいパーミッション系의 효과를 持つ通常함정カードで、
;かつアポロウーサが천사족モンスターであるという相性もあったので、「티타노사이더」に白날개の矢を立てる。
;カテゴリでサーチもできるようにして、천공의 성역の系統なら採用も検討できるぐらいの性能になった・・・かもしれない。
;효과는 ほぼそのままで若干スレイに寄せた使用感に。聖域があるとチェーン불가になり、발동を無効にしたりフリチェで逃げられない。
;②の묘지효과는 「묘지へ送られたターン～」の概念が煩雑なので、「갤럭시・サイクロン」に倣っていずれかターン１で簡略化。
;想定される상대의 動きを考えると②がターンを跨ぐのは遅いのだが、とはいえよくある再利用可能だが使用後제외される制約で각각 ターン１だと、
;「迷い風」のほぼ下位互換ぐらいのカードになって、元々の카드가 「迷い風」と差別化できてた部分が消えてしまうので、苦肉の策でこの性能に。
;パーミッション想定であれば、再利用可能でアドを稼げる대신에 動きが遅い、という효과調整のほうがテーマギミックとの一貫性があるだろう。


@CARDCAN_91163(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 효과先
#DIM DYNAMIC 대상カード_ID
#DIM DYNAMIC 대상カード_종류
#DIM DYNAMIC 추가条件플래그 = 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,91163)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,91163)
		RETURN 0
	SIF 발동済_2(듀얼리스트,91163)
		RETURN 0
	;손패발동条件を満たしているかチェック（ＰゾーンにＳアリアドネーが居るかチェック）　RESULT == 1で판정
	;除去種無効でチェックしたら、카드가 無効状態かどうかを판정できる気がするので試験的に１行추가。
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件名前 = 천공 사랑천사 아리아드네
	효과条件除去種 = 無効
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		추가条件플래그 |= 1
	
	IF ゾーン != "마함"
		SIF ゾーン != "손패" || 추가条件플래그 != 1
			RETURN 0
	ELSE
		CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
			RETURN 0
	ENDIF
	
	;상대 필드에 攻撃力1以上のEX몬스터가 存在する必要がある。
	;효과無効が出来なくても대상にできるようなので、除去種 = 無効の条件は記述しない。(公式Q&Aに明記あって助かる)
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件종류 = EXモン全般
	효과条件以攻撃力 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
	
ELSEIF 종류 == 효과後誘発
	SIF 발동済_1(듀얼리스트,91163)
		RETURN 0
	SIF 발동済_2(듀얼리스트,91163)
		RETURN 0
	SIF ゾーン != "묘지"
		RETURN 0
	;상대가 ＥＸ덱에서 특수 소환된 경우에 발동可能。
	CALL FULLRESET
	효과条件종류 = 효과全般
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"EX특수소환",1)
	SIF RESULT != 1
		RETURN 0
	
	;最終소환先を確認して、ＥＸモンスターであることも確認。
	효과先 = FINAL_SUMMON_TARGET(듀얼리스트,1)
	대상カード_ID = GETVAR(@"%対面者%_필드:효과先")
	TRYCALLFORM CARD_{대상カード_ID}("종류")
	대상カード_종류 = RESULT
	SIF 대상カード_종류 <= 3 && 대상カード_종류 >= 10
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == チェーン可否
	SIF !GROUPMATCH(チェーン可否종류, 손패起動, 마함起動, フリー誘発)
		RETURN 0
	SIF ゾーン == "묘지"
		RETURN 0
	SIF GETVARS(@"%듀얼리스트%_フィールド名") != "천공의 성역"
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_91163(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 효과先
#DIM DYNAMIC 설정レベル
#DIM DYNAMIC 대상カード_ID
#DIM DYNAMIC 대상カード_종류
#DIM DYNAMIC 選択結果

#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードB
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91163,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件종류 = EXモン全般
		효과条件以攻撃力 = 1
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 9999
			CALL CARD_SELECT(듀얼리스트,RESULT)
			CALL SET_FIELD_INFO(대상者（CS）,参照先（CS）,選択カード（CS）,"永攻",-999999)
			CALL SET_FIELD_INFO(대상者（CS）,参照先（CS）,選択カード（CS）,"無効",2,上書きモード)
		ENDIF
	ENDIF
ELSEIF 종류 == 효과後誘発
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91163,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 티타노사이더
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"裏側표시")
	ENDIF
ENDIF


