@CARDNAME_53523,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 장각의 카르노불스
	CASE "略称"
		RESULTS = 카르노불스
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_53523(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 비늘야수족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 2000
	CASE "守備力"
		RETURN 200
	CASE "튜너"
		RETURN 1
	CASE "성별"
		RETURN 無性
	CASE "추가日"
		RETURN 251026
	CASE "レア度"
		RETURN SPR
ENDSELECT

RETURN 0

@CARDSUMMON_53523(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件
CALL RESETCONDITION_MAT
必要レベル数 = 6
IF EX参照 == 0 || EX参照 == 1
	素材条件튜너 = 1
ELSEIF EX参照 >= 10
	素材条件튜너 = -1
ENDIF

IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,53523) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_53523(종류)
#DIM DYNAMIC 종류
PRINTL 튜너＋튜너 이외의 몬스터 １장 이상
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1,필드起動,フリー誘発)
PRINTL ①：자신 / 상대의 메인 페이즈 및 배틀 페이즈에 발동할 수 있다。
PRINTL 이 카드를 포함한 자신 필드의 몬스터를 소재로서 비늘야수족 Ｓ몬스터 １장을 Ｓ소환한다。
CALL CARD_ABLE(2,攻撃時誘発)
PRINTL ②：자신 또는 상대의 몬스터의 공격 선언시에 발동할 수 있다。
PRINTL 패에서 비늘야수족 몬스터 １장의 소환조건을 무시하고 특수 소환한다。
PRINTL 이 효과의 발동 후、턴 종료시까지 자신은 비늘야수족 몬스터밖에 특수 소환할 수 없다。


@CARDCAN_53523(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,53523)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,53523)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	IF メインフェイズ != 0
		SIF バトルフェイズ != 0
			RETURN 0
	ENDIF
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = 싱크로
	효과条件종족 = 비늘야수족
	強制素材場所 = 지정場所(場所,ゾーン)
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時誘発
	SIF 발동済_2(듀얼리스트,53523)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트,1) == 5
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件종족 = 비늘야수족
	효과条件소환可 = 1
	효과条件特不無視 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0	
	RETURN 1
ENDIF


@CARDEFFECT_53523(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

;PRINTFORMW 종류:{종류}

IF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,53523,1)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종류 = 싱크로
		효과条件종족 = 비늘야수족
		強制素材場所 = 지정場所(場所,ゾーン)
		효과条件소환可 = 2
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			TRYCALLFORM CARDSUMMON_{GETVAR(@"%듀얼리스트%_EX덱:{選択カード}")}(듀얼리스트,選択カード)
			CALL SYNSUMMON(듀얼리스트, 選択カード)
		ENDIF
	ENDIF
ELSEIF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,53523,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件종족 = 비늘야수족
		효과条件소환可 = 1
		효과条件特不無視 = 1
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			EX소환可能종족 = 비늘야수족
			CALL CARD_EX_RESTRICTION(듀얼리스트)	
		ENDIF
	ENDIF
ENDIF
