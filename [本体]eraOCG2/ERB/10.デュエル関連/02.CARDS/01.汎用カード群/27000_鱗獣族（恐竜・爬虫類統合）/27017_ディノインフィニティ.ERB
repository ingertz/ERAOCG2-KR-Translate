@CARDNAME_27017,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 디노 인피니티
	CASE "略称"
		RESULTS = 디노 Ⅰｎｆ
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_27017(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 비늘야수족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 1
	CASE "추가日"
		RETURN 251026
	CASE "レア度"
		RETURN SPR
ENDSELECT

RETURN 0

@CARD_EXPLANATION_27017(종류)
#DIM DYNAMIC 종류
CALL CARD_ABLE(1,지속효과)
PRINTL ①：이 카드의 원래 공격력은、제외되어있는 자신의 비늘야수족 몬스터의 수×１０００이 된다。

@CARDCAN_27017(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,27017)
SIF RESULT == 1
	RETURN 0
IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_27017(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 攻撃力強化値

;PRINTFORMW 종류:{종류}

IF 종류 == 지속효과
	CALL FULLRESET
	효과範囲제외 = 1
	효과条件종류 = モン全般
	효과条件종족 = 비늘야수족
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT >= 1
		攻撃力強化値 = RESULT * 1000
		CALL FULLRESET
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"永攻",攻撃力強化値,上書きモード)
	ENDIF
ENDIF
