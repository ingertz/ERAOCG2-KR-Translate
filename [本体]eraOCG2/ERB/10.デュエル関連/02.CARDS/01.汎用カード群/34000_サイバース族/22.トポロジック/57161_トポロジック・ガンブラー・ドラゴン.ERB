@CARDNAME_57161,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 토폴로직 검블러 드래곤
	CASE "略称"
		RESULTS = TpL 검블러
	CASE "カテゴリ"
		RESULTS:0 = 토폴로직
ENDSELECT


@CARD_57161(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 사이버스족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 3000
	CASE "守備力"
		RETURN 2500
	CASE "制限"
		RETURN 禁止
	CASE "추가日"
		RETURN 251028
ENDSELECT
RETURN 0


@CARDSUMMON_57161(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 4
素材条件종류 = 효과全般

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,57161) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_57161(종류)
#DIM DYNAMIC 종류

PRINTL 효과 몬스터 ２장 이상
PRINTL 이 카드명의 ①②의 효과는 １턴에 １번、어느쪽인가 １개밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,효과後誘発)
PRINTL ①：이 카드가 이미 몬스터 존에 존재하는 상태로、
PRINTL 자신 필드에 몬스터가 특수 소환된 경우、또는 상대 필드에 Ｌ몬스터가 특수 소환된 경우에 발동할 수 있다。
PRINTL 자신은 패를 임의의 수 만큼 무작위로 버린다（최대 ２장）。
PRINTL 그 후、버린 수 만큼 싱대는 패를 골라서 버린다。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：자신 필드에 Ｌ몬스터가 ５장 존재하는 경우에 발동할 수 있다。
PRINTL 상대는 패를 ２장까지 골라서 버린다。
PRINTL 이 효과로 상대의 패가 ０장이 된 경우、추가로 상대에게 ３０００데미지를 준다。


@CARDCAN_57161(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,57161)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과後誘発
	SIF 발동済_1(듀얼리스트,57161)
		RETURN 0
	SIF 발동済_2(듀얼리스트,57161)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0

	CALL FULLRESET
	효과範囲손패 = 1
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_最召場所") == 場所
		RETURN 0

	CALL FULLRESET
	효과条件종류 = 링크
	효과条件표시 = 表側표시
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환",1)
	IF RESULT != 1
		CALL FULLRESET
		CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환")
		SIF RESULT != 1
			RETURN 0
	ENDIF
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 발동済_1(듀얼리스트,57161)
		RETURN 0
	SIF 발동済_2(듀얼리스트,57161)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 손패数(対面者) == 0
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = 링크
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 5
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_57161(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択肢
#DIM DYNAMIC 효과횟수

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57161,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_RANDOM_HAND(듀얼리스트)
		選択カード = RESULT
		CALL CARD_DISPOSE(듀얼리스트,"손패",選択カード)
		효과횟수 ++

		IF 손패数(듀얼리스트) > 1 && 손패数(対面者) > 1
			IF 듀얼리스트 == "자신"
				PRINTL 추가로 패를 버리시겠습니까？
				CALL YN_CHOICE(듀얼리스트)
				選択肢 = RESULT
			ENDIF
		ELSE
			選択肢 = 1
		ENDIF
		IF 選択肢 == 0
			CALL CARD_RANDOM_HAND(듀얼리스트)
			選択カード = RESULT
			CALL CARD_DISPOSE(듀얼리스트,"손패",選択カード)
			효과횟수 ++
		ENDIF
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件複数 = 효과횟수 ++
		CALL CARD_ADD_GY_ADV(対面者,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57161,2)
	IF RESULT == 0
		CALL XON_GRADATION(C_WATER_T,C_LINK_BLUE,"─┼────────────────────","――――――――――――――――――――","────────────────────┼─",0)
		CALL XON_GRADATION(C_WATER_T,C_LINK_BLUE,"─┼─────────────────┼─┼","――――――――――――――――――――","┼─┼─────────────────┼─",0)
		CALL XON_GRADATION(C_WATER_T,C_LINK_BLUE,"─┼─────────────────┼─┼────"," EXTRA  LINK  EFFECT !! ","────┼─┼─────────────────┼─",0)
		CALL XON_GRADATION(C_WATER_T,C_LINK_BLUE,"─┼─────────────────┼─┼","――――――――――――――――――――","┼─┼─────────────────┼─",0)
		CALL XON_GRADATION(C_WATER_T,C_LINK_BLUE,"─┼────────────────────","――――――――――――――――――――","────────────────────┼─",0)
		CALL FULLRESET
		효과範囲손패 = 1
		SIF 손패数(対面者) > 1
			효과条件複数 = 2
		CALL CARD_ADD_GY_ADV(対面者,ゾーン,場所)

		IF 손패数(対面者) == 0
			CALL LIFE_CHANGE(듀얼리스트,"減少","효과",3000,1)
		ENDIF
	ENDIF
ENDIF