@CARDNAME_57159,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 토폴로직 투리스바에나
	CASE "略称"
		RESULTS = TpL바에나
	CASE "カテゴリ"
		RESULTS:0 = 토폴로직
ENDSELECT


@CARD_57159(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 사이버스족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 2300
	CASE "守備力"
		RETURN 1300
	CASE "추가日"
		RETURN 251028
ENDSELECT
RETURN 0


@CARDSUMMON_57159(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 3
素材条件종류 = 효과全般

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,57159) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_57159(종류)
#DIM DYNAMIC 종류

PRINTL 효과モンスター２体以上
CALLFORM CARD_ABLE(0,효과後誘発)
PRINTL ①：このカードがモンスターゾーンに存在する状態で、
PRINTL 자신 필드에 モンスターが특수소환された場合、または상대フィールドにＬモンスターが특수소환された場合に발동できる。
PRINTL そのモンスター及びフィールドの마법・함정カードを全て제외し、
PRINTL この효과で제외した상대のカードの数×５００ダメージを상대に与える。


@CARDCAN_57159(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,57159)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과後誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_最召場所") == 場所
		RETURN 0

	CALL FULLRESET
	효과条件종류 = 링크
	효과条件표시 = 表側표시
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환",1)
	IF RESULT != 1
		CALL FULLRESET
		CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환")
		SIF RESULT != 1
			RETURN 0
	ENDIF
	RETURN 1
ENDIF


@CARDEFFECT_57159(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 효과先
#DIM DYNAMIC ダメージ量

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57159)
	IF RESULT == 0
		IF GETVAR(@"%듀얼리스트%_最召場所") >= 0
			효과先 = FINAL_SUMMON_TARGET(듀얼리스트)
		ELSE
			효과先 = FINAL_SUMMON_TARGET(듀얼리스트,1)
		ENDIF
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"自動処理",효과先,"제외")
		CALL FULLRESET
		효과範囲마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"제외")
		CALL FULLRESET
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"제외")
		ダメージ量 = RESULT:1 * 500
		SIF ダメージ量 > 0
			CALL LIFE_CHANGE(듀얼리스트,"減少","효과",ダメージ量,1)
	ENDIF
ENDIF