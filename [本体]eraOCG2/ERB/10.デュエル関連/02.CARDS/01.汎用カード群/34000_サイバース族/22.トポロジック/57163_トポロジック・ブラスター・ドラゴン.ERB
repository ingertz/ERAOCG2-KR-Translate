@CARDNAME_57163,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 토폴로직 블래스터 드래곤
	CASE "略称"
		RESULTS = TpL블래스터
	CASE "カテゴリ"
		RESULTS:0 = 토폴로직
ENDSELECT


@CARD_57163(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 사이버스족
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 3500
	CASE "守備力"
		RETURN 2500
	CASE "추가日"
		RETURN 251028
ENDSELECT
RETURN 0


@CARDSUMMON_57163(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 5
素材条件종류 = 효과全般

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,57163) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_57163(종류)
#DIM DYNAMIC 종류

PRINTL 효과モンスター２体以上
PRINTL 자신 필드에 他のＬモンスターが存在しない状態でＬ소환したこのカードは「覚醒」する。
CALLFORM CARD_ABLE(0,효과後誘発)
PRINTL ①：覚醒状態のこのカードがモンスターゾーンに存在し、
PRINTL 자신 필드에 モンスターが특수소환された場合、または상대フィールドにＬモンスターが특수소환された場合に발동できる。
PRINTL 以下の효과から１つを選んで適用する。
PRINTL このターン、자신の「토폴로직 블래스터 드래곤」の효과で同じ효과を選択できない。
PRINTL ●このカード以外のフィールドのモンスターを全て덱に戻す。
PRINTL ●フィールドの마법・함정カードを全て덱に戻す。
PRINTL ●상대のＥＸ덱を確認し、その内の１枚を제외する。


@CARDCAN_57163(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 효과使用불가,3
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,57163)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과後誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_条達:場所") == 0
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_最召場所") == 場所
		RETURN 0

	CALL FULLRESET
	효과条件종류 = 링크
	효과条件표시 = 表側표시
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환",1)
	IF RESULT != 1
		CALL FULLRESET
		CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환")
		SIF RESULT != 1
			RETURN 0
	ENDIF

	SIF 발동済_1(듀얼리스트,57163)
		효과使用불가:0 = 1
	SIF 발동済_2(듀얼리스트,57163)
		효과使用불가:1 = 1
	SIF 발동済_3(듀얼리스트,57163)
		효과使用불가:2 = 1

	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		효과使用불가:0 = 1

	CALL FULLRESET
	효과範囲마함 = 1
	효과範囲상대마함 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		효과使用불가:1 = 1

	CALL FULLRESET
	효과範囲상대EX덱 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		효과使用불가:2 = 1
	
	SIF 효과使用불가:0 == 1 && 효과使用불가:1 == 1 && 효과使用불가:2 == 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == EX소환時強制
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = 링크
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_57163(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 효과使用불가,3
#DIM DYNAMIC 選択肢

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 효과後誘発
	SIF 발동済_1(듀얼리스트,57163)
		효과使用불가:0 = 1
	SIF 발동済_2(듀얼리스트,57163)
		효과使用불가:1 = 1
	SIF 발동済_3(듀얼리스트,57163)
		효과使用불가:1 = 1

	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		효과使用불가:0 = 1

	CALL FULLRESET
	효과範囲마함 = 1
	효과範囲상대마함 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		효과使用불가:1 = 1

	CALL FULLRESET
	효과範囲상대EX덱 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		효과使用불가:2 = 1

	IF 듀얼리스트 == "자신"
		PRINTL 효과を選択してください。
		SIF 효과使用불가:0 != 1
			PRINTL [0] このカード以外のフィールドのモンスターを全て덱に戻す。
		SIF 효과使用불가:1 != 1
			PRINTL [1] フィールドの마법・함정カードを全て덱に戻す。
		SIF 효과使用불가:2 != 1
			PRINTL [2] 상대のＥＸ덱を確認し、その内の１枚を제외する。
		BINPUT
		選択肢 = RESULT
	ELSE
		IF 효과使用불가:0 != 1
			選択肢 = 0
		ELSEIF 효과使用불가:1 != 1
			選択肢 = 1
		ELSEIF 효과使用불가:2 != 1
			選択肢 = 2
		ENDIF
	ENDIF
	IF 選択肢 == 0
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57163,1)
		IF RESULT == 0
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲상대필드 = 1
			효과条件他所 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"덱")
		ENDIF
	ELSEIF 選択肢 == 1
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57163,2)
		IF RESULT == 0
			CALL FULLRESET
			효과範囲마함 = 1
			효과範囲상대마함 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"덱")
		ENDIF
	ELSEIF 選択肢 == 2
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57163,3)
		IF RESULT == 0
			CALL FULLRESET
			효과範囲상대EX덱 = 1
			효과条件行先플래그 = 제외行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == EX소환時強制
	CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"条達",2,1)
ENDIF