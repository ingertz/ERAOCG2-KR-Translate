@CARDCAN_57160(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,57160)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과後誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_最召場所") == 場所
		RETURN 0

	CALL FULLRESET
	효과条件종류 = 링크
	효과条件표시 = 表側표시
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환",1)
	IF RESULT != 1
		CALL FULLRESET
		CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환")
		SIF RESULT != 1
			RETURN 0
	ENDIF
	RETURN 1
ELSEIF 종류 == 攻撃後強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	IF 直前戦闘破壊ID(듀얼리스트,1) == 0
		SIF 戦闘場所(듀얼리스트,1) == 5
			RETURN 0
	ENDIF
	RETURN 1
ENDIF


@CARDEFFECT_57160(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 最大링크
#DIM DYNAMIC 最大링크場所,5
#DIM DYNAMIC 最大링크数
#DIM DYNAMIC ダメージ量

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57160)
	IF RESULT == 0
		;상대フィールドの링크の最大値をチェック
		FOR カウンタ,0,5
			SIF GETVAR(@"%対面者%_필드:カウンタ") <= -1
				CONTINUE
			CALLFORM CARD_{GETVAR(@"%対面者%_필드:カウンタ")},"종류"
			SIF RESULT != 링크
				CONTINUE
			SIF 最大링크 <= GETVAR(@"%対面者%_MZ_星:カウンタ")
				最大링크 = GETVAR(@"%対面者%_MZ_星:カウンタ")
		NEXT
		IF 最大링크 > 0
			;상대フィールドの링크値が一番高いモンスターの場所をチェック
			FOR カウンタ,0,5
				SIF GETVAR(@"%対面者%_필드:カウンタ") <= -1
					CONTINUE
				CALLFORM CARD_{GETVAR(@"%対面者%_필드:カウンタ")},"종류"
				SIF RESULT != 링크
					CONTINUE
				CALLFORM CARD_{GETVAR(@"%対面者%_필드:カウンタ")},"レベル"
				IF RESULT == 最大링크
					最大링크場所:カウンタ = 1
					最大링크数 ++
				ENDIF
			NEXT
		ENDIF

		;先に자신の場を全破壊
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件他所 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"묘지")

		;링크値が一番高いモンスター以外を1体ずつ粉砕
		FOR カウンタ,0,5
			SIF GETVAR(@"%対面者%_필드:カウンタ") <= -1
				CONTINUE
			SIF 最大링크場所:カウンタ == 1
				CONTINUE
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"自動処理",カウンタ,"묘지")
		NEXT

		;링크値が同じモンスターが複数存在する場合、１体だけ残して単体破壊
		IF 最大링크数 >= 2
			PRINTL 어느 몬스터를 파괴하시겠습니까？
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과条件종류 = 링크
			효과条件複数 = 100 - (最大링크数 - 1)
			CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
		ENDIF
		CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"単攻",1)
	ENDIF
ELSEIF 종류 == 攻撃後強制誘発
	PRINTFORML 토폴로직 폭탄 드래곤의 효과발동！
	IF 直前戦闘破壊ID(듀얼리스트,1) == 0
		TRYCALLFORM CARD_{戦闘カードID(듀얼리스트,1)}("攻撃力")
	ELSE
		TRYCALLFORM CARD_{直前戦闘破壊ID(듀얼리스트,1)}("攻撃力")
	ENDIF
	ダメージ量 = RESULT
	CALL LIFE_CHANGE(듀얼리스트,"減少","효과",ダメージ量,1)
ENDIF