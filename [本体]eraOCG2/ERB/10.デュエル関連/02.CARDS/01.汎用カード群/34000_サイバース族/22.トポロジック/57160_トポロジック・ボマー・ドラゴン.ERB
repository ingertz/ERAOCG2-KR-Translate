@CARDNAME_57160,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 토폴로직 폭탄 드래곤
	CASE "略称"
		RESULTS = TpL폭탄
	CASE "カテゴリ"
		RESULTS:0 = 토폴로직
ENDSELECT


@CARD_57160(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 사이버스족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 3000
	CASE "守備力"
		RETURN 2500
	CASE "추가日"
		RETURN 251028
ENDSELECT
RETURN 0


