@CARDNAME_57162,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 토폴로직 제로보로스
	CASE "略称"
		RESULTS = TpL제로보로스
	CASE "カテゴリ"
		RESULTS:0 = 토폴로직
ENDSELECT


@CARD_57162(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 사이버스족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 3000
	CASE "守備力"
		RETURN 3000
	CASE "추가日"
		RETURN 251028
ENDSELECT
RETURN 0


@CARDSUMMON_57162(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 4
素材条件종류 = 효과全般

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,57162) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_57162(종류)
#DIM DYNAMIC 종류

PRINTL 효과 몬스터 ２장 이상
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ①：이 카드의 공격력은、제외상태인 카드의 수×２００오른다。
CALLFORM CARD_ABLE(0,효과後誘発)
PRINTL ②：이 카드가 몬스터 존에 존재하는 상태로、
PRINTL 자신 필드에 몬스터가 특수 소환된 경우、또는 상대 필드에 Ｌ몬스터가 특수 소환된 경우에 발동할 수 있다。
PRINTL 필드의 카드를 전부 제외한다。
CALLFORM CARD_ABLE(0,제외時)
PRINTL ③：이 카드가 제외된 경우、다음 스탠바이 페이즈에 발동한다。
PRINTL 제외상태인 이 카드를 특수 소환한다。


@CARDCAN_57162(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,57162)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과後誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_最召場所") == 場所
		RETURN 0

	CALL FULLRESET
	효과条件종류 = 링크
	효과条件표시 = 表側표시
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환",1)
	IF RESULT != 1
		CALL FULLRESET
		CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환")
		SIF RESULT != 1
			RETURN 0
	ENDIF
	RETURN 1
ELSEIF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 제외時
	RETURN 1
ELSEIF 종류 == ターン開始時予約
	CALL CARD_SS_CHECK(듀얼리스트,57162,"제외")
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_57162(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57162)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲상대필드 = 1
		효과範囲마함 = 1
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"제외")
	ENDIF
ELSEIF 종류 == 攻守変動
	攻撃力修正 = 200 * (제외数(듀얼리스트) + 제외数(対面者))
	CALL STATCHANGE_BASIC(듀얼리스트,"自身",場所,攻撃力修正)
ELSEIF 종류 == 제외時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,57162)
	IF RESULT == 0
		CALL CARD_RESERV(듀얼리스트,57162,スタン予約)
	ENDIF
ELSEIF 종류 == ターン開始時予約
	CALL FULLRESET
	효과範囲제외 = 1
	효과条件名前 = 토폴로직 제로보로스
	CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
ENDIF
