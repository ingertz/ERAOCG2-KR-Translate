@CARDNAME_55663,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 고생대 화석룡 스컬기오스
	CASE "略称"
		RESULTS = 고생대 화석룡
	CASE "カテゴリ"
		RESULTS:0 = 화석
ENDSELECT


@CARD_55663(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 3500
	CASE "守備力"
		RETURN 0
	CASE "추가日"
		RETURN 250919
ENDSELECT

RETURN 0

@CARD_EXPLANATION_55663(종류)
#DIM DYNAMIC 종류

PRINTL 원소정령족 몬스터＋상대의 묘지의 레벨７ 이상의 몬스터
;CALLFORM CARD_ABLE(1,攻撃時誘発)
;PRINTL ①：이 카드가 상대 몬스터와 전투를 행한 데미지 계산 전에 발동할 수 있다。
;PRINTL 그 상대 몬스터의 공격력과 수비력을 그 데미지 스텝 종료시까지 뒤바꾼다。
;PRINTL その상대モンスターの攻撃力と守備力をそのダメージステップ終了時まで、
;PRINTL その攻撃力と守備力のうち小さい数値へ변경する。
CALLFORM CARD_ABLE(1,攻守変動)
PRINTL ①：이 카드가 필드에 존재하는 한、
PRINTL 상대 몬스터의 공격력과 수비력을、그 공격력과 수비력중 작은 수치로 변경한다。
CALLFORM CARD_ABLE(2,지속효과)
PRINTL ②：이 카드가 수비 표시 몬스터를 공격한 경우、
PRINTL 그 수비력을 공격력이 넘은 만큼 전투 데미지를 준다。
CALLFORM CARD_ABLE(3,지속효과)
;PRINTL ③：융합 소환한 이 카드가 상대 몬스터와의 전투에서 상대에게 주는 전투 데미지는 배가 된다。
PRINTL ③：이 카드가 상대 몬스터와의 전투에서 상대에게 주는 전투 데미지는 배가 된다。

@CARDSUMMON_55663(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材条件종족 = 원소정령족
ELSEIF EX参照 >= 10
	素材範囲상대묘지 = 1
	素材条件レベル:0 = 7
	素材条件レベル:1 = 8
	素材条件レベル:2 = 9
	素材条件レベル:3 = 10
	素材条件レベル:4 = 11
	素材条件レベル:5 = 12
ENDIF

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,55663) 
	RETURN RESULT
ENDIF

@CARDCAN_55663(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,55663)
SIF RESULT == 1
	RETURN 0

IF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_55663(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 元攻撃力
#DIM DYNAMIC 元守備力
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"貫通")
ELSEIF 종류 == 攻撃時強制誘発
	CALL SET_PLAYER_INFO(듀얼리스트,"ダメージ倍化",3,1)
ELSEIF 종류 == 攻守変動

	FOR カウンタ,0,5
		SIF GETVAR(@"%対面者%_필드:{カウンタ}") == -1
			CONTINUE
		SIF GETVAR(@"%対面者%_필드:{カウンタ}") == -1
			CONTINUE
		元攻撃力 = GETVAR(@"%対面者%_MZ_攻:カウンタ")
		元守備力 = GETVAR(@"%対面者%_MZ_守:カウンタ")
		IF  元攻撃力 > 元守備力
			CALL SET_FIELD_INFO(対面者,"필드",カウンタ,"攻",元守備力,上書きモード)
		ELSE
			CALL SET_FIELD_INFO(対面者,"필드",カウンタ,"守",元攻撃力,上書きモード)
		ENDIF
	NEXT

ENDIF
