@CARDNAME_55666,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 중생대 화석 머신 스컬왜건
	CASE "略称"
		RESULTS = 화석 스컬왜건
	CASE "カテゴリ"
		RESULTS:0 = 화석융합
		RESULTS:1 = 화석
ENDSELECT

@CARD_55666(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 1700
	CASE "守備力"
		RETURN 1500
	CASE "추가日"
		RETURN 250927
ENDSELECT

RETURN 0

@CARD_EXPLANATION_55666(종류)
#DIM DYNAMIC 종류

PRINTL 자신 묘지의 원소정령족 몬스터＋레벨５ / ６인 몬스터
;PRINTL 이 카드는 「화석융합－파슬 퓨전」の효과でのみＥＸ덱에서 특수소환할 수 있다。
PRINTL 이 카드명의 ③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,지속효과)
PRINTL ②：이 카드는 １번의 배틀 페이즈중에 ２회까지 몬스터에게 공격할 수 있다。
CALLFORM CARD_ABLE(2,攻撃後誘発)
PRINTL ③：이 카드가 전투로 상대 몬스터를 파괴했을 때에 발동할 수 있다。
PRINTL 상대에게 ８００ 데미지를 준다。
CALLFORM CARD_ABLE(3,묘지起動)
PRINTL ③：묘지의 이 카드를 제외하고、필드의 마법 / 함정 카드 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터를 파괴한다。

@CARDSUMMON_55666(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材範囲묘지 = 1
	素材条件종족 = 원소정령족
ELSEIF EX参照 >= 10
	素材条件종류 = レベル持ち
	素材条件レベル:0 = 5
	素材条件レベル:1 = 6
ENDIF

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,55666) 
	RETURN RESULT
ENDIF

@CARDCAN_55666(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,55666)
SIF RESULT == 1
	RETURN 0

IF 攻撃後誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF 直前戦闘破壊ID(듀얼리스트,1) == 0
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF 발동済_3(듀얼리스트,55666)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대마함 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_55666(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

IF 종류 == 攻撃時強制誘発
	CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"効済",1)
	IF 戦闘場所(듀얼리스트,1) != 5
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"戦",1)
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"直無",1)
	ENDIF

ELSEIF 종류 == 攻撃後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55666,2)
	IF RESULT == 0
		CALL LIFE_CHANGE(듀얼리스트,"減少","효과",800,1)
	ENDIF
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55666,3)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
	ENDIF
ENDIF

