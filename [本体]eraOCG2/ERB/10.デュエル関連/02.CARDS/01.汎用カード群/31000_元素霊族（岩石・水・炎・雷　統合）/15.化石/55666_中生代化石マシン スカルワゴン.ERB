@CARDNAME_55666,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 중생대 화석 머신 스컬왜건
	CASE "略称"
		RESULTS = 화석 스컬왜건
	CASE "カテゴリ"
		RESULTS:0 = 화석융합
		RESULTS:1 = 화석
ENDSELECT

@CARD_55666(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 1700
	CASE "守備力"
		RETURN 1500
	CASE "추가日"
		RETURN 250927
ENDSELECT

RETURN 0

@CARD_EXPLANATION_55666(종류)
#DIM DYNAMIC 종류

PRINTL 자신の묘지の원소정령족モンスター＋レベル５・６のモンスター
;PRINTL このカードは「화석융합－파슬 퓨전」の효과でのみＥＸ덱から특수소환できる。
PRINTL このカード名の③の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,지속효과)
PRINTL ②：このカードは１度のバトルフェイズ中に２回までモンスターに攻撃できる。
CALLFORM CARD_ABLE(2,攻撃後誘発)
PRINTL ③：このカードが戦闘で상대モンスターを破壊した時に발동できる。
PRINTL 상대に８００ダメージを与える。
CALLFORM CARD_ABLE(3,묘지起動)
PRINTL ③：묘지のこのカードを제외し、フィールドの마법・함정カード１枚を대상として발동できる。
PRINTL そのモンスターを破壊する。

@CARDSUMMON_55666(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材範囲묘지 = 1
	素材条件종족 = 원소정령족
ELSEIF EX参照 >= 10
	素材条件종류 = レベル持ち
	素材条件レベル:0 = 5
	素材条件レベル:1 = 6
ENDIF

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,55666) 
	RETURN RESULT
ENDIF

@CARDCAN_55666(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,55666)
SIF RESULT == 1
	RETURN 0

IF 攻撃後誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF 直前戦闘破壊ID(듀얼리스트,1) == 0
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF 발동済_3(듀얼리스트,55666)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대마함 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_55666(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

IF 종류 == 攻撃時強制誘発
	CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"効済",1)
	IF 戦闘場所(듀얼리스트,1) != 5
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"戦",1)
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"直無",1)
	ENDIF

ELSEIF 종류 == 攻撃後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55666,2)
	IF RESULT == 0
		CALL LIFE_CHANGE(듀얼리스트,"減少","효과",800,1)
	ENDIF
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55666,3)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
	ENDIF
ENDIF

