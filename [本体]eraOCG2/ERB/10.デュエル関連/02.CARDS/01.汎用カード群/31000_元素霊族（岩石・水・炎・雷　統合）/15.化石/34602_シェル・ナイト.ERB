@CARDNAME_34602,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 쉘 나이트
	CASE "略称"
		RESULTS = 쉘 나이트
	CASE "カテゴリ"
		RESULTS = 화석
ENDSELECT


@CARD_34602(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 2000
	CASE "추가日"
		RETURN 250927
ENDSELECT

RETURN 0

@CARD_EXPLANATION_34602(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の②③の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,소환時)
PRINTL ①：このカードが소환に成功した時に발동できる。
PRINTL このカードを守備표시にし、상대に５００ダメージを与える。
CALLFORM CARD_ABLE(2,戦闘→묘지 ,필드→묘지 ,손패→묘지 ,덱→묘지 ,破壊→묘지)
PRINTL ②：このカードが효과で묘지へ送られた場合、または戦闘で破壊された場合に발동できる。
PRINTL 덱から원소정령족・レベル８モンスター１体を손패に加える。
PRINTL 자신の묘지に「화석융합－파슬 퓨전」が存在する場合、
PRINTL 손패に加えず특수소환する事もできる。
PRINTL このターン、자신はそのカード及びその同名カードの효과を발동できない。
CALLFORM CARD_ABLE(3,필드起動)
PRINTL ③：フィールドのこのカードを破壊する。その後、덱から「쉘 나이트」以外の
PRINTL レベル４以下の「화석」モンスター１体を특수소환するか묘지へ送る。
PRINTL この효과を使用したターン、자신は융합モンスターしかＥＸ덱から특수소환できない。

@CARDCAN_34602(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,34602)
SIF RESULT == 1
	RETURN 0
IF 종류 == 소환時
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 戦闘→묘지 || 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지
	SIF 발동済_2(듀얼리스트,34602)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종족 = 원소정령족
	효과条件レベル = 8
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 발동済_3(듀얼리스트,34602)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = モン全般
	효과条件カテゴリ = 화석
	CALL 효과条件レベル_ADV(4,"以下")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_34602(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択結果

IF 종류 == 소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34602, 1)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"表",2,1)
		CALL LIFE_CHANGE(듀얼리스트,"減少","효과",500,1)
	ENDIF
ELSEIF 종류 == 戦闘→묘지 || 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34602, 2)
	IF RESULT == 0

		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 화석융합－파슬 퓨전
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			IF 듀얼리스트 == "상대"
				;CPUは특수소환を優先する
				選択結果 = はい
			ELSE
				PRINTL 몬스터를 특수 소활할지、패에 넣을지 선택해주세요。
				CUSTOMDRAWLINE -
				CALL YN_CHOICE(듀얼리스트,"특수소환","손패へ加える")
				選択結果 = RESULT
			ENDIF
		ELSE
			選択結果 = いいえ
		ENDIF

		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종족 = 원소정령족
		효과条件レベル = 8

		; TODO:同名カードの효과발동制約はどうする？
		IF 選択結果 == はい
			;특수소환処理
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)

		ELSEIF 選択結果 == いいえ
			;묘지送り処理
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34602, 3)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		;특수소환が封じられている場合どうなる？要検証
		IF 듀얼리스트 == "상대"
			;CPUは특수소환を優先する
			選択結果 = はい
		ELSE
			PRINTL 몬스터를 특수 소환할지、묘지로 보낼지 선택해주세요。
			CUSTOMDRAWLINE -
			CALL YN_CHOICE(듀얼리스트,"특수소환","묘지へ送る")
			選択結果 = RESULT
		ENDIF
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종류 = モン全般
		효과条件カテゴリ = 화석
		CALL 효과条件レベル_ADV(4,"以下")
		IF 選択結果 == はい
			;특수소환処理
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)

		ELSEIF 選択結果 == いいえ
			;묘지送り処理
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"덱",ゾーン,場所)
		ENDIF
		CALL FULLRESET
		EX소환可能종류 = 융합
		CALL CARD_EX_RESTRICTION(듀얼리스트)
	ENDIF
ENDIF
