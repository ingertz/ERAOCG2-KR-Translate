@CARDNAME_34602,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 쉘 나이트
	CASE "略称"
		RESULTS = 쉘 나이트
	CASE "カテゴリ"
		RESULTS = 화석
ENDSELECT


@CARD_34602(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 2000
	CASE "추가日"
		RETURN 250927
ENDSELECT

RETURN 0

@CARD_EXPLANATION_34602(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ②③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時)
PRINTL ①：이 카드가 소환에 성공했을 때에 발동할 수 있다。
PRINTL 이 카드를 수비 표시로 하고、상대에게 ５００데미지를 준다。
CALLFORM CARD_ABLE(2,戦闘→묘지 ,필드→묘지 ,손패→묘지 ,덱→묘지 ,破壊→묘지)
PRINTL ②：이 카드가 효과로 묘지로 보내진 경우、또는 전투로 파괴된 경우에 발동할 수 있다。
PRINTL 덱에서 원소정령족 / 레벨８ 몬스터 １장을 패에 넣는다。
PRINTL 자신 묘지에 "화석융합－파슬 퓨전"이 존재하는 경우、
PRINTL 패에 넣지 않고 특수 소환할수도 있다。
PRINTL 이 턴、자신은 그 카드 및 그 같은 이름의 카드의 효과를 발동할 수 없다。
CALLFORM CARD_ABLE(3,필드起動)
PRINTL ③：필드의 이 카드를 파괴한다。그 후、덱에서 "쉘 나이트" 이외의
PRINTL 레벨４ 이하의 "화석" 몬스터 １장을 특수 소환하거나 묘지로 보낸다。
PRINTL 이 효과를 사용한 턴、자신은 융합 몬스터밖에 ＥＸ덱에서 특수 소환할 수 없다。

@CARDCAN_34602(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,34602)
SIF RESULT == 1
	RETURN 0
IF 종류 == 소환時
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 戦闘→묘지 || 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지
	SIF 발동済_2(듀얼리스트,34602)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종족 = 원소정령족
	효과条件レベル = 8
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 발동済_3(듀얼리스트,34602)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = モン全般
	효과条件カテゴリ = 화석
	CALL 효과条件レベル_ADV(4,"以下")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_34602(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択結果

IF 종류 == 소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34602, 1)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"表",2,1)
		CALL LIFE_CHANGE(듀얼리스트,"減少","효과",500,1)
	ENDIF
ELSEIF 종류 == 戦闘→묘지 || 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34602, 2)
	IF RESULT == 0

		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 화석융합－파슬 퓨전
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			IF 듀얼리스트 == "상대"
				;CPUは특수소환を優先する
				選択結果 = はい
			ELSE
				PRINTL 몬스터를 특수 소활할지、패에 넣을지 선택해주세요。
				CUSTOMDRAWLINE -
				CALL YN_CHOICE(듀얼리스트,"특수 소환","패에 넣는다")
				選択結果 = RESULT
			ENDIF
		ELSE
			選択結果 = いいえ
		ENDIF

		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종족 = 원소정령족
		효과条件レベル = 8

		; TODO:同名カードの효과발동制約はどうする？
		IF 選択結果 == はい
			;특수소환処理
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)

		ELSEIF 選択結果 == いいえ
			;묘지送り処理
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,34602, 3)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		;특수소환が封じられている場合どうなる？要検証
		IF 듀얼리스트 == "상대"
			;CPUは특수소환を優先する
			選択結果 = はい
		ELSE
			PRINTL 몬스터를 특수 소환할지、묘지로 보낼지 선택해주세요。
			CUSTOMDRAWLINE -
			CALL YN_CHOICE(듀얼리스트,"특수 소환","묘지로 보낸다")
			選択結果 = RESULT
		ENDIF
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종류 = モン全般
		효과条件カテゴリ = 화석
		CALL 효과条件レベル_ADV(4,"以下")
		IF 選択結果 == はい
			;특수소환処理
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)

		ELSEIF 選択結果 == いいえ
			;묘지送り処理
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"덱",ゾーン,場所)
		ENDIF
		CALL FULLRESET
		EX소환可能종류 = 융합
		CALL CARD_EX_RESTRICTION(듀얼리스트)
	ENDIF
ENDIF
