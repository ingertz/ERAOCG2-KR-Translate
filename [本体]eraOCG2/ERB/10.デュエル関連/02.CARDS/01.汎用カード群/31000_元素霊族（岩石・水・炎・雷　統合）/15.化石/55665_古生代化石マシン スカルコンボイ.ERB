@CARDNAME_55665,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 고생대 화석 머신 스컬콘보이
	CASE "略称"
		RESULTS = 화석 스컬콘보이
	CASE "カテゴリ"
		RESULTS = 화석
ENDSELECT

@CARD_55665(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 2100
	CASE "守備力"
		RETURN 1800
	CASE "추가日"
		RETURN 250927
ENDSELECT

RETURN 0

@CARD_EXPLANATION_55665(종류)
#DIM DYNAMIC 종류

PRINTL 자신 묘지의 원소정령족 몬스터＋레벨７ 이상의 몬스터
;PRINTL 이 카드는 「화석융합－파슬 퓨전」の효과でのみＥＸ덱에서 특수소환할 수 있다。
CALLFORM CARD_ABLE(1,지속효과)
PRINTL ①：융합 소환한 이 카드가 몬스터 존에 존재하는 한、
PRINTL 상대 필드의 몬스터의 공격력은、그 몬스터의 원래 공격력만큼 내린다。
CALLFORM CARD_ABLE(2,지속효과)
PRINTL ②：이 카드는 １번의 배틀 페이즈중에 ３회까지 몬스터에게 공격할 수 있다。
CALLFORM CARD_ABLE(3,攻撃後誘発)
PRINTL ③：이 카드가 전투로 상대 몬스터를 파괴했을 때에 발동할 수 있다。
PRINTL 상대에게 １０００데미지를 준다。

@CARDSUMMON_55665(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材範囲묘지 = 1
	素材条件종족 = 원소정령족
ELSEIF EX参照 >= 10
	素材条件종류 = レベル持ち
	素材条件レベル:0 = 7
	素材条件レベル:1 = 8
	素材条件レベル:2 = 9
	素材条件レベル:3 = 10
	素材条件レベル:4 = 11
	素材条件レベル:5 = 12
ENDIF

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,55665) 
	RETURN RESULT
ENDIF

@CARDCAN_55665(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,55665)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃後誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	SIF 直前戦闘破壊ID(듀얼리스트,1) == 0
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_55665(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 지속효과
	FOR カウンタ,0,5
		SIF GETVAR(@"%対面者%_필드:カウンタ") == -1
			CONTINUE
		攻撃力修正 = GETVAR(@"%対面者%_MZ_守:カウンタ")
		;CALL STATCHANGE_BASIC(対面者,"自身",カウンタ,-攻撃力修正)
		CALL STATCHANGE_EFFECT(듀얼리스트,"対面自身",カウンタ,"永攻",-攻撃力修正)
	NEXT

ELSEIF 종류 == 攻撃時強制誘発
	CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"効済",2)
	IF 戦闘場所(듀얼리스트,1) != 5
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"戦",2)
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"直無",1)
	ENDIF
ELSEIF 종류 == 攻撃後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55665,3)
	IF RESULT == 0
		CALL LIFE_CHANGE(듀얼리스트,"減少","효과",1000,1)
	ENDIF
ENDIF

