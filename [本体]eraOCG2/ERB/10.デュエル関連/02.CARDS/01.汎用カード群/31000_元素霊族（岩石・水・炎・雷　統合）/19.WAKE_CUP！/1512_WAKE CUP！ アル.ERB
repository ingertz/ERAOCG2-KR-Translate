@CARDNAME_1512,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = WAKE CUP！ 얼
	CASE "略称"
		RESULTS = WAKE CUP！ 얼
	CASE "カテゴリ"
		RESULTS:0 = 없음
		RESULTS:1 = 리버스
ENDSELECT


@CARD_1512(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 2700
	CASE "守備力"
		RETURN 400
	CASE "성별"
		RETURN 牝性
ENDSELECT
RETURN 0

@CARD_EXPLANATION_1512(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALL CARD_ABLE(1, 손패起動)
PRINTL ①：이 카드가 손패に存在する場合に발동할 수 있다。
PRINTL 자신の패에서 他のリバース몬스터 １장을 選んで捨て、이 카드를 表側攻撃표시か裏側守備표시で특수 소환한다。
CALL CARD_ABLE(2, リバース誘発)
PRINTL ②：이 카드가 リバースした場合に발동할 수 있다。
PRINTL 자신 필드의 リバースモンスターの数まで、상대필드의 表側표시カードを묘지로 보낸다。
CALL CARD_ABLE(3, ターン終了時)
PRINTL ③：자신 엔드 페이즈에 、자신 묘지의 リバース몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL その몬스터를 裏側守備표시で특수 소환한다。


@CARDCAN_1512(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트, 종류, ゾーン, 場所, 1512)
SIF RESULT == 1
	RETURN 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트, 1512)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트, 1512, "손패")
	SIF RESULT == 1
		RETURN 0
	
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件종류 = モン全般
	효과条件カテゴリ = 리버스
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == リバース誘発
	SIF 발동済_2(듀얼리스트, 1512)
		RETURN 0
	
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件표시 = 表側표시
	효과条件除去種 = リリース
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 리버스
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == ターン終了時
	SIF 발동済_3(듀얼리스트, 1512)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종류 = モン全般
	효과条件カテゴリ = 리버스
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ENDIF

@CARDEFFECT_1512(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択結果
#DIM DYNAMIC 除去枚数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 1512, 1)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종류 = モン全般
		효과条件カテゴリ = 리버스
		효과条件他所 = 1
		CALL CARD_ADD_GY_BASIC(듀얼리스트, "손패", ゾーン, 場所)
		IF RESULT == 1
			SIF 듀얼리스트 == "자신"
				PRINTFORMW 표시形式を選択してください
			CALL YN_CHOICE(듀얼리스트, "●表側攻撃표시", "●裏側守備표시")
			選択結果 = RESULT
			
			CALL FULLRESET
			IF 選択結果 == はい
				CALL CARD_SP_SUMMON(듀얼리스트, ゾーン, 場所, "攻撃표시")
			ELSE
				CALL CARD_SP_SUMMON(듀얼리스트, ゾーン, 場所, "裏側守備표시")
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == リバース誘発
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 1512, 2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 리버스
		효과条件표시 = 表側표시
		효과条件CNT = 1
		효과条件限界値 = 5
		CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
		除去枚数 = RESULT
		
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과条件표시 = 表側표시
		효과条件複数 = 100 - 除去枚数
		CALL CARD_REMOVAL_ADV(듀얼리스트, "単体除去", 場所, "リリース")
	ENDIF
ELSEIF 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 1512, 3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종류 = モン全般
		효과条件カテゴリ = 리버스
		CALL CARD_SP_SUMMON_ADV(듀얼리스트, ゾーン, 場所, "裏側守備표시")
	ENDIF
ENDIF


