@CARDNAME_31317,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 결장룡 티스티나
	CASE "略称"
		RESULTS = 결장룡 티스티나
	CASE "カテゴリ"
		RESULTS:0 = 티스티나
ENDSELECT


@CARD_31317(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 2000
	CASE "守備力"
		RETURN 0
	CASE "추가日"
		RETURN 251125
ENDSELECT
RETURN 0

@CARD_EXPLANATION_31317(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １장밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時,특수소환時)
PRINTL ①：이 카드가 소환 / 특수 소환한 경우에 발동할 수 있다。
PRINTL 덱에서 이 카드명 이외의 "티스티나" 몬스터 １장을 패에 넣는다。
PRINTL 이 턴 중、자신 필드의 빛속성인 "티스티나" 몬스터의 공격력은 １０００오른다。
CALLFORM CARD_ABLE(2,필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지,X素材時효과)
PRINTL ②：이 카드가 묘지로 보내진 경우、필드 마법 카드가 앞면 표시로 존재하고 있다면 발동할 수 있다。
PRINTL 이 카드를 특수 소환한다。이 턴、자신은 Ｘ몬스터밖에 ＥＸ덱에서 특수 소환할 수 없다。
;PRINTL 이 카드를 특수 소환한다。이 턴、자신은 「티스티나」 몬스터밖에 패 / 묘지에서 특수 소환할 수 없다。


@CARDSUMMON_AA_31317


@CARDCAN_31317(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,31317)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,31317)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 티스티나
	효과条件固名前 = 결장룡 티스티나
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 短紋章起動
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지 || 종류 == X素材時효과
	SIF 발동済_2(듀얼리스트,31317)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,22010,"묘지")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과範囲상대마함 = 1
	효과条件종류 = フィールド
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_31317(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31317,1)
	IF RESULT == 0
		CALL FULLRESET
		효과条件カテゴリ = 티스티나
		효과条件固名前 = 결장룡 티스티나
		CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所)
		SIF RESULT 
			CALL CARD_RESERV(듀얼리스트,31317,短紋章予約)
	ENDIF
ELSEIF 종류 == 短紋章起動
	CALL FULLRESET
	효과条件속성 = 빛속성
	효과条件カテゴリ = 티스티나
	CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,500)
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지 || 종류 == X素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31317,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 결장룡 티스티나
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		EX소환可能종류 = 엑시즈
		CALL CARD_EX_RESTRICTION(듀얼리스트)
	ENDIF
ENDIF
