@CARDNAME_31314,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 티스티나의 엽견
	CASE "略称"
		RESULTS = 티스티나 엽견
	CASE "カテゴリ"
		RESULTS:0 = 티스티나
ENDSELECT


@CARD_31314(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1800
	CASE "守備力"
		RETURN 700
	CASE "추가日"
		RETURN 251125
ENDSELECT
RETURN 0

