@CARDNAME_91310,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 티스티나의 변정
	CASE "略称"
		RESULTS = 티스티나 변정
	CASE "カテゴリ"
		RESULTS:0 = 티스티나
ENDSELECT


@CARD_91310(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 251125
ENDSELECT

RETURN 0

@CARD_EXPLANATION_91310(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는１턴에 １번、어느쪽인가밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動,フリー誘発)
PRINTL ①：자신 필드에 "티스티나" 몬스터가 존재하는 경우에 발동할 수 있다。상대 묘지의 카드 １장을 완전 제외한다。
PRINTL 그 "티스티나" 몬스터가 EX 몬스터인 경우、상대 묘지의 카드를 전부 완전 제외할 수도 있다。
CALLFORM CARD_ABLE(1,묘지起動,フリー誘発)
PRINTL ②：묘지의 이 카드를 제외하고 발동할 수 있다。자신 묘지의 "티스티나" 몬스터 １장을 패로 되돌린다。



@CARDCAN_91310(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,91310)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 묘지起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,91310)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	IF ゾーン == "마함"
		CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 티스티나
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
		CALL FULLRESET
		효과範囲상대묘지 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ELSEIF ゾーン == "묘지"
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 티스티나
		효과条件종류 = モン全般
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ELSE
		RETURN 0
	ENDIF
	RETURN 1
ENDIF


@CARDEFFECT_91310(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 묘지送カード,5
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 마함起動 || 종류 == 묘지起動 || 종류 == フリー誘発
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91310,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		IF ゾーン == "마함"
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件カテゴリ = 티스티나
			효과条件종류 = EXモン全般
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			IF RESULT == 1
				PRINTL 상대 묘지의 카드를 전부 완전 제외하시겠습니까？
				CALL YN_CHOICE(듀얼리스트)
			ELSE
				RESULT = 1
			ENDIF
			IF RESULT == 0
				FOR カウンタ,0,紙束最大値
					SIF GETVAR(@"%対面者%_묘지:カウンタ") == -1
						CONTINUE
					CALL CARD_DISPOSE(対面者,"묘지",カウンタ,完全제외行き)
				NEXT
			ELSE
				CALL FULLRESET
				효과条件行先플래그 = 完全제외行き
				CALL CARD_ADD_GY_BASIC(듀얼리스트, "상대묘지",ゾーン,場所)
			ENDIF
		ELSEIF ゾーン == "묘지"
			CALL FULLRESET
			효과条件カテゴリ = 티스티나
			효과条件종류 = モン全般
			CALL CARD_ADD_BASIC(듀얼리스트,"묘지",ゾーン,場所)
		ENDIF
	ENDIF
ENDIF
