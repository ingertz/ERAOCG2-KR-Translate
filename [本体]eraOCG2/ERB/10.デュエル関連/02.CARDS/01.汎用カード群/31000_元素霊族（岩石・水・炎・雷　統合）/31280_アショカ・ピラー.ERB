@CARDNAME_31280,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 아쇼카 필라
	CASE "略称"
		RESULTS = Ash 필라
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_31280(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 2200
		CASE "추가日"
		RETURN 250927
ENDSELECT

RETURN 0

@CARD_EXPLANATION_31280(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,소환時 ,특수소환時)
PRINTL ①：このカードが소환・특수소환に成功した場合に발동できる。
PRINTL 덱から装備마법カード１枚を손패に加える。
PRINTL このカードが攻撃표시の場合、さらにこのカードは守備표시になる。
CALLFORM CARD_ABLE(2,破壊→묘지 ,戦闘→묘지)
PRINTL ②：このカードが戦闘・효과で破壊された場合に強制的に발동する。
PRINTL 자신は２０００ダメージを受ける。
PRINTL 


@CARDFORCE_31280(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

VARSET RESULT
IF 종류 == 破壊→묘지 || 종류 == 제외時
	RETURN 1
ENDIF
@CARDCAN_31280(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,31280)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,31280)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = 装備마법
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	SIF 발동済_2(듀얼리스트,31280)
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_31280(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31280,1)
	IF RESULT == 0
		CALL FULLRESET
		효과条件종류 = 装備마법
		CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所)
		SIF GETVAR(@"%듀얼리스트%_MZ_表:場所") == 攻撃표시
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"表",2,1)
	ENDIF
ELSEIF 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31280,2)
	IF RESULT == 0
		CALL LIFE_CHANGE(듀얼리스트,"減少","효과",2000)
	ENDIF
ENDIF


