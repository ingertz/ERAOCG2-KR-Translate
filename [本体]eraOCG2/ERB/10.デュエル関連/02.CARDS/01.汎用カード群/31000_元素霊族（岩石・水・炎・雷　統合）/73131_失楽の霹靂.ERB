@CARDNAME_73131,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 실락의 벽력
	CASE "略称"
		RESULTS = 실락의 벽력
	CASE "カテゴリ"
		RESULTS:0 = 환마
ENDSELECT


@CARD_73131(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속마법
ENDSELECT

RETURN 0

@CARD_EXPLANATION_73131(종류)
#DIM DYNAMIC 종류

CALLFORM CARD_ABLE(10,발동誘発)
PRINTL ①：１턴에 １번、상대가 마법 / 함정 카드를 발동했을 때에 발동할 수 있다。
PRINTL 그 발동을 무효로 하고、자신 필드의 공격 표시인 "삼환마" 몬스터 １장을 수비 표시로 한다。
CALLFORM CARD_ABLE(0,마함起動)
PRINTL ②：자신 필드의 "삼환마" 몬스터가 필드에서 벗어난 턴、
PRINTL 자신이 받는 모든 데미지는 ０이 된다。
CALLFORM CARD_ABLE(0,묘지起動)
PRINTL ③：자신의 패 / 필드의 "번개황제 하몬"을 상대에게 확인시키고 발동할 수 있다。
PRINTL 묘지의 이 카드를 자신의 마법 & 함정 존에 앞면 표시로 놓는다。


@CARDCAN_73131(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,73131)
SIF RESULT == 1
	RETURN 0

IF 종류 == 발동誘発 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件표시 = 攻撃표시
	효과条件カテゴリ = 삼환마
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과条件종류 = 마함全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,73131)
		RETURN 0
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後強制誘発
	SIF ゾーン != "마함"
		RETURN 0
	CALL FULLRESET
	효과条件カテゴリ = 삼환마
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"필드離れ",1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲필드 = 1
	효과条件名前 = 번개황제 하몬
	효과条件표시 = 0
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_CONT_M(듀얼리스트,종류,"손패",場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_73131(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 발동誘発 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73131,10)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"묘지")
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件표시 = 攻撃표시
		효과条件カテゴリ = 삼환마
		CALL CARD_GRANT_ADV(듀얼리스트,ゾーン,場所,"表",守備표시)
	ENDIF
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73131)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF
ELSEIF 종류 == 효과後強制誘発
	CALL SET_PLAYER_INFO(듀얼리스트,"ダメージ無効",1)
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73131)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF
ENDIF
