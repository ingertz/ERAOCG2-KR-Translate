@CARDNAME_31362,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 전지맨－C
	CASE "略称"
		RESULTS = 전지맨C
	CASE "カテゴリ"
		RESULTS:0 = 전지맨
ENDSELECT


@CARD_31362(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 260101
ENDSELECT
RETURN 0

@CARD_EXPLANATION_31362(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,손패起動)
PRINTL ①：자신 필드에 빛속성 몬스터가 존재하는 경우에 발동할 수 있다。
PRINTL 이 카드를 패에서 특수 소환한다。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ②：자신 필드의 기계족 몬스터와 빛속성 / 원소정령족 몬스터의 공격력은
PRINTL 자신 필드의 공격표시인 "전지맨－C"의 수×５００포인트 오르고、
PRINTL 자신 필드의 기계족 몬스터와 빛속성 / 원소정령족 몬스터의 수비력은
PRINTL 자신 필드의 수비표시인 "전지맨－C"의 수×５００포인트 오른다。
CALLFORM CARD_ABLE(1,필드→묘지,손패→묘지,덱→묘지,破壊→묘지,戦闘→묘지)
PRINTL ③：이 카드가 묘지로 보내진 경우에 발동할 수 있다。
PRINTL 덱에서 "전지맨－C" 이외의 "전지맨" 몬스터 １장을 패에 넣는다。
PRINTL 

@CARDCAN_31362(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,31362)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0	
	SIF メインフェイズ != 1
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,31362,"손패")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件속성 = 빛속성
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	SIF 발동済_3(듀얼리스트,31362)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ= 전지맨
	효과条件固名前 = 전지맨－C
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_31362(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 守備力修正

IF 종류 == 손패起動 
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31362)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 攻守変動
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件표시 = 攻撃표시
	효과条件名前 = 전지맨－C
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	攻撃力修正 = RESULT * 500
	IF 攻撃力修正 > 0
		CALL FULLRESET
		효과条件종족 = 기계족
		CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,攻撃力修正,0)

		CALL FULLRESET
		효과条件속성 = 빛속성
		효과条件종족 = 원소정령족
		CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,攻撃力修正,0)
	ENDIF

	CALL FULLRESET
	효과範囲필드 = 1
	효과条件표시 = 守備표시
	효과条件名前 = 전지맨－C
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	守備力修正 = RESULT * 500
	IF 守備力修正 > 0
		CALL FULLRESET
		효과条件종족 = 기계족
		CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,0,守備力修正)

		CALL FULLRESET
		효과条件속성 = 빛속성
		효과条件종족 = 원소정령족
		CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,0,守備力修正)
	ENDIF
ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31362,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ= 전지맨
		효과条件固名前 = 전지맨－C
		효과条件종류 = モン全般
		CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所)
	ENDIF
ENDIF
