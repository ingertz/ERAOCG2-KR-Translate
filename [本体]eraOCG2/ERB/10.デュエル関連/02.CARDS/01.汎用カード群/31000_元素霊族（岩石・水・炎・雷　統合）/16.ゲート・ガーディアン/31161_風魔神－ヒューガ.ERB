VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 풍 마신－휴가
	CASE "略称"
		RESULTS = 풍 마신－휴가
	CASE "カテゴリ"
		RESULTS:0 = 게이트 가디언
ENDSELECT


@CARD_31161(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
