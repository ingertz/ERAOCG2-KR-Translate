@CARDNAME_31331,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 볼캐닉 림파이어
	CASE "略称"
		RESULTS = V 림파이어
	CASE "カテゴリ"
		RESULTS:0 = 볼캐닉
ENDSELECT


@CARD_31331(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 300
	CASE "守備力"
		RETURN 0
ENDSELECT
RETURN 0

@CARD_EXPLANATION_31331(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
;묘지送り時묘지送りorブレイズ
CALLFORM CARD_ABLE(0,필드→묘지 ,손패→묘지 ,덱→묘지 ,破壊→묘지 ,戦闘→묘지)
PRINTL ①：이 카드가 묘지로 보내진 경우、이하의 효과에서 １개를 선택해서 발동할 수 있다
PRINTL （이 카드명의 이하의 효과는 각각 １턴에 １번밖에 선택할 수 없다）。
CALLFORM CARD_ABLE(1,필드→묘지 ,손패→묘지 ,덱→묘지 ,破壊→묘지 ,戦闘→묘지)
PRINTL ●묘지의 이 카드를 제외하고、
PRINTL 덱에서 "볼캐닉 림파이어" 이외의 "볼캐닉" 몬스터 １장을 묘지로 보낸다。
CALLFORM CARD_ABLE(2,필드→묘지 ,손패→묘지 ,덱→묘지 ,破壊→묘지 ,戦闘→묘지)
PRINTL ●패 / 덱에서 "브레이즈 캐논" 지속 마법 / 지속 함정 카드 １장을 자신 필드에 앞면 표시로 놓는다。
;リリースリクルート
CALLFORM CARD_ABLE(3,필드起動)
PRINTL 이 카드를 릴리스하고 발동할 수 있다。
PRINTL 덱에서 레벨４ 이하의 "볼캐닉" 몬스터 １장을 특수 소환한다。
PRINTL 이 효과의 발동 후、턴 종료시까지 자신은 화염속성 몬스터밖에 특수 소환할 수 없다。



@CARDCAN_31331(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 발동불가,2
#DIM DYNAMIC VBC有

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,31331)
SIF RESULT == 1
	RETURN 0
;묘지送り時효과
IF  종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	SIF 발동済_1(듀얼리스트,31331)
		발동불가:0 = 1
	SIF 발동済_2(듀얼리스트,31331)
		발동불가:1 = 1
	;묘지送りからチェック
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		발동불가:0 = 1
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 볼캐닉
	효과条件固名前 = 볼캐닉 림파이어
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1
	;ここからブレイズキャノンセット
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件名前 = 볼캐닉 브레이즈 캐논
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		;VBCは唯一だから既にあったら出せないよ
		VBC有 = 1
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲손패 = 1
	효과条件カテゴリ = 브레이즈 캐논
	SIF VBC有 == 1
		효과条件固名前 = 볼캐닉 브레이즈 캐논
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:1 = 1
	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 발동済_3(듀얼리스트,31331)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 볼캐닉
	CALL 효과条件レベル_ADV(4, "以下")
	효과条件소환可 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_31331(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 발동불가,2

#DIM DYNAMIC VBC有

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

;묘지送り時효과
IF  종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31331)
	IF RESULT == 0	
		SIF 발동済_1(듀얼리스트,31331)
			발동불가:0 = 1
		SIF 발동済_2(듀얼리스트,31331)
			발동불가:1 = 1
		;묘지送りからチェック
		SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
			발동불가:0 = 1
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 볼캐닉
		효과条件固名前 = 볼캐닉 림파이어
		효과条件종류 = モン全般
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:0 = 1
		;ここからブレイズキャノンセット
		CALL FULLRESET
		효과範囲마함 = 1
		효과条件名前 = 볼캐닉 브레이즈 캐논
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			VBC有 = 1
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲손패 = 1
		효과条件カテゴリ = 브레이즈 캐논
		SIF VBC有 == 1
			효과条件固名前 = 볼캐닉 브레이즈 캐논
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:1 = 1
		;選択
		IF 발동불가:0 != 1 && 발동불가:1 != 1
			CALL YN_CHOICE(듀얼리스트,"●묘지의 이 카드를 제외하고、덱에서 「볼캐닉 림파이어」 이외의 「볼캐닉」몬스터 １장을 묘지로 보낸다。","●패 / 덱에서 「브레이즈 캐논」지속 마법 / 지속 함정 카드 １장을 자신 필드에 앞면 표시로 놓는다。")
		ELSEIF 발동불가:0 != 1
			RESULT = 0
		ELSEIF 발동불가:1 != 1
			RESULT = 1
		ENDIF
		IF RESULT == 0
			CALL CARD_EFFECT_USE(듀얼리스트,31331,1)
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件名前 =볼캐닉 림파이어
			효과条件行先플래그 = 제외行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲덱 = 1
				효과条件カテゴリ = 볼캐닉
				효과条件固名前 = 볼캐닉 림파이어
				효과条件종류 = モン全般
				CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
		ELSEIF RESULT == 1
			CALL CARD_EFFECT_USE(듀얼리스트,31331,2)
			CALL FULLRESET
			효과範囲마함 = 1
			효과条件名前 = 볼캐닉 브레이즈 캐논
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT == 1
				VBC有 = 1

			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲손패 = 1
			효과条件カテゴリ = 브레이즈 캐논
			SIF VBC有 == 1
				효과条件固名前 = 볼캐닉 브레이즈 캐논
			CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"表側표시")
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31331,3)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 볼캐닉
		CALL 효과条件レベル_ADV(4, "以下")
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		SS소환可能속성:0 = 화염속성
		CALL CARD_SS_RESTRICTION(듀얼리스트)
	ENDIF
ENDIF

