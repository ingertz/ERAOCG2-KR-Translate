@CARDNAME_93101,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 볼캐닉 에미션
	CASE "略称"
		RESULTS = V 에미션
	CASE "カテゴリ"
		RESULTS:0 = 볼캐닉
ENDSELECT


@CARD_93101(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
ENDSELECT

RETURN 0

@CARD_EXPLANATION_93101(종류)
#DIM DYNAMIC 종류
CALLFORM CARD_ABLE(0,마함起動,フリー誘発)
PRINTL ①：이하의 효과에서 １개를 선택해서 발동할 수 있다
PRINTL （이 카드명의 이하의 효과는 각각 １턴에 １번밖에 선택할 수 없다）。
CALLFORM CARD_ABLE(1,마함起動,フリー誘発)
PRINTL ●덱에서 "볼캐닉" 몬스터 １장을 골라서 특수 소환한다。
PRINTL 이 효과로 특수 소환한 몬스터는 엔드 페이즈에 패로 되돌아간다。
CALLFORM CARD_ABLE(2,마함起動,フリー誘発)
PRINTL ●필드의 화염 속성 / 원소정령족 몬스터 １장의 원래 공격력 절반의 데미지를 상대에게 준다。

@CARDCAN_93101(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 발동불가,2
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,93101)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == フリー誘発
	SIF ゾーン != "마함"
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 발동済_1(듀얼리스트,93101)
		발동불가:0 = 1
	SIF 발동済_2(듀얼리스트,93101)
		발동불가:1 = 1
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 볼캐닉
	효과条件종류 = モン全般
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1

	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件속성 = 화염속성
	효과条件종족 = 원소정령족
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:1 = 1

	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_93101(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 발동불가,2
#DIM DYNAMIC ダメージ量

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,93101)
	IF RESULT == 0
		SIF 발동済_1(듀얼리스트,93101)
			발동불가:0 = 1
		SIF 발동済_2(듀얼리스트,93101)
			발동불가:1 = 1
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 볼캐닉
		효과条件종류 = モン全般
		효과条件소환可 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:0 = 1

		효과範囲필드 = 1
		효과範囲상대필드 = 1
		효과条件속성 = 화염속성
		효과条件종족 = 원소정령족
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:1 = 1
	
		IF 듀얼리스트 == "자신"
			SIF 발동불가:0 != 1
				PRINTL [0] - ●덱에서 "볼캐닉" 몬스터를 특수 소환한다。
			SIF 발동불가:1 != 1
				PRINTL [1] - ●필드의 화염 속성 / 원소정령족 몬스터의 공격력 절반의 데미지를 준다。
			SIF 발동불가:0 == 1 && 발동불가:1 == 1
				PRINTL [9999] - 돌아간다
			BINPUT
		ELSE
			IF 발동불가:1 != 1
				RESULT = 1
			ELSE
				RESULT = 0
			ENDIF
		ENDIF

		IF RESULT == 0
			CALL CARD_EFFECT_USE(듀얼리스트,93101,1)
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 볼캐닉
			효과条件종류 = モン全般
			효과추가종류 = 10 + 손패行き
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ELSEIF RESULT == 1
			CALL CARD_EFFECT_USE(듀얼리스트,93101,2)
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲상대필드 = 1
			효과条件속성 = 화염속성
			효과条件종족 = 원소정령족
			CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
			CALL CARD_SELECT(듀얼리스트,RESULT)
			選択カード = RESULT
			選択カード_ID = RESULT:99
			CALLFORM CARD_{選択カード_ID}("攻撃力")
			IF RESULT > 0
				ダメージ量 = RESULT / 2
				CALL LIFE_CHANGE(듀얼리스트,"減少","효과",ダメージ量,1)
			ENDIF
		ENDIF
	ENDIF
ENDIF
