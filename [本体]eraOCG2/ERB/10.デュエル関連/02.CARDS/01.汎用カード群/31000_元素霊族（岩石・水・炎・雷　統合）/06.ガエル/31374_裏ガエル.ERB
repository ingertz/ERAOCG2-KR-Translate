@CARDNAME_31374,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 배반 개구리
	CASE "略称"
		RESULTS = 배반 개구리
	CASE "カテゴリ"
		RESULTS:0 = 개구리
ENDSELECT


@CARD_31374(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 500
	CASE "守備力"
		RETURN 200
	CASE "추가日"
		RETURN 260101
ENDSELECT

RETURN 0

@CARD_EXPLANATION_31374(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,필드起動)
PRINTL ①：자신 메인 페이즈에 발동할 수 있다。
PRINTL 이 카드를 뒷면 수비 표시로 한다。
CALLFORM CARD_ABLE(0,リバース誘発)
PRINTL ②：이 카드가 리버스된 경우에 발동할 수 있다。
PRINTL 자신 필드의 "개구리" 몬스터의 수＋１장까지、상대 필드의 몬스터를 패로 되돌린다。
CALLFORM CARD_ABLE(0,효과後誘発)
PRINTL ③：자신 필드의 "배반 개구리" 이외의 "개구리" 몬스터가 전투 / 효과로 파괴된 경우에 발동할 수 있다。
PRINTL 이 카드를 묘지에서 뒷면 수비 표시로 특수 소환한다。
PRINTL 이 효과로 특수 소환된 이 카드는 필드에서 벗어날 경우、제외된다。

@CARDCAN_31374(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,31374)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動
	SIF 발동済_1(듀얼리스트,31374)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1

ELSEIF 종류 == リバース誘発
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件除去種 = 손패
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 효과後誘発
	SIF ゾーン != "묘지"
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,31374,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과条件カテゴリ = 개구리
	효과条件종류 = モン全般
	효과条件固名前 = 배반 개구리
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"破壊全般")
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_31374(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 개구리数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31374,1)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"表",3,1)
	ENDIF

ELSEIF 종류 == リバース誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31374)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 개구리
		효과条件표시 = 表側표시
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		개구리数 = RESULT
		SIF 개구리数 < 5
			개구리数 += 1

		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件複数 = 100 - 개구리数
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"손패")
	ENDIF

ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31374)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 배반 개구리
		효과추가종류 = 効追除処
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"裏側守備표시")
	ENDIF
ENDIF

