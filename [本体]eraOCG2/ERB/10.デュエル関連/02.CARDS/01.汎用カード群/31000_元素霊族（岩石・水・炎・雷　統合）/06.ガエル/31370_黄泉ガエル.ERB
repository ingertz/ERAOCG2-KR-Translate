@CARDNAME_31370,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 황천 개구리
	CASE "略称"
		RESULTS = 황천 개구리
	CASE "カテゴリ"
		RESULTS:0 = 개구리
ENDSELECT


@CARD_31370(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 100
	CASE "守備力"
		RETURN 100
	CASE "Xレベル"
		RETURN 2
	CASE "추가日"
		RETURN 260101
ENDSELECT

RETURN 0

@CARD_EXPLANATION_31370(종류)
#DIM DYNAMIC 종류

PRINTL このカードをＸ소환に使用する場合、このカードのレベルを２として扱うことができる。
PRINTL このカード名の②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(0,ターン開始時)
PRINTL ①：자신フィールドに「황천 개구리」が存在しない場合、자신スタンバイフェイズに발동できる。
PRINTL 묘지のこのカードを특수소환する。
PRINTL この효과は자신の마법＆함정ゾーンにカードが存在しない場合に발동と処理ができる。
CALLFORM CARD_ABLE(2,戦闘→묘지 ,필드→묘지 ,손패→묘지 ,덱→묘지 ,破壊→묘지,X素材時효과)
PRINTL ②：このカードが묘지へ送られた場合に발동できる。
PRINTL 손패からレベル２以上の「개구리」モンスター１体を특수소환する。

@CARDCAN_31370(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,31370)
SIF RESULT == 1
	RETURN 0

IF 종류 == ターン開始時
	SIF ゾーン != "묘지"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 마함数(듀얼리스트) != 0
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,31370,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件名前 = 황천 개구리
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 0
	RETURN 1

ELSEIF GROUPMATCH(종류,戦闘→묘지 ,필드→묘지 ,손패→묘지 ,덱→묘지 ,破壊→묘지,X素材時효과)
	SIF 발동済_2(듀얼리스트,31370)
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件カテゴリ = 개구리
	CALLFORM 효과条件レベル_ADV(2,"以上")
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_31370(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == ターン開始時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31370)
	IF RESULT == 0
		SIF 마함数(듀얼리스트) != 0
			RETURN 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 황천 개구리
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31370,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件カテゴリ = 개구리
		CALLFORM 효과条件レベル_ADV(2,"以上")
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF

