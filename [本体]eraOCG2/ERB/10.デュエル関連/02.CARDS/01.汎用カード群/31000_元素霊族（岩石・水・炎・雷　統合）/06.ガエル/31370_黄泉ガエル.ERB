@CARDNAME_31370,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 황천 개구리
	CASE "略称"
		RESULTS = 황천 개구리
	CASE "カテゴリ"
		RESULTS:0 = 개구리
ENDSELECT


@CARD_31370(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 100
	CASE "守備力"
		RETURN 100
	CASE "Xレベル"
		RETURN 2
	CASE "추가日"
		RETURN 260101
ENDSELECT

RETURN 0

@CARD_EXPLANATION_31370(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드를 Ｘ소환에 사용할 경우、이 카드의 레벨을 ２로서 취급할 수 있다。
PRINTL 이 카드명의 ②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,ターン開始時)
PRINTL ①：자신 필드에 "황천 개구리"가 존재하지 않는 경우、자신 스탠바이 페이즈에 발동할 수 있다。
PRINTL 묘지의 이 카드를 특수 소환한다。
PRINTL 이 효과는 자신의 마법＆함정 존에 카드가 존재하지 않는 경우에 발동과 처리를할 수 있다。
CALLFORM CARD_ABLE(2,戦闘→묘지 ,필드→묘지 ,손패→묘지 ,덱→묘지 ,破壊→묘지,X素材時효과)
PRINTL ②：이 카드가 묘지로 보내진 경우에 발동할 수 있다。
PRINTL 패에서 레벨２ 이상인 "개구리" 몬스터 １장을 특수 소환한다。

@CARDCAN_31370(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,31370)
SIF RESULT == 1
	RETURN 0

IF 종류 == ターン開始時
	SIF ゾーン != "묘지"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 마함数(듀얼리스트) != 0
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,31370,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件名前 = 황천 개구리
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 0
	RETURN 1

ELSEIF GROUPMATCH(종류,戦闘→묘지 ,필드→묘지 ,손패→묘지 ,덱→묘지 ,破壊→묘지,X素材時효과)
	SIF 발동済_2(듀얼리스트,31370)
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件カテゴリ = 개구리
	CALLFORM 효과条件レベル_ADV(2,"以上")
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_31370(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == ターン開始時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31370)
	IF RESULT == 0
		SIF 마함数(듀얼리스트) != 0
			RETURN 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 황천 개구리
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지 || 종류 == 破壊→묘지 || 종류 == 戦闘→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,31370,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件カテゴリ = 개구리
		CALLFORM 효과条件レベル_ADV(2,"以上")
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF

