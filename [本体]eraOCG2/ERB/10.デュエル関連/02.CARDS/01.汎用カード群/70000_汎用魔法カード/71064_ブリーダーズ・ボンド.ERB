@CARDNAME_71064,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 브리더즈 본드
	CASE "略称"
		RESULTS = 육성자의 인연
	CASE "カテゴリ"
		RESULTS:0 = Lv
		RESULTS:4 = 게임오리지널
ENDSELECT


@CARD_71064(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속마법
ENDSELECT

RETURN 0

@CARD_EXPLANATION_71064(종류)
#DIM DYNAMIC 종류
PRINTL このカード名のカードは１ターンに１枚しか발동できない。
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①：자신のフィールド・묘지にモンスターが存在しない場合、
PRINTL このカードの발동時の효과処理として、덱から「Ｌｖ」モンスター１体を특수소환できる。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ②：자신フィールドの「Ｌｖ」モンスターの攻撃力・守備力は、そのモンスターのレベル×１００アップする。
CALLFORM CARD_ABLE(0,身代효과)
PRINTL ③：자신フィールドの「Ｌｖ」モンスターが상대によって離れる場合、
PRINTL 代わりにフィールドのこのカードを묘지に送ってもよい。
PRINTL そうした場合、자신フィールドの成長可能な「Ｌｖ」モンスター１体を成長させてもよい。

@CARDCAN_71064(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,71064)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,71064)
		RETURN 0
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1

ELSEIF 종류 == 身代효과
	SIF ゾーン != "마함"
		RETURN 0
	SIF 破壊대상ゾーン != "필드"
		RETURN 0
	SIF 処理中_듀얼리스트 == 듀얼리스트
		RETURN 0
	TRYCALLFORM CARDNAME_{破壊대상ID}("カテゴリ")
	SIF !MATCH(RESULTS,"Lv")
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻守変動
	SIF ゾーン != "마함"
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_71064(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 設定レベル 
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 取込カードID
#DIMS DYNAMIC 取込カード名称

IF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆設置まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71064,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)

		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件종류 = モン全般
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT != 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = Lv
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 攻守変動
	FOR カウンタ,0,5
		SIF GETVAR(@"%듀얼리스트%_필드:{カウンタ}") == -1
			CONTINUE	
		TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_필드:{カウンタ}")}("カテゴリ")
		SIF !MATCH(RESULTS, "Lv")
			CONTINUE
		TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_필드:{カウンタ}")}("レベル")
		攻撃力修正 = RESULT * 100

		CALL STATCHANGE_BASIC(듀얼리스트,"自身",カウンタ,攻撃力修正)
	NEXT
ELSEIF 종류 == 身代효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71064)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)

		CALL FULLRESET
		효과範囲필드 = 1
		효과条件任意 = 1
		효과条件カテゴリ = Lv
		효과条件固カテゴリ = 궁극체
		효과条件固名前 = 알카디몬 초궁극체
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		選択カード = RESULT
		取込カードID = GETVAR(@"%듀얼리스트%_필드:選択カード")
		IF 選択カード != 9999
			CALLFORM CARDNAME_{取込カードID}("略称")
			取込カード名称 = %RESULTS%
			PRINTFORMW %取込カード名称%は進化する！
			TRYCALLFORM CARDNAME_{取込カードID}("カテゴリ")
			IF MATCH(RESULTS, "OVER")
				CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"永星",2)
			ELSE
				取込カードID = 取込カードID + 100000

				CALL CARD_RECONSTRUCT(듀얼리스트,"필드",選択カード,取込カードID)
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	RETURN 0
ENDIF