#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 마법돌의 채굴
	CASE "略称"
		RESULTS = 마법돌의 채굴
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_71940(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
	CASE "추가日"
		RETURN 251130
ENDSELECT

RETURN 0

