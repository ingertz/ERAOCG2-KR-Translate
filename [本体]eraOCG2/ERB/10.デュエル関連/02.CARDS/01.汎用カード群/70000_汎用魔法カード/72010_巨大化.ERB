@CARDNAME_72010,参照先
;ココで지정 카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 거대화
	CASE "略称"
		RESULTS = 거대화
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_72010(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 装備마법
ENDSELECT

RETURN 0

@CARD_EXPLANATION_72010(종류)
#DIM DYNAMIC 종류

CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ①：자신의 LP가 상대보다 적을 경우 장착 몬스터의 공격력은 원래의 공격력의 배가 된다。
PRINTL 자신의 LP가 상대보다 많을 경우 장착 몬스터의 공격력은 원래의 공격력의 절반이 된다。
PRINTL 

@CARDCAN_72010(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72010)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	CALL FULLRESET
	효과範囲필드 = 1
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻守変動
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_72010(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者

#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIMS DYNAMIC 装備者
#DIM DYNAMIC 装備先

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL 装備판정(듀얼리스트,場所,ゾーン)
装備先 = RESULT	
装備者 = %RESULTS%


IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72010)
	IF RESULT == 0
		;패에서 발동 후、마법トラップ존에 カード이동
		CALL FULLRESET
		효과範囲필드 = 1
		CALLFORM CARD_EQUIP_ADV(듀얼리스트,場所,ゾーン)
	ENDIF
ELSEIF 종류 == 攻守変動
	CALLFORM CARD_{GETVAR(@"%装備者%_필드:装備先")}("攻撃力")

	攻撃力修正 = RESULT
	IF GETVAR(@"ライフ_%듀얼리스트%") > GETVAR(@"ライフ_%対面者%") 
		攻撃力修正 = -攻撃力修正 / 2
	ELSEIF GETVAR(@"ライフ_%듀얼리스트%") == GETVAR(@"ライフ_%対面者%") 
		攻撃力修正 = 0
	ENDIF
	CALL STATCHANGE_BASIC(듀얼리스트,"装備",場所,攻撃力修正)
ENDIF

