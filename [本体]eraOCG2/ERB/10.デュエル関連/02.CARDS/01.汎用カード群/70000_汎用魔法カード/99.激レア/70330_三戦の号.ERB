@CARDNAME_70330,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 삼전의 호
	CASE "略称"
		RESULTS = 삼전의 호
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_70330(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
	CASE "추가日"
		RETURN 251108
ENDSELECT

RETURN 0

@CARD_EXPLANATION_70330(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 카드는 １턴에 １장밖에 발동할 수 없다。
CALLFORM CARD_ABLE(0,마함起動 ,손패起動)
PRINTL ①：이 턴에 상대가 몬스터의 효과를 발동한 경우에 발동할 수 있다。
PRINTL 덱에서 "삼전의 호" 이외의 일반 마법 / 일반 함정 카드 １장을 자신 필드에 세트한다。
PRINTL 이 효과로 세트한 카드는 이 턴 발동할 수 없다。
PRINTL 상대 필드에 몬스터가 존재하는 경우, 세트하지 않고 패에 넣을 수도 있다。

@CARDCAN_70330(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 발동불가,10
#DIM DYNAMIC 条件달성

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,70330)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,70330)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GET_PLAYER_INFO(듀얼리스트,"モン발동数",1) == 0
		RETURN 0

	CALL FULLRESET
	효과範囲상대필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		条件달성 = 1

	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류:0 = 通常마법
	효과条件종류:1 = 通常함정
	SIF 条件달성 == 0
		효과条件セット = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_70330(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 발동불가,10
#DIM DYNAMIC 条件달성

IF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,70330,1)
	IF RESULT == 0
		;通常마법汎用処理
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)

		CALL FULLRESET
		효과範囲상대필드 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			PRINTFORML 덱에서 카드를……
			CALL YN_CHOICE(듀얼리스트,"패에 넣기","세트하기")
		ELSE
			RESULT = 1		
		ENDIF
		IF RESULT == 0
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件종류:0 = 通常마법
			효과条件종류:1 = 通常함정
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ELSEIF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件종류:0 = 通常마법
			효과条件종류:1 = 通常함정
			효과추가종류 = 530
			CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"裏側표시")
		ENDIF
	ENDIF
ENDIF
