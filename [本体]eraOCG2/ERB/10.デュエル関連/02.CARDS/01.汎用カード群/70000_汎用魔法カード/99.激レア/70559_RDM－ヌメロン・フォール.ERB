@CARDNAME_70559,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = RDM－누메론 폴
	CASE "略称"
		RESULTS = RDM FALL
	CASE "カテゴリ"
		RESULTS:0 = RUM
ENDSELECT


@CARD_70559(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
	CASE "추가日"
		RETURN 250927
ENDSELECT

RETURN 0

@CARD_EXPLANATION_70559(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,마함起動 ,손패起動)
PRINTL ①：자신 필드의 "Ｎｏ." X몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 선택한 몬스터보다 랭크가 낮은 몬스터 엑시즈 １장을、
PRINTL 대상의 몬스터 위에 겹쳐서 X소환 취급으로 EX덱에서 특수 소환한다。
PRINTL 이렇게 랭크１ X몬스터 이외를 특수 소환한 경우、그 카드의 효과는 턴 종료시까지 무효가 되며、
PRINTL 랭크１ X몬스터를 특수 소환한 경우、그 카드는 턴 종료시까지 완전 내성을 얻는다。


@CARDCAN_70559(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,70559)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,70559)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = 엑시즈
	효과条件カテゴリ = 넘버즈
	효과条件RUM = 70559
	효과条件重ねてＸ = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_70559(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 설정レベル

#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードB
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 소환先
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,70559,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		;通常마법汎用処理
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件종류 = 엑시즈
		효과条件カテゴリ = 넘버즈
		효과条件RUM = 70559
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			설정レベル = GETVAR(@"%듀얼리스트%_MZ_星:選択カード") - 1
			CALL FULLRESET
			효과条件종류 = 엑시즈
			CALL 효과条件レベル_ADV(설정レベル, "以下")
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
			選択カードB = RESULT
			;戻る
			IF 選択カードB != 9999
				選択カード_ID = RESULT:99
				TRYCALLFORM CARDSUMMON_{GETVAR(@"%듀얼리스트%_EX덱:{選択カードB}")}(듀얼리스트,選択カードB)

				CALL RESETCONDITION_MAT(1)
				代替素材数 = 1
				重ねてＸ = 1
				素材条件固定 = 選択カード
				TRYCALLFORM XYZSUMMON(듀얼리스트,選択カードB)
				소환先 = カード소환先
				TRYCALLFORM CARD_{選択カード_ID},"レベル"
				IF RESULT == 1
					CALL SET_FIELD_INFO(듀얼리스트,"필드",소환先,"モ耐",1,1)
					CALL SET_FIELD_INFO(듀얼리스트,"필드",소환先,"魔耐",1,1)
					CALL SET_FIELD_INFO(듀얼리스트,"필드",소환先,"함정耐",1,1)
				ELSE
					CALL SET_FIELD_INFO(듀얼리스트,"필드",소환先,"無効",1,1)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF


@CARDRUM_70559(듀얼리스트,ゾーン,場所,カードID)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カードID
#DIM DYNAMIC 설정カードID
#DIM DYNAMIC 素材レベル
VARSET RESULT

IF ゾーン == "필드"
	素材レベル = GETVAR(@"%듀얼리스트%_MZ_星:場所")
ELSE
	RETURN 0
ENDIF

FOR カウンタ,0,15
	설정カードID =  GETVAR(@"%듀얼리스트%_EX덱:カウンタ")
	SIF 설정カードID == -1 
		CONTINUE

	TRYCALLFORM CARD_{설정カードID}, "종류"
	SIF RESULT != 엑시즈
		CONTINUE
	TRYCALLFORM CARD_{설정カードID}, "レベル"
	SIF RESULT >= 素材レベル
		CONTINUE
	VARSET RESULT
	RETURN 1
NEXT