@CARDNAME_71018,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 금지된 성관
	CASE "略称"
		RESULTS = 금지된 성관
	CASE "カテゴリ"
		RESULTS:0 = 금지된
ENDSELECT


@CARD_71018(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
	CASE "レア度"
		RETURN SPR
	CASE "추가日"
		RETURN 251222
ENDSELECT

RETURN 0

@CARD_EXPLANATION_71018(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 카드는 １턴에 １장밖에 발동할 수 없으며、
PRINTL 이 카드의 효과의 발동에 대해서 상대는 효과를 발동할 수 없다。
CALLFORM CARD_ABLE(1,마함起動,손패起動,フリー誘発)
PRINTL ①：필드의 앞면 표시 몬스터 １장을 골라、턴 종료시까지 이하의 효과를 적용한다。
PRINTL 이 효과는 무차별 내성 이외의 영향을 받지 않는다。
PRINTL ●효과는 무효화된다。
PRINTL ●공격할 수 없다。
PRINTL ●전투 / 효과로는 파괴되지 않는다。
PRINTL ●완전 내성을 부여한다。
PRINTL ●어드밴스 소환 / 의식 소환을 위해 릴리스할 수 없다。
PRINTL ●융합 / Ｓ / Ｘ / Ｌ 소환의 소재로 할 수 없다。

@CARDCAN_71018(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,71018)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == チェーン可否
	SIF !GROUPMATCH(チェーン可否종류,마함起動,손패起動,フリー誘発)
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_71018(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71018)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲상대필드 = 1
		효과条件표시 = 表側표시
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 9999
			CALL CARD_SELECT(듀얼리스트,RESULT)
			選択カード = RESULT
			IF GETVAR(@"%대상者（CS）%_MZ_無差耐:選択カード") >= 1
				PRINTW 無差別耐性によって処理が行われませんでした
				RETURN 0
			ENDIF

			CALL SET_FIELD_INFO(대상者（CS）,"필드",選択カード,"無効",1)
			CALL SET_FIELD_INFO(대상者（CS）,"필드",選択カード,"戦無",1)
			CALL SET_FIELD_INFO(대상者（CS）,"필드",選択カード,"戦耐",1)
			CALL SET_FIELD_INFO(대상者（CS）,"필드",選択カード,"破耐",1)
			CALL SET_FIELD_INFO(대상者（CS）,"필드",選択カード,"モ耐",1)
			CALL SET_FIELD_INFO(대상者（CS）,"필드",選択カード,"魔耐",1)
			CALL SET_FIELD_INFO(대상者（CS）,"필드",選択カード,"함정耐",1)
			CALL SET_FIELD_INFO(대상者（CS）,"필드",選択カード,"不材",1)
		ENDIF
	ENDIF
ENDIF