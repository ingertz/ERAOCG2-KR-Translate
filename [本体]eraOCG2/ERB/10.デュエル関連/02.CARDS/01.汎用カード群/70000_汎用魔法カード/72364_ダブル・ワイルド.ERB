@CARDNAME_72364,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 더블 와일드
	CASE "略称"
		RESULTS = 더블 와일드
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_72364(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
	CASE "추가日"
		RETURN 251125
ENDSELECT

RETURN 0

@CARD_EXPLANATION_72364(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 카드는 １턴에 １장밖에 발동할 수 없다。
CALLFORM CARD_ABLE(0,마함起動,손패起動,フリー誘発)
PRINTL ①：자신 필드의 레벨５ 이하인 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 원래의 종족이 그 몬스터와 같은 레벨１０ 몬스터 １장을 덱에서 패에 넣는다。
PRINTL 그 후、이하의 효과를 적용할 수 있다。이 카드의 발동 후、턴 종료시까지 
PRINTL 자신은 원래의 종족이 대상 몬스터와 같은 몬스터밖에 특수 소환할 수 없다。
PRINTL ●이 효과로 넣은 몬스터와 같은 종족의 몬스터를 
PRINTL 패에서 수비 표시로 특수 소환하고、자신의 패를 １장 골라서 버린다。

@CARDCAN_72364(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72364)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 발동済_1(듀얼리스트,72364)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	CALLFORM 효과条件レベル_ADV(5,"以下")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_72364(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択종족

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72364,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		CALLFORM 효과条件レベル_ADV(5,"以下")
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT != 9999
			TRYCALLFORM CARD_{RESULT:99}("종족")
			選択종족 = RESULT
			CALL FULLRESET
			효과条件종족 = 選択종족
			효과条件レベル = 10
			CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲손패 = 1
				효과条件CNT = 1
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT >= 2
					CALL FULLRESET
					효과範囲손패 = 1
					효과条件종족 = 選択종족
					효과条件任意 = 1
					CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"守備표시")
					IF RESULT == 1
						CALL FULLRESET
						CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF