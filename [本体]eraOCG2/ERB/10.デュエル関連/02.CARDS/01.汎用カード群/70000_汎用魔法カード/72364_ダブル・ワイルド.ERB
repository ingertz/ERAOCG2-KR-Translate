@CARDNAME_72364,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 더블 와일드
	CASE "略称"
		RESULTS = 더블 와일드
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_72364(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
	CASE "추가日"
		RETURN 251125
ENDSELECT

RETURN 0

@CARD_EXPLANATION_72364(종류)
#DIM DYNAMIC 종류

PRINTL このカード名のカードは１ターンに１枚しか발동できない。
CALLFORM CARD_ABLE(0,마함起動,손패起動,フリー誘発)
PRINTL ①：자신フィールドのレベル５以下のモンスター１体を대상として발동できる。
PRINTL 元々の종족がそのモンスターと同じレベル１０モンスター１体を덱から손패に加える。
PRINTL その後、以下の효과を適用できる。このカードの발동後、ターン終了時まで
PRINTL 자신は元々の종족が대상のモンスターと同じモンスターしか특수소환できない。
PRINTL ●この효과で加えたモンスターと同じ종족のモンスターを
PRINTL 손패から守備표시で특수소환し、자신の손패を１枚選んで捨てる。

@CARDCAN_72364(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72364)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 발동済_1(듀얼리스트,72364)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	CALLFORM 효과条件レベル_ADV(5,"以下")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_72364(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択종족

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72364,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		CALLFORM 효과条件レベル_ADV(5,"以下")
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT != 9999
			TRYCALLFORM CARD_{RESULT:99}("종족")
			選択종족 = RESULT
			CALL FULLRESET
			효과条件종족 = 選択종족
			효과条件レベル = 10
			CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲손패 = 1
				효과条件CNT = 1
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT >= 2
					CALL FULLRESET
					효과範囲손패 = 1
					효과条件종족 = 選択종족
					효과条件任意 = 1
					CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"守備표시")
					IF RESULT == 1
						CALL FULLRESET
						CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF