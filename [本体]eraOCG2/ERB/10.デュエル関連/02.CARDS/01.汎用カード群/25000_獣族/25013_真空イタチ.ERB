@CARDNAME_25013,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 진공 족제비
	CASE "略称"
		RESULTS = 진공 족제비
	CASE "カテゴリ"
		RESULTS:0 = 없음
		RESULTS:1 = 리버스
ENDSELECT


@CARD_25013(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 야수족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 500
	CASE "守備力"
		RETURN 1500
	CASE "추가日"
		RETURN 260125
ENDSELECT
RETURN 0

@CARD_EXPLANATION_25013(종류)
#DIM DYNAMIC 종류

CALL CARD_ABLE(0, リバース誘発)
PRINTL ①：このカードがリバースした場合に발동できる。
PRINTL このターン、상대は마법・함정カードを발동できない。


@CARDCAN_25013(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트, 종류, ゾーン, 場所, 25013)
SIF RESULT == 1
	RETURN 0

IF 종류 == リバース誘発
	RETURN 1
ENDIF

@CARDEFFECT_25013(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

IF 종류 == リバース誘発
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 25013, 1)
	IF RESULT == 0
		CALL SET_PLAYER_INFO(듀얼리스트, "마함無効", 1, 1)
	ENDIF
ENDIF


