@CARDNAME_72537,参照先
;ココで지정 카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 졸음의 루닉
	CASE "略称"
		RESULTS = 졸음의 루닉
	CASE "カテゴリ"
		RESULTS:0 = 루닉
ENDSELECT


@CARD_72537(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
ENDSELECT

RETURN 0

@CARD_EXPLANATION_72537(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 카드는 1턴에 1장밖에 발동할 수 없다。
CALLFORM CARD_ABLE(1,마함起動 ,손패起動 ,フリー誘発)
PRINTL ①：이하의 효과에서 1개를 선택하고 발동할 수 있다。
PRINTL 이 카드의 발동 후, 다음 자신 배틀 페이즈를 스킵한다。
PRINTL ●필드의 앞면 표시 몬스터 1장을 대상으로 하고 발동할 수 있다。
PRINTL  이 턴에, 그 몬스터는 1번만 전투 / 효과로는 파괴되지 않으며, 공격할 수 없다。
PRINTL 그 후, 상대의 덱 위에서 카드를 3장 제외한다。
PRINTL ●엑스트라 덱에서 "루닉" 몬스터 1장을 특수 소환한다。（이 효과는 자신 필드에 융합, 싱크로, 엑시즈, 링크 몬스터가 존재하지 않을 경우에만 발동할 수 있다.）


@CARDCAN_72537(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72537)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 발동済_1(듀얼리스트,72537)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = EXモン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 1
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲상대필드 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT != 1
			RETURN 0
		ENDIF
	ENDIF
	RETURN 1
ENDIF

@CARDEFFECT_72537(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 選択カード
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72537,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件종류 = EXモン全般
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT != 1 && モンスター数(듀얼리스트) < 5
			CALL YN_CHOICE(듀얼리스트,"●엑스트라 덱에서 「루닉」 몬스터 1장을 특수 소환한다。","●몬스터를 선택하여 한번만 전투 / 효과로는 파괴되지 않으며、공격할 수 없다。")		
		ELSE
			RESULT = いいえ
		ENDIF
		IF RESULT == はい
			CALL FULLRESET
			효과範囲EX덱 = 1
			효과条件カテゴリ = 루닉
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ELSEIF RESULT == いいえ
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲상대필드 = 1
			CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)	
			選択カード = RESULT
			IF 選択カード != 9999
				CALL CARD_SELECT(듀얼리스트,選択カード)
				CALL SET_FIELD_INFO(대상者（CS）,"필드",選択カード（CS）,"一破",1)
				CALL SET_FIELD_INFO(대상者（CS）,"필드",選択カード（CS）,"戦無",1)
			ENDIF
			CALL CARD_DECK_DISPOSE(対面者,"덱",3,제외行き)
		ENDIF
		CALL SET_PLAYER_INFO(듀얼리스트,"バトルスキップ", 1)
	ENDIF
ENDIF