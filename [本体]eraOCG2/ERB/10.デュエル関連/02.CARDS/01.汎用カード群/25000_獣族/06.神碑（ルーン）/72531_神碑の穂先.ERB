@CARDNAME_72531,参照先
;ココで지정 카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 루닉의 날끝
	CASE "略称"
		RESULTS = 루닉의 날끝
	CASE "カテゴリ"
		RESULTS:0 = 루닉
ENDSELECT


@CARD_72531(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
ENDSELECT

RETURN 0

@CARD_EXPLANATION_72531(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 카드는 1턴에 1장밖에 발동할 수 없다。
CALLFORM CARD_ABLE(1,마함起動 ,손패起動 ,フリー誘発)
PRINTL ①：이하의 효과에서 1개를 선택하고 발동할 수 있다。
PRINTL 이 카드의 발동 후, 다음 자신 배틀 페이즈를 스킵한다。
PRINTL ●덱에서 "루닉의 날끝" 이외의 "루닉" 카드 1장을 패에 넣는다. 그 후, 상대의 덱 위에서 카드를 1장 제외한다。
PRINTL ●엑스트라 덱에서 "루닉" 몬스터 1장을 특수 소환한다。（이 효과는 자신 필드에 융합, 싱크로, 엑시즈, 링크 몬스터가 존재하지 않을 경우에만 발동할 수 있다.）


@CARDCAN_72531(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72531)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 발동済_1(듀얼리스트,72531)
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF

@CARDEFFECT_72531(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72531,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件종류 = EXモン全般
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT != 1 && モンスター数(듀얼리스트) < 5
			CALL YN_CHOICE(듀얼리스트,"●엑스트라 덱에서 「루닉」 몬스터 1장을 특수 소환한다。","●덱에서 「루닉의 날끝」 이외의 「루닉」 카드 1장을 패에 넣는다。")
		ELSE
			RESULT = いいえ
		ENDIF
		IF RESULT == はい
			CALL FULLRESET
			효과範囲EX덱 = 1
			효과条件カテゴリ = 루닉
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ELSEIF RESULT == いいえ
			CALL FULLRESET
			효과条件カテゴリ = 루닉
			효과条件固名前 = 루닉의 날끝
			CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所)
			CALL CARD_DECK_DISPOSE(対面者,"덱",1,제외行き)
		ENDIF
		CALL SET_PLAYER_INFO(듀얼리스트,"バトルスキップ", 1)
	ENDIF
ENDIF