@CARDNAME_1674,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 사이코 헬스트랜서
	CASE "略称"
		RESULTS = 헬스트랜서
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_1674(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 사이킥족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 2400
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251225
ENDSELECT

RETURN 0

@CARD_EXPLANATION_1674(종류)
#DIM DYNAMIC 종류

PRINTL 튜너＋튜너以外のモンスター１体以上
CALLFORM CARD_ABLE(0,EX소환時,특수소환時,ターン終了時)
PRINTL ①：このカードが특수소환した場合、またはエンドフェイズに발동できる。
PRINTL 자신の묘지のモンスター１体を제외し、자신は１２００ＬＰ회복する。
PRINTL この효과で사이킥족モンスターを제외した場合、さらに자신はそのモンスターのコスト×４００ＬＰ회복する。
PRINTL （コストｘはレベル・ランク・링크ｘを指す）
CALLFORM CARD_ABLE(10,필드起動,フリー誘発)
PRINTL ②：お互いのターンに１度、以下の효과から１つを選択して발동できる。
PRINTL ●１０００ＬＰを払い、상대フィールドのカード１枚を破壊する。
PRINTL ●자신フィールドのモンスター１体の攻撃力分のＬＰを失い、そのモンスターの攻撃力をターン終了時まで倍にする。
PRINTL 　（この효과はバトルフェイズにのみ選択できる）


@CARDSUMMON_1674(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要レベル数 = 7
IF EX参照 == 0 || EX参照 == 1
	素材条件튜너 = 1
ELSEIF EX参照 >= 10
	素材条件튜너 = -1
ENDIF

IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,1674) 
	RETURN RESULT
ENDIF


@CARDCAN_1674(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 발동불가,2
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,1674)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX소환時 || 종류 == 특수소환時 || 종류 == ターン終了時
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0

	SIF GETVAR(@"ライフ_%듀얼리스트%") < 1000
		발동불가:0 = 1
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 묘지
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1

	SIF バトルフェイズ != 1
		발동불가:1 = 1
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件攻撃力 = GETVAR(@"ライフ_%듀얼리스트%") - 1
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:1 = 1

	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_1674(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 발동불가,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX소환時 || 종류 == 특수소환時 || 종류 == ターン終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1674)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			選択カード_ID = RESULT:1
			CALL LIFE_CHANGE(듀얼리스트,"増加","효과",1200)
			TRYCALLFORM CARD_{選択カード_ID},"종족"
			IF MATCH(RESULT,사이킥족)
				TRYCALLFORM CARD_{選択カード_ID},"レベル"
				CALL LIFE_CHANGE(듀얼리스트,"増加","효과",RESULT*400)
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1674,10)
	IF RESULT == 0
		SIF GETVAR(@"ライフ_%듀얼리스트%") < 1000
			발동불가:0 = 1
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		효과条件除去種 = 묘지
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:0 = 1

		SIF バトルフェイズ != 1
			발동불가:1 = 1
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件攻撃力 = GETVAR(@"ライフ_%듀얼리스트%") - 1
		효과条件표시 = 表側표시
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:1 = 1
		
		IF 발동불가:0 == 1 && 발동불가:1 == 1
			CALL YN_CHOICE(듀얼리스트,"●最古式念導","●才呼粉身")
		ELSEIF 발동불가:0 == 1
			RESULT = 0
		ELSEIF 발동불가:1 == 1
			RESULT = 1
		ENDIF

		IF RESULT == 0
			CALL LIFE_CHANGE(듀얼리스트,"減少","コスト",1000)
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과範囲상대마함 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,ゾーン,場所)

		ELSEIF RESULT == 1
			CALL FULLRESET
			효과条件攻撃力 = GETVAR(@"ライフ_%듀얼리스트%") - 1
			효과条件표시 = 表側표시
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
			IF RESULT != 9999
				選択カード = RESULT
				攻撃力修正 = GETVAR(@"%듀얼리스트%_MZ_攻:選択カード")
				CALL LIFE_CHANGE(듀얼리스트,"減少","コスト",攻撃力修正)
				CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"一攻",攻撃力修正)
			ENDIF
		ENDIF
	ENDIF
ENDIF



