@CARDNAME_51664,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 아캐나이트 매지션/버스터
	CASE "略称"
		RESULTS = 아캐나이트/B
	CASE "カテゴリ"
		RESULTS:0 = 버스터
		RESULTS:1 = /버스터
		RESULTS:2 = 마력카운터
ENDSELECT


@CARD_51664(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 900
	CASE "守備力"
		RETURN 2300
	CASE "특수불가"
		RETURN 1
	CASE "추가日"
		RETURN 251026
ENDSELECT

RETURN 0

@CARD_EXPLANATION_51664(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드는 특수 소환할 수 없으며、"버스터 모드"의 효과로만 특수 소환할 수 있다。

CALLFORM CARD_ABLE(0,특수소환時,ターン開始時)
PRINTL ①：이 카드가 특수 소환에 성공한 경우、또는 자신 턴의 스탠바이 페이즈에 발동할 수 있다。
PRINTL 이 카드에 마력카운터를 ２개 놓는다。
CALLFORM CARD_ABLE(0,필드起動)
PRINTL ②：자신 필드의 마력카운터를 １개 제거하는것으로 발동할 수 있다。
PRINTL 상대 필드 위의 카드를 전부 파괴한다。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ③：이 카드의 공격력은 、이 카드에 놓여있는 마력카운터의 수×１０００포인트 오른다。
CALLFORM CARD_ABLE(0,戦闘→묘지 ,破壊→묘지)
PRINTL ④：이 카드가 파괴되었을 때에 발동할 수 있다。
PRINTL 묘지에서 "아캐나이트 매지션" １장을 특수 소환한다。


@CARDSUMMON_51664(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
RETURN 0
IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,51664) 
	RETURN RESULT
ENDIF


@CARDCAN_51664(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 발동불가,2
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,51664)
SIF RESULT == 1
	RETURN 0

IF 종류 == 특수소환時
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲상대묘지 = 1
	효과条件종류 = モン全般
	효과条件종족 = 언데드족
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン開始時
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_魔Ｃ:場所") == 0
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件名前 = 아캐나이트 매지션
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_51664(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 발동불가,2
#DIM DYNAMIC 攻撃力修正
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 특수소환時 || 종류 == ターン開始時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51664)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"魔Ｃ",2)
	ENDIF

ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51664)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과条件魔Ｃ所持 = 999
		CALL CARD_GRANT_ADV(듀얼리스트,ゾーン,場所,"魔Ｃ",-1)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과範囲상대마함 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"묘지")
		ENDIF
	ENDIF
ELSEIF 종류 == 攻守変動
	攻撃力修正 = GETVAR(@"%듀얼리스트%_MZ_魔Ｃ:場所") * 1000
	CALL STATCHANGE_BASIC(듀얼리스트,"自身",場所,攻撃力修正)	
ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51664)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 아캐나이트 매지션
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF