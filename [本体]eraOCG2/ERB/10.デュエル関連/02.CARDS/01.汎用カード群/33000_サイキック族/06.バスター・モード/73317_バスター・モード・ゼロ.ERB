@CARDNAME_73317,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 버스터 모드 제로
	CASE "略称"
		RESULTS = Ｂ 모드 ０
	CASE "カテゴリ"
		RESULTS:0 = 버스터
ENDSELECT


@CARD_73317(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
	CASE "추가日"
		RETURN 251026
ENDSELECT

RETURN 0

@CARD_EXPLANATION_73317(종류)
#DIM DYNAMIC 종류
PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,마함起動,손패起動,フリー誘発)
PRINTL ①：자신フィールドのSモンスター１体をリリースして발동できる。
PRINTL そのモンスターのカード名が含まれる「/버스터」モンスター１体を、
PRINTL 「버스터 모드」による특수소환扱いとしてEX덱から특수소환する。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②：자신メインフェイズに묘지のこのカードを제외して발동できる。
PRINTL 손패・덱から「버스터 모드」１枚を選んで자신の마법＆함정ゾーンにセットする。
PRINTL この효과でセットしたカードはセットしたターンでも발동できる。

@CARDCAN_73317(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,73317)
SIF RESULT == 1
	RETURN 0


IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
;	SIF 紋章済(듀얼리스트,73315) != 0
;		효과範囲EX덱 = 1
	효과条件名前:0 = スターダスト・ドラゴン
	효과条件名前:1 = レッド・デーモンズ・ドラゴン
	효과条件名前:2 = ギガンテック・ファイター
	효과条件名前:3 = 아캐나이트 매지션
	효과条件名前:4 = 크림즌 블레이더
	효과条件名前:5 = 하이퍼 사이코거너
	효과条件名前:6 = TG 할버드 캐논
	효과条件名前:7 = 데스카이저 드래곤
	효과条件名前:8 = 정크 워리어
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF 발동済_2(듀얼리스트,73317)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과条件名前 = 버스터 모드
	효과条件セット = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_73317(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 選択名前
#DIM DYNAMIC 紋章場所


IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73317,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)

		CALL FULLRESET
		효과範囲필드 = 1
;		SIF 紋章済(듀얼리스트,73315) != 0
;			효과範囲EX덱 = 1
		효과条件名前:0 = スターダスト・ドラゴン
		효과条件名前:1 = レッド・デーモンズ・ドラゴン
		효과条件名前:2 = ギガンテック・ファイター

		효과条件名前:3 = 아캐나이트 매지션
		효과条件名前:4 = 크림즌 블레이더
		효과条件名前:5 = 하이퍼 사이코거너
		효과条件名前:6 = TG 할버드 캐논
		효과条件名前:7 = 데스카이저 드래곤
		효과条件名前:8 = 정크 워리어
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALLFORM CARDNAME_{RESULT:1}("名前")
			選択名前 = %RESULTS%
			CALL FULLRESET
			효과範囲EX덱 = 1
			SELECTCASE 選択名前
			CASE "スターダスト・ドラゴン"
				효과条件名前 = スターダスト・ドラゴン/버스터
			CASE "レッド・デーモンズ・ドラゴン"
				효과条件名前 = レッド・デーモンズ・ドラゴン/버스터
			CASE "ギガンテック・ファイター"
				효과条件名前 = ギガンテック・ファイター/버스터
			CASE "크림즌 블레이더"
				효과条件名前 = 크림즌 블레이더/버스터
			CASE "아캐나이트 매지션"
				효과条件名前 = 아캐나이트 매지션/버스터
			CASE "하이퍼 사이코거너"
				효과条件名前 = 하이퍼 사이코거너/버스터
			CASE "TG 할버드 캐논"
				효과条件名前 = TG 할버드 캐논/버스터
			CASE "데스카이저 드래곤"
				효과条件名前 = 데스카이저 드래곤/버스터
			CASE "정크 워리어"
				효과条件名前 = 정크 워리어/버스터
			ENDSELECT
			효과条件特不無視 = 1
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"攻撃표시")		
			CALL CARD_GET_EMBLEM_VALUES(듀얼리스트,73315)
			紋章場所 = RESULT
			SIF 紋章場所 != -1
				SETVAR @"%듀얼리스트%_永紋章:紋章場所", -1
		ENDIF
	ENDIF
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73317,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲덱 = 1
		효과条件名前 = 버스터 모드
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"使化裏側표시")
	ENDIF
ENDIF