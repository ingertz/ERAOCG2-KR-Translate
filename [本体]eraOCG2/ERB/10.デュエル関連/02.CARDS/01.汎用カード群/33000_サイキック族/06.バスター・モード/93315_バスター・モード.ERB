@CARDNAME_93315,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 버스터 모드
	CASE "略称"
		RESULTS = 버스터 모드
	CASE "カテゴリ"
		RESULTS:0 = 버스터
ENDSELECT


@CARD_93315(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
ENDSELECT

RETURN 0

@CARD_EXPLANATION_93315(종류)
#DIM DYNAMIC 종류
CALLFORM CARD_ABLE(0,마함起動 ,フリー誘発)
PRINTL ①: 자신 필드의 싱크로 몬스터 1장을 릴리스하고 발동할 수 있다.
PRINTL 그 몬스터의 카드명에 포함되는 "/버스터" 몬스터 1장을 EX덱에서 공격 표시로 특수 소환한다.
PRINTL 
PRINTL 

@CARDCAN_93315(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,93315)
SIF RESULT == 1
	RETURN 0
IF 종류 == 마함起動 || 종류 == フリー誘発
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	CALL FULLRESET
	효과範囲필드 = 1
	SIF 紋章済(듀얼리스트,73315) != 0
		효과範囲EX덱 = 1
	효과条件名前:0 = 스타더스트 드래곤
	효과条件名前:1 = 레드 데몬즈 드래곤
	효과条件名前:2 = 기간테크 파이터
	효과条件名前:3 = 아캐나이트 매지션
	효과条件名前:4 = 크림즌 블레이더
	효과条件名前:5 = 하이퍼 사이코거너
	효과条件名前:6 = TG 할버드 캐논
	효과条件名前:7 = 데스카이저 드래곤
	효과条件名前:8 = 정크 워리어
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_93315(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード,5
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC 選択名前
#DIM DYNAMIC 紋章場所
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,93315)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		
		CALL FULLRESET
		효과範囲필드 = 1
		SIF 紋章済(듀얼리스트,73315) != 0
			효과範囲EX덱 = 1
		효과条件名前:0 = 스타더스트 드래곤
		효과条件名前:1 = 레드 데몬즈 드래곤
		효과条件名前:2 = 기간테크 파이터

		효과条件名前:3 = 아캐나이트 매지션
		효과条件名前:4 = 크림즌 블레이더
		효과条件名前:5 = 하이퍼 사이코거너
		효과条件名前:6 = TG 할버드 캐논
		효과条件名前:7 = 데스카이저 드래곤
		효과条件名前:8 = 정크 워리어
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT == 1
			CALLFORM CARDNAME_{RESULT:1}("名前")
			選択名前 = %RESULTS%
			CALL FULLRESET
			효과範囲EX덱 = 1
			SELECTCASE 選択名前
			CASE "스타더스트 드래곤"
				효과条件名前 = 스타더스트 드래곤/버스터
			CASE "레드 데몬즈 드래곤"
				효과条件名前 = 레드 데몬즈 드래곤/버스터
			CASE "기간테크 파이터"
				효과条件名前 = 기간테크 파이터/버스터
			CASE "크림즌 블레이더"
				효과条件名前 = 크림즌 블레이더/버스터
			CASE "아캐나이트 매지션"
				효과条件名前 = 아캐나이트 매지션/버스터
			CASE "하이퍼 사이코거너"
				효과条件名前 = 하이퍼 사이코거너/버스터
			CASE "TG 할버드 캐논"
				효과条件名前 = TG 할버드 캐논/버스터
			CASE "데스카이저 드래곤"
				효과条件名前 = 데스카이저 드래곤/버스터
			CASE "정크 워리어"
				효과条件名前 = 정크 워리어/버스터
			ENDSELECT
			효과条件特不無視 = 1
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"攻撃표시")	
			CALL CARD_GET_EMBLEM_VALUES(듀얼리스트,73315)
			紋章場所 = RESULT
			SIF 紋章場所 != -1
				SETVAR @"%듀얼리스트%_永紋章:紋章場所", -1	
		ENDIF
	ENDIF
ENDIF
