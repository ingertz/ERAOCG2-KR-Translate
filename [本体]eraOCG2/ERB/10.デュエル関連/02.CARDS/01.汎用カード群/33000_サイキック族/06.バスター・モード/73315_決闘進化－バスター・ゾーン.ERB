@CARDNAME_73315,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 결투진화－버스터 존
	CASE "略称"
		RESULTS = 버스터 존
	CASE "カテゴリ"
		RESULTS:0 = 버스터
ENDSELECT


@CARD_73315(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN フィールド
	CASE "추가日"
		RETURN 251026
ENDSELECT

RETURN 0

@CARD_EXPLANATION_73315(종류)
#DIM DYNAMIC 종류

PRINTL 자신フィールドは「버스터 존」となる。
PRINTL 이 카드명의 カードは１ターンに１枚しか발동できず、이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：このカードの발동時の효과処理として、
PRINTL 덱から「버스터」モンスター１体を손패に加える事ができる。
CALLFORM CARD_ABLE(2,지속효과)
PRINTL ②：「버스터」モンスターは특수소환されたターンには戦闘・破壊耐性を得る。
CALLFORM CARD_ABLE(0,ターン終了時)
PRINTL ③：２０００LPを払って발동できる。
PRINTL このターンに１度だけ、자신が「버스터 모드」を발동するためにリリースするSモンスターをEX덱から選ぶ事ができる。

@CARDCAN_73315(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,73315)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 발동済_3(듀얼리스트,73315)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,73315)
		RETURN 0
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_73315(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件달성
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73315,3)
	IF RESULT == 0
		CALL LIFE_CHANGE(듀얼리스트,"減少","コスト",2000)
		CALL CARD_RESERV(듀얼리스트,73315,短紋章予約)
	ENDIF
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73315,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 버스터
		효과条件종류 = モン全般
		효과条件任意 = 1
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 지속효과
	CALL SET_FIELD_MAGIC_INFO(듀얼리스트,"버스터 존")

	CALL FULLRESET
	효과条件カテゴリ = 버스터
	효과条件T1召種 = 召種全특수
	CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"戦耐")
	CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"破耐")
ENDIF
