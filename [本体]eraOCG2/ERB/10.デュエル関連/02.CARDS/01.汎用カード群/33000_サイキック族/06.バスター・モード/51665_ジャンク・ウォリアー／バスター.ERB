@CARDNAME_51665,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 정크 워리어/버스터
	CASE "略称"
		RESULTS = JUNK W/B
	CASE "カテゴリ"
		RESULTS:0 = 정크
		RESULTS:1 = 워리어
		RESULTS:2 = 버스터
		RESULTS:3 = /버스터
ENDSELECT


@CARD_51665(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 2800
	CASE "守備力"
		RETURN 1800
	CASE "특수불가"
		RETURN 1
	CASE "추가日"
		RETURN 251026
ENDSELECT

RETURN 0

@CARD_EXPLANATION_51665(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드는 특수 소환할 수 없으며、"버스터 모드"의 효과로만 특수 소환할 수 있다。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ①：이 카드의 공격력은、자신 필드의 "버스터" 몬스터의 수×１０００ 오르고、
PRINTL 이 카드가 몬스터와의 전투로 상대에게 주는 전투 데미지는 두배가 된다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：필드의 이 카드는 상대가 발동한 몬스터의 효과를 받지 않는다。
CALLFORM CARD_ABLE(0,戦闘→묘지 ,破壊→묘지)
PRINTL ③：이 카드가 파괴되었을 때에 발동할 수 있다。
PRINTL 묘지에서 "정크 워리어" １장을 특수 소환한다。


@CARDSUMMON_51665(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
RETURN 0
IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,51665) 
	RETURN RESULT
ENDIF


@CARDCAN_51665(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 발동불가,2
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,51665)
SIF RESULT == 1
	RETURN 0

IF 종류 == 攻守変動 || 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件名前 = 정크 워리어
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻撃時強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_51665(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 발동불가,2
#DIM DYNAMIC 攻撃力修正
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 攻守変動
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 버스터
	효과条件종류 = 싱크로
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	攻撃力修正 = RESULT * 1000
	CALL STATCHANGE_BASIC(듀얼리스트,"自身",場所,攻撃力修正)	
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_HAND(듀얼리스트,"自身",場所,"モン耐")
ELSEIF 종류 == 攻撃時強制誘発
	CALL SET_PLAYER_INFO(듀얼리스트,"ダメージ倍化",3,1)
ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51665)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 정크 워리어
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF