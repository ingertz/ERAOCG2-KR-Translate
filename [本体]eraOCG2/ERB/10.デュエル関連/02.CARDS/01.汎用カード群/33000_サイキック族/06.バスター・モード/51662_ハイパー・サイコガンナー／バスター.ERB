@CARDNAME_51662,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 하이퍼 사이코거너/버스터
	CASE "略称"
		RESULTS = 사이코건/B
	CASE "カテゴリ"
		RESULTS:0 = 버스터
		RESULTS:1 = /버스터
ENDSELECT


@CARD_51662(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 사이킥족
	CASE "レベル"
		RETURN 11
	CASE "攻撃力"
		RETURN 3500
	CASE "守備力"
		RETURN 3000
	CASE "특수불가"
		RETURN 1
	CASE "추가日"
		RETURN 251026
ENDSELECT

RETURN 0

@CARD_EXPLANATION_51662(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드는 특수 소환할 수 없으며、"버스터 모드"의 효과로만 특수 소환할 수 있다。

CALLFORM CARD_ABLE(0,필드起動)
PRINTL ①：５００LP를 지불하고、상대 필드의 카드 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 카드를 제외한다。
CALLFORM CARD_ABLE(2,지속효과)
PRINTL ②：이 카드는 관통 공격을 가지며、상대 라이프에 데미지를 준 경우、
PRINTL 그 수치만큼 회복하고、상대에게 자신과 상대의 라이프의 차이만큼 데미지를 준다。
CALLFORM CARD_ABLE(0,戦闘→묘지 ,破壊→묘지)
PRINTL ③：이 카드가 파괴되었을 때에 발동할 수 있다。
PRINTL 묘지에서 "하이퍼 사이코거너" １장을 특수 소환한다。

@CARDSUMMON_51662(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
RETURN 0
IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,51662) 
	RETURN RESULT
ENDIF


@CARDCAN_51662(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 발동불가,2
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,51662)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動
	SIF ゾーン != "필드"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"ライフ_%듀얼리스트%") <= 500
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == ライフ変強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF ダメージ受者 == 듀얼리스트
		RETURN 0
	SIF !GROUPMATCH(ダメージ종류,"戦闘", "直接戦闘")
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件名前 = 하이퍼 사이코거너
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_51662(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 발동불가,2
#DIM DYNAMIC 효과ダメージ
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51662)
	IF RESULT == 0
		CALL LIFE_CHANGE(듀얼리스트,"減少","コスト",500)
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"全場単体",場所,"제외")
	ENDIF
ELSEIF 종류 == ライフ変強制誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51662)
	IF RESULT == 0
		CALL LIFE_CHANGE(듀얼리스트,"増加","효과",ダメージ受値)
		IF GETVAR(@"ライフ_%듀얼리스트%") > GETVAR(@"ライフ_%対面者%")
			효과ダメージ = GETVAR(@"ライフ_%듀얼리스트%") - GETVAR(@"ライフ_%対面者%")
		ELSE
			효과ダメージ = GETVAR(@"ライフ_%対面者%") - GETVAR(@"ライフ_%듀얼리스트%")
		ENDIF
		CALL LIFE_CHANGE(듀얼리스트,"減少","효과",효과ダメージ,1)
	ENDIF
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"貫通")
ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51662)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 하이퍼 사이코거너
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF



