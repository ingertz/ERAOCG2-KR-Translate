@CARDNAME_56002,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 영락제화－페리얼리스
	CASE "略称"
		RESULTS = 페리얼리스
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_56002(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 식물족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 1600
	CASE "守備力"
		RETURN 2400
	CASE "성별"
		RETURN 牝性
ENDSELECT

RETURN 0

@CARD_EXPLANATION_56002(종류)
#DIM DYNAMIC 종류

PRINTL 튜너＋튜너 이외의 몬스터 １장以上
PRINTL 이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0, 攻守変動)
PRINTL ①：이 카드의 공격력은、자신 필드의 다른 식물족 몬스터의 수×４００오른다。
CALLFORM CARD_ABLE(2, 필드起動)
PRINTL ②：자신메인 페이즈에 발동할 수 있다。
PRINTL "영락제화－페리얼리스"를 제외한、레벨５ 이상인 식물족 몬스터 １장을 자신의 패 / 묘지에서 수비 표시로 특수 소환한다。


@CARDSUMMON_56002(듀얼리스트, 소환カード, EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要レベル数 = 7
IF EX参照 == 0 || EX参照 == 1
	素材条件튜너 = 1
ELSEIF EX参照 >= 10
	素材条件튜너 = -1
ENDIF

IF EX参照 == 1
	CALL SYNCAN(듀얼리스트, 소환カード, 56002) 
	RETURN RESULT
ENDIF


@CARDCAN_56002(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트, 종류, ゾーン, 場所, 56002)
SIF RESULT == 1
	RETURN 0

IF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종족 = 식물족
	효과条件표시 = 表側표시
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트, 56002)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲묘지 = 1
	효과条件종족 = 식물족
	효과条件소환可 = 1
	CALL 효과条件レベル_ADV(5, "以上")
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	
	RETURN 1
ENDIF

@CARDEFFECT_56002(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 攻守変動
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종족 = 식물족
	효과条件표시 = 表側표시
	효과条件他所 = 1
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	攻撃力修正 = RESULT * 400
	
	CALL FULLRESET
	CALL STATCHANGE_BASIC(듀얼리스트, "自身", 場所, 攻撃力修正)
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트, 종류, ゾーン, 場所, 56002, 2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲묘지 = 1
		효과条件종족 = 식물족
		CALL 효과条件レベル_ADV(5, "以上")
		CALL CARD_SP_SUMMON_ADV(듀얼리스트, ゾーン, 場所, "守備표시")
	ENDIF
ENDIF



