@CARDNAME_50868,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 패왕폭룡 스타브 베놈 윙 드래곤
	CASE "略称"
		RESULTS = 패왕폭룡ＳＶＷＤ
	CASE "カテゴリ"
		RESULTS:0 = 베놈
ENDSELECT


@CARD_50868(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 3300
	CASE "守備力"
		RETURN 2500
	CASE "성별"
		RETURN 雄性
	CASE "分割"
		RETURN 펜듈럼
	CASE "추가日"
		RETURN 260124
ENDSELECT

RETURN 0

@CARDSUMMON_50868(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材条件종류 = 융합
ELSEIF EX参照 >= 10
	素材条件カテゴリ = 클리어윙
ENDIF

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,50868) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_50868(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("FUSE_P_MAGIC")
CALLFORM CARD_ABLE(0,효과後強制誘発)
PRINTL ①：このカードが마법＆함정ゾーンに表側표시で存在する限り、
PRINTL 상대がモンスターを특수소환する度に、そのモンスターに悪性カウンターを１つ置き、
PRINTL レベルを１にする。
CALL TEXT_DECORATION("FUSE_P_MAGIC_2")
PRINTL 융합モンスター＋「클리어윙」モンスター
PRINTL このカード名の①の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,효과後誘発)
PRINTL ①：상대がモンスターを특수소환した場合に발동できる。
PRINTL ターン終了時まで、そのモンスターの攻撃力分だけこのカードの攻撃力をアップし、
PRINTL そのモンスターの효과は無効化される。
CALLFORM CARD_ABLE(10,발동誘発)
PRINTL ②：１ターンに１度、このカード以外のカードの효과が손패・フィールドで발동した時に발동できる。
PRINTL フィールドのカード１枚を破壊する。
CALLFORM CARD_ABLE(0,戦破壊→묘지)
PRINTL ③：モンスターゾーンのこのカードが破壊された場合に발동できる。
PRINTL このカードを자신の마법＆함정ゾーンに表側표시で置く。


@CARDCAN_50868(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 효과先
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50868)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과後強制誘発
	SIF ゾーン != "마함"
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환",1)
	SIF RESULT != 1
		RETURN 0
	효과先 = FINAL_SUMMON_TARGET(듀얼리스트,1)
	SIF GETVAR(@"%対面者%_MZ_モ耐:효과先") > 0
		RETURN 0
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF 발동済_1(듀얼리스트,50868)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환",1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲손패 = 1
	효과条件他所 = 1
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	;상대フィールドにカードがある時に발동するようにルーチン調整
	RETURN 1
ELSEIF 종류 == 戦破壊→묘지
	SIF 발동済_2(듀얼리스트,50868)
		RETURN 0
	SIF !GROUPMATCH(묘지送り종류,"破壊","戦闘破壊")
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_50868(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 選択カード_攻
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 효과後強制誘発
	選択カード = FINAL_SUMMON_TARGET(듀얼리스트,1)
	CALL SET_FIELD_INFO(対面者,"필드",選択カード,"悪Ｃ",1)
	CALL SET_FIELD_INFO(対面者,"필드",選択カード,"永星",1,1)
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50868,1)
	IF RESULT == 0
		選択カード = FINAL_SUMMON_TARGET(듀얼리스트,1)
		選択カード_ID = GETVAR(@"%対面者%_필드:選択カード")
		選択カード_攻 = GETVAR(@"%対面者%_MZ_攻:選択カード")
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"一攻",選択カード_攻)
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"自動処理",選択カード,"지속無効")
	ENDIF
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50868,10)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
	ENDIF
ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50868)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件名前 = 패왕폭룡 스타브 베놈 윙 드래곤
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"表側표시")
	ENDIF
ENDIF