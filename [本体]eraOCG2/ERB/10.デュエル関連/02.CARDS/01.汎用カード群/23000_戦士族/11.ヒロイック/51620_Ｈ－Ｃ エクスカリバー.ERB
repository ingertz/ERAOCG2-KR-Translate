@CARDNAME_51620,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = Ｈ－Ｃ　엑스칼리버
	CASE "略称"
		RESULTS = HC엑스칼리버
	CASE "カテゴリ"
		RESULTS:0 = 히로익
ENDSELECT


@CARD_51620(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 2000
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251003
ENDSELECT

RETURN 0

@CARDSUMMON_51620(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 4
素材条件종족 = 전사족
;추가효과用

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,51620) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_51620(종류)
#DIM DYNAMIC 종류

PRINTL 전사족レベル４モンスター×２
PRINTL このカード名の③の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(10,필드起動)
PRINTL ①：１ターンに１度、このカードのＸ素材を２つ取り除いて발동できる。
PRINTL このカードの攻撃力は상대ターン終了時まで倍になる。
CALLFORM CARD_ABLE(0,필드起動,フリー誘発)
PRINTL ②：このカードのＸ素材が１つ以下の場合、자신・상대のメインフェイズに발동できる。
PRINTL 자신フィールドの他の表側표시モンスター１体に、このカードを攻撃力・守備力２０００アップの装備カード扱いで装備する。
CALLFORM CARD_ABLE(0,묘지起動)
PRINTL ③：このカードが묘지に存在する場合、자신の묘지からこのカード名以外の전사족モンスター３体を대상として발동できる。
PRINTL そのカードを덱に戻し、묘지のこのカードをＥＸ덱に戻す。

@CARDCAN_51620(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,51620)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動 && GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") >= 1
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") >= 1
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件표시 = 表側표시
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	IF 듀얼리스트 != "자신"
		SIF GETVAR(@"%듀얼리스트%_MZ_攻:場所") > 2000
			RETURN 0
	ENDIF
	RETURN 1

ELSEIF 종류 == 묘지起動
	SIF 발동済_3(듀얼리스트,51620)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종족 = 전사족
	효과条件종류 = モン全般
	효과条件CNT = 1
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 3
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_51620(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動 && GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") >= 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51620,10,X消費2)
	IF RESULT == 0
		攻撃力修正 = GETVAR(@"%듀얼리스트%_MZ_攻:場所")
		CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"二攻",攻撃力修正)
	ENDIF

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51620)
	IF RESULT == 0
		CALL FULLRESET
		효과条件표시 = 表側표시
		효과条件他所 = 1
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			CALL CARD_EQUIP_MONSTER(듀얼리스트,場所,ゾーン,選択カード,3)
		ENDIF
	ENDIF

ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51620,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종족 = 전사족
		효과条件종류 = モン全般
		효과条件複数 = 3
		효과条件他所 = 1
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件名前 = Ｈ－Ｃ　엑스칼리버
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF