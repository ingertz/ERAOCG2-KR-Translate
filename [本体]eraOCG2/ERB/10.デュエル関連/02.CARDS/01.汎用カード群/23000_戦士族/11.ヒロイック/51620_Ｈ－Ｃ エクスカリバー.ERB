@CARDNAME_51620,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = Ｈ－Ｃ 엑스칼리버
	CASE "略称"
		RESULTS = HC엑스칼리버
	CASE "カテゴリ"
		RESULTS:0 = 히로익
ENDSELECT


@CARD_51620(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 2000
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251003
ENDSELECT

RETURN 0

@CARDSUMMON_51620(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 4
素材条件종족 = 전사족
;추가효과用

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,51620) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_51620(종류)
#DIM DYNAMIC 종류

PRINTL 전사족 레벨４ 몬스터×２
PRINTL 이 카드명의 ③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(10,필드起動)
PRINTL ①：１턴에 １번、이 카드의 Ｘ소재를 ２개 제거하고 발동할 수 있다。
PRINTL 이 카드의 공격력은 상대턴 종료시 까지 배가된다。
CALLFORM CARD_ABLE(0,필드起動,フリー誘発)
PRINTL ②：이 카드의 Ｘ소재가 １개 이하인 경우、자신 / 상대의 메인 페이즈에 발동할 수 있다。
PRINTL 자신 필드의 다른 앞면 표시 몬스터 １장에게、이 카드를 공격력 / 수비력 ２０００올려주는 장착 카드 취급으로 장착한다。
CALLFORM CARD_ABLE(0,묘지起動)
PRINTL ③：이 카드가 묘지에 존재하는 경우、자신의 묘지에서 이 카드명 이외의 전사족 몬스터 ３장을 대상으로 하고 발동할 수 있다。
PRINTL 그 카드를 덱으로 되돌리고、묘지의 이 카드를 ＥＸ덱으로 되돌린다。

@CARDCAN_51620(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,51620)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動 && GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") >= 1
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") >= 1
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件표시 = 表側표시
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	IF 듀얼리스트 != "자신"
		SIF GETVAR(@"%듀얼리스트%_MZ_攻:場所") > 2000
			RETURN 0
	ENDIF
	RETURN 1

ELSEIF 종류 == 묘지起動
	SIF 발동済_3(듀얼리스트,51620)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종족 = 전사족
	효과条件종류 = モン全般
	효과条件CNT = 1
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 3
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_51620(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動 && GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") >= 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51620,10,X消費2)
	IF RESULT == 0
		攻撃力修正 = GETVAR(@"%듀얼리스트%_MZ_攻:場所")
		CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"二攻",攻撃力修正)
	ENDIF

ELSEIF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51620)
	IF RESULT == 0
		CALL FULLRESET
		효과条件표시 = 表側표시
		효과条件他所 = 1
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			CALL CARD_EQUIP_MONSTER(듀얼리스트,場所,ゾーン,選択カード,3)
		ENDIF
	ENDIF

ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51620,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종족 = 전사족
		효과条件종류 = モン全般
		효과条件複数 = 3
		효과条件他所 = 1
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件名前 = Ｈ－Ｃ 엑스칼리버
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF