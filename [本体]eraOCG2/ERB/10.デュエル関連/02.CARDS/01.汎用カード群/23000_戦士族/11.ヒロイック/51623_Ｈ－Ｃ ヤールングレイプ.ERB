@CARDNAME_51623,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = Ｈ－Ｃ　야릉그레이프
	CASE "略称"
		RESULTS = HC야릉그레
	CASE "カテゴリ"
		RESULTS:0 = 히로익
ENDSELECT


@CARD_51623(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 700
	CASE "守備力"
		RETURN 1800
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251003
ENDSELECT

RETURN 0

@CARDSUMMON_51623(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 1
素材条件종족 = 전사족
;추가효과用

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,51623) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_51623(종류)
#DIM DYNAMIC 종류

PRINTL 전사족レベル１モンスター×２体
PRINTL このカード名の②③の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：자신フィールドの전사족モンスターは、それぞれ１ターンに１度だけ戦闘・효과では破壊されない。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：このカードのＸ素材を２つ取り除き、자신の묘지のレベル・ランク４の전사족モンスター１体を대상として발동できる。
PRINTL そのモンスターを특수소환し、その元々の攻撃力分このカードの攻撃力をアップする。
CALLFORM CARD_ABLE(3,攻撃時誘発)
PRINTL ③：상대モンスターが戦闘を行う攻撃宣言時に발동できる。
PRINTL そのモンスターの攻撃力の半分だけ자신のＬＰを회복する。

@CARDCAN_51623(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 효과先

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,51623)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트,51623)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= 0
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件レベル = 4
	효과条件종류 = 링크以外
	효과条件종족 = 전사족
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃時誘発
	SIF 발동済_3(듀얼리스트,51623)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트,1) == 5
		RETURN 0
	SIF GETVAR(@"%対面者%_MZ_表:戦闘場所(듀얼리스트,1)") == 3
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_51623(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 회복量修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51623,2,X消費2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件レベル = 4
		효과条件종류 = 링크以外
		효과条件종족 = 전사족
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			TRYCALLFORM CARD_{RESULT:1},"攻撃力"
			CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"永攻",RESULT)
		ENDIF
	ENDIF

ELSEIF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51623,3)
	IF RESULT == 0
		회복量修正 = GETVAR(@"%対面者%_MZ_攻:戦闘場所(듀얼리스트,1)") / 2
		CALL LIFE_CHANGE(듀얼리스트,"増加","효과",회복量修正)
	ENDIF

ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件종족 = 전사족
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"一破")
ENDIF