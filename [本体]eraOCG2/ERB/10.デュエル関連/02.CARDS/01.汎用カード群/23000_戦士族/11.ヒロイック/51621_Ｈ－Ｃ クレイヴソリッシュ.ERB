@CARDNAME_51621,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = Ｈ－Ｃ 크레이브솔리시
	CASE "略称"
		RESULTS = HC크레이브
	CASE "カテゴリ"
		RESULTS:0 = 히로익
ENDSELECT


@CARD_51621(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251003
ENDSELECT

RETURN 0

@CARDSUMMON_51621(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 4
素材条件종족 = 전사족
;추가효과用

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,51621) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_51621(종류)
#DIM DYNAMIC 종류

PRINTL 전사족 레벨４ 몬스터×２
PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：상대는 다른 몬스터를 공격대상에 선택할 수 없다。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：５００ＬＰ가 되도록 ＬＰ를 지불하고 발동할 수 있다。
PRINTL 이 턴의 배틀 페이즈 시작시、자신 필드의 몬스터 １장을 선택하고 공격력을 배로 한다。
CALLFORM CARD_ABLE(3,攻撃時誘発)
PRINTL ③：상대 몬스터가 전투를 하는 공격 선언시、이 카드의 Ｘ소재를 １개 제거하고 발동할 수 있다。
PRINTL 이 카드의 공격력은 턴 종료시 까지、상대 필드의 앞면 표시 몬스터 １장의 공격력 만큼 오른다。

@CARDCAN_51621(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,51621)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트,51621)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"ライフ_%듀얼리스트%") <= 500
		RETURN 0
	SIF ターン数 <= 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == バトル開始時強制
	SIF 발동済_2(듀얼리스트,51621) == 0
		RETURN 0
	SIF 발동済_4(듀얼리스트,51621)
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃時誘発
	SIF 발동済_3(듀얼리스트,51621)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	SIF 戦闘場所(듀얼리스트,1) == 5
		RETURN 0
	IF 듀얼리스트 != "자신"
		SIF 戦闘場所(듀얼리스트) != 場所
			RETURN 0
	ENDIF
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_51621(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51621,2)
	IF RESULT == 0
		攻撃力修正 = GETVAR(@"ライフ_%듀얼리스트%") - 500
		CALL LIFE_CHANGE(듀얼리스트,"減少","コスト",攻撃力修正)
	ENDIF

ELSEIF 종류 == バトル開始時強制
	CALL FULLRESET
	효과条件표시 = 表側표시
	CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
	IF RESULT != 9999
		攻撃力修正 = GETVAR(@"%듀얼리스트%_MZ_攻:RESULT")
		CALL SET_FIELD_INFO(듀얼리스트,"필드",RESULT,"永攻",攻撃力修正)
	ENDIF
	CALL CARD_EFFECT_USE(듀얼리스트,51621,4)

ELSEIF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51621,3,X消費1)
	IF RESULT == 0
		CALL FULLRESET
		효과条件표시 = 表側표시
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"상대필드",ゾーン,場所)
		IF RESULT != 9999
			攻撃力修正 = GETVAR(@"%対面者%_MZ_攻:RESULT")
			CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"一攻",攻撃力修正)
		ENDIF
	ENDIF

ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"攻誘")
ENDIF