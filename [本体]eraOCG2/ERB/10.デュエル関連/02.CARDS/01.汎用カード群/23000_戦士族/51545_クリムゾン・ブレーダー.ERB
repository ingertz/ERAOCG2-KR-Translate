@CARDNAME_51545,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 크림즌 블레이더
	CASE "略称"
		RESULTS = Ｃ 블레이더
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_51545(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
	
		RETURN 싱크로
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 2800
	CASE "守備力"
		RETURN 2600
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251019

ENDSELECT

RETURN 0

