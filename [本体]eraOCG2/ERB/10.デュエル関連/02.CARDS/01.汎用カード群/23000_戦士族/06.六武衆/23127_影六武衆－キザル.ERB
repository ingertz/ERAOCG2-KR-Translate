@CARDNAME_23127,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 그림자 여섯 무사－키자루
	CASE "略称"
		RESULTS = 영여섯무사키자루
	CASE "カテゴリ"
		RESULTS:0 = 그림자 여섯 무사
		RESULTS:1 = 여섯 무사
ENDSELECT


@CARD_23127(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"	
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1900
	CASE "守備力"
		RETURN 1000
	CASE "튜너"
		RETURN 0
	CASE "성별"
		RETURN 雄性
	CASE "レア度"
		RETURN SPR
	CASE "추가日"
		RETURN 251214
ENDSELECT

RETURN 0

@CARD_EXPLANATION_23127(종류)
#DIM DYNAMIC 종류

CALLFORM CARD_ABLE(0,특수소환時)
PRINTL ①：このカードが특수소환に成功した時に발동できる。
PRINTL 땅속성以外の「여섯 무사」モンスター１体を덱から손패に加える。
;PRINTL 자신フィールドに存在する속성以外の「여섯 무사」モンスター１体を덱から손패に加える。
;再現できなかった＆なくても良さそうなので변경。키잔と師範にアクセスできなければ問題なしと判断。影響はシエン存在時に破戒僧サーチできるくらい。
CALLFORM CARD_ABLE(0,身代효과)
PRINTL ②：자신フィールドの「여섯 무사」モンスター１体のみが효과で破壊される場合、
PRINTL 代わりに묘지のこのカードを제외できる。
PRINTL 

@CARDCAN_23127(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,23127)
SIF RESULT == 1
	RETURN 0

IF 종류 == 특수소환時
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = モン全般
	효과条件カテゴリ = 여섯 무사
	CALL 효과条件속성_ADV(땅속성, "以外")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 身代효과
	SIF ゾーン != "묘지"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	TRYCALLFORM CARDNAME_{破壊대상ID}("カテゴリ")
	 SIF !MATCH(RESULTS,"여섯 무사")	
		RETURN 0
	SIF !GROUPMATCH(破壊종류,"효과")
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_23127(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 攻撃力修正


IF 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,23127)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종류 = モン全般
		효과条件カテゴリ = 여섯 무사
		CALL 효과条件속성_ADV(땅속성, "以外")
		CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所)
	ENDIF
ELSEIF 종류 == 身代효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,23127)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		RETURN 1
	ENDIF
	RETURN 0
ENDIF


