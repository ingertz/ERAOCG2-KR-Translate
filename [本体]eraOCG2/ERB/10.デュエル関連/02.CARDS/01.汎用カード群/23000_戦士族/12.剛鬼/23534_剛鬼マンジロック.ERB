@CARDNAME_23534,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 강귀 만지록
	CASE "略称"
		RESULTS = 강귀 만지록
	CASE "カテゴリ"
		RESULTS:0 = 강귀 
ENDSELECT


@CARD_23534(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	;효과モン/通常モン/의식/융합/싱크로/엑시즈/링크/초차원
	CASE "종류"
		RETURN 효과モン
	;어둠속성/빛속성/땅속성/물속성/화염속성/바람속성
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	;牝性/雄性があるよ
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251006
ENDSELECT
RETURN 0

@CARD_EXPLANATION_23534(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,攻撃時誘発)
PRINTL ①：상대 몬스터가 공격한 경우、이 카드를 패에서 버리고 발동할 수 있다。
PRINTL 이 전투로 발생하는 자신으로의 전투 데미지는 절반이 된다。
CALLFORM CARD_ABLE(1,戦破壊→묘지)
PRINTL ②：이 카드가 필드에서 묘지로 보내졌을 경우에 발동할 수 있다。
PRINTL 덱에서 "강귀 만지록" 이외의 "강귀" 카드 １장을 패에 넣는다。


@CARDCAN_23534(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,23534)
SIF RESULT == 1
	RETURN 0

IF 종류 == 攻撃時誘発
    SIF バトルフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0
	SIF ゾーン != "손패"
		RETURN 0
	RETURN 1
	
ELSEIF 종류 == 戦破壊→묘지
	SIF !GROUPMATCH(묘지送り종류,"リリース","破壊","戦闘破壊")
		RETURN 0
	SIF 발동済_1(듀얼리스트,23534)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 강귀 
	효과条件固名前 = 강귀 만지록
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1	
	
ENDIF

@CARDEFFECT_23534(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,23534)
	IF RESULT == 0
	    CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL SET_PLAYER_INFO(듀얼리스트,"ダメージ半化",3)
	ENDIF

ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,23534,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 강귀 
	    효과条件固名前 = 강귀 만지록
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ENDIF