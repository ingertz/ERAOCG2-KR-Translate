@CARDNAME_23532,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 강귀 라이징스콜피오
	CASE "略称"
		RESULTS = 강귀 스콜피오
	CASE "カテゴリ"
		RESULTS:0 = 강귀 
ENDSELECT


@CARD_23532(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	;효과モン/通常モン/의식/융합/싱크로/엑시즈/링크/초차원
	CASE "종류"
		RETURN 효과モン
	;어둠속성/빛속성/땅속성/물속성/화염속성/바람속성
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 2300
	CASE "守備力"
		RETURN 0
	;牝性/雄性があるよ
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251006
ENDSELECT
RETURN 0

@CARD_EXPLANATION_23532(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の②の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(0,효과소환)
PRINTL ①：자신フィールドのモンスターが存在しない場合、または「강귀」モンスターが存在する場合、
PRINTL このカードはリリースなしで소환できる。
CALLFORM CARD_ABLE(1,戦破壊→묘지)
PRINTL ②：このカードがフィールドから묘지へ送られた場合に발동できる。
PRINTL 덱から「강귀 라이징스콜피오」以外の「강귀」カード１枚を손패に加える。


@CARDCAN_23532(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,23532)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과소환
	SIF モンスター数(듀얼리스트) < 1
		RETURN 1
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 강귀 
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 1
	RETURN 0
	
ELSEIF 종류 == 戦破壊→묘지
	SIF !GROUPMATCH(묘지送り종류,"リリース","破壊","戦闘破壊")
		RETURN 0
	SIF 발동済_1(듀얼리스트,23532)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 강귀 
	효과条件固名前 = 강귀 라이징스콜피오
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1	
	
ENDIF

@CARDEFFECT_23532(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 효과소환
	RETURN 1

ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,23532,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 강귀 
	    효과条件固名前 = 강귀 라이징스콜피오
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ENDIF