@CARDNAME_51637,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 강귀 더 파워로드 오우거
	CASE "略称"
		RESULTS = 강귀 파워로드
	CASE "カテゴリ"
		RESULTS:0 = 강귀 
ENDSELECT


@CARD_51637(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	;효과モン/通常モン/의식/융합/싱크로/엑시즈/링크/초차원
	CASE "종류"
		RETURN 링크
	;어둠속성/빛속성/땅속성/물속성/화염속성/바람속성
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 2800
	CASE "守備力"
		RETURN 0
	;牝性/雄性があるよ
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251006
ENDSELECT
RETURN 0


@CARDSUMMON_51637(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 4
素材条件종족 = 전사족


IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,51637) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_51637(종류)
#DIM DYNAMIC 종류

PRINTL 전사족 몬스터 ２장 이상
PRINTL 이 카드명의 ③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ①：이 카드의 공격력은、이 카드 이외의 자신 필드의 
PRINTL L몬스터의 링크의 합계×２００오른다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：L소환한이 카드는 상대의 카드의 효과를 받지 않는다。
CALLFORM CARD_ABLE(1,필드起動)
PRINTL ③：자신 필드의 "강귀" L몬스터 １장을 릴리스하고、
PRINTL 그 링크의 수 만큼 상대 필드의 카드를 대상으로 하고 발동할 수 있다。
PRINTL 그 카드를 파괴한다。


@CARDCAN_51637(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,51637)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF 발동済_1(듀얼리스트,51637)
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1	

ELSEIF 종류 == 지속효과 || 종류 == 攻守変動
	SIF ゾーン != "필드" 
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_召種:場所") != 召種EX덱
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻守変動
	SIF ゾーン != "필드" 
		RETURN 0
	RETURN 1	

ENDIF

@CARDEFFECT_51637(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードレベル

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51637,1)
	IF RESULT == 0
	    CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 강귀 
	    효과条件종류 = 링크
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			TRYCALLFORM CARD_{RESULT:1}("レベル")
			選択カードレベル = RESULT
			REPEAT 選択カードレベル
				CALL FULLRESET
				효과範囲상대필드 = 1
				효과範囲상대마함 = 1
				효과条件任意 = 1
				효과条件除去種 = 묘지
		        효과条件行先플래그 = 破壊行き
		        CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			REND
		ENDIF
	ENDIF

ELSEIF 종류 == 攻守変動 
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = 링크
	효과条件CNT = 1
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	攻撃力修正 = RESULT:2 * 200
	CALL STATCHANGE_BASIC(듀얼리스트,"自身",場所,攻撃力修正)

ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"モ耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"魔耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"함정耐")

ENDIF	


