@CARDNAME_72316,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 강귀 피니시홀드
	CASE "略称"
		RESULTS = 강귀 Finish Hold
	CASE "カテゴリ"
		RESULTS:0 = 강귀 
ENDSELECT


@CARD_72316(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
	CASE "추가日"
		RETURN 251006
ENDSELECT
RETURN 0

@CARD_EXPLANATION_72316(종류)
#DIM DYNAMIC 종류

PRINTL このカード名のカードは１ターンに１枚しか발동できない。
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①：자신フィールドの「강귀」링크モンスター１体を대상として발동できる。
PRINTL そのモンスターの攻撃力はターン終了時まで、その링크数×１０００アップし、貫通を与える。
PRINTL このカードの발동後、ターン終了時まで자신は「강귀」モンスターでしか攻撃宣言できない。


@CARDCAN_72316(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72316)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,72316)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 강귀 
	효과条件종류 = 링크
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ENDIF

@CARDEFFECT_72316(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カードレベル
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72316,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		효과範囲필드 = 1
		효과条件カテゴリ = 강귀 
		효과条件종류 = 링크
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		IF 選択カード != 9999
		    選択カード = RESULT
			選択カードレベル = GETVAR(@"%듀얼리스트%_MZ_星:選択カード")

		    CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"一攻",選択カードレベル*1000)
			CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"貫通",1)

			CALL CARD_ATK_RESTRICTION(듀얼리스트,"강귀")
		ENDIF

	ENDIF
ENDIF

