@CARDNAME_50636,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 파괴검사의 수호반룡
	CASE "略称"
		RESULTS = 수호반룡
	CASE "カテゴリ"
		RESULTS:0 = 파괴검
	CASE "検索カテゴリ"
		RESULTS:0 = 버스터 블레이더
ENDSELECT


@CARD_50636(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 드래곤족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 400
	CASE "守備力"
		RETURN 300
	CASE "추가日"
		RETURN 251022
ENDSELECT

RETURN 0
@CARDSUMMON_50636(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要링크数 = 1
素材条件カテゴリ = 파괴검

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,50636) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_50636(종류)
#DIM DYNAMIC 종류


PRINTL 파괴검 몬스터 １장
PRINTL 이 카드명의 ①②의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
CALL CARD_ABLE(1,EX소환時)
PRINTL ①：이 카드가 링크 소환에 성공한 경우에 발동할 수 있다。
PRINTL 덱에서 "파괴검" 카드 １장을 묘지로 보낸다。
PRINTL 그 후、패 / 묘지에서 "버스터 블레이더" 몬스터 １장을 특수 소환할 수 있다。
CALL CARD_ABLE(2,バトル終了時)
PRINTL ②：상대 필드에 몬스터가 존재하지 않는 자신 배틀 페이즈 종료시에、
PRINTL 자신 필드의 "버스터 블레이더" 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터의 공격력 만큼 데미지를 상대에게 준다。

@CARDCAN_50636(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50636)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX소환時
	SIF 발동済_1(듀얼리스트,50636)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件名前 = 파괴검
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == バトル終了時
	SIF 발동済_2(듀얼리스트,50636)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 발동済_2(듀얼리스트,50636)
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 0
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_50636(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID 
#DIM DYNAMIC ダメージ量

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 攻撃時誘発
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50636,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件名前 = 파괴검
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲손패 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ = 버스터 블레이더
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == バトル終了時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50636,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件カテゴリ = 버스터 블레이더
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			ダメージ量 = GETVAR(@"%듀얼리스트%_MZ_攻:選択カード")
			CALL LIFE_CHANGE(듀얼리스트,"減少","효과",ダメージ量,1)
		ENDIF
	ENDIF
ENDIF
