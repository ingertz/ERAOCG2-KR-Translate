@CARDNAME_51651,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = CX 열혈지도신 얼티미트 트레이너
	CASE "略称"
		RESULTS = 열혈지도신
	CASE "カテゴリ"
		RESULTS:0 = 카오스
ENDSELECT


@CARD_51651(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 3800
	CASE "守備力"
		RETURN 2300
	CASE "성별"
		RETURN 雄性
ENDSELECT
RETURN 0

@CARD_EXPLANATION_51651(종류)
#DIM DYNAMIC 종류

PRINTL 레벨 9 몬스터 × 4장
PRINTL 엑스 몬스터를 엑스 소재로 하고 있는 이 카드는 "각성"한다.
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①: 필드 위에 있는 이 카드는 카드 효과의 대상이 되지 않는다.
CALLFORM CARD_ABLE(10,필드起動)
PRINTL ②: 1턴에 1번, 각성 상태의 이 카드의 엑스 소재를 1개 제거하고 발동할 수 있다.
PRINTL 자신의 덱 맨 위의 카드를 넘기고, 패에 넣는다.
PRINTL 넘긴 카드가 몬스터였을 경우, 추가로 상대에게 800 데미지를 준다.


@CARDCAN_51651(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,51651)
SIF RESULT == 1
	RETURN 0

; ①의 효과の条件지정
IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0	
	RETURN 1

; ②의 효과の条件지정
ELSEIF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트,51651)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_条達:場所") == 0
		RETURN 0
	RETURN 1
ENDIF

@CARDSUMMON_51651(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 4
素材条件レベル = 9
;추가효과用
지정素材종류 = 엑시즈

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,51651) 
	RETURN RESULT
ENDIF

@CARDEFFECT_51651(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 조교대상
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

; ①의 효과
IF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"対耐")

; ②의 효과
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,51651,2,X消費1)
	IF RESULT == 0
		TRYCALLFORM CARD_UI(GETVAR(@"%듀얼리스트%_덱:0"))
		PRINTW
		CALLFORM CARD_{GETVAR(@"%듀얼리스트%_덱:0")}("종류")
		IF RESULT < 10
			CALL LIFE_CHANGE(듀얼리스트,"減少","효과",800,1)
		ENDIF


		FOR カウンタ,0,5
			CALL FULLRESET
			CALL CARD_FILTER_SET(듀얼리스트,"필드",カウンタ,듀얼리스트,5)
			조교대상 = RESULT
			IF RESULT != -1
				조교대상 = RESULT
				PRINTFORMW %CALLNAME:조교대상%은 트레이너에게 명령받은 대로, 필사적으로 하드한 스쿼트를 반복했다.
				CALL EROTIC_MOVE("스쿼트",조교대상,,300)
			ENDIF
		NEXT
		FOR カウンタ,0,5
			CALL FULLRESET
			CALL CARD_FILTER_SET(対面者,"필드",カウンタ,듀얼리스트,5)
			조교대상 = RESULT
			IF RESULT != -1
				조교대상 = RESULT
				PRINTFORMW %CALLNAME:조교대상%은 트레이너에게 명령받은 대로, 필사적으로 하드한 스쿼트를 반복했다.
				CALL EROTIC_MOVE("스쿼트",조교대상,,300)
			ENDIF
		NEXT

		CALL CARD_EROTICS(現在プレイヤー,듀얼리스트)
		IF RESULT != -1
			조교대상 = RESULT
			PRINTFORMW %CALLNAME:조교대상%도 또한, 명령받은 대로 하드한 스쿼트를 반복했다.
			CALL EROTIC_MOVE("스쿼트",조교대상,,300)
		ENDIF

		CALL CARD_EROTICS(상대プレイヤー,듀얼리스트)
		IF RESULT != -1
			조교대상 = RESULT
			PRINTFORMW %CALLNAME:조교대상%도 또한, 명령받은 대로 하드한 스쿼트를 반복했다.
			CALL EROTIC_MOVE("스쿼트",조교대상,,300)
		ENDIF

		CALL CARDDRAW_BASIC(듀얼리스트,1)
	ENDIF
ENDIF
