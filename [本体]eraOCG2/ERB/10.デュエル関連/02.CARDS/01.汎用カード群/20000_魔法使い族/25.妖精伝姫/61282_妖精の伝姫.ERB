@CARDNAME_61282,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 페어리테일
	CASE "略称"
		RESULTS = 페어리테일
	CASE "カテゴリ"
		RESULTS:0 = 페어리테일
ENDSELECT


@CARD_61282(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속마법
	CASE "추가日"
		RETURN 260124
ENDSELECT

RETURN 0

@CARD_EXPLANATION_61282(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①：同名モンスターが자신フィールドに存在しない、
PRINTL 손패の攻撃力１８５０の마법사족モンスター１体を상대に見せて발동できる。
PRINTL そのモンスターの通常소환を行う（リリースは必要としない）。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：자신フィールドに元々の攻撃力が１８５０の마법사족モンスターが存在し、
PRINTL 자신が戦闘・효과でダメージを受ける場合、１ターンに１度だけそのダメージは０になる。


@CARDCAN_61282(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성
#DIMS DYNAMIC 選択カード名前,6

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,61282)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 발동済_1(듀얼리스트,61282)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF モンスター数(듀얼리스트) >= 5
		RETURN 0
	FOR カウンタ,0,5
		SIF GETVAR(@"%듀얼리스트%_필드:場所") == -1
			CONTINUE
		TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_필드:場所")},"攻撃力"
		SIF RESULT != 1850
			CONTINUE
		TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_필드:場所")},"名前"
		選択カード名前:(カウンタ+1) = %RESULTS%
	NEXT
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件固攻撃力 = 1850
	효과条件종족 = 마법사족
	효과条件固名前:0 = ダミー
	FOR カウンタ,1,5
		효과条件固名前:カウンタ = %選択カード名前:カウンタ%
	NEXT
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2
		RETURN 0
	FOR カウンタ,0,5
		SIF GETVAR(@"%듀얼리스트%_필드:カウンタ") == -1
			CONTINUE
		SIF GETVAR(@"%듀얼리스트%_MZ_表:カウンタ") == 3
			CONTINUE
		TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_필드:カウンタ")}("攻撃力")
		SIF RESULT != 1850
			CONTINUE
		条件달성 = 1
		BREAK
	NEXT
	SIF 条件달성 != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_61282(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC 選択カード名前,6

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,61282,1)
	IF RESULT == 0
		FOR カウンタ,0,5
			SIF GETVAR(@"%듀얼리스트%_필드:場所") == -1
				CONTINUE
			TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_필드:場所")},"攻撃力"
			SIF RESULT != 1850
				CONTINUE
			TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_필드:場所")},"名前"
			選択カード名前:(カウンタ+1) = %RESULTS%
		NEXT
		CALL FULLRESET
		효과条件종족 = 마법사족
		효과条件固攻撃力 = 1850
		효과条件固名前:0 = ダミー
		FOR カウンタ,1,5
			효과条件固名前:カウンタ = %選択カード名前:カウンタ%
		NEXT
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"손패",ゾーン,場所)
		SIF RESULT != 9999
			CALL CARD_SUMMON_SHORI(듀얼리스트,RESULT,"攻撃표시",1)
	ENDIF

ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,61282)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF

ELSEIF 종류 == 지속효과
	CALL SET_PLAYER_INFO(듀얼리스트,"一時ダメージ無効",3)
ENDIF
