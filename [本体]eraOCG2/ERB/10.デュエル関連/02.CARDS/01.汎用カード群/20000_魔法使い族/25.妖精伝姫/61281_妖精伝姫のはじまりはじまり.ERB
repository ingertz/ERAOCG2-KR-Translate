@CARDNAME_61281,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 페어리테일의 시작합니다 시작해요
	CASE "略称"
		RESULTS = 시작한다 시작해
	CASE "カテゴリ"
		RESULTS:0 = 페어리테일
ENDSELECT


@CARD_61281(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
	CASE "추가日"
		RETURN 260124
ENDSELECT

RETURN 0

@CARD_EXPLANATION_61281(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動,손패起動,フリー誘発)
PRINTL ①：자신의 손패・묘지・제외状態から각각 １장까지 、빛속성の「페어리테일」몬스터를 특수소환する（같은 이름의 카드는 １장까지）。
PRINTL 이 턴、자신은 마법사족モンスターしか특수 소환할 수 없다。
CALLFORM CARD_ABLE(2,제외時,손패→묘지,덱→묘지)
PRINTL ②：이 카드가 「페어리테일」카드의 효과で제외された場合、またはフィールド以外から묘지로 보내진 경우에 발동할 수 있다。
PRINTL 이 카드를 자신 필드에 セットする。
;PRINTL 이 효과로 セットした이 카드는 、자신 필드에 「페어리테일」モンスターが存在しない場合には발동できない。

@CARDCAN_61281(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성
#DIM DYNAMIC カウンタ

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,61281)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,61281)
		RETURN 0
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件カテゴリ = 페어리테일
	효과条件속성 = 빛속성
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 제외時 || 종류 == 손패→묘지 || 종류 == 덱→묘지
	SIF 발동済_2(듀얼리스트,61281)
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	TRYCALLFORM CARDNAME_{処理中_효과ID},"カテゴリ"
	SIF !MATCH(RESULTS,"페어리테일")
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_61281(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名前,2
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%
IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,61281,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件カテゴリ = 페어리테일
		효과条件속성 = 빛속성
		효과条件任意 = 1
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			TRYCALLFORM CARDNAME_{RESULT:1},"名前"
			選択カード名前:0 = %RESULTS%
		ENDIF

		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 페어리테일
		효과条件속성 = 빛속성
		효과条件固名前:0 = ダミー
		효과条件固名前:1 = %選択カード名前:0%
		효과条件任意 = 1
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			TRYCALLFORM CARDNAME_{RESULT:1},"名前"
			選択カード名前:1 = %RESULTS%
		ENDIF

		CALL FULLRESET
		효과範囲제외 = 1
		효과条件カテゴリ = 페어리테일
		효과条件속성 = 빛속성
		효과条件固名前:0 = ダミー
		효과条件固名前:1 = %選択カード名前:0%
		효과条件固名前:2 = %選択カード名前:1%
		효과条件任意 = 1
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 제외時 || 종류 == 손패→묘지 || 종류 == 덱→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,61281,2)
	IF RESULT == 0
		CALL FULLRESET
		IF ゾーン == "묘지"
			효과範囲묘지 = 1
		ELSEIF ゾーン == "제외"
			효과範囲제외 = 1
		ENDIF
		효과条件名前 = 페어리테일의 시작합니다 시작해요
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"裏側표시")
	ENDIF
ENDIF

