@CARDNAME_1286,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 페어리테일－위캣
	CASE "略称"
		RESULTS = 위캣
	CASE "カテゴリ"
		RESULTS:0 = 페어리테일
ENDSELECT


@CARD_1286(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1850
	CASE "守備力"
		RETURN 1000
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 260124
ENDSELECT

RETURN 0

@CARDSUMMON_1286(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 4
素材条件종족 = 마법사족
IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,1286) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_1286(종류)
#DIM DYNAMIC 종류

PRINTL 마법사족レベル４モンスター×２
PRINTL このカード名の②③の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：자신フィールドの元々の속성が빛속성の「페어리테일」モンスターは상대が발동した효과を受けない。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：자신メインフェイズに발동できる。
PRINTL このカードのＸ素材を２つまで取り除き、取り除いた数だけ덱から「페어리테일」カードを묘지へ送る。
CALLFORM CARD_ABLE(3,묘지起動,フリー誘発)
PRINTL ③：자신・상대ターンに、このカードが묘지に存在する場合、
PRINTL 자신フィールドの元々の속성が빛속성の「페어리테일」モンスター１体を대상として발동できる。
PRINTL このカードを특수소환し、대상のモンスターを묘지へ送る。


@CARDCAN_1286(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성
#DIMS DYNAMIC 装備者
#DIM DYNAMIC 装備先

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL 装備판정(듀얼리스트,場所,ゾーン)
装備者 = %RESULTS%
装備先 = RESULT

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,1286)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트,1286)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 페어리테일
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 묘지起動 || 종류 == フリー誘発
	SIF ゾーン != "묘지"
		RETURN 0
	SIF 발동済_2(듀얼리스트,1286)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,1286,ゾーン)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	CALL LITE_FAIRYTAIL_SET
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_1286(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성
#DIM DYNAMIC 選択数
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 지속효과
	CALL FULLRESET
	CALL LITE_FAIRYTAIL_SET
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"モ耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"魔耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"함정耐")

ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1286,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 페어리테일
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT >= 2
			条件달성 = 1

		IF 듀얼리스트 == "자신"
			PRINTL 【取り除くＸ素材の数を選択してください】
			PRINTL
			PRINT [1]　
			SIF 条件달성 == 1 && GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") >= 1
				PRINTL [2]
			BINPUT
		ELSE
			RESULT = 1
			SIF 条件달성 == 1 && GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") >= 1
				RESULT = 2
			PRINTFORMW %듀얼리스트%は「{RESULT}つ」取り除きました
		ENDIF
		選択数 = RESULT
		CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"Ｘ",-選択数)

		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 페어리테일
		효과条件複数 = 選択数
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 묘지起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1286,3)
	IF RESULT == 0
		CALL FULLRESET
		CALL LITE_FAIRYTAIL_SET
		효과条件표시 = 表側표시
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件名前 = 페어리테일－위캣
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			SIF RESULT == 1
				CALL CARD_DISPOSE(듀얼리스트,"필드",選択カード)
		ENDIF
	ENDIF
ENDIF



@LITE_FAIRYTAIL_SET
효과条件名前:0 = 페어리테일－カグヤ
효과条件名前:1 = 페어리테일－シラユキ
효과条件名前:2 = 페어리테일－シンデレラ
효과条件名前:3 = 페어리테일－ターリア
효과条件名前:4 = 페어리테일－ラチカ
효과条件名前:5 = 페어리테일－매치릴
