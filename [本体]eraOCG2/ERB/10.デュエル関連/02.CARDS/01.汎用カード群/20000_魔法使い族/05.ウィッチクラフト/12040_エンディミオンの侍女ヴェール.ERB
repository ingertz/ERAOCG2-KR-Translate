@CARDNAME_12040, 参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 엔디미온의 시녀 베르
	CASE "略称"
		RESULTS = 시녀 베르
	CASE "カテゴリ"
		RESULTS:0 = 엔디미온
		RESULTS:1 = 위치크래프트
ENDSELECT

@CARD_12040(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 500
	CASE "守備力"
		RETURN 1400
	CASE "성별"
		RETURN 牝性
	CASE "レア度"
		RETURN ULR
	CASE "連動ID"
		RETURN 2040
	CASE "추가日"
		RETURN 260105
ENDSELECT

RETURN 0

@CARD_EXPLANATION_12040(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：마법카드의 효과が발동したターンの자신 메인 페이즈에 발동할 수 있다。이 카드를 패에서 특수 소환한다。
CALLFORM CARD_ABLE(2,특수소환時)
PRINTL ②：이 카드가 특수 소환된 경우에 발동할 수 있다。
PRINTL 덱에서 「위치크래프트」、「디멘션 매직」마법 / 함정 카드 １장을 패에 넣는다。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ③：자신의 フィールドか묘지に「프린스 오브 엔디미온 레굴루스」が존재하는 한、이 카드의 공격력은 ２３００오른다。


@CARDCAN_12040(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,12040)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,12040)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,12040,"손패")
	SIF RESULT == 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_마법발동数") == 0 && GETVAR(@"%対面者%_마법발동数") == 0
		RETURN 0
	RETURN 1
ELSEIF 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,12040)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ:0 = 위치크래프트
	효과条件カテゴリ:1 = 디멘션 매직
	효과条件종류 = 마함全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲묘지 = 1
	효과条件名前 = 프린스 오브 엔디미온 레굴루스
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_12040(듀얼리스트, 종류, ゾーン, 場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,12040,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,"손패",場所)
	ENDIF
ELSEIF 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,12040,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件カテゴリ:0 = 위치크래프트
		효과条件カテゴリ:1 = 디멘션 매직
		효과条件종류 = 마함全般
		CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所)
	ENDIF
ELSEIF 종류 == 攻守変動
	CALL STATCHANGE_BASIC(듀얼리스트,"自身",場所,2300)
ENDIF
