@CARDNAME_42106,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 엑소시스터 카르마엘
	CASE "略称"
		RESULTS = 카르마엘
	CASE "カテゴリ"
		RESULTS:0 = 엑소시스터
ENDSELECT


@CARD_42106(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 2600
	CASE "守備力"
		RETURN 1800
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		RETURN 2104
	CASE "추가日"
		RETURN 251025
ENDSELECT
RETURN 0

@CARDSUMMON_42106(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 4
素材条件カテゴリ = 엑소시스터

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,42106) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_42106(종류)
#DIM DYNAMIC 종류

PRINTL 레벨４ "엑소시스터" 몬스터×２
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,EX소환時)
PRINTL ①：이 카드가 Ｘ소환된 경우에 발동할 수 있다。
PRINTL 이 턴의 엔드 페이즈에、
PRINTL 자신의 덱 / 묘지 / 제외 상태인 "엑소시스터" 마법 / 함정 카드 １장을 자신 필드에 세트한다。
CALLFORM CARD_ABLE(2,발동誘発)
PRINTL ②：상대가 몬스터의 효과 / 일반마법 / 일반함정 카드를 발동했을 때에 발동할 수 있다。
PRINTL 이 카드의 Ｘ소재를 전부 제거하고 그 효과를 무효로 하고、상대는 이하의 효과를 적용한다。
PRINTL ●상대 묘지의 카드 １장을 골라 상대의 패에 넣는다。


@CARDCAN_42106(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,42106)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX소환時
	SIF 발동済_1(듀얼리스트,42106)
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン終了時予約
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件カテゴリ = 엑소시스터
	효과条件종류 = 마함全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF 발동済_2(듀얼리스트,42106)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	CALL FULLRESET
	효과条件종류:0 = モン全般
	효과条件종류:1 = 通常마법
	효과条件종류:2 = 通常함정
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1	
ENDIF

@CARDEFFECT_42106(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,42106,1)
	IF RESULT == 0
		CALL CARD_RESERV(듀얼리스트,42106)
	ENDIF
ELSEIF 종류 == ターン終了時予約
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件カテゴリ = 엑소시스터
	효과条件종류 = 마함全般
	CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"裏側표시")
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,42106,2)
	IF RESULT == 0
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"Ｘ",-1,上書きモード)
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")
		IF RESULT == 1
			CALL FULLRESET
			효과範囲상대묘지 = 1
			CALL CARD_CHOOSE_ADV(対面者,ゾーン,場所)
			IF RESULT != 9999
				CALL CARD_SELECT(対面者,RESULT)
				選択カード = RESULT
				CALL CARD_DISPOSE(듀얼리스트,"묘지",選択カード,손패行き)
			ENDIF
		ENDIF
	ENDIF
ENDIF
