@CARDNAME_71170,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 아이스 돌 미러
	CASE "略称"
		RESULTS = 얼음 인형 거울
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_71170(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
	CASE "추가日"
		RETURN 250615
ENDSELECT

RETURN 0

@CARD_EXPLANATION_71170(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 1번밖에 사용할 수 없다.
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①: 자신의 패 / 필드 (앞면 표시)에서 물 속성 몬스터 １장을 묘지로 보내 발동할 수 있다.
PRINTL 자신 필드의 물 속성 몬스터 １장을 고르고, 그 동명 몬스터 １장을 패 / 덱에서 특수 소환한다.
PRINTL 이 카드의 발동 후, 턴 종료 시까지 자신은 물 속성 몬스터밖에 특수 소환할 수 없다.
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②: 묘지의 이 카드를 제외하고 발동할 수 있다.
PRINTL 자신의 덱 / 묘지에서 "아이스 돌" １장을 패에 넣는다.


@CARDCAN_71170(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 条件달성カード名,10
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,71170)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
    SIF 발동済_1(듀얼리스트,71170)
    	RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件속성 = 물속성
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲필드 = 1
	효과条件속성 = 물속성
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0
	;자신 필드에 存在する물속성 몬스터의 名称を취득
	FOR カウンタ,0,5
		SIF GETVAR(@"%듀얼리스트%_필드:カウンタ") == -1
			CONTINUE
		SIF GETVAR(@"%듀얼리스트%_MZ_表:カウンタ") == 3
			CONTINUE
		選択カード_ID = GETVAR(@"%듀얼리스트%_필드:カウンタ")
		TRYCALLFORM CARD_{選択カード_ID}("속성")
		SIF RESULT != 물속성
			CONTINUE
		TRYCALLFORM CARDNAME_{選択カード_ID}("名前")
		IF RESULTS != ""
			条件달성カード名:カウンタ = %RESULTS%
		ENDIF
	NEXT
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件속성 = 물속성
	효과条件소환可 = 1
	효과条件名前:0 = 더미
	효과条件名前:1 = %条件달성カード名:0%
	효과条件名前:2 = %条件달성カード名:1%
	효과条件名前:3 = %条件달성カード名:2%
	효과条件名前:4 = %条件달성カード名:3%
	효과条件名前:5 = %条件달성カード名:4%
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT != 1
		RETURN 0
	ENDIF
	RETURN 1
ELSEIF 종류 == 묘지起動
    SIF 발동済_2(듀얼리스트,71170)
    	RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
		CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件名前 = 아이스 돌
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_71170(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 選択カード名前
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 条件달성カード名,10
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 条件달성数 = 0

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71170,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		;まず필드의 물속성 몬스터의 数を確認(2장 이상 居ればフィールドもリリース範囲にできる)
		FOR カウンタ,0,5
			SIF GETVAR(@"%듀얼리스트%_필드:カウンタ") == -1
				CONTINUE
			SIF GETVAR(@"%듀얼리스트%_MZ_表:カウンタ") == 3
				CONTINUE
			選択カード_ID = GETVAR(@"%듀얼리스트%_필드:カウンタ")
			TRYCALLFORM CARD_{選択カード_ID}("속성")
			SIF RESULT != 물속성
				CONTINUE
			TRYCALLFORM CARDNAME_{選択カード_ID}("名前")
			IF RESULTS != ""
				条件달성カード名:カウンタ = %RESULTS%
			ENDIF
			条件달성数 += 1
		NEXT
		CALL FULLRESET
		효과範囲손패 = 1
		SIF 条件달성数 >= 2
			효과範囲필드 = 1
		효과条件속성 = 물속성
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			[SKIPSTART]
			CALL FULLRESET
			효과条件속성 = 물속성
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
			選択カード = RESULT
			IF 選択カード != 9999
				TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_필드:選択カード")}("名前")
				選択カード名前 = %RESULTS%

				CALL FULLRESET
				효과範囲덱 = 1
				효과条件名前 = %選択カード名前%
				CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
			[SKIPEND]
			
			;色々面倒なんで、コスト払った後に필드에 残ってる물속성 몬스터의 名前を引っ張ってきて、名前条件で덱에서 リクルート
			;
			FOR カウンタ,0,5
				;前の処理で名前が変数に入ってる想定なんで、先頭で１回空白にしておく
				条件달성カード名:カウンタ = ""
				
				SIF GETVAR(@"%듀얼리스트%_필드:カウンタ") == -1
					CONTINUE
				SIF GETVAR(@"%듀얼리스트%_MZ_表:カウンタ") == 3
					CONTINUE
				選択カード_ID = GETVAR(@"%듀얼리스트%_필드:カウンタ")
				TRYCALLFORM CARD_{選択カード_ID}("속성")
				SIF RESULT != 물속성
					CONTINUE
				TRYCALLFORM CARDNAME_{選択カード_ID}("名前")
				IF RESULTS != ""
					条件달성カード名:カウンタ = %RESULTS%
				ENDIF
			NEXT
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件속성 = 물속성
			효과条件名前:0 = 더미
			효과条件名前:1 = %条件달성カード名:0%
			효과条件名前:2 = %条件달성カード名:1%
			효과条件名前:3 = %条件달성カード名:2%
			효과条件名前:4 = %条件달성カード名:3%
			효과条件名前:5 = %条件달성カード名:4%
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)

		ENDIF	
		;SS:특수소환禁止の制約（물속성のみ可能）
		CALL FULLRESET
		SS소환可能속성 = 물속성
		CALL CARD_SS_RESTRICTION(듀얼리스트)
	ENDIF
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71170,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲덱 = 1
		효과条件名前 = 아이스 돌
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF
