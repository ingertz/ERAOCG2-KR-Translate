@CARDNAME_50001,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 대륜의 령사
	CASE "略称"
		RESULTS = 대륜의 령사
	CASE "カテゴリ"
		RESULTS:0 = 령사
ENDSELECT


@CARD_50001(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 3000
	CASE "守備力"
		RETURN 2500
	CASE "성별"
		RETURN 牝性
	CASE "レア度"
		RETURN ULR
	CASE "추가日"
		RETURN 260124
	CASE "連動ID"
		SELECTCASE RAND:4
			CASE 0
				RESULT:3 = 1253
				RESULT:2 = 1252
				RESULT:1 = 1251
				RETURN 1250
			CASE 1
				RESULT:3 = 1253
				RESULT:2 = 1252
				RESULT:1 = 1250
				RETURN 1251
			CASE 2
				RESULT:3 = 1253
				RESULT:2 = 1250
				RESULT:1 = 1251
				RETURN 1252
			CASE 3
				RESULT:3 = 1250
				RESULT:2 = 1252
				RESULT:1 = 1251
				RETURN 1253
		ENDSELECT
ENDSELECT
RETURN 0

@CARD_EXPLANATION_50001(종류)
#DIM DYNAMIC 종류

PRINTL 「령사」モンスター×２体以上
PRINTL このカード名の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,EX소환時)
PRINTL ①：このカードが융합소환した場合に발동できる。
PRINTL このカードの융합素材としたモンスターの元々の속성の종류の数まで、
PRINTL 「以下の효과から１つを選び、その효과を適用する」処理を繰り返す（最大４回）。
PRINTL ●このカードの攻撃力は８００アップする。
PRINTL ●덱から「憑依」마법・함정カード１枚を손패に加える。
PRINTL ●フィールドのカード１枚を손패に戻す。
PRINTL ●자신の묘지から마법사족モンスター１体を특수소환する。



@CARDSUMMON_AA_50001


@CARDSUMMON_50001(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 99
素材条件数自由 = 1
素材条件속성数起動 = 1

素材条件カテゴリ = 령사

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,50001) 
	RETURN RESULT
ENDIF


@CARDCAN_50001(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50001)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX소환時
	SIF 발동済_1(듀얼리스트,50001)
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_50001(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 素材数
#DIM DYNAMIC 選択カード


IF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50001,1)
	IF RESULT == 0
		素材数 = GETVAR(@"%듀얼리스트%_MZ_汎数:場所") - 1
		SIF 素材数 > 4
			素材数 = 4
		$LOOP_POINT
		IF 듀얼리스트 == "자신"
			PRINTFORML 
			PRINTFORML 발동する효과を選んで下さい。
			PRINTFORML 
			PRINTFORML [0] - ●このカードの攻撃力は８００アップする。
			PRINTFORML [1] - ●덱から「憑依」마법・함정カード１枚を손패に加える。
			PRINTFORML [2] - ●フィールドのカード１枚を손패に戻す。
			PRINTFORML [3] - ●자신の묘지から마법사족モンスター１体を특수소환する。
			BINPUT
		ELSE
			RESULT = RAND:3 + 1
		ENDIF
		IF RESULT == 0
			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"永攻",800)
		ELSEIF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 령사
			효과条件종류 = 마함全般
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ELSEIF RESULT == 2
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲마함 = 1
			효과範囲상대필드 = 1
			효과範囲상대마함 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"손패")
		ELSEIF RESULT == 3
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件종족 = 마법사족
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
		カウンタ ++
		SIF カウンタ < 素材数
			GOTO LOOP_POINT
		CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"汎数",0,1)

	ENDIF
ENDIF

