@CARDNAME_50203,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 나이트메어 아이즈 새크리파이스
	CASE "略称"
		RESULTS = 나이트메어아이즈
	CASE "カテゴリ"
		RESULTS:0 = 새크리파이스
ENDSELECT


@CARD_50203(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
ENDSELECT

RETURN 0
@CARDSUMMON_50203(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件R종족起動 = 1
素材条件종족:0 = 악마족
素材条件종족:1 = 미확인족
素材条件종족:2 = 마법사족

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,50203) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_50203(종류)
#DIM DYNAMIC 종류

PRINTL 종족이 다른 악마족 / 미확인족 / 마법사족 몬스터×２
PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,특수소환時,EX소환時,攻撃後誘発)
PRINTL ①：이 카드가 특수 소환된 경우、또는 이 카드가 전투를 한 배틀 종료시에 발동할 수 있다。
PRINTL 상대 필드의 몬스터 １장을 이 카드에 장착한다。
PRINTL 이 카드의 공격력 / 수비력은、이 카드의 효과로 장착되어있는 몬스터의 공격력 / 수비력만큼 오른다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：이 카드가 몬스터 전투를 하는 경우、그 ２장은 그 전투로는 파괴되지 않는다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：이 카드가 몬스터 존에 존재하는 한、
PRINTL 상대 몬스터는 다른 몬스터를 공격할 수 없다。


@CARDCAN_50203(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50203)
SIF RESULT == 1
	RETURN 0



IF 종류 == 특수소환時 || 종류 == 攻撃後誘発 || 종류 == EX소환時
	IF 종류 == 攻撃後誘発
		SIF ゾーン != "필드"
			RETURN 0
	ENDIF
	SIF 발동済_1(듀얼리스트,50203)
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件除去種 = 装備
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 종류 == 攻撃後誘発 && 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_50203(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID 


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 특수소환時 || 종류 == 攻撃後誘発 || 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50203,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		CALL CARD_EQUIP_MONSTER_ADV(듀얼리스트,ゾーン,場所,(1 + 2))
	ENDIF
ELSEIF 종류 == 지속효과
	IF 戦闘場所(듀얼리스트) == 場所
		IF 戦闘場所(듀얼리스트,1) != 5
			CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦耐")
			CALL STATCHANGE_EFFECT(듀얼리스트,"対面自身",戦闘場所(듀얼리스트,1),"戦耐")
		ENDIF
	ENDIF
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"攻誘")
ENDIF
