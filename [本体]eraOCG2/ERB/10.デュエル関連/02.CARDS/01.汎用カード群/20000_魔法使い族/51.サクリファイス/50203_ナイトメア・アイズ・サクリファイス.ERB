@CARDNAME_50203,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 나이트메어 아이즈 새크리파이스
	CASE "略称"
		RESULTS = 나이트메어아이즈
	CASE "カテゴリ"
		RESULTS:0 = 새크리파이스
ENDSELECT


@CARD_50203(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
ENDSELECT

RETURN 0
@CARDSUMMON_50203(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件R종족起動 = 1
素材条件종족:0 = 악마족
素材条件종족:1 = 미확인족
素材条件종족:2 = 마법사족

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,50203) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_50203(종류)
#DIM DYNAMIC 종류

PRINTL 종족が異なる악마족・미확인족・마법사족モンスター×２
PRINTL このカード名の①の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,특수소환時,攻撃後誘発)
PRINTL ①：このカードが특수소환した場合、またはこのカードが戦闘を行ったバトル終了時に발동できる。
PRINTL 상대フィールドのモンスター１体をこのカードに装備する。
PRINTL このカードの攻撃力・守備力は、このカードの효과で装備しているモンスターの攻撃力・守備力分アップする。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：このカードがモンスターと戦闘を行う場合、その２体はその戦闘では破壊されない。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：このカードがモンスターゾーンに存在する限り、
PRINTL このカード以外のフィールドのモンスターは攻撃できず、표시形式の변경もできない。


@CARDCAN_50203(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,50203)
SIF RESULT == 1
	RETURN 0



IF 종류 == 특수소환時 || 종류 == 攻撃後誘発
	SIF 발동済_1(듀얼리스트,50203)
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件除去種 = 装備
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_50203(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID 


CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 특수소환時 || 종류 == 攻撃後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,50203,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		CALL CARD_EQUIP_MONSTER_ADV(듀얼리스트,ゾーン,場所,(1 + 2))
	ENDIF
ELSEIF 종류 == 지속효과
	IF 戦闘場所(듀얼리스트) == 場所
		IF 戦闘場所(듀얼리스트,1) != 5
			CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦耐")
			CALL STATCHANGE_EFFECT(듀얼리스트,"対面自身",戦闘場所(듀얼리스트,1),"戦耐")
		ENDIF
	ENDIF
	CALL FULLRESET
	효과条件他所 = 1
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"戦無")
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"表固")

	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"戦無")
	CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"表固")
ENDIF
