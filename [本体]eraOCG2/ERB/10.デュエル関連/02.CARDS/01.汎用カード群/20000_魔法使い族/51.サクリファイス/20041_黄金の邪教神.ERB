@CARDNAME_20041,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 황금의 사교신
	CASE "略称"
		RESULTS = 황금의 사교신
	CASE "カテゴリ"
		RESULTS:0 = 없음
	CASE "検索皇カテゴリ"
		RESULTS = 새크리파이스
ENDSELECT


@CARD_20041(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	CASE "추가日"
		RETURN 2551006
ENDSELECT


@CARD_EXPLANATION_20041(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の②③の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：フィールドの表側표시のこのモンスターは「千眼の邪教神」として扱う。
CALLFORM CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ②：자신・상대ターンに、발동できる。
PRINTL 상대の손패を全て確認する。
PRINTL その後、상대の손패のモンスター１体を選び、상대フィールドに특수소환できる。
CALLFORM CARD_ABLE(3,필드→묘지,戦闘→묘지,破壊→묘지,손패→묘지,덱→묘지,제외時)
PRINTL ③：このカードが묘지へ送られた場合、または제외された場合に발동できる。
PRINTL 덱からレベル１モンスター１体か、「환술사」カード１枚を손패に加える。
PRINTL この효과で通常モンスターか의식モンスターを손패に加えた場合、
PRINTL さらに덱・묘지から「새크리파이스」カードか의식마법カード１枚を손패に加えることができる。


@CARDCAN_20041(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,20041)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_2(듀얼리스트,20041)
		RETURN 0
	SIF 손패数(対面者) < 1
		RETURN 0
	RETURN 1

ELSEIF GROUPMATCH(종류,필드→묘지,戦闘→묘지,破壊→묘지,손패→묘지,덱→묘지,제외時)
	SIF 발동済_3(듀얼리스트,20041)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件スーパーカテゴリ = 환술사
	효과条件レベル = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_20041(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,20041,2)
	IF RESULT == 0
		SIF 듀얼리스트 == "자신"
			PRINTL 손패を確認してください
		CALL FULLRESET
		효과条件任意 = 1
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"상대손패",ゾーン,場所)

		SIF 듀얼리스트 == "자신"
			PRINTL 특수소환するモンスターを選んでください
		CALL FULLRESET
		효과範囲상대손패 = 1
		효과条件任意 = 1
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"",,1)
	ENDIF

ELSEIF GROUPMATCH(종류,필드→묘지,戦闘→묘지,破壊→묘지,손패→묘지,덱→묘지,제외時)
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,20041,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件スーパーカテゴリ = 환술사
		효과条件レベル = 1
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			TRYCALLFORM CARD_{RESULT:1},"종류"
			SIF !MATCH(RESULT,通常モン,의식)
				RETURN 0
			
			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ = 새크리파이스
			효과条件スーパーカテゴリ = 의식마법
			효과条件任意 = 1
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF

ELSEIF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"変化元ID",20040)
ENDIF
