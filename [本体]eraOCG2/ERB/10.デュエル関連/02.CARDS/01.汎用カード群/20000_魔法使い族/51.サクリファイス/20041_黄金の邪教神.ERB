@CARDNAME_20041,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 황금의 사교신
	CASE "略称"
		RESULTS = 황금의 사교신
	CASE "カテゴリ"
		RESULTS:0 = 없음
	CASE "検索皇カテゴリ"
		RESULTS = 새크리파이스
ENDSELECT


@CARD_20041(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 0
	CASE "추가日"
		RETURN 2551006
ENDSELECT


@CARD_EXPLANATION_20041(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：필드의 앞면 표시인 이 몬스터는 "천개의 눈을 가진 사교신"으로 취급한다。
CALLFORM CARD_ABLE(2,필드起動,フリー誘発)
PRINTL ②：자신 / 상대 턴에、발동할 수 있다。
PRINTL 상대의 패를 전부 확인한다。
PRINTL 그 후、상대 패의 몬스터 １장을 골라、상대 필드에 특수 소환할 수 있다。
CALLFORM CARD_ABLE(3,필드→묘지,戦闘→묘지,破壊→묘지,손패→묘지,덱→묘지,제외時)
PRINTL ③：이 카드가 묘지로 보내진 경우、또는 제외된 경우에 발동할 수 있다。
PRINTL 덱에서 레벨１ 몬스터 １장 또는、"환술사" 카드 １장을 패에 넣는다。
PRINTL 이 효과로 일반 몬스터 또는 의식 몬스터를 패에 넣었을 경우、
PRINTL 추가로 덱 / 묘지에서 "새크리파이스" 카드 또는 의식 마법 카드 １장을 패에 넣을 수 있다。


@CARDCAN_20041(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,20041)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_2(듀얼리스트,20041)
		RETURN 0
	SIF 손패数(対面者) < 1
		RETURN 0
	RETURN 1

ELSEIF GROUPMATCH(종류,필드→묘지,戦闘→묘지,破壊→묘지,손패→묘지,덱→묘지,제외時)
	SIF 발동済_3(듀얼리스트,20041)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件スーパーカテゴリ = 환술사
	효과条件レベル = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_20041(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,20041,2)
	IF RESULT == 0
		SIF 듀얼리스트 == "자신"
			PRINTL 패를 확인해주세요
		CALL FULLRESET
		효과条件任意 = 1
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"상대손패",ゾーン,場所)

		SIF 듀얼리스트 == "자신"
			PRINTL 특수 소환할 몬스터를 선택해주세요
		CALL FULLRESET
		효과範囲상대손패 = 1
		효과条件任意 = 1
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"",,1)
	ENDIF

ELSEIF GROUPMATCH(종류,필드→묘지,戦闘→묘지,破壊→묘지,손패→묘지,덱→묘지,제외時)
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,20041,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件スーパーカテゴリ = 환술사
		효과条件レベル = 1
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			TRYCALLFORM CARD_{RESULT:1},"종류"
			SIF !MATCH(RESULT,通常モン,의식)
				RETURN 0
			
			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲묘지 = 1
			효과条件カテゴリ = 새크리파이스
			효과条件スーパーカテゴリ = 의식 마법
			효과条件任意 = 1
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF

ELSEIF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"変化元ID",20040)
ENDIF
