@CARDNAME_1733,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 도미나스 스파크
	CASE "略称"
		RESULTS = 정왕의 섬광
	CASE "カテゴリ"
		RESULTS:0 = 도미나스
ENDSELECT


@CARD_1733(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 260124
ENDSELECT

RETURN 0

@CARD_EXPLANATION_1733(종류)
#DIM DYNAMIC 종류

PRINTL このカード名のカードは１ターンに１枚しか발동できない。
PRINTL 상대が손패・묘지のモンスターの효과を발동したターン、このカードの발동は손패からもできる。
CALLFORM CARD_ABLE(1,발동誘発)
PRINTL ①：상대フィールドのモンスター１体を제외する。
PRINTL 자신の묘지に함정カードが存在しない場合、さらに상대は自身の손패からモンスター１体を特殊召喚できる。
PRINTL このカードを손패から발동した場合、발동後、
CALLFORM CARD_ABLE(20,永紋章起動)
PRINTL このデュエル中に자신は땅・물・화염・바람속성モンスターの효과を발동できない。


@CARDCAN_1733(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 효과制限達成
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,1733)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動 || 종류 == 마함起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,1733)
		RETURN 0
	SIF !GROUPMATCH(ゾーン,"손패","마함")
		RETURN 0
	IF ゾーン == "손패"
		SIF GET_PLAYER_INFO(듀얼리스트,"K9발동数",1) <= 0
			RETURN 0
	ELSEIF ゾーン == "마함"
		;ゾーン処理も設定済み
		CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ELSE
		RETURN 0
	ENDIF
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件除去種 = 제외
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_1733(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 묘지送カード,5
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動 || 종류 == 마함起動 || 종류 == フリー誘発
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1733,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"제외")
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종류 = 함정全般
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT != 1
			CALL FULLRESET
			효과範囲손패 = 1
			CALL CARD_SP_SUMMON_ADV(対面者,ゾーン,場所)
		ENDIF
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		IF ゾーン == "손패"
			CALL SET_PLAYER_INFO(듀얼리스트,"땅속성효과無効",2)
			CALL SET_PLAYER_INFO(듀얼리스트,"물속성효과無効",2)
			CALL SET_PLAYER_INFO(듀얼리스트,"화염속성효과無効",2)
			CALL SET_PLAYER_INFO(듀얼리스트,"바람속성효과無効",2)
			CALL CARD_EFFECT_D1USE(듀얼리스트,1733)
		ENDIF
	ENDIF
ENDIF
