@CARDNAME_91065,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 기브＆테이크
	CASE "略称"
		RESULTS = 기브＆테이크
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_91065(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 250927
ENDSELECT

RETURN 0

@CARD_EXPLANATION_91065(종류)
#DIM DYNAMIC 종류
CALLFORM CARD_ABLE(0,마함起動 ,フリー誘発)
PRINTL ①：자신의 묘지의 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 대상 묘지의 몬스터를 상대 필드에 수비 표시로 특수 소환한다。
PRINTL 그 후、자신 필드의 몬스터 １장을 골라、그 몬스터의 레벨을 턴 종료시까지 특수 소환한 몬스터의 원래 코스트만큼 올릴 수 있다。
PRINTL （코스트는 레벨 / 랭크 / 링크의 수치를 가리킨다）


@CARDCAN_91065(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,91065)
SIF RESULT == 1
	RETURN 0
IF 종류 == 마함起動 || 종류 == フリー誘発
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") == 3
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF



@CARDEFFECT_91065(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 選択カード_レベル

IF 종류 == 마함起動 || 종류 == フリー誘発
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91065)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件종류 = モン全般
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"守備표시",,1)
		IF RESULT == 1
			選択カード_ID = RESULT:1
			TRYCALLFORM CARDNAME_{選択カード_ID},"レベル"
			選択カード_レベル = RESULT
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)

			CALL FULLRESET
			효과範囲필드 = 1
			효과条件任意 = 1
			CALL CARD_GRANT_ADV(듀얼리스트,ゾーン,場所,"一星",選択カード_レベル)
		ENDIF
	ENDIF
ENDIF
