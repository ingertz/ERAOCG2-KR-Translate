@CARDNAME_91903,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 신내림의 외법
	CASE "略称"
		RESULTS = 신내림의 외법
	CASE "カテゴリ"
		RESULTS:0 = 없음
		RESULTS:1 = 게임 오리지널
ENDSELECT


@CARD_91903(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 251025
ENDSELECT

RETURN 0

@CARD_EXPLANATION_91903(종류)
#DIM DYNAMIC 종류

PRINTL 상대 필드에 신속성 또는 환신야수족 몬스터가 존재하는 경우、이 카드는 패에서 발동할 수 있다。
CALLFORM CARD_ABLE(0,마함起動,フリー誘発)
PRINTL ①：상대 필드의 몬스터（앞면 표시）의 모든 같은 이름의 카드를、각각 １장씩 상대의 묘지에 추가한다。
PRINTL 
PRINTL 
PRINTL 

@CARDCAN_91903(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,91903)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	효과条件スーパー속성 = 신속성
	효과条件종족 = 환신야수족
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 1
		IF ゾーン == "마함"
			CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT != 1
				RETURN 0
		ELSEIF ゾーン == "손패"

		ELSE
			RETURN 0
		ENDIF
	ELSE
		SIF ゾーン != "마함"
			RETURN 0
		CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件표시 = 表側표시
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ENDIF
	RETURN 1
ENDIF


@CARDEFFECT_91903(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC コピーカード_ID,5
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91903)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		FOR カウンタ,0,5
			SIF GETVAR(@"%対面者%_필드:カウンタ") == -1
				CONTINUE
			SIF GETVAR(@"%対面者%_MZ_表:カウンタ") == 3
				CONTINUE
			コピーカード_ID:カウンタ = GETVAR(@"%対面者%_필드:カウンタ")
		NEXT

		FOR カウンタ,0,5
			SIF コピーカード_ID:カウンタ != 0
				CALL CARD_GENERATE_GY(対面者,コピーカード_ID:カウンタ)
		NEXT
	ENDIF
ENDIF
