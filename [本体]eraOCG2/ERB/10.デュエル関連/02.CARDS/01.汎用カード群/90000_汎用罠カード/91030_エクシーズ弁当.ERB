@CARDNAME_91030,参照先
;ココで지정 카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 엑시즈 도시락
	CASE "略称"
		RESULTS = 엑시즈 도시락
	CASE "カテゴリ"
		RESULTS:0 = 엑시즈
ENDSELECT


@CARD_91030(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
ENDSELECT

RETURN 0

@CARD_EXPLANATION_91030(종류)
#DIM DYNAMIC 종류

CALLFORM CARD_ABLE(0,효과後誘発)
PRINTL ①：상대의 몬스터가 묘지로 보내진 경우、
PRINTL 자신 필드의 Ｘ몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 상대 묘지에서 몬스터 １장을 고르고 제외하고、대상 몬스터의 Ｘ소재를 １개 늘린다。
PRINTL 그 후, 식사 페이즈에 들어간다 (듀얼 중 1번만).
CALLFORM CARD_ABLE(0,묘지起動 ,フリー誘発)
PRINTL ②：묘지의 이 카드를 제외하고、ＥＸ덱에서 특수 소환된 필드의 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터의 표시 형식을 변경한다.


@CARDCAN_91030(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 효과制限달성
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,91030)
SIF RESULT == 1
	RETURN 0
IF 종류 == 효과後誘発
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = 엑시즈
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"묘지送り全般+H",1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 묘지起動 || 종류 == フリー誘発
	SIF ゾーン != "묘지"
		RETURN 0
	CALL FULLRESET
	SIF 듀얼리스트 == "자신"
		효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件召種 = 召種EX덱
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_91030(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 味付け
#DIM DYNAMIC 材料
#DIM DYNAMIC 具の量
#DIM DYNAMIC 회복量
#DIM DYNAMIC お腹空き
#DIM DYNAMIC 満腹感

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 효과後誘発
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91030)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과条件종류 = 엑시즈
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			CALL FULLRESET
			효과範囲상대묘지 = 1
			효과条件종류 = モン全般
			효과条件行先플래그 = 제외行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				選択カード_ID = RESULT:1
				CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"Ｘ",1)

				IF 듀얼리스트 == "자신" && 발동済_D1(듀얼리스트,91030) == 0
					PRINTL
					PRINTW 식사 페이즈로 들어갑니다
					PRINTL
					PRINTL
					TRYCALLFORM CARD_{選択カード_ID}("속성")
					味付け = RESULT
					TRYCALLFORM CARD_{選択カード_ID}("종족")
					材料 = RESULT
					TRYCALLFORM CARD_{選択カード_ID}("攻撃力")
					具の量 = RESULT
					회복量 = 具の量 / 3

					PRINTW 오늘의 도시락은……
					PRINTL
					IF 具の量 <= 1
						PRINTW 텅 비었었다……
						PRINTL
						PRINTW 식사 페이즈를 종료합니다
						RETURN 0
					ENDIF
					IF 味付け == 화염속성
						PRINT 불을 뿜을 정도로 매운 
					ELSEIF 味付け == 물속성
						PRINT 꽝꽝 얼어있는 
					ELSEIF 味付け == 땅속성
						PRINT 염분 듬뿍인 
					ELSEIF 味付け == 바람속성
						PRINT 목넘김이 시원한 
					ELSEIF 味付け == 어둠속성
						PRINT 상자 가득 김에 둘러싸인 
					ELSEIF 味付け == 빛속성
						PRINT 직시할 수 없을 정도로 빛나는 
					ENDIF
					IF 材料 == 마법사족
						PRINTL 케미컬 도시락이다!
						PRINTW 이상한 색의 음식이 가득 들어있다！
					ELSEIF 材料 == 드래곤족
						PRINTL 드래곤 도시락이다!
						PRINTW 굉장해！상자 반을 거대한 고기가 점령하고있다！
					ELSEIF 材料 == 언데드족
						PRINTL 세메터리 도시락이다!
						PRINTW 독늪 소스가 굉장한 녹색이다……
					ELSEIF 材料 == 전사족
						PRINTL 노동자 도시락이다!
						PRINTW 고기든 야채든 가득 들어있다！
					ELSEIF 材料 == 기계족
						PRINTL 로봇 도시락이다!
						PRINTW 많은 음식을 조합해보자！
					ELSEIF 材料 == 야수족
						PRINTL 고기 도시락이다!
						PRINTW 고기、고기、양배추、고기！이렇게까지 고기고기면 기분좋다！
					ELSEIF 材料 == 비행야수족
						PRINTL 카라아게 도시락이다!
						PRINTW 이거라고、이거！
					ELSEIF 材料 == 비늘야수족
						PRINTL 도마뱀 도시락이다!
						PRINTW 뱀의 머리가 들어있다……！
					ELSEIF 材料 == 악마족
						PRINTL 어린이 도시락이다!
						PRINTW 과자가 90%！
					ELSEIF 材料 == 천사족
						PRINTL 화이트 도시락이다!
						PRINTW 엄청나！전부 하얘！
					ELSEIF 材料 == 곤충족
						PRINTL 인섹트 도시락이다!
						PRINTW 곤충이 그대로 들어있는건 호불호가 있을것……
					ELSEIF 材料 == 원소정령족
						PRINTL 삼색 도시락이다!
						PRINTW 이득본것같아！
					ELSEIF 材料 == 식물족
						PRINTL 야채 도시락이다!
						PRINTW 야채 말곤 쌀밖에 없어！
					ELSEIF 材料 == 사이킥족
						PRINTL 최면 도시락이다!
						PRINTW 뭔가……엄청 먹고싶어졌다！
					ELSEIF 材料 == 사이버스족
						PRINTL 링크 도시락이다!
						PRINTW 링크앞의 음식과 같이 먹자！
					ELSEIF 材料 == 바다생물족
						PRINTL 해산물 도시락이다!
						PRINTW 새우의 주장이 격렬하다！
					ENDIF
					PRINTL
					PRINTL
					PRINTBUTTON @"【잘먹겠습니다！】",1
					PRINTL
					BINPUT
					PRINTL
					CALL RECOVER_PERMIL(MASTER,회복量,"체력",1)
					CALL RECOVER_PERMIL(MASTER,회복量,"기력",1)
					お腹空き = MAXBASE:MASTER:체력 - BASE:MASTER:체력
					IF 회복量 * 3 > お腹空き
						PRINTW 조금 많나……？
						満腹感 ++
					ELSE
						PRINTW 맛있다！맛있다！
					ENDIF
					PRINTL
					CALL RECOVER_PERMIL(MASTER,회복量,"체력",1)
					CALL RECOVER_PERMIL(MASTER,회복量,"기력",1)
					お腹空き = MAXBASE:MASTER:체력 - BASE:MASTER:체력
					IF 회복量 * 2 > お腹空き
						IF 満腹感 == 1
							PRINTW 조금 맵기 시작했다……
						ELSE
							PRINTW 조금 많나……？
						ENDIF
						満腹感 ++
					ELSE
						PRINTW 전혀 질리지 않아！아직 완전 먹을수 있다구！
					ENDIF
					CALL RECOVER_PERMIL(MASTER,회복量,"체력",1)
					CALL RECOVER_PERMIL(MASTER,회복量,"기력",1)
					お腹空き = MAXBASE:MASTER:체력 - BASE:MASTER:체력
					IF 회복量 > お腹空き
						IF 満腹感 == 2
							PRINTW 힘들다……이제 먹기싫어……
							PRINTL ！？
							PRINTW 식당의 아주머니가 이쪽을 보고있다！남길수없어！
						ELSE
							PRINTW 윽……너무 많이 먹었을지도 모르겠다……힘들어……
						ENDIF
						満腹感 ++
					ELSE
						PRINTW 아아、벌써 반찬이 없어……
					ENDIF
					PRINTW …………。
					PRINTL
					SETCOLOR C_YELLOW
					PRINTW 완식！
					RESETCOLOR
					PRINTL
					PRINTL
					PRINTBUTTON @"【잘먹었습니다！】",1
					PRINTL
					BINPUT
					IF 満腹感 > 0
						PRINTW 일단 완식은 했지만, 조금 피곤해졌다……
						BASE:MASTER:체력 -= 500
						BASE:MASTER:기력 -= 500
					ELSE
						PRINTW 매우 만족스러운 맛이었다！
					ENDIF
					CALL CARD_EFFECT_USE(듀얼리스트,91030,20)
					PRINTL
					PRINTL
					PRINTW 식사 페이즈를 종료합니다
				ENDIF
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 묘지起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91030)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과추가종류 = 3
		효과条件召種 = 召種EX덱
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"両필드単体",場所,"표시변경")
	ENDIF
ENDIF
