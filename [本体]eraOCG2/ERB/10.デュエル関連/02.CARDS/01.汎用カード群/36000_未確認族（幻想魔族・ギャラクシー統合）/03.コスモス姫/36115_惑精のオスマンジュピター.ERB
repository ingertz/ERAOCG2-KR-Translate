@CARDNAME_36115,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 혹정의 오스만쥬피터
	CASE "略称"
		RESULTS = 혹정의 목성
	CASE "カテゴリ"
		RESULTS:0 = 코스모스터
	CASE "検索用カテゴリ"
		RESULTS:0 = 코스모스 공주
ENDSELECT


@CARD_36115(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "외부자"
		RETURN 0
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 미확인족
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 900
	CASE "守備力"
		RETURN 1600
	CASE "추가日"
		RETURN 251018
ENDSELECT

RETURN 0

@CARD_EXPLANATION_36115(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 ①②의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,소환時,특수소환時)
PRINTL ①：이 카드가 소환 / 특수 소환된 경우에 발동할 수 있다。
PRINTL 자신의 묘지에서 "코스모스터" 몬스터 １장을 수비 표시로 특수 소환한다。
CALLFORM CARD_ABLE(2,戦闘→묘지,破壊→묘지)
PRINTL ②：이 카드가 전투 / 효과로 파괴된 경우、또는 융합 소재가 된 경우에 발동할 수 있다。
PRINTL 자신 필드의 "코스모스터" 몬스터 １장을 파괴하고、묘지 / 제외상태인 이 카드를 특수 소환한다。


@CARDCAN_36115(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,36115)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_1(듀얼리스트,36115)
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 코스모스터
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지 || 종류 == F素材時효과
	SIF 발동済_2(듀얼리스트,36115)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,36115,ゾーン,1)
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 코스모스터
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_36115(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード속성
#DIM DYNAMIC 条件달성

IF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,36115,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 코스모스터
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"守備표시")
	ENDIF

ELSEIF 종류 == 戦闘→묘지 || 종류 == 破壊→묘지 || 종류 == F素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,36115,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 코스모스터
		효과条件行先플래그 = 破壊行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			IF ゾーン == "묘지"
				효과範囲묘지 = 1
			ELSEIF ゾーン == "제외"
				효과範囲제외 = 1
			ENDIF
			효과条件名前 = 혹정의 오스만쥬피터
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF

