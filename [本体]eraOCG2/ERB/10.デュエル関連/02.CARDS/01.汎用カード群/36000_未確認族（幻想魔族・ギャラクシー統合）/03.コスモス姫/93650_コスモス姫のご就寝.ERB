@CARDNAME_93650,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 코스모스 공주의 취침
	CASE "略称"
		RESULTS = 우주희의 취침
	CASE "カテゴリ"
		RESULTS:0 = 코스모스 공주
ENDSELECT


@CARD_93650(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 251018
ENDSELECT

RETURN 0

@CARD_EXPLANATION_93650(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 1턴에 1번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,효과後誘発)
PRINTL ①：자신 필드에 미확인족 몬스터가 존재하고、상대가 몬스터를 소환 / 특수 소환한 경우에 발동할 수 있다。
PRINTL 그 몬스터를 파괴한다。
PRINTL 그 후、자신 필드에 "코스모스 공주" 몬스터가 존재하는 경우、
PRINTL 추가로 자신은 덱에서 ２장 드로우할 수 있다。
CALLFORM CARD_ABLE(2,戦破壊→묘지)
PRINTL ②：필드의 이 카드가 "코스모스 공주" 몬스터의 효과로 파괴된 경우에 발동할 수 있다。
PRINTL 이 카드를 자신 필드에 세트한다。
PRINTL 이 효과로 세트한 이 카드는 세트한 턴에도 발동할 수 있다。

@CARDCAN_93650(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,93650)
SIF RESULT == 1
	RETURN 0

IF 종류 == 효과後誘発
	;ゾーン処理も설정済み
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF FINAL_SUMMON_TARGET(듀얼리스트,1) == 5 
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종족 = 미확인족
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 戦破壊→묘지
	SIF 발동済_2(듀얼리스트,73606)
		RETURN 0
	SIF 묘지送り종류 != "破壊"
		RETURN 0
	TRYCALLFORM CARDNAME_{処理中_효과ID}("カテゴリ")
	SIF !MATCH(RESULTS,"코스모스 공주")
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_93650(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 효과先


IF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,93650,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		효과先 = FINAL_SUMMON_TARGET(듀얼리스트,1)
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"自動処理",효과先,"묘지")
		IF RESULT == 1
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件カテゴリ = 코스모스 공주
			효과条件표시 = 表側표시
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT != 1
				RETURN 0
			SIF 듀얼리스트 == "자신"
				PRINTL 드로우하시겠습니까？
			CALL YN_CHOICE(듀얼리스트)
			SIF RESULT == はい
				CALL CARDDRAW_BASIC(듀얼리스트,2)
		ENDIF
	ENDIF

ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,93650,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 코스모스 공주의 취침
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"使化裏側표시")
	ENDIF
ENDIF
