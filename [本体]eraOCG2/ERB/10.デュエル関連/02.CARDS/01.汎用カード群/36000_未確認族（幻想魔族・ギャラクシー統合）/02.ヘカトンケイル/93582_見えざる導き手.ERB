@CARDNAME_93582,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 바이트 알 헤카톤케일
	CASE "略称"
		RESULTS = 안보이는이끄는손
	CASE "カテゴリ"
		RESULTS:0 = 헤카톤케일
ENDSELECT


@CARD_93582(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속함정
	CASE "추가日"
		RETURN 260124
ENDSELECT

RETURN 0

@CARD_EXPLANATION_93582(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,마함起動,フリー誘発)
PRINTL ①：자신フィールドの、「헤카톤케일」モンスターまたは
PRINTL 元々の持ち主が상대であるモンスター１体をリリースして발동できる。
PRINTL 상대フィールドのモンスター１体のコントロールを得る。
CALLFORM CARD_ABLE(0,ターン終了時強制)
PRINTL ②：자신エンドフェイズに발동する。
PRINTL 자신フィールドのカード１枚を묘지へ送る。


@CARDCAN_93582(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 효과制限달성
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,93582)
SIF RESULT == 1
	RETURN 0

IF (종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")) && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件スーパーカテゴリ = 헤카톤케일
	효과条件所有 = 2
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件除去種 = 強奪
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF (종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")) && GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == ターン終了時強制
	SIF ゾーン != "마함"
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_93582(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 묘지送カード,5
#DIM DYNAMIC カウンタ
#DIM DYNAMIC ダメージ量
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF (종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")) && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	$USE_EFFECT
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,93582,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件スーパーカテゴリ = 헤카톤케일
		효과条件所有 = 2
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"強奪")
		ENDIF
	ENDIF
ELSEIF (종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")) && GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
	;カード발동＆設置まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,93582)
	IF RESULT == 0
		TRYCALLFORM CARDCAN_93582(듀얼리스트,마함起動,"마함",場所)
		IF RESULT == 1
			PRINTFORML 
			PRINTFORML 今、효과を使用しますか？
			PRINTFORML 
			CALL YN_CHOICE(듀얼리스트)
			SIF RESULT == 0
				GOTO USE_EFFECT
		ENDIF
	ENDIF
ELSEIF 종류 == ターン終了時強制
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
ENDIF
