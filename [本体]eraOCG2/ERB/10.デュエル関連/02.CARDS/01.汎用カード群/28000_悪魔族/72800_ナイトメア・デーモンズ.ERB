@CARDNAME_92800,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 나이트메어 데몬즈
	CASE "略称"
		RESULTS = 나이트메어데몬즈
	CASE "カテゴリ"
		RESULTS:0 = 데몬
ENDSELECT


@CARD_92800(参照先)
;名前専用
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "生成カード"
		RETURN 192800
ENDSELECT

RETURN 0

@CARD_EXPLANATION_92800(종류)
#DIM DYNAMIC 종류
CALLFORM CARD_ABLE(0,마함起動 ,フリー誘発)
PRINTL ①：자신 필드의 몬스터 1마리를 릴리스하고 발동할 수 있다.
PRINTL 상대 필드에 "나이트메어 데몬 토큰"
PRINTL (악마족 어둠 속성 레벨 6 공격력 / 수비력 2000) 3마리를 공격 표시로 특수 소환한다.
PRINTL 이 토큰이 파괴되었을 때, 이 토큰의 컨트롤러는
PRINTL 1마리당 800 포인트 데미지를 받는다.
PRINTL 

@CARDCAN_92800(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,92800)
SIF RESULT == 1
	RETURN 0
IF 종류 == 마함起動 || 종류 == フリー誘発
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF モンスター数(対面者) >= 3
		RETURN 0
	SIF モンスター数(듀얼리스트) == 0
		RETURN 0
	RETURN 1

ENDIF


@CARDEFFECT_92800(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92800)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_GENERATE(対面者,192800,"攻撃표시")
			CALL FULLRESET
			CALL CARD_GENERATE(対面者,192800,"攻撃표시")
			CALL FULLRESET
			CALL CARD_GENERATE(対面者,192800,"攻撃표시")
		ENDIF
	ENDIF
ENDIF


