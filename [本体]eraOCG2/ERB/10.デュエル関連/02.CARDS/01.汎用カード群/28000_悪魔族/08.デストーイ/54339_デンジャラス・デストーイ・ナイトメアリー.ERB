@CARDNAME_54339,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 데인저러스 데스완구 나이트메어리
	CASE "略称"
		RESULTS = DDW 나이트메어
	CASE "カテゴリ"
		RESULTS:0 = 데스완구
	CASE "検索カテゴリ"
		RESULTS:0 = 퍼니멀
		RESULTS:1 = 에지임프
ENDSELECT


@CARD_54339(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 2000
	CASE "守備力"
		RETURN 3000
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251114
ENDSELECT

RETURN 0

@CARDSUMMON_54339(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 3
素材条件종류 = トークン以外

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = 에지임프
ELSEIF EX参照 >= 10
	素材条件カテゴリ = 퍼니멀
ENDIF

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,54339)
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_54339(종류)
#DIM DYNAMIC 종류

PRINTL "에지임프" 몬스터＋"퍼니멀" 몬스터×２
PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,攻守変動)
PRINTL ①：이 카드의 공격력은 자신의 묘지 / 제외된 이 카드의 천사족 / 악마족 몬스터의 수×３００만큼 오른다。
CALLFORM CARD_ABLE(0,필드起動)
PRINTL ②：자신 메인 페이즈에 발동할 수 있다。
PRINTL 덱에서 "데스완구" "퍼니멀" "에지임프" 몬스터를 합계 ４장까지 묘지로 보낸다。
CALLFORM CARD_ABLE(0,발동誘発)
PRINTL ③：상대의 효과가 발동했을 때、ＥＸ덱에서 "데스완구" 몬스터 １장을 제외하고 발동할 수 있다。
PRINTL 그 효과를 무효로 하고、제외한다。


@CARDCAN_54339(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,54339)
SIF RESULT == 1
	RETURN 0

IF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF ゾーン != "필드"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	;1ターンに1度の制限チェック
	SIF 발동済_2(듀얼리스트,54339)
		RETURN 0
	;덱に대상カードがあるかチェック
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = モン全般
	효과条件カテゴリ:0 = 데스완구
	효과条件カテゴリ:1 = 퍼니멀
	효과条件カテゴリ:2 = 에지임프
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF ゾーン != "필드"
		RETURN 0
	;1ターンに1度の制限チェック
	SIF 발동済_3(듀얼리스트,54339)
		RETURN 0
	;EX덱に「데스완구」モンスターがあるかチェック
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件カテゴリ = 데스완구
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	;상대の효과발동をチェック（タイラント・ドラゴンと同じ方式）
	CALL FULLRESET
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_54339(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 天使悪魔数
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 破壊レベル

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 攻守変動
	;묘지の천사족・악마족モンスター数をカウント
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종족 = 천사족
	효과条件종족:1 = 악마족
	효과条件종류 = モン全般
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	天使悪魔数 = RESULT

	;제외ゾーンの천사족・악마족モンスター数をカウント
	CALL FULLRESET
	효과範囲제외 = 1
	효과条件종족 = 천사족
	효과条件종족:1 = 악마족
	효과条件종류 = モン全般
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	天使悪魔数 += RESULT

	;攻撃力アップを付与
	攻撃力修正 = 天使悪魔数 * 300
	CALL STATCHANGE_BASIC(듀얼리스트,"自身",場所,攻撃力修正)

ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,54339,2)
	IF RESULT == 0
		;덱에서合計4体まで묘지へ送る
		FOR カウンタ, 0, 4
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件종류 = モン全般
			효과条件カテゴリ:0 = 데스완구
			효과条件カテゴリ:1 = 퍼니멀
			효과条件カテゴリ:2 = 에지임프
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT != 1
				BREAK
			SIF 듀얼리스트 == "자신"
				PRINTFORML {カウンタ + 1}장째를 묘지로 보내시겠습니까？
			CALL YN_CHOICE(듀얼리스트)
			SIF RESULT != はい
				BREAK
			CALL CARD_ADD_GY_BASIC(듀얼리스트,"덱",ゾーン,場所)
		NEXT
	ENDIF
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,54339,3)
	IF RESULT == 0
		;EX덱에서「데스완구」モンスター1体を제외
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件カテゴリ = 데스완구
		효과条件종류 = モン全般
		효과条件行先플래그 = 完全제외行き
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
		IF RESULT == 1
			;상대の발동した효과を無効にし、제외する
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"제외")
		ENDIF
	ENDIF
ENDIF
