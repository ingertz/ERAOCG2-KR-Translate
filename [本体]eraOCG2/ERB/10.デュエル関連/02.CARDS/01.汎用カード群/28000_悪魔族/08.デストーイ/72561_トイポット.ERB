@CARDNAME_72561,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 토이팟
	CASE "略称"
		RESULTS = 토이팟
	CASE "カテゴリ"
		RESULTS:0 = 토이팟
ENDSELECT


@CARD_72561(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속마법
ENDSELECT

RETURN 0

@CARD_EXPLANATION_72561(종류)
#DIM DYNAMIC 종류

CALL CARD_ABLE(1,마함起動)
PRINTL ①：１턴에 １번、패를 １장 버리고 발동할 수 있다。
PRINTL 자신은 덱에서 １장 드로우하고、서로는 확인한다。
PRINTL 확인한 카드가 "퍼니멀" 몬스터였을 경우、
PRINTL 패에서 몬스터 １장을 특수 소환할 수 있다。
PRINTL 아니었을 경우、그 드로우 한 카드를 버린다。
CALL CARD_ABLE(2,필드→묘지,破壊→묘지)
PRINTL ②：이 카드가 묘지로 보내진 경우에 발동할 수 있다。
PRINTL 덱에서 "에지임프" 몬스터 １장 또는 "퍼니멀" 몬스터 １장을 패에 넣는다。

@CARDCAN_72561(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72561)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 14
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드→묘지 || 종류 == 戦闘→묘지 || 종류 == 破壊→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ:0 = 에지임프
	효과条件カテゴリ:1 = 퍼니멀
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_72561(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 選択カード名前

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72561,10)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
		IF RESULT == 1
			;덱トップを確認
			選択カード = GETVAR(@"%듀얼리스트%_덱:0")
			SIF 듀얼리스트 == "자신"
				TRYCALLFORM CARD_UI(選択カード)
				PRINTW
			;カテゴリ판정を先に行う
			TRYCALLFORM CARDNAME_{選択カード}("カテゴリ")
			カウンタ = GROUPMATCH(RESULTS,"퍼니멀")
			CALL CARDDRAW_BASIC(듀얼리스트,1)

			IF カウンタ
				SIF 듀얼리스트 == "자신"
					PRINTFORML 드로우 한 카드는 "퍼니멀" 몬스터입니다！
				;손패から특수소환可能
				CALL FULLRESET
				효과範囲손패 = 1
				효과条件종류 = モン全般
				효과条件소환可 = 1
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				IF RESULT == 1
					SIF 듀얼리스트 == "자신"
						PRINTL 패에서 몬스터를 특수 소환하시겠습니까？
					CALL YN_CHOICE(듀얼리스트)
					IF RESULT == はい && 듀얼리스트 == "자신"
						CALL FULLRESET
						효과範囲손패 = 1
						효과条件종류 = モン全般
						CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
					ENDIF
				ENDIF
			ELSE
				SIF 듀얼리스트 == "자신"
					PRINTFORML "퍼니멀" 몬스터가 아닙니다。버립니다。
				;ドローしたカードを捨てる
				CALL FULLRESET
				효과範囲손패 = 1
				효과条件ID = 選択カード
				CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72561)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF
ELSEIF 종류 == 필드→묘지 || 종류 == 戦闘→묘지 || 종류 == 破壊→묘지 || 종류 == 손패→묘지 || 종류 == 덱→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72561,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ:0 = 에지임프
		효과条件カテゴリ:1 = 퍼니멀
		효과条件종류 = モン全般
		CALL CARD_ADD_BASIC(듀얼리스트,"덱",ゾーン,場所)
	ENDIF
ENDIF
