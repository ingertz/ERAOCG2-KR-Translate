@CARDNAME_28264,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 퍼니멀 윙
	CASE "略称"
		RESULTS = Fur 윙
	CASE "カテゴリ"
		RESULTS:0 = 퍼니멀
	CASE "検索カテゴリ"
		RESULTS:0 = 데스완구
		RESULTS:1 = 에지임프
ENDSELECT


@CARD_28264(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 100
	CASE "守備力"
		RETURN 100
	CASE "추가日"
		RETURN 251114
ENDSELECT
RETURN 0

@CARD_EXPLANATION_28264(종류)
#DIM DYNAMIC 종류

PRINTL "퍼니멀 윙"의 효과는 1턴에 1번밖에 사용할 수 없다。
CALL CARD_ABLE(1,묘지起動)
PRINTL ①：자신 필드에 "토이팟"이 존재하는 경우、묘지의 이 카드를 제외하고、
PRINTL 자신 묘지의 "퍼니멀" 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터를 제외하고、자신은 덱에서 １장 드로우한다。
PRINTL 그 후、이하의 효과를 적용할 수 있다。
PRINTL ●자신 필드의 "토이팟" １장을 골라 묘지로 보내고、
PRINTL 자신은 덱에서 １장 드로우한다。

@CARDSUMMON_AA_28264


@CARDCAN_28264(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,28264)
SIF RESULT == 1
	RETURN 0

IF 종류 == 묘지起動
	SIF 발동済_1(듀얼리스트,28264)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과条件名前 = 토이팟
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 퍼니멀
	효과条件他所 = 1
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_28264(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28264,1)
	IF RESULT == 0
		;퍼니멀 윙自身を제외
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,제외行き)
		;묘지の퍼니멀モンスターを選んで제외
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 퍼니멀
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			;ドロー
			CALL CARDDRAW_BASIC(듀얼리스트,1)
			PRINTL 자신 필드의 "토이팟"을 묘지로 보내고、한장 더 드로우 하시겠습니까？
			CALL YN_CHOICE(듀얼리스트)
			IF RESULT == はい
				CALL FULLRESET
				효과範囲필드 = 1
				효과範囲마함 = 1
				효과条件カテゴリ = 토이팟
				CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
				IF RESULT == 1
					CALL CARDDRAW_BASIC(듀얼리스트,1)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
