@CARDNAME_54333,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 데스완구 시저 타이거
	CASE "略称"
		RESULTS = DW 시저타이거
	CASE "カテゴリ"
		RESULTS:0 = 데스완구
	CASE "検索カテゴリ"
		RESULTS:0 = 퍼니멀
		RESULTS:1 = 에지임프
ENDSELECT


@CARD_54333(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 1900
	CASE "守備力"
		RETURN 1200
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251114
ENDSELECT

RETURN 0

@CARDSUMMON_54333(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 99
素材条件数自由 = 1
素材条件素材数起動 = 1

IF EX参照 == 0 || EX参照 == 1
	素材条件名前 = 에지임프 시저
ELSEIF EX参照 >= 10
	素材条件カテゴリ = 퍼니멀
ENDIF

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,54333)
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_54333(종류)
#DIM DYNAMIC 종류

PRINTL "에지임프 시저"＋"퍼니멀" 몬스터 １장 이상
CALLFORM CARD_ABLE(0,EX소환時)
PRINTL ①："데스완구 시저 타이거"는 자신 필드에 １장밖에 앞면 표시로 존재할 수 없다。
PRINTL ②：이 카드가 융합 소환에 성공했을 때、발동할 수 있다。
PRINTL 이 카드의 융합 소재로 이 카드의 융합 소재로 사용한 몬스터의 수만큼 필드의 카드를 파괴한다。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ③：이 카드가 몬스터 존에 존재하는 한、자신 필드의 "데스완구" 몬스터의 공격력은、
PRINTL 자신 필드의 "퍼니멀" 몬스터 및 "데스완구" 몬스터의 수×３００만큼 오른다。


@CARDCAN_54333(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 素材数

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,54333)
SIF RESULT == 1
	RETURN 0

IF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == EX소환時
	RETURN 1
ENDIF

@CARDEFFECT_54333(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 素材数
#DIM DYNAMIC 퍼니멀数
#DIM DYNAMIC 데스완구数
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 攻守変動
	;フィールドの「퍼니멀」の数をカウント
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 퍼니멀
	효과条件종류 = モン全般
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	퍼니멀数 = RESULT

	;フィールドの「데스완구」の数をカウント
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 데스완구
	효과条件종류 = モン全般
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	데스완구数 = RESULT

	;「데스완구」モンスター全体に攻撃力アップを付与
	CALL FULLRESET
	효과条件カテゴリ = 데스완구
	攻撃力修正 = (퍼니멀数 + 데스완구数) * 300
	CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,攻撃力修正)

ELSEIF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,54333)
	IF RESULT == 0
		素材数 = GETVAR(@"%듀얼리스트%_MZ_汎数:場所")
		CALL FULLRESET
		효과条件複数 = 100 - 素材数
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"両全場単体",場所,"묘지")
	ENDIF
ENDIF
