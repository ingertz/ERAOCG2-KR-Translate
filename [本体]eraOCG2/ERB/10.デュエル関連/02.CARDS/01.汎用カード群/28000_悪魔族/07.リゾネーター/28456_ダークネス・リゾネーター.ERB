@CARDNAME_28456,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 다크니스 레조네이터
	CASE "略称"
		RESULTS = 다크니스 Res
	CASE "カテゴリ"
		RESULTS:0 = 레조네이터
		RESULTS:1 = 레드 데몬
ENDSELECT


@CARD_28456(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	;효과モン/通常モン/의식/융합/싱크로/엑시즈/링크/초차원
	CASE "종류"
		RETURN 효과モン
	;어둠속성/빛속성/땅속성/물속성/화염속성/바람속성
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 1300
	CASE "守備力"
		RETURN 300
	CASE "튜너"
		RETURN 1
	CASE "추가日"
		RETURN 260124
ENDSELECT
RETURN 0

@CARD_EXPLANATION_28456(종류)
#DIM DYNAMIC 종류


PRINTL 이 카드명의 ①②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：EX덱の「레드 데몬즈 드래곤」１장을 상대에게 보여주고 발동할 수 있다。
PRINTL 이 카드를 패에서 특수 소환한다。이 턴、자신은 SモンスターしかEX덱에서 특수 소환할 수 없다。
CALLFORM CARD_ABLE(2,특수소환時)
PRINTL ②：이 카드가 특수 소환된 경우에 발동할 수 있다。
PRINTL 이 턴、자신은 일반 소환에 더해 １번만 、자신 메인 페이즈에 「레조네이터」몬스터 １장을 소환할 수 있다。
CALLFORM CARD_ABLE(3,필드起動)
PRINTL ③：자신 필드의 튜너を임의의 수 만큼 대상として발동할 수 있다。
PRINTL その몬스터의 レベルを１にする。


@CARDCAN_28456(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,28456)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,28456)
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,28456,"손패")
	SIF RESULT == 1
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件名前 = 레드 데몬즈 드래곤
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1	

ELSEIF 종류 == 특수소환時
    SIF 발동済_2(듀얼리스트,28456)
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動
    SIF 발동済_3(듀얼리스트,28456)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
    CALL FULLRESET
	효과範囲필드 = 1
	CALL 효과条件レベル_ADV(1,"以外")
	효과条件튜너 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1


ELSEIF 종류 == 短紋章起動
	RETURN 1
	

ENDIF

@CARDEFFECT_28456(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択횟수

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28456,1)
	IF RESULT == 0
	    CALL FULLRESET
		효과範囲EX덱 = 1
	    효과条件名前 = 레드 데몬즈 드래곤
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 9999
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)

			EX소환可能종류 = 싱크로
			CALL CARD_EX_RESTRICTION(듀얼리스트)
		ENDIF
	ENDIF

ELSEIF 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28456,2)
	IF RESULT == 0
		CALL CARD_RESERV(듀얼리스트,28456,短紋章予約)
	ENDIF

ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28456,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件튜너 = 1
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		選択횟수 = RESULT

		FOR カウンタ,0,選択횟수
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件종류 = レベル持ち
			효과条件튜너 = 1
			CALL 효과条件レベル_ADV(1,"以外")
			효과条件표시 = 表側표시
			효과条件任意 = 1
			CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		    選択カード = RESULT
		    IF 選択カード != 9999
			    CALL SET_FIELD_INFO(듀얼리스트,"필드",選択カード,"永星",1,1)
		    ENDIF
		NEXT

	ENDIF

ELSEIF 종류 == 短紋章起動
	CALL FULLRESET
	효과条件カテゴリ = 레조네이터
	CALL STATCHANGE_HAND(듀얼리스트,"全体",場所,"召可")	

ENDIF

