@CARDNAME_72847,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 크림즌 헬 콜
	CASE "略称"
		RESULTS = Crs헬 콜
	CASE "カテゴリ"
		RESULTS:0 = 레드 데몬
ENDSELECT


@CARD_72847(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
	CASE "추가日"
		RETURN 260124
ENDSELECT

RETURN 0

@CARD_EXPLANATION_72847(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 カードは１ターンに１枚しか발동できない。
CALLFORM CARD_ABLE(1,마함起動,손패起動)
PRINTL ①：자신의 묘지에서 레벨４ 이하인 악마족몬스터 １장을 패에 넣는다。
PRINTL 자신 필드에 「레드 데몬」Sモンスターが존재하는 경우、
PRINTL 손패に加える몬스터를 덱에서 選ぶ事もできる。
CALLFORM CARD_ABLE(0,攻撃後誘発)
PRINTL ②：자신의 モンスターが攻撃したダメージステップ終了時、묘지의 이 카드를 제외하고 발동할 수 있다。
PRINTL 자신의 「/버스터」モンスターか「레드 데몬즈 드래곤」１体の攻撃횟수を１回増やす。

@CARDCAN_72847(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72847)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
    SIF 발동済_1(듀얼리스트,72847)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 레드 데몬
	효과条件종류 = 싱크로
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		条件달성 = 1
	CALL FULLRESET
	효과範囲묘지 = 1
	SIF 条件달성 == 1
		효과範囲덱 = 1
	효과条件종족 = 악마족
	효과条件종류 = モン全般
	CALL 효과条件レベル_ADV(4, "以下")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃後誘発
	SIF ゾーン != "묘지"
		RETURN 0
	SIF 戦闘場所(듀얼리스트) == 5
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = /버스터
	효과条件スーパー名前 = 레드 데몬즈 드래곤
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ENDIF



@CARDEFFECT_72847(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72847,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲필드 = 1
	    효과条件カテゴリ = 레드 데몬
	    효과条件종류 = 싱크로
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1
			条件달성 = 1
		CALL FULLRESET
		효과範囲묘지 = 1
	    SIF 条件달성 == 1
	    	효과範囲덱 = 1
	    효과条件종족 = 악마족
	    효과条件종류 = モン全般
	    CALL 효과条件レベル_ADV(4, "以下")
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 攻撃後誘発
    CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72847)
	IF RESULT == 0
	    CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲필드 = 1
	    효과条件カテゴリ = /버스터
	    효과条件スーパー名前 = 레드 데몬즈 드래곤
	    효과条件종류 = モン全般
		CALL CARD_GRANT_ADV(듀얼리스트,ゾーン,場所,"戦",1)
	ENDIF

ENDIF

