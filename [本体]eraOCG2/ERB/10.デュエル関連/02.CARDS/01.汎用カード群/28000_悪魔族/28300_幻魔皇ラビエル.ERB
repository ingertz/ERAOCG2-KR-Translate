@CARDNAME_28300,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 환마황제 라비엘
	CASE "略称"
		RESULTS = 환마황제 라비엘
	CASE "カテゴリ"
		RESULTS:0 = 라비엘
		RESULTS:1 = 환마
		RESULTS:2 = 삼환마
ENDSELECT


@CARD_28300(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
			RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 4000
	CASE "守備力"
		RETURN 4000
	CASE "특수불가"
		RETURN 1
	CASE "소환불가"
		RETURN 1
	CASE "生成カード"
		RETURN 128300
ENDSELECT

RETURN 0

@CARD_EXPLANATION_28300(종류)
#DIM DYNAMIC 종류

CALLFORM CARD_ABLE(0,손패起動)
PRINTL 이 카드는 일반 소환할 수 없으며、 자신 필드의 몬스터 3장을 묘지로 보낸 경우에만 특수 소환할 수 있다.
PRINTL 이 방법으로의 특수 소환은 효과에 의한 제한을 받지 않는다.
CALLFORM CARD_ABLE(0,묘지起動,지속효과)
PRINTL ①: 자신의 필드 / 묘지 / 제외 / 패 / 덱에, 다른 "환마황제 라비엘"이 존재하지 않을 경우,
PRINTL 이 카드는 완전 내성을 가지고, 자신 필드의 몬스터 1장을 묘지로 보내는 것으로,
PRINTL 묘지의 이 카드를 패에 추가할 수 있다.
CALLFORM CARD_ABLE(0,효과後誘発)
PRINTL ②: 상대가 카드의 소환 / 특수 소환에 성공했을 때 발동할 수 있다.
PRINTL 자신 필드에 "환마의 시종" 1장을 특수 소환한다.
CALLFORM CARD_ABLE(10,필드起動)
PRINTL ③: 이 몬스터는 상대 몬스터가 존재하는 한、계속해서 공격할 수 있다.

@CARDCAN_28300(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,28300)
SIF RESULT == 1
	RETURN 0

;특수소환
IF 종류 == 손패起動 
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과条件종류 = モン全般
	효과条件표시 = 0
	효과条件CNT = 1	
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 3
		RETURN 0
	RETURN 1
;묘지回収
ELSEIF 종류 == 묘지起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF モンスター数(듀얼리스트) == 0
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲묘지 = 1
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과範囲제외 = 1
	효과条件名前 = 환마황제 라비엘
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1 
		RETURN 0
	RETURN 1

;トークン生成
ELSEIF 종류 == 효과後誘発
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"소환全般",1)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,128300,"")
	SIF RESULT == 1
		RETURN 0

	RETURN 1
;제물효과
; ELSEIF 종류 == 필드起動
; 	SIF メインフェイズ != 1
; 		RETURN 0
; 	SIF ターンプレイヤー != 듀얼리스트
; 		RETURN 0
; 	SIF 효과발동済(듀얼리스트,場所,ゾーン)
; 		RETURN 0
; 	CALL FULLRESET
; 	효과範囲필드 = 1
; 	효과条件CNT = 1
; 	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
; 	SIF RESULT <= 1
; 		RETURN 0
; 	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_28300(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

;특수소환
IF 종류 == 손패起動 
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28300)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲마함 = 1
		효과条件종류 = モン全般
		효과条件표시 = 0
		효과条件複数 = 3
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_SP_SUMMON(듀얼리스트, "손패", 場所)
		ENDIF
	ENDIF
;묘지回収
ELSEIF 종류 == 묘지起動 
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28300)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件名前 = 환마황제 라비엘
			CALL CARD_ADD_BASIC(듀얼리스트, "묘지",ゾーン,場所)	
		ENDIF
	ENDIF
;トークン生成
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28300)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_GENERATE(듀얼리스트,128300)
	ENDIF
;제물효과
; ELSEIF 종류 == 필드起動
; 	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28300,10)
; 	IF RESULT == 0
; 		CALL FULLRESET
; 		효과範囲필드 = 1
; 		효과条件他所 = 1
; 		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
; 		IF RESULT == 1
; 			CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"一攻",GETVAR(@"%듀얼리스트%_MZ_攻:場所"))
; 		ENDIF
; 	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲마함 = 1
	효과範囲묘지 = 1
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과範囲제외 = 1
	효과条件名前 = 환마황제 라비엘
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 1 
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"モ耐")
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"魔耐")
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"함정耐")
	ENDIF
	CALL FULLRESET
	효과範囲상대필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	IF RESULT == 1 
		CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"追戦",98)
	ENDIF
ENDIF







@CARDNAME_128300,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 환마의 시종
	CASE "略称"
		RESULTS = 환마의 시종
	CASE "カテゴリ"
		RESULTS:0 = 없음
ENDSELECT


@CARD_128300(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常モン
	CASE "トークン"
		RETURN 1
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 1000
	CASE "守備力"
		RETURN 1000
ENDSELECT


@CARD_EXPLANATION_128300(종류)
#DIM DYNAMIC 종류

CALLFORM CARD_ABLE(0,필드起動)
PRINTL ①：이 카드를 릴리스하고 발동할 수 있다。
PRINTL 자신 필드의 "환마황제 라비엘" １장의 공격력을 １０００올린다。
CALLFORM CARD_ABLE(0,묘지起動)
PRINTL ②：묘지의 이 카드를 소멸시키고 발동할 수 있다。
PRINTL 자신은 １장 드로우 한다。

@CARDCAN_128300(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,128300)
SIF RESULT == 1
	RETURN 0
	
IF 종류 == 필드起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件名前 = 환마황제 라비엘
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF

RETURN 0

@CARDEFFECT_128300(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,128300)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件名前 = 환마황제 라비엘
		CALL CARD_GRANT_ADV(듀얼리스트,ゾーン,場所,"一攻",1000)
	ENDIF
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,128300)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,소멸行き)
		CALL CARDDRAW_BASIC(듀얼리스트,1)
	ENDIF
ENDIF
