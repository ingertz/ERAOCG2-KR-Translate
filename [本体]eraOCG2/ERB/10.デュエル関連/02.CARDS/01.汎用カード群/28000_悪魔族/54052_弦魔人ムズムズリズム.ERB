@CARDNAME_54052,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 현마인 딩가딩가 리듬
	CASE "略称"
		RESULTS = 딩가딩가 리듬
	CASE "カテゴリ"
		RESULTS:0 = 마인
ENDSELECT


@CARD_54052(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 1000
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251108
ENDSELECT

RETURN 0

@CARDSUMMON_54052(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 3

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,54052) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_54052(종류)
#DIM DYNAMIC 종류

PRINTL 레벨３ 몬스터×２
PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 발동할 수 없다。
CALLFORM CARD_ABLE(1,攻撃時誘発)
PRINTL ①：자신으 "마인" Ｘ몬스터가 전투를 하는 공격 선언시에、이 카드의 Ｘ소재를 １개 제거하고 발동할 수 있다。
PRINTL 그 전투를 한 자신 몬스터의 공격력은 턴 종료시까지 배가 된다。
CALLFORM CARD_ABLE(0,戦破壊→묘지)
PRINTL ②：Ｘ소환한 이 카드가 상대에 의해 파괴된 경우、묘지의 몬스터 １장을 제외하고 발동할 수 있다。
PRINTL 이 카드를 공격 표시로 특수 소환하고、이 카드의 Ｘ소재를 １개 늘린다。


@CARDCAN_54052(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,54052)
SIF RESULT == 1
	RETURN 0

IF 종류 == 攻撃時誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_1(듀얼리스트,54052)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	SIF 戦闘場所(듀얼리스트) == 5
		RETURN 0
	TRYCALLFORM CARDNAME_{戦闘カードID(듀얼리스트)},"カテゴリ"
	SIF !MATCH(RESULTS,"마인")
		RETURN 0
	TRYCALLFORM CARD_{戦闘カードID(듀얼리스트)},"종류"
	SIF !MATCH(RESULT,엑시즈)
		RETURN 0
	RETURN 1

ELSEIF 종류 == 戦破壊→묘지
	SIF ゾーン != "필드"
		RETURN 0
	SIF 処理中_듀얼리스트 == 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_召種:場所") != 召種EX덱
		RETURN 0
	SIF !GROUPMATCH(묘지送り종류,"破壊","戦闘破壊")
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,54052,"묘지",1)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_54052(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 攻撃時誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,54052,1,X消費1)
	IF RESULT == 0
		攻撃力修正 = GETVAR(@"%듀얼리스트%_MZ_攻:戦闘場所(듀얼리스트)")
		CALL SET_FIELD_INFO(듀얼리스트,"필드",戦闘場所(듀얼리스트),"一攻",攻撃力修正)
	ENDIF

ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,54052)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 현마인 딩가딩가 리듬
		효과추가종류 = 効追Ｘ素
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"攻撃표시")
	ENDIF
ENDIF
