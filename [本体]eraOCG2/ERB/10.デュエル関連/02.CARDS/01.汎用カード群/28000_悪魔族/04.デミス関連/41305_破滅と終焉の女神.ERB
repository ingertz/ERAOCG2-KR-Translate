@CARDNAME_41305,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 룰러 오브 더 월드 엔드
	CASE "略称"
		RESULTS = 파멸과종언의여신
	CASE "カテゴリ"
		RESULTS:0 = 종언과 파멸
		RESULTS:1 = 게임 오리지널
ENDSELECT


@CARD_41305(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 의식
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 3000
	CASE "守備力"
		RETURN 2900
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		RETURN 1305
	CASE "추가日"
		RETURN 251229
ENDSELECT

RETURN 0
@CARDSUMMON_41305(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要レベル数 = 10

IF EX参照 == 1
	CALL RITCAN(듀얼리스트,소환カード,41305) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_41305(종류)
#DIM DYNAMIC 종류

PRINTL "엔드 오브 더 월드"에 의해 강림。
PRINTL 이 카드명의 ②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：이 카드의 카드명은、필드에 존재하는 한 "파멸의 여신 루인"으로 취급한다。
CALLFORM CARD_ABLE(2,손패起動)
PRINTL ②：패의 이 카드를 상대에게 보여주고 발동할 수 있다。
PRINTL 이 카드명 이외의 "종언과 파멸" 카드 １장을 덱에서 패에 넣는다。
PRINTL 그 후、패를 １장 묘지로 보낸다。
CALLFORM CARD_ABLE(3,필드起動)
PRINTL ③：이 카드가 특수 소환에 성공한 경우에 발동할 수 있다。
PRINTL 덱에서 레벨８ 이하인 빛속성 의식 몬스터 １장을 소환 조건을 무시하고 특수 소환한다。
PRINTL 이렇게 특수 소환된 몬스터의 효과는 발동할 수 없다。


@CARDCAN_41305(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,41305)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 손패起動
	SIF 발동済_2(듀얼리스트,41305)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 종언과 파멸
	효과条件固名前 = 룰러 오브 더 월드 엔드
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 특수소환時
	SIF 발동済_3(듀얼리스트,41305)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件特不無視 = 1
	효과条件속성 = 빛속성
	효과条件종류 = 의식
	CALL 효과条件レベル_ADV(8, "以下")
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_41305(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 손패選択
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 소환カード
#DIM DYNAMIC 攻撃力修正
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"変化元ID",1305)
ELSEIF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,41305,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 종언과 파멸
		효과条件固名前 = 룰러 오브 더 월드 엔드
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲손패 = 1
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,41305,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件特不無視 = 1
		효과条件속성 = 빛속성
		효과条件종류 = 의식
		CALL 효과条件レベル_ADV(8, "以下")
		효과추가종류 = 39
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF