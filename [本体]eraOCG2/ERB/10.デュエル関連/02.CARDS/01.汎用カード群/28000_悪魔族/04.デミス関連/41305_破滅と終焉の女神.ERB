@CARDNAME_41305,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 룰러 오브 더 월드 엔드
	CASE "略称"
		RESULTS = 파멸과종언의여신
	CASE "カテゴリ"
		RESULTS:0 = 종언과 파멸
		RESULTS:1 = 게임 오리지널
ENDSELECT


@CARD_41305(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 의식
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 3000
	CASE "守備力"
		RETURN 2900
	CASE "성별"
		RETURN 牝性
	CASE "連動ID"
		RETURN 1305
	CASE "추가日"
		RETURN 251229
ENDSELECT

RETURN 0
@CARDSUMMON_41305(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要レベル数 = 10

IF EX参照 == 1
	CALL RITCAN(듀얼리스트,소환カード,41305) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_41305(종류)
#DIM DYNAMIC 종류

PRINTL 「엔드 오브 더 월드」により降臨。
PRINTL このカード名の②③の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：このカードのカード名は、フィールドに存在する限り「破滅の女神ルイン」として扱う。
CALLFORM CARD_ABLE(2,손패起動)
PRINTL ②：손패のこのカードを상대に見せて발동できる。
PRINTL このカード名以外の「종언과 파멸」カード１枚を덱から손패に加える。
PRINTL その後、손패を１枚묘지へ送る。
CALLFORM CARD_ABLE(3,필드起動)
PRINTL ③：このカードが특수소환に成功した場合に발동できる。
PRINTL 덱からレベル８以下の빛속성の의식モンスター１体を소환条件を無視して특수소환する。
PRINTL こうして특수소환したモンスターの효과は발동できない。


@CARDCAN_41305(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,41305)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 손패起動
	SIF 발동済_2(듀얼리스트,41305)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 종언과 파멸
	효과条件固名前 = 룰러 오브 더 월드 엔드
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 특수소환時
	SIF 발동済_3(듀얼리스트,41305)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件特不無視 = 1
	효과条件속성 = 빛속성
	효과条件종류 = 의식
	CALL 효과条件レベル_ADV(8, "以下")
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_41305(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 손패選択
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 소환カード
#DIM DYNAMIC 攻撃力修正
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 지속효과
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"変化元ID",1305)
ELSEIF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,41305,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 종언과 파멸
		효과条件固名前 = 룰러 오브 더 월드 엔드
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲손패 = 1
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,41305,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件特不無視 = 1
		효과条件속성 = 빛속성
		효과条件종류 = 의식
		CALL 효과条件レベル_ADV(8, "以下")
		효과추가종류 = 39
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF