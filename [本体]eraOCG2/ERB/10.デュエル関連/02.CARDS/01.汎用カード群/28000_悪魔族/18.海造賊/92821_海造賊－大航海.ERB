@CARDNAME_92821,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 플런드롤－그랜드 보이지
	CASE "略称"
		RESULTS = 그랜드 보이지
	CASE "カテゴリ"
		RESULTS:0 = 플런드롤
ENDSELECT


@CARD_92821(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속함정
	CASE "추가日"
		RETURN 260112
ENDSELECT

RETURN 0

@CARD_EXPLANATION_92821(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,마함起動,フリー誘発)
PRINTL ①：상대フィールドの表側표시モンスター１体を대상として발동できる。
PRINTL 속성を１つ宣言し、そのモンスターをターン終了時まで宣言した속성にする。
PRINTL その後、자신の묘지から「플런드롤」モンスター１体を選んで덱に戻すか특수소환できる。
CALLFORM CARD_ABLE(0,ターン終了時強制)
PRINTL ②：자신エンドフェイズに、「플런드롤」モンスターが자신フィールドに存在しない場合に발동する。
PRINTL このカードを묘지へ送る。


@CARDCAN_92821(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 표시条件달성
#DIM DYNAMIC カウンタ

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,92821)
SIF RESULT == 1
	RETURN 0

표시条件달성 = 0
SIF ゾーン == "마함" && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	표시条件달성 = 1

IF (종류 == 마함起動 && 표시条件달성 == 1) || (종류 == フリー誘発 && 표시条件달성 == 1)
	SIF 발동済_1(듀얼리스트,92821)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과条件除去種 = 選択
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == ターン終了時強制 && 표시条件달성 == 1
	SIF ゾーン != "마함"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 플런드롤
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 마함起動
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_92821(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択효과
#DIM DYNAMIC 표시条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

표시条件달성 = 0
SIF ゾーン == "마함" && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	표시条件달성 = 1

IF (종류 == 마함起動 && 표시条件달성 == 1) || (종류 == フリー誘発 && 표시条件달성 == 1) || 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92821,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과条件표시 = 表側표시
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"選択")
		IF RESULT == 1
			CALL CARD_SELECT(듀얼리스트,RESULT)
			選択カード = RESULT
			IF 듀얼리스트 == "자신"
				;속성選択：選択者,ゾーン지정（필드以外は無意味）,場所지정（필드以外ry）,反転플래그（필드ry）
				CALL CARD_ELEMENT_SELECT(듀얼리스트,"필드",選択カード,1)
				選択효과 = RESULT
			ELSE
				RESULT = RAND:7 + 1

				CALL FULLRESET
				효과範囲상대필드 = 1
				효과範囲묘지 = 1
				효과条件속성 = 어둠속성
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				SIF RESULT != 1
					RESULT = 2
				CALL FULLRESET
				효과範囲상대필드 = 1
				효과範囲묘지 = 1
				효과条件속성 = 화염속성
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				SIF RESULT != 1
					RESULT = 5
				CALL FULLRESET
				효과範囲상대필드 = 1
				효과範囲묘지 = 1
				효과条件속성 = 빛속성
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				SIF RESULT != 1
					RESULT = 1
				PRINTL
				選択효과 = RESULT
				IF 選択효과 == 1
					RESULTS =（光）
				ELSEIF 選択효과 == 2
					RESULTS =（闇）
				ELSEIF 選択효과 == 3
					RESULTS =（地）
				ELSEIF 選択효과 == 4
					RESULTS =（水）
				ELSEIF 選択효과 == 5
					RESULTS =（炎）
				ELSEIF 選択효과 == 6
					RESULTS =（風）
				ELSEIF 選択효과 == 7
					RESULTS =（神）
				ENDIF
				PRINTFORMW %RESULTS%속성が選ばれました。
			ENDIF
			CALL SET_FIELD_INFO(対面者,"필드",選択カード,"一属",選択효과,1)
		ENDIF
	ENDIF

ELSEIF 종류 == ターン終了時強制 && 표시条件달성 == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92821)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 마함起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92821)
	IF RESULT == 0
	ENDIF
ENDIF
