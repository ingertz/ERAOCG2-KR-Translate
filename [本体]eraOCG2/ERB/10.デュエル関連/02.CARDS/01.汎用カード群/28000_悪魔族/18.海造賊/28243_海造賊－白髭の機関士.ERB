@CARDNAME_28243,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 플런드롤－흰수염 기관사
	CASE "略称"
		RESULTS = 흰수염 기관사
	CASE "カテゴリ"
		RESULTS:0 = 플런드롤
ENDSELECT


@CARD_28243(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 1000
	CASE "성별"
		RETURN 雄性
	CASE "튜너"
		RETURN 1
	CASE "추가日"
		RETURN 260112
ENDSELECT
RETURN 0

@CARD_EXPLANATION_28243(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,필드起動,フリー誘発)
PRINTL ①：자신・상대ターンに발동できる。
PRINTL 상대のフィールド・묘지のモンスターのいずれかと同じ속성を持つ「플런드롤」モンスター１体をＥＸ덱から특수소환し、
PRINTL 자신フィールドのこのカードを装備カード扱いとしてそのモンスターに装備する。
CALLFORM CARD_ABLE(2,필드→묘지,손패→묘지)
PRINTL ②：このカードが손패・モンスターゾーンから묘지へ送られた場合に발동できる。
PRINTL 덱から「플런드롤－흰수염 기관사」以外の「플런드롤」モンスター１体を특수소환する。
PRINTL このターン、자신は「플런드롤」モンスターしかＥＸ덱から특수소환できない。


@CARDSUMMON_AA_28243


@CARDCAN_28243(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,28243)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動 || 종류 == フリー誘発
	SIF 발동済_1(듀얼리스트,28243)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	FOR カウンタ,1,7
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대묘지 = 1
		효과条件속성 = カウンタ
		효과条件표시 = 表側표시
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			CONTINUE
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件속성 = カウンタ
		효과条件カテゴリ = 플런드롤
		효과条件소환可 = 1
		효과条件特不無視 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			CONTINUE
		条件달성 = 1
		BREAK
	NEXT
	SIF 条件달성 != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지
	SIF 발동済_2(듀얼리스트,28243)
		RETURN 0
	SIF ゾーン == "제외"
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 플런드롤
	효과条件固名前 = 플런드롤－흰수염 기관사
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_28243(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 条件달성,7

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28243,1)
	IF RESULT == 0
		FOR カウンタ,1,7
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과範囲상대묘지 = 1
			효과条件속성 = カウンタ
			효과条件표시 = 表側표시
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT != 1
				CONTINUE
			CALL FULLRESET
			효과範囲EX덱 = 1
			효과条件속성 = カウンタ
			효과条件カテゴリ = 플런드롤
			효과条件소환可 = 1
			효과条件特不無視 = 1
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT != 1
				CONTINUE
			条件달성:カウンタ = 1
		NEXT
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件속성:0 = 10
		FOR カウンタ,1,7
			SIF 条件달성:カウンタ == 1
				효과条件속성:カウンタ = カウンタ
		NEXT
		효과条件カテゴリ = 플런드롤
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲필드 = 1
			효과条件固定 = カード소환先
			CALL CARD_EQUIP_ADV(듀얼리스트,場所,ゾーン)
		ENDIF
	ENDIF

ELSEIF 종류 == 필드→묘지 || 종류 == 손패→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28243,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 플런드롤
		효과条件固名前 = 플런드롤－흰수염 기관사
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		CALL CARD_EX_RESTRICTION(듀얼리스트,"플런드롤")
	ENDIF
ENDIF
