@CARDNAME_54130,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 플런드롤－캡틴 검은수염
	CASE "略称"
		RESULTS = 캡틴 검은수염
	CASE "カテゴリ"
		RESULTS:0 = 플런드롤
ENDSELECT


@CARD_54130(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 링크
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 1600
	CASE "守備力"
		RETURN 1000
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 260112
ENDSELECT

RETURN 0

@CARDSUMMON_54130(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要링크数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = 플런드롤
ENDIF

IF EX参照 == 1
	CALL LINCAN(듀얼리스트,소환カード,54130) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_54130(종류)
#DIM DYNAMIC 종류

PRINTL 「플런드롤」モンスターを含むモンスター２体
PRINTL このカード名の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,필드起動,フリー誘発)
PRINTL ①：자신・상대ターンに、자신フィールドのモンスター１体を대상として발동できる。
PRINTL 상대のフィールド・묘지のいずれかと同じ속성を持つ「플런드롤」モンスター１体をＥＸ덱から특수소환し、
PRINTL 대상の자신のモンスターを装備カード扱いで、その특수소환したモンスターに装備する。
PRINTL その後、자신は덱から１枚ドローする。
PRINTL 

@CARDCAN_54130(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,54130)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動 || 종류 == フリー誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_1(듀얼리스트,54130)
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	FOR カウンタ,1,7
		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대묘지 = 1
		효과条件속성 = カウンタ
		효과条件표시 = 表側표시
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			CONTINUE
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件속성 = カウンタ
		효과条件カテゴリ = 플런드롤
		효과条件소환可 = 1
		효과条件特不無視 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			CONTINUE
		条件달성 = 1
		BREAK
	NEXT
	SIF 条件달성 != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF


@CARDEFFECT_54130(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 攻撃力上昇
#DIM DYNAMIC 条件달성,7

IF 종류 == 필드起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,54130,1)
	IF RESULT == 0
		CALL FULLRESET
		효과条件표시 = 表側표시
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			FOR カウンタ,1,7
				CALL FULLRESET
				효과範囲상대필드 = 1
				효과範囲상대묘지 = 1
				효과条件속성 = カウンタ
				효과条件표시 = 表側표시
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				SIF RESULT != 1
					CONTINUE
				CALL FULLRESET
				효과範囲EX덱 = 1
				효과条件속성 = カウンタ
				효과条件カテゴリ = 플런드롤
				효과条件소환可 = 1
				효과条件特不無視 = 1
				CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
				SIF RESULT != 1
					CONTINUE
				条件달성:カウンタ = 1
			NEXT
			CALL FULLRESET
			효과範囲EX덱 = 1
			효과条件속성:0 = 10
			FOR カウンタ,1,7
				SIF 条件달성:カウンタ == 1
					효과条件속성:カウンタ = カウンタ
			NEXT
			효과条件カテゴリ = 플런드롤
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲필드 = 1
				효과条件固定 = カード소환先
				CALL CARD_EQUIP_ADV(듀얼리스트,選択カード,"필드")
				SIF RESULT == 1
					CALL CARDDRAW_BASIC(듀얼리스트,1)
			ENDIF
		ENDIF
	ENDIF
ENDIF


