@CARDNAME_54134,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 플런드롤－장중의 요르즈호
	CASE "略称"
		RESULTS = 장중의 요르즈호
	CASE "カテゴリ"
		RESULTS:0 = 플런드롤
ENDSELECT


@CARD_54134(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 3000
	CASE "分割"
		RETURN 펜듈럼
	CASE "추가日"
		RETURN 260112
ENDSELECT

RETURN 0

@CARDSUMMON_54134(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要レベル数 = 8

IF EX参照 == 0 || EX参照 == 1
	素材条件튜너 = 1
ELSEIF EX参照 >= 10
	素材条件튜너 = -1
ENDIF

IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,54134) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_54134(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("SYN_P_MAGIC")
PRINTL このカード名のＰ효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(3,발동誘発)
PRINTL ①：속성を１つ宣言して발동できる。
PRINTL このカードを持ち主のＥＸ덱に戻し、宣言した속성を持つ「플런드롤 토큰」をお互いのフィールドに１体ずつ守備표시で특수소환する。
CALL TEXT_DECORATION("SYN_P_MAGIC_2")

PRINTL 튜너＋튜너以外のモンスター１体以上
PRINTL このカード名の①②のモンスター효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,효과後誘発)
PRINTL ①：상대がモンスターを특수소환した場合に발동できる。
PRINTL 덱から「플런드롤」カード１枚を손패に加える。
PRINTL このカードが「플런드롤」カードを装備している場合、さらに덱から「플런드롤」モンスター１体を특수소환できる。
CALLFORM CARD_ABLE(2,필드起動)
PRINTL ②：자신の묘지の「플런드롤」カード１枚を대상として발동できる。
PRINTL そのカードを손패に加え、このカードを자신の마법＆함정ゾーンに表側표시で置く。


@CARDCAN_54134(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,54134)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動
	SIF 발동済_3(듀얼리스트,54134)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,154134,"")
	SIF RESULT == 1
		RETURN 0
	SIF モンスター数(対面者) >= 5
		RETURN 0
	RETURN 1

ELSEIF 종류 == 효과後誘発
	SIF 발동済_1(듀얼리스트,54134)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 플런드롤
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"특수소환",1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動
	SIF 발동済_2(듀얼리스트,54134)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 플런드롤
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_54134(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択효과

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 마함起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,54134,3)
	IF RESULT == 0
		IF 듀얼리스트 == "자신"
			;속성選択：選択者,ゾーン지정（필드以外は無意味）,場所지정（필드以外ry）,反転플래그（필드ry）
			CALL CARD_ELEMENT_SELECT(듀얼리스트)
			選択효과 = RESULT
		ELSE
			RESULT = RAND:7 + 1

			CALL FULLRESET
			효과範囲상대필드 = 1
			효과範囲묘지 = 1
			효과条件속성 = 어둠속성
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT != 1
				RESULT = 2
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과範囲묘지 = 1
			효과条件속성 = 화염속성
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT != 1
				RESULT = 5
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과範囲묘지 = 1
			효과条件속성 = 빛속성
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT != 1
				RESULT = 1
			PRINTL
			選択효과 = RESULT
			IF RESULT == 1
				RESULTS =（빛）
			ELSEIF RESULT == 2
				RESULTS =（어둠）
			ELSEIF RESULT == 3
				RESULTS =（땅）
			ELSEIF RESULT == 4
				RESULTS =（물）
			ELSEIF RESULT == 5
				RESULTS =（화염）
			ELSEIF RESULT == 6
				RESULTS =（바람）
			ELSEIF RESULT == 7
				RESULTS =（신）
			ENDIF
			PRINTFORMW %RESULTS%속성が選ばれました。
		ENDIF
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,EX덱行き)
		CALL FULLRESET
		효과추가종류 = 効追永属 + 選択효과
		CALL CARD_GENERATE(듀얼리스트,154134,"守備표시")
		CALL FULLRESET
		효과추가종류 = 効追永属 + 選択효과
		CALL CARD_GENERATE(듀얼리스트,154134,"守備표시",1)
	ENDIF

ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,54134,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 플런드롤
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과条件カテゴリ = 플런드롤
			CALL CARD_EQUIP_CHECK(듀얼리스트,場所,ゾーン)
			IF RESULT != 0
				CALL FULLRESET
				효과範囲덱 = 1
				효과条件カテゴリ = 플런드롤
				효과条件任意 = 1
				CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,54134,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 플런드롤
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		ENDIF
	ENDIF
ENDIF

