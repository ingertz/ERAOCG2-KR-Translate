@CARDNAME_28124,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 무지개 크리보
	CASE "略称"
		RESULTS = 무지개 크리보
	CASE "カテゴリ"
		RESULTS:0 = 크리보
ENDSELECT


@CARD_28124(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 100
	CASE "守備力"
		RETURN 100
	CASE "추가日"
		RETURN 251009
ENDSELECT

RETURN 0

@CARD_EXPLANATION_28124(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,攻撃時誘発)
PRINTL ①：상대 몬스터의 공격 선언시에 발동할 수 있다。
PRINTL 그 공격을 무효로 하고、이 카드를 패에서 장착 카드 취급으로 그 몬스터에게 장착한다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：이 카드를 장착하고 있는 몬스터는 공격할 수 없다。
CALLFORM CARD_ABLE(3,攻撃時誘発)
PRINTL ③：상대 몬스터의 직접 공격 선언시에 발동할 수 있다。
PRINTL 묘지의 이 카드를 수비 표시로 특수 소환하고、공격 대상을 이 카드로 옮긴다。
PRINTL 이 효과로 특수 소환한 이 카드는、필드에서 벗어날 경우에 제외된다。

@CARDCAN_28124(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 装備者
#DIM DYNAMIC 装備先

CALL 装備판정(듀얼리스트,場所,ゾーン)
装備先 = RESULT	
装備者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,28124)
SIF RESULT == 1
	RETURN 0

IF 종류 == 攻撃時誘発
	SIF ターンプレイヤー == 듀얼리스트
		RETURN 0

	IF ゾーン == "손패"
		SIF 발동済_1(듀얼리스트,28124)
			RETURN 0
		SIF 마함数(듀얼리스트) >= 5
			RETURN 0
		RETURN 1
		
	ELSEIF ゾーン == "묘지"
		SIF 발동済_3(듀얼리스트,28124)
			RETURN 0
		SIF 戦闘場所(듀얼리스트) != 5
			RETURN 0
		CALL CARD_SS_CHECK(듀얼리스트,28124,ゾーン)
		SIF RESULT == 1
			RETURN 0
		RETURN 1

	ELSE
		RETURN 0
	ENDIF
	RETURN 0

ELSEIF 종류 == 지속효과
	SIF ゾーン != "마함"
		RETURN 0
	SIF 装備先 == 5
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_28124(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 装備者
#DIM DYNAMIC 装備先

CALL 装備판정(듀얼리스트,場所,ゾーン)
装備先 = RESULT	
装備者 = %RESULTS%

IF 종류 == 攻撃時誘発
	IF ゾーン == "손패"
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28124,1)
		IF RESULT == 0
			CALL EVADE_ATTACK(듀얼리스트)
			CALL FULLRESET
			효과範囲상대필드 = 1
			효과条件固定 = 戦闘場所(듀얼리스트,2)
			CALLFORM CARD_EQUIP_ADV(듀얼리스트,場所,ゾーン)
			CALL EVADE_ATTACK(듀얼리스트)
		ENDIF

	ELSEIF ゾーン == "묘지"
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28124,3)
		IF RESULT == 0
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件名前 = 무지개 크리보
			효과추가종류 = 効追除処
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"守備표시")
			SIF RESULT == 1
				CALL COVER_ATTACK(듀얼리스트,カード소환先)
		ENDIF
	ENDIF

ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"装備",場所,"戦無")
ENDIF

