@CARDNAME_92810,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 데몬의 해학
	CASE "略称"
		RESULTS = 데몬의 해학
	CASE "カテゴリ"
		RESULTS:0 = 데몬
ENDSELECT


@CARD_92810(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "추가日"
		RETURN 251025
ENDSELECT

RETURN 0
@CARD_EXPLANATION_92810(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 카드는 １턴에 １장밖에 발동할 수 없다。
CALLFORM CARD_ABLE(1,마함起動 ,フリー誘発)
PRINTL ①：패 / 덱에서 레벨７ 이하인 "데몬" 몬스터 １장을 특수 소환한다。
PRINTL 자신의 ＥＸ덱에 "데몬" 의식 몬스터가 존재하는 경우、
PRINTL 대신에 "로열 데몬" "듀크 데몬" "하이네스 데몬"을 각각 １장까지、
PRINTL 패 / 덱에서 특수 소환할 수 있다。


@CARDCAN_92810(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성
#DIM DYNAMIC EX条件달성


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,92810)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == フリー誘発
	SIF ゾーン != "마함"
		RETURN 0
	SIF 발동済_1(듀얼리스트,92810)
		RETURN 0
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과条件カテゴリ = 데몬
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_92810(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92810,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		
		CALL FULLRESET
		효과範囲EX덱 = 1
		효과条件カテゴリ = 데몬
		효과条件종류 = 의식
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			SIF 듀얼리스트 == "자신"
				PRINTL "로열 데몬" "듀크 데몬" "하이네스 데몬"을 각각 １장싹 특수 소환하시겠습니까？
			CALL YN_CHOICE(듀얼리스트)
		ELSE
			RESULT = 1
		ENDIF

		IF RESULT == 0
			CALL FULLRESET
			효과範囲손패 = 1
			효과範囲덱 = 1
			효과条件名前 = 로열 데몬
			효과条件任意 = 1
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)

			SIF モンスター数(듀얼리스트) >= 5
				RETURN 0
			
			CALL FULLRESET
			효과範囲손패 = 1
			효과範囲덱 = 1
			효과条件名前 = 듀크 데몬
			효과条件任意 = 1
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			
			SIF モンスター数(듀얼리스트) >= 5
				RETURN 0
			
			CALL FULLRESET
			효과範囲손패 = 1
			효과範囲덱 = 1
			효과条件名前 = 하이네스 데몬
			효과条件任意 = 1
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			
		ELSEIF RESULT == 1
			CALL FULLRESET
			효과範囲손패 = 1
			효과範囲덱 = 1
			효과条件カテゴリ = 데몬
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF
