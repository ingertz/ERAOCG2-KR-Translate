@CARDNAME_54040,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 데스 엠페러 데몬
	CASE "略称"
		RESULTS = Ｄ엠페러Ｄ
	CASE "カテゴリ"
		RESULTS:0 = 데몬
ENDSELECT


@CARD_54040(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 의식
	CASE "속성"
		RETURN 화염속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 1200
	CASE "성별"
		RETURN 雄性
	CASE "分割"
		RETURN 펜듈럼
	CASE "특수불가"
		RETURN 1
	CASE "추가日"
		RETURN 251025
ENDSELECT
RETURN 0


@CARDSUMMON_54040(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要レベル数 = 7

IF EX参照 == 1
	CALL RITCAN(듀얼리스트,소환カード,54040) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_54040(종류)
#DIM DYNAMIC 종류

CALL TEXT_DECORATION("GISK_P_MAGIC")
PRINTL 이 카드명의 Ｐ효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動)
PRINTL ①：필드의 다른 앞면 표시 마법 / 함정 카드 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 카드와 이 카드를 파괴한다。
CALL TEXT_DECORATION("GISK_P_MAGIC")

PRINTL "쓰론 오브 데몬즈"에 의해 강림。
PRINTL 이 카드는 의식 소환으로밖에 특수 소환할 수 없다。
PRINTL 이 카드명의 ①③의 몬스터 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(2,EX소환時)
PRINTL ①：이 카드가 ＥＸ덱에서 의식 소환된 경우에 발동할 수 있다。
PRINTL 서로의 플레이어는 자신의 필드의 ＥＸ덱에서 특수 소환된 몬스털르 최대 １장까지 고른다。
PRINTL 고른 몬스터 이외의 필드의 모든 몬스터를 제외한다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：ＥＸ덱에서 특수 소환된 이 카드는 상대 몬스터의 효과를 받지 않는다。
CALLFORM CARD_ABLE(3,필드起動)
PRINTL ③：이 카드가 ＥＸ덱에서 특수 소환되어있는 경우에 발동할 수 있다。
PRINTL 자신의 패 / 덱 / 묘지 / 제외상태인 악마족 몬스터 １장을 특수 소환한다。



@CARDCAN_54040(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,54040)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 마함起動
	SIF 발동済_1(듀얼리스트,54040)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과範囲상대마함 = 1
	효과条件표시 = 表側표시
	효과条件除去種 = 묘지
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

;-------------------------------------ここからモンスター-----------------------------------

ELSEIF 종류 == EX소환時
	SIF 발동済_2(듀얼리스트,54040)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_召種:場所") != 召種EX덱
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	SIF 듀얼리스트 == "자신"
		효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件除去種 = 제외
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드起動
	SIF 발동済_3(듀얼리스트,54040)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_召種:場所") != 召種EX덱
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件종족 = 악마족
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_召種:場所") != 召種EX덱
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_54040(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,54040)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF

ELSEIF 종류 == 마함起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,54040,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,破壊行き)
		CALL FULLRESET
		효과範囲마함 = 1
		효과範囲상대마함 = 1
		효과条件표시 = 表側표시
		효과条件除去種 = 묘지
		효과条件他所 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"묘지")
	ENDIF

;-------------------------------------ここからモンスター-----------------------------------

ELSEIF 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,54040,2)
	IF RESULT == 0
		CALL FULLRESET
		효과条件召種 = 召種EX덱
		효과条件任意 = 1
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
		SIF RESULT != 9999
			選択カード = RESULT
		
		CALL FULLRESET
		효과条件召種 = 召種EX덱
		효과条件任意 = 1
		CALL CARD_CHOOSE_BASIC(対面者,"필드",ゾーン,場所)
		SIF RESULT != 9999
			CALL SET_FIELD_INFO(対面者,"필드",RESULT,"モ耐",6)
		
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲상대필드 = 1
		SIF 選択カード != 9999
			효과条件他所 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",選択カード,"제외")
	ENDIF

ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,54040,3)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과範囲제외 = 1
		효과条件종족 = 악마족
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"モ耐")
ENDIF
