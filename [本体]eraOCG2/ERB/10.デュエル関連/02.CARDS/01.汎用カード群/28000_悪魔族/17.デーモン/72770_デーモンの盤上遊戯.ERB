@CARDNAME_72770,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 데몬의 스트래터지
	CASE "略称"
		RESULTS = Ｄ의 스트래터지
	CASE "カテゴリ"
		RESULTS:0 = 데몬
ENDSELECT


@CARD_72770(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN フィールド
	CASE "추가日"
		RETURN 251025
ENDSELECT

RETURN 0

