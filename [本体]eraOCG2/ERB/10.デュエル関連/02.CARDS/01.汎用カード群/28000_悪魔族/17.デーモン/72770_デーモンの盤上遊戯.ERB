@CARDCAN_72770(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 발동불가,2

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72770)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 발동済_2(듀얼리스트,72770)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	
	SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
		발동불가:0 = 1
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲묘지 = 1
	효과条件종족 = 악마족
	효과条件スーパーカテゴリ = 데몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 데몬
	효과条件종류:0 = モン全般
	효과条件종류:1 = 함정全般
	효과条件종류:2 = 通常마법
	효과条件종류:3 = 速攻마법
	효과条件종류:4 = 지속마법
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1

	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 데몬
	효과条件分割 = 펜듈럼
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:1 = 1
	
	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과 || 종류 == 攻守変動
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_72770(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 발동불가,2

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72770,2)
	IF RESULT == 0
		SIF GETVAR(@"%듀얼리스트%_제외NG置換") >= 1
			발동불가:0 = 1
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲묘지 = 1
		효과条件종족 = 악마족
		효과条件スーパーカテゴリ = 데몬
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:0 = 1
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 데몬
		효과条件종류:0 = モン全般
		효과条件종류:1 = 함정全般
		효과条件종류:2 = 通常마법
		효과条件종류:3 = 速攻마법
		효과条件종류:4 = 지속마법
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:0 = 1

		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 데몬
		효과条件分割 = 펜듈럼
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:1 = 1
		
		SIF 발동불가:0 == 1 && 발동불가:1 == 1
			RETURN 0
		
		IF 발동불가:0 != 1 && 발동불가:1 != 1
			CALL YN_CHOICE(듀얼리스트,"●덱에서 필드 이외의 「데몬」을 패에 넣는다","●덱의「데몬」Ｐ를 ＥＸ덱으로 보낸다")
		ELSEIF 발동불가:0 != 1
			RESULT = 0
		ELSEIF 발동불가:1 != 1
			RESULT = 1
		ENDIF

		IF RESULT == 0
			CALL FULLRESET
			효과範囲손패 = 1
			효과範囲묘지 = 1
			효과条件종족 = 악마족
			효과条件スーパーカテゴリ = 데몬
			효과条件行先플래그 = 제외行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲덱 = 1
				효과条件カテゴリ = 데몬
				효과条件종류:0 = モン全般
				효과条件종류:1 = 함정全般
				효과条件종류:2 = 通常마법
				효과条件종류:3 = 速攻마법
				효과条件종류:4 = 지속마법
				CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
			ENDIF

		ELSEIF RESULT == 1
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 데몬
			효과条件分割 = 펜듈럼
			효과条件行先플래그 = EX덱行き
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF

ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72770)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF

ELSEIF 종류 == 攻守変動
	CALL FULLRESET
	효과条件召種 = 召種EX덱
	CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,1000,0)
	CALL STATCHANGE_BASIC(듀얼리스트,"상대필드",場所,1000,0,72770)

ELSEIF 종류 == 지속효과
	CALL SET_FIELD_MAGIC_INFO(듀얼리스트,"데몬의 스트래터지")
ENDIF
