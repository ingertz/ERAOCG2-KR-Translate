@CARDNAME_72771,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 쓰론 오브 데몬즈
	CASE "略称"
		RESULTS = 쓰론 오브 D
	CASE "カテゴリ"
		RESULTS:0 = 데몬
		RESULTS:1 = 의식 마법
ENDSELECT


@CARD_72771(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
	CASE "추가日"
		RETURN 251025
ENDSELECT

RETURN 0

@CARD_EXPLANATION_72771(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の②の효과は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(0,마함起動,손패起動)
PRINTL ①：レベルの合計が의식소환するモンスターのレベル以上になるように、
PRINTL 자신の손패・フィールドのモンスターをリリースし、
PRINTL 자신の손패・ＥＸ덱・묘지・제외状態の「데몬」의식モンスター１体を의식소환する。
CALL CARD_ABLE(2,ターン開始時)
PRINTL ②：자신・상대のスタンバイフェイズに、
PRINTL 자신のＥＸ덱に「데스 엠페러 데몬」が存在する場合に발동できる。
PRINTL 묘지・제외状態のこのカードを손패に加える。


@CARDCAN_72771(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件달성

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,72771)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL RESETAREA_MAT
	素材範囲손패 = 1
	素材範囲필드 = 1
	CALL FULLRESET
	효과範囲손패 = 1
	효과範囲EX덱 = 1
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件종류 = 의식
	효과条件カテゴリ = 데몬
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == ターン開始時
	SIF 발동済_2(듀얼리스트,72771)
		RETURN 0
	SIF !GROUPMATCH(ゾーン,"묘지","제외")
		RETURN 0
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件名前 = 데스 엠페러 데몬
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_72771(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件달성

IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72771)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		CALL RESETAREA_MAT
		素材範囲손패 = 1
		素材範囲필드 = 1
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲EX덱 = 1
		효과範囲묘지 = 1
		효과範囲제외 = 1
		효과条件종류 = 의식
		효과条件カテゴリ = 데몬
		효과条件소환可 = 1
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 9999
			CALL CARD_SELECT(듀얼리스트,RESULT)
			選択カード = RESULT
			CALL RESETAREA_MAT
			TRYCALLFORM CARDSUMMON_{GETVAR(@"%듀얼리스트%_%参照先（CS）%:選択カード")}(듀얼리스트,選択カード)
			素材範囲필드 = 1
			素材範囲손패 = 1
			TRYCALLFORM RITSUMMON(듀얼리스트, 選択カード,参照先（CS）)
		ENDIF
	ENDIF

ELSEIF 종류 == ターン開始時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,72771,2)
	IF RESULT == 0
		CALL FULLRESET
		IF ゾーン == "묘지"
			효과範囲묘지 = 1
		ELSEIF ゾーン == "제외"
			효과範囲제외 = 1
		ENDIF
		효과条件名前 = 쓰론 오브 데몬즈
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ENDIF
