@CARDNAME_92811,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 데몬의 기백
	CASE "略称"
		RESULTS = 데몬의 기백
	CASE "カテゴリ"
		RESULTS:0 = 데몬
ENDSELECT


@CARD_92811(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속함정
	CASE "추가日"
		RETURN 251025
ENDSELECT

RETURN 0

@CARD_EXPLANATION_92811(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,마함起動,フリー誘発,발동誘発)
PRINTL ①：자신 필드에 ＥＸ덱에서 특수 소환된 "데몬" 의식 몬스터가 존재하는 경우、
PRINTL 상대 필드의 앞면 표시 카드 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 카드의 효과를 턴 종료시까지 무효로 한다。
PRINTL 이 효과를 상대 패의 일반 마법 / 속공 마법 카드의 발동에 대해서 발동한 경우、
PRINTL 대신에 그 효과를 무효로 할 수 있다。
CALLFORM CARD_ABLE(2,제외時)
PRINTL ②：이 카드가 제외된 경우에 발동할 수 있다。
PRINTL 덱에서 "데몬의 기백" 이외의 "데몬" 카드 １장을 패에 넣는다。


@CARDCAN_92811(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 표시条件달성
#DIM DYNAMIC カウンタ

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,92811)
SIF RESULT == 1
	RETURN 0

표시条件달성 = 0
SIF ゾーン == "마함" && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	표시条件달성 = 1

IF (종류 == 마함起動 && 표시条件달성 == 1) || (종류 == フリー誘発 && 표시条件달성 == 1)
	SIF 발동済_1(듀얼리스트,92811)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 데몬
	효과条件종류 = 의식
	효과条件召種 = 召種EX덱
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	효과範囲상대마함 = 1
	효과条件除去種 = 無効
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所,92811)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 발동誘発
	SIF 발동済_1(듀얼리스트,92811)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 데몬
	효과条件종류 = 의식
	효과条件召種 = 召種EX덱
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲손패 = 1
	효과条件종류:0 = 通常마법
	효과条件종류:1 = 速攻마법
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 제외時
	SIF 발동済_2(듀얼리스트,92811)
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 데몬
	효과条件固名前 = 데몬의 기백
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 마함起動
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_92811(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 표시条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

표시条件달성 = 0
SIF ゾーン == "마함" && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	표시条件달성 = 1

IF (종류 == 마함起動 && 표시条件달성 == 1) || (종류 == フリー誘発 && 표시条件달성 == 1) || 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92811,1)
	IF RESULT == 0
		IF 종류 == 발동誘発
			SIF 듀얼리스트 == "자신"
				PRINTL 발동한 효과를 무효로 하시겠습니까？
			CALL YN_CHOICE(듀얼리스트)
			IF RESULT == はい
				CALL FULLRESET
				CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")
				RETURN 1
			ENDIF
		ENDIF

		CALL FULLRESET
		효과範囲상대필드 = 1
		효과範囲상대마함 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"無効")
	ENDIF
	RETURN 0

ELSEIF 종류 == 제외時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92811,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 데몬
		효과条件固名前 = 데몬의 기백
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF

ELSEIF 종류 == 마함起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,92811)
	IF RESULT == 0
	ENDIF
ENDIF
