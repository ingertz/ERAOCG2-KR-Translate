효과条件分割 = 펜듈럼
CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
SIF RESULT == 0
	효과使用可:1 = 0

CALL FULLRESET
효과範囲덱 = 1
효과条件종류 = モン全般
효과条件分割 = 펜듈럼
효과条件レベル:0 = 1
효과条件レベル:1 = 3
효과条件レベル:2 = 5
효과条件レベル:3 = 7
CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
SIF RESULT == 0
	효과使用可:1 = 0

CALL FULLRESET
효과範囲덱 = 1
효과条件종류 = モン全般
효과条件分割 = 펜듈럼
효과条件レベル:0 = 2
효과条件レベル:1 = 4
효과条件レベル:2 = 6
효과条件レベル:3 = 8
CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
SIF RESULT == 0
	효과使用可:1 = 0

SIF 마함数(듀얼리스트) > 3
	효과使用可:1 = 0


CALL FULLRESET
효과範囲마함 = 1
효과条件종류 = モン全般
효과条件分割 = 펜듈럼
효과条件行先플래그 = EX덱行き
효과条件レベル:0 = 1
효과条件レベル:1 = 3
효과条件レベル:2 = 5
효과条件レベル:3 = 7
효과条件レベル:4 = 9
효과条件レベル:5 = 11
CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
SIF RESULT == 0
	효과使用可:2 = 0

CALL FULLRESET
효과範囲마함 = 1
효과条件종류 = モン全般
효과条件分割 = 펜듈럼
효과条件行先플래그 = EX덱行き
효과条件レベル:0 = 2
효과条件レベル:1 = 4
효과条件レベル:2 = 6
효과条件レベル:3 = 8
효과条件レベル:4 = 10
