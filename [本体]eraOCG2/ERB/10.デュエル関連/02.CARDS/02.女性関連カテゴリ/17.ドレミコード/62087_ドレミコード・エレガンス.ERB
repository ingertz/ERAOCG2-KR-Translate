@CARDNAME_62087,参照先
;ココで지정카드의 名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 도레미코드 엘레강스
	CASE "略称"
		RESULTS = ♪엘레강스
	CASE "カテゴリ"
		RESULTS:0 = 도레미코드
ENDSELECT


@CARD_62087(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常마법
ENDSELECT

RETURN 0

@CARD_EXPLANATION_62087(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 카드는 1턴에 1장밖에 발동할 수 없다.
CALLFORM CARD_ABLE(1,마함起動 ,손패起動)
PRINTL ①: 이하의 효과 중에서 1개를 골라 적용한다.
PRINTL ●덱에서 "도레미코드"P 몬스터 1장을 고르고, 자신의 마법 & 함정 존에 놓는다.
PRINTL ●패에서 "도레미코드"P 몬스터 1장을 고르고, EX덱에 앞면 표시로 더한다.
PRINTL 그 후, 덱에서 레벨이 홀수와 짝수인 "도레미코드"P 몬스터를 1체씩 고르고, 자신의 마법 & 함정 존에 앞면으로 놓는다.
PRINTL ●마법 / 함정 존에서 레벨이 홀수와 짝수인 카드 1장씩을 앞면 표시로 EX덱에 더한다.
PRINTL 그 후、자신은 덱에서 ２장 드로우한다。

@CARDCAN_62087(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,62087)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,62087)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARDEFFCT_ABLE_62087(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT:1 == 0 && RESULT:2 == 0 && RESULT:3 == 0
		RETURN 0

	RETURN 1
ENDIF



@CARDEFFECT_62087(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 효과使用可,3
CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,62087,1)
	IF RESULT == 0
		;通常마법汎用処理
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		
		CALL CARDEFFCT_ABLE_62087(듀얼리스트,종류,ゾーン,場所)
		효과使用可:0 = RESULT:1
		효과使用可:1 = RESULT:2
		효과使用可:2 = RESULT:3

		IF 듀얼리스트 == "자신"
			IF 효과使用可:0 == 1
				PRINTL
				PRINTL [1]덱에서 "도레미코드" P몬스터 １장을 골라、자신의 마법＆함정 존에 놓는다。
			ENDIF
			IF 효과使用可:1 == 1
				PRINTL
				PRINTL [2]패에서 "도레미코드" P몬스터 １장을 골라、EX덱에 앞면 표시로 더한다。
				PRINTL    그 후、덱에서 레벨이 홀수와 짝수인 "도레미코드" P몬스터를 １체씩 골라、자신의 마법＆함정 존에 앞면으로 놓는다。
			ENDIF
			IF 효과使用可:2 == 1
				PRINTL
				PRINTL [3]마법 / 함정 존에서 레벨이 홀수와 짝수인 카드를 각각 １장씩 앞면 표시로 EX덱에 넣는다。
				PRINTL    그 후、덱에서２장 드로우한다。
			ENDIF
			PRINTL

			BINPUT
			IF RESULT == 1 && 효과使用可:0 == 1
				CALL CARDEFFECT_62087_1(듀얼리스트,종류,ゾーン,場所)
			ELSEIF RESULT == 2 && 효과使用可:1 == 1
				CALL CARDEFFECT_62087_2(듀얼리스트,종류,ゾーン,場所)
			ELSEIF RESULT == 3 && 효과使用可:2 == 1
				CALL CARDEFFECT_62087_3(듀얼리스트,종류,ゾーン,場所)
			ENDIF
		ELSE
			カウンタ = RAND:3
			WHILE 효과使用可:カウンタ != 1
				カウンタ = RAND:3
			WEND
			
			SELECTCASE カウンタ
				CASE 0
					PRINTL ●덱에서 "도레미코드" P몬스터 １장을 골라、자신의 마법＆함정 존에 놓는다。
					PRINTW
					CALL CARDEFFECT_62087_1(듀얼리스트,종류,ゾーン,場所)
				CASE 1
					PRINTL ●패에서 "도레미코드" P몬스터 １장을 골라、EX덱에 앞면 표시로 더한다。
					PRINTL 그 후、덱에서 레벨이 홀수와 짝수인 "도레미코드" P몬스터를 １장씩 골라、자신의 마법＆함정 존에 앞면으로 놓는다。
					PRINTW
					CALL CARDEFFECT_62087_2(듀얼리스트,종류,ゾーン,場所)
				CASE 2
					PRINTL ●마법 / 함정 존에서 레벨이 홀수와 짝수인 카드를 각각 １장씩 앞면 표시로 EX덱에 넣는다。
					PRINTL 그 후、덱에서２장 드로우한다。
					PRINTW
					CALL CARDEFFECT_62087_3(듀얼리스트,종류,ゾーン,場所)
			ENDSELECT
		ENDIF
	ENDIF
ENDIF


@CARDEFFECT_62087_1(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL FULLRESET
효과条件カテゴリ = 도레미코드
효과条件종류 = モン全般
CALL CARD_SET_BASIC(듀얼리스트,"덱",ゾーン,場所,"表側표시")

RETURN

@CARDEFFECT_62087_2(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL FULLRESET
효과条件カテゴリ = 도레미코드
효과条件종류 = モン全般
효과条件行先플래그 = EX덱行き
CALL CARD_ADD_GY_BASIC(듀얼리스트,"손패",ゾーン,場所)
IF RESULT == 1
	CALL FULLRESET
	효과条件カテゴリ = 도레미코드
	효과条件종류 = モン全般
	효과条件分割 = 펜듈럼
	효과条件レベル:0 = 1
	효과条件レベル:1 = 3
	효과条件レベル:2 = 5
	효과条件レベル:3 = 7
	CALL CARD_SET_BASIC(듀얼리스트,"덱",ゾーン,場所,"表側표시")

	CALL FULLRESET
	효과条件カテゴリ = 도레미코드
	효과条件종류 = EX以外全般
	효과条件分割 = 펜듈럼
	효과条件レベル:0 = 2
	효과条件レベル:1 = 4
	효과条件レベル:2 = 6
	효과条件レベル:3 = 8
	CALL CARD_SET_BASIC(듀얼리스트,"덱",ゾーン,場所,"表側표시")
ENDIF
RETURN

@CARDEFFECT_62087_3(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


カウンタ = 0
CALL FULLRESET
효과範囲마함 = 1
효과条件종류 = モン全般
효과条件分割 = 펜듈럼
효과条件行先플래그 = EX덱行き
효과条件レベル:0 = 1
효과条件レベル:1 = 3
효과条件レベル:2 = 5
효과条件レベル:3 = 7
효과条件レベル:4 = 9
효과条件レベル:5 = 11
CALL CARD_ADD_GY_ADV(듀얼리스트,"마함",場所)
SIF RESULT != 9999
	カウンタ++
CALL FULLRESET
효과範囲마함 = 1
효과条件종류 = モン全般
효과条件分割 = 펜듈럼
효과条件行先플래그 = EX덱行き
효과条件レベル:0 = 2
효과条件レベル:1 = 4
효과条件レベル:2 = 6
효과条件レベル:3 = 8
효과条件レベル:4 = 10
효과条件レベル:5 = 12
CALL CARD_ADD_GY_ADV(듀얼리스트,"마함",場所)
SIF RESULT != 9999
	カウンタ++

SIF カウンタ == 2
	CALL CARDDRAW_BASIC(듀얼리스트,2)

RETURN

