@CARDNAME_11310,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 마계발 차원여행 버스
	CASE "略称"
		RESULTS = 마계발 차원버스
	CASE "カテゴリ"
		RESULTS:0 = 용사 일행
		RESULTS:1 = 게임 오리지널
ENDSELECT


@CARD_11310(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		RETURN 牝性
	CASE "実装日"
		RETURN 251031
	CASE "生産불가"
		RETURN 1
	CASE "連動ID"
		RETURN 1310
ENDSELECT

RETURN 0

@CARD_EXPLANATION_11310(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
PRINTL 이 카드의 효과를 발동하는 턴、자신은 특수 소환된 몬스터 이외의 필드의 몬스터의 효과를 발동할 수 없다。
CALL CARD_ABLE(1,손패起動)
PRINTL ①：자신 필드에 몬스터가 존재하지 않는 경우、또는 효과를 갖지 않는 몬스터가 존재하면 발동할 수 있다。
PRINTL 이 카드를 패에서 특수 소환한다。
CALL CARD_ABLE(2,소환時 ,특수소환時)
PRINTL ②：이 카드가 소환 / 특수 소환에 성공했을 때 발동할 수 있다。
PRINTL 자신의 덱의 이 카드명 이외의 레벨３인 악마족 몬스터 １장을 제외한다。
PRINTL 그 카드의 소환 성공시의 효과를 발동한다。

@CARDCAN_11310(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 효과발동불가,3

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,11310)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,11310)
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0	
	SIF メインフェイズ != 1
		RETURN 0
	SIF アラメシア顕現불가 == 1
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,11310,"손패")
	SIF RESULT == 1
		RETURN 0

	;やりたいこと：
	;필드에 몬스터가 いない：OK
	;フィールド효과無しがいる　　　：OK
	;フィールド효과ありのみ　　　　：NG
	CALL FULLRESET
	효과範囲필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 0
	;필드에 몬스터가 いる場合
		효과발동불가:0 = 1

	CALL FULLRESET
	효과範囲필드 = 1
	효과条件종류 = 효과無し全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	;효과なしが1体もいない場合
	SIF RESULT != 1
		효과발동불가:1 = 1
	SIF 효과발동불가:0 == 1 && 효과발동불가:1 == 1
		RETURN 0

	RETURN 1
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	SIF 발동済_2(듀얼리스트,11310)
		RETURN 0
	SIF アラメシア顕現불가 == 1
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종족 = 악마족
	효과条件レベル = 3
	효과条件固名前 = 마계발 차원여행 버스
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_11310(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,11310,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트, "손패", 場所)
	ENDIF
ELSEIF 종류 == 소환時 || 종류 == 특수소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,11310,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종족 = 악마족
		효과条件レベル = 3
		효과条件固名前 = 마계발 차원여행 버스
		효과条件行先플래그 = 제외行き
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALLFORM CARDEFFECT_{RESULT:1}(듀얼리스트,소환時,"효과処理")
		ENDIF
	ENDIF
ENDIF