@CARDNAME_73884,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 중력의 도끼－그랄
	CASE "略称"
		RESULTS = 중력 그랄
	CASE "カテゴリ"
		RESULTS:0 = 없음
	CASE "検索カテゴリ"
		RESULTS:0 = 가디언
ENDSELECT


@CARD_73884(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 装備마법
	CASE "추가日"
		RETURN 250931
ENDSELECT

RETURN 0

@CARD_EXPLANATION_73884(종류)
#DIM DYNAMIC 종류

PRINTL ①：이하의 효과에서 １개를 선택해서 발동할 수 있다
PRINTL （이 카드명의 이하의 효과는 각각 １턴에 １번밖에 선택할 수 없다）。
CALLFORM CARD_ABLE(1,손패起動,마함起動)
PRINTL ●필드의 몬스터 １장에게 장착한다。
CALLFORM CARD_ABLE(2,손패起動)
PRINTL ●패의 이 카드를 묘지로 보내고 、덱에서 레벨５ 이상의 "가디언" 몬스터 １장을 묘지로 보낸다。
PRINTL 　그 후、자신 묘지의 레벨４ 이하의 "가디언" 몬스터 １장을 수비 표시로 특수소환할 수 있다。
CALLFORM CARD_ABLE(0,攻守変動,지속효과)
PRINTL ②：장착 몬스터의 공격력은５００ 오르고、그 공격은 관통한다。
PRINTL 또한、상대 필드의 몬스터는 표시 형식을 변경할 수 없다。
CALLFORM CARD_ABLE(0,戦破壊→묘지)
PRINTL ③：이 카드가 필드에서 묘지로 보내졌을 경우에 발동할 수 있다。
PRINTL 이 턴의 엔드 페이즈에、묘지의 이 카드를 자신 필드의 "가디언" 몬스터 １장에게 장착한다。


@CARDCAN_73884(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 발동불가,2
#DIMS DYNAMIC 装備者
#DIM DYNAMIC 装備先

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,73884)
SIF RESULT == 1
	RETURN 0

CALL 装備판정(듀얼리스트,場所,ゾーン)
装備先 = RESULT	
装備者 = %RESULTS%


IF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	SIF 발동済_1(듀얼리스트,73884)
		발동불가:0 = 1
	SIF 발동済_2(듀얼리스트,73884)
		발동불가:1 = 1
	
	SIF 마함数(듀얼리스트) >= 5 && 종류 != 마함起動
		발동불가:0 = 1
	CALL FULLRESET
	효과範囲필드 = 1
	SIF 듀얼리스트 == "자신"
		효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1

	SIF 종류 == 마함起動
		발동불가:1 = 1
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 가디언
	CALLFORM 효과条件レベル_ADV(5,"以上")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:1 = 1
	
	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 戦破壊→묘지
	SIF !GROUPMATCH(묘지送り종류,"破壊","戦闘破壊","リリース")
		RETURN 0
	RETURN 1

ELSEIF 종류 == ターン終了時予約
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 가디언
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻守変動 || 종류 == 지속효과
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	SIF 装備先 == 5
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_73884(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 발동불가,2
#DIMS DYNAMIC 装備者
#DIM DYNAMIC 装備先
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL 装備판정(듀얼리스트,場所,ゾーン)
装備先 = RESULT	
装備者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,73884)
		발동불가:0 = 1
	SIF 발동済_2(듀얼리스트,73884)
		발동불가:1 = 1
	
	SIF 마함数(듀얼리스트) >= 5 && 종류 != 마함起動
		발동불가:0 = 1

	CALL FULLRESET
	효과範囲필드 = 1
	SIF 듀얼리스트 == "자신"
		효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1

	SIF 종류 == 마함起動
		발동불가:1 = 1
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 가디언
	CALLFORM 효과条件レベル_ADV(5,"以上")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:1 = 1
	
	IF 발동불가:0 != 1 && 발동불가:1 != 1
		CALL YN_CHOICE(듀얼리스트,"●필드의 몬스터에게 장착한다。","●덱에서 레벨５ 이상의「가디언」을 묘지로 보낸다")
		SIF 듀얼리스트 != "자신"
			RESULT = 1
	ELSEIF 발동불가:0 != 1
		RESULT = 0
	ELSEIF 발동불가:1 != 1
		RESULT = 1
	ELSE
		RETURN 0
	ENDIF

	IF RESULT == 0
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73884,1)
		IF RESULT == 0
			CALL FULLRESET
			효과範囲필드 = 1
			SIF 듀얼리스트 == "자신"
				효과範囲상대필드 = 1
			CALLFORM CARD_EQUIP_ADV(듀얼리스트,場所,ゾーン)
		ENDIF
	
	ELSEIF RESULT == 1
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73884,2)
		IF RESULT == 0
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ = 가디언
			CALLFORM 효과条件レベル_ADV(5,"以上")

			
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				효과範囲묘지 = 1
				효과条件カテゴリ = 가디언
				CALLFORM 효과条件レベル_ADV(4,"以下")
				효과条件任意 = 1
				CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,73884)
	IF RESULT == 0
		CALL CARD_RESERV(듀얼리스트,73884,エンド予約)
	ENDIF

ELSEIF 종류 == ターン終了時予約
	CALL FULLRESET
	효과条件名前 = 중력의 도끼－그랄
	CALL CARD_CHOOSE_BASIC(듀얼리스트,"묘지",ゾーン,場所)
	IF RESULT != 9999
		選択カード = RESULT
		CALL FULLRESET
		효과範囲필드 = 1
		효과条件カテゴリ = 가디언
		효과条件표시 = 表側표시
		CALLFORM CARD_EQUIP_ADV(듀얼리스트,選択カード,"묘지")
	ENDIF

ELSEIF 종류 == 攻守変動
	CALL STATCHANGE_BASIC(装備者,"装備",場所,500)

ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(装備者,"装備",場所,"貫通")
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(듀얼리스트,"상대필드",場所,"表固")
ENDIF

