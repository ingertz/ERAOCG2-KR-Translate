@CARDNAME_1531,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 크라운 클랜　플레어
	CASE "略称"
		RESULTS = 클랜의 플레어
	CASE "カテゴリ"
		RESULTS:0 = 크라운 클랜
ENDSELECT


@CARD_1531(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 의식
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 야수족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 500
	CASE "守備力"
		RETURN 1000
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 260124
ENDSELECT

RETURN 0
@CARDSUMMON_1531(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照



CALL RESETCONDITION_MAT
必要レベル数 = 1

IF EX参照 == 1
	CALL RITCAN(듀얼리스트,소환カード,1531) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_1531(종류)
#DIM DYNAMIC 종류

PRINTL 「크라운 클랜」カードにより降臨
PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：패의 이 카드를 상대에게 보여주고 발동할 수 있다。
PRINTL 덱에서 의식モンスター이외의 「크라운 클랜」카드 １장을 패에 넣는다。
PRINTL 그 후、자신의 패를 １장 골라 捨てる。
PRINTL ②：이 카드가 リリースされた場合、또는 의식소환の素材となった場合、이하의 효과에서 １개를 선택해서 발동할 수 있다
PRINTL （이 카드명의 이하의 효과는 각각 １턴에 １번밖에 선택할 수 없다）。
CALLFORM CARD_ABLE(2,필드→묘지,R素材時효과)
PRINTL ●필드의 효과몬스터 １장을 裏側守備표시にする。
CALLFORM CARD_ABLE(3,필드→묘지,R素材時효과)
PRINTL ●お互いの필드 / 묘지의 의식몬스터를 모두 덱으로 되돌린다。



@CARDCAN_1531(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 발동불가,2

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,1531)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,1531)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 크라운 클랜
	효과条件固名前:0 = 크라운 클랜　플레어
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드→묘지 || 종류 == R素材時효과
	SIF 발동済_2(듀얼리스트,1531)
		발동불가:0 = 1
	SIF 발동済_3(듀얼리스트,1531)
		발동불가:1 = 1

	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件종류 = 효과全般
	효과条件표시 = 表側표시
	효과条件除去種 = 표시변경
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1
	
	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_1531(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 발동불가,2

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1531,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 크라운 클랜
		효과条件固名前:0 = 크라운 클랜　플레어
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			효과範囲손패 = 1
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF

ELSEIF 종류 == 필드→묘지 || 종류 == R素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1531)
	IF RESULT == 0
		SIF 발동済_2(듀얼리스트,1531)
			발동불가:0 = 1
		SIF 발동済_3(듀얼리스트,1531)
			발동불가:1 = 1

		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲상대필드 = 1
		효과条件종류 = 효과全般
		효과条件표시 = 表側표시
		효과条件除去種 = 표시변경
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:0 = 1

		IF 발동불가:0 != 1 && 발동불가:1 != 1
			CALL YN_CHOICE(듀얼리스트,"●효과몬스터 １장을 裏側守備표시にする。","●お互いの필드 / 묘지의 의식몬스터를 모두 덱으로 되돌린다。")
		ELSEIF 발동불가:0 != 1
			RESULT = 0
		ELSEIF 발동불가:1 != 1
			RESULT = 1
		ENDIF

		IF RESULT == 0
			CALL CARD_EFFECT_USE(듀얼리스트,1525,2)
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲상대필드 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"표시변경")
		ELSEIF RESULT == 1
			CALL CARD_EFFECT_USE(듀얼리스트,1525,3)
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲묘지 = 1
			효과範囲상대필드 = 1
			효과範囲상대묘지 = 1
			효과条件종류 = 의식
			CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"덱")
		ENDIF
	ENDIF
ENDIF