@CARDNAME_52621,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 크라운 클랜　메테오
	CASE "略称"
		RESULTS = 클랜의 메테오
	CASE "カテゴリ"
		RESULTS:0 = 크라운 클랜
ENDSELECT


@CARD_52621(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 야수족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 600
	CASE "守備力"
		RETURN 1300
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 260124
ENDSELECT

RETURN 0


@CARDSUMMON_52621(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要レベル数 = 6
IF EX参照 == 0 || EX参照 == 1
	素材条件튜너 = 1
ELSEIF EX参照 >= 10
	素材条件튜너 = -1
ENDIF

IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,50850) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_52621(종류)
#DIM DYNAMIC 종류


PRINTL 튜너＋튜너이외의 몬스터 １장 이상
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：자신의 「크라운 클랜」카드의 효과の발동に対して、상대は카드의 효과를 발동できない。
PRINTL ②：이 카드가 リリースされた場合、または의식소환の素材となった場合、以下の효과から１つを選択して발동할 수 있다
PRINTL （이 카드명의 以下의 효과는 각각 １턴에 １번しか選択できない）。
CALLFORM CARD_ABLE(2,필드→묘지,R素材時효과)
PRINTL ●「크라운 클랜　메테오」이외의 자신 묘지의 「크라운 클랜」카드 １장을 패에 넣는다。
CALLFORM CARD_ABLE(3,필드→묘지,R素材時효과)
PRINTL ●お互いの필드 / 묘지의 Ｓ몬스터를 全てＥＸ덱に戻す。

@CARDCAN_52621(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 발동불가,2

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,52621)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드→묘지 || 종류 == R素材時효과
	SIF 발동済_2(듀얼리스트,52621)
		발동불가:0 = 1
	SIF 발동済_3(듀얼리스트,52621)
		발동불가:1 = 1

	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 크라운 클랜
	효과条件固名前 = 크라운 클랜　메테오
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1
	
	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_52621(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 발동불가,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 지속효과
	CALL SET_CAT_SOGAI_INFO(듀얼리스트,"크라운 클랜")

ELSEIF 종류 == 필드→묘지 || 종류 == R素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52621)
	IF RESULT == 0
		SIF 발동済_2(듀얼리스트,52621)
			발동불가:0 = 1
		SIF 발동済_3(듀얼리스트,52621)
			발동불가:1 = 1

		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件カテゴリ = 크라운 클랜
		효과条件固名前 = 크라운 클랜　메테오
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:0 = 1

		IF 발동불가:0 != 1 && 발동불가:1 != 1
			CALL YN_CHOICE(듀얼리스트,"●자신 묘지의 「크라운 클랜」카드 １장을 패에 넣는다。","●お互いの필드 / 묘지의 Ｓ몬스터를 全て덱に戻す。")
		ELSEIF 발동불가:0 != 1
			RESULT = 0
		ELSEIF 발동불가:1 != 1
			RESULT = 1
		ENDIF

		IF RESULT == 0
			CALL CARD_EFFECT_USE(듀얼리스트,52621,2)
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件カテゴリ = 크라운 클랜
			효과条件固名前 = 크라운 클랜　메테오
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ELSEIF RESULT == 1
			CALL CARD_EFFECT_USE(듀얼리스트,52621,3)
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲묘지 = 1
			효과範囲상대필드 = 1
			효과範囲상대묘지 = 1
			효과条件종류 = 싱크로
			CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"덱")
		ENDIF
	ENDIF
ENDIF

