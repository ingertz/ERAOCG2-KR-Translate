@CARDNAME_52622,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 크라운 클랜　데블즈
	CASE "略称"
		RESULTS = 클랜의 데블즈
	CASE "カテゴリ"
		RESULTS:0 = 크라운 클랜
ENDSELECT


@CARD_52622(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 야수족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 2000
	CASE "성별"
		IF RAND:2 == 0
			RETURN 雄性
		ELSE
			RETURN 牝性
		ENDIF
	CASE "추가日"
		RETURN 260124
ENDSELECT
RETURN 0

@CARDSUMMON_52622(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 3

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,52622) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_52622(종류)
#DIM DYNAMIC 종류

PRINTL レベル３モンスター×２
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：자신フィールドのＡ소환したモンスターの攻撃力は１０００アップする。
PRINTL ②：このカードがリリースされた場合、または의식소환の素材となった場合、以下の효과から１つを選択して발동できる
PRINTL （このカード名の以下の효과はそれぞれ１ターンに１度しか選択できない）。
CALLFORM CARD_ABLE(2,필드→묘지,R素材時효과)
PRINTL ●덱から「크라운 클랜」마법カード１枚を자신フィールドにセットする。
CALLFORM CARD_ABLE(3,필드→묘지,R素材時효과)
PRINTL ●お互いのフィールド・묘지のＸモンスターを全てＥＸ덱に戻す。

@CARDCAN_52622(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 발동불가,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,52622)
SIF RESULT == 1
	RETURN 0

IF 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드→묘지 || 종류 == R素材時효과
	SIF 발동済_2(듀얼리스트,52622)
		발동불가:0 = 1
	SIF 발동済_3(듀얼리스트,52622)
		발동불가:1 = 1

	SIF 마함数(듀얼리스트) >= 5
		RETURN 0
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ = 크라운 클랜
	효과条件종류 = 마법全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1
	
	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	CALL CARD_DRAW_CHECK(1)
	RETURN 1
ENDIF


@CARDEFFECT_52622(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 발동불가,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 攻守変動
	CALL FULLRESET
	효과条件召種 = 召種通常
	CALL 효과条件レベル_ADV(5,"以上")
	CALL STATCHANGE_BASIC(듀얼리스트,"필드",場所,1000)

ELSEIF 종류 == 필드→묘지 || 종류 == R素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52622)
	IF RESULT == 0
		SIF 발동済_2(듀얼리스트,52622)
			발동불가:0 = 1
		SIF 발동済_3(듀얼리스트,52622)
			발동불가:1 = 1

		SIF 마함数(듀얼리스트) >= 5
			RETURN 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 크라운 클랜
		효과条件종류 = 마법全般
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:0 = 1

		IF 발동불가:0 != 1 && 발동불가:1 != 1
			CALL YN_CHOICE(듀얼리스트,"●덱から「크라운 클랜」마법カード１枚を자신フィールドにセットする。","●お互いのフィールド・묘지のＸモンスターを全て덱に戻す。")
		ELSEIF 발동불가:0 != 1
			RESULT = 0
		ELSEIF 발동불가:1 != 1
			RESULT = 1
		ENDIF

		IF RESULT == 0
			CALL CARD_EFFECT_USE(듀얼리스트,52622,2)
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件종류 = 마법全般
			효과条件カテゴリ = 크라운 클랜
			CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"裏側표시")
		ELSEIF RESULT == 1
			CALL CARD_EFFECT_USE(듀얼리스트,52622,3)
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲묘지 = 1
			효과範囲상대필드 = 1
			효과範囲상대묘지 = 1
			효과条件종류 = 엑시즈
			CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"덱")
		ENDIF
	ENDIF
ENDIF