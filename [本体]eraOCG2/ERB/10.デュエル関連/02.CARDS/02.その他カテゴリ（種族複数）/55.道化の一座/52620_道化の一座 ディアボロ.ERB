@CARDNAME_52620,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 크라운 클랜　디아볼로
	CASE "略称"
		RESULTS = 클랜의 디아볼로
	CASE "カテゴリ"
		RESULTS:0 = 크라운 클랜
ENDSELECT


@CARD_52620(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 야수족
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 200
	CASE "守備力"
		RETURN 1800
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 260124
ENDSELECT
RETURN 0

@CARD_EXPLANATION_52620(종류)
#DIM DYNAMIC 종류

;現状再現불가なので最強モンスターに
PRINTL 종족が異なるモンスター×２
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：Ａ소환した자신의 モンスターが守備표시몬스터를 攻撃した場合、
PRINTL その守備力を공격력이 超えた分の倍の数値だけ상대に戦闘ダメージを与える。
PRINTL ②：이 카드가 リリースされた場合、または의식소환の素材となった場合、이하의 효과에서 １개를 선택해서 발동할 수 있다
PRINTL （이 카드명의 이하의 효과는 각각 １턴에 １번밖에 선택할 수 없다）。
CALLFORM CARD_ABLE(2,필드→묘지,R素材時효과)
PRINTL ●덱에서 「크라운 클랜」함정카드 １장을 자신 필드에 セットする。
CALLFORM CARD_ABLE(3,필드→묘지,R素材時효과)
PRINTL ●お互いの필드 / 묘지의 융합몬스터를 全てＥＸ덱に戻す。



@CARDSUMMON_52620(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件R종족起動 = 1

IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,52620) 
	RETURN RESULT
ENDIF



@CARDCAN_52620(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 발동불가,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,52620)
SIF RESULT == 1
	RETURN 0

IF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻撃時強制誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF 戦闘場所(듀얼리스트) == 5
		RETURN 0
	TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_필드:戦闘場所(듀얼리스트)")},"レベル"
	SIF RESULT < 5
		RETURN 0
	TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_필드:戦闘場所(듀얼리스트)")},"종류"
	SIF !GROUPMATCH(RESULT,通常モン,효과モン)
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_召種:戦闘場所(듀얼리스트)") != 召種通常
		RETURN 0
	SIF GETVAR(@"%対面者%_MZ_表:戦闘場所(듀얼리스트,1)") == 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 필드→묘지 || 종류 == R素材時효과
	SIF 발동済_2(듀얼리스트,52620)
		발동불가:0 = 1
	SIF 발동済_3(듀얼리스트,52620)
		발동불가:1 = 1

	SIF 마함数(듀얼리스트) >= 5
		발동불가:0 = 1
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件종류 = 함정全般
	효과条件カテゴリ = 크라운 클랜
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1
	
	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	CALL CARD_DRAW_CHECK(1)
	RETURN 1
ENDIF



@CARDEFFECT_52620(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 발동불가,2

IF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"貫通")

ELSEIF 종류 == 攻撃時強制誘発
	CALL SET_PLAYER_INFO(듀얼리스트,"ダメージ倍化", 3 ,1)

ELSEIF 종류 == 필드→묘지 || 종류 == R素材時효과
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52620)
	IF RESULT == 0
		SIF 발동済_2(듀얼리스트,52620)
			발동불가:0 = 1
		SIF 발동済_3(듀얼리스트,52620)
			발동불가:1 = 1

		SIF 마함数(듀얼리스트) >= 5
			발동불가:0 = 1
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件종류 = 함정全般
		효과条件カテゴリ = 크라운 클랜
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			발동불가:0 = 1

		IF 발동불가:0 != 1 && 발동불가:1 != 1
			CALL YN_CHOICE(듀얼리스트,"●덱에서 「크라운 클랜」함정카드 １장을 자신 필드에 セットする。","●お互いの필드 / 묘지의 융합몬스터를 全て덱に戻す。")
		ELSEIF 발동불가:0 != 1
			RESULT = 0
		ELSEIF 발동불가:1 != 1
			RESULT = 1
		ENDIF

		IF RESULT == 0
			CALL CARD_EFFECT_USE(듀얼리스트,52620,2)
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件종류 = 함정全般
			효과条件カテゴリ = 크라운 클랜
			CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"裏側표시")
		ELSEIF RESULT == 1
			CALL CARD_EFFECT_USE(듀얼리스트,52620,3)
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲묘지 = 1
			효과範囲상대필드 = 1
			효과範囲상대묘지 = 1
			효과条件종류 = 융합
			CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"덱")
		ENDIF
	ENDIF
ENDIF
