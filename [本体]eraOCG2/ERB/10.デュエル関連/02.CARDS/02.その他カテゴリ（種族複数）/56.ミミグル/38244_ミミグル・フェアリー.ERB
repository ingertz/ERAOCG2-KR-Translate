@CARDNAME_38244,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 미미구르 페어리
	CASE "略称"
		RESULTS = Mmgl페어리
	CASE "カテゴリ"
		RESULTS:0 = 미미구르
		RESULTS:1 = 요정
ENDSELECT


@CARD_38244(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 100
	CASE "守備力"
		RETURN 100
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251025
ENDSELECT
RETURN 0

@CARD_EXPLANATION_38244(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：자신メインフェイズに발동できる。
PRINTL 손패から「미미구르 페어리」１体を상대フィールドに裏側守備표시で특수소환できる。
PRINTL 특수소환せず、상대フィールドのモンスターの数が자신フィールドのモンスターより多い場合、
PRINTL 代わりに자신 필드에 表側표시で특수소환する。
CALLFORM CARD_ABLE(2,リバース誘発)
PRINTL ②：このカードがメインフェイズにリバースした場合に발동する。以下の효과を각각 適用する。
PRINTL ●このターン、자신フィールドの元々の持ち主が자신の손패から특수소환されたモンスター의 효과는 無効化される。
;발동しない효과も無効（仕様限界）
PRINTL ●このカードのコントロールを상대に移す。



@CARDCAN_38244(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,38244)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,38244)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ELSEIF 종류 == リバース誘発
	SIF 발동済_2(듀얼리스트,38244)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDFORCE_38244(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

VARSET RESULT
IF 종류 == リバース誘発
	RETURN 1
ENDIF


@CARDEFFECT_38244(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,38244,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件名前 = 미미구르 페어리
		효과条件任意 = 1
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"裏側守備표시",,1)
		IF RESULT != 1 && モンスター数(듀얼리스트) < モンスター数(対面者)
			CALL FULLRESET
			효과範囲손패 = 1
			효과条件名前 = 미미구르 페어리
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"裏側守備표시")
		ENDIF
	ENDIF
ELSEIF 종류 == リバース誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,38244,2)
	IF RESULT == 0
		CALL CARD_RESERV(듀얼리스트,38244,短紋章予約)

		CALL FULLRESET
		CALL CARD_GET_CONTROL(対面者,場所)
	ENDIF
ELSEIF 종류 == 短紋章起動
	CALL FULLRESET
	효과条件所有 = 1
	효과条件召種 = 召種손패
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"無効")
ENDIF
