@CARDNAME_38244,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 미미구르 페어리
	CASE "略称"
		RESULTS = Mmgl페어리
	CASE "カテゴリ"
		RESULTS:0 = 미미구르
		RESULTS:1 = 요정
ENDSELECT


@CARD_38244(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 100
	CASE "守備力"
		RETURN 100
	CASE "성별"
		RETURN 雄性
	CASE "추가日"
		RETURN 251025
ENDSELECT
RETURN 0

@CARD_EXPLANATION_38244(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：자신 메인 페이즈에 발동할 수 있다。
PRINTL 패에서 "미미구르 페어리" １장을 상대 필드에 뒷면 수비 표시로 특수 소환할 수 있다。
PRINTL 특수 소환하지 않고、상대 필드의 몬스터의 수가 자신 필드의 몬스터보다 많은 경우、
PRINTL 대신에 자신 필드에 앞면 표시로 특수 소환한다。
CALLFORM CARD_ABLE(2,リバース誘発)
PRINTL ②：이 카드가 메인 페이즈에 리버스된 경우에 발동한다。이하의 효과를 각각 적용한다。
PRINTL ●이 턴、자신 필드의 원래 주인이 자신의 패에서 특수 소환한 몬스터의 효과는 무효화된다。
;발동しない효과も無効（仕様限界）
PRINTL ●이 카드의 컨트롤을 상대에게 옮긴다。



@CARDCAN_38244(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,38244)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,38244)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ELSEIF 종류 == リバース誘発
	SIF 발동済_2(듀얼리스트,38244)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDFORCE_38244(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

VARSET RESULT
IF 종류 == リバース誘発
	RETURN 1
ENDIF


@CARDEFFECT_38244(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,38244,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件名前 = 미미구르 페어리
		효과条件任意 = 1
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"裏側守備표시",,1)
		IF RESULT != 1 && モンスター数(듀얼리스트) < モンスター数(対面者)
			CALL FULLRESET
			효과範囲손패 = 1
			효과条件名前 = 미미구르 페어리
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"裏側守備표시")
		ENDIF
	ENDIF
ELSEIF 종류 == リバース誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,38244,2)
	IF RESULT == 0
		CALL CARD_RESERV(듀얼리스트,38244,短紋章予約)

		CALL FULLRESET
		CALL CARD_GET_CONTROL(対面者,場所)
	ENDIF
ELSEIF 종류 == 短紋章起動
	CALL FULLRESET
	효과条件所有 = 1
	효과条件召種 = 召種손패
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"無効")
ENDIF
