@CARDNAME_38243,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 미미구르 슬라임
	CASE "略称"
		RESULTS = Mmgl슬라임
	CASE "カテゴリ"
		RESULTS:0 = 미미구르
		RESULTS:1 = 슬라임
ENDSELECT


@CARD_38243(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 원소정령족
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 400
	CASE "守備力"
		RETURN 500
	CASE "성별"
		RETURN 無性
	CASE "추가日"
		RETURN 251025
ENDSELECT
RETURN 0

@CARD_EXPLANATION_38243(종류)
#DIM DYNAMIC 종류

PRINTL このカード名の①②の효과はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：자신メインフェイズに발동できる。
PRINTL 손패から「미미구르 슬라임」１体を상대フィールドに裏側守備표시で특수소환できる。
PRINTL 특수소환せず、상대フィールドのモンスターの数が자신フィールドのモンスターより多い場合、
PRINTL 代わりに자신フィールドに表側표시で특수소환する。
CALLFORM CARD_ABLE(2,リバース誘発)
PRINTL ②：このカードがメインフェイズにリバースした場合に발동する。以下の효과をそれぞれ適用する。
PRINTL ●상대は自身の덱から「미미구르」モンスター１体を특수소환できる。
PRINTL ●このカードのコントロールを상대に移す。



@CARDCAN_38243(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,38243)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,38243)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1
ELSEIF 종류 == リバース誘発
	SIF 발동済_2(듀얼리스트,38243)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDFORCE_38243(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

VARSET RESULT
IF 종류 == リバース誘発
	RETURN 1
ENDIF


@CARDEFFECT_38243(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,38243,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件名前 = 미미구르 슬라임
		SIF モンスター数(듀얼리스트) < モンスター数(対面者)
			효과条件任意 = 1
		CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"裏側守備표시",,1)
		IF RESULT != 1 && モンスター数(듀얼리스트) < モンスター数(対面者)
			CALL FULLRESET
			효과範囲손패 = 1
			효과条件名前 = 미미구르 슬라임
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所,"裏側守備표시")
		ENDIF
	ENDIF
ELSEIF 종류 == リバース誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,38243,2)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ = 미미구르
		CALL CARD_SP_SUMMON_ADV(対面者,ゾーン,場所)

		CALL FULLRESET
		CALL CARD_GET_CONTROL(対面者,場所)
	ENDIF
ENDIF
