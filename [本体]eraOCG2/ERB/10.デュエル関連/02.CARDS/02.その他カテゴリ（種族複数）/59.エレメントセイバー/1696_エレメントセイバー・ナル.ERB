@CARDNAME_1696,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 엘리멘트세이버 나르
	CASE "略称"
		RESULTS = ElmS 나르
	CASE "カテゴリ"
		RESULTS:0 = 엘리멘트세이버
		RESULTS:1 = 엘리멘트
		;カテゴリ縛りのSS、EX소환のために설정
		RESULTS:4 = 령신
ENDSELECT


@CARD_1696(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 물속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 1000
	CASE "령신속성"
		RETURN 1
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251030
ENDSELECT

RETURN 0

@CARD_EXPLANATION_1696(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：패의 이 카드를 묘지로 보내고 발동할 수 있다。자신의 덱에서 "령신의 성전" １장을 패에 넣는다。
PRINTL 자신 필드가 "령신의 성전"인 경우、대신에 "령신" 마법 / 함정 카드 １장을 패에 넣을 수 있다。
CALLFORM CARD_ABLE(10,필드起動)
PRINTL ②：１턴에 １번、패에서 "엘리멘트" 몬스터 １장을 묘지로 보내고、자신 묘지의 "엘리멘트세이버 나르" 이외의
PRINTL "령신" / "엘리멘트" 몬스터 １장을 대상으로 하고 발동할 수 있다。그 몬스터를 패에 넣는다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：묘지의 이 카드는、모든 속성을 가진 몬스터로서 취급한다。

;「엘리멘트세이버」の初動にもなる優秀な女戦士。필드でのサルベージ효과も발동時に最低１枚は대상が묘지に存在している必要があるものの、
;テーマの殆どの카드를 패에 サルベージできる효과になっていて色々と応用が効く性能になっている。「령신의 성전」の③의 효과를 活用すれば、
;묘지経由の実質「엘리멘트세이버」몬스터의 サーチ효과としても使える。손패コストは要るもののこれも名称ターン１でない효과になっている。
;攻撃1500守備1000という比較的高いステータスも、「령신의 성전」のパンプアップ等を駆使すれば打点要員になれて地味ながら偉い。

;女の子であるため、若干「엘리멘트」にも寄り添った효과にしている。ただし①의 サーチ範囲は「엘리멘트세이버」向けなので相性はそこそこ止まり。


@CARDCAN_1696(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 추가条件플래그 = 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,1696)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,1696)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVARS(@"%듀얼리스트%_フィールド名") == "령신의 성전"
		추가条件플래그 |= 1
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ:0 = 더미
	SIF 추가条件플래그 & 1
		효과条件カテゴリ:1 = 령신
	효과条件종류 = 마함全般
	효과条件スーパー名前 = 령신의 성전
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件名前 = 령신의 성전
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1 && !(발동済_3(듀얼리스트,71705))
		추가条件플래그 |= 1
	CALL FULLRESET
	효과範囲손패 = 1
	SIF 추가条件플래그 & 1
		효과範囲덱 = 1
	효과条件カテゴリ = 엘리멘트
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ:0 = 령신
	효과条件カテゴリ:1 = 엘리멘트
	효과条件종류 = モン全般
	효과条件固名前 = 엘리멘트세이버 나르
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_1696(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 추가条件플래그 = 0
#DIM DYNAMIC 손패枚数＿前
#DIM DYNAMIC 손패枚数＿後

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1696,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		
		SIF GETVARS(@"%듀얼리스트%_フィールド名") == "령신의 성전"
			추가条件플래그 |= 1
		CALL FULLRESET
		효과範囲덱 = 1
		효과条件カテゴリ:0 = 더미
		SIF 추가条件플래그 & 1
			효과条件カテゴリ:1 = 령신
		효과条件종류 = 마함全般
		효과条件スーパー名前 = 령신의 성전
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1695,10)
	IF RESULT == 0
		손패枚数＿前 = 손패数(듀얼리스트)
		CALL FULLRESET
		효과範囲마함 = 1
		효과条件名前 = 령신의 성전
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1 && !(발동済_3(듀얼리스트,71705))
			추가条件플래그 |= 1
		;패의 엘리멘트몬스터를 묘지로 보낸다。(条件次第で덱에서 も送れる)
		CALL FULLRESET
		효과範囲손패 = 1
		SIF 추가条件플래그 & 1
			효과範囲덱 = 1
		효과条件カテゴリ = 엘리멘트
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			;묘지へ送る前後で패의 枚数を確認し、減っていない場合は덱에서 送ったと판정し령신의 성전の효과③を使用した扱いに。
			손패枚数＿後 = 손패数(듀얼리스트)
			IF 손패枚数＿前 == 손패枚数＿後
				;령신의 성전의 효과를 발동した！
				SETCOLOR C_YELLOW
				PRINTFORML "령신의 성전"의 효과에 의해 덱에서 직접 몬스터를 묘지로 보냈다！！
				RESETCOLOR
				CALL CARD_EFFECT_USE(듀얼리스트,71705,3)
			ENDIF
			;묘지의 몬스터를 サルベージ
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件カテゴリ:0 = 령신
			효과条件カテゴリ:1 = 엘리멘트
			효과条件종류 = モン全般
			효과条件固名前 = 엘리멘트세이버 나르
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF
