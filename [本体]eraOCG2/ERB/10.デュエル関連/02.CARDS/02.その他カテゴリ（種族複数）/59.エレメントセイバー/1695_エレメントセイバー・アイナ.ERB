@CARDNAME_1695,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 엘리멘트세이버 아이나
	CASE "略称"
		RESULTS = ElmS 아이나
	CASE "カテゴリ"
		RESULTS:0 = 엘리멘트세이버
		RESULTS:1 = 엘리멘트
		;カテゴリ縛りのSS、EX소환のために설정
		RESULTS:4 = 령신
ENDSELECT


@CARD_1695(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 900
	CASE "守備力"
		RETURN 1800
	CASE "령신속성"
		RETURN 1
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251030
ENDSELECT

RETURN 0

@CARD_EXPLANATION_1695(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ②의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(10,필드起動)
PRINTL ①：１턴에 １번、패에서 "엘리멘트" 몬스터 １장을 묘지로 보내고、
PRINTL 자신 묘지의 "엘리멘트세이버 아이나" 이외의 "엘리멘트" 몬스터 １장을 대상으로 하고 발동할 수 있다。그 몬스터를 특수 소환한다。
CALLFORM CARD_ABLE(2,묘지起動)
PRINTL ②：자신 필드에 레벨５ 이상인 "엘리멘트세이버" 몬스터 또는 ４종류 이상의 속성인 몬스터가 존재하는 경우에 발동할 수 있다。
PRINTL 묘지의 이 카드를 포함해、자신 묘지의 몬스터를 ５장까지 덱으로 되돌리고、１장 드로우한다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：묘지의 이 카드는、모든 속성을 가진 몬스터로서 취급한다。

;「엘리멘트세이버」の継戦能力を支える縁の下の力持ちな女戦士。蘇生효과で盤面にモンスターを並べる能力を持っている。
;自身は蘇生できないので손패コストの続く限り横並べ、みたいな無法は流石に難しいが、名称ターン１じゃない展開효과には若干の不穏さを感じる。
;발동の際に蘇生可能な「엘리멘트」モンスターが１体以上は묘지に必要だが、손패から묘지へ送ったモンスターを即座に蘇生する事もできる。
;とはいえ、「엘리멘트세이버」では손패を切りすぎると위라드の특수소환が難しくなってしまうので、フィールドに出力しすぎるのも考え物。
;蘇生して展開を繋げたり、링크モンスターに変換して상대盤面を処理したりする用途であれば頼もしい存在であろう。
;②はリソース회복효과。「엘리멘트세이버」も「엘리멘트」も묘지を肥やすテーマだが、ロングゲームになった時にリソース회복は有り難いだろう。
;③は上部のカードデータ部分の「령신속성」という項目での対応となっている。この記述があると묘지限定で全속성のモンスターと同等の扱いになる。
;※필터処理で行っているため、カードデータに속성が추가されているわけではない。なので元々の속성は「CALL CARD_1695,"속성"」などで参照可能。

;땅속성の女の子ということで「엘리멘트」テーマとの相性が６人の中で最も高くなるよう意図して調整している。


@CARDCAN_1695(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 추가条件플래그 = 0
#DIM DYNAMIC 使用플래그 = 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,1695)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件名前 = 령신의 성전
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1 && !(발동済_3(듀얼리스트,71705))
		추가条件플래그 |= 1
	CALL FULLRESET
	효과範囲손패 = 1
	SIF 추가条件플래그 & 1
		효과範囲덱 = 1
	효과条件カテゴリ = 엘리멘트
	효과条件종류 = モン全般
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 엘리멘트
	효과条件종류 = モン全般
	효과条件固名前 = 엘리멘트세이버 아이나
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 묘지起動
	SIF 발동済_2(듀얼리스트,1695)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件종류 = モン全般
	효과条件CNT = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT < 3
		RETURN 0
	
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 엘리멘트세이버
	효과条件종류 = モン全般
	CALL 효과条件レベル_ADV(5, "以上")
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		使用플래그 |= 1
	
	CALL FULLRESET
	CALL FIELD_INFO_COUNT(듀얼리스트,"属")
	SIF RESULT >= 4
		使用플래그 |= 2
	SIF 使用플래그 == 0
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF

@CARDEFFECT_1695(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 추가条件플래그 = 0
#DIM DYNAMIC 손패枚数＿前
#DIM DYNAMIC 손패枚数＿後

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1695,10)
	IF RESULT == 0
		손패枚数＿前 = 손패数(듀얼리스트)
		CALL FULLRESET
		효과範囲마함 = 1
		효과条件名前 = 령신의 성전
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1 && !(발동済_3(듀얼리스트,71705))
			추가条件플래그 |= 1
		;손패の엘리멘트モンスターを묘지へ送る。(条件次第で덱からも送れる)
		CALL FULLRESET
		효과範囲손패 = 1
		SIF 추가条件플래그 & 1
			효과範囲덱 = 1
		효과条件カテゴリ = 엘리멘트
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			;묘지へ送る前後で손패の枚数を確認し、減っていない場合は덱から送ったと판정し령신의 성전の효과③を使用した扱いに。
			손패枚数＿後 = 손패数(듀얼리스트)
			IF 손패枚数＿前 == 손패枚数＿後
				;령신의 성전の효과を발동した！
				SETCOLOR C_YELLOW
				PRINTFORML "령신의 성전"의 효과에 의해 덱에서 직접 몬스터를 묘지로 보냈다！！
				RESETCOLOR
				CALL CARD_EFFECT_USE(듀얼리스트,71705,3)
			ENDIF
			;묘지のモンスターを蘇生
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件カテゴリ = 엘리멘트
			효과条件종류 = モン全般
			효과条件固名前 = 엘리멘트세이버 아이나
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 종류 == 묘지起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,1695,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,덱行き)
		CALL FULLRESET
		효과条件종류 = モン全般
		효과条件複数 = 96
		효과条件行先플래그 = 덱行き
		CALL CARD_ADD_GY_BASIC(듀얼리스트,"묘지",ゾーン,場所)
		IF RESULT == 1
			CALL CARDDRAW_BASIC(듀얼리스트,1)
		ENDIF
	ENDIF
ENDIF
