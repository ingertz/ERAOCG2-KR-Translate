@CARDNAME_91705,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		;RESULTS = エレメンタル・トレーニング
		RESULTS = 엘리멘틀 트레이닝
	CASE "略称"
		RESULTS = 령신통일
	CASE "カテゴリ"
		RESULTS:0 = 령신
ENDSELECT


@CARD_91705(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속함정
	CASE "추가日"
		RETURN 251030
ENDSELECT

RETURN 0

@CARD_EXPLANATION_91705(종류)
#DIM DYNAMIC 종류
PRINTL 이 카드명의 ③의 효과는 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ①：이 카드가 마법＆함정 존에 존재하는한、자신 필드의 "령신의 성전"은 효과로는 파괴되지 않으며、상대 효과의 대상이 되지 않는다。
CALLFORM CARD_ABLE(10,마함起動,フリー誘発)
PRINTL ②：１턴에 １번、자신 필드의 몬스터 １장을 릴리스하고 발동할 수 있다。
PRINTL 릴리스한 몬스터와 원래 속성이 다른 "엘리멘트세이버" 몬스터 １장을 덱에서 특수 소환한다。
PRINTL 그 후、이 효과로 특수 소환한 몬스터의 속성과 같은 속성의 상대 필드의 몬스터 １장을 골라、그 효과를 무효로 할 수 있다。
CALLFORM CARD_ABLE(3,마함起動)
PRINTL ③：자신 메인 페이즈에 마법＆함정 존의 앞면 표시인 이 카드를 묘지로 보내고 발동할 수 있다。자신의 패를 ６장까지 골라 묘지로 보낸다。
PRINTL 그 후、이 효과로 묘지로 보낸 카드의 수 만큼、자신의 묘지에서 "령신" / "엘리멘트세이버" 몬스터를 패에 넣을 수 있다。

;【엘리멘트세이버】の마함による妨害효과とリクルートを兼ねた지속함정。필드에 維持できれば妨害と展開補助の両面で使えるなかなか優秀な함정。
;重要なアド稼ぎ源の「령신의 성전」を保護する효과もあるため、出来ればこのカードも伏せた状態でターンを返せるようにしたいところ。
;②のリクルートに속성条件つきの妨害と、③の패의 묘지送り枚数を最大６枚で選べる融通が利く효과に調整して、使い勝手を向上させている。
;その代わりの軽い調整として、③의 효과를 발동할 수 있다フェイズを지정してフリチェ발동をできなくした。これはeraOCG2での操作性に配慮した調整。
;本来できていた動きを減らす調整なのだが、③はうっかり押しミスしたら大変なことになる효과なので、そもそも聞いてくる機会を減らすようにしている。
;なお、③はセット状態からの발동時に即時使用する事ができない。これはQ&A記載の裁定でOCGの仕様（앞면 표시인 ～と지정している지속함정で共通の裁定）
;裁定を調べたら②の효과발동したチェーンで③の효과の발동出来ないとの記載もある。마함起動효과が２つある지속함정は複雑な処理をしていて難しい。
;
;「엘리멘트세이버」덱は、묘지に各속성の戦士を貯める動きをしつつ、「엘리멘틀 트레이닝」での妨害も行うためには덱にも適度に
;몬스터를 残す必要があるため、複数のゾーンの残り몬스터를 意識して扱う必要がある。展開の簡単さの割には使いこなすのがやや難しいのは仕様。


@CARDCAN_91705(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 효과制限달성
#DIM DYNAMIC 条件달성플래그 = 0
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 複数속성, 8

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,91705)
SIF RESULT == 1
	RETURN 0

IF (종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")) && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") == 3
		RETURN 0
	;-----------------------------
	;②효과のチェック　②が발동できない場合は「条件달성플래그 |= 1」を설정
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		条件달성플래그 |= 1
	
	;덱に存在する엘리멘트세이버の속성を確認する。（二속성以上あれば필드의 モンスターは何を릴리스하고 も大丈夫になる。）
	;속성が１つしかない場合(RESULT:0 == 6)に利用するため효과制限달성の플래그を立てる。
	;※後の処理で存在している속성 이외의 몬스터가 필드에 あるか確認で利用するので反転플래그を使う。
	CALL FULLRESET
	효과条件カテゴリ = 엘리멘트세이버
	CALL ELEMENTS_KIND_BASIC(듀얼리스트,"덱",複数속성,0,1)
	SIF RESULT:1 == 6
		효과制限달성 = 1
	
	;全속성の플래그が立ってる場合（덱に「엘리멘트세이버」몬스터가 １人も居ない場合）は②は발동할 수 없다。
	SIF RESULT:1 == 7
		条件달성플래그 |= 1
	
	CALL FULLRESET
	효과範囲필드 = 1
	SIF 효과制限달성 == 1
		CALL 효과条件속성_複数(複数속성)
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		条件달성플래그 |= 1
	
	;-----------------------------
	;③효과のチェック　③が발동できない場合は「条件달성플래그 |= 2」を설정
	IF メインフェイズ == 1 && 종류 == 마함起動 && ターンプレイヤー == 듀얼리스트
		SIF 발동済_3(듀얼리스트,91705)
			条件달성플래그 |= 2

		CALL FULLRESET
		효과範囲손패 = 1
		효과条件他所 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			条件달성플래그 |= 2
	ELSE
		条件달성플래그 |= 2
	ENDIF
	SIF 条件달성플래그 & 1 && 条件달성플래그 & 2
		RETURN 0
	RETURN 1
;ELSEIF 종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함" && GETVAR(@"%듀얼리스트%_魔_表:場所") == 2)
ELSEIF 종류 == 마함起動
	CALL CARD_SET_ACT(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_91705(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 選択カード속성
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC リピート数
#DIM DYNAMIC 속성数
#DIM DYNAMIC 발동효과종류 = 0
#DIM DYNAMIC 条件달성플래그 = 0
#DIM DYNAMIC 효과制限달성 = 0
#DIM DYNAMIC 選択結果
#DIM DYNAMIC 複数속성, 8

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF (종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함")) && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	;両方の효과が利用可能か確認する。条件달성플래그が0なら両方の효과が발동可能。
	;両方발동可能（자신メインフェイズの마함起動で、かつどちらの발동条件も満たしている）なら、使う효과를 選択する。
	
	;-----------------------------
	;②효과のチェック　②が발동できない場合は「条件달성플래그 |= 1」を설정
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		条件달성플래그 |= 1
	
	;덱に存在する엘리멘트세이버の속성を確認する。（二속성以上あれば필드의 モンスターは何を릴리스하고 も大丈夫になる。）
	;속성が１つしかない場合(RESULT:0 == 6)に利用するため효과制限달성の플래그を立てる。
	;※後の処理で存在している속성 이외의 몬스터가 필드에 あるか確認で利用するので反転플래그を使う。
	CALL FULLRESET
	효과条件カテゴリ = 엘리멘트세이버
	CALL ELEMENTS_KIND_BASIC(듀얼리스트,"덱",複数속성,0,1)
	SIF RESULT:1 == 6
		효과制限달성 = 1
	
	;全속성の플래그が立ってる場合（덱に「엘리멘트세이버」몬스터가 １人も居ない場合）は②は발동할 수 없다。
	SIF RESULT:1 == 7
		条件달성플래그 |= 1
	
	CALL FULLRESET
	효과範囲필드 = 1
	SIF 효과制限달성 == 1
		CALL 효과条件속성_複数(複数속성)
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		条件달성플래그 |= 1
	
	;-----------------------------
	;③효과のチェック　③が발동できない場合は「条件달성플래그 |= 2」を설정
	IF メインフェイズ == 1 && 종류 == 마함起動 && ターンプレイヤー == 듀얼리스트
		SIF 발동済_3(듀얼리스트,91705)
			条件달성플래그 |= 2
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件他所 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			条件달성플래그 |= 2
	ELSE
		条件달성플래그 |= 2
	ENDIF
	
	IF 条件달성플래그 == 0
		IF 듀얼리스트 == "상대"
			;CPUは、両方を발동할 수 있다場合はまず先に②의 효과를 優先して使う（③を使うと이 카드를 묘지로 보내고 しまうため）
			選択結果 = はい
		ELSE
			CUSTOMDRAWLINE —
			PRINTFORML 
			PRINTFORML 어느 효과를 사용하시겠습니까？
			PRINTFORML 
			PRINTL ②：１턴에 １번、자신 필드의 몬스터 １장을 릴리스하고 발동할 수 있다。
			PRINTL 릴리스한 몬스터와 원래 속성이 다른 "엘리멘트세이버" 몬스터 １장을 덱에서 특수 소환한다。
			PRINTL 그 후、이 효과로 특수 소환한 몬스터의 속성과 같은 속성의 상대 필드의 몬스터 １장을 골라、그 효과를 무효로 할 수 있다。
			PRINTL ③：자신 메인 페이즈에 마법＆함정 존의 앞면 표시인 이 카드를 묘지로 보내고 발동할 수 있다。자신의 패를 ６장까지 골라서 묘지로 보낸다。
			PRINTL 그 후、이 효과로 묘지로 보낸 카드의 수 만큼、자신의 묘지에서 "령신" / "엘리멘트세이버" 몬스터를 패에 넣을 수 있다。
			PRINTFORML 
			CALL YN_CHOICE(듀얼리스트,"②の효과","③の효과")
			選択結果 = RESULT
		ENDIF
	ELSEIF 条件달성플래그 & 1
		選択結果 = いいえ
	ELSE
		選択結果 = はい
	ENDIF
	IF 選択結果 == はい
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91705,10)
		IF RESULT == 0
			;②の효과処理
			$EFFECT_91705_2
			
			CALL FULLRESET
			효과範囲필드 = 1
			SIF 효과制限달성 == 1
				CALL 효과条件속성_複数(複数속성)
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				選択カードID = RESULT:1
				TRYCALLFORM CARD_{選択カードID}, "속성"
				;複数속성持ちの몬스터를 リリースした場合でも、RESULT:0の속성を元々の속성として扱う
				選択カード속성 = RESULT:0
				;選択カード속성 이외의 속성で選ぶ処理（反転している）
				VARSET 複数속성
				FOR カウンタ,1,8
					SIF 選択カード속성 != カウンタ
						複数속성:(カウンタ) = 1
				NEXT
				CALL FULLRESET
				효과範囲덱 = 1
				효과条件カテゴリ = 엘리멘트세이버
				효과条件종류 = モン全般
				CALL 효과条件속성_複数(複数속성)
				CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
				IF RESULT == 1
					;특수소환成功後、특수 소환한 モンスターと同じ속성の몬스터를 無効化する処理
					選択カードID = RESULT:1
					TRYCALLFORM CARD_{選択カードID}, "속성"
					選択カード속성 = RESULT:0
					CALL FULLRESET
					효과範囲상대필드 = 1
					효과条件속성 = 選択カード속성
					효과条件除去種 = 無効
					CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
					IF RESULT == 1
						CALL FULLRESET
						효과条件속성 = 選択カード속성
						효과条件표시 = 表側표시
						효과条件任意 = 1
						CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",場所,"지속無効")
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ELSEIF 選択結果 == いいえ
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91705,3)
		IF RESULT == 0
			CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,묘지行き)
			;③の효과処理
			CALL FULLRESET
			효과範囲손패 = 1
			효과条件複数 = 94
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				リピート数 = RESULT:2
				CALL FULLRESET
				효과範囲묘지 = 1
				효과条件カテゴリ:0 = 령신
				효과条件カテゴリ:1 = 엘리멘트세이버
				효과条件종류 = モン全般
				효과条件複数 = 100 - リピート数
				CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 마함起動 || (종류 == フリー誘発 && ゾーン == "마함" && GETVAR(@"%듀얼리스트%_魔_表:場所") == 2)
	;カード발동＆설치まで
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,91705)
	IF RESULT == 0
		;②の효과が발동可能か確認し、발동可能であれば使用することも選択できる。
		TRYCALLFORM CARDCAN_91705(듀얼리스트,フリー誘発,"마함",場所)
		IF RESULT == 1
			CUSTOMDRAWLINE —
			PRINTFORML 
			PRINTFORML 지금、"엘리멘틀 트레이닝"의 ②의 효과를 사용하시겠습니까？
			PRINTFORML 
			PRINTL ②：１턴에 １번、자신 필드의 몬스터 １장을 릴리스하고 발동할 수 있다。
			PRINTL 릴리스한 몬스터와 원래 속성이 다른 "엘리멘트세이버" 몬스터 １장을 덱에서 특수 소환한다。
			PRINTL 그 후、이 효과로 특수 소환한 몬스터의 속성과 다른 속성의 상대 필드의 몬스터 １장을 골라、그 효과를 무효로 할 수 있다。
			PRINTFORML 
			CALL YN_CHOICE(듀얼리스트)
			IF RESULT == 0
				CALL CARD_EFFECT_USE(듀얼리스트, 91705, 10)
				GOTO EFFECT_91705_2
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件名前 = 령신의 성전
	CALL STATCHANGE_EFFECT(듀얼리스트,"마함",場所,"対耐")
	CALL STATCHANGE_EFFECT(듀얼리스트,"마함",場所,"破耐")
ENDIF
