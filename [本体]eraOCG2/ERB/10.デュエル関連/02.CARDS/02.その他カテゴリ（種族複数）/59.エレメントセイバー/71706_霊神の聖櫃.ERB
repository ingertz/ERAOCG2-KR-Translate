@CARDNAME_71706,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 령신의 성궤
	CASE "略称"
		RESULTS = 령신의 성궤
	CASE "カテゴリ"
		RESULTS:0 = 령신
		RESULTS:3 = 게임 오리지널
ENDSELECT


@CARD_71706(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 지속마법
	CASE "レア度"
		RETURN SPR
	CASE "추가日"
		RETURN 251030
ENDSELECT

RETURN 0

@CARD_EXPLANATION_71706(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 카드는 １턴에 １장밖에 발동할 수 없으며、이 카드명의 ②③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：이 카드의 발동시의 효과 처리로서、자신의 덱 / 묘지에서 "령신의 성전" １장을 패에 넣을 수 있다。
PRINTL 자신 필드가 "령신의 성전"인 경우、대신에 "령신의 성궤" 이외의 령신" 마법 / 함정 카드 １장을 패에 넣을 수 있다。
CALLFORM CARD_ABLE(2,효과後誘発)
PRINTL ②：자신 필드가 "령신의 성전"인 상태로、상대가 몬스터의 효과를 발동한 경우에 발동할 수 있다。
PRINTL 상대 묘지의 몬스터 １장을 선택하고、그 몬스터와 같은 속성의 "령신" / "엘리멘트세이버" 몬스터 １장을 덱에서 패에 넣는다。
CALLFORM CARD_ABLE(3,마함起動)
PRINTL ③：상대 필드에만 몬스터가 존재하는 경우、자신 메인 페이즈에 마법＆함정 존의 앞면 표시인 이 카드를 묘지로 보내고 발동할 수 있다。
PRINTL 자신의 묘지 / 제외 상태인 몬스터를 소재로서 덱으로 되돌리고、"령신" / "엘리멘트세이버" 융합 몬스터 １장을 융합 소환한다。

;「엘리멘트세이버」の初動を安定化させる추가カード。「령신의 성전」がなるべく初手に欲しいテーマなので、このカードでもかさ増しできるようにしている。
;지속마법として、상대의 モンスター효과の발동に反応して、상대가 使うモンスターと同じ속성のテーマ몬스터를 サーチする효과も持っており、
;이 카드를 経由して「聖殿」と両方を貼る動きを하는 것으로、추가로 アドバンテージを稼げるようになっている。
;テーマ内に융합효과가 ひとつもないのが気がかりだったので、申し訳程度の雷龍융합효과를 ③で추가。덱戻しによってリソース循環もできて
;動きとしては強いぶんピンチ時限定の발동条件に설정。正規の융합条件をクリアする必要があるので、メインに最上級「령신」を積む意義を増やす狙いも期待できる。

;聖櫃の大きさは50x50x70cmぐらいのサイズで全部で６つあり、엘리멘트세이버たちが身につける武具が１つずつ仕舞われている。
;要は「聖闘士星矢」の聖衣の入ってる箱を思い浮かべればだいたいそれ。엘리멘트세이버の武具は령신を模したオブジェに組み立てられる感じだと妄想している。
;こうなると상대에게 盤面を更地にされても「あなたにはまだ命が残っているでしょう」と라파위라くんを酷使してくるスパルタ女神（本籍アテネ）も欲しくなるな。


@CARDCAN_71706(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 複数속성, 8

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,71706)
SIF RESULT == 1
	RETURN 0

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	SIF 발동済_3(듀얼리스트,71706)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL FULLRESET
	효과範囲상대필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과範囲필드 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		RETURN 0
	
	CALL RESETAREA_MAT
	素材範囲묘지 = 1
	素材範囲제외 = 1
	CALL FULLRESET
	효과範囲EX덱 = 1
	효과条件종류 = 융합
	효과条件カテゴリ:0 = 령신
	효과条件カテゴリ:1 = 엘리멘트세이버
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트, 종류, ゾーン, 場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,71706)
		RETURN 0
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ELSEIF 종류 == 효과後誘発
	SIF 발동済_2(듀얼리스트,71706)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") >= 2
		RETURN 0
	SIF GETVARS(@"%듀얼리스트%_フィールド名") != "령신의 성전"
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_FIN_DATA(듀얼리스트,"효과발동",1)
	SIF RESULT != 1
		RETURN 0
	
	;상대묘지의 속성を確認して「複数속성」の変数に설정を格納。下の효과条件속성_複数にて利用。
	CALL FULLRESET
	CALL ELEMENTS_KIND_BASIC(듀얼리스트,"묘지",複数속성,1)
	
	CALL FULLRESET
	효과範囲덱 = 1
	효과条件カテゴリ:0 = 령신
	효과条件カテゴリ:1 = 엘리멘트세이버
	효과条件종류 = モン全般
	CALL 효과条件속성_複数(複数속성)
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF




@CARDEFFECT_71706(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 選択カード속성
#DIM DYNAMIC 複数속성, 8
#DIM DYNAMIC 추가条件플래그 = 0

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 && GETVAR(@"%듀얼리스트%_魔_表:場所") == 1
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71706,3)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,묘지行き)
		;EX덱確認
		CALL RESETAREA_MAT
		素材範囲묘지 = 1
		素材範囲제외 = 1
		CALL FULLRESET
		효과条件종류 = 융합
		효과条件カテゴリ:0 = 령신
		효과条件カテゴリ:1 = 엘리멘트세이버
		효과条件소환可 = 1
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
		選択カード = RESULT
		;돌아간다
		IF 選択カード != 9999
			;마법 카드를 묘지送り
			TRYCALLFORM CARDSUMMON_{GETVAR(@"%듀얼리스트%_EX덱:{選択カード}")}(듀얼리스트, 選択カード)
			;素材処理を読み込む
			CALL FUSSUMMON(듀얼리스트, 選択カード, 덱行き)
		ENDIF
	ENDIF
ELSEIF 종류 == 마함起動 || 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71706,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
		
		SIF GETVARS(@"%듀얼리스트%_フィールド名") == "령신의 성전"
			추가条件플래그 |= 1
		
		CALL FULLRESET
		효과範囲덱 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ:0 = 더미
		SIF 추가条件플래그 & 1
			효과条件カテゴリ:1 = 령신
		효과条件종류 = 마함全般
		효과条件固名前 = 령신의 성궤
		효과条件スーパー名前 = 령신의 성전
		효과条件任意 = 1
		CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		
	ENDIF
ELSEIF 종류 == 효과後誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,71706,2)
	IF RESULT == 0
		
		;덱に残っている령신・엘리멘트세이버の속성を確認して、その속성の상대묘지의 몬스터밖에 選べないようにする処理。
		CALL FULLRESET
		효과条件カテゴリ:0 = 령신
		효과条件カテゴリ:1 = 엘리멘트세이버
		CALL ELEMENTS_KIND_BASIC(듀얼리스트,"덱",複数속성)
		
		CALL FULLRESET
		효과範囲상대묘지 = 1
		CALL 효과条件속성_複数(複数속성)
		CALL CARD_CHOOSE_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT != 9999
			選択カードID = RESULT:99
			TRYCALLFORM CARD_{選択カードID}, "속성"
			選択カード속성 = RESULT
			
			CALL FULLRESET
			효과範囲덱 = 1
			효과条件カテゴリ:0 = 령신
			효과条件カテゴリ:1 = 엘리멘트세이버
			효과条件종류 = モン全般
			효과条件속성 = 選択カード속성
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
			
		ENDIF
	ENDIF
ENDIF