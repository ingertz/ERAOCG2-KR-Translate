@CARDNAME_55596,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 엘리멘트세이버 케라위니
	CASE "略称"
		RESULTS = ElmS 케라위니
	CASE "カテゴリ"
		RESULTS:0 = 엘리멘트세이버
		RESULTS:1 = 엘리멘트
		RESULTS:3 = 게임 오리지널
		;カテゴリ縛りのSS、EX소환のために설정
		RESULTS:4 = 령신
ENDSELECT


@CARD_55596(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 융합
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 전사족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 1200
	CASE "특수불가"
		RETURN 1
	CASE "単一存在"
		RETURN 1
	CASE "성별"
		RETURN 牝性
	CASE "レア度"
		RETURN ULR
	CASE "連動ID"
		RETURN 1697
	CASE "추가日"
		RETURN 251030
ENDSELECT

RETURN 0



@CARDSUMMON_55596(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2

IF EX参照 == 0 || EX参照 == 1
	CALLFORM 素材条件レベル_ADV(8, "以上")
	素材条件カテゴリ = 령신
ELSEIF EX参照 >= 10
	素材条件名前 = 엘리멘트세이버 마카니
ENDIF


IF EX参照 == 1
	CALL FUSCAN(듀얼리스트,소환カード,55596) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_55596(종류)
#DIM DYNAMIC 종류

PRINTL 레벨８ 이상의 "령신" 몬스터 ＋ "엘리멘트세이버 마카니"
PRINTL "엘리멘트세이버 케라위니"는、자신 필드에 １장밖에 앞면 표시로 존재할 수 없으며、융합 소환 및 이하의 방법으로만 특수 소환할 수 있다。
CALLFORM CARD_ABLE(1,EX덱起動)
PRINTL ●자신 패 / 필드의 "령신" / "엘리멘트세이버" 몬스터 ２장을 묘지로 보낸 경우에 ＥＸ덱에서 특수 소환할 수 있다。
PRINTL 　（이 방법에 의한특수소환は１턴에 １번しか行えない。）
CALLFORM CARD_ABLE(0,특수소환時強制,EX소환時強制)
PRINTL ①：이 카드가 특수 소환된 경우에 발동한다。
PRINTL 자신 묘지의 "령신" / "엘리멘트세이버" 몬스터 １장을 골라、그 몬스터의 원래 속성에 따라、
PRINTL 이 몬스터가 필드에 존재하는 동안、자신 필드의 "령신" / "엘리멘트세이버" 몬스터에 대해 이하의 효과를 적용한다。
PRINTL ●땅 또는 화염：공격력이 ８００오르고、관통 공격을 얻는다。
PRINTL ●물 또는 바람："엘리멘트세이버 케라위니"가 ②의 효과를 발동했을 때、대상의 카드를 파괴하지 않고 덱으로 되돌린다。
CALLFORM CARD_ABLE(10,필드起動)
PRINTL ②：１턴에 １번、자신 묘지의 "령신" / "엘리멘트세이버" 몬스터의 원래 속성과 같은 속성의、
PRINTL 상대 필드의 앞면 표시 몬스터 １장을 대상으로 하고 발동할 수 있다。그 몬스터를 파괴한다。

;【엘리멘트세이버】の추가エースモンスター。위라드とほぼ同等の소환条件で出せるＥＸモンスターであり、女の子몬스터의 エースである。
;위라드が先攻展開で出して妨害を行ったり耐性で凌ぐ守りのエースだとすれば、こちらは能動的な除去や攻撃性能で상대盤面を崩す攻めのエース。
;デュエルの상황に応じて위라드と使い分けることで活用していきたい。패에 余裕があれば両方を降臨させて一気に圧倒するのもよいだろう。
;
;케라위니とはハワイ語で「強風」の意味を持つ言葉である。엘리멘트세이버の名前はハワイ語が元になっており、それに倣っている。


@CARDCAN_55596(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 추가条件플래그 = 0
#DIM DYNAMIC 条件달성 = 0
#DIM DYNAMIC 複数속성, 8

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,55596)
SIF RESULT == 1
	RETURN 0

IF 종류 == EX덱起動
	SIF 발동済_1(듀얼리스트,55596)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	CALL CARD_EX_CHECK(듀얼리스트,55596)
	SIF RESULT == 1
		RETURN 0
	
	CALL FULLRESET
	효과範囲마함 = 1
	효과条件名前 = 령신의 성전
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1 && !(발동済_3(듀얼리스트,71705))
		추가条件플래그 |= 1
	;CALL FULLRESET
	;효과範囲필드 = 1
	;효과条件カテゴリ = 엘리멘트세이버
	;CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	;SIF RESULT == 1
	;	추가条件플래그 |= 2
	
	IF 추가条件플래그 & 2
		;2025/11/1 :こっちは死に분기に。
		;条件1：패에 몬스터가 必要。
		;条件2：손패（＋条件플래그&1で덱）にテーマ몬스터가 必要。
		;条件3：손패（＋条件플래그&1で덱）に2장 이상 の몬스터가 必要。
		CALL FULLRESET
		효과範囲손패 = 1
		효과条件종류 = モン全般
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
		CALL FULLRESET
		효과範囲손패 = 1
		SIF 추가条件플래그 & 1
			효과範囲덱 = 1
		효과条件カテゴリ:0 = 령신
		효과条件カテゴリ:1 = 엘리멘트세이버
		효과条件종류 = モン全般
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
		CALL FULLRESET
		효과範囲손패 = 1
		SIF 추가条件플래그 & 1
			효과範囲덱 = 1
		효과条件종류 = モン全般
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT <= 1
			RETURN 0
	ELSE
		;条件1：패 / 필드에 テーマ몬스터가 1体必要。
		;条件2：패 / 필드（＋条件플래그&1で덱）でテーマ몬스터가 合計2장 이상 必要。
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲필드 = 1
		효과条件カテゴリ:0 = 령신
		효과条件カテゴリ:1 = 엘리멘트세이버
		효과条件종류 = モン全般
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲필드 = 1
		SIF 추가条件플래그 & 1
			효과範囲덱 = 1
		효과条件カテゴリ:0 = 령신
		효과条件カテゴリ:1 = 엘리멘트세이버
		효과条件종류 = モン全般
		효과条件CNT = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT <= 1
			RETURN 0
	ENDIF
	RETURN 1
ELSEIF 종류 == EX소환時強制 || 종류 == 특수소환時強制
	RETURN 1
ELSEIF 종류 == 필드起動
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	
	;묘지의 カテゴリの속성を確認して「複数속성」の変数に설정を格納。下の효과条件속성_複数にて利用。
	CALL FULLRESET
	효과条件カテゴリ:0 = 령신
	효과条件カテゴリ:1 = 엘리멘트세이버
	CALL ELEMENTS_KIND_BASIC(듀얼리스트,"묘지",複数속성)
	
	IF GETVAR(@"%듀얼리스트%_MZ_汎数:{場所}") & 2
		CALL FULLRESET
		효과範囲상대필드 = 1
		CALL 효과条件속성_複数(複数속성)
		효과条件표시 = 表側표시
		효과条件除去種 = 덱
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ELSE
		CALL FULLRESET
		효과範囲상대필드 = 1
		CALL 효과条件속성_複数(複数속성)
		효과条件표시 = 表側표시
		효과条件除去種 = 묘지
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ENDIF
	RETURN 1
ELSEIF 종류 == 지속효과 || 종류 == 攻守変動
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_55596(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 효과先
#DIM DYNAMIC 추가条件플래그 = 0
#DIM DYNAMIC 条件달성 = 0
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 選択속성
#DIM DYNAMIC 손패枚数＿前
#DIM DYNAMIC 손패枚数＿後
#DIM DYNAMIC 攻守修正値 = 0
#DIM DYNAMIC 複数속성, 8

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == EX덱起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55596,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲마함 = 1
		효과条件名前 = 령신의 성전
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		SIF RESULT == 1 && !(발동済_3(듀얼리스트,71705))
			추가条件플래그 |= 1
		;CALL FULLRESET
		;효과範囲필드 = 1
		;효과条件カテゴリ = 엘리멘트세이버
		;CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		;SIF RESULT == 1
		;	추가条件플래그 |= 2
		
		;まずは「령신」・「엘리멘트세이버」몬스터 1장을 묘지로 보낸다。
		CALL FULLRESET
		효과範囲손패 = 1
		효과範囲필드 = 1
		효과条件カテゴリ:0 = 령신
		효과条件カテゴリ:1 = 엘리멘트세이버
		효과条件종류 = モン全般
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			손패枚数＿前 = 손패数(듀얼리스트)
			CALL FULLRESET
			효과範囲손패 = 1
			효과範囲필드 = 1
			SIF 추가条件플래그 & 1
				효과範囲덱 = 1
			효과条件カテゴリ:0 = 령신
			효과条件カテゴリ:1 = 엘리멘트세이버
			효과条件종류 = モン全般
			CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
			IF RESULT == 1
				;묘지へ送る前後で패의 枚数を確認し、減っていない場合は덱에서 送ったと판정し령신의 성전の효과③を使用した扱いに。
				손패枚数＿後 = 손패数(듀얼리스트)
				IF 손패枚数＿前 == 손패枚数＿後
					;령신의 성전의 효과를 발동した！
					SETCOLOR C_YELLOW
					PRINTFORML "령신의 성전"의 효과에 의해 덱에서 직접 몬스터를 묘지로 보냈다！！
					RESETCOLOR
					CALL CARD_EFFECT_USE(듀얼리스트,71705,3)
				ENDIF
				CALL FULLRESET
				CALL CARD_SP_SUMMON(듀얼리스트,"EX덱",場所)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 종류 == EX소환時強制 || 종류 == 특수소환時強制
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55596)
	IF RESULT == 0
		;묘지의 カテゴリの몬스터를 2体골라 、その속성に応じて汎数を설정する。
		;汎数bit1(1):●地또는 炎：공격력이 ８００오르고、貫通효과를 얻는다。
		;汎数bit2(2):●水또는 風：「엘리멘트세이버 케라위니」が②의 효과를 발동했을 때、대상の카드를 파괴せず덱へ戻す。
		
		CALL FULLRESET
		효과条件カテゴリ:0 = 령신
		효과条件カテゴリ:1 = 엘리멘트세이버
		효과条件固名前:0 = 엘리멘트세이버 라파위라
		효과条件固名前:1 = 엘리멘트세이버 모레프
		효과条件固名前:2 = 엘리멘트세이버 위라드
		효과条件종류 = モン全般
		CALL CARD_CHOOSE_BASIC(듀얼리스트,"묘지",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			選択カードID = RESULT:99
			TRYCALLFORM CARD_{選択カードID}, "속성"
			選択속성 = RESULT
			SELECTCASE 選択속성
				CASE 땅속성,화염속성
					;汎数に1を立てる
					CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"汎数",1)
				CASE 물속성,바람속성
					;汎数に2を立てる
					CALL SET_FIELD_INFO(듀얼리스트,"필드",場所,"汎数",2)
			ENDSELECT
		ENDIF
	ENDIF
ELSEIF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,55596,10)
	IF RESULT == 0
		
		;묘지의 カテゴリの속성を確認して「複数속성」の変数に설정を格納。下の효과条件속성_複数にて利用。
		CALL FULLRESET
		효과条件カテゴリ:0 = 령신
		효과条件カテゴリ:1 = 엘리멘트세이버
		CALL ELEMENTS_KIND_BASIC(듀얼리스트,"묘지",複数속성)
		
		IF GETVAR(@"%듀얼리스트%_MZ_汎数:{場所}") & 2
			CALL FULLRESET
			CALL 효과条件속성_複数(複数속성)
			효과条件표시 = 表側표시
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",효과先,"덱")
		ELSE
			CALL FULLRESET
			CALL 효과条件속성_複数(複数속성)
			효과条件표시 = 表側표시
			CALL CARD_REMOVAL_BASIC(듀얼리스트,"필드単体",효과先,"묘지")
		ENDIF
	ENDIF
ELSEIF 종류 == 지속효과
	;CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"不材")
	
	IF GETVAR(@"%듀얼리스트%_MZ_汎数:{場所}") & 1
		CALL FULLRESET
		효과条件カテゴリ:0 = 령신
		효과条件カテゴリ:1 = 엘리멘트세이버
		효과条件종류 = モン全般
		CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"貫通")
	ENDIF
	;IF GETVAR(@"%듀얼리스트%_MZ_汎数:{場所}") & 4
	;	CALL FULLRESET
	;	효과条件カテゴリ:0 = 령신
	;	효과条件カテゴリ:1 = 엘리멘트세이버
	;	효과条件종류 = モン全般
	;	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"戦阻")
	;ENDIF
	
ELSEIF 종류 == 攻守変動
	SIF GETVAR(@"%듀얼리스트%_MZ_汎数:{場所}") & 1
		攻守修正値 = 800
	CALL FULLRESET
