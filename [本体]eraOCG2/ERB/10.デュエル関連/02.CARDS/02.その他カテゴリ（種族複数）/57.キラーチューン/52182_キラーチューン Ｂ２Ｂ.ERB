@CARDNAME_52182,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 킬러튠　Ｂ２Ｂ
	CASE "略称"
		RESULTS = 백투백
	CASE "カテゴリ"
		RESULTS:0 = 킬러튠
		RESULTS:5 = 튜너소재가능
ENDSELECT


@CARD_52182(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 싱크로
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 악마족
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 3200
	CASE "守備力"
		RETURN 0
	CASE "성별"
		RETURN 牝性
	CASE "튜너"
		RETURN 1
	CASE "連動ID"
		SELECTCASE RAND:2
			CASE 0
				RESULT:1 = 2273
				RETURN 2270
			CASE 1
				RESULT:1 = 2270
				RETURN 2273
		ENDSELECT
	CASE "추가日"
		RETURN 260124
ENDSELECT

RETURN 0

@CARDSUMMON_52182(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要レベル数 = 10
IF EX参照 == 0 || EX参照 == 1
	素材条件튜너 = 1
ELSEIF EX参照 >= 10
	素材条件종류 = 싱크로
ENDIF

IF EX参照 == 1
	CALL SYNCAN(듀얼리스트,소환カード,52182) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_52182(종류)
#DIM DYNAMIC 종류

PRINTL 튜너＋Ｓ몬스터 １장 이상
PRINTL 이 카드명의 ③의 효과는 １턴에 ２度まで使用できる。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ①：상대 필드의 몬스터의 레벨은 ２つ오른다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：자신의 튜너は１度のバトルフェイズ中に２回攻撃できる。
CALLFORM CARD_ABLE(15,발동誘発)
PRINTL ③：상대가 몬스터의 효과를 발동했을 때、レベル１０이외의 자신의 묘지 / 제외 상태인 튜너１장을 대상으로 하고 발동할 수 있다。
PRINTL その몬스터를 패에 加えるか특수 소환한다。
PRINTL 그 후、이하의 효과에서 １つを골라 적용할 수 있다。
PRINTL ●자신 필드의 몬스터를 Ｓ素材として、Ｓ몬스터의 튜너１体のＳ소환を行う。
PRINTL ●패의 튜너１体と자신 필드의 元々のレベルが４以下の「킬러튠」튜너１장을 Ｓ素材として묘지로 보내고、
PRINTL 　ＥＸ덱에서 Ｓ몬스터의 튜너１장을 Ｓ소환する。


@CARDCAN_52182(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,52182)
SIF RESULT == 1
	RETURN 0

IF 종류 == 발동誘発
	SIF ゾーン != "필드"
		RETURN 0
	SIF 발동済_2(듀얼리스트,52182)
		RETURN 0
	CALL FULLRESET
	효과範囲묘지 = 1
	효과範囲제외 = 1
	효과条件튜너 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 攻守変動 || 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_52182(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC EX選択カード
#DIM DYNAMIC EXカードID,50
#DIM DYNAMIC 발동불가,2
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,52182,15)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과範囲제외 = 1
		효과条件튜너 = 1
		효과条件소환可 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			SIF 듀얼리스트 == "자신"
				PRINTL 몬스터를 특수소환しますか？
			CALL YN_CHOICE(듀얼리스트)
		ELSE
			RESULT = 1
		ENDIF

		IF RESULT == 0
			CALL FULLRESET
			효과範囲묘지 = 1
			효과範囲제외 = 1
			효과条件튜너 = 1
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ELSEIF RESULT == 1
			CALL FULLRESET
			효과範囲묘지 = 1
			효과範囲제외 = 1
			효과条件튜너 = 1
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF

		IF RESULT == 1
			CALL FULLRESET
			효과範囲EX덱 = 1
			효과条件종류 = 싱크로
			효과条件튜너 = 1
			효과条件소환可 = 1
			CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
			SIF RESULT != 1
				발동불가:0 = 1
			
			FOR カウンタ,0,5
				SIF GETVAR(@"%듀얼리스트%_필드:カウンタ") == -1
					CONTINUE
				TRYCALLFORM CARDNAME_{GETVAR(@"%듀얼리스트%_필드:カウンタ")}("カテゴリ")
				SIF !MATCH(RESULTS,"킬러튠")
					CONTINUE
				TRYCALLFORM CARD_{GETVAR(@"%듀얼리스트%_필드:カウンタ")}("レベル")
				SIF RESULT > 4
					CONTINUE
				CALL KILLERTUNE_CHECK(듀얼리스트,カウンタ,1)
				IF RESULT == 1
					条件달성 = 1
					BREAK
				ENDIF
			NEXT
			SIF 条件달성 != 1
				발동불가:1 = 1

			SIF 발동불가:0 == 1 && 발동불가:1 == 1
				RETURN 0
			SIF 듀얼리스트 == "자신"
				PRINTL 싱크로소환を行いますか？
			CALL YN_CHOICE(듀얼리스트)
			SIF RESULT == いいえ
				RETURN 0
			
			IF 발동불가:0 != 1 && 발동불가:1 != 1
				CALL YN_CHOICE(듀얼리스트,"●필드의 モンスターでＳ소환を行う。","●패의 튜너と필드의 킬러튠でＳ소환を行う。")
			ELSEIF 발동불가:0 != 1
				RESULT = 0
			ELSEIF 발동불가:1 != 1
				RESULT = 1
			ENDIF

			IF RESULT == 0
				CALL FULLRESET
				효과条件종류 = 싱크로
				효과条件튜너 = 1
				CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
				IF RESULT != 9999
					選択カード = RESULT
					TRYCALLFORM CARDSUMMON_{RESULT:99}(듀얼리스트,選択カード)
					CALL SYNSUMMON(듀얼리스트, 選択カード)
				ENDIF

			ELSEIF RESULT == 1
				SETCOLOR C_YELLOW
				PRINTL 싱크로素材にする몬스터를 選択してください
				RESETCOLOR
				CALL FULLRESET
				효과条件名前:0 = 킬러튠 레코
				효과条件名前:1 = 킬러튠 믹스
				효과条件名前:2 = 킬러튠 클립
				효과条件名前:3 = 킬러튠 큐
				효과条件名前:4 = 킬러튠 로터리
				효과条件名前:5 = 킬러튠 트랙메이커
				CALL CARD_CHOOSE_BASIC(듀얼리스트,"필드",ゾーン,場所)
				IF RESULT != 9999
					選択カード = RESULT
					CALL KILLERTUNE_CHECK(듀얼리스트,選択カード,1)
					FOR カウンタ,0,50
						EXカードID:カウンタ = RESULT:(カウンタ+1)
					NEXT

					CALL FULLRESET
					FOR カウンタ,0,50
						효과条件ID:カウンタ = EXカードID:カウンタ
					NEXT
					CALL CARD_CHOOSE_BASIC(듀얼리스트,"EX덱",ゾーン,場所)
					IF RESULT != 9999
						EX選択カード = RESULT
						CALL KILLERTUNE_SYNSUMMON(듀얼리스트,"필드",選択カード,EX選択カード)
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF

ELSEIF 종류 == 攻守変動
	CALL FULLRESET
	효과条件종류 = レベル持ち
	CALL STATCHANGE_OTHER(듀얼리스트,"상대필드",場所,"星",2)

ELSEIF 종류 == 지속효과
	CALL FULLRESET
	효과条件튜너 = 1
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"追攻",1)
ENDIF
