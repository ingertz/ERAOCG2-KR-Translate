@CARDNAME_61533,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 현람한 헌앙
	CASE "略称"
		RESULTS = 현람한 헌앙
	CASE "カテゴリ"
		RESULTS:0 = 현람
ENDSELECT


@CARD_61533(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 速攻마법
	CASE "추가日"
		RETURN 250726
ENDSELECT

RETURN 0

@CARD_EXPLANATION_61533(종류)
#DIM DYNAMIC 종류
PRINTL ①：이하의 효과에서 １개를 선택해서 발동할 수 있다
PRINTL （이 카드명의 이하의 효과는 각각 １턴에 １번밖에 선택할 수 없다）。
CALL CARD_ABLE(1,마함起動 ,손패起動,フリー誘発)
PRINTL ●자신의 묘지에서 레벨６ 이하인 "현람" 몬스터 １장을 특수 소환한다。
CALL CARD_ABLE(2,마함起動 ,손패起動,フリー誘発)
PRINTL ●자신의 덱 / 묘지에서 "싸이크론" １장을 패에 넣는다。
CALL CARD_ABLE(0,戦破壊→묘지)
PRINTL ②：필드의 이 카드가 효과로 파괴된 경우에 발동할 수 있다。
PRINTL 이 카드를 자신의 마법&함정 존에 세트한다。
PRINTL 직전에 "싸이크론"을 발동한 경우、이 카드의 ①의 효과를 발동한다。

@CARDCAN_61533(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 발동불가,2
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,61533)
SIF RESULT == 1
	RETURN 0
IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	CALL CARD_QUICK_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 발동済_1(듀얼리스트,61533)
		발동불가:0 = 1
	SIF 발동済_2(듀얼리스트,61533)
		발동불가:1 = 1

	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 현람
	CALLFORM 효과条件レベル_ADV(6,"以下")
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1

	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件名前 = 싸이크론
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:1 = 1
	SIF 발동불가:0 == 1 && 발동불가:1 == 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 戦破壊→묘지
	SIF 묘지送り종류 != "破壊"
		RETURN 0
	RETURN 1

ENDIF



@CARDEFFECT_61533(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 발동불가,2

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


IF 종류 == 마함起動 || 종류 == 손패起動 || 종류 == フリー誘発
	SIF 종류 == 발동誘発
		CALL CARD_EFFECT_USE(듀얼리스트,61533,3)

	SIF 발동済_1(듀얼리스트,61533)
		발동불가:0 = 1
	SIF 발동済_2(듀얼리스트,61533)
		발동불가:1 = 1
	
	CALL FULLRESET
	효과範囲묘지 = 1
	효과条件カテゴリ = 현람
	CALLFORM 효과条件レベル_ADV(6,"以下")
	효과条件소환可 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:0 = 1

	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲묘지 = 1
	효과条件名前 = 싸이크론
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		발동불가:1 = 1
	
	IF 발동불가:0 != 1 && 발동불가:1 != 1
		CALL YN_CHOICE(듀얼리스트,"●자신의 묘지에서 레벨６ 이하인「현람」몬스터 １장을 특수 소환한다。","●자신의 덱 / 묘지에서「싸이크론」１장을 패에 넣는다。")
	ELSEIF 발동불가:0 != 1
		RESULT = 0
	ELSEIF 발동불가:1 != 1
		RESULT = 1
	ENDIF
	
	IF RESULT == 0
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,61533,1)
		IF RESULT == 0
				CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
			CALL FULLRESET
			효과範囲묘지 = 1
			효과条件カテゴリ = 현람
			CALLFORM 효과条件レベル_ADV(6,"以下")
			CALL CARD_SP_SUMMON_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	
	ELSEIF RESULT == 1
		CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,61533,2)
		IF RESULT == 0
				CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
			CALL FULLRESET
			효과範囲덱 = 1
			효과範囲묘지 = 1
			효과条件名前 = 싸이크론
			CALL CARD_ADD_ADV(듀얼리스트,ゾーン,場所)
		ENDIF
	ENDIF

ELSEIF 종류 == 戦破壊→묘지
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,61533)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲묘지 = 1
		효과条件名前 = 현람한 헌앙
		CALL CARD_SET_ADV(듀얼리스트,ゾーン,場所,"裏側표시")
		CALL FULLRESET
		효과条件名前 = 싸이크론
		CALL CARD_CHECK_FIN_DATA(듀얼리스트,"효과발동",2)
		IF RESULT == 1
			TRYCALLFORM CARDEFFECT_61530(듀얼리스트,마함起動,"손패",場所)
			IF RESULT == 1
				TRYCALLFORM CARDEFFECT_61530(듀얼리스트,마함起動,"효과処理",場所)
			ENDIF
		ENDIF

	ENDIF
ENDIF
