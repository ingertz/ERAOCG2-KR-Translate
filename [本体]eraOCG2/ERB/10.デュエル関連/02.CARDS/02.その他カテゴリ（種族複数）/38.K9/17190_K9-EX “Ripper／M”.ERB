@CARDNAME_17190,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = K9-EX“Ripper/M”
	CASE "略称"
		RESULTS = K9“Ripper/M”
	CASE "カテゴリ"
		RESULTS:0 = K9
ENDSELECT


@CARD_17190(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 바람속성
	CASE "종족"
		RETURN 야수족
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 3100
	CASE "守備力"
		RETURN 2600
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 251024
	CASE "連動ID"
		RETURN 2190
ENDSELECT
RETURN 0


@CARDSUMMON_17190(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 9

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,17190) 
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_17190(종류)
#DIM DYNAMIC 종류

PRINTL 레벨９ 몬스터 ×２
PRINTL 이 카드명의 ①③의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,특수소환時,EX소환時)
PRINTL ①：이 카드가 "K9" 마법 / 함정 카드의 효과로 특수 소환된 경우에 발동할 수 있다。
PRINTL 상대의 묘지 / 제외 상태인 카드를 ２장까지 덱으로 되돌린다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ②：이 카드가 수비 표시 몬스터를 공격한 경우、
PRINTL 그 수비력을 공격력이 넘은 수치 만큼 상대에게 전투 데미지를 준다。
CALLFORM CARD_ABLE(3,발동誘発)
PRINTL ③：상대가 몬스터의 효과를 발동했을 때、이 카드의 Ｘ소재를 ２개 제거하고 발동할 수 있다。
PRINTL 그 효과를 무효로 한다。
PRINTL 그 후、필드의 카드를 전부 파괴한다。


@CARDSUMMON_AA_17190


@CARDCAN_17190(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,17190)
SIF RESULT == 1
	RETURN 0

IF 종류 == 특수소환時 || 종류 == EX소환時
	TRYCALLFORM CARD_{処理中_효과ID},"종류"
	SIF RESULT <= モン全般
		RETURN 0
	TRYCALLFORM CARDNAME_{処理中_효과ID},"カテゴリ"
	SIF !MATCH(RESULTS,"K9")
		RETURN 0
	CALL FULLRESET
	효과範囲상대묘지 = 1
	효과範囲상대제외 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	RETURN 1
ELSEIF 종류 == 발동誘発
	SIF 발동済_3(듀얼리스트,17190)
		RETURN 0
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= 0
		RETURN 0
	CALL FULLRESET
	효과条件종류 = モン全般
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_17190(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード

IF 종류 == 특수소환時 || 종류 == EX소환時
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,17190,1,1)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲상대묘지 = 1
		효과範囲상대제외 = 1
		효과条件行先플래그 = 덱行き
		효과条件任意 = 2
		CALL CARD_ADD_GY_ADV(듀얼리스트,ゾーン,場所)
	ENDIF
ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"貫通")
ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,17190,3,2)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(듀얼리스트,"발동無効",場所,"無効")
		IF RESULT == 1
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲마함 = 1
			효과範囲상대필드 = 1
			효과範囲상대마함 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"묘지")
		ENDIF
	ENDIF
ENDIF



