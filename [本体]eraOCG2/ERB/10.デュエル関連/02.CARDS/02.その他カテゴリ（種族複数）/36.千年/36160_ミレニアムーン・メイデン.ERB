@CARDNAME_36160,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 밀레니엄문 메이든
	CASE "略称"
		RESULTS = 밀레니엄문메이든
	CASE "カテゴリ"
		RESULTS:0 = 밀레니엄
ENDSELECT


@CARD_36160(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 미확인족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1500
	CASE "守備力"
		RETURN 1300
	CASE "성별"
		RETURN 牝性
	CASE "추가日"
		RETURN 250908
ENDSELECT

RETURN 0

@CARD_EXPLANATION_36160(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드명의 ①②의 효과는 각각 １턴에 １번밖에 사용할 수 없다。
CALLFORM CARD_ABLE(1,손패起動)
PRINTL ①：이 카드가 패에 존재하는 경우에 발동할 수 있다。
PRINTL 이 카드를 자신의 마법＆함정 존에 앞면 표시로 둔다。
CALLFORM CARD_ABLE(2,발동誘発)
PRINTL ②：이 카드가 자신의 마법＆함정 존에 앞면 표시로 존재하고、상대의 효과가 발동했을 때에 발동할 수 있다。
PRINTL 이 카드를 특수 소환하고、이 턴동안、
PRINTL 자신 필드의 레벨 ５이상의 미확인족 / 마법사족 몬스터를 상대는 효과의 대상으로 할 수 없다。
CALLFORM CARD_ABLE(0,지속효과)
PRINTL ③：이 카드가 몬스터와 전투를 행할 경우、그 ２장은 그 전투로는 파괴되지 않는다。


@CARDCAN_36160(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,36160)
SIF RESULT == 1
	RETURN 0

IF 종류 == 손패起動
	SIF 발동済_1(듀얼리스트,36160)
		RETURN 0
	CALL CARD_CONT_M(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 발동誘発
	SIF 발동済_2(듀얼리스트,36160)
		RETURN 0
	SIF ゾーン != "마함"
		RETURN 0
	CALL CARD_SS_CHECK(듀얼리스트,36160,"마함")
	SIF RESULT == 1
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_START_DATA(듀얼리스트,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == 短紋章起動
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF 戦闘場所(듀얼리스트,1) == 5
		RETURN 0
	SIF 戦闘場所(듀얼리스트) != 場所
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_36160(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC カウンタ

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 손패起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,36160,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,마함行き)
	ENDIF

ELSEIF 종류 == 발동誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,36160,2)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(듀얼리스트,ゾーン,場所)
		IF RESULT == 1
			CALL CARD_RESERV(듀얼리스트,36160,短紋章予約)
		ENDIF
	ENDIF
	RETURN 0

ELSEIF 종류 == 短紋章起動
	CALL FULLRESET
	효과条件종족:0 = 미확인족
	효과条件종족:1 = 마법사족
	CALLFORM 효과条件レベル_ADV(5,"以上")
	CALL STATCHANGE_EFFECT(듀얼리스트,"필드",場所,"対耐")

ELSEIF 종류 == 지속효과
	CALL STATCHANGE_EFFECT(듀얼리스트,"自身",場所,"戦耐")
	CALL STATCHANGE_EFFECT(対面者,"自身",戦闘場所(듀얼리스트,1),"戦耐")
ENDIF


