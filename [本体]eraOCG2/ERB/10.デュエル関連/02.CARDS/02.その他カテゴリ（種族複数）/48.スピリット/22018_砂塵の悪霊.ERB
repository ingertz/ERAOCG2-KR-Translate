@CARDNAME_22018,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 모래 먼지의 악령
	CASE "略称"
		RESULTS = 모래 먼지의 악령
	CASE "カテゴリ"
		RESULTS:0 = 스피릿
ENDSELECT

@CARD_22018(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 땅속성
	CASE "종족"
		RETURN 언데드족
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 2200
	CASE "守備力"
		RETURN 1800
	CASE "특수불가"
		RETURN 1
	CASE "추가日"
		RETURN 251208
ENDSELECT

RETURN 0

@CARD_EXPLANATION_22018(종류)
#DIM DYNAMIC 종류

PRINTL このカードは특수소환できない。
CALLFORM CARD_ABLE(0,소환時,リバース誘発)
PRINTL ①：このカードが소환・リバースした場合に발동できる。
PRINTL このカード以外のフィールドの表側표시モンスターを全て破壊する。
PRINTL 자신フィールド・묘지にこのカード以外の「스피릿」モンスターが存在する場合、
PRINTL 상대フィールドの全てのモンスターを破壊することができる。
CALLFORM CARD_ABLE(0,ターン終了時強制)
PRINTL ②：このカードが通常소환されている場合、エンドフェイズに발동する。
PRINTL このカードを持ち主の손패に戻す。

@CARDCAN_22018(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件달성

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,22018)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == リバース誘発
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲묘지 = 1
	효과条件カテゴリ = 스피릿
	효과条件표시 = 表側표시
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT == 1
		条件달성 = 1
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	SIF 条件달성 != 1
		효과条件표시 = 表側표시
	효과条件他所 = 1
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == ターン終了時強制
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_召種:場所") != 召種通常
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_22018(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード

IF 종류 == 소환時 || 종류 == リバース誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22018)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲묘지 = 1
		효과条件カテゴリ = 스피릿
		효과条件표시 = 表側표시
		효과条件他所 = 1
		CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
		IF RESULT == 1
			CALL YN_CHOICE(듀얼리스트,"●상대モンスターのみを破壊する。","●他の表側のモンスターを全て破壊する。")
		ELSE
			RESULT = 1
		ENDIF

		IF RESULT == 0
			CALL FULLRESET
			효과範囲상대필드 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"묘지")
		ELSEIF RESULT == 1
			CALL FULLRESET
			효과範囲필드 = 1
			효과範囲상대필드 = 1
			효과条件표시 = 表側표시
			효과条件他所 = 1
			CALL CARD_REMOVAL_ADV(듀얼리스트,"全体除去",場所,"묘지")
		ENDIF
	ENDIF

ELSEIF 종류 == ターン終了時強制
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,22018)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,손패行き)
	ENDIF
ENDIF
