@CARDNAME_20004,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 쓰쿠요미
	CASE "略称"
		RESULTS = 쓰쿠요미
	CASE "カテゴリ"
		RESULTS:0 = 스피릿
ENDSELECT

@CARD_20004(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 어둠속성
	CASE "종족"
		RETURN 마법사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1100
	CASE "守備力"
		RETURN 1400
	CASE "성별"
		RETURN 雄性
	CASE "특수불가"
		RETURN 1
	CASE "추가日"
		RETURN 251208
ENDSELECT

RETURN 0

@CARD_EXPLANATION_20004(종류)
#DIM DYNAMIC 종류

PRINTL 이 카드는 특수 소환할 수 없다。
CALLFORM CARD_ABLE(0,소환時,リバース誘発)
PRINTL ①：이 카드가 소환 / 리버스된 경우、필드의 몬스터 １장을 대상으로 하고 발동할 수 있다。
PRINTL 그 몬스터를 뒷면 수비 표시로 한다。
CALLFORM CARD_ABLE(0,ターン終了時強制)
PRINTL ②：이 카드가 일반 소환된 경우、엔드 페이즈에 발동한다。
PRINTL 이 카드를 원래 주인의 패로 되돌린다。

@CARDCAN_20004(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,20004)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時 || 종류 == リバース誘発
	CALL FULLRESET
	효과範囲필드 = 1
	효과範囲상대필드 = 1
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 종류 == ターン終了時強制
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_召種:場所") != 召種通常
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_20004(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード

IF 종류 == 소환時 || 종류 == リバース誘発
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,20004)
	IF RESULT == 0
		CALL FULLRESET
		효과範囲필드 = 1
		효과範囲상대필드 = 1
		CALL CARD_REMOVAL_ADV(듀얼리스트,"単体除去",場所,"표시변경")
	ENDIF

ELSEIF 종류 == ターン終了時強制
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,20004)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,손패行き)
	ENDIF
ENDIF
