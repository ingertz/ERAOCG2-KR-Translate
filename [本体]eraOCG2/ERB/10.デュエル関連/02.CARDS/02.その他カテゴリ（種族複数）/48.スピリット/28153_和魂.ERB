@CARDNAME_28153,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 니기타마
	CASE "略称"
		RESULTS = 니기타마
	CASE "カテゴリ"
		RESULTS:0 = 스피릿
ENDSELECT

@CARD_28153(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 효과モン
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 800
	CASE "守備力"
		RETURN 1800
	CASE "특수불가"
		RETURN 1
	CASE "추가日"
		RETURN 251208
ENDSELECT

RETURN 0

@CARD_EXPLANATION_28153(종류)
#DIM DYNAMIC 종류

PRINTL このカードは특수소환できない。
CALLFORM CARD_ABLE(0,소환時強制,リバース誘発)
PRINTL ①：このカードが소환・リバースしたターン、
PRINTL 자신は通常소환に加えて１度だけ、자신メインフェイズに「스피릿」モンスター１体を소환できる。
CALLFORM CARD_ABLE(0,ターン終了時強制)
PRINTL ②：このカードが通常소환されている場合、エンドフェイズに발동する。
PRINTL このカードを持ち主の손패に戻す。
CALLFORM CARD_ABLE(0,필드→묘지,덱→묘지,破壊→묘지,戦闘→묘지,손패→묘지)
PRINTL ③：자신フィールドに「스피릿」モンスターが存在し、このカードが묘지へ送られた場合に발동できる。
PRINTL 자신は덱から１枚ドローする。

@CARDCAN_28153(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,28153)
SIF RESULT == 1
	RETURN 0

IF 종류 == 소환時強制 || 종류 == リバース誘発
	RETURN 1

ELSEIF 종류 == 短紋章起動
	RETURN 1

ELSEIF 종류 == ターン終了時強制
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_召種:場所") != 召種通常
		RETURN 0
	RETURN 1

ELSEIF GROUPMATCH(종류,필드→묘지,덱→묘지,破壊→묘지,戦闘→묘지,손패→묘지)
	CALL FULLRESET
	효과範囲필드 = 1
	효과条件カテゴリ = 스피릿
	효과条件표시 = 表側표시
	CALL CARD_CHECK_ADV(듀얼리스트,종류,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF


@CARDFORCE_28153(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所

VARSET RESULT
IF 종류 == リバース誘発
	RETURN 1
ENDIF


@CARDEFFECT_28153(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード

IF 종류 == 소환時強制 || 종류 == リバース誘発
	CALL CARD_RESERV(듀얼리스트,28153,短紋章予約)

ELSEIF 종류 == 短紋章起動
	CALL FULLRESET
	효과条件カテゴリ = 스피릿
	CALL STATCHANGE_HAND(듀얼리스트,"全体",場所,"召可")

ELSEIF 종류 == ターン終了時強制
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28153)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所,손패行き)
	ENDIF

ELSEIF GROUPMATCH(종류,필드→묘지,덱→묘지,破壊→묘지,戦闘→묘지,손패→묘지)
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,28153)
	IF RESULT == 0
		CALL CARDDRAW_BASIC(듀얼리스트,1)
	ENDIF
ENDIF