@MYDECK(듀얼리스트,選択덱)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 選択덱
#DIM DYNAMIC カウンタ

SELECTCASE 選択덱
CASE 100
	FOR カウンタ,0,50
		SETVAR @"%듀얼리스트%_덱:{カウンタ}", CFLAG:TARGET:(700 + カウンタ)
	NEXT
	FOR カウンタ,0,15
		SETVAR @"%듀얼리스트%_EX덱:{カウンタ}", CFLAG:TARGET:(770 + カウンタ)
	NEXT
CASEELSE
	FOR カウンタ,0,紙束最大値
		IF 마이덱:選択덱:カウンタ <= 0
			SETVAR @"%듀얼리스트%_덱:{カウンタ}", -1
		ELSE
			SETVAR @"%듀얼리스트%_덱:{カウンタ}", 마이덱:選択덱:カウンタ
		ENDIF
	NEXT

	FOR カウンタ,0,紙束最大値
		IF マイEX덱:選択덱:カウンタ <= 0
			SETVAR @"%듀얼리스트%_EX덱:{カウンタ}", -1
		ELSE
			SETVAR @"%듀얼리스트%_EX덱:{カウンタ}", マイEX덱:選択덱:カウンタ
		ENDIF
	NEXT
	IF 듀얼리스트 != "仮組"
		SETVAR @"%듀얼리스트%_切り札", 마이덱_切り札:選択덱
		SETVAR @"%듀얼리스트%_エース", 마이덱_エース:選択덱
		SETVAR @"%듀얼리스트%_アイドル", 마이덱_アイドル:選択덱

		SETVAR @"%듀얼리스트%_切り札_技名", 마이덱_切り札_技名:選択덱
		SETVAR @"%듀얼리스트%_エース_技名", 마이덱_エース_技名:選択덱
		SETVAR @"%듀얼리스트%_アイドル_技名", 마이덱_アイドル_技名:選択덱

		;ザポルグ追記20250309
		SETVAR @"%듀얼리스트%_切り札_소환구상", 마이덱_切り札_소환구상:選択덱
		SETVAR @"%듀얼리스트%_エース_소환구상", 마이덱_エース_소환구상:選択덱
		SETVAR @"%듀얼리스트%_アイドル_소환구상", 마이덱_アイドル_소환구상:選択덱
	ENDIF
ENDSELECT

@MYDECK_SAVE(選択덱)
#DIM DYNAMIC 選択덱
#DIM DYNAMIC カウンタ

SELECTCASE 選択덱
CASE 100
	FOR カウンタ,700,760
		CFLAG:TARGET:カウンタ = -1
	NEXT
	FOR カウンタ,770,790
		CFLAG:TARGET:カウンタ = -1
	NEXT

	FOR カウンタ,0,50
		CFLAG:TARGET:(700 + カウンタ) = 編集_덱:カウンタ
	NEXT
	FOR カウンタ,0,15
		CFLAG:TARGET:(770 + カウンタ) = 編集_EX덱:カウンタ
	NEXT

CASEELSE
	FOR カウンタ,0,紙束最大値
		마이덱:選択덱:カウンタ = -1
		マイEX덱:選択덱:カウンタ = -1
	NEXT
	FOR カウンタ,0,紙束最大値
		마이덱:選択덱:カウンタ = 編集_덱:カウンタ
	NEXT
	FOR カウンタ,0,15
		マイEX덱:選択덱:カウンタ = 編集_EX덱:カウンタ
	NEXT

	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲EX덱 = 1
	효과条件ID = 編集_切り札
	CALL CARD_CHECK_ADV("編集")
	IF RESULT == 1
		마이덱_切り札:選択덱 = 編集_切り札
	ELSE
		마이덱_切り札:選択덱 = 0
	ENDIF

	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲EX덱 = 1
	효과条件ID = 編集_エース
	CALL CARD_CHECK_ADV("編集")
	IF RESULT == 1
		마이덱_エース:選択덱 = 編集_エース
	ELSE
		마이덱_エース:選択덱 = 0
	ENDIF
	CALL FULLRESET
	효과範囲덱 = 1
	효과範囲EX덱 = 1
	효과条件ID = 編集_アイドル
	CALL CARD_CHECK_ADV("編集")
	IF RESULT == 1
		마이덱_アイドル:選択덱 = 編集_アイドル
	ELSE
		마이덱_アイドル:選択덱 = 0
	ENDIF

	마이덱_切り札_技名:選択덱 = %編集_切り札_技名%
	마이덱_エース_技名:選択덱 = %編集_エース_技名%
	마이덱_アイドル_技名:選択덱 = %編集_アイドル_技名%

	;ザポルグ追記20250309
	마이덱_切り札_소환구상:選択덱 = %編集_切り札_소환구상%
	마이덱_エース_소환구상:選択덱 = %編集_エース_소환구상%
	마이덱_アイドル_소환구상:選択덱 = %編集_アイドル_소환구상%
ENDSELECT

@CHOOSE_DECK_RANDOM
#DIM DYNAMIC 설정
#DIM DYNAMIC 덱リスト,1000
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC 選択덱
FOR カウンタ,2,1000
	VARSET RESULT
	TRYCALLFORM DUELDECK_{10000 + カウンタ}("存在確認")
	SIF RESULT != 1
		CONTINUE
	덱リスト:カウンタB = 10000 + カウンタ
	カウンタB ++
NEXT

選択덱 = 덱リスト:(RAND:カウンタB)
RETURN 選択덱

