@CARDNAME_39708,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 触手宮のスライム
	CASE "略称"
		RESULTS = 触手宮のスライム
	CASE "カテゴリ"
		RESULTS:0 = 触手
        RESULTS:1 = スライム
		RESULTS:2 = E.R.A
ENDSELECT


@CARD_39708(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 闇属性
	CASE "種族"
		RETURN 悪魔族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 700
	CASE "守備力"
		RETURN 1700
ENDSELECT

RETURN 0

@CARD_EXPLANATION_39708(種類)
#DIM DYNAMIC 種類

CALL TEXT_DECORATION("ROGUE")
PRINTL このカード名の①③の効果は１ターンにそれぞれ１度しか使用できない。
CALLFORM CARD_ABLE(1,召喚時,特殊召喚時)
PRINTL ①：このカードの召喚・特殊召喚に成功した場合に発動できる。
PRINTL 手札・デッキから「触手」モンスターまたは「スライム」モンスター１体を特殊召喚する。
CALL CARD_ABLE(0,永続効果)
PRINTL ②：このカードがフィールドに表側表示で存在する限り、このカードは戦闘では破壊されない
CALL CARD_ABLE(2,墓地起動)
PRINTL ③：このカードが墓地に存在する場合、相手ターンのメインフェイズに発動できる。
PRINTL 墓地のこのカードを特殊召喚する。その後、相手フィールドの牝性モンスター１体をこのカードに装備できる。
CALL TEXT_DECORATION("ROGUE")

@CARDCAN_39708(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件達成

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,39708)
SIF RESULT == 1
	RETURN 0

IF 種類 == 召喚時 || 種類 == 特殊召喚時
	SIF 発動済_1(決闘者,39708)
		RETURN 0
	SIF モンスター数(決闘者) >= 5
		RETURN 0

    CALL FULLRESET
    効果範囲手札 = 1
    効果範囲デッキ = 1
    効果条件種類 = モン全般
    効果条件カテゴリ:0 = 触手
    効果条件カテゴリ:1 = スライム
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
    RETURN 1

ELSEIF 種類 == 墓地起動 || 種類 == フリー誘発
	SIF 発動済_2(決闘者,39708)
		RETURN 0
	SIF ゾーン != "墓地"
		RETURN 0
	SIF モンスター数(決闘者) >= 5
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー == 決闘者
		RETURN 0
    RETURN 1

ELSEIF 種類 == 永続効果
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_39708(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 調教対象

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 召喚時 || 種類 == 特殊召喚時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,39708,1)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲手札 = 1
        効果範囲デッキ = 1
        効果条件種類 = モン全般
        効果条件カテゴリ:0 = 触手
        効果条件カテゴリ:1 = スライム
		CALL CARD_SP_SUMMON_ADV(決闘者,ゾーン,場所)
	ENDIF

ELSEIF 種類 == 墓地起動 || 種類 == フリー誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,39708,2)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(決闘者,ゾーン,場所)
        IF RESULT == 1
            CALL FULLRESET
            効果範囲相手戦場 = 1
            効果条件性別 = 牝性
            効果条件表示 = 表側表示
            効果条件種類 = モン全般
            CALL CARD_EQUIP_MONSTER_ADV(決闘者,"戦場",カード召喚先)
			IF RESULT == 1
				調教対象 = RESULT:1
				CALL CARD_EROTICS(調教対象)
				IF RESULT != -1
					調教対象 = RESULT
					PRINTFORML 
					PRINTFORML %CALLNAME:調教対象%の足元に突如として粘り気のある物質が現われた。%CALLNAME:調教対象%は遠ざかろうとしたが、両足が粘り付いて離れることができない。
					PRINTFORML 一瞬のうちに、%CALLNAME:調教対象%はスライムの体に呑み込まれてしまった。半透明な物質を通して、スライムの中にいる%CALLNAME:調教対象%の姿が透けて見える。
					PRINTFORMW スライムに包まれた%CALLNAME:調教対象%は、全身を透明なゼリー状の触手に絡め取られ、さらに数本の触手が%CALLNAME:調教対象%の口内、胸、秘部、そして菊門を執拗に出入りしている。
					CALL EROTIC_MOVE("苗床捕縛",調教対象,-1,50)
				ENDIF
			ENDIF
        ENDIF
    ENDIF

ELSEIF 種類 == 永続効果
    CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"戦耐")
ENDIF