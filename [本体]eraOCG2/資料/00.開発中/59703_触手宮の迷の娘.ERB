@CARDNAME_59703,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 触手宮の迷の娘
	CASE "略称"
		RESULTS = 触手宮の迷の娘
	CASE "カテゴリ"
		RESULTS:0 = 触手
		RESULTS:1 = 苗床
		RESULTS:2 = E.R.A
ENDSELECT


@CARD_59703(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN エクシーズ
	CASE "属性"
		RETURN 闇属性
	CASE "種族"
		RETURN 悪魔族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 300
	CASE "守備力"
		RETURN 300
	CASE "性別"
		RETURN ふたなり
ENDSELECT

RETURN 0

@CARDSUMMON_59703(決闘者,召喚カード,EX参照)
#DIMS DYNAMIC 決闘者
#DIM DYNAMIC 召喚カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件レベル = 4

IF EX参照 == 1
	CALL XYZCAN(決闘者,召喚カード,59703) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_59703(種類)
#DIM DYNAMIC 種類

CALL TEXT_DECORATION("ROGUE")
PRINTL レベル４モンスター×２
CALL CARD_ABLE(1,EXデッキ起動)
PRINTL このカード名のカードは１ターンに１度、フィールドの「苗床」カード１枚を墓地へ送る事でも、エクストラデッキから特殊召喚できる。
PRINTL このカード名の①③の効果はそれぞれ１ターンに１度使用できる。
CALL CARD_ABLE(2,特殊召喚時,EX召喚時)
PRINTL ①：このカードが特殊召喚に成功した場合に発動できる。
PRINTL 手札・フィールド・デッキから「触手」モンスター１体を墓地へ送り、
PRINTL このカードのランクをその効果で墓地へ送ったモンスターのレベル分だけ変化させる。
CALL CARD_ABLE(0,攻守変動)
PRINTL ②：このカードの攻撃力・守備力は、このカードのランク×３００アップし、このカードは「苗床」カードとして扱う。
CALL CARD_ABLE(3,墓地起動)
PRINTL ③：このカードが墓地に存在する場合に発動できる。
PRINTL このカードを墓地から特殊召喚する。
PRINTL その後、相手フィールドの牝性モンスター１体を「苗床」として相手の魔法＆罠ゾーンに置くことができる。
PRINTL 自分のフィールドに「触手宮」が表側表示で存在する場合、この効果は相手ターンでも発動できる。
CALL TEXT_DECORATION("ROGUE")

@CARDCAN_59703(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件達成

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,59703)
SIF RESULT == 1
	RETURN 0

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == EXデッキ起動
	SIF 発動済_1(決闘者,59703)
		RETURN 0
	CALL CARD_SS_CHECK(決闘者,59703,"EXデッキ")
	SIF RESULT == 1
		RETURN 0
	SIF モンスター数(決闘者) >= 5
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0

    CALL FULLRESET
    効果範囲戦場 = 1
    効果範囲相手戦場 = 1
    効果範囲魔罠 = 1
    効果範囲相手魔罠 = 1
    効果条件カテゴリ = 苗床
    効果条件表示 = 表側表示
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
    RETURN 1
    
ELSEIF 種類 == EX召喚時 || 種類 == 特殊召喚時
	SIF 発動済_2(決闘者,59703)
		RETURN 0

    CALL FULLRESET
    効果範囲手札 = 1
    効果範囲デッキ = 1
    効果範囲戦場 = 1
    効果範囲相手戦場 = 1
    効果範囲魔罠 = 1
    効果範囲相手魔罠 = 1
    効果条件カテゴリ = 触手
    効果条件種類 = モン全般
    効果条件表示 = 表側表示
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
    RETURN 1

ELSEIF 種類 == 墓地起動 || 種類 == フリー誘発
	SIF 発動済_3(決闘者,59703)
		RETURN 0
	SIF ゾーン != "墓地"
		RETURN 0
	SIF モンスター数(決闘者) >= 5
		RETURN 0

    CALL FULLRESET
    効果範囲魔罠 = 1
    効果条件表示 = 表側表示
    効果条件名前 = 触手宮 -テンタクル・パレス-
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	IF RESULT != 1
        SIF メインフェイズ != 1
            RETURN 0
        SIF ターンプレイヤー != 決闘者
            RETURN 0
    ENDIF
    RETURN 1

ELSEIF 種類 == 攻守変動
	SIF ゾーン != "戦場"
		RETURN 0
    RETURN 1
ENDIF



@CARDEFFECT_59703(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 参照レベル
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 調教対象

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == EXデッキ起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,59703,1)
	IF RESULT == 0
        CALL FULLRESET
        効果範囲戦場 = 1
        効果範囲相手戦場 = 1
        効果範囲魔罠 = 1
        効果範囲相手魔罠 = 1
        効果条件カテゴリ = 苗床
        効果条件表示 = 表側表示
        効果条件行先フラグ = 墓地行き
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			調教対象 = RESULT:1

			CALL FULLRESET
            CALL CARD_EX_SUMMON(決闘者, "EXデッキ", 場所)
			IF RESULT == 1
				CALL CARD_EROTICS(調教対象)
				IF RESULT != -1
					調教対象 = RESULT
					PRINTFORML 
					PRINTFORML 苗床としての%CALLNAME:調教対象%は、触手との子を産み落とし、生まれたばかりの子供に栄養を与え、性的な欲求を解消させている。
					PRINTFORMW その後、%CALLNAME:調教対象%を拘束していた触手が彼女を再び飲み込み、次の出産に備えて準備を始めた。
					CALL EROTIC_MOVE("苗床捕縛",調教対象,-1,50)
				ENDIF
			ENDIF
		ENDIF
    ENDIF

ELSEIF 種類 == EX召喚時 || 種類 == 特殊召喚時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,59703,2)
	IF RESULT == 0
        CALL FULLRESET
        効果範囲手札 = 1
        効果範囲デッキ = 1
        効果範囲戦場 = 1
        効果範囲相手戦場 = 1
        効果範囲魔罠 = 1
        効果範囲相手魔罠 = 1
        効果条件カテゴリ = 触手
        効果条件種類 = モン全般
        効果条件表示 = 表側表示
        効果条件行先フラグ = 墓地行き
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
        	選択カード_ID = RESULT:1
			TRYCALLFORM CARD_{選択カード_ID}("レベル")
			参照レベル = RESULT
			CALL SET_FIELD_INFO(決闘者,"戦場",場所,"永星",参照レベル,上書きモード)
        ENDIF
    ENDIF

ELSEIF 種類 == 墓地起動 || 種類 == フリー誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,59703,3)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_SP_SUMMON(決闘者,ゾーン,場所)
        IF RESULT == 1
            効果範囲相手戦場 = 1
            効果条件性別 = 牝性
            効果条件表示 = 表側表示
            効果追加カテ = 苗床
            CALL CARD_SET_ADV(決闘者,ゾーン,場所,"表側表示",1)
        ENDIF
    ENDIF

ELSEIF 種類 == 攻守変動
	攻撃力修正 = GETVAR(@"%決闘者%_MZ_星:場所") * 300
	CALL STATCHANGE_BASIC(決闘者,"自身",場所,攻撃力修正)
ENDIF