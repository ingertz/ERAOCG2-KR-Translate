@CARDNAME_72486,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = パワーアップゲージ
	CASE "略称"
		RESULTS = POW UPゲージ
	CASE "カテゴリ"
		RESULTS:0 = 時空戦闘機
	CASE "出典作品"
		RESULTS:0 = Gradius
ENDSELECT


@CARD_72486(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "種類"
		RETURN 通常魔法
ENDSELECT

RETURN 0

@CARD_EXPLANATION_72486(種類)
#DIM DYNAMIC 種類

CALLFORM CARD_ABLE(0,魔罠起動,手札起動)
PRINTL ①：自分フィールドのモンスター１体をデッキに戻して発動できる。
PRINTL 自分のデッキ・墓地から「時空戦闘機」モンスターを２体まで選んで手札に加える。
PRINTL 自分の墓地に「パワーカプセル」カードがある場合、さらに自分の手札・フィールドの
PRINTL モンスターを融合素材とし、機械族・光属性の融合モンスター１体を融合召喚できる。

@CARDCAN_72486(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,72486)
SIF RESULT == 1
	RETURN 0

;汎用処理
IF 種類 == 魔罠起動 || 種類 == 手札起動
	CALL CARD_CONT_M(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	効果範囲戦場 = 1
	効果条件種類 = モン全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_72486(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード


IF 種類 == 魔罠起動 || 種類 == 手札起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,72486)
	IF RESULT == 0
		CALL CARD_DISPOSE(決闘者,ゾーン,場所)
		CALL FULLRESET
		効果条件種類 = モン全般
		効果条件行先フラグ = 2
		CALL CARD_ADD_GY_BASIC(決闘者,"戦場",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			効果範囲デッキ = 1
			効果範囲墓地 = 1
			効果条件カテゴリ = 時空戦闘機
			効果条件種類 = モン全般
			効果条件複数 = 98
			CALL CARD_ADD_ADV(決闘者,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				効果範囲墓地 = 1
				効果条件カテゴリ = パワーカプセル
				CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
				IF RESULT == 1
					CALL RESETAREA_MAT
					素材範囲手札 = 1
					素材範囲戦場 = 1
					CALL FULLRESET
					効果範囲EXデッキ = 1
					効果条件種類 = 融合
					効果条件種族 = 機械族
					効果条件属性 = 光属性
					効果条件召喚可 = 1
					CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
					IF RESULT == 1
						CALL FULLRESET
						効果条件種類 = 融合
						効果条件種族 = 機械族
						効果条件属性 = 光属性
						効果条件召喚可 = 1
						効果条件任意 = 1
						CALL CARD_CHOOSE_BASIC(決闘者,"EXデッキ",ゾーン,場所)
						選択カード = RESULT
						;戻る
						IF 選択カード != 9999
							;カードの条件を読み込む：
							TRYCALLFORM CARDSUMMON_{GETVAR(@"%決闘者%_EXデッキ:{選択カード}")}(決闘者,選択カード)
							;素材処理を読み込む
							CALL FUSSUMMON(決闘者, 選択カード)
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
