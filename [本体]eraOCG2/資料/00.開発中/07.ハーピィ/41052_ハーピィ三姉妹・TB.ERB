@CARDNAME_41052,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ハーピィレディース・トライアングル・ビューティ
	CASE "略称"
		RESULTS = 三姉妹・ＴＢ
	CASE "カテゴリ"
		RESULTS:0 = ハーピィ
ENDSELECT


@CARD_41052(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 0
	CASE "種類"
		RETURN 融合
	CASE "属性"
		RETURN 風属性
	CASE "種族"
		RETURN 鳥獣族
	CASE "レベル"
		RETURN 12
	CASE "攻撃力"
		RETURN 3400
	CASE "守備力"
		RETURN 2100
	CASE "性別"
		RETURN 牝性
ENDSELECT

RETURN 0


