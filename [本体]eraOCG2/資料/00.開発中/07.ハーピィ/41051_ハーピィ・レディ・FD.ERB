@CARDNAME_41051,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ハーピィ・レディ・フェザー・ダスター
	CASE "略称"
		RESULTS = ハーピィ・ＦＤ
	CASE "カテゴリ"
		RESULTS:0 = ハーピィ
ENDSELECT


@CARD_41051(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 0
	CASE "種類"
		RETURN 融合
	CASE "属性"
		RETURN 風属性
	CASE "種族"
		RETURN 鳥獣族
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 2100
	CASE "守備力"
		RETURN 1400
	CASE "性別"
		RETURN 牝性
	CASE "連動ID"
		RETURN 1050
ENDSELECT

RETURN 0


@CARD_EXPLANATION_41051(種類)
#DIM DYNAMIC 種類

PRINTL レベル４の「ハーピィ・レディ」＋鳥獣族・風属性の通常モンスター
PRINTL このカードは自分フィールドの上記モンスターを素材としてコンタクト融合できる。
PRINTL このカード名の①の効果は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,EX召喚時,特殊召喚時)
PRINTL ①：このカードが特殊召喚した場合に発動できる。デッキから「ハーピィの羽根帚」１枚を手札に加える。
CALLFORM CARD_ABLE(10,戦場起動)
PRINTL ②：１ターンに１度、デッキの一番上のカードを墓地へ送って発動できる。
PRINTL このカードのカード名はこのターン、「ハーピィ・レディ」になる。
PRINTL その後、相手フィールドの魔法・罠カード１枚を選んで破壊できる。


@CARDSUMMON_41051(決闘者,召喚カード,EX参照)
#DIMS DYNAMIC 決闘者
#DIM DYNAMIC 召喚カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材条件レベル = 4
	素材条件種類 = レベル持ち
	素材条件名前 = ハーピィ・レディ
ELSEIF EX参照 >= 10
	素材条件種族 = 鳥獣族
	素材条件属性 = 風属性
	素材条件種類 = 通常モン
ENDIF
IF EX参照 == 1
	CALL FUSCAN(決闘者,召喚カード,41051) 
	RETURN RESULT
ENDIF

@CARDCAN_41051(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者判定(決闘者)
対面者 = %RESULTS%


CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,41051)
SIF RESULT == 1
	RETURN 0

IF 種類 == EXデッキ起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL CARD_EX_CHECK(決闘者,41051)
	SIF RESULT == 1
		RETURN 0
	CALL RESETAREA_MAT
	素材範囲戦場 = 1
	CALL FULLRESET
	効果範囲EXデッキ = 1
	効果条件固定 = 場所
	効果条件召喚可 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 特殊召喚時
	SIF 発動済_1(決闘者,41051)
		RETURN 0
	CALL FULLRESET
	効果範囲デッキ = 1
	効果条件名前 = ハーピィの羽根帚
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 戦場起動
	SIF 効果発動済(決闘者,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_41051(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 除外判定

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == EXデッキ起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,41051)
	IF RESULT == 0
		CALL RESETAREA_MAT
		素材範囲戦場 = 1
		CALL FULLRESET
		TRYCALLFORM CARDSUMMON_41051(決闘者,場所)
		CALL FUSSUMMON(決闘者,場所,デッキ行き)
	ENDIF
ELSEIF 種類 == 特殊召喚時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,41051,1)
	IF RESULT == 0
		CALL FULLRESET
		効果条件名前 = ハーピィの羽根帚
		CALL CARD_ADD_BASIC(決闘者,"デッキ",ゾーン,場所)
	ENDIF
ELSEIF 種類 == 戦場起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,41051,10)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_DECK_DISPOSE(決闘者,"デッキ",0)
		CALL SET_FIELD_INFO(決闘者,"戦場",場所,"変化元ID",1050,上書きモード)
		CALL FULLRESET
		効果条件任意 = 1
		CALL CARD_REMOVAL_BASIC(決闘者,"魔罠単体",場所,"墓地")
	ENDIF
ENDIF

