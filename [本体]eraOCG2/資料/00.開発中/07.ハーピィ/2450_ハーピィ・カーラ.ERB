@CARDNAME_2450,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ハーピィ・カーラ
	CASE "略称"
		RESULTS = ハーピィ・カーラ
	CASE "カテゴリ"
		RESULTS:0 = ハーピィ
ENDSELECT


@CARD_2450(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 0
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 風属性
	CASE "種族"
		RETURN 鳥獣族
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 500
	CASE "守備力"
		RETURN 500
	CASE "性別"
		RETURN 牝性
ENDSELECT

RETURN 0

@CARD_EXPLANATION_2450(種類)
#DIM DYNAMIC 種類

CALLFORM CARD_ABLE(10,戦場起動)
PRINTL ①：１ターンに１度、デッキから風属性の通常モンスターを墓地に送って発動できる。
PRINTL 自分の墓地の「ハーピィ」魔法・罠カード１枚を選んで自分の魔法＆罠ゾーンにセットする。
PRINTL 
PRINTL 


@CARDCAN_2450(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所


CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,2450)
SIF RESULT == 1
	RETURN 0

IF 種類 == 戦場起動
	SIF 効果発動済(決闘者,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL FULLRESET
	効果範囲デッキ = 1
	効果条件属性 = 風属性
	効果条件種類 = 通常モン
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0


	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件カテゴリ = ハーピィ
	効果条件種類 = 魔罠全般
	効果条件セット = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_2450(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード


IF 種類 == 戦場起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,2450,10)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲デッキ = 1
		効果条件属性 = 風属性
		効果条件種類 = 通常モン
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			効果条件名前 = ハーピィズフルドレス
			CALL CARD_SET_BASIC(決闘者,"墓地",ゾーン,場所,"裏側表示")
		ENDIF
	ENDIF
ENDIF
