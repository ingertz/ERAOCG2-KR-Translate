@CARDNAME_2454,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ハーピィ・レジーナ
	CASE "略称"
		RESULTS = Hp・レジーナ
	CASE "カテゴリ"
		RESULTS:0 = ハーピィ
ENDSELECT


@CARD_2454(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 0
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 風属性
	CASE "種族"
		RETURN 鳥獣族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1000
	CASE "守備力"
		RETURN 300
	CASE "性別"
		RETURN 牝性
ENDSELECT

RETURN 0

@CARD_EXPLANATION_2454(種類)
#DIM DYNAMIC 種類

CALLFORM CARD_ABLE(10,戦場起動)
PRINTL ①：１ターンに１度、自分フィールドに他の鳥獣族・風属性モンスターが存在する場合、
PRINTL 手札１枚を墓地へ送って発動できる。自分は１枚ドローする。自分フィールドに通常モンスターがいる場合、
PRINTL さらに自分の墓地の「ハーピィ」モンスター１体を選んで手札に加える事ができる。

@CARDCAN_2454(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所


CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,2454)
SIF RESULT == 1
	RETURN 0

IF 種類 == 戦場起動
	SIF 効果発動済(決闘者,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL FULLRESET
	効果範囲戦場 = 1
	効果条件種族 = 鳥獣族
	効果条件属性 = 風属性
	効果条件他所 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 手札数(決闘者) < 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_2454(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ


IF 種類 == 戦場起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,2454,10)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲手札 = 1
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			CALL CARDDRAW_BASIC(決闘者,1)
			CALL FULLRESET
			効果範囲戦場 = 1
			効果条件種類 = 通常モン
			CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
			IF RESULT == 1
				効果条件カテゴリ = ハーピィ
				効果条件種類 = モン全般
				CALL CARD_ADD_BASIC(決闘者,"墓地",ゾーン,場所)
			ENDIF
		ENDIF
	ENDIF
ENDIF
