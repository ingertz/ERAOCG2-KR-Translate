	CASE "外部者"
		RETURN 0
	CASE "種類"
		RETURN 通常魔法
	CASE "生成カード"
		RETURN 161057
ENDSELECT

RETURN 0

@CARD_EXPLANATION_61057(種類)
#DIM DYNAMIC 種類

PRINTL このカード名のカードは１ターンに１枚しか発動できない。
CALLFORM CARD_ABLE(1,魔罠起動,手札起動)
PRINTL ①：以下の効果から１つを選択して発動できる。
PRINTL ●自分のモンスターゾーンからEXモンスター以外の「ハーピィ・レディ三姉妹」１体を消滅させて発動できる。
PRINTL 手札に「ハーピィ三姉妹」を生成する。その後、自分フィールドのモンスターを全て持ち主の手札に戻す事ができる。
PRINTL 自分のEXモンスターを戻した場合、その数まで自分の墓地から「ハーピィ」モンスターを手札に加える事ができる。
PRINTL ●自分フィールドのレベル６以上の「ハーピィ」モンスター１体を対象として発動できる。
PRINTL そのモンスターは、攻撃力が自身のレベル×１００アップし、貫通能力を得る。


@CARDCAN_61057(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件達成,2

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,61057)
SIF RESULT == 1
	RETURN 0

IF 種類 == 魔罠起動 || 種類 == 手札起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL FULLRESET
	効果範囲戦場 = 1
	効果条件種類 = EX以外全般
	効果条件名前 = ハーピィ・レディ三姉妹
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT == 1
		条件達成:0 = 1
	CALL FULLRESET
	効果範囲戦場 = 1
	効果条件カテゴリ = ハーピィ
	効果条件種類 = レベル持ち
	CALL 効果条件レベル_ADV(6, "以上")
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT == 1
		条件達成:1 = 1
	SIF 条件達成:0 != 1 && 条件達成:1 != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_61057(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件達成,2
#DIM DYNAMIC EX判定用,2
#DIM DYNAMIC サルベージ枚数
#DIM DYNAMIC 選択レベル


IF 種類 == 魔罠起動 || 種類 == 手札起動
	;カード発動確認
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,61057)
	IF RESULT == 0
		CALL CARD_DISPOSE(決闘者,ゾーン,場所)
		CALL FULLRESET
		効果範囲戦場 = 1
		効果条件種類 = EX以外全般
		効果条件名前 = ハーピィ・レディ三姉妹
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT == 1
			条件達成:0 = 1
		CALL FULLRESET
		効果範囲戦場 = 1
		効果条件カテゴリ = ハーピィ
		効果条件種類 = レベル持ち
		CALL 効果条件レベル_ADV(6, "以上")
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT == 1
			条件達成:1 = 1
		IF 条件達成:0 == 1 && 条件達成:1 == 1
			PRINTL どちらの効果を発動しますか？
			CALL YN_CHOICE(決闘者,"●手札に「ハーピィ三姉妹」を生成する","●レベル６以上の「ハーピィ」１体を強化する")
		ELSEIF 条件達成:0 == 1 && 条件達成:1 != 1
			RESULT = 0
		ELSEIF 条件達成:0 != 1 && 条件達成:1 == 1
			RESULT = 1
		ENDIF
		IF RESULT == 0
			CALL FULLRESET
			効果範囲戦場 = 1
			効果条件種類 = EX以外全般
			効果条件名前 = ハーピィ・レディ三姉妹
			効果条件行先フラグ = 消滅行き
			CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
			IF RESULT == 1
				CALL CARD_GENERATE_HAND(決闘者,161057)
				PRINTL 自分フィールドのモンスターを手札に戻しますか？
				CALL YN_CHOICE(決闘者)
				IF RESULT == 0
					EX判定用:0 = 現EX山札数(決闘者)
					CALL FULLRESET
					効果範囲戦場 = 1
					CALL CARD_REMOVAL_ADV(決闘者,"全体除去",場所,"手札")
					EX判定用:1 = 現EX山札数(決闘者)
					サルベージ枚数 = EX判定用:1 - EX判定用:0
					IF サルベージ枚数 != 0
						CALL FULLRESET
						効果条件カテゴリ = ハーピィ
						効果条件種類 = モン全般
						SIF サルベージ枚数 == 1
							効果条件任意 = 1
						SIF サルベージ枚数 != 1
							効果条件複数 = 100 - サルベージ枚数
						CALL CARD_ADD_BASIC(決闘者,"墓地",ゾーン,場所)
					ENDIF
				ENDIF
			ENDIF
		ELSE
			CALL FULLRESET
			効果範囲戦場 = 1
			効果条件カテゴリ = ハーピィ
			効果条件種類 = レベル持ち
			CALL 効果条件レベル_ADV(6, "以上")
			CALL CARD_CHOOSE_ADV(決闘者,ゾーン,場所)
			IF 選択カード != 9999
				選択レベル = GETVAR(@"%決闘者%_MZ_星:RESULT")
				CALL SET_FIELD_INFO(決闘者,"戦場",場所,"永攻",選択レベル*100)
				CALL SET_FIELD_INFO(決闘者,"戦場",場所,"貫通",2)
			ENDIF
		ENDIF
	ENDIF
ENDIF


