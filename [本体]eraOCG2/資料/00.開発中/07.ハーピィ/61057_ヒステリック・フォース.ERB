SELECTCASE 参照先
	CASE "名前"
		RESULTS = ハーピィレディース[Ｒ]
	CASE "略称"
		RESULTS = 三姉妹 [R]
	CASE "カテゴリ"
		RESULTS:0 = ハーピィ
	CASE "マキシマム"
		RESULTS = 三姉妹・パーツ
ENDSELECT


@CARD_261059(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 0
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 風属性
	CASE "種族"
		RETURN 鳥獣族
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 600
	CASE "守備力"
		RETURN 1100
	CASE "性別"
		RETURN 牝性
	CASE "パーツ"
		RETURN 1
ENDSELECT
RETURN 0

@CARD_EXPLANATION_261059(種類)
#DIM DYNAMIC 種類

PRINTL （マキシマムモードのこのカードは攻撃できない）
CALL CARD_ABLE(0,永続効果)
PRINTL ①：このカードのカード名は、モンスターゾーンに存在する限り「ハーピィ・レディ三姉妹」として扱い、
CALL CARD_ABLE(0,攻守変動)
PRINTL このカードがマキシマムモードではないなら、その攻撃力・守備力はコアと同じになる。
CALL CARD_ABLE(0,永続効果)
PRINTL ②：自分のモンスターゾーンの「ハーピィ・レディ三姉妹」はモンスター耐性を持ち、
PRINTL このカードがマキシマムモードなら、守備表示のそのカードは攻撃回避と対象耐性を得る。

@CARDCAN_261059(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,261059)
SIF RESULT == 1
	RETURN 0

IF 種類 == 永続効果
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ELSEIF 種類 == 攻守変動
	CALL CARD_CHECK_MAXX(決闘者,ゾーン,場所,"三姉妹・コア")
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == マキシマム条件
	CALL CARD_CHECK_MAXX(決闘者,ゾーン,場所,"三姉妹・コア")
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_261059(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者判定(決闘者)
対面者 = %RESULTS%


IF 種類 == 永続効果
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"変化元ID",161051)
	CALL FULLRESET
	効果条件名前 = ハーピィ・レディ三姉妹
	CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"モ耐")
ELSEIF 種類 == 攻守変動
	CALL STATCHANGE_BASIC(決闘者,"装備",場所,1500,-1100)
ELSEIF 種類 == マキシマム条件
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"戦無")
	CALL FULLRESET
	効果条件表示 = 守備表示
	効果条件名前 = ハーピィ・レディ三姉妹
	CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"攻避")
	CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"対耐")
ENDIF
