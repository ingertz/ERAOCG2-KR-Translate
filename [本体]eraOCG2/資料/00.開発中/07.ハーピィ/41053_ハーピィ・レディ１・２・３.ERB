@CARDSUMMON_41053(決闘者,召喚カード,EX参照)
#DIMS DYNAMIC 決闘者
#DIM DYNAMIC 召喚カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 3
素材条件名前 = ハーピィ・レディ


IF EX参照 == 1
	CALL FUSCAN(決闘者,召喚カード,41053) 
	RETURN RESULT
ENDIF

@CARDCAN_41053(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者判定(決闘者)
対面者 = %RESULTS%


CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,41053)
SIF RESULT == 1
	RETURN 0

IF 種類 == EXデッキ起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL CARD_EX_CHECK(決闘者,41053)
	SIF RESULT == 1
		RETURN 0
	CALL RESETAREA_MAT
	素材範囲戦場 = 1
	CALL FULLRESET
	効果範囲EXデッキ = 1
	効果条件固定 = 場所
	効果条件召喚可 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 永続効果
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_41053(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 除外判定

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == EXデッキ起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,41053)
	IF RESULT == 0
		CALL RESETAREA_MAT
		素材範囲戦場 = 1
		CALL FULLRESET
		TRYCALLFORM CARDSUMMON_41053(決闘者,場所)
		CALL FUSSUMMON(決闘者,場所,デッキ行き)
	ENDIF
ELSEIF 種類 == 永続効果
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"変化元ID",161051)
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"直無")
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"追戦",2)
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"不材")
ENDIF

