@CARDNAME_41053,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ハーピィ・レディ１・２・３
	CASE "略称"
		RESULTS = ハーピィ１２３
	CASE "カテゴリ"
		RESULTS:0 = ハーピィ
ENDSELECT


@CARD_41053(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 0
	CASE "種類"
		RETURN 融合
	CASE "属性"
		RETURN 風属性
	CASE "種族"
		RETURN 鳥獣族
	CASE "レベル"
		RETURN 12
	CASE "攻撃力"
		RETURN 3900
	CASE "守備力"
		RETURN 2100
	CASE "性別"
		RETURN 牝性
ENDSELECT

RETURN 0


@CARD_EXPLANATION_41053(種類)
