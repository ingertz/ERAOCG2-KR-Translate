@IRAI_EVENT_381(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 対象キャラ
#DIM DYNAMIC 条件達成数 = 0
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 追加条件フラグ = 0

VARSET RESULT
VARSET RESULTS

;魔法世界での、ウィッチクラフトとの（まともすぎる）クエスト
;異世界の技術の情報など、開発のヒントにするための情報交換（ヒアリング）を行いたいとか
;OCGにおける別世界（端末世界）の融合魔法の情報を提供して、対価に試作したゴーレムを貰う。
;貰ったゴーレムを使ってモニターテストするということで、結果や事件等は後続依頼につづく（？）
;続きでは、シャドールの人形がヴェールを襲い、デュエルで人形を破壊する感じの依頼となる予定？

;発生条件
;・千年ドアによる次元移動可能（２章までクリア）
;　もしくは「ヴェール」を所持済み　⇒殆ど初期からクエスト受注する裏ルートとして設定。シナリオ導入部も変わる
;・ウィッチクラフトマスター・ヴェールと面識あり（他の子は不問）
;・「ウィッチクラフト」キャラクターのカードを３種類以上所持する必要あり。
;クエスト追加条件
;	話の都合上、該当するカードが必要
;	「ジェムナイト・クリスタ」
;	「ジェムナイト・フュージョン」
;	「シャドール・フュージョン」

SIF !(ITEM:31102);ジェムナイト・クリスタ(ID:31102)
	追加条件フラグ |= 1
SIF !(ITEM:71101);ジェムナイト・フュージョン(ID:71101)
	追加条件フラグ |= 2
SIF !(ITEM:61831);影依融合(ID:61831)
	追加条件フラグ |= 4

;「ウィッチクラフト」キャラのカード枚数をチェック（依頼として表示するためには３種類以上必要）
FOR カウンタ,2040,2050
	SIF ITEM:カウンタ <= 0
		CONTINUE
	条件達成数 ++
NEXT

SELECTCASE 参照先
	CASE  "名前"
		RESULTS = (CP-WC1)ウィッチクラフト・ワークショップ
	CASE "イベント種"
		RETURN イベント_ＲＥ
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		IF 追加条件フラグ == 0;bitが立ってないなら受領可能
			PRINTL 
			IF ITEM:千年ドア == 0 ;千年ドアの取得なしのケース = ヴェール所持ルートの導入となる。
				PRINTL ある日、自室の机の上に見慣れぬ巻物が置いてあったのを見つけた。
			ELSE
				PRINTL ある日、千年ドアで異世界と繋がったクローゼットに巻物が置いてあったのを見つけた。
			ENDIF
			PRINTL 印章つきの封蝋までされた、時代がかった巻物にはこう書かれていた。
			PRINTL 
			PRINTL 「異なる世界の技術・我々の知らない未知の魔法技術、承ります」
			PRINTL 
			PRINTL 
			PRINTL 
			PRINTL 
			PRINTL 成功報酬：情報提供料（応相談）
		ELSE
			PRINTL 
			PRINTL 依頼を受けるためには以下のカードが必要になります。
			PRINTL 
			IF 追加条件フラグ & 1
				SETCOLOR C_RED
				PRINTL ・「ジェムナイト・クリスタ」　のカードが必要です。
				RESETCOLOR
			ELSE
				PRINTL ・「ジェムナイト・クリスタ」　のカードは所持しています。
			ENDIF
			IF 追加条件フラグ & 2
				SETCOLOR C_RED
				PRINTL ・「ジェムナイト・フュージョン」　のカードが必要です。
				RESETCOLOR
			ELSE
				PRINTL ・「ジェムナイト・フュージョン」　のカードは所持しています。
			ENDIF
			IF 追加条件フラグ & 4
				SETCOLOR C_RED
				PRINTL ・「影依融合」　のカードが必要です。
				RESETCOLOR
			ELSE
				PRINTL ・「影依融合」　のカードは所持しています。
			ENDIF
			PRINTL 
			PRINTL カードを入手してから、再度依頼を受けて下さい。
			PRINTL （デッキ編集画面でのカード生成がおすすめです）
			PRINTL 
		ENDIF
	CASE "条件"
		;千年ドアの開放、またはヴェール本人を呼び出せる状態
		SIF ITEM:千年ドア == 0 && CFLAG:NO_TO_CHARANUM(2040):所有済み == 0
			RETURN 0
		;ヴェールとの面識が必要（話を色々と手っ取り早くするための卑劣な条件設定だ……）
		SIF CFLAG:NO_TO_CHARANUM(2040):面識 == 0
			RETURN 0
		;「ウィッチクラフト」のキャラクターのカードが３種類以上は必要。
		SIF 条件達成数 <= 2
			RETURN 0
		RETURN 1
	CASE "追加条件"
		;「ジェムナイト・クリスタ」と「ジェムナイト・フュージョン」と「影依融合」の３枚のカードが必要。
		IF 追加条件フラグ != 0
			RESULTS = 依頼を受けるにはカードが足りません。
			RETURN 1
		ENDIF
		RETURN 0
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0

@IRAI_ACT_381(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC イベント主,10
#DIM DYNAMIC 条件達成 = 0

;ヴェール
イベント主:0 = NO_TO_CHARANUM(2040)
;ハイネ
イベント主:1 = NO_TO_CHARANUM(2041)
;ジェニー
イベント主:2 = NO_TO_CHARANUM(2042)
;エーデル
イベント主:3 = NO_TO_CHARANUM(2047)
;シュミッタ
イベント主:4 = NO_TO_CHARANUM(2046)
;ピットレ
イベント主:5 = NO_TO_CHARANUM(2045)
;ポトリー
イベント主:6 = NO_TO_CHARANUM(2044)


IF 依頼_達成状況 == 0
	;依頼スキップ機能
	IF 依頼_見返し中 >= 1
		CUSTOMDRAWLINE -
		PRINTL 依頼をスキップしますか？
		CUSTOMDRAWLINE -
		PRINTFORML 
		PRINTFORML 
		PRINTFORML [0] - お話を読む
		PRINTFORML [1] - カードだけゲット！
		BINPUT
		IF RESULT
			PRINTFORMW 依頼をクリアしたものとして扱い、カードだけ入手します。
			GOTO SKIPEND_IRAI381
		ENDIF
	ENDIF
	;最初　依頼を受けて自室から移動
	IF ITEM:千年ドア == 0
		;ドアなしのケースはヴェール所持している前提となる。特殊演出（早期所持 = 初期キャラ選択の想定）
		PRINTFORML 
		PRINTFORMW 「異なる世界の技術・我々の知らない未知の魔法技術、承ります」
		PRINTFORML 
		PRINTFORMW ・・・仰々しい文体でそう書かれた巻物は、現代ではまず見かけない代物だ。
		PRINTFORMW メールもパソコンもある現代社会で、こんな通信手段を取る知り合いは居ないな。
		PRINTFORMW それに封蝋の紋章にも見覚えがある。
		PRINTFORMW ハンマーとハサミを抽象化したそのシンボルマークは・・・『ウィッチクラフト』
		PRINTFORML 
		PRINTFORMW ・・・
		PRINTFORMW ・・・<<ウィッチクラフト・デモンストレーション>>の効果を発動！
		PRINTFORMW <<ウィッチクラフトマスター・ヴェール>>を特殊召喚する！
		PRINTFORML 
		CALL FLASH(2)
		PRINTFORMW POM！
		PRINTFORMW カードから幼い女の子が飛び出してきた！　もちろん守備表示で。
		PRINTFORML 
		PRINTFORMW 「もうっ。いきなり呼び出すなんて、ずいぶんじゃない？」
		PRINTFORMW 召喚されたことを瞬時に察した少女――%CALLNAME:(イベント主:0)%は、頭を掻きながら不満を軽く口にしている。
		PRINTFORML 
		PRINTFORMW そんな%CALLNAME:(イベント主:0)%に巻物を見せつけると、彼女は肩をすくめた。
		PRINTFORMW 「あら？　この文字は魔法文字じゃない。これを書いた人間はとても高レベルな魔法使いね♪」
		PRINTFORML 
		PRINTFORMW 普通、そういうの自分で言うか……
		CLEARLINE 1
		PRINTFORMW 普通、そういうの自分で言うか……言うんだろうな。
		PRINTFORML 
		PRINTFORMW 「……冗談はこのぐらいにしておくとして。実は今、研究開発が"ちょっとだけ"行き詰まっててね」
		PRINTFORMW ホンの"ちょっと"だと、指の仕草で強調するように言う。
		PRINTFORMW 「そういう時は、全く新しい知見を得るのが一番手っ取り早いのよ。で、%CALLNAME:MASTER%の出番ってわけ」
		PRINTFORML 
		PRINTFORMW なるほど。理屈は分からんでもない。
		PRINTFORMW しかし、魔法に関してはほとんど素人なんだが、それでいいんだろうか？
		PRINTFORMW 「いいのよ。外からの刺激が入るだけでも、物事って意外と好転したりするんだから。……それに」
		PRINTFORML 
		PRINTFORML くるりと踊るように、軽やかに%CALLNAME:(イベント主:0)%は身を翻して指差した。
		PRINTFORMW 「%CALLNAME:MASTER%の『物事を見抜く力』……結構、信用してるのよ」
		PRINTFORML 
		PRINTFORMW ・・・
		CLEARLINE 1
		PRINTFORMW ・・・そう、事もなげに言った。
		CLEARLINE 1
		PRINTFORMW ・・・そう、事もなげに言った。そしてそのまま、自分の胸に手を当てて自信満々に言葉を続けた。
		PRINTFORMW 「なんといっても、このわたしを選び取ったのだから、大した審美眼というものよ♪」
		PRINTFORML 
		PRINTFORMW ・
		PRINTFORMW ・・
		PRINTFORMW ・・・
		PRINTFORML 
		PRINTFORMW それで、具体的には何をすればいいのか？　尋ねると、%CALLNAME:(イベント主:0)%は少しだけ考える素振りを見せた。
		PRINTFORMW 「やっぱり私たちの工房まで来て貰いたいから……これよね」
		PRINTFORMW %CALLNAME:(イベント主:0)%が指を鳴らすと、何もない空間から魔法の杖が現れる。
		PRINTFORML 
		PRINTFORMW <<ウィッチクラフトマスター・ヴェール>>の魔法の杖は、最上級の魔法使いが手にするに相応しい、複雑な意匠と装飾が凝らされている。
		PRINTFORML 
		PRINTFORML 水晶のように透き通った煌玉の魔法石には、ゆっくりと色を変える不思議な光の輝きが閉じ込められている。
		PRINTFORML 淡い藍色の輝きと桃色の輝きのグラデーションが玻璃の中で反射光を織り成し、杖を構える少女の頬を色づけている。
		PRINTFORML 魔法石をぐるりと取り囲む水晶細工の装飾部には、１つだけでも並の魔法使いの杖で中核に据えられる価値のある宝石が、数え切れないほど――――
		TWAIT 5, 0
		PRINTFORML 
		PRINTFORMW 「……そんなにまじまじと見つめてたらケガするわよ」
		PRINTFORML 
		PRINTFORMW %CALLNAME:(イベント主:0)%は、国１つでも替えが効かない至高の杖で軽くこちらを小突いて追い払うと、サッと大きく振りかぶった。
		PRINTFORML 
		PRINTFORM 部屋の空気が変わり、カタカタと部屋の小物が震えはじめる。
		WAIT
		PRINTFORM いや、震えているのは小物ではない、家全体――
		WAIT
		PRINTFORML いや、この世界がっ――――
		PRINTFORML 
		PRINTFORMW 「ディメンション・マジック！　"リターン・オブ・ザ・ワールド"！！」
		
		CALL FLASH(2)
		PRINTFORMW ・・・
		PRINTFORMW ・・・・・・
		CALL FLASH(2)
		PRINTFORMW ・・・・・・・・・！
		
		;依頼_場所 = 場所_寝室
		依頼_達成状況 ++
		依頼用エリア１名称 = 魔法世界のどこか
		依頼用エリア２名称 = ウィッチクラフトの工房 エントランス
		依頼用エリア３名称 = ウィッチクラフトの工房 商品開発部
		依頼用エリア４名称 = ウィッチクラフトの工房 試験ルーム
		CALL EVENT_MOVE(MASTER,場所_依頼用エリア１,1)
		CALL EVENT_TIMER(20)
	ELSE
		;ドアありの場合は普通に自力で次元移動する必要あり。
		PRINTFORML 
		PRINTFORMW 「異なる世界の技術・我々の知らない未知の魔法技術、承ります」
		PRINTFORML 
		PRINTFORMW ・・・仰々しい文体でそう書かれた巻物は、現代ではまず見かけない代物だ。
		PRINTFORMW メールもパソコンもある現代社会で、こんな通信手段を取る知り合いは居ないな。
		PRINTFORMW それに封蝋の紋章にも見覚えがある。
		PRINTFORMW ハンマーとハサミを抽象化したそのシンボルマークは・・・『ウィッチクラフト』
		PRINTFORML 
		PRINTFORMW ・・・
		PRINTFORMW ・・・しかし、どうやってこんな巻物を置いていったのやら。
		PRINTFORMW 自宅のセキュリティにある種の不安を覚えつつも、依頼の場所に向かうことにした。
		
		依頼_場所 = 場所_魔法都市
		依頼_達成状況 ++
		CALL EVENT_TIMER(10)
	ENDIF

ELSEIF 依頼_達成状況 == 1
	;魔法世界。工房へ移動する。
	IF ITEM:千年ドア == 0
		PRINTFORML 
		PRINTFORMW 次元移動のショックは、凄まじいものだった。
		PRINTFORMW まだ世界全体が振動しているような錯覚が抜けず、"召喚酔い"とはこういう感覚なのかと納得していた。
		PRINTFORML 
		PRINTFORMW ・・・
		CLEARLINE 1
		PRINTFORMW ・・・ようやく感覚が戻ってくる。
		PRINTFORMW 狭まっていた視野が戻るにつれて、先ほどまで居た自室とは、まるで違う場所でうずくまっていたのだと、改めて実感が湧いてきた。
		PRINTFORMW 「ふふ……だいぶやられたみたいね。気絶して寝込まないだけ、初心者にしては大したものよ」
		PRINTFORMW ニヤニヤと眺めながら待っていた%CALLNAME:(イベント主:0)%は、まるでダメージを受けてない様子だ。
		PRINTFORML 
		PRINTFORMW 「立てる？　あなたにも杖が必要かしら……なんてね」
		PRINTFORMW 差し伸べてきた手を握り、起こす手伝いをしてもらう。立ち上がると、少しだけ世界が正しく見えてきたように思えてくる。
		PRINTFORML 
		PRINTFORMW ……ここが魔法の世界か。
		PRINTFORMW なんというか、外国の片田舎ぐらいの雰囲気だ。
		PRINTFORMW 見慣れないは見慣れないが、そこまで元の世界とかけ離れた"異世界"には思えない。
		PRINTFORMW 「そりゃあそうよ。交流ができるほどの生き物が棲む世界ってなると、まあだいたいどこも似た形になるものなのよ」
		PRINTFORML 
		PRINTFORMW 街路の脇の木の幹をつつきながら、%CALLNAME:(イベント主:0)%が講釈する。
		PRINTFORMW 大地があり、樹木があり、空気があり、人間が居るとなると、そこまで突飛な世界にはならないのか。
		PRINTFORMW 「それより……ちょーっとだけ座標がズレちゃったみたいね。まあ人が居ない場所って条件で跳んだから仕方ないけど」
		PRINTFORMW 失敗ではない。と言いたげに%CALLNAME:(イベント主:0)%は弁明しながら、辺りを見回している。
		PRINTFORML 
		PRINTFORMW 土地勘がある場所なのかどうか判断しにくい反応だが、いきなり異世界でいきなり迷子というのは勘弁してほしいところだ。
		PRINTFORMW そんな心配を他所に、%CALLNAME:(イベント主:0)%はマイペースに杖をかざして何やら魔術を行使し始めた。
		PRINTFORMW 「……ふーん。なるほどね」
