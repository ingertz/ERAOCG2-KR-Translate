@CARDNAME_59601, 参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ウィッチクラフトゴーレム・フロウライト
	CASE "略称"
		RESULTS = WCG フロウライト
	CASE "カテゴリ"
		RESULTS:0 = ウィッチクラフト
		;RESULTS:1 = シャドール
		RESULTS:2 = ゲームオリジナル
ENDSELECT

@CARD_59601(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 通常モン
	CASE "属性"
		RETURN 闇属性
	CASE "種族"
		RETURN 元素霊族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 0
	CASE "守備力"
		RETURN 2000
	CASE "分割"
		RETURN デュアル
	CASE "性別"
		RETURN 牝性
	;CASE "生産不可"
	;	RETURN 1
	CASE "追加日"
		RETURN 251231
ENDSELECT

RETURN 0

@CARD_EXPLANATION_59601(種類)
#DIM DYNAMIC 種類

PRINTL このカードは通常モンスターである。
CALLFORM CARD_ABLE(1,戦場起動)
PRINTL ①：このカードが表側表示で存在する限り自分メインフェイズ時、自分のデッキの上からカード１枚を墓地へ送り、１度だけ「覚醒」できる。
PRINTL 「覚醒」したこのカードは「シャドール」モンスターとしても扱われる。「覚醒」は１ターンに１度しか行えない。
PRINTL ②：このカードが「覚醒」状態の場合、１ターンに１度、自分メインフェイズに発動できる。
PRINTL 自分の手札・フィールドのモンスターを融合素材にし、レベル８以下の融合モンスター１体を融合召喚する。

;通常モンスターというからにはフレーバーテキストを入れたいという欲望
PRINTL ---------------------------------------------------------------------------------------------------------------
PRINTL 「ウィッチクラフト」の工房が造り出した新モデルの自律人形（ゴーレム）。美しい魔法使いの女性を連想させる整った容姿をしている。
PRINTL 主と認めた人間に従順に仕えるようプログラミングされており、主人の望みのためならば何者も厭わずに使命を全うしようとする献身的な人形。
PRINTL 蛍石の核は一定の波長の光を溜め込む性質を持ち、夜になると微かに淡い紫の光を放射しているらしい……
PRINTL 
PRINTL 

;「シャドール・フュージョン」の融合の力を秘めたゴーレム。人形的な印象がより強く、受け答えもどことなく機械的。
;命令した仕事内容は問題なくこなし、不平不満も（人造ゴーレムなので当たり前だが）無いため、従者ゴーレムとしての性能は及第点といったところ。
;表面上からは見えない課題を発見するべく、ヴェールは自分の侍従として側に置いて動作テストを行っている（という名目で生活のあれこれを怠けてる……）
;普段のゴーレムからは力も魔力も殆ど感じられないため、大した警戒もしていない。そのため、危うく暴走したゴーレムに襲われ、死ぬより恐ろしい目に遭いかける事に……
;シリカとは姉妹機の関係にある。ラピスとラズリーの文脈を踏襲。※マルチとセリオとか、ローゼンメイデンとかのイメージも混ざってるかも。
;鉄の意志と鋼の強さで、シリカを姉（天然ボケ）、フロウライトを妹（実はお姉ちゃんラブ）としている。漫画業界の用語でいう"ズラし"ってやつだね。

;ジェムナイト側をユニオンモンスターにしたので、こちらはデュアルモンスターに設定。通常モンスター扱いを活用して遊ぶ余地がある、おもちゃ寄りのカード性能。
;ガチで組むぶんには、クリエイション初動にするなら侍女ヴェールで光の涙経由で侍女ヴェール＋WCMヴェールでバイスマスター出したり、ゾロア使ったマギストス展開が強い。

;覚醒によって融合効果と「シャドール」カテゴリが追加されるのは、普段は危険性が感じ取れないという設定の表現と、シャドール側での利用をしにくくする調整。
;「ウィッチクラフト」側では魔法使い族ではないものの、元からカテゴリがついてるため光の涙やサボタージュで気軽に呼べるしバイスマスターの素材にもなれる。
;⇒魔法使い族に設定するとWC魔法等々の発動条件を満たせて使い勝手が向上するが、こいつが素でWC魔法を使うのは解釈が違うので、ジェム側と同様に元素霊（岩石）族に。

;Q.シャドールなのにデッキ融合しないのけ？
;A.そもそもデッキ融合はジェムナイトが本家である。ちなみにシリカはデッキからの素材調達は相手依存１体でリクルートを挟む、マイルドなデッキ融合としてデザインされております。


@CARDCAN_59601(決闘者, 種類, ゾーン, 場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 調教対象 = -1

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者, 種類, ゾーン, 場所, 59601)
SIF RESULT == 1
	RETURN 0


IF 種類 == 戦場起動 && GETVAR(@"%決闘者%_MZ_条達:場所") == 0
	SIF 発動済_1(決闘者,覚醒発動)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	RETURN 1
ELSEIF 種類 == 戦場起動 && GETVAR(@"%決闘者%_MZ_条達:場所") == 1
	SIF 効果発動済(決闘者,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL RESETAREA_MAT
	素材範囲戦場 = 1
	素材範囲手札 = 1
	CALL FULLRESET
	効果範囲EXデッキ = 1
	効果条件種類 = 融合
	CALL 効果条件レベル_ADV(8, "以下")
	効果条件召喚可 = 2
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_59601(決闘者, 種類, ゾーン, 場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 戦場起動 && GETVAR(@"%決闘者%_MZ_条達:場所") == 0
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,覚醒発動,1)
	IF RESULT == 0
		CALL CARD_DECK_DISPOSE(決闘者,"デッキ",0,完全墓地行き)
		
		;条達＝覚醒状態の表示で利用
		CALL SET_FIELD_INFO(決闘者,"戦場",場所,"条達",2,1)
		SETVAR @"%決闘者%_MZ_追カテ:場所", "シャドール"
	ENDIF
ELSEIF 種類 == 戦場起動 && GETVAR(@"%決闘者%_MZ_条達:場所") == 1
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,59601,10)
	IF RESULT == 0
		CALL RESETAREA_MAT
		素材範囲戦場 = 1
		素材範囲手札 = 1
		CALL FULLRESET
		効果条件種類 = 融合
		CALL 効果条件レベル_ADV(8, "以下")
		効果条件召喚可 = 2
		CALL CARD_CHOOSE_BASIC(決闘者,"EXデッキ",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			TRYCALLFORM CARDSUMMON_{GETVAR(@"%決闘者%_EXデッキ:{選択カード}")}(決闘者,選択カード)
			CALL FUSSUMMON(決闘者, 選択カード)
		ENDIF
	ENDIF
ENDIF
