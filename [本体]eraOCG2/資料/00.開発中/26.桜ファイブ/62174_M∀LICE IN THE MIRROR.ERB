@CARDNAME_62174,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = M∀LICE IN THE MIRROR
	CASE "略称"
		RESULTS = IN THE MIRROR
	CASE "カテゴリ"
		RESULTS:0 = マリス
ENDSELECT


@CARD_62174(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 速攻魔法
ENDSELECT

RETURN 0

@CARD_EXPLANATION_62174(種類)
#DIM DYNAMIC 種類

PRINTL このカード名の①②の効果はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,魔罠起動,手札起動,フリー誘発)
PRINTL ①：自分の手札・フィールド（表側表示）から「M∀LICE」モンスター１体を除外し、
PRINTL 相手フィールドの表側表示モンスター１体の効果をターン終了時まで無効にする。
CALLFORM CARD_ABLE(2,除外時)
PRINTL ②：このカードが除外された場合に発動できる。
PRINTL 自分の墓地の「M∀LICE」カード１枚を除外し、
PRINTL 除外したカードと同じ種類（モンスター・魔法・罠）の「M∀LICE」カード１枚をデッキから手札に加える。



@CARDCAN_62174(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,62174)
SIF RESULT == 1
	RETURN 0

IF 種類 == 魔罠起動 || 種類 == 手札起動 || 種類 == フリー誘発
	SIF 発動済_1(決闘者,62174)
		RETURN 0
	CALL CARD_QUICK_M(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF GETVAR(@"%決闘者%_除外NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	効果範囲手札 = 1
	効果範囲戦場 = 1
	効果条件カテゴリ = マリス
	効果条件表示 = 10
	効果条件種類 = モン全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	効果範囲相手戦場 = 1
	効果条件表示 = 10
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 除外時
	SIF 発動済_2(決闘者,62174)
		RETURN 0
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件カテゴリ = マリス
	効果条件種類 = モン全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	IF RESULT == 1
		CALL FULLRESET
		効果範囲デッキ = 1
		効果条件カテゴリ = マリス
		効果条件種類 = モン全般
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT == 1
			カウンタ ++
	ENDIF
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件カテゴリ = マリス
	効果条件種類 = 魔法全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	IF RESULT == 1
		CALL FULLRESET
		効果範囲デッキ = 1
		効果条件カテゴリ = マリス
		効果条件種類 = 魔法全般
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT == 1
			カウンタ ++
	ENDIF
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件カテゴリ = マリス
	効果条件種類 = 罠全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	IF RESULT == 1
		CALL FULLRESET
		効果範囲デッキ = 1
		効果条件カテゴリ = マリス
		効果条件種類 = 罠全般
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT == 1
			カウンタ ++
	ENDIF
	SIF カウンタ == 0
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_62174(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIM DYNAMIC 選択カード種類
#DIM DYNAMIC 条件達成モン
#DIM DYNAMIC 条件達成魔
#DIM DYNAMIC 条件達成罠


IF 種類 == 魔罠起動 || 種類 == 手札起動 || 種類 == フリー誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,62174,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(決闘者,ゾーン,場所)
		CALL FULLRESET
		効果範囲手札 = 1
		効果範囲戦場 = 1
		効果条件カテゴリ = マリス
		効果条件表示 = 10
		効果条件種類 = モン全般
		効果条件行先フラグ = 除外行き
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			効果条件表示 = 表側表示
			CALL CARD_REMOVAL_BASIC(決闘者,"戦場単体",場所,"無効")
		ENDIF
	ENDIF
ELSEIF 種類 == 除外時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,62174,2)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲デッキ = 1
		効果条件カテゴリ = マリス
		効果条件種類 = モン全般
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT == 1
			条件達成モン = 1
		CALL FULLRESET
		効果範囲デッキ = 1
		効果条件カテゴリ = マリス
		効果条件種類 = 魔法全般
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT == 1
			条件達成魔 = 1
		CALL FULLRESET
		効果範囲デッキ = 1
		効果条件カテゴリ = マリス
		効果条件種類 = 罠全般
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT == 1
			条件達成罠 = 1

		CALL FULLRESET
		効果範囲墓地 = 1
		効果条件カテゴリ = マリス
		効果条件行先フラグ = 除外行き
		効果条件種類:0 = 99
		IF 条件達成モン == 1
			効果条件種類:0 = モン全般
		ENDIF
		IF 条件達成魔 == 1
			効果条件種類:1 = フィールド
			効果条件種類:2 = 速攻魔法
			効果条件種類:3 = 通常魔法
		ENDIF
		IF 条件達成罠 == 1
			効果条件種類:4 = 通常罠
			効果条件種類:5 = 永続罠
		ENDIF
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			選択カード_ID = RESULT:1
			TRYCALLFORM CARD_{選択カード_ID}("種類")
			選択カード種類 = RESULT
			IF 選択カード種類 < 20
				CALL FULLRESET
				効果範囲デッキ = 1
				効果条件種類 = モン全般
				効果条件カテゴリ = マリス
				CALL CARD_ADD_ADV(決闘者,ゾーン,場所)
			ELSEIF 選択カード種類 >= 20 && 選択カード種類 < 30
				CALL FULLRESET
				効果範囲デッキ = 1
				効果条件種類 = 魔法全般
				効果条件カテゴリ = マリス
				CALL CARD_ADD_ADV(決闘者,ゾーン,場所)
			ELSEIF 選択カード種類 >= 30 && 選択カード種類 < 40
				CALL FULLRESET
				効果範囲デッキ = 1
				効果条件種類 = 罠全般
				効果条件カテゴリ = マリス
				CALL CARD_ADD_ADV(決闘者,ゾーン,場所)
			ENDIF
		ENDIF

	ENDIF
ENDIF
