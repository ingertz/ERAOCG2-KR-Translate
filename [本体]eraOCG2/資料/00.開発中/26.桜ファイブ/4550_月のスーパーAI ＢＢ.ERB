@CARDNAME_4550,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 月のスーパーAI ＢＢ
	CASE "略称"
		RESULTS = ＢＢちゃん
	CASE "カテゴリ"
		RESULTS:0 = サクラファイブ
ENDSELECT


@CARD_4550(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 光属性
	CASE "種族"
		RETURN サイバース族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1000
	CASE "守備力"
		RETURN 1500
	CASE "性別"
		RETURN 牝性
	CASE "追加日"
		RETURN 251120
ENDSELECT
RETURN 0

@CARD_EXPLANATION_4550(種類)
#DIM DYNAMIC 種類

PRINTL このカード名の①③の効果はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,戦場起動)
PRINTL ①：自分メインフェイズに発動できる。
PRINTL EXデッキからサイバース族以外のモンスターを２枚除外し、
PRINTL このカード名以外の「サクラファイブ」カード１枚を手札に加える。
CALLFORM CARD_ABLE(3,除外時)
PRINTL ②：このカードが除外された場合に発動できる。
PRINTL このカードを特殊召喚する。
PRINTL このターン、自分はＬモンスターしかEXデッキから特殊召喚できない。


@CARDSUMMON_AA_4550


@CARDCAN_4550(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,4550)
SIF RESULT == 1
	RETURN 0

IF 種類 == 戦場起動
	SIF 発動済_1(決闘者,4550)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF GETVAR(@"%決闘者%_除外NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	効果範囲手札 = 1
	効果条件カテゴリ = マリス
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 永続効果
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ELSEIF 種類 == 除外時
	SIF 発動済_3(決闘者,4550)
		RETURN 0
	SIF GETVAR(@"ライフ_%決闘者%") <= 300
		RETURN 0
	CALL CARD_SS_CHECK(決闘者,4550,"除外")
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_4550(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID

CALL 対面者判定(決闘者)
対面者 = %RESULTS%


IF 種類 == 戦場起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,4550,1)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲手札 = 1
		効果条件行先フラグ = 除外行き
		効果条件カテゴリ = マリス
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			PRINTL デッキから２枚ドローしますか？
			CALL YN_CHOICE(決闘者)
			IF RESULT == 0
				CALL CARDDRAW_BASIC(決闘者,2)
			ELSE
				PRINTW ドローしませんでした。
			ENDIF
		ENDIF
	ENDIF
ELSEIF 種類 == 永続効果
	CALL FULLRESET
	効果条件カテゴリ = マリス
	効果条件種類 = リンク
	CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"戦除")
ELSEIF 種類 == 除外時
	CALL CARD_CHOICE(決闘者,種類,"除外",場所,4550,3)
	IF RESULT == 0
		CALL LIFE_CHANGE(決闘者,"減少","コスト",300)
		CALL FULLRESET
		効果範囲除外 = 1
		効果条件名前 = M∀LICE＜P＞Cheshire Cat
		CALL CARD_SP_SUMMON_ADV(決闘者,ゾーン,場所)

		EX召喚可能種類 = リンク
		CALL CARD_EX_RESTRICTION(決闘者)
	ENDIF
ENDIF

