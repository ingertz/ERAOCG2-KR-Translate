@CARDNAME_28260,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ファーニマル・ペンギン
	CASE "略称"
		RESULTS = Fur・ペンギン
	CASE "カテゴリ"
		RESULTS:0 = ファーニマル
		RESULTS:1 = ペンギン
ENDSELECT


@CARD_28260(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 水属性
	CASE "種族"
		RETURN 天使族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1600
	CASE "守備力"
		RETURN 1100
ENDSELECT

RETURN 0

@CARD_EXPLANATION_28260(種類)
#DIM DYNAMIC 種類

PRINTL このカード名の②の効果は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(10,戦場起動)
PRINTL ①：このカードがフィールドに表側表示で存在する限り１度だけ、自分 메인 페이즈에 発動できる。
PRINTL 手札から「ファーニマル・ペンギン」以外の「ファーニマル」モンスター１体を特殊召喚する。
PRINTL ②：このカードが融合モンスターの融合召喚の素材となって墓地へ送られた場合に発動できる。
PRINTL 自分はデッキから２枚ドローし、その後手札を１枚選んで捨てる。


@CARDCAN_28260(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,28260)
SIF RESULT == 1
	RETURN 0

IF 種類 == 戦場起動
	SIF 効果発動済(決闘者,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL FULLRESET
	効果範囲手札 = 1
	効果条件固名前 = ファーニマル・ペンギン
	効果条件カテゴリ = ファーニマル
	効果条件召喚可 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ELSEIF 種類 == F素材時効果
	SIF 発動済_2(決闘者,28260)
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_28260(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 種類 == 戦場起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,28260,11)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲手札 = 1
		効果条件固名前 = ファーニマル・ペンギン
		効果条件カテゴリ = ファーニマル
		CALL CARD_SP_SUMMON_ADV(決闘者,ゾーン,場所)
	ENDIF
ELSEIF 種類 == F素材時効果
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,28260,2)
	IF RESULT == 0
		CALL CARDDRAW_BASIC(決闘者,2)
		CALL FULLRESET
		CALL CARD_ADD_GY_BASIC(決闘者,"手札",ゾーン,場所)
	ENDIF
ENDIF

