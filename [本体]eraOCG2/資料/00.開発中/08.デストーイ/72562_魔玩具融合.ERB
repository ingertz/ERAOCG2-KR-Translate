@CARDNAME_72562,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 魔玩具融合
	CASE "略称"
		RESULTS = 魔玩具融合
	CASE "カテゴリ"
		RESULTS:0 = デストーイ
ENDSELECT


@CARD_72562(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 通常魔法
ENDSELECT

RETURN 0

@CARD_EXPLANATION_72562(種類)
#DIM DYNAMIC 種類

PRINTL 「魔玩具融合」は１ターンに１枚しか発動できない。
CALL CARD_ABLE(1,手札起動,魔罠起動)
PRINTL ①：自分のフィールド・墓地から、
PRINTL 「デストーイ」融合モンスターカードによって決められた融合素材モンスターを除外し、
PRINTL その融合モンスター１体をエクストラデッキから融合召喚する。

@CARDCAN_72562(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,72562)
SIF RESULT == 1
	RETURN 0

IF 種類 == 魔罠起動 || 種類 == 手札起動
	SIF 発動済_1(決闘者,72562)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL CARD_EX_CHECK(決闘者,0)
	SIF RESULT == 1
		RETURN 0
	CALL RESETAREA_MAT
	素材範囲戦場 = 1
	素材範囲墓地 = 1
	CALL FULLRESET
	効果範囲EXデッキ = 1
	効果条件カテゴリ = デストーイ
	効果条件種類 = 融合
	効果条件召喚可 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_72562(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 種類 == 魔罠起動 || 種類 == 手札起動
	;カード発動確認
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,72562,1)
	IF RESULT == 0
		;通常魔法汎用処理
		CALL CARD_DISPOSE(決闘者,ゾーン,場所)
		CALL RESETAREA_MAT
		素材範囲戦場 = 1
		素材範囲墓地 = 1
		CALL FULLRESET
		効果条件カテゴリ = デストーイ
		効果条件種類 = 融合
		効果条件召喚可 = 1
		CALL CARD_CHOOSE_BASIC(決闘者,"EXデッキ",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			TRYCALLFORM CARDSUMMON_{選択カード}(決闘者,選択カード)
			CALL FUSSUMMON(決闘者,選択カード,除外行き)
		ENDIF
	ENDIF
ENDIF
