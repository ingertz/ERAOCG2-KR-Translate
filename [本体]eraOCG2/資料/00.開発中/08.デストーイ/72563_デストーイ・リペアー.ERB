@CARDNAME_72563,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = デストーイ・リペアー
	CASE "略称"
		RESULTS = 魔玩具修理
	CASE "カテゴリ"
		RESULTS:0 = デストーイ
ENDSELECT


@CARD_72563(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 通常魔法
ENDSELECT

RETURN 0

@CARD_EXPLANATION_72563(種類)
#DIM DYNAMIC 種類

PRINTL このカード名の①②の効果は１ターンに１度、いずれか１つしか使用できない。
CALL CARD_ABLE(1,手札起動,魔罠起動)
PRINTL ①：自分の墓地の「デストーイ」融合モンスター１体を対象として発動できる。
PRINTL そのモンスターをエクストラデッキに戻す。
PRINTL その後、自分の墓地から「ファーニマル」モンスターまたは「エッジインプ」モンスター１体を選んで特殊召喚できる。
CALL CARD_ABLE(2,墓地起動)
PRINTL ②：墓地のこのカードを除外して発動できる。
PRINTL 手札から「ファーニマル」モンスターまたは「エッジインプ」モンスター１体を特殊召喚する。

@CARDCAN_72563(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,72563)
SIF RESULT == 1
	RETURN 0

IF 種類 == 魔罠起動 || 種類 == 手札起動
	SIF 発動済_1(決闘者,72563) || 発動済_2(決闘者,72563)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件カテゴリ = デストーイ
	効果条件種類 = 融合
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 墓地起動
	SIF 発動済_1(決闘者,72563) || 発動済_2(決闘者,72563)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF GETVAR(@"%決闘者%_除外NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	効果範囲手札 = 1
	効果条件カテゴリ:0 = ファーニマル
	効果条件カテゴリ:1 = エッジインプ
	効果条件種類 = モン全般
	効果条件召喚可 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_72563(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

IF 種類 == 魔罠起動 || 種類 == 手札起動
	;カード発動確認
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,72563,1)
	IF RESULT == 0
		;通常魔法汎用処理
		CALL CARD_DISPOSE(決闘者,ゾーン,場所)
		CALL FULLRESET
		効果範囲墓地 = 1
		効果条件カテゴリ = デストーイ
		効果条件種類 = 融合
		効果条件行先フラグ = EX行き
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			;墓地から特殊召喚できるか確認
			CALL FULLRESET
			効果範囲墓地 = 1
			効果条件カテゴリ:0 = ファーニマル
			効果条件カテゴリ:1 = エッジインプ
			効果条件種類 = モン全般
			効果条件召喚可 = 1
			CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
			IF RESULT == 1
				SIF 決闘者 == "自分"
					PRINTL 墓地からモンスターを特殊召喚しますか？
				CALL YN_CHOICE(決闘者)
				IF RESULT == はい && 決闘者 == "自分"
					CALL FULLRESET
					効果範囲墓地 = 1
					効果条件カテゴリ:0 = ファーニマル
					効果条件カテゴリ:1 = エッジインプ
					効果条件種類 = モン全般
					CALL CARD_SP_SUMMON_ADV(決闘者,ゾーン,場所)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ELSEIF 種類 == 墓地起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,72563,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(決闘者,ゾーン,場所)
		CALL FULLRESET
		効果範囲手札 = 1
		効果条件カテゴリ:0 = ファーニマル
		効果条件カテゴリ:1 = エッジインプ
		効果条件種類 = モン全般
		CALL CARD_SP_SUMMON_ADV(決闘者,ゾーン,場所)
	ENDIF
ENDIF
