@CARDNAME_28265,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ファーニマル・ドルフィン
	CASE "略称"
		RESULTS = Fur・ドルフィン
	CASE "カテゴリ"
		RESULTS:0 = ファーニマル
ENDSELECT


@CARD_28265(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 水属性
	CASE "種族"
		RETURN 天使族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1600
	CASE "守備力"
		RETURN 1000
ENDSELECT
RETURN 0

@CARD_EXPLANATION_28265(種類)
#DIM DYNAMIC 種類

PRINTL このカード名の①②の効果はそれぞれ１ターンに１度しか使用できない。
CALL CARD_ABLE(1,戦場起動)
PRINTL ①：自分の墓地の「トイポット」１枚を対象として発動できる。
PRINTL そのカードを自分フィールドにセットし、
PRINTL デッキから「エッジインプ」モンスター１体または「ファーニマル」モンスター１体を墓地へ送る。
CALL CARD_ABLE(2,F素材時効果)
PRINTL ②：このカードが融合召喚の素材となって墓地へ送られた場合に発動できる。
PRINTL 自分の墓地のカード及び除外されている自分のカードの中から、
PRINTL 「融合」魔法カードまたは「フュージョン」魔法カード１枚を選んでデッキに戻す。

@CARDSUMMON_AA_28265


@CARDCAN_28265(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,28265)
SIF RESULT == 1
	RETURN 0

IF 種類 == 戦場起動
	SIF 発動済_1(決闘者,28265)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF 魔罠数(決闘者) >= 5
		RETURN 0
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件カテゴリ = トイポット
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == F素材時効果
	SIF 発動済_2(決闘者,28265)
		RETURN 0
	CALL FULLRESET
	効果範囲墓地 = 1
	効果範囲除外 = 1
	効果条件名前:0 = 融合
	効果条件名前:1 = フュージョン
	効果条件種類 = 魔法全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_28265(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者判定(決闘者)
対面者 = %RESULTS%


IF 種類 == 戦場起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,28265,1)
	IF RESULT == 0
		CALL FULLRESET
		効果条件カテゴリ = トイポット
		CALL CARD_SET_BASIC(決闘者,"墓地",ゾーン,場所,"裏側表示")
		IF RESULT == 1
			CALL FULLRESET
			効果範囲デッキ = 1
			効果条件カテゴリ:0 = エッジインプ
			効果条件カテゴリ:1 = ファーニマル
			効果条件種類 = モン全般
			CALL CARD_ADD_GY_BASIC(決闘者,"デッキ",ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 種類 == F素材時効果
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,28265,2)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲墓地 = 1
		効果範囲除外 = 1
		効果条件名前:0 = 融合
		効果条件名前:1 = フュージョン
		効果条件種類 = 魔法全般
		効果条件行先フラグ = デッキ行き
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
	ENDIF
ENDIF
