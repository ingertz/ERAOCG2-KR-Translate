@CARDNAME_28250,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = エッジインプ・チェーン
	CASE "略称"
		RESULTS = EI・チェーン
	CASE "カテゴリ"
		RESULTS:0 = エッジインプ
ENDSELECT


@CARD_28250(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 闇属性
	CASE "種族"
		RETURN 悪魔族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1200
	CASE "守備力"
		RETURN 1800
ENDSELECT

RETURN 0

@CARD_EXPLANATION_28250(種類)
#DIM DYNAMIC 種類

PRINTL このカード名の①②の効果はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,攻撃時誘発)
PRINTL ①：このカードの攻撃宣言時に発動できる。
PRINTL デッキから「エッジインプ・チェーン」１体を手札に加える。
CALLFORM CARD_ABLE(2,戦場→墓地 ,手札→墓地 ,破壊→墓地 ,戦闘→墓地)
PRINTL ②：このカードが手札・フィールドから墓地へ送られた場合に発動できる。
PRINTL デッキから「デストーイ」カード１枚を手札に加える。

@CARDCAN_28250(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,28250)
SIF RESULT == 1
	RETURN 0

IF 種類 == 攻撃時誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF 発動済_1(決闘者,28250)
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF 戦闘場所(決闘者) != 場所
		RETURN 0
	CALL FULLRESET
	効果範囲デッキ = 1
	効果条件名前 = エッジインプ・チェーン
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 戦場→墓地 || 種類 == 手札→墓地 || 種類 == 破壊→墓地 || 種類 == 戦闘→墓地
	SIF 発動済_2(決闘者,28250)
		RETURN 0
	CALL FULLRESET
	効果範囲デッキ = 1
	効果条件カテゴリ = デストーイ
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_28250(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 戦闘カード
#DIM DYNAMIC 対戦カード

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 攻撃時誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,28250,1)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲デッキ = 1
		効果条件名前 = エッジインプ・チェーン
		CALL CARD_ADD_ADV(決闘者,ゾーン,場所)
	ENDIF
ELSEIF 種類 == 戦場→墓地 || 種類 == 手札→墓地 || 種類 == 破壊→墓地 || 種類 == 戦闘→墓地
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,28250,2)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲デッキ = 1
		効果条件カテゴリ = デストーイ
		CALL CARD_ADD_ADV(決闘者,ゾーン,場所)
	ENDIF
ENDIF

