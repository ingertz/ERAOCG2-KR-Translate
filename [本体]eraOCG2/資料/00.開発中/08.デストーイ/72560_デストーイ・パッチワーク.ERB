@CARDNAME_72560,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = デストーイ・パッチワーク
	CASE "略称"
		RESULTS = 魔玩具補綴
	CASE "カテゴリ"
		RESULTS:0 = デストーイ
ENDSELECT


@CARD_72560(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 通常魔法
ENDSELECT

RETURN 0

