@CARDNAME_28264,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ファーニマル・ウィング
	CASE "略称"
		RESULTS = Fur・ウィング
	CASE "カテゴリ"
		RESULTS:0 = ファーニマル
ENDSELECT


@CARD_28264(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 光属性
	CASE "種族"
		RETURN 天使族
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 100
	CASE "守備力"
		RETURN 100
ENDSELECT
RETURN 0

@CARD_EXPLANATION_28264(種類)
#DIM DYNAMIC 種類

PRINTL 「ファーニマル・ウィング」の効果は１ターンに１度しか使用できない。
CALL CARD_ABLE(1,墓地起動)
PRINTL ①：自分フィールドに「トイポット」が存在する場合、墓地のこのカードを除外し、
PRINTL 自分の墓地の「ファーニマル」モンスター１体を対象として発動できる。
PRINTL そのモンスターを除外し、自分はデッキから１枚ドローする。
PRINTL 그 후、以下の効果を適用できる。
PRINTL ●自分フィールドの「トイポット」１枚を選んで墓地へ送り、
PRINTL 自分はデッキから１枚ドローする。

@CARDSUMMON_AA_28264


@CARDCAN_28264(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,28264)
SIF RESULT == 1
	RETURN 0

IF 種類 == 墓地起動
	SIF 発動済_1(決闘者,28264)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF GETVAR(@"%決闘者%_除外NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	効果範囲戦場 = 1
	効果範囲魔罠 = 1
	効果条件名前 = トイポット
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件カテゴリ = ファーニマル
	効果条件種類 = モン全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_28264(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者判定(決闘者)
対面者 = %RESULTS%


IF 種類 == 墓地起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,28264,1)
	IF RESULT == 0
		;ファーニマル・ウィング自身を除外
		CALL CARD_DISPOSE(決闘者,ゾーン,場所,除外行き)
		;墓地のファーニマルモンスターを選んで除外
		CALL FULLRESET
		効果範囲墓地 = 1
		効果条件カテゴリ = ファーニマル
		効果条件種類 = モン全般
		CALL CARD_REMOVAL_ADV(決闘者,"単体除去",場所,"除外")
		IF RESULT == 1
			;ドロー
			CALL CARDDRAW_BASIC(決闘者,1)
			SIF 決闘者 == "自分"
				PRINTL 自分フィールドの「トイポット」を墓地へ送り、もう1枚ドローしますか？
			CALL YN_CHOICE(決闘者)
			IF RESULT == はい && 決闘者 == "自分"
				CALL FULLRESET
				効果範囲戦場 = 1
				効果範囲魔罠 = 1
				効果条件カテゴリ = トイポット
				CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
				IF RESULT == 1
					CALL CARDDRAW_BASIC(決闘者,1)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
