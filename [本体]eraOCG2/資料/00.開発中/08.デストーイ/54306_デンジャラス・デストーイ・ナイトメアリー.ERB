@CARDNAME_54306,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = デンジャラス・デストーイ・ナイトメアリー
	CASE "略称"
		RESULTS = DDT・ナイトメア
	CASE "カテゴリ"
		RESULTS:0 = デストーイ
ENDSELECT


@CARD_54306(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 融合
	CASE "属性"
		RETURN 闇属性
	CASE "種族"
		RETURN 悪魔族
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 2000
	CASE "守備力"
		RETURN 3000
	CASE "性別"
		RETURN 雄性
	CASE "追加日"
		RETURN 250829
ENDSELECT

RETURN 0

@CARDSUMMON_54306(決闘者,召喚カード,EX参照)
#DIMS DYNAMIC 決闘者
#DIM DYNAMIC 召喚カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 3
素材条件種類 = トークン以外

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = エッジインプ
ELSEIF EX参照 >= 10
	素材条件カテゴリ = ファーニマル
ENDIF

IF EX参照 == 1
	CALL FUSCAN(決闘者,召喚カード,54306)
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_54306(種類)
#DIM DYNAMIC 種類

PRINTL 「エッジインプ」モンスター＋「ファーニマル」モンスター×２
PRINTL このカード名の②③の効果はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,攻守変動)
PRINTL ①：このカードの攻撃力は自分の墓地・除外の天使族・悪魔族モンスターの数×３００アップする。
CALLFORM CARD_ABLE(0,戦場起動)
PRINTL ②：自分 메인 페이즈에 発動できる。
PRINTL デッキから「デストーイ」「ファーニマル」「エッジインプ」モンスターを合計４体まで墓地へ送る。
CALLFORM CARD_ABLE(0,発動誘発)
PRINTL ③：相手の効果が発動した時、ＥＸデッキから「デストーイ」モンスター１体を除外して発動できる。
PRINTL その効果を無効にし、除外する。


@CARDCAN_54306(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,54306)
SIF RESULT == 1
	RETURN 0

IF 種類 == 攻守変動
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ELSEIF 種類 == 戦場起動
	SIF ゾーン != "戦場"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	;1ターンに1度の制限チェック
	SIF 発動済_2(決闘者,54306)
		RETURN 0
	;デッキに対象カードがあるかチェック
	CALL FULLRESET
	効果範囲デッキ = 1
	効果条件種類 = モン全般
	効果条件カテゴリ:0 = デストーイ
	効果条件カテゴリ:1 = ファーニマル
	効果条件カテゴリ:2 = エッジインプ
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 発動誘発
	SIF ゾーン != "戦場"
		RETURN 0
	;1ターンに1度の制限チェック
	SIF 発動済_3(決闘者,54306)
		RETURN 0
	;EXデッキに「デストーイ」モンスターがあるかチェック
	CALL FULLRESET
	効果範囲EXデッキ = 1
	効果条件カテゴリ = デストーイ
	効果条件種類 = モン全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	;相手の効果発動をチェック（タイラント・ドラゴンと同じ方式）
	CALL FULLRESET
	CALL CARD_CHECK_START_DATA(決闘者,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_54306(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 天使悪魔数
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 破壊レベル

CALL 対面者判定(決闘者)
対面者 = %RESULTS%


IF 種類 == 攻守変動
	;墓地の天使族・悪魔族モンスター数をカウント
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件種族 = 天使族
	効果条件種族:1 = 悪魔族
	効果条件種類 = モン全般
	効果条件CNT = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	天使悪魔数 = RESULT

	;除外ゾーンの天使族・悪魔族モンスター数をカウント
	CALL FULLRESET
	効果範囲除外 = 1
	効果条件種族 = 天使族
	効果条件種族:1 = 悪魔族
	効果条件種類 = モン全般
	効果条件CNT = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	天使悪魔数 += RESULT

	;攻撃力アップを付与
	攻撃力修正 = 天使悪魔数 * 300
	CALL STATCHANGE_BASIC(決闘者,"自身",場所,攻撃力修正)

ELSEIF 種類 == 戦場起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,54306,2)
	IF RESULT == 0
		;デッキから合計4体まで墓地へ送る
		FOR カウンタ, 0, 4
			CALL FULLRESET
			効果範囲デッキ = 1
			効果条件種類 = モン全般
			効果条件カテゴリ:0 = デストーイ
			効果条件カテゴリ:1 = ファーニマル
			効果条件カテゴリ:2 = エッジインプ
			CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
			SIF RESULT != 1
				BREAK
			SIF 決闘者 == "自分"
				PRINTFORML {カウンタ + 1}枚目を墓地へ送りますか？
			CALL YN_CHOICE(決闘者)
			SIF RESULT != はい
				BREAK
			CALL CARD_ADD_GY_BASIC(決闘者,"デッキ",ゾーン,場所)
		NEXT
	ENDIF
ELSEIF 種類 == 発動誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,54306,3)
	IF RESULT == 0
		;EXデッキから「デストーイ」モンスター1体を除外
		CALL FULLRESET
		効果範囲EXデッキ = 1
		効果条件カテゴリ = デストーイ
		効果条件種類 = モン全般
		効果条件行先フラグ = 完全除外行き
		CALL CARD_ADD_GY_BASIC(決闘者,"EXデッキ",ゾーン,場所)
		IF RESULT == 1
			;相手の発動した効果を無効にし、除外する
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(決闘者,"発動無効",場所,"除外")
		ENDIF
	ENDIF
ENDIF
