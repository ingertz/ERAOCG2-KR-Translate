@CARDNAME_54304,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = デストーイ・サーベル・タイガー
	CASE "略称"
		RESULTS = DT・剣虎
	CASE "カテゴリ"
		RESULTS:0 = デストーイ
ENDSELECT


@CARD_54304(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 融合
	CASE "属性"
		RETURN 闇属性
	CASE "種族"
		RETURN 悪魔族
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 2400
	CASE "守備力"
		RETURN 2000
	CASE "性別"
		RETURN 雄性
	CASE "追加日"
		RETURN 250829
ENDSELECT

RETURN 0

@CARDSUMMON_54304(決闘者,召喚カード,EX参照)
#DIMS DYNAMIC 決闘者
#DIM DYNAMIC 召喚カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 99
素材条件数自由 = 1
素材条件素材数起動 = 1
素材条件種類 = トークン以外

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = デストーイ
	素材条件種類 = 融合
ELSEIF EX参照 >= 10
	素材条件カテゴリ:0 = ファーニマル
	素材条件カテゴリ:1 = エッジインプ
ENDIF

IF EX参照 == 1
	CALL FUSCAN(決闘者,召喚カード,54304)
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_54304(種類)
#DIM DYNAMIC 種類

PRINTL 「デストーイ」融合モンスター＋「ファーニマル」モンスターまたは「エッジインプ」モンスター１体以上
CALLFORM CARD_ABLE(0,EX召喚時)
PRINTL ①：このカードが融合召喚に成功した時、
PRINTL 自分の墓地の「デストーイ」モンスター１体を対象として発動できる。
PRINTL そのモンスターを特殊召喚する。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ②：このカードがモンスターゾーンに存在する限り、
PRINTL 自分フィールドの「デストーイ」モンスターの攻撃力は４００アップする。
CALLFORM CARD_ABLE(0,永続効果)
PRINTL ③：モンスター３体以上を素材として融合召喚したこのカードは
PRINTL 戦闘・効果では破壊されない。


@CARDCAN_54304(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,54304)
SIF RESULT == 1
	RETURN 0

IF 種類 == 攻守変動
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ELSEIF 種類 == 永続効果
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ELSEIF 種類 == EX召喚時
	SIF ゾーン != "戦場"
		RETURN 0
	;墓地に「デストーイ」モンスターがあるかチェック
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件種類 = モン全般
	効果条件カテゴリ:0 = デストーイ
	効果条件召喚可 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_54304(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 素材数

CALL 対面者判定(決闘者)
対面者 = %RESULTS%


IF 種類 == 攻守変動
	;「デストーイ」モンスター全体に攻撃力400アップを付与
	CALL FULLRESET
	効果条件カテゴリ = デストーイ
	CALL STATCHANGE_BASIC(決闘者,"戦場",場所,400)

ELSEIF 種類 == 永続効果
	;素材数が3体以上なら破壊耐性を付与
	素材数 = GETVAR(@"%決闘者%_MZ_汎数:場所")
	IF 素材数 >= 3
		CALL SET_FIELD_INFO(決闘者,"戦場",場所,"破壊耐性",1,2)
	ENDIF

ELSEIF 種類 == EX召喚時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,54304,1)
	IF RESULT == 0
		;墓地の「デストーイ」モンスターを特殊召喚
		CALL FULLRESET
		効果範囲墓地 = 1
		効果条件種類 = モン全般
		効果条件カテゴリ:0 = デストーイ
		CALL CARD_SP_SUMMON_ADV(決闘者,ゾーン,場所)
	ENDIF
ENDIF
