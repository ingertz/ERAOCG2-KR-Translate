@CARDNAME_54303,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = デストーイ・シザー・タイガー
	CASE "略称"
		RESULTS = DT・鋏虎
	CASE "カテゴリ"
		RESULTS:0 = デストーイ
ENDSELECT


@CARD_54303(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 融合
	CASE "属性"
		RETURN 闇属性
	CASE "種族"
		RETURN 悪魔族
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 1900
	CASE "守備力"
		RETURN 1200
	CASE "性別"
		RETURN 雄性
	CASE "追加日"
		RETURN 250829
ENDSELECT

RETURN 0

@CARDSUMMON_54303(決闘者,召喚カード,EX参照)
#DIMS DYNAMIC 決闘者
#DIM DYNAMIC 召喚カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 99
素材条件数自由 = 1
素材条件素材数起動 = 1
素材条件種類 = トークン以外

IF EX参照 == 0 || EX参照 == 1
	素材条件名前 = エッジインプ・シザー
ELSEIF EX参照 >= 10
	素材条件カテゴリ = ファーニマル
ENDIF

IF EX参照 == 1
	CALL FUSCAN(決闘者,召喚カード,54303)
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_54303(種類)
#DIM DYNAMIC 種類

PRINTL 「エッジインプ・シザー」＋「ファーニマル」モンスター１体以上
CALLFORM CARD_ABLE(0,EX召喚時)
PRINTL ①：「デストーイ・シザー・タイガー」は自分フィールドに１体しか表側表示で存在できない。
PRINTL ②：このカードが融合召喚に成功した時、発動できる。
PRINTL このカードの融合素材としたモンスターの数まで、フィールドのカードを破壊する。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ③：このカードがモンスターゾーンに存在する限り、自分フィールドの「デストーイ」モンスターの攻撃力は、自分フィールドの「ファーニマル」モンスター及び「デストーイ」モンスターの数×３００アップする。


@CARDCAN_54303(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 素材数

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,54303)
SIF RESULT == 1
	RETURN 0

IF 種類 == 攻守変動
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ELSEIF 種類 == EX召喚時
	RETURN 1
ENDIF

@CARDEFFECT_54303(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 素材数
#DIM DYNAMIC ファーニマル数
#DIM DYNAMIC デストーイ数
#DIM DYNAMIC 攻撃力修正

CALL 対面者判定(決闘者)
対面者 = %RESULTS%


IF 種類 == 攻守変動
	;フィールドの「ファーニマル」の数をカウント
	CALL FULLRESET
	効果範囲戦場 = 1
	効果条件カテゴリ = ファーニマル
	効果条件種類 = モン全般
	効果条件CNT = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	ファーニマル数 = RESULT

	;フィールドの「デストーイ」の数をカウント
	CALL FULLRESET
	効果範囲戦場 = 1
	効果条件カテゴリ = デストーイ
	効果条件種類 = モン全般
	効果条件CNT = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	デストーイ数 = RESULT

	;「デストーイ」モンスター全体に攻撃力アップを付与
	CALL FULLRESET
	効果条件カテゴリ = デストーイ
	攻撃力修正 = (ファーニマル数 + デストーイ数) * 300
	CALL STATCHANGE_BASIC(決闘者,"戦場",場所,攻撃力修正)

ELSEIF 種類 == EX召喚時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,54303)
	IF RESULT == 0
		素材数 = GETVAR(@"%決闘者%_MZ_汎数:場所")
		CALL FULLRESET
		効果条件複数 = 100 - 素材数
		CALL CARD_REMOVAL_BASIC(決闘者,"両全場単体",場所,"墓地")
	ENDIF
ENDIF
