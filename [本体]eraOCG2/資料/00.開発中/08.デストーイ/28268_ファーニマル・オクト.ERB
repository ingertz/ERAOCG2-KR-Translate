@CARDNAME_28268,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ファーニマル・オクト
	CASE "略称"
		RESULTS = Fur・オクト
	CASE "カテゴリ"
		RESULTS:0 = ファーニマル
ENDSELECT


@CARD_28268(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 水属性
	CASE "種族"
		RETURN 天使族
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 800
	CASE "守備力"
		RETURN 800
ENDSELECT
RETURN 0

@CARD_EXPLANATION_28268(種類)
#DIM DYNAMIC 種類

PRINTL 「ファーニマル・オクト」の①②の効果はそれぞれ１ターンに１度しか使用できない。
CALL CARD_ABLE(1,召喚時 ,特殊召喚時)
PRINTL ①：このカードが召喚・特殊召喚に成功した時、
PRINTL 自分の墓地の、「ファーニマル」モンスターまたは
PRINTL 「エッジインプ」モンスター１体を対象として発動できる。
PRINTL そのモンスターを手札に加える。
CALL CARD_ABLE(2,F素材時効果)
PRINTL ②：このカードが「デストーイ」融合モンスターの融合召喚の素材となって墓地へ送られた場合、
PRINTL 除外されている自分のモンスターを２体まで対象として発動できる。
PRINTL そのモンスターを墓地に戻す。

@CARDSUMMON_AA_28268


@CARDCAN_28268(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,28268)
SIF RESULT == 1
	RETURN 0

IF 種類 == 召喚時 || 種類 == 特殊召喚時
	SIF 発動済_1(決闘者,28268)
		RETURN 0
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件カテゴリ:0 = ファーニマル
	効果条件カテゴリ:1 = エッジインプ
	効果条件種類 = モン全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == F素材時効果
	SIF 発動済_2(決闘者,28268)
		RETURN 0
	CALL FULLRESET
	効果範囲除外 = 1
	効果条件種類 = モン全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_28268(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

CALL 対面者判定(決闘者)
対面者 = %RESULTS%


IF 種類 == 召喚時 || 種類 == 特殊召喚時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,28268,1)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲墓地 = 1
		効果条件カテゴリ:0 = ファーニマル
		効果条件カテゴリ:1 = エッジインプ
		効果条件種類 = モン全般
		CALL CARD_ADD_BASIC(決闘者,"墓地",ゾーン,場所)
	ENDIF
ELSEIF 種類 == F素材時効果
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,28268,2)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲除外 = 1
		効果条件種類 = モン全般
		効果条件任意 = 1
		効果条件複数 = 2
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
	ENDIF
ENDIF

