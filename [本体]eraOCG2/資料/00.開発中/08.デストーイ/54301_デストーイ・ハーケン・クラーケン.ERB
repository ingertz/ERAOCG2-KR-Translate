@CARDNAME_54301,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = デストーイ・ハーケン・クラーケン
	CASE "略称"
		RESULTS = DT・鉤鎖蛸
	CASE "カテゴリ"
		RESULTS:0 = デストーイ
ENDSELECT


@CARD_54301(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 融合
	CASE "属性"
		RETURN 水属性
	CASE "種族"
		RETURN 悪魔族
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 2200
	CASE "守備力"
		RETURN 3000
	CASE "性別"
		RETURN 雄性
	CASE "追加日"
		RETURN 250829
ENDSELECT

RETURN 0

@CARDSUMMON_54301(決闘者,召喚カード,EX参照)
#DIMS DYNAMIC 決闘者
#DIM DYNAMIC 召喚カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2
素材条件種類 = トークン以外

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = エッジインプ
ELSEIF EX参照 >= 10
	素材条件カテゴリ = ファーニマル
ENDIF

IF EX参照 == 1
	CALL FUSCAN(決闘者,召喚カード,54301)
	RETURN RESULT
ENDIF

@CARD_EXPLANATION_54301(種類)
#DIM DYNAMIC 種類

PRINTL 「エッジインプ」モンスター＋「ファーニマル」モンスター
CALLFORM CARD_ABLE(0,戦場起動)
PRINTL ①：１ターンに１度、相手フィールドのモンスター１体を対象として発動できる。
PRINTL そのモンスターを墓地へ送る。
PRINTL この効果を発動するターン、このカードは直接攻撃できない。
CALLFORM CARD_ABLE(0,永続効果)
PRINTL ②：このカードは１度のバトルフェイズ中に２回攻撃できる。
PRINTL ③：このカードが戦闘を行ったバトルフェイズ終了時に発動できる。
PRINTL このカードを守備表示にする。


@CARDCAN_54301(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,54301)
SIF RESULT == 1
	RETURN 0

IF 種類 == 永続効果
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ELSEIF 種類 == 戦場起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF 発動済_1(決闘者,54301)
		RETURN 0
	SIF ゾーン != "戦場"
		RETURN 0
	;相手フィールドにモンスターがいるかチェック
	SIF モンスター数(対面者) <= 0
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_54301(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIMS DYNAMIC 対面者

CALL 対面者判定(決闘者)
対面者 = %RESULTS%


IF 種類 == 永続効果
	;２回攻撃（追加で1回）
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"追戦",1)
	;戦闘後守備表示変更（バトルフェイズ終了時処理は別途実装が必要）
ELSEIF 種類 == 戦場起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,54301,1)
	IF RESULT == 0
		;相手モンスター１体を墓地へ送る
		CALL FULLRESET
		効果範囲相手戦場 = 1
		CALL CARD_REMOVAL_ADV(決闘者,"単体除去",場所,"墓地")
		IF RESULT == 1
			;直接攻撃不可
			CALL SET_FIELD_INFO(決闘者,"戦場",場所,"直接攻撃不可",1)
		ENDIF
	ENDIF
ENDIF
