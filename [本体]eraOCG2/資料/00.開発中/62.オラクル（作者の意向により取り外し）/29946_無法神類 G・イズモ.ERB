@CARDNAME_29946,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 無法神類 G・イズモ
	CASE "略称"
		RESULTS = G・イズモ
	CASE "カテゴリ"
		RESULTS:0 = オラクル
		RESULTS:1 = ゴッド
		RESULTS:2 = ゴッド・ノヴァ
		RESULTS:4 = DUEL MASTERS
ENDSELECT


@CARD_29946(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "種類"
		RETURN リンク
	CASE "属性"
		RETURN 光属性
	CASE "種族"
		RETURN 天使族
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 3500
	CASE "守備力"
		RETURN 3000
	CASE "性別"
		RETURN 雄性
	CASE "特殊制限"
		RETURN 1
	CASE "レア度"
		RETURN ULR
ENDSELECT

RETURN 0

@CARDSUMMON_29946(決闘者,召喚カード,EX参照)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 召喚カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件達成
;素材条件

CALL RESETCONDITION_MAT
必要リンク数 = 3
素材条件カテゴリ = ゴッド・ノヴァ
素材条件固名前起動 = 1

CALL FULLRESET
効果範囲墓地 = 1
効果範囲除外 = 1
効果条件名前 = 神人類 ヨミ－ゴッドリンク－
CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
SIF RESULT != 1
	素材条件固名前 = イズモ


IF EX参照 == 0 || EX参照 == 1
	素材条件名前 = イズモ
ENDIF

IF EX参照 == 1
	CALL LINCAN(決闘者,召喚カード,29946) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_29946(種類)
#DIM DYNAMIC 種類

PRINTL 「イズモ」を含むカード名が異なる「ゴッド・ノヴァ」モンスター２体以上
PRINTL 自分は「無法神類 G・イズモ」を１ターンに１度しか特殊召喚できず。
PRINTL 自分の墓地・除外状態に「神人類 ヨミ－ゴッドリンク－」が存在しない場合、このカードはL召喚できない。
CALLFORM CARD_ABLE(0,EX召喚時強制,特殊召喚時強制)
PRINTL このカードはX素材を持つことができ、X素材を２つ持った状態で特殊召喚される。
PRINTL このカードがモンスターゾーンを離れる場合、かわりにX素材を１つ取り除くことができる。
CALLFORM CARD_ABLE(0,永続効果)
PRINTL ①：このカードは１度のバトルフェイズ中に３回攻撃できる。
CALLFORM CARD_ABLE(0,永続効果)
PRINTL ②：相手は通常ではない魔法・罠を発動できない。
PRINTL このカードが持っているX素材の数が２つ以上の場合、
PRINTL このカードは完全耐性を持ち、相手は魔法・罠を発動できない。


@CARDCAN_29946(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,29946)
SIF RESULT == 1
	RETURN 0

IF 種類 == 永続効果
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ELSEIF 種類 == EX召喚時強制 || 種類 == 特殊召喚時強制
	RETURN 1
ELSEIF 種類 == 身代効果
	SIF ゾーン != "戦場"
		RETURN 0
	SIF 破壊対象ゾーン != "戦場"
		RETURN 0
	SIF 破壊対象場所 != 場所
		RETURN 0
	SIF GETVAR(@"%決闘者%_MZ_Ｘ:場所") <= -1
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_29946(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正

IF 種類 == 永続効果
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"追戦",2)
	CALL SET_PLAYER_INFO(決闘者,"逆通常無効",3,1)
	SIF GETVAR(@"%決闘者%_MZ_Ｘ:場所") <= 0
		RETURN 0
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"モ耐")
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"魔耐")
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"罠耐")
	CALL SET_PLAYER_INFO(決闘者,"魔罠無効",3,1)
ELSEIF 種類 == EX召喚時強制 || 種類 == 特殊召喚時強制
	CALL SET_FIELD_INFO(決闘者,"戦場",場所,"Ｘ",2)
ELSEIF 種類 == 身代効果
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,29946,0,X消費1)
	IF RESULT == 0
		RETURN 1
	ENDIF
	RETURN 0
ENDIF
