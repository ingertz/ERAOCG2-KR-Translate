@CARDCAN_29949(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,29949)
SIF RESULT == 1
	RETURN 0

IF 種類 == 手札起動 || 種類 == 戦場起動
	SIF 発動済_1(決闘者,29949)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL FULLRESET
	効果範囲手札 = 1
	効果範囲戦場 = 1
	効果条件他所 = 1
	効果条件カテゴリ:0 = オラクル
	効果条件カテゴリ:1 = ゴッド・ノヴァ
	効果条件CNT = 1	
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0
	RETURN 1
ELSEIF 種類 == 特殊召喚時
	SIF 発動済_2(決闘者,29949)
		RETURN 0
	CALL FULLRESET
	効果範囲戦場 = 1
	効果条件カテゴリ:0 = オラクル
	効果条件カテゴリ:1 = ゴッド・ノヴァ
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	効果範囲デッキ = 1
	効果条件CNT = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT < 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == マキシマム条件
	SIF GETVAR(@"%決闘者%_戦場:2") != 29949
		RETURN 0
	TRYCALLFORM CARDNAME_{GETVAR(@"%決闘者%_戦場:1")}("カテゴリ")
	SIF !MATCH(RESULTS,"左G・リンク")
		RETURN 0
	TRYCALLFORM CARDNAME_{GETVAR(@"%決闘者%_戦場:3")}("カテゴリ")
	SIF !MATCH(RESULTS,"右G・リンク")
		RETURN 0
	RETURN 1
ELSEIF 種類 == 永続効果
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_29949(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC めくり数

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 手札起動 || 種類 == 戦場起動
	効果無効不能 = 1
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,29949,1)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲手札 = 1
		効果範囲戦場 = 1
		効果条件他所 = 1
		効果条件カテゴリ:0 = オラクル
		効果条件カテゴリ:1 = ゴッド・ノヴァ
		効果条件複数 = 2
		効果条件行先フラグ = 消滅行き
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			CALL CARD_DISPOSE(決闘者,ゾーン,場所,消滅行き)
			FOR カウンタ,0,5
				SIF GETVAR(@"%決闘者%_戦場:カウンタ") == -1
					CONTINUE
				CALL CARD_DISPOSE(決闘者,"戦場",カウンタ)
			NEXT
			CALL FULLRESET
			CALL CARD_GENERATE(決闘者,29949,"攻撃表示")
			IF 決闘者 == "自分"
				PRINTL どのモンスターを特殊召喚しますか？
				PRINTL
				PRINTL [0] - 封魔左神リバティーンズ
				PRINTL [1] - 妖精左神パールジャム
				PRINTL [2] - 聖霊左神ジャスティス
				BINPUT
			ELSE
				RESULT = RAND:3
			ENDIF

			IF RESULT == 0
				CALL FULLRESET
				CALL CARD_GENERATE(決闘者,129948,"守備表示")
			ELSEIF RESULT == 1
				CALL FULLRESET
				CALL CARD_GENERATE(決闘者,229945,"守備表示")
			ELSEIF RESULT == 2
				CALL FULLRESET
				CALL CARD_GENERATE(決闘者,229948,"守備表示")
			ENDIF

			IF 決闘者 == "自分"
				PRINTL どのモンスターを特殊召喚しますか？
				PRINTL
				PRINTL [0] - 爆裂右神ストロークス
				PRINTL [1] - 戦攻右神マッシヴ・アタック
				PRINTL [2] - 悪魔右神ダフトパンク
				BINPUT
			ELSE
				RESULT = RAND:3
			ENDIF

			IF RESULT == 0
				CALL FULLRESET
				CALL CARD_GENERATE(決闘者,129950,"守備表示")
			ELSEIF RESULT == 1
				CALL FULLRESET
				CALL CARD_GENERATE(決闘者,229947,"守備表示")
			ELSEIF RESULT == 2
				CALL FULLRESET
				CALL CARD_GENERATE(決闘者,229950,"守備表示")
			ENDIF
		ENDIF
	ENDIF
ELSEIF 種類 == 特殊召喚時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,29949,2)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲戦場 = 1
		効果条件カテゴリ:0 = オラクル
		効果条件カテゴリ:1 = ゴッド・ノヴァ
		効果条件固名前起動 = 1;CARDCHECK_ADV専用
		効果条件CNT = 1
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		めくり数 = RESULT

		CALL FULLRESET
		CALL CARD_ADD_BASIC(決闘者,"デッキ",ゾーン,場所,めくり数)
	ENDIF
ELSEIF 種類 == 永続効果
	CALL FULLRESET
	効果条件カテゴリ:0 = オラクル
	効果条件カテゴリ:1 = ゴッド・ノヴァ
	効果条件他所 = 1
	CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"対耐")
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"攻誘")
ELSEIF 種類 == マキシマム条件
	CALL SET_PLAYER_INFO(決闘者,"効果ダメージ無効",3)
ENDIF




