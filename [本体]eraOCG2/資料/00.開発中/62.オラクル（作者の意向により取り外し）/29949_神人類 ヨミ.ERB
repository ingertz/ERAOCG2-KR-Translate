@CARDNAME_229950,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 悪魔右神ダフトパンク
	CASE "略称"
		RESULTS = ダフトパンク
	CASE "カテゴリ"
		RESULTS:0 = コマンド
		RESULTS:1 = ゴッド・ノヴァ
	CASE "出典作品"
		RESULTS:0 = DUEL MASTERS
		RESULTS:5 = ゴッド
		RESULTS:6 = 右G・リンク
	CASE "マキシマム"
		RESULTS = 右G・リンク
ENDSELECT


@CARD_229950(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 闇属性
	CASE "種族"
		RETURN 悪魔族
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 1000
	CASE "守備力"
		RETURN 1500
	CASE "パーツ"
		RETURN 1
ENDSELECT
RETURN 0

@CARD_EXPLANATION_229950(種類)
#DIM DYNAMIC 種類

PRINTL （マキシマム状態のこのカードは攻撃できない）
PRINTL このカード名の①の効果は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,特殊召喚時)
PRINTL ①：このカードが特殊召喚した場合に発動できる。
PRINTL 自分の墓地のレベル６以下のモンスター１体を特殊召喚する。
PRINTL 

@CARDCAN_229950(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,229950)
SIF RESULT == 1
	RETURN 0

IF 種類 == 攻守変動 || 種類 == 永続効果
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ELSEIF 種類 == 特殊召喚時
	SIF 発動済_1(決闘者,229950)
		RETURN 0
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件種類 = レベル持ち
	CALL 効果条件レベル_ADV(6, "以下")
	効果条件召喚可 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == マキシマム条件
	SIF GETVAR(@"%決闘者%_戦場:3") != 229950
		RETURN 0
	TRYCALLFORM CARDNAME_{GETVAR(@"%決闘者%_戦場:1")}("カテゴリ")
	SIF !MATCH(RESULTS,"左G・リンク")
		RETURN 0
	TRYCALLFORM CARDNAME_{GETVAR(@"%決闘者%_戦場:2")}("カテゴリ")
	SIF !MATCH(RESULTS,"中央G・リンク")
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_229950(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者判定(決闘者)
対面者 = %RESULTS%


IF 種類 == 特殊召喚時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,229950,1)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲墓地 = 1
		効果条件種類 = レベル持ち
		CALL 効果条件レベル_ADV(6, "以下")
		CALL CARD_SP_SUMMON_ADV(決闘者,場所)
	ENDIF
ELSEIF 種類 == マキシマム条件
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"戦無")
ENDIF


