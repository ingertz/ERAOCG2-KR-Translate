#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 特殊召喚時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,229948,1)
	IF RESULT == 0
		CALL FULLRESET
		効果条件種類 = 魔罠全般
		効果条件山切り無し = 1
		効果条件任意 = 1
		CALL CARD_ADD_BASIC(決闘者,"デッキ",ゾーン,場所,5)
		IF RESULT == 1
			CALL CARD_DECK_DISPOSE(決闘者,"デッキ",4)
		ELSE
			CALL CARD_DECK_DISPOSE(決闘者,"デッキ",5)	
		ENDIF
	ENDIF
ELSEIF 種類 == マキシマム条件
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"戦無")
ENDIF


