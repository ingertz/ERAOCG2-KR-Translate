@CARDNAME_75032,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ゴッド・ゲート
	CASE "略称"
		RESULTS = 神門
	CASE "カテゴリ"
		RESULTS:0 = ゴッド
	CASE "出典作品"
		RESULTS:0 = DUEL MASTERS
ENDSELECT


@CARD_75032(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "種類"
		RETURN 通常罠
ENDSELECT

RETURN 0

@CARD_EXPLANATION_75032(種類)
#DIM DYNAMIC 種類
PRINTL このカード名の①の効果は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,魔罠起動 ,フリー誘発)
PRINTL ①：自分のデッキの上からカードを５枚めくる。
PRINTL その中からレベル９以下の「ゴッド」モンスター１体を特殊召喚できる。
PRINTL 残りのカードはデッキに戻す。
PRINTL その後、手札から「ゴッド」モンスター１体を特殊召喚できる。
PRINTL この効果は自分が直接攻撃を受けた場合に手札からも発動できる。

@CARDCAN_75032(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,75032)
SIF RESULT == 1
	RETURN 0

IF 種類 == 魔罠起動 || 種類 == フリー誘発
	SIF 発動済_1(決闘者,75032)
		RETURN 0
	IF ゾーン == "魔罠"
		CALL CARD_SET_ACT(決闘者,種類,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
	ELSE
		RETURN 0
	ENDIF
	RETURN 1
ELSEIF 種類 == 効果後誘発
	SIF 発動済_1(決闘者,75032)
		RETURN 0
	SIF ゾーン != "手札"
		RETURN 0
	CALL CARD_CHECK_FIN_BIT(決闘者,"被弾種",2)
	SIF RESULT != 1
		RETURN 0
	SIF ターンプレイヤー == 決闘者
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_75032(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カード

IF 種類 == 魔罠起動 || 種類 == フリー誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,75032,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(決闘者,ゾーン,場所)
		CALL FULLRESET
		効果範囲デッキ = 1
		CALL 効果条件レベル_ADV(9, "以下")
		効果条件カテゴリ = ゴッド
		効果条件任意 = 1
		CALL CARD_SP_SUMMON_ADV(決闘者,ゾーン,場所,,5)
		IF RESULT == 1
			CALL FULLRESET
			効果範囲手札 = 1
			効果条件カテゴリ = ゴッド
			効果条件任意 = 1
			CALL CARD_SP_SUMMON_ADV(決闘者,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 種類 == 効果後誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,75032,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(決闘者,ゾーン,場所)
		CALL FULLRESET
		効果範囲デッキ = 1
		CALL 効果条件レベル_ADV(9, "以下")
		効果条件カテゴリ = ゴッド
		効果条件任意 = 1
		CALL CARD_SP_SUMMON_ADV(決闘者,ゾーン,場所,,5)
		IF RESULT == 1
			CALL FULLRESET
			効果範囲手札 = 1
			効果条件カテゴリ = ゴッド
			効果条件任意 = 1
			CALL CARD_SP_SUMMON_ADV(決闘者,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF
