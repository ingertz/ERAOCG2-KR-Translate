CALLFORM CARD_ABLE(1,手札起動,戦場起動)
PRINTL ①：【G・MAXIMUM！！】「オラクル」モンスターまたは「ゴッド・ノヴァ」モンスター×２
PRINTL 手札・フィールドに存在するほかの「オラクル」モンスターまたは「ゴッド・ノヴァ」モンスター２枚を書き換え、マキシマム召喚を行う。
PRINTL マキシマム召喚は無効化されない。


@CARDCAN_29946(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,29946)
SIF RESULT == 1
	RETURN 0

IF 種類 == 手札起動 || 種類 == 戦場起動
	SIF 発動済_1(決闘者,29946)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL FULLRESET
	効果範囲手札 = 1
	効果範囲戦場 = 1
	効果条件他所 = 1
	効果条件カテゴリ:0 = オラクル
	効果条件カテゴリ:1 = ゴッド・ノヴァ
	効果条件CNT = 1	
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT < 2
		RETURN 0
	RETURN 1
ELSEIF 種類 == マキシマム条件
	SIF GETVAR(@"%決闘者%_戦場:2") != 29946
		RETURN 0
	TRYCALLFORM CARDNAME_{GETVAR(@"%決闘者%_戦場:1")}("カテゴリ")
	SIF !MATCH(RESULTS,"左G・リンク")
		RETURN 0
	TRYCALLFORM CARDNAME_{GETVAR(@"%決闘者%_戦場:3")}("カテゴリ")
	SIF !MATCH(RESULTS,"右G・リンク")
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_29946(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者 
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC めくり数

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 手札起動 || 種類 == 戦場起動
	効果無効不能 = 1
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,29946,1)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲手札 = 1
		効果範囲戦場 = 1
		効果条件他所 = 1
		効果条件カテゴリ:0 = オラクル
		効果条件カテゴリ:1 = ゴッド・ノヴァ
		効果条件複数 = 2
		効果条件行先フラグ = 消滅行き
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			CALL CARD_DISPOSE(決闘者,ゾーン,場所,消滅行き)
			FOR カウンタ,0,5
				SIF GETVAR(@"%決闘者%_戦場:カウンタ") == -1
					CONTINUE
				CALL CARD_DISPOSE(決闘者,"戦場",カウンタ)
			NEXT
			CALL FULLRESET
			CALL CARD_GENERATE(決闘者,29946,"攻撃表示")
			IF 決闘者 == "自分"
				PRINTL どのモンスターを特殊召喚しますか？
				PRINTL
				PRINTL [0] - 双魔左神ディーヴォ
				PRINTL [1] - 妖精左神パールジャム
				BINPUT
			ELSE
				RESULT = RAND:2
			ENDIF

			IF RESULT == 0
				CALL FULLRESET
				CALL CARD_GENERATE(決闘者,129945,"守備表示")
			ELSEIF RESULT == 1
				CALL FULLRESET
				CALL CARD_GENERATE(決闘者,229945,"守備表示")
			ENDIF

			IF 決闘者 == "自分"
				PRINTL どのモンスターを特殊召喚しますか？
				PRINTL
				PRINTL [0] - 双天右神クラフト・ヴェルク
				PRINTL [1] - 戦攻右神マッシヴ・アタック
				BINPUT
			ELSE
				RESULT = RAND:2
			ENDIF

			IF RESULT == 0
				CALL FULLRESET
				CALL CARD_GENERATE(決闘者,129947,"守備表示")
			ELSEIF RESULT == 1
				CALL FULLRESET
				CALL CARD_GENERATE(決闘者,229947,"守備表示")
			ENDIF
		ENDIF
	ENDIF
ENDIF




