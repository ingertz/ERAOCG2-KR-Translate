#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者判定(決闘者)
対面者 = %RESULTS%


IF 種類 == 特殊召喚時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,229947,1)
	IF RESULT == 0
		CALL CARDDRAW_BASIC(決闘者,1)
	ENDIF
ELSEIF 種類 == マキシマム条件
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"戦無")
ENDIF

