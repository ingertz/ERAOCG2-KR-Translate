@CARDNAME_12046,参照先
;ココで指定卡片の名称、简称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ウィッチコスプレイヤー・魔法少女シュミッタ
	CASE "略称"
		RESULTS = cosシュミッタ
	CASE "カテゴリ"
		RESULTS:0 = ウィッチクラフト
		RESULTS:1 = ウィッチコスプレイヤー
        RESULTS:2 = E.R.A
ENDSELECT


@CARD_12046(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 炎属性
	CASE "種族"
		RETURN 魔法使い族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1600
	CASE "守備力"
		RETURN 600
	CASE "性別"
		RETURN 牝性
	CASE "連動ID"
		RETURN 2046
ENDSELECT

RETURN 0

@CARD_EXPLANATION_12046(種類)
#DIM DYNAMIC 種類

PRINTL このカード名の①②の効果はそれぞれ１ターンに１度しかできない。
CALLFORM CARD_ABLE(1,手札起動)
PRINTL ①：自己回合才能发动
PRINTL 手札から「ウィッチクラフト」カード１枚を墓地へ送り、このカードを手札から特殊召喚する。
PRINTL この効果の発動後、ターン終了時まで魔法使い族モンスターしか特殊召喚できない。
CALLFORM CARD_ABLE(2,戦場起動)
PRINTL ②：自分のデッキの上から３枚のカードを確認する。
PRINTL その中に「ウィッチクラフト」カードが存在する場合、その内の１枚を手札に加える事ができる。
PRINTL このカードのレベルを３つ上げるか下げる。
PRINTL その後、魔法使い族モンスターを１体選択する。
PRINTL 自分フィールドの全ての魔法使い族モンスターのレベルはターン終了時まで対象のモンスターと同じレベルになる。

CALLFORM CARD_ABLE(0,墓地起動)
PRINTL ③：このカードが墓地に存在する場合に発動できる。
PRINTL ５００LPを払い、このカードをエクストラデッキに戻す。

@CARDCAN_12046(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 効果制限達成
#DIM DYNAMIC カウンタ

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,12046)
SIF RESULT == 1
	RETURN 0
IF 種類 == 手札起動
	SIF 発動済_1(決闘者,12406)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF モンスター数(決闘者) >= 5
		RETURN 0
	CALL FULLRESET
	効果範囲手札 = 1
	効果条件他所 = 1
	効果条件カテゴリ = ウィッチクラフト
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_SS_CHECK(決闘者,12046,ゾーン)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 戦場起動
	SIF 発動済_2(決闘者,12046)
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ELSEIF 種類 == 墓地起動
	SIF RESULT == 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF ゾーン != "墓地"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_12046(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 調教対象 = -1
#DIMS DYNAMIC 調教対象名
#DIM DYNAMIC 回復量
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 設定レベル 

IF 種類 == 手札起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,12046,1)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲手札 = 1
		効果条件他所 = 1
		効果条件カテゴリ = ウィッチクラフト
		CALL CARD_ADD_GY_BASIC(決闘者,"手札",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_SP_SUMMON(決闘者,ゾーン,場所)
		ENDIF
	ENDIF
	SS召喚可能種族 = 魔法使い族
	CALL CARD_SS_RESTRICTION(決闘者)
ELSEIF 種類 == 戦場起動
	;卡片发动＆設置まで
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,12046,2)
	IF RESULT == 0
		CALL FULLRESET
		効果条件カテゴリ = ウィッチクラフト
		CALL CARD_ADD_BASIC(決闘者,"デッキ",ゾーン,場所,3)

		IF RESULT					
			PRINTL
			PRINTL [0] - レベル 3 UP
			PRINTL [1] - レベル 3 DOWN
			BINPUT
			IF RESULT == 0	
				CALL SET_FIELD_INFO(決闘者,"戦場",場所,"星",3)
			ELSEIF RESULT == 1
				CALL SET_FIELD_INFO(決闘者,"戦場",場所,"星",-3)
			ENDIF
		ENDIF
		CALL FULLRESET
		効果条件種族 = 魔法使い族
		効果条件種類 = レベル持ち
		CALL CARD_CHOOSE_BASIC(決闘者,"戦場",ゾーン,場所)
		選択カード = RESULT
		IF 選択カード != 9999
			設定レベル = GETVAR(@"%決闘者%_MZ_星:選択カード")
			CALL FULLRESET
			効果条件種族 = 魔法使い族
			CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"一星",設定レベル)
		ENDIF

	ENDIF
ELSEIF 種類 == 墓地起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,12046)
	IF RESULT == 0
		CALL LIFE_CHANGE(決闘者,"減少","コスト",500)		
		CALL CARD_DISPOSE(決闘者,ゾーン,場所,デッキ行き)
	ENDIF
ENDIF