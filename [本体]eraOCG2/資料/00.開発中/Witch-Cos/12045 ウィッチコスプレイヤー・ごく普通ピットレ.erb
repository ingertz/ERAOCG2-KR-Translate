@CARDNAME_12045,参照先
;ココで指定卡片の名称、简称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ウィッチコスプレイヤー・ごく普通ピットレ
	CASE "略称"
		RESULTS = cos?ピットレ
	CASE "カテゴリ"
		RESULTS:0 = ウィッチクラフト
		RESULTS:1 = ウィッチコスプレイヤー
        RESULTS:2 = E.R.A
ENDSELECT


@CARD_12045(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 水属性
	CASE "種族"
		RETURN 魔法使い族
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 2100
	CASE "守備力"
		RETURN 0
	CASE "性別"
		RETURN 牝性
	CASE "チューナー"
		RETURN 1
	CASE "連動ID"
		RETURN 2045
ENDSELECT

RETURN 0

@CARD_EXPLANATION_12045(種類)
#DIM DYNAMIC 種類

PRINTL このカード名の①②の効果はそれぞれ１ターンに１度しかできない。
CALLFORM CARD_ABLE(1,手札起動)
PRINTL ①：このカードを手札から捨てて発動できる。デッキから「ウィッチクラフト」罠カード１枚を墓地へ送る。
CALLFORM CARD_ABLE(2,召喚時,特殊召喚時)
PRINTL ②：このカードが召喚・特殊召喚に成功した場合、デッキから２枚ドローする。
PRINTL 手札に「ウィッチクラフト」カードが存在する場合、このカードのレベルを２つ上げるか下げる。
CALLFORM CARD_ABLE(0,墓地起動)
PRINTL ③：このカードが墓地に存在する場合に発動できる。
PRINTL ５００LPを払い、このカードをデッキに戻す。


@CARDCAN_12045(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 効果制限達成
#DIM DYNAMIC カウンタ

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,12045)
SIF RESULT == 1
	RETURN 0
IF 種類 == 手札起動 
	SIF ゾーン != "手札"
		RETURN 0
	SIF 発動済_1(決闘者,12045)
		RETURN 0
	CALL FULLRESET
	効果範囲デッキ = 1
	効果条件カテゴリ = ウィッチクラフト
	効果条件種類 = 罠全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所,12045)
	CALL FULLRESET
	CALL CARD_CHECK_START_DATA(決闘者,1)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 召喚時 || 種類 == 特殊召喚時
	SIF 発動済_2(決闘者,12045)
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ELSEIF 種類 == 墓地起動
	SIF RESULT == 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF ゾーン != "墓地"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_12045(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 調教対象 = -1
#DIMS DYNAMIC 調教対象名
#DIM DYNAMIC 回復量
#DIM DYNAMIC 選択カード


IF 種類 == 手札起動 
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,12045)
	IF RESULT == 0
		CALL CARD_DISPOSE(決闘者,ゾーン,場所)
		CALL FULLRESET
		効果範囲デッキ = 1
		効果条件種類 = 罠全般
		効果条件カテゴリ = ウィッチクラフト
		CALL CARD_ADD_GY_BASIC(決闘者,"デッキ",ゾーン,場所)
	ENDIF
ELSEIF 種類 == 召喚時 || 種類 == 特殊召喚時 
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,12045,2)
	IF RESULT == 0
		CALL CARDDRAW_BASIC(決闘者,2)
		CALL FULLRESET
		効果範囲手札 = 1
		効果条件カテゴリ = ウィッチクラフト
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		IF RESULT
			PRINTFORML 					
			PRINTL
			PRINTL [0] - レベル 2 UP
			PRINTL [1] - レベル 2 DOWN
			BINPUT
			IF RESULT == 0	
				CALL FULLRESET
				CALL SET_FIELD_INFO(決闘者,"戦場",場所,"一星",2)
			ELSEIF RESULT == 1
				CALL FULLRESET
				CALL SET_FIELD_INFO(決闘者,"戦場",場所,"一星",-2)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 種類 == 墓地起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,12045)
	IF RESULT == 0
		CALL LIFE_CHANGE(決闘者,"減少","コスト",500)		
		CALL CARD_DISPOSE(決闘者,ゾーン,場所,デッキ行き)
	ENDIF
ENDIF