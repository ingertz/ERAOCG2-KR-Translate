@CARDNAME_42042,参照先
;ココで指定卡片の名称、简称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ウィッチコスプレイヤー・サイバースペシャル
	CASE "略称"
		RESULTS = cosジェニー
	CASE "カテゴリ"
		RESULTS:0 = ウィッチクラフト
		RESULTS:1 = ウィッチコスプレイヤー
        RESULTS:2 = E.R.A
ENDSELECT


@CARD_42042(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN リンク
	CASE "属性"
		RETURN 風属性
	CASE "種族"
		RETURN 魔法使い族
	CASE "レベル"
		RETURN 1
	CASE "攻撃力"
		RETURN 300
	CASE "守備力"
		RETURN 500
	CASE "性別"
		RETURN 牝性
	CASE "連動ID"
		RETURN 2042
ENDSELECT


RETURN 0


@CARD_EXPLANATION_42042(種類)
#DIM DYNAMIC 種類

PRINTL 「ウィッチクラフト」モンスター１体
PRINTL 自分は「ウィッチクラフト・サイバースペシャル」を１ターンに１度しか特殊召喚できない。
PRINTL このカード名の①②の効果はそれぞれ１ターンに１度しかできない。
CALLFORM CARD_ABLE(1,EX召喚時)
PRINTL ①：このカードがL召喚した場合に発動できる。
PRINTL 自分フィールドに「ハッキングトークン」（魔法使い族・闇・星７・攻／守０）を２体特殊召喚する。
PRINTL この効果の発動後、ターン終了時まで自分は「ウィッチクラフト」モンスターしか特殊召喚できない。
CALLFORM CARD_ABLE(2,戦場起動)
PRINTL ②：相手のデッキを確認する。
PRINTL 相手のデッキに「E.R.A」カードが存在する場合、以下の効果から１つを選んで適用する。
PRINTL ●デッキから「ウィッチクラフト」モンスター１体を特殊召喚する。
PRINTL ●相手のデッキから「E.R.A」カード１枚を手札に加える。
PRINTL ●相手はあなたに１５００円を支払い、あなたは７００LPを回復する。
CALLFORM CARD_ABLE(0,墓地起動)
PRINTL ③：このカードが墓地に存在する場合に発動できる。
PRINTL ５００LPを払い、このカードをエクストラデッキに戻す。

@CARDSUMMON_42042(決闘者,召喚カード,EX参照)
#DIMS DYNAMIC 決闘者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 召喚カード
#DIM DYNAMIC EX参照
;素材条件

CALL RESETCONDITION_MAT
必要リンク数 = 1

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = ウィッチクラフト
ELSE
	PRINT
ENDIF

IF EX参照 == 1
	CALL LINCAN(決闘者,召喚カード,42042) 
	RETURN RESULT
ENDIF

@CARDCAN_42042(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 条件達成

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,42042)
SIF RESULT == 1
	RETURN 0

IF 種類 == EX召喚時 
	SIF 発動済_1(決闘者,42042)
		RETURN 0
	CALL CARD_SS_CHECK(決闘者,442042,ゾーン)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 戦場起動
	SIF 発動済_2(決闘者,42042)
		RETURN 0
	CALL CARD_EROTICS(相手プレイヤー,決闘者,1)
	SIF RESULT == -1
		RETURN 0
	CALL FULLRESET
	効果範囲デッキ = 1
	効果条件カテゴリ = ウィッチクラフト
	効果条件召喚可 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)

	CALL FULLRESET
	効果範囲相手デッキ = 1
	効果条件カテゴリ = E.R.A
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	RETURN 1
ELSEIF 種類 == 墓地起動
	SIF RESULT == 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF ゾーン != "墓地"
		RETURN 0
	RETURN 1
ENDIF


@CARDEFFECT_42042(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 調教対象 = -1
#DIMS DYNAMIC 調教対象名
#DIM DYNAMIC 回復量
#DIM DYNAMIC 選択カード


CALL 対面者判定(決闘者)
対面者 = %RESULTS%


IF 種類 == EX召喚時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,42042,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_GENERATE(決闘者,442042)
		CALL FULLRESET
		CALL CARD_GENERATE(決闘者,442042)

	ENDIF
	CALL CARD_SS_RESTRICTION(決闘者,"ウィッチクラフト")
ELSEIF 種類 == 戦場起動
	;卡片发动確認
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,42042,2)
	IF RESULT == 0
		
		CALL CARD_EROTICS(相手プレイヤー,決闘者)
		IF RESULT > -1
			調教対象 = RESULT
			TRYCALLFORM CARDNAME_{NO:調教対象}("名前")
			調教対象名 = %RESULTS%
			SIF 調教対象名 == ""
				RETURN 0
		ELSE
			RETURN 0
		ENDIF
		
		;对方の额外卡组の「E.R.A」卡片を確認
		CALL FULLRESET
		効果範囲相手デッキ = 1
		効果条件カテゴリ = E.R.A
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		IF RESULT
			PRINTFORML 					
			PRINTL
			PRINTL [0] - デッキから「ウィッチクラフト」モンスター１体を特殊召喚する。
			PRINTL [1] - 相手のデッキから「E.R.A」カード１枚を手札に加える。
			PRINTL [2] - 相手はあなたに１５００円を支払い、あなたは７００LPを回復する。
			BINPUT		
			IF RESULT == 0
				CALL FULLRESET
				効果範囲デッキ = 1
				効果条件カテゴリ = ウィッチクラフト
				CALL CARD_SP_SUMMON_ADV(決闘者,ゾーン,場所)	
			ELSEIF RESULT == 1

				CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,42042)
				IF RESULT == 0
					CALL FULLRESET
					効果範囲相手デッキ = 1
					効果条件カテゴリ = E.R.A
					CALL CARD_CHOOSE_ADV(決闘者,ゾーン,場所)
					選択カード = RESULT
					IF 選択カード != 9999
						CALL CARD_SELECT(決闘者,選択カード)
						選択カード = RESULT
						CALL CARD_ADD(決闘者, "相手デッキ", "手札", 選択カード)
					ENDIF
				ENDIF
			ELSEIF  RESULT == 2
				CALL MONEY_GET(1500)
				CALL LIFE_CHANGE(決闘者,"増加","効果",700)						
			ENDIF

		ENDIF
	ENDIF
ELSEIF 種類 == 墓地起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,42042)
	IF RESULT == 0
		CALL LIFE_CHANGE(決闘者,"減少","コスト",500)		
		CALL CARD_DISPOSE(決闘者,ゾーン,場所,デッキ行き)
	ENDIF
ENDIF


