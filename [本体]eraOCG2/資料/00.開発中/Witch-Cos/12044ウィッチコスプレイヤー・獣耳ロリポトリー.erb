@CARDNAME_12044,参照先
;ココで指定卡片の名称、简称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ウィッチコスプレイヤー・獣耳ロリポトリー
	CASE "略称"
		RESULTS = cosポトリー
	CASE "カテゴリ"
		RESULTS:0 = ウィッチクラフト
		RESULTS:1 = ウィッチコスプレイヤー
        RESULTS:2 = E.R.A
ENDSELECT


@CARD_12044(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 地属性
	CASE "種族"
		RETURN 魔法使い族
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 1300
	CASE "守備力"
		RETURN 700
	CASE "性別"
		RETURN 牝性
	CASE "チューナー"
		RETURN 1
	CASE "連動ID"
		RETURN 2044
ENDSELECT


RETURN 0

@CARD_EXPLANATION_12044(種類)
#DIM DYNAMIC 種類

PRINTL このカード名の①②の効果はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,手札起動)
PRINTL ①：このカードを手札から捨てて発動できる。デッキから「ウィッチクラフト」魔法カード１枚を墓地へ送る。
CALLFORM CARD_ABLE(2,召喚時,特殊召喚時)
PRINTL ②：このカードが召喚・特殊召喚に成功した場合、デッキから「ウィッチクラフト」モンスター１体を効果を無効にして特殊召喚する。
PRINTL その後、このカードのレベルを１つ上げるか下げる。
CALLFORM CARD_ABLE(0,墓地起動)
PRINTL ③：このカードが墓地に存在する場合に発動できる。
PRINTL ５００LPを払い、このカードをデッキに戻す。

@CARDCAN_12044(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 効果制限達成
#DIM DYNAMIC カウンタ

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,12044)
SIF RESULT == 1
	RETURN 0
IF 種類 == 手札起動 
	SIF ゾーン != "手札"
		RETURN 0
	SIF 発動済_1(決闘者,12044)
		RETURN 0
	CALL FULLRESET
	効果範囲デッキ = 1
	効果条件カテゴリ = ウィッチクラフト
	効果条件種類 = 魔法全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所,12044)
	CALL FULLRESET
	CALL CARD_CHECK_START_DATA(決闘者,1)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 召喚時 || 種類 == 特殊召喚時
	SIF 発動済_2(決闘者,12044)
		RETURN 0
	CALL FULLRESET
	効果範囲デッキ = 1
	効果条件種類 = モン全般
	効果条件種族 = 魔法使い族
	効果条件召喚可 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 墓地起動
	SIF RESULT == 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF ゾーン != "墓地"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_12044(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 調教対象 = -1
#DIMS DYNAMIC 調教対象名
#DIM DYNAMIC 回復量
#DIM DYNAMIC 選択カード


IF 種類 == 手札起動 
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,12044)
	IF RESULT == 0
		CALL CARD_DISPOSE(決闘者,ゾーン,場所)
		CALL FULLRESET
		効果範囲デッキ = 1
		効果条件種類 = 魔法全般
		効果条件カテゴリ = ウィッチクラフト
		CALL CARD_ADD_GY_BASIC(決闘者,"デッキ",ゾーン,場所)
	ENDIF
ELSEIF 種類 == 召喚時 || 種類 == 特殊召喚時 
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,12044,2)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲デッキ = 1
		効果条件種族 = 魔法使い族
		効果追加種類 = 効追無効
		CALL CARD_SP_SUMMON_ADV(決闘者,ゾーン,場所)
		PRINTFORML 					
		PRINTL
		PRINTL [0] - レベル 1 UP
		PRINTL [1] - レベル 1 DOWN
		BINPUT
		IF RESULT == 0	
			CALL FULLRESET
			CALL SET_FIELD_INFO(決闘者,"戦場",場所,"一星",1)
		ELSEIF RESULT == 1
			CALL FULLRESET
			CALL SET_FIELD_INFO(決闘者,"戦場",場所,"一星",-1)
		ENDIF
	ENDIF
ELSEIF 種類 == 墓地起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,12044)
	IF RESULT == 0
		CALL LIFE_CHANGE(決闘者,"減少","コスト",500)		
		CALL CARD_DISPOSE(決闘者,ゾーン,場所,デッキ行き)
	ENDIF
ENDIF


