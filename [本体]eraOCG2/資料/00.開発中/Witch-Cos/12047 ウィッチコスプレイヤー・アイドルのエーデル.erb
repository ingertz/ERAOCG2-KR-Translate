@CARDNAME_12047,参照先
;ココで指定卡片の名称、简称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = ウィッチコスプレイヤー・アイドルのエーデル
	CASE "略称"
		RESULTS = cosエーデル
	CASE "カテゴリ"
		RESULTS:0 = ウィッチクラフト
		RESULTS:1 = ウィッチコスプレイヤー
        RESULTS:2 = E.R.A
ENDSELECT


@CARD_12047(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 光属性
	CASE "種族"
		RETURN 魔法使い族
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 2000
	CASE "守備力"
		RETURN 1700
	CASE "性別"
		RETURN 牝性
	CASE "連動ID"
		RETURN 2047
ENDSELECT

RETURN 0


@CARD_EXPLANATION_12047(種類)
#DIM DYNAMIC 種類


PRINTL このカード名の①②の効果はそれぞれ１ターンに１度しかできない。
CALLFORM CARD_ABLE(1,手札起動)
PRINTL ①：エクストラデッキから「ウィッチクラフト」モンスター１体を墓地へ送り、このカードを手札から特殊召喚する。
PRINTL この効果の発動後、ターン終了時まで魔法使い族モンスターしか特殊召喚できない。
CALLFORM CARD_ABLE(2,戦場起動)
PRINTL ②：デッキから「ウィッチクラフト」永続魔法１枚を手札に加える。
PRINTL このターン、自分のレベルを４つ下げる。
CALLFORM CARD_ABLE(0,X素材時効果,R素材時効果,F素材時効果,S素材時効果,L素材時効果)
PRINTL ③：このカードが融合・シンクロ・エクシーズ・リンクモンスターの素材となった場合、
PRINTL ８００LPを回復し、このカードをデッキに戻す。
PRINTL フィールドの魔法・罠カード１枚を対象として発動できる。そのカードを破壊する。


@CARDCAN_12047(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 効果制限達成
#DIM DYNAMIC カウンタ

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,12047)
SIF RESULT == 1
	RETURN 0
IF 種類 == 手札起動
	SIF 発動済_1(決闘者,12406)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF モンスター数(決闘者) >= 5
		RETURN 0
	CALL FULLRESET
	効果範囲EXデッキ = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_SS_CHECK(決闘者,12047,ゾーン)
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 戦場起動
	SIF 発動済_2(決闘者,12047)
		RETURN 0
	CALL CARD_DRAW_CHECK
	CALL FULLRESET
	効果範囲デッキ = 1
	効果条件カテゴリ = ウィッチクラフト
	効果条件種類 = 永続魔法
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == S素材時効果 ||  種類 == L素材時効果 ||  種類 == X素材時効果 ||  種類 == R素材時効果 ||  種類 == F素材時効果
	CALL FULLRESET
	効果範囲魔罠 = 1	
	効果範囲相手魔罠 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	RETURN 1
ENDIF
@CARDEFFECT_12047(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 調教対象 = -1
#DIMS DYNAMIC 調教対象名
#DIM DYNAMIC 回復量
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 設定レベル 

IF 種類 == 手札起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,12047,1)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲EXデッキ = 1
		効果条件他所 = 1
		効果条件カテゴリ = ウィッチクラフト
		CALL CARD_ADD_GY_BASIC(決闘者,"EXデッキ",ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_SP_SUMMON(決闘者,ゾーン,場所)
		ENDIF
	ENDIF
	SS召喚可能種族 = 魔法使い族
	CALL CARD_SS_RESTRICTION(決闘者)

ELSEIF 種類 == 戦場起動
	;卡片发动確認
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,12047,2)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲デッキ = 1
		効果条件カテゴリ = ウィッチクラフト
		効果条件種類 = 永続魔法
		CALL CARD_ADD_ADV(決闘者,ゾーン,場所)
		CALL SET_FIELD_INFO(決闘者,"戦場",場所,"一星",-4)
	ENDIF
ELSEIF 種類 == S素材時効果 || 種類 == L素材時効果 || 種類 == X素材時効果 || 種類 == R素材時効果 || 種類 == F素材時効果
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,12047)
	IF RESULT == 0
		CALL LIFE_CHANGE(決闘者,"増加","効果",800)		
		CALL CARD_DISPOSE(決闘者,ゾーン,場所,デッキ行き)
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(決闘者,"魔罠単体",場所,通常罠)
	ENDIF
ENDIF
