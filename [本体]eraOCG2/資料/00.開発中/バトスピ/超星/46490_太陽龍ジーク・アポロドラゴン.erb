;========================================================
; 46490 太陽龍ジーク・アポロドラゴン
;========================================================

@CARDNAME_46490,参照先
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS
SELECTCASE 参照先
	CASE "名前"
		RESULTS = 太陽龍ジーク・アポロドラゴン
	CASE "略称"
		RESULTS = アポロドラゴン
	CASE "カテゴリ"
		RESULTS:0 = 星竜
		RESULTS:1 = 神星
		RESULTS:4 = バトルスピリッツ
ENDSELECT
RETURN 0

@CARD_46490(参照先)
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS
SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 炎属性
	CASE "種族"
		RETURN ドラゴン族
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 2500
	CASE "守備力"
		RETURN 2000
	CASE "生成カード"
		RETURN 46491
	CASE "追加日"
		RETURN 250814
ENDSELECT
RETURN 0

@CARD_EXPLANATION_46490(種類)
#DIM DYNAMIC 種類
PRINTL このカード名の①②の効果はそれぞれ１ターンに１度しか発動できない。
CALLFORM CARD_ABLE(1,手札起動)
PRINTL ①：自分 메인 페이즈에 発動できる。
PRINTL 自分の「創界神」からコアカウンターを２つ取り除き、
PRINTL このカードを手札から特殊召喚する。
CALLFORM CARD_ABLE(2,攻撃時誘発)
PRINTL ②：このカードが相手モンスターと戦闘を行うダメージステップ開始時に発動できる。
PRINTL そのモンスターを墓地へ送り、相手に２０００のダメージを与える。
CALLFORM CARD_ABLE(3,攻撃後誘発)
PRINTL ③：《『転醒』「創界神」カウント７以下》
PRINTL このモンスターが戦闘を行ったダメージステップ終了時に、
PRINTL 自分フィールドの「創界神」のうち、カウントカウンターが７つ以下の１枚を対象として発動できる。
PRINTL そのカードのコアカウンターを２つ取り除き、
PRINTL このカードを裏返し「太陽神龍ライジング・アポロドラゴン」に転醒させる。
PRINTL 그 후、対象とした「創界神」にカウントカウンターを１つ置く。
RETURN 0

@CARDCAN_46490(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,46490)
SIF RESULT == 1
	RETURN 0

; ① 手札起動（自分メイン／創界神 個Ｃ>=2）
IF 種類 == 手札起動
	SIF ゾーン != "手札"
		RETURN 0
	SIF メインフェイズ != 1 || ターンプレイヤー != 決闘者
		RETURN 0
	SIF 発動済_1(決闘者,46490)
		RETURN 0
	CALL FULLRESET
	効果範囲魔罠     = 1
	効果条件カテゴリ = 創界神
	効果条件個Ｃ所持 = 2
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL CARD_SS_CHECK(決闘者,46490,"手札")
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ENDIF

; ② 攻撃時誘発（このカードが戦闘関与）
IF 種類 == 攻撃時誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF バトルフェイズ != 1
		RETURN 0
	SIF 発動済_2(決闘者,46490)
		RETURN 0
	; このカードが現在の戦闘に関与していることを確認（環境API名に応じて読み替え可）
	SIF 戦闘場所(決闘者) != 場所
		RETURN 0
	RETURN 1
ENDIF

; ③ 効果後誘発（このターン戦闘関与 ＆ 創界神：悪Ｃ<=7・個Ｃ>=2）
IF 種類 == 攻撃後誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF 発動済_3(決闘者,46490)
		RETURN 0
	SIF 戦闘場所(決闘者) != 場所
		RETURN 0
	CALL FULLRESET
	効果範囲魔罠     = 1
	効果条件カテゴリ = 創界神
	効果条件個Ｃ所持 = 2
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

RETURN 0

@CARDEFFECT_46490(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC 選択カード

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

; ① 創界神から個Ｃ2支払い → 手札から自身SS
IF 種類 == 手札起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46490,1)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲魔罠     = 1
		効果条件カテゴリ = 創界神
		効果条件個Ｃ所持 = 2
		CALL CARD_CHOOSE_ADV(決闘者,ゾーン,場所)
		IF RESULT != 9999
			CALL CARD_SELECT(決闘者,RESULT)
			CALL SET_FIELD_INFO(対象者（CS）,参照先（CS）,選択カード（CS）,"個Ｃ",-2)

			CALL FULLRESET
			効果範囲手札 = 1
			効果条件固ID = 46490
			CALL CARD_SP_SUMMON(決闘者,"手札",場所)
		ENDIF
	ENDIF
; ② 相手モンスターを墓地へ → 2000ダメージ
ELSEIF 種類 == 攻撃時誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46490,2)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲相手戦場 = 1
		効果条件種類     = モン全般
		CALL CARD_CHOOSE_ADV(決闘者,ゾーン,場所)
		IF RESULT == 9999
			RETURN 0
		ENDIF
		CALL CARD_SELECT(決闘者,RESULT)
		CALL CARD_DISPOSE(対面者,"戦場",選択カード（CS）,墓地行き)
		CALL LIFE_CHANGE(対面者,"減少","効果",2000,1)
		RETURN 0
	ENDIF

; ③ 転醒：対象創界神(悪Ｃ<=7 & 個Ｃ>=2)の個Ｃ-2 → 自身消滅 → 46491生成 → 悪Ｃ+1
ELSEIF 種類 == 攻撃後誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46490,3)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲魔罠     = 1
		効果条件カテゴリ = 創界神
		効果条件個Ｃ所持 = 2
		CALL CARD_CHOOSE_ADV(決闘者,ゾーン,場所)
		IF RESULT != 9999
			CALL CARD_SELECT(決闘者,RESULT)

			SIF GETVAR(@"%対象者（CS）%_魔_悪Ｃ:{選択カード（CS）}") > 7
				RETURN 0

			CALL SET_FIELD_INFO(対象者（CS）,参照先（CS）,選択カード（CS）,"個Ｃ",-2)
			CALL CARD_DISPOSE(決闘者,"戦場",場所,消滅行き)
			CALL CARD_GENERATE(決闘者,46491)
			CALL SET_FIELD_INFO(対象者（CS）,参照先（CS）,選択カード（CS）,"悪Ｃ",1)
		ENDIF
	ENDIF
ENDIF

RETURN 0


;========================================================
; 46491 太陽神龍ライジング・アポロドラゴン — 完全版
;========================================================

@CARDNAME_46491,参照先
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS
SELECTCASE 参照先
	CASE "名前"
		RESULTS = 太陽神龍ライジング・アポロドラゴン
	CASE "略称"
		RESULTS = 太陽ライジング
	CASE "カテゴリ"
		RESULTS:0 = 星竜
		RESULTS:1 = 神星
		RESULTS:4 = バトルスピリッツ
ENDSELECT
RETURN 0

@CARD_46491(参照先)
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS
SELECTCASE 参照先
	CASE "種類"
		RETURN 儀式
	CASE "属性"
		RETURN 炎属性
	CASE "種族"
		RETURN ドラゴン族
	CASE "レベル"
		RETURN 8
	CASE "攻撃力"
		RETURN 3000
	CASE "守備力"
		RETURN 2500
	CASE "トークン"
		RETURN 1
ENDSELECT
RETURN 0

@CARD_EXPLANATION_46491(種類)
#DIM DYNAMIC 種類
CALLFORM CARD_ABLE(1,永続効果)
PRINTL ①：このカードがフィールドに存在する限り、
PRINTL 自分の「神星」モンスターは直接攻撃できる。
CALLFORM CARD_ABLE(2,攻撃時誘発)
PRINTL ②：このカードに置かれたコアカウンターが２個以上の場合、
PRINTL このカードの攻撃時に発動できる。
PRINTL 相手フィールドの攻撃力２０００以下のモンスター２体を破壊する。
PRINTL 그 후、デッキから１枚ドローする。
CALLFORM CARD_ABLE(3,戦破壊→墓地)
CALLFORM CARD_ABLE(3,除外時)
CALLFORM CARD_ABLE(3,デッキ行き)
CALLFORM CARD_ABLE(3,手札行き)
PRINTL ■転醒体
PRINTL このカードがフィールドを離れた場合、表面の「太陽龍ジーク・アポロドラゴン」に戻る。
RETURN 0

@CARDCAN_46491(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,46491)
SIF RESULT == 1
	RETURN 0

; ① 永続（常時）
IF 種類 == 永続効果
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ENDIF

; ② 攻撃時誘発（自分バトルフェイズ／個Ｃ>=2／D1／このカードが攻撃中）
IF 種類 == 攻撃時誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF バトルフェイズ != 1 || ターンプレイヤー != 決闘者
		RETURN 0
	SIF GETVAR(@"%決闘者%_MZ_個Ｃ:場所") < 2
		RETURN 0
	SIF 戦闘場所(決闘者) != 場所
		RETURN 0
	RETURN 1
ENDIF

; ③ フィールド離脱（統一形）
IF GROUPMATCH(種類, 破壊→墓地, 戦闘→墓地, 戦破壊→墓地, 手札行き, デッキ行き, 除外時)
	RETURN 1
ENDIF

RETURN 0

@CARDEFFECT_46491(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 枚数
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

; ① 永続：自分の神星に直攻付与（効果条件カテゴリで判定）
IF 種類 == 永続効果
	SIF ゾーン != "戦場"
		RETURN 0
	CALL FULLRESET
	効果範囲戦場     = 1
	効果条件種類     = モン全般
	効果条件カテゴリ = 神星
	; フィルタに一致する自分戦場の神星へ一括付与（ループ不要）
	CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"直攻")

; ② 攻撃時：ATK2000以下の対面者モンスターを最大2体破壊 → 1ドロー（D1）
ELSEIF 種類 == 攻撃時誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46491,2)
	IF RESULT == 0

		CALL FULLRESET
		効果範囲相手戦場   = 1
		効果条件攻撃力	   = 2000
		効果条件複数       = 98
		CALL CARD_REMOVAL_ADV(決闘者,"単体除去",場所,"墓地")

		CALL CARDDRAW_BASIC(決闘者,1)
		CALL CARD_EFFECT_D1USE(決闘者,46491)
	ENDIF
; ③ フィールド離脱：通常体(46490)のみ墓地に1枚生成（場に残さない）
ELSEIF GROUPMATCH(種類, 破壊→墓地, 戦闘→墓地, 戦破壊→墓地, 手札行き, デッキ行き, 除外時)
    CALL FULLRESET
    CALL CARD_GENERATE_GY(決闘者, 46490)
	CALL CARD_DISPOSE(決闘者, ゾーン, 場所, 消滅行き)
ENDIF

