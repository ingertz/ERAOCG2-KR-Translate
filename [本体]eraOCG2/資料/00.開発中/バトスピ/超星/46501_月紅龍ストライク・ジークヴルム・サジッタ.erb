;========================================================
; 46501 月紅龍ストライク・ジークヴルム・サジッタ
;========================================================

@CARDNAME_46501,参照先
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 月紅龍ストライク・ジークヴルム・サジッタ
	CASE "略称"
		RESULTS = 月紅サジッタ
	CASE "カテゴリ"
		RESULTS:0 = 光導
		RESULTS:1 = 星竜
		RESULTS:2 = 神星
	CASE "出典作品"
		RESULTS:0 = バトルスピリッツ
ENDSELECT
RETURN 0


@CARD_46501(参照先)
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 融合
	CASE "属性"
		RETURN 炎属性
	CASE "種族"
		RETURN ドラゴン族
	CASE "レベル"
		RETURN 10
	CASE "攻撃力"
		RETURN 3500
	CASE "守備力"
		RETURN 2000
	CASE "追加日"
		RETURN 250814
ENDSELECT
RETURN 0


@CARD_EXPLANATION_46501(種類)
#DIM DYNAMIC 種類

PRINTL 「神星」モンスター＋「光導」モンスター＋「星竜」モンスター
PRINTL 自分の手札・フィールド・墓地の上記のカードをデッキ・EXデッキに戻した場合のみ特殊召喚できる。
PRINTL このカードは融合素材にできない。
PRINTL このカード名の①③の効果はそれぞれ１ターンに１度しか使用できない。

CALLFORM CARD_ABLE(1,発動誘発)
PRINTL ①：魔法・罠・モンスターの効果が発動した時に発動できる。
PRINTL その発動を無効にし、破壊する。

CALLFORM CARD_ABLE(0,永続効果)
PRINTL ②：このカードは相手モンスターの効果を受けない。

CALLFORM CARD_ABLE(3,攻撃時誘発)
PRINTL ③：このカードにコアカウンターが２個以上の場合、
PRINTL このカードが相手モンスターと戦闘を行う場合に発動できる。
PRINTL 相手フィールドの攻撃力２５００以下のモンスター１体を墓地に送り、
PRINTL その後、相手に２０００ダメージを与え、自分はデッキから１枚ドローする。

RETURN 0

@CARDCAN_46501(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,46501)
SIF RESULT == 1
	RETURN 0

IF 種類 == EXデッキ起動
	SIF メインフェイズ != 1 || ターンプレイヤー != 決闘者
		RETURN 0
	CALL FULLRESET
	効果範囲EXデッキ = 1
	効果条件ID = 46501
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	効果範囲手札 = 1
	効果範囲戦場 = 1
	効果範囲墓地 = 1
	効果条件カテゴリ = 神星
	効果条件種類   = モン全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	効果範囲手札 = 1
	効果範囲戦場 = 1
	効果範囲墓地 = 1
	効果条件カテゴリ = 光導
	効果条件種類   = モン全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	効果範囲手札 = 1
	効果範囲戦場 = 1
	効果範囲墓地 = 1
	効果条件カテゴリ = 星竜
	効果条件種類   = モン全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	RETURN 1
ENDIF

IF 種類 == 発動誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF 発動済_1(決闘者,46501)
		RETURN 0
	CALL FULLRESET
	効果条件種類   = モン全般
	効果条件種類:1 = 魔法全般
	効果条件種類:2 = 罠全般
	CALL CARD_CHECK_START_DATA(決闘者,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

IF 種類 == 永続効果
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ENDIF

IF 種類 == 攻撃時誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF 発動済_3(決闘者,46501)
		RETURN 0
	SIF 戦闘場所(決闘者) != 場所
		RETURN 0
	SIF 戦闘場所(決闘者,1) == 5
		RETURN 0
	SIF GETVAR(@"%決闘者%_MZ_個Ｃ:場所") < 2
		RETURN 0
	CALL FULLRESET
	効果範囲相手戦場   = 1
	効果条件種類       = モン全般
	効果条件攻撃力 = 2500
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

RETURN 0


@CARDEFFECT_46501(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所
#DIMS DYNAMIC 対面者

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == EXデッキ起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46501)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲手札 = 1
		効果範囲戦場 = 1
		効果範囲墓地 = 1
		効果条件カテゴリ   = 神星
		効果条件種類       = モン全般
		効果条件行先フラグ = デッキ行き
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			効果範囲手札 = 1
			効果範囲戦場 = 1
			効果範囲墓地 = 1
			効果条件カテゴリ   = 光導
			効果条件種類       = モン全般
			効果条件行先フラグ = デッキ行き
			CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
			IF RESULT == 1
				CALL FULLRESET
				効果範囲手札 = 1
				効果範囲戦場 = 1
				効果範囲墓地 = 1
				効果条件カテゴリ   = 星竜
				効果条件種類       = モン全般
				効果条件行先フラグ = デッキ行き
				CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
				IF RESULT == 1
					CALL FULLRESET
					CALL CARD_EX_SUMMON(決闘者,"EXデッキ",場所)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	RETURN 0
ENDIF

IF 種類 == 発動誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46501,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(決闘者,"発動無効",場所,"墓地")
		CALL CARD_EFFECT_USE(決闘者,46501,1)
		RETURN 1
	ENDIF
	RETURN 0
ENDIF

IF 種類 == 永続効果
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"モ耐")
	RETURN 0
ENDIF

IF 種類 == 攻撃時誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46501,3)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲相手戦場   = 1
		効果条件種類       = モン全般
		効果条件攻撃力上限 = 2500
		CALL CARD_ADD_GY_BASIC(決闘者,"相手戦場",ゾーン,場所)
		CALL DAMAGE(決闘者,対面者,2000)
		CALL CARDDRAW_BASIC(決闘者,1)
		CALL CARD_EFFECT_USE(決闘者,46501,3)
	ENDIF
	RETURN 0
ENDIF

RETURN 0
