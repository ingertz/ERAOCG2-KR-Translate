;========================================
; 46481 龍星の射手リュキオース
;========================================

@CARDNAME_46481,参照先
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 龍星の射手リュキオース
	CASE "略称"
		RESULTS = リュキオース
	CASE "カテゴリ"
		RESULTS:0 = 星竜
		RESULTS:1 = 光導
	CASE "出典作品"
		RESULTS:0 = バトルスピリッツ
ENDSELECT
RETURN 0


@CARD_46481(参照先)
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 炎属性
	CASE "種族"
		RETURN ドラゴン族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1900
	CASE "守備力"
		RETURN 1100
	CASE "追加日"
		RETURN 250814
ENDSELECT
RETURN 0


@CARD_EXPLANATION_46481(種類)
#DIM DYNAMIC 種類

PRINTL このカード名の①②の効果はそれぞれ１ターンに１度しか使用できず、
PRINTL ③の効果はデュエル中１度しか発動できない。
CALLFORM CARD_ABLE(1,手札起動)
PRINTL ①：自分フィールドにモンスターが存在しない場合に発動できる。
PRINTL このカードを手札から特殊召喚する。
CALLFORM CARD_ABLE(2,召喚時,特殊召喚時)
PRINTL ②：このカードが召喚・特殊召喚した場合に発動できる。
PRINTL デッキの上から５枚めくる。
PRINTL その中の「超星」または「星竜」カードを１枚手札に加える。
PRINTL 残りはデッキに戻す。
CALLFORM CARD_ABLE(20,戦場起動)
PRINTL ③：メインフェイズに発動できる。
PRINTL 自分の「創界神」にコアカウンターを３つ置き、
PRINTL デッキの上から５枚めくる。
PRINTL その中の「光導」カードを１枚手札に加える。
RETURN 0


@CARDCAN_46481(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,46481)
SIF RESULT == 1
	RETURN 0

; ① 手札起動：自分フィールドにモンスターが存在しない
IF 種類 == 手札起動
	SIF メインフェイズ != 1 || ターンプレイヤー != 決闘者
		RETURN 0
	SIF 発動済_1(決闘者,46481)
		RETURN 0
	SIF モンスター数(決闘者) != 0
		RETURN 0
	CALL CARD_SS_CHECK(決闘者,46481,"手札")
	SIF RESULT == 1
		RETURN 0
	RETURN 1
ENDIF

; ② 召喚時／特殊召喚時
IF 種類 == 召喚時 || 種類 == 特殊召喚時
	SIF ゾーン != "戦場"
		RETURN 0
	SIF 発動済_2(決闘者,46481)
		RETURN 0
	RETURN 1
ENDIF

IF 種類 == 戦場起動
	SIF ゾーン != "戦場"
		RETURN 0
	SIF メインフェイズ != 1 || ターンプレイヤー != 決闘者
		RETURN 0
	SIF 発動済_D1(決闘者,46481)
		RETURN 0
	CALL FULLRESET
	効果範囲魔罠   = 1
	効果条件カテゴリ = 創界神
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT < 1
		RETURN 0
	RETURN 1
ENDIF

RETURN 0


@CARDEFFECT_46481(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所
#DIM  DYNAMIC 選択カード

IF 種類 == 手札起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46481,1)
	CALL CARD_SP_SUMMON(決闘者,"手札",場所)
	RETURN 0
ENDIF

IF 種類 == 召喚時 || 種類 == 特殊召喚時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46481,2)

	CALL FULLRESET
	効果範囲デッキ     = 1
	効果条件カテゴリ:0 = 超星
	効果条件カテゴリ:1 = 星竜
	効果条件任意       = 1
	効果条件複数       = 1
	CALL CARD_ADD_BASIC(決闘者,"デッキ",ゾーン,場所,5)
	RETURN 0
ENDIF

IF 種類 == 戦場起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46481,20)
	CALL FULLRESET
	効果範囲魔罠   = 1
	効果条件カテゴリ = 創界神
	CALL CARD_CHOOSE_ADV(決闘者,ゾーン,場所)
	IF RESULT == 9999
		RETURN 0
	ENDIF
	CALL CARD_SELECT(決闘者,RESULT)
	CALL SET_FIELD_INFO(対象者（CS）,参照先（CS）,選択カード（CS）,"個Ｃ",3)

	CALL FULLRESET
	効果範囲デッキ   = 1
	効果条件カテゴリ = 光導
	効果条件任意     = 1
	効果条件複数     = 1
	CALL CARD_ADD_BASIC(決闘者,"デッキ",ゾーン,場所,5)
	RETURN 0
ENDIF

RETURN 0
