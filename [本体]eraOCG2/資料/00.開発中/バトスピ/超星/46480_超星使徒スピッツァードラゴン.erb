;========================================
; 46480 超星使徒スピッツァードラゴン
;========================================

@CARDNAME_46480,参照先
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 超星使徒スピッツァードラゴン
	CASE "略称"
		RESULTS = スピッツァー
	CASE "カテゴリ"
		RESULTS:0 = 超星
		RESULTS:1 = 星竜
		RESULTS:4 = バトルスピリッツ
ENDSELECT

@CARD_46480(参照先)
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 闇属性
	CASE "種族"
		RETURN ドラゴン族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 2100
	CASE "守備力"
		RETURN 200
	CASE "追加日"
		RETURN 250814
ENDSELECT
RETURN 0

@CARD_EXPLANATION_46480(種類)
#DIM DYNAMIC 種類

PRINTL このカード名の①②③の効果はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,発動誘発)
PRINTL ①：相手が罠カードを発動した場合に発動できる。
PRINTL 自分の「光星の契約神レムリア」からコアカウンターを１つ取り除き、その発動を無効にし、破壊する。
PRINTL 그 후、このカードを手札から特殊召喚する。
CALLFORM CARD_ABLE(2,召喚時,特殊召喚時)
PRINTL ②：このカードが召喚・特殊召喚した場合に発動できる。
PRINTL 墓地の「星竜」または「超星」モンスター１体を特殊召喚する。
CALLFORM CARD_ABLE(3,戦場起動)
PRINTL ③：このカードをリリースして発動できる。
PRINTL 墓地の「超星」モンスター１体を特殊召喚し、自分フィールドのモンスターの数分、そのモンスターにコアカウンターを置く。
RETURN 0

@CARDCAN_46480(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,46480)
SIF RESULT == 1
	RETURN 0

IF 種類 == 発動誘発
	SIF ゾーン != "手札"
		RETURN 0
	SIF 発動済_1(決闘者,46480)
		RETURN 0
	CALL FULLRESET
	効果条件種類 = 罠全般
	CALL CARD_CHECK_START_DATA(決闘者,1)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	効果範囲魔罠 = 1
	効果条件名前 = 光星の契約神レムリア
	効果条件個Ｃ所持 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT < 1
		RETURN 0
	RETURN 1
ENDIF

IF 種類 == 召喚時 || 種類 == 特殊召喚時
	SIF ゾーン != "戦場"
		RETURN 0
	SIF 発動済_2(決闘者,46480)
		RETURN 0
	RETURN 1
ENDIF

IF 種類 == 戦場起動
	SIF ゾーン != "戦場"
		RETURN 0
	SIF メインフェイズ != 1 || ターンプレイヤー != 決闘者
		RETURN 0
	SIF 発動済_3(決闘者,46480)
		RETURN 0
	RETURN 1
ENDIF

RETURN 0

@CARDEFFECT_46480(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所
#DIM  DYNAMIC 個数
#DIM  DYNAMIC 選択カードID

IF 種類 == 発動誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46480,1)
	CALL FULLRESET
	効果範囲魔罠 = 1
	効果条件名前 = 光星の契約神レムリア
	効果条件個Ｃ所持 = 1
	CALL CARD_CHOOSE_ADV(決闘者,ゾーン,場所)
	IF RESULT == 9999
		RETURN 0
	ENDIF
	CALL CARD_SELECT(決闘者,RESULT)
	CALL SET_FIELD_INFO(対象者（CS）,参照先（CS）,選択カード（CS）,"個Ｃ",-1)
	CALL CARD_REMOVAL_BASIC(決闘者,"発動無効",場所,"墓地")
	CALL CARD_SP_SUMMON(決闘者,"手札",場所)
	RETURN 0
ENDIF

IF 種類 == 召喚時 || 種類 == 特殊召喚時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46480,2)
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件カテゴリ:0 = 星竜
	効果条件カテゴリ:1 = 超星
	効果条件種類 = モン全般
	効果条件召喚可 = 1
	CALL CARD_SP_SUMMON_ADV(決闘者,ゾーン,場所)
	RETURN 0
ENDIF

IF 種類 == 戦場起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46480,3)
	CALL CARD_DISPOSE(決闘者,"戦場",場所,墓地行き)
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件カテゴリ = 超星
	効果条件種類 = モン全般
	効果条件召喚可 = 1
	CALL CARD_CHOOSE_ADV(決闘者,ゾーン,場所)
	IF RESULT == 9999 || RESULT == 0
		RETURN 0
	ENDIF
	CALL CARD_SELECT(決闘者,RESULT)
	選択カードID = GETVAR(@"%対象者（CS）%_%参照先（CS）%:{選択カード（CS）}")

	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件ID = 選択カードID
	CALL CARD_SP_SUMMON(決闘者,"墓地",場所)

	個数 = モンスター数(決闘者)
	SIF 個数 >= 1
	
	CALL FULLRESET
	効果範囲戦場 = 1
	効果条件ID = 選択カードID
	CALL CARD_CHOOSE_ADV(決闘者,ゾーン,場所)
	IF RESULT != 9999 && RESULT != 0
		CALL CARD_SELECT(決闘者,RESULT)
		CALL SET_FIELD_INFO(対象者（CS）,参照先（CS）,選択カード（CS）,"個Ｃ",個数)
	ENDIF

ENDIF

RETURN 0
