;========================================
; 46471_煌藺天蠍 スピニア・スコール
;========================================

@CARDNAME_46471,参照先
#DIMS DYNAMIC 参照先
VARSET RESULTS
SELECTCASE 参照先
    CASE "名前"
        RESULTS = 煌藺天蠍 スピニア・スコール
    CASE "略称"
        RESULTS = 煌藺スピア
    CASE "カテゴリ"
        RESULTS:0 = CoZ12
        RESULTS:1 = 光導
        RESULTS:2 = 詩姫
	CASE "出典作品"
		RESULTS:0 = バトルスピリッツ
ENDSELECT
RETURN 0


@CARD_46471(参照先)
#DIMS DYNAMIC 参照先
SELECTCASE 参照先
    CASE "種類"
        RETURN シンクロ
    CASE "属性"
        RETURN 水属性
    CASE "種族"
        RETURN 昆虫族
    CASE "レベル"
        RETURN 9
    CASE "攻撃力"
        RETURN 2500
    CASE "守備力"
        RETURN 2000
    CASE "性別"
        RETURN 牝性
	CASE "追加日"
		RETURN 250814
ENDSELECT
RETURN 0


@CARDSUMMON_46471(決闘者,召喚カード,EX参照)
#DIMS DYNAMIC 決闘者
#DIM  DYNAMIC 召喚カード
#DIM  DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要レベル数 = 9

IF EX参照 == 0 || EX参照 == 1
    素材条件チューナー = 1
	素材条件カテゴリ = CoZ12
ELSEIF EX参照 >= 10
    素材条件チューナー = -1 
ENDIF


IF EX参照 == 1
    CALL SYNCAN(決闘者, 召喚カード, 46471)
    RETURN RESULT
ENDIF

RETURN 0



@CARD_EXPLANATION_46471(種類)
#DIM DYNAMIC 種類
PRINTL 「CoZ12」チューナー＋チューナー以外のモンスター１体以上
PRINTL このカードはS召喚及び以下の方法でのみ特殊召喚できる。
PRINTL このカード名の①の効果は１ターンに１度しか使用できない。

CALLFORM CARD_ABLE(0,EXデッキ起動)
PRINTL ●『煌臨』「天蠍神姫 スピニア・スコール」
PRINTL 自分ターンに、自分フィールドの「創界神」のコアカウンターを１つ取り除き、
PRINTL フィールドの「天蠍神姫 スピニア・スコール」１体をリリースして発動できる。
PRINTL このカードをＥＸデッキから特殊召喚する。

CALLFORM CARD_ABLE(1,戦場起動,フリー誘発)
PRINTL ①：相手フィールドのカード１枚を対象として発動できる。
PRINTL 自分の「創界神」からコアカウンターを１つ取り除き、そのカードを破壊する。
PRINTL この効果は相手ターンでも発動できる。

CALLFORM CARD_ABLE(2,攻撃時誘発)
PRINTL ②：自分フィールドの「CoZ12」を持つモンスターの攻撃宣言時に発動できる。
PRINTL 相手モンスター１体を手札に戻す。

CALLFORM CARD_ABLE(3,攻守変動)
PRINTL ③：このカードがフィールドに存在する限り、
PRINTL 自分フィールドのモンスターの攻撃力は１０００アップする。
RETURN 0


@CARDCAN_46471(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所
#DIM  DYNAMIC atk_id

IF 種類 == EXデッキ起動
    SIF ゾーン != "EXデッキ"
        RETURN 0
    SIF ターンプレイヤー != 決闘者 || メインフェイズ != 1
        RETURN 0
    SIF モンスター数(決闘者) == 5
        RETURN 0
    CALL FULLRESET
    効果範囲戦場 = 1
    効果条件名前 = 天蠍神姫 スピニア・スコール
    効果条件CNT  = 1
    CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
    SIF RESULT != 1
        RETURN 0
    CALL FULLRESET
    効果範囲魔罠 = 1
    効果条件カテゴリ = 創界神
    効果条件個Ｃ所持 = 1
    効果条件CNT      = 1
    CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
    SIF RESULT != 1
        RETURN 0
    RETURN 1
ENDIF

IF 種類 == 戦場起動 || 種類 == フリー誘発
    SIF ゾーン != "戦場"
        RETURN 0
    SIF 発動済_1(決闘者,46471)
        RETURN 0
    CALL FULLRESET
    効果範囲魔罠 = 1
    効果条件カテゴリ = 創界神
    効果条件個Ｃ所持 = 1
    効果条件CNT      = 1
    CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
    SIF RESULT != 1
        RETURN 0
    CALL FULLRESET
    効果範囲相手戦場 = 1
    効果範囲相手魔罠 = 1
    効果条件種類     = モン全般
    効果条件種類:1   = 魔罠全般
    効果条件CNT      = 1
    CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
    SIF RESULT != 1
        RETURN 0
    RETURN 1
ENDIF

IF 種類 == 攻撃時誘発
    SIF ゾーン != "戦場"
        RETURN 0
    SIF ターンプレイヤー != 決闘者
        RETURN 0
    atk_id = 戦闘カードID(決闘者)
    SIF atk_id <= 0
        RETURN 0
    TRYCALLFORM CARDNAME_{atk_id}("カテゴリ")
    SIF MATCH(RESULTS,"CoZ12") == 0
        RETURN 0
    CALL FULLRESET
    効果範囲相手戦場 = 1
    効果条件種類 = モン全般
    効果条件CNT  = 1
    CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
    SIF RESULT != 1
        RETURN 0
    RETURN 1
ENDIF

IF 種類 == 攻守変動
    SIF ゾーン != "戦場"
        RETURN 0
    RETURN 1
ENDIF

RETURN 0


@CARDEFFECT_46471(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所

IF 種類 == EXデッキ起動
    CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46471,0)

    CALL FULLRESET
    効果範囲魔罠 = 1
    効果条件カテゴリ = 創界神
    効果条件個Ｃ所持 = 1
    CALL CARD_CHOOSE_ADV(決闘者,ゾーン,場所)
    SIF RESULT == 9999
        RETURN 0
    CALL CARD_SELECT(決闘者,RESULT)
    CALL SET_FIELD_INFO(対象者（CS）,参照先（CS）,選択カード（CS）,"個Ｃ",-1)

    CALL FULLRESET
    効果範囲戦場 = 1
    効果条件名前 = 天蠍神姫 スピニア・スコール
    効果条件複数 = 1
    CALL CARD_CHOOSE_ADV(決闘者,ゾーン,場所)
    SIF RESULT != 1
        RETURN 0

    CALL FULLRESET
    効果範囲EXデッキ = 1
    効果条件固ID     = 46471
    CALL CARD_SP_SUMMON(決闘者,"EXデッキ",場所)
    RETURN 0
ENDIF

IF 種類 == 戦場起動 || 種類 == フリー誘発
    CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46471,1)

    CALL FULLRESET
    効果範囲魔罠 = 1
    効果条件カテゴリ = 創界神
    効果条件個Ｃ所持 = 1
    CALL CARD_CHOOSE_ADV(決闘者,ゾーン,場所)
    SIF RESULT == 9999
        RETURN 0
    CALL CARD_SELECT(決闘者,RESULT)
    CALL SET_FIELD_INFO(対象者（CS）,参照先（CS）,選択カード（CS）,"個Ｃ",-1)

    CALL FULLRESET
    効果範囲相手戦場 = 1
    効果範囲相手魔罠 = 1
    効果条件種類     = モン全般
    効果条件種類:1   = 魔罠全般
    効果条件複数     = 1
    CALL CARD_REMOVAL_ADV(決闘者,"単体除去",場所,"墓地")
    RETURN 0
ENDIF

IF 種類 == 攻撃時誘発
    CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46471,2)
    CALL FULLRESET
    効果範囲相手戦場 = 1
    効果条件種類     = モン全般
    効果条件任意     = 1
    CALL CARD_CHOOSE_ADV(決闘者,ゾーン,場所)
    SIF RESULT == 9999
        RETURN 0
    CALL FULLRESET
    効果範囲相手戦場 = 1
    CALL CARD_REMOVAL_BASIC(決闘者,"戦場単体",場所,"手札")
    RETURN 0
ENDIF

IF 種類 == 攻守変動
    CALL FULLRESET
    効果範囲戦場 = 1
    効果条件種類 = モン全般
    CALL STATCHANGE_BASIC(決闘者,"戦場",場所,1000)
    RETURN 0
ENDIF

RETURN 0