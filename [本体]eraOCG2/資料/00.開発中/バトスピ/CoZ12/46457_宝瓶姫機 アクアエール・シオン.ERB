; ============================================================
; 46457_宝瓶姫機 アクアエール・シオン
; ============================================================

@CARDNAME_46457,参照先
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS
SELECTCASE 参照先
	CASE "名前"
		RESULTS = 宝瓶姫機 アクアエール・シオン
	CASE "略称"
		RESULTS = エリシオン
	CASE "カテゴリ"
		RESULTS:0 = CoZ12
		RESULTS:1 = 光導
		RESULTS:2 = 詩姫
	CASE "出典作品"
		RESULTS:0 = バトルスピリッツ
ENDSELECT
RETURN 0


@CARD_46457(参照先)
#DIMS DYNAMIC 参照先
SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "分割"
		RETURN ペンデュラム
	CASE "属性"
		RETURN 地属性
	CASE "種族"
		RETURN 機械族
	CASE "レベル"
		RETURN 7
	CASE "攻撃力"
		RETURN 2100
	CASE "守備力"
		RETURN 2400
	CASE "性別"
		RESULTS = 牝性
	CASE "追加日"
		RETURN 250814
ENDSELECT
RETURN 0


@CARD_EXPLANATION_46457(種類)
#DIM DYNAMIC 種類

CALL TEXT_DECORATION("P_MAGIC")
PRINTL このカード名の①②③のＰ効果はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(11,永続効果)
PRINTL ①：このカードが魔法＆罠ゾーンに存在する限り、
PRINTL 自分フィールドの「光導」モンスターは効果の対象にならず、１ターンに１度、戦闘・効果では破壊されない。
CALLFORM CARD_ABLE(12,魔罠起動)
PRINTL ②：自分メインフェイズに、自分の「光導の創界神帝 レピィ・アーズ」からコアカウンターを１つ取り除いて発動できる。
PRINTL このカードを自分のモンスターゾーンに特殊召喚する。
CALLFORM CARD_ABLE(13,効果後誘発)
PRINTL ③：相手がモンスターを特殊召喚した場合に発動できる。
PRINTL 自分の「創界神」にコアカウンターを１つ置き、このカードを自分のモンスターゾーンに特殊召喚する。

CALL TEXT_DECORATION("P_MAGIC_2")
CALLFORM CARD_ABLE(21,永続効果)
PRINTL ①：このカードがモンスターゾーンに存在する限り、
PRINTL 相手は墓地からモンスターを特殊召喚できず、相手のモンスターは表示形式を変更できない。
RETURN 0


@CARDCAN_46457(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所
#DIM  DYNAMIC 選択カードID

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,46457)
SIF RESULT == 1
	RETURN 0

;―― 手札からP設置
IF 種類 == 手札起動
	SIF ゾーン != "手札"
		RETURN 0
	SIF メインフェイズ != 1 || ターンプレイヤー != 決闘者
		RETURN 0
	SIF 魔罠数(決闘者) >= 5
		RETURN 0
	RETURN 1
ENDIF

IF 種類 == 永続効果 && ゾーン == "魔罠"
	選択カードID = GETVAR(@"%決闘者%_魔罠:場所")
	SIF 選択カードID != 46457
		RETURN 0
	RETURN 1
ENDIF

IF 種類 == 魔罠起動
	SIF ゾーン != "魔罠"
		RETURN 0
	SIF 発動済_2(決闘者,46457)
		RETURN 0
	SIF メインフェイズ != 1 || ターンプレイヤー != 決闘者
		RETURN 0
	CALL FULLRESET
	効果範囲魔罠   = 1
	効果条件名前   = 光導の創界神帝 レピィ・アーズ
	効果条件個Ｃ所持 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	RETURN RESULT
ENDIF

IF 種類 == 効果後誘発
	SIF ゾーン != "魔罠"
		RETURN 0
	SIF 発動済_3(決闘者,46457)
		RETURN 0
	CALL FULLRESET
	CALL CARD_CHECK_FIN_DATA(決闘者,"特殊召喚",1)
	RETURN RESULT
ENDIF

;―― モンス①：戦場常在
IF 種類 == 永続効果 && ゾーン == "戦場"
	選択カードID = GETVAR(@"%決闘者%_戦場:場所")
	SIF 選択カードID != 46457
		RETURN 0
	RETURN 1
ENDIF

RETURN 0


@CARDEFFECT_46457(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所
#DIM  DYNAMIC 枚数
#DIM  DYNAMIC 選択カードID

IF 種類 == 手札起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46457,0)
	CALL CARD_DISPOSE(決闘者,ゾーン,場所,魔罠行き)
	RETURN 0
ENDIF

IF 種類 == 永続効果 && ゾーン == "魔罠"
    選択カードID = GETVAR(@"%決闘者%_魔罠:場所")
	SIF 選択カードID != 46457
        RETURN 0
	CALL FULLRESET
	効果範囲戦場     = 1
	効果条件種類     = モン全般
	効果条件カテゴリ = 光導
	CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"一破")
	CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"対耐")
	RETURN 0
ENDIF

IF 種類 == 魔罠起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46457,12)

	CALL FULLRESET
	効果範囲魔罠   = 1
	効果条件名前   = 光導の創界神帝 レピィ・アーズ
	効果条件個Ｃ所持 = 1
	CALL CARD_CHOOSE_ADV(決闘者,"魔罠",場所)
	IF RESULT == 9999
		RETURN 0
	ENDIF
	CALL CARD_SELECT(決闘者,RESULT)
	CALL SET_FIELD_INFO(対象者（CS）,参照先（CS）,選択カード（CS）,"個Ｃ",-1)

	選択カードID = GETVAR(@"%決闘者%_魔罠:場所")
	IF 選択カードID > 0
		CALL FULLRESET
		効果範囲魔罠   = 1
		効果条件召喚可 = 1
		CALL CARD_SP_SUMMON(決闘者, "魔罠", 場所)
	ENDIF
ENDIF

IF 種類 == 効果後誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46457,13)

	CALL FULLRESET
	効果範囲戦場 = 1
	効果範囲魔罠 = 1
	効果条件カテゴリ = 創界神
	CALL CARD_CHOOSE_ADV(決闘者,"全場",場所)
	IF RESULT != 9999
		CALL CARD_SELECT(決闘者,RESULT)
		CALL SET_FIELD_INFO(対象者（CS）,参照先（CS）,選択カード（CS）,"個Ｃ",1)
		CALL FULLRESET
		効果範囲魔罠   = 1
		効果条件召喚可 = 1
		CALL CARD_SP_SUMMON(決闘者, "魔罠", 場所)
	ENDIF
ENDIF

IF 種類 == 永続効果 && ゾーン == "戦場"
    選択カードID = GETVAR(@"%決闘者%_戦場:場所")
	SIF 選択カードID != 46457
        RETURN 0
	CALL SET_PLAYER_INFO(決闘者,"SS召喚禁止墓地",3,1)
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(決闘者,"相手戦場",場所,"表固")
ENDIF

