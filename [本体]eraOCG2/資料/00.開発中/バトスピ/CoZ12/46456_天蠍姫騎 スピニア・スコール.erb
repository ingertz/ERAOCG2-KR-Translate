; ============================================================
; 46456_天蠍姫騎 スピニア・スコール
; ============================================================

@CARDNAME_46456,参照先
#DIMS DYNAMIC 参照先
VARSET RESULTS
SELECTCASE 参照先
	CASE "名前"
		RESULTS = 天蠍姫騎 スピニア・スコール
	CASE "略称"
		RESULTS = スコルスピア
	CASE "カテゴリ"
		RESULTS:0 = CoZ12
		RESULTS:1 = 光導
		RESULTS:2 = 詩姫
		RESULTS:4 = バトルスピリッツ
ENDSELECT
RETURN 0


@CARD_46456(参照先)
#DIMS DYNAMIC 参照先
SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "分割"
		RETURN ペンデュラム
	CASE "属性"
		RETURN 水属性
	CASE "種族"
		RETURN 昆虫族
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 2000
	CASE "守備力"
		RETURN 1700
	CASE "性別"
		RETURN 牝性
	CASE "追加日"
		RETURN 250814
ENDSELECT
RETURN 0


@CARD_EXPLANATION_46456(種類)
#DIM DYNAMIC 種類

CALL TEXT_DECORATION("P_MAGIC")
PRINTL このカード名の①②③のＰ効果はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,効果後誘発)
PRINTL ①：自分フィールドに「光導」モンスターが特殊召喚された場合に、相手フィールドのカード１枚を対象として発動できる。
PRINTL そのカードを破壊する。
CALLFORM CARD_ABLE(2,魔罠起動)
PRINTL ②：自分メインフェイズに発動できる。
PRINTL 自分の「光導の創界神帝 レピィ・アーズ」からコアカウンターを１つ取り除き、このカードを自分のモンスターゾーンに特殊召喚する。
CALLFORM CARD_ABLE(3,攻撃後誘発)
PRINTL ③：相手モンスターが攻撃を行ったダメージステップ終了時に発動できる。
PRINTL 自分の「創界神」にコアカウンターを１つ置き、このカードを自分のモンスターゾーンに特殊召喚する。

CALL TEXT_DECORATION("P_MAGIC_2")
PRINTL このカード名の①②の効果はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(11,特殊召喚時)
PRINTL ①：このカードが特殊召喚した場合に発動できる。
PRINTL 相手フィールドのコスト２以下のモンスターを全てデッキに戻す。
PRINTL この効果でデッキに戻すモンスターのコストの上限は自分フィールドの「CoZ12」カード１枚につき＋１する。
PRINTL （コスト２はレベル・ランク・リンク２のカードを指す）
CALLFORM CARD_ABLE(12,攻撃時誘発)
PRINTL ②：自分フィールドの「CoZ12」を持つモンスターが戦闘を行う場合に、相手モンスター１体を対象として発動できる。
PRINTL そのモンスターの攻撃力を５００ダウンする。
RETURN 0


@CARDSUMMON_AA_46456


@CARDCAN_46456(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM  DYNAMIC 上限コスト

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,46456)
SIF RESULT == 1
	RETURN 0

IF 種類 == 手札起動
	SIF ゾーン != "手札"
		RETURN 0
	SIF メインフェイズ != 1 || ターンプレイヤー != 決闘者
		RETURN 0
	SIF 魔罠数(決闘者) >= 5
		RETURN 0
	RETURN 1
ENDIF

IF 種類 == 効果後誘発 && ゾーン == "魔罠"
    CALL CARD_CHECK_FIN_DATA(決闘者,"特殊召喚")
    SIF RESULT != 1
        RETURN 0

    CALL FULLRESET
    効果範囲戦場   = 1
    効果条件カテゴリ = 光導
    効果条件召種   = 召種全特殊
    効果条件CNT    = 1
    CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
    SIF RESULT != 1
        RETURN 0

    CALL FULLRESET
    効果範囲相手戦場 = 1
    効果条件CNT      = 1
    CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
    IF RESULT != 1
        CALL FULLRESET
        効果範囲相手魔罠 = 1
        効果条件CNT      = 1
        CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
        SIF RESULT != 1
            RETURN 0
    ENDIF

    RETURN 1
ENDIF

IF 種類 == 魔罠起動
	SIF ゾーン != "魔罠"
		RETURN 0
    SIF 発動済_2(決闘者,46456)
        RETURN 0
    SIF メインフェイズ != 1
        RETURN 0
    SIF ターンプレイヤー != 決闘者
        RETURN 0
    CALL FULLRESET
    効果範囲魔罠   = 1
    効果条件名前 = 光導の創界神帝 レピィ・アーズ
    効果条件個Ｃ所持 = 1
    CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
    RETURN RESULT
ENDIF


IF 種類 == 攻撃後誘発 && ゾーン == "魔罠"
	SIF 発動済_3(決闘者,46456)
		RETURN 0
	SIF ターンプレイヤー == 決闘者
		RETURN 0
	CALL FULLRESET
	効果範囲戦場 = 1
	効果範囲魔罠 = 1
	効果条件カテゴリ = 創界神
	効果条件CNT = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	RETURN RESULT
ENDIF

IF 種類 == 特殊召喚時
	RETURN 1
ENDIF

IF 種類 == 攻撃時誘発
   SIF ゾーン != "戦場"
       RETURN 0
	CALL FULLRESET
	効果範囲戦場 = 1
	効果条件カテゴリ = CoZ12
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	CALL FULLRESET
	効果範囲相手戦場 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	RETURN RESULT
ENDIF

RETURN 0


@CARDEFFECT_46456(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM  DYNAMIC 選択カードID
#DIM  DYNAMIC CoZ数
#DIM  DYNAMIC 上限コスト
#DIM  DYNAMIC カウンタ
CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 手札起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46456,0)
	CALL CARD_DISPOSE(決闘者,ゾーン,場所,魔罠行き)
	RETURN 0
ENDIF

IF 種類 == 効果後誘発 && ゾーン == "魔罠"
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46456,1)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲相手戦場 = 1
		効果条件CNT = 1
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(決闘者,"戦場単体",場所,"墓地")
		ELSE
			CALL FULLRESET
			効果範囲相手魔罠 = 1
			効果条件CNT = 1
			CALL CARD_REMOVAL_BASIC(決闘者,"魔罠単体",場所,"墓地")
		ENDIF
	ENDIF
	RETURN 0
ENDIF

IF 種類 == 魔罠起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46456,2)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲魔罠 = 1
		効果条件名前 = 光導の創界神帝 レピィ・アーズ
		効果条件個Ｃ所持 = 1
		CALL CARD_CHOOSE_ADV(決闘者,"魔罠",場所)
		IF RESULT != 9999
			CALL CARD_SELECT(決闘者,RESULT)
			CALL SET_FIELD_INFO(対象者（CS）,参照先（CS）,選択カード（CS）,"個Ｃ",-1)
			CALL FULLRESET
			効果範囲魔罠   = 1
			効果条件召喚可 = 1
			CALL CARD_SP_SUMMON(決闘者, "魔罠", 場所)
		ENDIF
	ENDIF
	RETURN 0
ENDIF

IF 種類 == 攻撃後誘発 && ゾーン == "魔罠"
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46456,3)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲戦場 = 1
		効果範囲魔罠 = 1
		効果条件カテゴリ = 創界神
		CALL CARD_CHOOSE_ADV(決闘者,"全場",場所)
		IF RESULT != 9999
			CALL CARD_SELECT(決闘者,RESULT)
			CALL SET_FIELD_INFO(対象者（CS）,参照先（CS）,選択カード（CS）,"個Ｃ",1)
			CALL FULLRESET
			効果範囲魔罠   = 1
			効果条件召喚可 = 1
			CALL CARD_SP_SUMMON(決闘者, "魔罠", 場所)
		ENDIF
	ENDIF
	RETURN 0
ENDIF

IF 種類 == 特殊召喚時
	CALL FULLRESET
	効果範囲戦場 = 1
	効果範囲魔罠 = 1
	効果条件カテゴリ = CoZ12
	効果条件CNT = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	CoZ数 = RESULT
	上限コスト = 2 + CoZ数

	FOR カウンタ,0,5
		SIF GETVAR(@"%対面者%_戦場:カウンタ") == -1
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_星:カウンタ") > 上限コスト
			CONTINUE
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(決闘者,"自動処理",カウンタ,"デッキ")
	NEXT
	RETURN 0
ENDIF

IF 種類 == 攻撃時誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46456,12)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲相手戦場 = 1
		効果条件CNT = 1
		CALL CARD_CHOOSE_ADV(決闘者,ゾーン,場所)
		IF RESULT != 9999
			CALL CARD_SELECT(決闘者, RESULT)
			選択カードID = GETVAR(@"%対象者（CS）%_%参照先（CS）%:{選択カード（CS）}")
			CALL FULLRESET
			効果範囲相手戦場 = 1
			効果条件ID = 選択カードID
			CALL STATCHANGE_EFFECT(対面者,"戦場",場所,"一攻",-500) ;
		ENDIF
	ENDIF
	RETURN 0
ENDIF

RETURN 0