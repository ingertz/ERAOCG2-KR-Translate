; ============================================================
; 46462_光龍騎姫 ポロン・サジータ
; ============================================================

@CARDNAME_46462,参照先
#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS
SELECTCASE 参照先
	CASE "名前"
		RESULTS = 光龍騎姫 ポロン・サジータ
	CASE "略称"
		RESULTS = サジット
	CASE "カテゴリ"
		RESULTS:0 = CoZ12
		RESULTS:1 = 光導
		RESULTS:2 = 詩姫
		RESULTS:4 = バトルスピリッツ
ENDSELECT
RETURN 0


@CARD_46462(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 炎属性
	CASE "種族"
		RETURN ドラゴン族
	CASE "レベル"
		RETURN 12
	CASE "攻撃力"
		RETURN 3500
	CASE "守備力"
		RETURN 3000
	CASE "性別"
		RETURN 牝性
	CASE "追加日"
		RETURN 250814
ENDSELECT
RETURN 0


@CARD_EXPLANATION_46462(種類)
#DIM DYNAMIC 種類
PRINTL このカード名の①②の効果はそれぞれ１ターンに１度しか発動できない。
CALLFORM CARD_ABLE(1,手札起動)
PRINTL ①：自分メインフェイズに発動できる。
PRINTL 自分の「光導の創界神帝 レピィ・アーズ」からコアカウンターを２つ取り除き、
PRINTL このカードを手札から特殊召喚する。
CALLFORM CARD_ABLE(2,戦場起動,フリー誘発)
PRINTL ②：バトルフェイズに発動できる。
PRINTL 自分の魔法＆罠ゾーンに存在する「光導」カードの枚数分、
PRINTL 相手フィールドのカードを破壊する。
PRINTL このカードが装備カードを装備している場合、この効果は相手ターンでも発動できる。
CALLFORM CARD_ABLE(3,攻撃時誘発)
PRINTL ③：このカードの攻撃宣言時に発動できる。
PRINTL このカードの攻撃力を５００アップする。
PRINTL その後、デッキの上からカードを５枚墓地へ送る。
PRINTL この効果で「CoZ12」カードが墓地へ送られた場合、
PRINTL このカードの攻撃回数を＋１する。
RETURN 0


@CARDCAN_46462(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM  DYNAMIC 枚数

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,46462)
SIF RESULT == 1
	RETURN 0

IF 種類 == 手札起動
	SIF ゾーン != "手札"
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF 発動済_1(決闘者,46462)
		RETURN 0
	SIF モンスター数(決闘者) == 5
		RETURN 0
	CALL FULLRESET
	効果範囲魔罠 = 1
	効果条件名前   = 光導の創界神帝 レピィ・アーズ
	効果条件個Ｃ所持 = 2
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 種類 == 戦場起動 || 種類 == フリー誘発
	SIF 発動済_2(決闘者,46462)
		RETURN 0
	SIF ゾーン != "戦場"
		RETURN 0
	SIF バトルフェイズ != 1
		RETURN 0
	CALL FULLRESET
	効果範囲魔罠   = 1
	効果条件カテゴリ = 光導
	効果条件CNT     = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT < 1
		RETURN 0
	CALL FULLRESET
	効果範囲相手戦場 = 1
	効果範囲相手魔罠 = 1
	効果条件種類     = モン全般
	効果条件種類:1   = 魔罠全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	CALL CARD_EQUIP_CHECK(決闘者,場所,ゾーン)
	IF RESULT != 1
		SIF 種類 == フリー誘発
			RETURN 0
		SIF ターンプレイヤー != 決闘者
			RETURN 0
	ENDIF
	RETURN 1

ELSEIF 種類 == 攻撃時誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF 戦闘カードID(決闘者) != 46462
		RETURN 0
	RETURN 1
ENDIF
RETURN 0


@CARDEFFECT_46462(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM  DYNAMIC 種類
#DIM  DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM  DYNAMIC 個数
#DIM  DYNAMIC 枚数


CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 手札起動
	CALL FULLRESET
	効果範囲魔罠 = 1
	効果条件名前 = 光導の創界神帝 レピィ・アーズ
	効果条件個Ｃ所持 = 2
	CALL CARD_CHOOSE_ADV(決闘者,ゾーン,場所)
	IF RESULT == 9999
		RETURN 0
	ENDIF

	CALL CARD_SELECT(決闘者,RESULT)
	CALL SET_FIELD_INFO(対象者（CS）,参照先（CS）,選択カード（CS）,"個Ｃ",-2)

		CALL FULLRESET
		効果範囲手札   = 1
		効果条件ID     = 46462
		効果条件召喚可 = 1
		CALL CARD_SP_SUMMON(決闘者,"手札",場所)
		RETURN 0

ELSEIF 種類 == 戦場起動 || 種類 == フリー誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,46462,2)
	CALL FULLRESET
	効果範囲魔罠   = 1
	効果条件カテゴリ = 光導
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	枚数 = RESULT
	SIF 枚数 < 1
		RETURN 0
	CALL FULLRESET
	効果範囲相手戦場 = 1
	効果範囲相手魔罠 = 1
	効果条件種類   = モン全般
	効果条件種類:1   = 魔罠全般
	効果条件任意 = 0
	効果条件複数 = 枚数
	CALL CARD_REMOVAL_ADV(決闘者,"単体除去",場所,"墓地")
	RETURN 0

ELSEIF 種類 == 攻撃時誘発
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"一攻",500)

	CALL FULLRESET
	効果範囲墓地     = 1
	効果条件カテゴリ = CoZ12
	効果条件CNT      = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	個数 = RESULT

	CALL CARD_DECK_DISPOSE(決闘者,"デッキ",5,効果墓地行き,0)

	CALL FULLRESET
	効果範囲墓地     = 1
	効果条件カテゴリ = CoZ12
	効果条件CNT      = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT > 個数
		CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"戦",1)

	RETURN 0
ENDIF

RETURN 0