@CARDNAME_71705,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 霊神の聖殿
	CASE "略称"
		RESULTS = 霊神の聖殿
	CASE "カテゴリ"
		RESULTS:0 = 霊神
ENDSELECT


@CARD_71705(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN フィールド
	CASE "追加日"
		RETURN 251030
ENDSELECT

RETURN 0

@CARD_EXPLANATION_71705(種類)
#DIM DYNAMIC 種類

PRINTL 自分フィールドは「霊神の聖殿」となる。
PRINTL このカード名の③の効果は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ①：自分フィールドのモンスターの攻撃力・守備力は、自分の墓地のモンスターの属性の種類×２００アップする。
PRINTL この効果で属性の種類を数える際には、通常召喚可能な「エレメントセイバー」モンスターを任意の属性のモンスターとして扱う事ができる。
CALL CARD_ABLE(10,魔罠起動)
PRINTL ②：１ターンに１度、メインフェイズ１に発動できる。デッキから「エレメントセイバー」モンスター１体を手札に加える。
PRINTL この効果の発動後、ターン終了時まで自分は「霊神」・「エレメントセイバー」モンスターでしか攻撃できない。
CALL CARD_ABLE(3,他効果起動)
PRINTL ③：このカードがフィールドゾーンに存在する状態で、自分の「エレメントセイバー」モンスターが
PRINTL 効果を発動するために手札のモンスターを墓地へ送る場合、代わりにデッキから墓地へ送る事ができる。

@CARDCAN_71705(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 条件達成
#DIM DYNAMIC カウンタ

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,71705)
SIF RESULT == 1
	RETURN 0

IF 種類 == 魔罠起動 && GETVAR(@"%決闘者%_魔_表:場所") == 1
	SIF 効果発動済(決闘者,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF メインフェイズ２ == 1
		RETURN 0
	CALL FULLRESET
	効果範囲デッキ = 1
	効果条件種類 = モン全般
	効果条件カテゴリ = エレメントセイバー
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 魔罠起動 || 種類 == 手札起動
	CALL CARD_CONT_M(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 永続効果	|| 種類 == 攻守変動
	SIF ゾーン != "魔罠"
		RETURN 0
	SIF GETVAR(@"%決闘者%_魔_表:場所") >= 2
		RETURN 0
	RETURN 1
ELSEIF 種類 == 短紋章起動
	RETURN 1
ENDIF

@CARDEFFECT_71705(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 条件達成
#DIM DYNAMIC 属性数
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 複数属性, 8

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 魔罠起動 && GETVAR(@"%決闘者%_魔_表:場所") == 1
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,71705,10)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲デッキ = 1
		効果条件カテゴリ = エレメントセイバー
		効果条件種類 = モン全般
		CALL CARD_ADD_ADV(決闘者,ゾーン,場所)
		
		;「エレメントセイバー」にも「霊神」カテゴリを入れたので、攻撃の制約を「霊神」カテゴリ縛りで設定
		;CALL FULLRESET
		;CALL CARD_ATK_RESTRICTION(決闘者,"霊神")
		CALL CARD_RESERV(決闘者,71705,短紋章予約)
	ENDIF
ELSEIF 種類 == 魔罠起動 || 種類 == 手札起動
	;カード発動＆設置まで
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,71705)
	IF RESULT == 0
		CALL CARD_DISPOSE(決闘者,ゾーン,場所,魔罠行き)
	ENDIF
ELSEIF 種類 == 攻守変動
	;属性変更効果を持つエレメントセイバー以外のモンスターの属性数をカウント。
	CALL FULLRESET
	効果条件固カテゴリ = エレメントセイバー
	効果条件スーパー名前:0 = エレメントセイバー・ウィラード
	効果条件スーパー名前:1 = エレメントセイバー・ケラウィニ
	CALL ELEMENTS_KIND_BASIC(決闘者,"墓地",複数属性)
	;ELEMENTS_KIND_BASICは一部の効果条件のみ対応。
	属性数 = RESULT:1
	
	;그 후、属性変更効果を持つエレメントセイバーモンスターの数をカウントして属性数に加算する。
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件カテゴリ = エレメントセイバー
	効果条件種類 = 効果モン
	効果条件CNT = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	属性数 += RESULT
	
	;属性数が７以上になっていたら７に補正する。
	SIF 属性数 >= 7
		属性数 = 7
	
	攻撃力修正 = 属性数 * 200
	CALL FULLRESET
	CALL STATCHANGE_BASIC(決闘者,"戦場",場所,攻撃力修正,攻撃力修正)
ELSEIF 種類 == 永続効果
	CALL SET_FIELD_MAGIC_INFO(決闘者, "霊神の聖殿")
ELSEIF 種類 == 短紋章起動
	CALL FULLRESET
	効果条件固カテゴリ:0 = エレメントセイバー
	効果条件固カテゴリ:1 = 霊神
	CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"戦無",1)
ENDIF
