@CARDNAME_23332,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = エレメントセイバー・マロー
	CASE "略称"
		RESULTS = ElmS・マロー
	CASE "カテゴリ"
		RESULTS:0 = エレメントセイバー
		RESULTS:1 = エレメント
		;カテゴリ縛りのSS、EX召喚のために設定
		RESULTS:4 = 霊神
ENDSELECT


@CARD_23332(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 炎属性
	CASE "種族"
		RETURN 戦士族
	CASE "レベル"
		RETURN 3
	CASE "攻撃力"
		RETURN 1700
	CASE "守備力"
		RETURN 200
	CASE "霊神属性"
		RETURN 1
	CASE "性別"
		RETURN 雄性
	CASE "追加日"
		RETURN 251030
ENDSELECT

RETURN 0

@CARD_EXPLANATION_23332(種類)
#DIM DYNAMIC 種類

PRINTL このカード名の①の効果は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,手札起動)
PRINTL ①：手札のこのカードを墓地へ送って発動できる。
PRINTL （この効果を発動するターン、自分は「霊神」・「エレメントセイバー」モンスターしかＥＸデッキから特殊召喚できない。）
PRINTL 自分の墓地から「エレメントセイバー・マロー」以外の「エレメントセイバー」モンスター１体を手札に加える。
PRINTL 그 후、手札から「エレメントセイバー」モンスター１体を召喚できる。
CALLFORM CARD_ABLE(10,戦場起動)
PRINTL ②：１ターンに１度、手札から「エレメントセイバー」モンスター１体を墓地へ送って発動できる。
PRINTL 自分のデッキから「エレメントセイバー・マロー」以外の「霊神」・「エレメントセイバー」モンスター１体を墓地へ送る。
CALLFORM CARD_ABLE(0,永続効果)
PRINTL ③：墓地のこのカードは全ての属性のモンスターとして扱う。

;「エレメントセイバー」の展開力を支える有能な戦士。①の効果で自身と墓地の「エレメントセイバー」モンスターを交換しつつ追加召喚もできる。
;この効果には「するターン」縛りがついているため、これを使用するターンは汎用リンクモンスター等に頼れなくなってしまう点は注意が必要。
;戦場起動の効果で墓地肥やしも可能なため盤面に出力してもいいのだが、流石に他の初動役になるモンスターに比べたら優先順位は下がる。


@CARDCAN_23332(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 追加条件フラグ = 0

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,23332)
SIF RESULT == 1
	RETURN 0

IF 種類 == 手札起動
	SIF 発動済_1(決闘者,23332)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	;縛り
	CALL FULLRESET
	効果条件固カテゴリ:0 = 霊神
	効果条件固カテゴリ:1 = エレメントセイバー
	CALL CARD_CHECK_FIN_DATA(決闘者,"EX履歴")
	SIF RESULT != 0
		RETURN 0
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件カテゴリ:0 = 霊神
	効果条件カテゴリ:1 = エレメントセイバー
	効果条件種類 = モン全般
	効果条件固名前 = エレメントセイバー・マロー
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 戦場起動
	SIF 効果発動済(決闘者,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL FULLRESET
	効果範囲魔罠 = 1
	効果条件名前 = 霊神の聖殿
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT == 1 && !(発動済_3(決闘者,71705))
		追加条件フラグ |= 1
	CALL FULLRESET
	効果範囲手札 = 1
	SIF 追加条件フラグ & 1
		効果範囲デッキ = 1
	効果条件カテゴリ = エレメントセイバー
	効果条件種類 = モン全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	効果範囲デッキ = 1
	効果条件カテゴリ:0 = 霊神
	効果条件カテゴリ:1 = エレメントセイバー
	効果条件種類 = モン全般
	効果条件固名前 = エレメントセイバー・マロー
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_23332(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 追加条件フラグ = 0
#DIM DYNAMIC 手札枚数＿前
#DIM DYNAMIC 手札枚数＿後
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 手札起動
	;縛りを設定（後続処理の都合上先に設定）
	CALL FULLRESET
	CALL CARD_EX_RESTRICTION(決闘者,"霊神")
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,23332,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(決闘者,ゾーン,場所)
		CALL FULLRESET
		効果範囲墓地 = 1
		効果条件カテゴリ:0 = 霊神
		効果条件カテゴリ:1 = エレメントセイバー
		効果条件種類 = モン全般
		効果条件固名前 = エレメントセイバー・マロー
		CALL CARD_ADD_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			効果範囲手札 = 1
			効果条件カテゴリ = エレメントセイバー
			効果条件種類 = モン全般
			効果条件召喚可 = 1
			CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
			SIF RESULT != 1
				RETURN 0
			
			;戦場にモンスターがいない場合、レベル４以下しか選べない。
			CALL FULLRESET
			効果範囲戦場 = 1
			CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
			SIF RESULT != 1
				追加条件フラグ |= 1
			
			;追加で手札のエレメントセイバー１体を召喚する処理
			;参考：冥帝エレボス
			
			CALL FULLRESET
			効果条件カテゴリ = エレメントセイバー
			効果条件種類 = モン全般
			SIF 追加条件フラグ & 1
				CALL 効果条件レベル_ADV(4, "以下")
			効果条件任意 = 1
			CALL CARD_CHOOSE_BASIC(決闘者,"手札",ゾーン,場所)
			IF RESULT != 9999
				選択カード = RESULT
				選択カードID = RESULT:99
				TRYCALLFORM CARD_{選択カードID},"レベル"
				IF RESULT >= 5
					;レベル５以上の召喚の場合、自分フィールドのモンスター１体を墓地へ送る。
					CALL FULLRESET
					効果範囲戦場 = 1
					CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
					SIF	RESULT != 1
						RETURN 0
				ENDIF
				CALL CARD_SUMMON_SHORI(決闘者,選択カード,"攻撃表示",1)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 種類 == 戦場起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,23332,10)
	IF RESULT == 0
		手札枚数＿前 = 手札数(決闘者)
		CALL FULLRESET
		効果範囲魔罠 = 1
		効果条件名前 = 霊神の聖殿
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT == 1 && !(発動済_3(決闘者,71705))
			追加条件フラグ |= 1
		;手札のエレメントセイバーモンスターを墓地へ送る。(条件次第でデッキからも送れる)
		CALL FULLRESET
		効果範囲手札 = 1
		SIF 追加条件フラグ & 1
			効果範囲デッキ = 1
		効果条件カテゴリ = エレメントセイバー
		効果条件種類 = モン全般
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			;墓地へ送る前後で手札の枚数を確認し、減っていない場合はデッキから送ったと判定し霊神の神殿の効果③を使用した扱いに。
			手札枚数＿後 = 手札数(決闘者)
			IF 手札枚数＿前 == 手札枚数＿後
				;霊神の神殿の効果を発動した！
				SETCOLOR C_YELLOW
				PRINTFORML 「霊神の神殿」の効果によってデッキから直接モンスターを墓地へ送った！！
				RESETCOLOR
				CALL CARD_EFFECT_USE(決闘者,71705,3)
			ENDIF
			;デッキのモンスターを墓地送り
			CALL FULLRESET
			効果範囲デッキ = 1
			効果条件カテゴリ:0 = 霊神
			効果条件カテゴリ:1 = エレメントセイバー
			効果条件種類 = モン全般
			効果条件固名前 = エレメントセイバー・マロー
			CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		ENDIF
	ENDIF
ENDIF
