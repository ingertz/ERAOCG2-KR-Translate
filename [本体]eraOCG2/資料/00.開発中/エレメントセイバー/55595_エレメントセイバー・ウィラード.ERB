@CARDNAME_55595,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = エレメントセイバー・ウィラード
	CASE "略称"
		RESULTS = ElmS・ウィラード
	CASE "カテゴリ"
		RESULTS:0 = エレメントセイバー
		RESULTS:1 = エレメント
		;カテゴリ縛りのSS、EX召喚のために設定
		RESULTS:4 = 霊神
ENDSELECT


@CARD_55595(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 融合
	CASE "属性"
		RETURN 光属性
	CASE "種族"
		RETURN 戦士族
	CASE "レベル"
		RETURN 6
	CASE "攻撃力"
		RETURN 2400
	CASE "守備力"
		RETURN 2100
	CASE "特殊不可"
		RETURN 1
	CASE "単一存在"
		RETURN 1
	CASE "性別"
		RETURN 雄性
	CASE "レア度"
		RETURN ULR
	CASE "追加日"
		RETURN 251030
ENDSELECT

RETURN 0



@CARDSUMMON_55595(決闘者,召喚カード,EX参照)
#DIMS DYNAMIC 決闘者
#DIM DYNAMIC 召喚カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2

IF EX参照 == 0 || EX参照 == 1
	素材条件カテゴリ = 霊神
ELSEIF EX参照 >= 10
	素材条件名前 = エレメントセイバー・ラパウィラ
ENDIF


IF EX参照 == 1
	CALL FUSCAN(決闘者,召喚カード,55595) 
	RETURN RESULT
ENDIF


@CARD_EXPLANATION_55595(種類)
#DIM DYNAMIC 種類

PRINTL 「霊神」モンスター ＋ 「エレメントセイバー・ラパウィラ」
PRINTL 「エレメントセイバー・ウィラード」は、自分フィールドに１体しか表側表示で存在できず、融合召喚及び以下の方法でのみ特殊召喚できる。
CALLFORM CARD_ABLE(1,EXデッキ起動)
PRINTL ●自分の手札の「霊神」・「エレメントセイバー」モンスター２体を墓地へ送った場合にＥＸデッキから特殊召喚できる。
PRINTL 　自分フィールドに「エレメントセイバー」モンスターが存在する場合、「霊神」・「エレメントセイバー」以外のモンスターも１体まで墓地へ送る事ができる。
PRINTL 　（この方法による特殊召喚は１ターンに１度しか行えない。）
CALLFORM CARD_ABLE(0,永続効果)
PRINTL ①：モンスターゾーンのこのカードは特殊召喚の素材にできない。
CALLFORM CARD_ABLE(0,EX召喚時強制,特殊召喚時強制)
PRINTL ②：このカードが特殊召喚した場合に発動する。
PRINTL 自分の墓地の「霊神」・「エレメントセイバー」モンスターを２体まで選び、そのモンスターの属性に応じて、
PRINTL このモンスターがフィールドに存在する間、自分フィールドの「霊神」・「エレメントセイバー」モンスターに対して以下の効果を適用する。
PRINTL ●地または風：戦闘耐性を得て、攻撃力・守備力が３００アップする。
PRINTL ●水または炎：効果破壊耐性を得て、攻撃力・守備力が３００アップする。
PRINTL ●光または闇：対象耐性を得る。
CALLFORM CARD_ABLE(10,効果後誘発)
PRINTL ③：１ターンに１度、自分の墓地の「霊神」・「エレメントセイバー」モンスターと同じ属性を持つモンスターを
PRINTL 相手が特殊召喚した場合に発動できる。そのモンスターを破壊する。

;【エレメントセイバー】のエースモンスター。出すだけであればデッキに「エレメントセイバー」モンスターを多く採用すれば難しくはない。
;しかし似たような特殊召喚条件を持つ融合モンスターと比べて、コスト支払いは手札に限るためコストの誤魔化しや踏み倒しがしにくいのが難点。
;「霊神の聖殿」の③の使用はウィラードの召喚コストの支払いにも対応している。この処理は元々のOCGでも可能であるため効果再現でそうなっている。
;テーマとして「エレメントセイバー」モンスターを手札に集めやすいようになってはいるので、うまく効果を使ってかき集めてウィラードを出せるようにしたい。
;とはいえ、これを単体で出しても特殊召喚反応型モンスター破壊の１妨害で属性にも依存するので、出来るだけ墓地にテーマモンスターを送る事も必要になる。
;出した時に墓地に存在するテーマモンスターの中から耐性をつけるための属性を選べるので、出す前に墓地を肥やす動きをしてから降臨させるとよい。
;「聖殿」や永続魔法罠もしっかり構えたうえで降臨させれば、強固な耐性つきの妨害効果持ち大型モンスターとなり、なかなか突破されにくい盤面にできる。

;--------------------------------------------------------------------------------------------------
;【エレメントセイバー】は、弱いテーマで起こりがちな「手札に特殊召喚出来ない下級モンスターが固まってて、召喚権が足りず動けない」という状況に対して、
;「効果のコストとして使う」というアプローチをしたテーマ。と読み取ったので、その考えを元にテーマギミックのデザインを現代水準に見直している。
;--------------------------------------------------------------------------------------------------

@CARDCAN_55595(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 追加条件フラグ = 0
#DIM DYNAMIC 条件達成 = 0
#DIM DYNAMIC 複数属性, 8

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,55595)
SIF RESULT == 1
	RETURN 0

IF 種類 == EXデッキ起動
	SIF 発動済_1(決闘者,55595)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL CARD_EX_CHECK(決闘者,55595)
	SIF RESULT == 1
		RETURN 0
	
	CALL FULLRESET
	効果範囲魔罠 = 1
	効果条件名前 = 霊神の聖殿
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT == 1 && !(発動済_3(決闘者,71705))
		追加条件フラグ |= 1
	CALL FULLRESET
	効果範囲戦場 = 1
	効果条件カテゴリ = エレメントセイバー
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT == 1
		追加条件フラグ |= 2
	
	IF 追加条件フラグ & 2
		;アホほど条件ムズい。条件設定すげー見落としてそう感が凄い。テストでチェックする！
		;条件1：手札にモンスターが必要。
		;条件2：手札（＋条件フラグ&1でデッキ）にテーマモンスターが必要。
		;条件3：手札（＋条件フラグ&1でデッキ）に2体以上のモンスターが必要。
		CALL FULLRESET
		効果範囲手札 = 1
		効果条件種類 = モン全般
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
		CALL FULLRESET
		効果範囲手札 = 1
		SIF 追加条件フラグ & 1
			効果範囲デッキ = 1
		効果条件カテゴリ:0 = 霊神
		効果条件カテゴリ:1 = エレメントセイバー
		効果条件種類 = モン全般
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
		CALL FULLRESET
		効果範囲手札 = 1
		SIF 追加条件フラグ & 1
			効果範囲デッキ = 1
		効果条件種類 = モン全般
		効果条件CNT = 1
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT <= 1
			RETURN 0
	ELSE
		;テーマモンスター以外を素材にできない場合
		;条件1：手札にテーマモンスターが必要。
		;条件2：手札（＋条件フラグ&1でデッキ）にテーマモンスターが2体必要。
		CALL FULLRESET
		効果範囲手札 = 1
		効果条件カテゴリ:0 = 霊神
		効果条件カテゴリ:1 = エレメントセイバー
		効果条件種類 = モン全般
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT != 1
			RETURN 0
		CALL FULLRESET
		効果範囲手札 = 1
		SIF 追加条件フラグ & 1
			効果範囲デッキ = 1
		効果条件カテゴリ:0 = 霊神
		効果条件カテゴリ:1 = エレメントセイバー
		効果条件種類 = モン全般
		効果条件CNT = 1
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT <= 1
			RETURN 0
	ENDIF
	RETURN 1
ELSEIF 種類 == EX召喚時強制 || 種類 == 特殊召喚時強制
	RETURN 1
ELSEIF 種類 == 効果後誘発
	SIF 効果発動済(決闘者,場所,ゾーン)
		RETURN 0
	SIF ゾーン != "戦場"
		RETURN 0
	[SKIPSTART]
	FOR カウンタ,1,8
		CALL FULLRESET
		効果範囲墓地 = 1
		効果条件属性 = カウンタ
		効果条件カテゴリ:0 = 霊神
		効果条件カテゴリ:1 = エレメントセイバー
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT != 1
			CONTINUE
		CALL FULLRESET
		効果条件属性 = カウンタ
		CALL CARD_CHECK_FIN_DATA(決闘者,"特殊召喚",1)
		SIF RESULT != 1
			CONTINUE
		条件達成 |= 1
	NEXT
	SIF 条件達成 == 0
		RETURN 0
	[SKIPEND]
	
	;墓地のカテゴリの属性を確認して「複数属性」の変数に設定を格納。下の効果条件属性_複数にて利用。
	CALL FULLRESET
	効果条件カテゴリ:0 = 霊神
	効果条件カテゴリ:1 = エレメントセイバー
	CALL ELEMENTS_KIND_BASIC(決闘者,"墓地",複数属性)
	
	CALL FULLRESET
	CALL 効果条件属性_複数(複数属性)
	CALL CARD_CHECK_FIN_DATA(決闘者,"特殊召喚",1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 永続効果 || 種類 == 攻守変動
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_55595(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 効果先
#DIM DYNAMIC 追加条件フラグ = 0
#DIM DYNAMIC 条件達成 = 0
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 選択属性
#DIM DYNAMIC 手札枚数＿前
#DIM DYNAMIC 手札枚数＿後
#DIM DYNAMIC 攻守修正値 = 0
#DIM DYNAMIC 複数属性, 8

CALL 対面者判定(決闘者)
対面者 = %RESULTS%


IF 種類 == EXデッキ起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,55595,1)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲魔罠 = 1
		効果条件名前 = 霊神の聖殿
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT == 1 && !(発動済_3(決闘者,71705))
			追加条件フラグ |= 1
		CALL FULLRESET
		効果範囲戦場 = 1
		効果条件カテゴリ = エレメントセイバー
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT == 1
			追加条件フラグ |= 2
		
		手札枚数＿前 = 手札数(決闘者)
		;まずは「霊神」・「エレメントセイバー」モンスター1体を墓地へ送る。
		CALL FULLRESET
		効果範囲手札 = 1
		SIF 追加条件フラグ & 1
			効果範囲デッキ = 1
		効果条件カテゴリ:0 = 霊神
		効果条件カテゴリ:1 = エレメントセイバー
		効果条件種類 = モン全般
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			;墓地へ送る前後で手札の枚数を確認し、減っていない場合はデッキから送ったと判定し霊神の神殿の効果③を使用した扱いに。
			手札枚数＿後 = 手札数(決闘者)
			IF 手札枚数＿前 == 手札枚数＿後
				;霊神の神殿の効果を発動した！
				SETCOLOR C_YELLOW
				PRINTFORML 「霊神の神殿」の効果によってデッキから直接モンスターを墓地へ送った！！
				RESETCOLOR
				CALL CARD_EFFECT_USE(決闘者,71705,3)
				追加条件フラグ ^= 1
			ENDIF
			CALL FULLRESET
			効果範囲手札 = 1
			SIF 追加条件フラグ & 1
				効果範囲デッキ = 1
			IF !(追加条件フラグ & 2);XORは表記が直感的じゃなさすぎるので論理積の否定で記載
				効果条件カテゴリ:0 = 霊神
				効果条件カテゴリ:1 = エレメントセイバー
			ENDIF
			効果条件種類 = モン全般
			CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
			IF RESULT == 1
				;墓地へ送る前後で手札の枚数を確認し、減っていない場合はデッキから送ったと判定し霊神の神殿の効果③を使用した扱いに。
				手札枚数＿前 = 手札数(決闘者)
				IF 手札枚数＿前 == 手札枚数＿後
					;霊神の神殿の効果を発動した！
					SETCOLOR C_YELLOW
					PRINTFORML 「霊神の神殿」の効果によってデッキから直接モンスターを墓地へ送った！！
					RESETCOLOR
					CALL CARD_EFFECT_USE(決闘者,71705,3)
				ENDIF
				CALL FULLRESET
				CALL CARD_SP_SUMMON(決闘者,"EXデッキ",場所)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 種類 == EX召喚時強制 || 種類 == 特殊召喚時強制
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,55595)
	IF RESULT == 0
		;墓地のカテゴリのモンスターを2体選んで、その属性に応じて汎数を設定する。
		;汎数bit1(1):●地または風：戦闘耐性を得て、攻撃力・守備力が３００アップする。
		;汎数bit2(2):●水または炎：効果破壊耐性を得て、攻撃力・守備力が３００アップする。
		;汎数bit3(4):●光または闇：対象耐性を得る。
		
		CALL FULLRESET
		効果条件カテゴリ:0 = 霊神
		効果条件カテゴリ:1 = エレメントセイバー
		効果条件種類 = モン全般
		CALL CARD_CHOOSE_BASIC(決闘者,"墓地",ゾーン,場所)
		IF RESULT != 9999
			選択カード = RESULT
			選択カードID = RESULT:99
			TRYCALLFORM CARD_{選択カードID}, "属性"
			選択属性 = RESULT
			SELECTCASE 選択属性
				CASE 地属性,風属性
					;汎数に1を立てる
					CALL SET_FIELD_INFO(決闘者,"戦場",場所,"汎数",1)
				CASE 水属性,炎属性
					;汎数に2を立てる
					CALL SET_FIELD_INFO(決闘者,"戦場",場所,"汎数",2)
				CASE 光属性,闇属性
					;汎数に4を立てる
					CALL SET_FIELD_INFO(決闘者,"戦場",場所,"汎数",4)
			ENDSELECT
			CALL FULLRESET
			効果条件カテゴリ:0 = 霊神
			効果条件カテゴリ:1 = エレメントセイバー
			効果条件種類 = モン全般
			効果条件属性:0 = 神属性
			IF !(GETVAR(@"%決闘者%_MZ_汎数:{場所}") & 1)
				効果条件属性:1 = 地属性
				効果条件属性:2 = 風属性
			ENDIF
			IF !(GETVAR(@"%決闘者%_MZ_汎数:{場所}") & 2)
				効果条件属性:3 = 炎属性
				効果条件属性:4 = 水属性
			ENDIF
			IF !(GETVAR(@"%決闘者%_MZ_汎数:{場所}") & 4)
				効果条件属性:5 = 光属性
				効果条件属性:6 = 闇属性
			ENDIF
			CALL CARD_CHOOSE_BASIC(決闘者,"墓地",ゾーン,場所)
			IF RESULT != 9999
				選択カード = RESULT
				選択カードID = RESULT:99
				TRYCALLFORM CARD_{選択カードID}, "属性"
				選択属性 = RESULT
				SELECTCASE 選択属性
					CASE 地属性,風属性
						;汎数に1を立てる
						CALL SET_FIELD_INFO(決闘者,"戦場",場所,"汎数",1)
					CASE 水属性,炎属性
						;汎数に2を立てる
						CALL SET_FIELD_INFO(決闘者,"戦場",場所,"汎数",2)
					CASE 光属性,闇属性
						;汎数に4を立てる
						CALL SET_FIELD_INFO(決闘者,"戦場",場所,"汎数",4)
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ELSEIF 種類 == 効果後誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,55595,10)
	IF RESULT == 0
		効果先 = FINAL_SUMMON_TARGET(決闘者,1)
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(決闘者,"自動処理",効果先,"墓地")
	ENDIF
ELSEIF 種類 == 永続効果
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"不材")
	
	IF GETVAR(@"%決闘者%_MZ_汎数:{場所}") & 1
		CALL FULLRESET
		効果条件カテゴリ:0 = 霊神
		効果条件カテゴリ:1 = エレメントセイバー
		効果条件種類 = モン全般
		CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"戦耐")
	ENDIF
	IF GETVAR(@"%決闘者%_MZ_汎数:{場所}") & 2
		CALL FULLRESET
		効果条件カテゴリ:0 = 霊神
		効果条件カテゴリ:1 = エレメントセイバー
		効果条件種類 = モン全般
		CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"破耐")
	ENDIF
	IF GETVAR(@"%決闘者%_MZ_汎数:{場所}") & 4
		CALL FULLRESET
		効果条件カテゴリ:0 = 霊神
		効果条件カテゴリ:1 = エレメントセイバー
		効果条件種類 = モン全般
		CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"対耐")
	ENDIF
	
ELSEIF 種類 == 攻守変動
	SIF GETVAR(@"%決闘者%_MZ_汎数:{場所}") & 1
		攻守修正値 += 300
	SIF GETVAR(@"%決闘者%_MZ_汎数:{場所}") & 2
		攻守修正値 += 300
	CALL FULLRESET
	効果条件カテゴリ:0 = 霊神
	効果条件カテゴリ:1 = エレメントセイバー
	効果条件種類 = モン全般
	CALL STATCHANGE_BASIC(決闘者,"戦場",場所,攻守修正値,攻守修正値)
