@CARDNAME_1695,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = エレメントセイバー・アイナ
	CASE "略称"
		RESULTS = ElmS・アイナ
	CASE "カテゴリ"
		RESULTS:0 = エレメントセイバー
		RESULTS:1 = エレメント
		;カテゴリ縛りのSS、EX召喚のために設定
		RESULTS:4 = 霊神
ENDSELECT


@CARD_1695(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 地属性
	CASE "種族"
		RETURN 戦士族
	CASE "レベル"
		RETURN 2
	CASE "攻撃力"
		RETURN 900
	CASE "守備力"
		RETURN 1800
	CASE "霊神属性"
		RETURN 1
	CASE "性別"
		RETURN 牝性
	CASE "追加日"
		RETURN 251030
ENDSELECT

RETURN 0

@CARD_EXPLANATION_1695(種類)
#DIM DYNAMIC 種類

PRINTL このカード名の②の効果は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(10,戦場起動)
PRINTL ①：１ターンに１度、手札から「エレメント」モンスター１体を墓地へ送り、
PRINTL 自分の墓地の「エレメントセイバー・アイナ」以外の「エレメント」モンスター１体を対象にして発動できる。そのモンスターを特殊召喚する。
CALLFORM CARD_ABLE(2,墓地起動)
PRINTL ②：自分フィールドにレベル５以上の「エレメントセイバー」モンスターまたは４種類以上の属性のモンスターが存在する場合に発動できる。
PRINTL 墓地のこのカードを含む、自分の墓地のモンスター３体をデッキに戻し、１枚ドローする。
CALLFORM CARD_ABLE(0,永続効果)
PRINTL ③：墓地のこのカードは全ての属性のモンスターとして扱う。

;「エレメントセイバー」の継戦能力を支える縁の下の力持ちな女戦士。蘇生効果で盤面にモンスターを並べる能力を持っている。
;自身は蘇生できないので手札コストの続く限り横並べ、みたいな無法は流石に難しいが、名称ターン１じゃない展開効果には若干の不穏さを感じる。
;発動の際に蘇生可能な「エレメント」モンスターが１体以上は墓地に必要だが、手札から墓地へ送ったモンスターを即座に蘇生する事もできる。
;とはいえ、「エレメントセイバー」では手札を切りすぎるとウィラードの特殊召喚が難しくなってしまうので、フィールドに出力しすぎるのも考え物。
;蘇生して展開を繋げたり、リンクモンスターに変換して相手盤面を処理したりする用途であれば頼もしい存在であろう。
;②はリソース回復効果。「エレメントセイバー」も「エレメント」も墓地を肥やすテーマだが、ロングゲームになった時にリソース回復は有り難いだろう。

;地属性の女の子ということで「エレメント」テーマとの相性が６人の中で最も高くなるよう意図して調整している。


@CARDCAN_1695(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 追加条件フラグ = 0
#DIM DYNAMIC 使用フラグ = 0

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,1695)
SIF RESULT == 1
	RETURN 0

IF 種類 == 戦場起動
	SIF 効果発動済(決闘者,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL FULLRESET
	効果範囲魔罠 = 1
	効果条件名前 = 霊神の聖殿
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT == 1 && !(発動済_3(決闘者,71705))
		追加条件フラグ |= 1
	CALL FULLRESET
	効果範囲手札 = 1
	SIF 追加条件フラグ & 1
		効果範囲デッキ = 1
	効果条件カテゴリ = エレメント
	効果条件種類 = モン全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件カテゴリ = エレメント
	効果条件種類 = モン全般
	効果条件固名前 = エレメントセイバー・アイナ
	効果条件召喚可 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 墓地起動
	SIF 発動済_2(決闘者,1695)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件種類 = モン全般
	効果条件CNT = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT < 3
		RETURN 0
	
	CALL FULLRESET
	効果範囲戦場 = 1
	効果条件カテゴリ = エレメントセイバー
	効果条件種類 = モン全般
	CALL 効果条件レベル_ADV(5, "以上")
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT == 1
		使用フラグ |= 1
	
	CALL FULLRESET
	CALL FIELD_INFO_COUNT(決闘者,"属")
	SIF RESULT >= 4
		使用フラグ |= 2
	SIF 使用フラグ == 0
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF

@CARDEFFECT_1695(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 追加条件フラグ = 0
#DIM DYNAMIC 手札枚数＿前
#DIM DYNAMIC 手札枚数＿後

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 戦場起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,1695,10)
	IF RESULT == 0
		手札枚数＿前 = 手札数(決闘者)
		CALL FULLRESET
		効果範囲魔罠 = 1
		効果条件名前 = 霊神の聖殿
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT == 1 && !(発動済_3(決闘者,71705))
			追加条件フラグ |= 1
		;手札のエレメントモンスターを墓地へ送る。(条件次第でデッキからも送れる)
		CALL FULLRESET
		効果範囲手札 = 1
		SIF 追加条件フラグ & 1
			効果範囲デッキ = 1
		効果条件カテゴリ = エレメント
		効果条件種類 = モン全般
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			;墓地へ送る前後で手札の枚数を確認し、減っていない場合はデッキから送ったと判定し霊神の神殿の効果③を使用した扱いに。
			手札枚数＿後 = 手札数(決闘者)
			IF 手札枚数＿前 == 手札枚数＿後
				;霊神の神殿の効果を発動した！
				SETCOLOR C_YELLOW
				PRINTFORML 「霊神の神殿」の効果によってデッキから直接モンスターを墓地へ送った！！
				RESETCOLOR
				CALL CARD_EFFECT_USE(決闘者,71705,3)
			ENDIF
			;墓地のモンスターを蘇生
			CALL FULLRESET
			効果範囲墓地 = 1
			効果条件カテゴリ = エレメント
			効果条件種類 = モン全般
			効果条件固名前 = エレメントセイバー・アイナ
			CALL CARD_SP_SUMMON_ADV(決闘者,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 種類 == 墓地起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,1695,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(決闘者,ゾーン,場所,デッキ行き)
		CALL FULLRESET
		効果条件種類 = モン全般
		効果条件複数 = 2
		効果条件行先フラグ = デッキ行き
		CALL CARD_ADD_GY_BASIC(決闘者,"墓地",ゾーン,場所)
		IF RESULT == 1
			CALL CARDDRAW_BASIC(決闘者,1)
		ENDIF
	ENDIF
ENDIF
