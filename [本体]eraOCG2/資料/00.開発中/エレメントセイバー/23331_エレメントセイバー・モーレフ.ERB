@CARDNAME_23331,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = エレメントセイバー・モーレフ
	CASE "略称"
		RESULTS = ElmS・モーレフ
	CASE "カテゴリ"
		RESULTS:0 = エレメントセイバー
		RESULTS:1 = エレメント
		;カテゴリ縛りのSS、EX召喚のために設定
		RESULTS:4 = 霊神
ENDSELECT


@CARD_23331(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 闇属性
	CASE "種族"
		RETURN 戦士族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1900
	CASE "守備力"
		RETURN 0
	CASE "霊神属性"
		RETURN 1
	CASE "性別"
		RETURN 雄性
	CASE "追加日"
		RETURN 251030
ENDSELECT

RETURN 0

@CARD_EXPLANATION_23331(種類)
#DIM DYNAMIC 種類

PRINTL このカード名の②の効果は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(10,戦場起動,フリー誘発)
PRINTL ①：１ターンに１度、手札から「エレメントセイバー」モンスター１体を墓地へ送り、
PRINTL 相手フィールドの表側表示モンスター１体を対象にして発動できる。（この効果は相手ターンでも発動できる。）
PRINTL そのモンスターを裏側守備表示にする。
CALLFORM CARD_ABLE(2,戦破壊→墓地)
PRINTL ②：このカードがフィールドから墓地へ送られた場合に発動できる。自分の墓地の「エレメントセイバー・モーレフ」以外の
PRINTL 「霊神」・「エレメントセイバー」モンスター１体を手札に加える。
PRINTL この効果の発動後、ターン終了時まで自分は「霊神」・「エレメントセイバー」モンスターしか特殊召喚できない。
CALLFORM CARD_ABLE(0,永続効果)
PRINTL ③：墓地のこのカードは全ての属性のモンスターとして扱う。

;「エレメントセイバー」の妨害の要になる闇属性の戦士。相手モンスターを裏側守備表示にする妨害はフリチェで撃てるため、
;テーマモンスターの中ではほぼ唯一の、能動的な妨害効果を撃てるモンスターである。そのため盤面に出力したいところではあるが、
;このモンスター自体は展開に関与する能力に乏しいので、先攻展開で盤面に残すのは難しい。永続罠の効果で相手ターンにリクルートするのがよいだろう。
;その際には、相手がフィールドで闇属性モンスターの効果を発動したいタイミングでリクルートできれば、永続罠の追加効果での妨害も狙う事が可能。


@CARDCAN_23331(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 追加条件フラグ = 0

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,23331)
SIF RESULT == 1
	RETURN 0

IF 種類 == 戦場起動 || 種類 == フリー誘発
	SIF 効果発動済(決闘者,場所,ゾーン)
		RETURN 0
	SIF ゾーン != "戦場"
		RETURN 0
	CALL FULLRESET
	効果範囲魔罠 = 1
	効果条件名前 = 霊神の聖殿
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT == 1 && !(発動済_3(決闘者,71705))
		追加条件フラグ |= 1
	CALL FULLRESET
	効果範囲手札 = 1
	SIF 追加条件フラグ & 1
		効果範囲デッキ = 1
	効果条件カテゴリ = エレメントセイバー
	効果条件種類 = モン全般
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	効果範囲相手戦場 = 1
	効果条件種類 = モン全般
	効果条件表示 = 表側表示
	効果条件除去種 = 表示変更
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 戦破壊→墓地
	SIF 発動済_2(決闘者,23331)
		RETURN 0
	SIF !GROUPMATCH(墓地送り種類,"リリース","破壊","戦闘破壊")
		RETURN 0
	CALL FULLRESET
	効果範囲墓地 = 1
	効果条件カテゴリ:0 = 霊神
	効果条件カテゴリ:1 = エレメントセイバー
	効果条件種類 = モン全般
	効果条件固名前 = エレメントセイバー・モーレフ
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_23331(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 追加条件フラグ = 0
#DIM DYNAMIC 手札枚数＿前
#DIM DYNAMIC 手札枚数＿後

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 戦場起動 || 種類 == フリー誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,23331,10)
	IF RESULT == 0
		手札枚数＿前 = 手札数(決闘者)
		CALL FULLRESET
		効果範囲魔罠 = 1
		効果条件名前 = 霊神の聖殿
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		SIF RESULT == 1 && !(発動済_3(決闘者,71705))
			追加条件フラグ |= 1
		;手札のエレメントセイバーを墓地へ送る。(条件次第でデッキからも送れる)
		CALL FULLRESET
		効果範囲手札 = 1
		SIF 追加条件フラグ & 1
			効果範囲デッキ = 1
		効果条件カテゴリ = エレメントセイバー
		効果条件種類 = モン全般
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			;墓地へ送る前後で手札の枚数を確認し、減っていない場合はデッキから送ったと判定し霊神の神殿の効果③を使用した扱いに。
			手札枚数＿後 = 手札数(決闘者)
			IF 手札枚数＿前 == 手札枚数＿後
				;霊神の神殿の効果を発動した！
				SETCOLOR C_YELLOW
				PRINTFORML 「霊神の神殿」の効果によってデッキから直接モンスターを墓地へ送った！！
				RESETCOLOR
				CALL CARD_EFFECT_USE(決闘者,71705,3)
			ENDIF
			;相手のモンスター１体を裏側守備表示に変更する。
			CALL FULLRESET
			効果条件表示 = 表側表示
			CALL CARD_REMOVAL_BASIC(決闘者,"戦場単体",場所,"表示変更")
		ENDIF
	ENDIF
ELSEIF 種類 == 戦破壊→墓地
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,23331,2)
	IF RESULT == 0
		;墓地のモンスターをサルベージ
		CALL FULLRESET
		効果範囲墓地 = 1
		効果条件カテゴリ:0 = 霊神
		効果条件カテゴリ:1 = エレメントセイバー
		効果条件種類 = モン全般
		効果条件固名前 = エレメントセイバー・モーレフ
		CALL CARD_ADD_ADV(決闘者,ゾーン,場所)
		;縛り。※カテゴリ縛りの設定は「霊神」で設定する。
		;「エレメントセイバー」モンスターは全て隠しで「霊神」カテゴリにも所属させる。
		CALL FULLRESET
		CALL CARD_SS_RESTRICTION(決闘者,"霊神")
	ENDIF
ENDIF
