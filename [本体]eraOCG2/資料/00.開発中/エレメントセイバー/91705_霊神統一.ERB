@CARDNAME_91705,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		;RESULTS = エレメンタル・トレーニング
		RESULTS = 霊神統一
	CASE "略称"
		RESULTS = 霊神統一
	CASE "カテゴリ"
		RESULTS:0 = 霊神
ENDSELECT


@CARD_91705(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 永続罠
	CASE "追加日"
		RETURN 251030
ENDSELECT

RETURN 0

@CARD_EXPLANATION_91705(種類)
#DIM DYNAMIC 種類
PRINTL このカード名の③の効果は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(0,永続効果)
PRINTL ①：このカードが魔法＆罠ゾーンに存在する限り、自分フィールドの「霊神の聖殿」は効果では破壊されず、相手の効果の対象にならない。
CALLFORM CARD_ABLE(10,魔罠起動,フリー誘発)
PRINTL ②：１ターンに１度、自分フィールドのモンスター１体をリリースして発動できる。
PRINTL リリースしたモンスターと元々の属性が異なる「エレメントセイバー」モンスター１体をデッキから特殊召喚する。
PRINTL その後、この効果で特殊召喚したモンスターの属性と同じ属性の相手フィールドのモンスター１体を選び、その効果を無効にできる。
CALLFORM CARD_ABLE(3,魔罠起動)
PRINTL ③：自分メインフェイズに魔法＆罠ゾーンの表側表示のこのカードを墓地へ送って発動できる。自分の手札を６枚まで選んで墓地へ送る。
PRINTL その後、この効果で墓地へ送ったカードの数まで、自分の墓地から「霊神」・「エレメントセイバー」モンスターを手札に加える事ができる。

;【エレメントセイバー】の魔罠による妨害効果とリクルートを兼ねた永続罠。フィールドに維持できれば妨害と展開補助の両面で使えるなかなか優秀な罠。
;重要なアド稼ぎ源の「霊神の聖殿」を保護する効果もあるため、出来ればこのカードも伏せた状態でターンを返せるようにしたいところ。
;②のリクルートに属性条件つきの妨害と、③の手札の墓地送り枚数を最大６枚で選べる融通が利く効果に調整して、使い勝手を向上させている。
;その代わりの軽い調整として、③の効果を発動できるフェイズを指定してフリチェ発動をできなくした。これはeraOCG2での操作性に配慮した調整。
;本来できていた動きを減らす調整なのだが、③はうっかり押しミスしたら大変なことになる効果なので、そもそも聞いてくる機会を減らすようにしている。
;なお、③はセット状態からの発動時に即時使用する事ができない。これはQ&A記載の裁定でOCGの仕様（表側表示の～と指定している永続罠で共通の裁定）
;裁定を調べたら②の効果発動したチェーンで③の効果の発動出来ないとの記載もある。魔罠起動効果が２つある永続罠は複雑な処理をしていて難しい。


@CARDCAN_91705(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 効果制限達成
#DIM DYNAMIC 条件達成フラグ = 0
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 複数属性, 8

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,91705)
SIF RESULT == 1
	RETURN 0

IF (種類 == 魔罠起動 || (種類 == フリー誘発 && ゾーン == "魔罠")) && GETVAR(@"%決闘者%_魔_表:場所") == 1
	SIF ゾーン != "魔罠"
		RETURN 0
	SIF GETVAR(@"%決闘者%_魔_表:場所") == 3
		RETURN 0
	;-----------------------------
	;②効果のチェック　②が発動できない場合は「条件達成フラグ |= 1」を設定
	SIF 効果発動済(決闘者,場所,ゾーン)
		条件達成フラグ |= 1
	
	;デッキに存在するエレメントセイバーの属性を確認する。（二属性以上あればフィールドのモンスターは何をリリースしても大丈夫になる。）
	;属性が１つしかない場合(RESULT:0 == 6)に利用するため効果制限達成のフラグを立てる。
	;※後の処理で存在している属性以外のモンスターがフィールドにあるか確認で利用するので反転フラグを使う。
	CALL FULLRESET
	効果条件カテゴリ = エレメントセイバー
	CALL ELEMENTS_KIND_BASIC(決闘者,"デッキ",複数属性,0,1)
	SIF RESULT:1 == 6
		効果制限達成 = 1
	
	;全属性のフラグが立ってる場合（デッキに「エレメントセイバー」モンスターが１人も居ない場合）は②は発動できない。
	SIF RESULT:1 == 7
		条件達成フラグ |= 1
	
	CALL FULLRESET
	効果範囲戦場 = 1
	SIF 効果制限達成 == 1
		CALL 効果条件属性_複数(複数属性)
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		条件達成フラグ |= 1
	
	;-----------------------------
	;③効果のチェック　③が発動できない場合は「条件達成フラグ |= 2」を設定
	IF メインフェイズ == 1 && 種類 == 魔罠起動 && ターンプレイヤー == 決闘者
		SIF 発動済_3(決闘者,91705)
			条件達成フラグ |= 2
		SIF 手札数(決闘者) >= 0
			条件達成フラグ |= 2
	ELSE
		条件達成フラグ |= 2
	ENDIF
	SIF 条件達成フラグ & 1 && 条件達成フラグ & 2
		RETURN 0
	RETURN 1
;ELSEIF 種類 == 魔罠起動 || (種類 == フリー誘発 && ゾーン == "魔罠" && GETVAR(@"%決闘者%_魔_表:場所") == 2)
ELSEIF 種類 == 魔罠起動
	CALL CARD_SET_ACT(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 永続効果
	SIF ゾーン != "魔罠"
		RETURN 0
	SIF GETVAR(@"%決闘者%_魔_表:場所") != 1
		RETURN 0
	RETURN 1
ENDIF



@CARDEFFECT_91705(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 選択カードID
#DIM DYNAMIC 選択カード属性
#DIM DYNAMIC カウンタ
#DIM DYNAMIC カウンタB
#DIM DYNAMIC リピート数
#DIM DYNAMIC 属性数
#DIM DYNAMIC 発動効果種類 = 0
#DIM DYNAMIC 条件達成フラグ = 0
#DIM DYNAMIC 効果制限達成 = 0
#DIM DYNAMIC 選択結果
#DIM DYNAMIC 複数属性, 8

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF (種類 == 魔罠起動 || (種類 == フリー誘発 && ゾーン == "魔罠")) && GETVAR(@"%決闘者%_魔_表:場所") == 1
	;両方の効果が利用可能か確認する。条件達成フラグが0なら両方の効果が発動可能。
	;両方発動可能（自分メインフェイズの魔罠起動で、かつどちらの発動条件も満たしている）なら、使う効果を選択する。
	
	;-----------------------------
	;②効果のチェック　②が発動できない場合は「条件達成フラグ |= 1」を設定
	SIF 効果発動済(決闘者,場所,ゾーン)
		条件達成フラグ |= 1
	
	;デッキに存在するエレメントセイバーの属性を確認する。（二属性以上あればフィールドのモンスターは何をリリースしても大丈夫になる。）
	;属性が１つしかない場合(RESULT:0 == 6)に利用するため効果制限達成のフラグを立てる。
	;※後の処理で存在している属性以外のモンスターがフィールドにあるか確認で利用するので反転フラグを使う。
	CALL FULLRESET
	効果条件カテゴリ = エレメントセイバー
	CALL ELEMENTS_KIND_BASIC(決闘者,"デッキ",複数属性,0,1)
	SIF RESULT:1 == 6
		効果制限達成 = 1
	
	;全属性のフラグが立ってる場合（デッキに「エレメントセイバー」モンスターが１人も居ない場合）は②は発動できない。
	SIF RESULT:1 == 7
		条件達成フラグ |= 1
	
	CALL FULLRESET
	効果範囲戦場 = 1
	SIF 効果制限達成 == 1
		CALL 効果条件属性_複数(複数属性)
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		条件達成フラグ |= 1
	
	;-----------------------------
	;③効果のチェック　③が発動できない場合は「条件達成フラグ |= 2」を設定
	IF メインフェイズ == 1 && 種類 == 魔罠起動 && ターンプレイヤー == 決闘者
		SIF 発動済_3(決闘者,91705)
			条件達成フラグ |= 2
		SIF 手札数(決闘者) == 0
			条件達成フラグ |= 2
	ELSE
		条件達成フラグ |= 2
	ENDIF
	
	IF 条件達成フラグ == 0
		IF 決闘者 == "相手"
			;CPUは、両方を発動できる場合はまず先に②の効果を優先して使う（③を使うとこのカードを墓地へ送ってしまうため）
			選択結果 = はい
		ELSE
			CUSTOMDRAWLINE —
			PRINTFORML 
			PRINTFORML どちらの効果を使用しますか？
			PRINTFORML 
			PRINTL ②：１ターンに１度、自分フィールドのモンスター１体をリリースして発動できる。
			PRINTL リリースしたモンスターと元々の属性が異なる「エレメントセイバー」モンスター１体をデッキから特殊召喚する。
			PRINTL その後、この効果で特殊召喚したモンスターの属性と同じ属性の相手フィールドのモンスター１体を選び、その効果を無効にできる。
			PRINTL ③：自分メインフェイズに魔法＆罠ゾーンの表側表示のこのカードを墓地へ送って発動できる。自分の手札を６枚まで選んで墓地へ送る。
			PRINTL その後、この効果で墓地へ送ったカードの数まで、自分の墓地から「霊神」・「エレメントセイバー」モンスターを手札に加える事ができる。
			PRINTFORML 
			CALL YN_CHOICE(決闘者,"②の効果","③の効果")
		ENDIF
	ELSEIF 条件達成フラグ & 1
		選択結果 = いいえ
	ELSE
		選択結果 = はい
	ENDIF
	IF 選択結果 == はい
		CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,91705,10)
		IF RESULT == 0
			;②の効果処理
			$EFFECT_91705_2
			
			CALL FULLRESET
			効果範囲戦場 = 1
			SIF 効果制限達成 == 1
				CALL 効果条件属性_複数(複数属性)
			CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
			IF RESULT == 1
				選択カードID = RESULT:1
				TRYCALLFORM CARD_{選択カードID}, "属性"
				;複数属性持ちのモンスターをリリースした場合でも、RESULT:0の属性を元々の属性として扱う
				選択カード属性 = RESULT:0
				;選択カード属性以外の属性で選ぶ処理（反転している）
				VARSET 複数属性
				FOR カウンタ,1,8
					SIF 選択カード属性 != カウンタ
						複数属性:(カウンタ) = 1
				NEXT
				CALL FULLRESET
				効果範囲デッキ = 1
				効果条件カテゴリ = エレメントセイバー
				効果条件種類 = モン全般
				CALL 効果条件属性_複数(複数属性)
				CALL CARD_SP_SUMMON_ADV(決闘者,ゾーン,場所)
				IF RESULT == 1
					;特殊召喚成功後、特殊召喚したモンスターと同じ属性のモンスターを無効化する処理
					選択カードID = RESULT:1
					TRYCALLFORM CARD_{選択カードID}, "属性"
					選択カード属性 = RESULT:0
					CALL FULLRESET
					効果範囲相手戦場 = 1
					効果条件属性 = 選択カード属性
					効果条件除去種 = 無効
					CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
					IF RESULT == 1
						CALL FULLRESET
						効果条件属性 = 選択カード属性
						効果条件表示 = 表側表示
						効果条件任意 = 1
						CALL CARD_REMOVAL_BASIC(決闘者,"戦場単体",場所,"永続無効")
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ELSEIF 選択結果 == いいえ
		CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,91705,3)
		IF RESULT == 0
			CALL CARD_DISPOSE(決闘者,ゾーン,場所,墓地行き)
			;③の効果処理
			CALL FULLRESET
			効果範囲手札 = 1
			効果条件複数 = 94
			CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
			IF RESULT == 1
				リピート数 = RESULT:2
				CALL FULLRESET
				効果範囲墓地 = 1
				効果条件カテゴリ:0 = 霊神
				効果条件カテゴリ:1 = エレメントセイバー
				効果条件種類 = モン全般
				効果条件複数 = 100 - リピート数
				CALL CARD_ADD_ADV(決闘者,ゾーン,場所)
			ENDIF
		ENDIF
	ENDIF
ELSEIF 種類 == 魔罠起動 || (種類 == フリー誘発 && ゾーン == "魔罠" && GETVAR(@"%決闘者%_魔_表:場所") == 2)
	;カード発動＆設置まで
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,91705)
	IF RESULT == 0
		;②の効果が発動可能か確認し、発動可能であれば使用することも選択できる。
		TRYCALLFORM CARDCAN_91705(決闘者,フリー誘発,"魔罠",場所)
		IF RESULT == 1
			CUSTOMDRAWLINE —
			PRINTFORML 
			PRINTFORML 今、「霊神統一」の②の効果を使用しますか？
			PRINTFORML 
			PRINTL ②：１ターンに１度、自分フィールドのモンスター１体をリリースして発動できる。
			PRINTL リリースしたモンスターと元々の属性が異なる「エレメントセイバー」モンスター１体をデッキから特殊召喚する。
			PRINTL その後、この効果で特殊召喚したモンスターの属性と同じ属性の相手フィールドのモンスター１体を選び、その効果を無効にできる。
			PRINTFORML 
			CALL YN_CHOICE(決闘者)
			IF RESULT == 0
				CALL CARD_EFFECT_USE(決闘者, 91705, 10)
				GOTO EFFECT_91705_2
			ENDIF
		ENDIF
	ENDIF
ELSEIF 種類 == 永続効果
	CALL FULLRESET
	効果条件名前 = 霊神の聖殿
	CALL STATCHANGE_EFFECT(決闘者,"魔罠",場所,"対耐")
	CALL STATCHANGE_EFFECT(決闘者,"魔罠",場所,"破耐")
ENDIF
