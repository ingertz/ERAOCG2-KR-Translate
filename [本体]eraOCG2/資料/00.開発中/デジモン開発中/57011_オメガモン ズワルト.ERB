@CARDNAME_57011,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = オメガモン ズワルト
	CASE "略称"
		RESULTS = オメガモンZWART
	CASE "カテゴリ"
		RESULTS:0 = デジモン
	CASE "出典作品"
		RESULTS:0 = デジモン
ENDSELECT


@CARD_57011(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "種類"
		RETURN エクシーズ
	CASE "属性"
		RESULT:1 = 炎属性
		RESULT:2 = 水属性
		RETURN 闇属性
	CASE "種族"
		RESULT:1 = サイバース族
		RETURN 戦士族
	CASE "レベル"
		RETURN 11
	CASE "攻撃力"
		RETURN 3500
	CASE "守備力"
		RETURN 3500
	CASE "特殊制限"
		RETURN 1
	CASE "レア度"
		RETURN ULR
	CASE "追加日"
		RETURN 260111
ENDSELECT

RETURN 0

@CARD_EXPLANATION_57011(種類)
#DIM DYNAMIC 種類

PRINTL 「ブラックウォーグレイモン」＋「メタルガルルモン」
;エクシーズなのに素材の名称指定してるのは別にガバじゃなく意図
CALLFORM CARD_ABLE(1,EXデッキ起動)
PRINTL このカードは自分フィールド・墓地の「オメガモン」を除外することでEXデッキから特殊召喚することもできる。
PRINTL この方法で特殊召喚したこのカードのＸ素材は２つ増える。
PRINTL デジモンカードはサイバース族としても扱う。
PRINTL 自分は「オメガモン ズワルト」を１ターンに１度しか特殊召喚できず、
PRINTL このカード名の②③の効果はそれぞれ１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(0,永続効果)
PRINTL ①：このカードは非対象・戦闘耐性を持つ。
CALLFORM CARD_ABLE(2,発動誘発)
PRINTL ②：相手が手札から効果を発動した時に、このカードのX素材を1つ取り除いて発動できる。
PRINTL その発動を無効する。その後、相手の手札を確認し、１枚選んで捨てる。
CALLFORM CARD_ABLE(3,戦場起動,フリー誘発)
PRINTL ③：自分・相手ターンに発動できる。
PRINTL 相手フィールドのモンスターゾーン・魔法＆罠ゾーンのカードをそれぞれ１体まで破壊する。

@CARDSUMMON_57011(決闘者,召喚カード,EX参照)
#DIMS DYNAMIC 決闘者
#DIM DYNAMIC 召喚カード
#DIM DYNAMIC EX参照

CALL RESETCONDITION_MAT
必要素材数 = 2
なんでもＸ = 1
素材条件名前:0 = ブラックウォーグレイモン
素材条件名前:1 = メタルガルルモン
素材条件固名前起動 = 1

IF EX参照 == 1
	CALL XYZCAN(決闘者,召喚カード,57011) 
	RETURN RESULT
ENDIF



@CARDCAN_57011(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件達成

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,57011)
SIF RESULT == 1
	RETURN 0

IF 種類 == EXデッキ起動
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL CARD_EX_CHECK(決闘者,57011)
	SIF RESULT == 1
		RETURN 0
	SIF GETVAR(@"%決闘者%_除外NG置換") >= 1
		RETURN 0
	CALL FULLRESET
	効果範囲戦場 = 1
	効果範囲墓地 = 1
	効果条件名前 = オメガモン
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 発動誘発
	SIF 発動済_2(決闘者,57011)
		RETURN 0
	SIF ゾーン != "戦場"
		RETURN 0
	SIF GETVAR(@"%決闘者%_MZ_Ｘ:場所") <= -1
		RETURN 0
	CALL FULLRESET
	効果範囲手札 = 1
	CALL CARD_CHECK_START_DATA(決闘者,1)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 戦場起動 || 種類 == フリー誘発
	SIF 発動済_3(決闘者,57011)
		RETURN 0
	SIF ゾーン != "戦場"
		RETURN 0
	CALL FULLRESET
	効果範囲相手戦場 = 1
	効果範囲相手墓地 = 1
	効果条件除去種 = 墓地
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 永続効果
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ENDIF




@CARDEFFECT_57011(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 選択カード
#DIM DYNAMIC 選択カード_ID
#DIMS DYNAMIC 選択カード名前
#DIM DYNAMIC 同名枚数

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == EXデッキ起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,57011,1)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲戦場 = 1
		効果範囲墓地 = 1
		効果条件名前 = オメガモン
		効果条件行先フラグ = 除外行き
		CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			効果追加種類 = 効追Ｘ素 + 2
			CALL CARD_SP_SUMMON(決闘者, "EXデッキ", 場所)
		ENDIF
	ENDIF
ELSEIF 種類 == 発動誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,57011,2,X消費1)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(決闘者,"発動無効",場所,"無効")
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(決闘者,"手札指定",場所,"墓地")
	ENDIF
ELSEIF 種類 == 戦場起動 || 種類 == フリー誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,57011,3)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲相手戦場 = 1
		CALL CARD_REMOVAL_ADV(決闘者,"単体除去",場所,"墓地")
		CALL FULLRESET
		効果範囲相手魔罠 = 1
		CALL CARD_REMOVAL_ADV(決闘者,"単体除去",場所,"墓地")
	ENDIF
ELSEIF 種類 == 永続効果
	CALL FULLRESET
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"無差耐")
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"戦耐")
ENDIF
