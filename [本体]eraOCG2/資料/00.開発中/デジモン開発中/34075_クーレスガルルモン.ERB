@CARDNAME_34075,参照先
;ココで指定カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = クーレスガルルモン
	CASE "略称"
		RESULTS = クレスガルルモン
	CASE "カテゴリ"
		RESULTS:0 = デジモン
	CASE "出典作品"
		RESULTS:0 = デジモン
ENDSELECT


@CARD_34075(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "外部者"
		RETURN 1
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 水属性
	CASE "種族"
		RESULT:1 = サイバース族
		RETURN 獣族
	CASE "レベル"
		RETURN 9
	CASE "攻撃力"
		RETURN 2900
	CASE "守備力"
		RETURN 2300
	CASE "レア度"
		RETURN SPR
ENDSELECT

RETURN 0

@CARD_EXPLANATION_34075(種類)
#DIM DYNAMIC 種類

PRINTL デジモンカードはサイバース族としても扱う。
PRINTL このカード名の②の効果は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,手札起動)
PRINTL ①：手札のこのカードを相手に見せて発動できる。
PRINTL デッキからレベル５～８の獣族の「デジモン」モンスターを２体まで手札に加え、（同名カードは１枚まで）
PRINTL ２体加えた場合、自分の手札１枚を選んで捨てる。
CALLFORM CARD_ABLE(2,発動誘発)
PRINTL ②：相手がモンスターの効果を発動した時に発動できる。
PRINTL 相手フィールドのカード１枚を破壊する。
CALLFORM CARD_ABLE(0,永続効果)
PRINTL ③：このカードは特殊召喚されたターンには戦闘及び相手の効果では破壊されない。
PRINTL また、このカードは戦闘耐性・貫通能力を持ち、相手フィールドのモンスター全てに攻撃できる。


@CARDCAN_34075(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件達成



CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,34075)
SIF RESULT == 1
	RETURN 0

IF 種類 == 手札起動
	SIF 発動済_1(決闘者,34075)
		RETURN 0
	CALL FULLRESET
	効果範囲デッキ = 1
	効果条件種族:0 = 獣族
	効果条件レベル:0 = 5
	効果条件レベル:1 = 6
	効果条件レベル:2 = 7
	効果条件レベル:3 = 8
	効果条件カテゴリ = デジモン
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 発動誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF 発動済_2(決闘者,34075)
		RETURN 0
	CALL FULLRESET
	効果条件種類 = モン全般
	CALL CARD_CHECK_START_DATA(決闘者,1)
	SIF RESULT != 1
		RETURN 0
	CALL FULLRESET
	効果範囲相手戦場 = 1
	効果範囲相手魔罠 = 1
	効果条件除去種 = 墓地
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 特殊召喚時強制
	RETURN 1
ELSEIF 種類 == 永続効果
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_34075(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

IF 種類 == 手札起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,34075,1)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲デッキ = 1
		効果条件種族:0 = 獣族
		効果条件レベル:0 = 5
		効果条件レベル:1 = 6
		効果条件レベル:2 = 7
		効果条件レベル:3 = 8
		効果条件カテゴリ = デジモン
		効果条件固名前選択 = 1
		効果条件複数 = 2
		効果条件任意 = 1
		CALL CARD_ADD_ADV(決闘者,ゾーン,場所)
		IF RESULT == 1
			CALL FULLRESET
			効果範囲手札 = 1
			CALL CARD_ADD_GY_ADV(決闘者,ゾーン,場所)
		ENDIF
	ENDIF
ELSEIF 種類 == 発動誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,34075,2)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲相手戦場 = 1
		効果範囲相手魔罠 = 1
		CALL CARD_REMOVAL_ADV(決闘者,"単体除去",場所,"墓地")
	ENDIF
ELSEIF 種類 == 特殊召喚時強制
	CALL SET_FIELD_INFO(決闘者,"戦場",カード召喚先,"戦耐",1,1)
	CALL SET_FIELD_INFO(決闘者,"戦場",カード召喚先,"破耐",1,1)
ELSEIF 種類 == 永続効果
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"貫通")
	CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"連戦")
ENDIF

