@IRAI_EVENT_50(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 対象キャラ

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE  "名前"
		RESULTS = (ST5-1)夢の国のカイバランド
	CASE "イベント種"
		RETURN イベント_物語
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		PRINTL あれからまたしばらく時が過ぎた。
		PRINTL 新たな次元との接触で異世界側はまた大きく広がり書類仕事にいそしむ中……
		PRINTL 戦士たちは休息を必要としていた。
		PRINTL
		PRINTL 
	CASE "条件"
		SIF 依頼_完了回数:44 == 0
			RETURN 0
		RETURN 1
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0



@IRAI_ACT_50(参照)
#DIM DYNAMIC 参照
#DIM DYNAMIC 獲得モンスター
#DIM DYNAMIC イベント主
#DIM DYNAMIC ガイドさん
#DIM DYNAMIC 龍仙女
#DIM DYNAMIC 水遣い
#DIM DYNAMIC アリアンナ
#DIM DYNAMIC ウィッチちゃん
#DIM DYNAMIC 騎士様
ガイドさん = NO_TO_CHARANUM(1310)
龍仙女 = NO_TO_CHARANUM(1630)
水遣い = NO_TO_CHARANUM(2241)
アリアンナ = NO_TO_CHARANUM(2111)
ウィッチちゃん = NO_TO_CHARANUM(1194)
騎士様 = NO_TO_CHARANUM(1194)
IF 依頼_達成状況 == 0
	PRINTFORMW 「……ところで疑問だったデースが、このアイテム共集めたらどうなるんデース？」
	PRINTFORMW 「そういえばあまり考えたことなかったですね」
	PRINTFORMW 「こんなもん集めたらロクなことにならネーってのは結構楽に想像できるデスけど」
	PRINTFORMW 「邪神の封印が解けて復活、とか……簡単に考えられますね、ともあれ
	PRINTFORMW 　今日の集まりで、乙女さんに直接聞きましょうか？」


	PRINTFORMW 「おーっほっほ！　よくぞ来てくれましたわ！」
	PRINTFORMW 「スーツ姿に合いますね……」
	PRINTFORMW 「ついに魔界の代表も一般KC従業員堕ちしたデスか……」
	PRINTFORMW 「失礼な！　その逆ですわ！　説明してくださいまし、乙女代表？」
	PRINTFORML 
	PRINTFORMW 「はい！　ラビュリンス代表発案の出張メイドサービスがそれはもう決闘世界で……
	PRINTFORMW 　KC社員の魔界リモート派遣事業も大成中で私等KC分社『ミレニアムグループ』をしのぐ勢い勢いです！
	PRINTFORMW 　本当に、おとぼけ姫様だと思っていましたがなかなか俊敏で完全に足元をすくわれてしまいました！」
	PRINTFORML 
	PRINTFORMW 「おほほ、お口が上手ですわ乙女代表！　私は単に運とチャンスに恵まれただけの女……
	PRINTFORMW 　そちらが家の無い異世界人のために資金を使っていただけなければ、もう少し時間がかかりましたわ～
	PRINTFORMW 　私も腹黒邪悪な生臭修道院かと思っていましたが、白龍霊堂の教えがしっかりと精神に刻まれているようで」
	PRINTFORML 
	PRINTFORMW 「帰りましょうか」
	PRINTFORMW 「デス、この辺に美味しいお店あるんデース、あっモールのカドショ寄ろうデース、デス」
	PRINTFORML 
	PRINTFORMW 「すみませんええっと、とりあえず今後の話ですわね……千年アイテムの危険性は熟知しています」
	PRINTFORMW 「なので私たちもなるべく一か所に集めないよう、監視下にて千年アイテムのテスト利用の持ち出しなどを許可していました」
	PRINTFORMW 「決闘世界以外の世界で保管するのも、その世界に与えるリスクを考えると許可は出ませんでしたね、当然私達の魔界も」
	PRINTFORMW 「」
	PRINTFORMW 



	RETURN 2
ENDIF
