@IRAI_EVENT_50(参照先)
#DIMS DYNAMIC 参照先
#DIM DYNAMIC 対象キャラ

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE  "名前"
		RESULTS = (ST6-2)戦士の帰還
	CASE "イベント種"
		RETURN イベント_物語
	CASE "依頼先"
		RETURN 即時開始
	CASE "詳細"
		PRINTL 勇者の討伐に成功したが、手に入れたのは裏側のカード同士がくっついたカード。
		PRINTL 水遣いがKCの施設を借りて勇者を取り戻す方法を探るが上手く行かない。
		PRINTL 
		PRINTL 
	CASE "条件"
		SIF 依頼_完了回数:60 == 0
			RETURN 0
		RETURN 1
	CASE "回想可"
		RETURN 1
ENDSELECT

RETURN 0



