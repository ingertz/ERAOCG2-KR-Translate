@CARDNAME_40074,参照先
;ココで指定卡片の名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 惑プティカ
	CASE "略称"
		RESULTS = 惑プティカ
	CASE "カテゴリ"
		RESULTS:0 = 惑乱魔
		RESULTS:1 = E.R.A
ENDSELECT


@CARD_40074(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 地属性
	CASE "種族"
		RETURN 植物族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 450
	CASE "守備力"
		RETURN 2350
	CASE "性別"
		RETURN 牝性
	CASE "連動ID"
		RETURN 1381
ENDSELECT

RETURN 0

@CARD_EXPLANATION_40074(種類)
#DIM DYNAMIC 種類

CALL TEXT_DECORATION("ROGUE")
PRINTL 这个卡名的①②的效果1回合各能使用1次。
CALLFORM CARD_ABLE(1,手札起動)
PRINTL ①：自分・相手의 메인 페이즈に、このカードが手札に存在し、相手フィールドの表側表示モンスター１体を対象として発動できる。
PRINTL このカードを守備表示で特殊召喚し、そのモンスターにこのカードの蟲紋カウンターを１つ置く。
PRINTL 그 후、対象のモンスターに置かれている蟲紋カウンターが４種類以上の場合、
PRINTL そのモンスターは自分フィールドの「惑乱魔」エクシーズモンスターの"蜜壺"となる。
CALLFORM CARD_ABLE(2,召喚時,特殊召喚時)
PRINTL ②：このカードが召喚・特殊召喚に成功した場合に発動できる。
PRINTL デッキから「惑乱魔」魔法カード１枚を手札に加える。
CALLFORM CARD_ABLE(3,攻撃時誘発)
SETCOLOR C_PINK
PRINTL ③：攻撃表示のこのカードが攻撃対象として選択された時に発動できる。
PRINTL その攻撃モンスターにこのカードの蟲紋カウンターを１つ置き、このカードは守備表示になる。
RESETCOLOR
CALL TEXT_DECORATION("ROGUE")

;"蜜壺":対象のモンスターを自分モンスターのエクシーズ素材とする。ただし、墓地へは送らず“消滅”させる。

@CARDCAN_40074(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,40074)
SIF RESULT == 1
	RETURN 0

IF 種類 == 手札起動 || 種類 == フリー誘発
	SIF 発動済_1(決闘者,40074)
		RETURN 0
    SIF メインフェイズ != 1
    	RETURN 0
	SIF モンスター数(決闘者) >= 5
		RETURN 0
	SIF ゾーン != "手札"
		RETURN 0
	CALL CARD_SS_CHECK(決闘者,40074,ゾーン)
	SIF RESULT == 1
		RETURN 0

	CALL FULLRESET
	効果範囲相手戦場 = 1
	効果条件表示 = 表側表示
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1
ELSEIF 種類 == 召喚時 || 種類 == 特殊召喚時
	SIF 発動済_2(決闘者,40074)
		RETURN 0
	RETURN 1

ELSEIF 種類 == 攻撃時誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF 戦闘場所(決闘者) != 場所
		RETURN 0
	SIF ターンプレイヤー == 決闘者
		RETURN 0
	SIF GETVAR(@"%決闘者%_MZ_表:場所") == 2
		RETURN 0
	RETURN 1

ELSEIF 種類 == 攻撃時強制誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF 戦闘場所(決闘者) != 場所
		RETURN 0
	SIF ターンプレイヤー == 決闘者
		RETURN 0
	SIF GETVAR(@"%決闘者%_MZ_表:場所") == 2
		RETURN 0
	RETURN 1		
ENDIF

@CARDEFFECT_40074(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 选择卡片,2
#DIM DYNAMIC 自己卡片
#DIM DYNAMIC 自己守備力修正
#DIM DYNAMIC 对方卡片
#DIM DYNAMIC 对方攻撃力修正
#DIM DYNAMIC 条件达成
#DIM DYNAMIC 调教对象
#DIM DYNAMIC 性別判定

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 手札起動 || 種類 == フリー誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,40074,1)
	IF RESULT == 0
		CALL FULLRESET
		効果条件表示 = 表側表示
		CALL CARD_CHOOSE_BASIC(決闘者,"相手戦場",ゾーン,場所)
		选择卡片:0 = RESULT
		IF 选择卡片:0 != 9999
			CALL FULLRESET
			CALL CARD_SP_SUMMON(決闘者,ゾーン,場所,"守備表示")

			CALL SET_FIELD_INFO(対面者,"戦場",选择卡片:0,"普蒂卡纹Ｃ",1)

			调教对象 = GETVAR(@"%対面者%_戦場:(选择卡片:0)")
			性別判定 = GETVAR(@"%対面者%_MZ_性:(选择卡片:0)")
			CALL SEXTEXT_40074_1_1(決闘者,调教对象,性別判定)
			CALL TRAPSEX_FACETIRON1(対面者,选择卡片:0)
			SIF RESULT >= 4
				条件达成 = 1
			CALL FULLRESET
			効果範囲戦場 = 1
			効果条件表示 = 表側表示
			効果条件カテゴリ = 惑乱魔
			効果条件種類 = エクシーズ
			CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
			IF RESULT == 1 && 条件达成 == 1
				CALL FULLRESET
				PRINTL 対象のモンスターを"蜜壺"としますか？
				PRINTL [1] - ★YEAH!★
				PRINTL [2] - NO
				BINPUT
				IF RESULT == 1
					CALL FULLRESET
					効果条件表示 = 表側表示
					効果条件カテゴリ = 惑乱魔
					効果条件種類 = エクシーズ
					CALL CARD_CHOOSE_BASIC(決闘者,"戦場",ゾーン,場所)
					选择卡片:1 = RESULT
					IF 选择卡片:1 != 9999
						CALL CARD_DISPOSE(対面者,"戦場",选择卡片:0,消滅行き)
						CALL SET_FIELD_INFO(決闘者,"戦場",选择卡片:1,"Ｘ",1)
					ENDIF
					CALL SEXTEXT_40074_1_2(決闘者,调教对象)
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ELSEIF 種類 == 召喚時 || 種類 == 特殊召喚時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,40074,2)
	IF RESULT == 0
		CALL FULLRESET
		効果条件カテゴリ = 惑乱魔
		効果条件種類 = 魔法全般
		CALL CARD_ADD_BASIC(決闘者,"デッキ",ゾーン,場所)
	ENDIF

ELSEIF 種類 == 攻撃時誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,40074,3)
	IF RESULT == 0
		自己卡片 = 戦闘場所(決闘者)
		自己守備力修正 = GETVAR(@"%決闘者%_MZ_守:自己卡片")
		对方卡片 = 戦闘場所(決闘者,1)
		对方攻撃力修正 = GETVAR(@"%対面者%_MZ_攻:对方卡片")
		性別判定 = GETVAR(@"%対面者%_MZ_性:对方卡片")
		IF 性別判定 == 牝性
			调教对象 = GETVAR(@"%対面者%_戦場:对方卡片")
			CALL SEXTEXT_40074_2_1(決闘者,调教对象,性別判定,对方卡片,自己守備力修正,对方攻撃力修正)
		ELSEIF (性別判定 == 雄性 || 性別判定 == ふたなり) && 对方攻撃力修正 - 自己守備力修正 >= 1
			调教对象 = GETVAR(@"%対面者%_戦場:对方卡片")
			CALL SEXTEXT_40074_2_1(決闘者,调教对象,性別判定,对方卡片,自己守備力修正,对方攻撃力修正)
			CALL CARD_EROTICS(调教对象)
			IF RESULT != -1
				SIF 魔罠数(対面者) < 5
					CALL CARD_EQUIP_MONSTER(対面者,对方卡片,"相手戦場",自己卡片,1)
			ELSE
				SIF 魔罠数(対面者) < 5
					CALL CARD_EQUIP_MONSTER(対面者,对方卡片,"相手戦場",自己卡片,1)
			ENDIF
		ELSEIF 性別判定 == 雄性 || 性別判定 == ふたなり
			调教对象 = GETVAR(@"%対面者%_戦場:对方卡片")
			CALL SEXTEXT_40074_2_1(決闘者,调教对象,性別判定,对方卡片,自己守備力修正,对方攻撃力修正)
		ENDIF
		CALL SET_FIELD_INFO(決闘者,"戦場",場所,"表",2,1)
		CALL SET_FIELD_INFO(対面者,"戦場",对方卡片,"普蒂卡纹Ｃ",1)
	ENDIF

ELSEIF 種類 == 攻撃時強制誘発
	CALL FULLRESET
	IF RESULT == 0
		IF 戦闘場所(決闘者,1) != 5
			CALL CARD_EROTICS(戦闘カードID(決闘者,1))
			IF RESULT != 0
				调教对象 = RESULT
			ENDIF
		ENDIF
		IF 调教对象 > 0
			PRINTFORML
			SETCOLOR C_PINK 
			PRINTFORML プティカが%CALLNAME:调教对象%の攻撃に遭おうとしたその時、突然現れた植物が二人を飲み込んだ。
			RESETCOLOR
		ENDIF		
	ENDIF		
ENDIF



