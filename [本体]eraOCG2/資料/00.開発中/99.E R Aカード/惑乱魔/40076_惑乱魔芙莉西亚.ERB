@CARDNAME_40076,参照先
;ココで指定卡片の名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 惑乱魔フレシア
	CASE "略称"
		RESULTS = 惑フレシア
	CASE "カテゴリ"
		RESULTS:0 = 惑乱魔
		RESULTS:1 = E.R.A
ENDSELECT


@CARD_40076(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN エクシーズ
	CASE "属性"
		RETURN 地属性
	CASE "種族"
		RETURN 植物族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 150
	CASE "守備力"
		RETURN 2650
	CASE "性別"
		RETURN 牝性
	CASE "連動ID"
		RETURN 1371
ENDSELECT

RETURN 0

@CARDSUMMON_40076(決闘者,召喚カード,EX参照)
#DIMS DYNAMIC 決闘者
#DIM DYNAMIC 召喚カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 5
素材条件レベル = 4
素材条件カテゴリ:0 = 蟲惑魔
素材条件カテゴリ:1 = 惑乱魔
素材条件数自由 = 1

IF EX参照 == 1
	CALL XYZCAN(決闘者,召喚カード,40076) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_40076(種類)
#DIM DYNAMIC 種類

CALL TEXT_DECORATION("ROGUE")
PRINTL レベル４の「蟲惑魔」モンスターまたは「惑乱魔」モンスター×２体以上
PRINTL このカード名の③の効果は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(0,攻守変動)
PRINTL ①：相手フィールドの蟲紋カウンターが置かれているモンスターを全て攻撃表示にする。
PRINTL その攻撃力は、置かれている蟲紋カウンターの種類の数×１００ダウンする。
CALLFORM CARD_ABLE(0,永続効果)
PRINTL ②：エクシーズ素材を持っているこのカードは相手の効果を受けない。
PRINTL このカードがモンスターゾーンに存在する限り、バトルフェイズ以外では、
PRINTL 「惑乱魔フレシア」以外の自分フィールドの「惑乱魔」モンスターは相手の効果の対象にならず、効果では破壊されない。
CALLFORM CARD_ABLE(1,戦場起動,フリー誘発)
PRINTL ③：相手ターンに、このカードのエクシーズ素材１つを取り除いて発動できる。
PRINTL 相手フィールドのモンスター全てにこのカードの蟲紋カウンターを１つずつ置く。
PRINTL その後、ターン終了時まで、相手フィールドに蟲紋カウンターが置かれているモンスターは攻撃可能な場合、攻撃しなければならない。
CALLFORM CARD_ABLE(2,攻撃時誘発)
SETCOLOR C_PINK
PRINTL ④：自分フィールドに「惑乱魔フレシア」以外の「惑乱魔」モンスターが存在し、
PRINTL このカードが攻撃対象として選択された時、このカードのエクシーズ素材１つを取り除いて発動できる。
PRINTL 攻撃モンスターの攻撃力は自分フィールドの「惑乱魔」モンスターの攻撃力の合計数値だけダウンし、
PRINTL そのモンスターにこのカードの蟲紋カウンターを１つ置き、このカードは守備表示になる。
RESETCOLOR
CALL TEXT_DECORATION("ROGUE")

;攻击怪兽对方的雄性/ふたなり怪兽时发动「惑乱魔フレシア」的④效果，若对方怪兽的攻撃力超过这张卡的守備力与戦場所有惑乱魔怪兽攻撃力的合计守備力，
;这张卡当做肉铠装备给对方怪兽，用这个效果装备的怪兽攻撃力上升这张卡的攻撃力数值，降低攻击怪兽的攻撃力的效果不再适用，
;那之后，自己戦場的惑乱魔モン全般屈服，效果无效化，攻撃力与守備力变成0。

@CARDCAN_40076(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC 必要的卡
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件达成

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,40076)
SIF RESULT == 1
	RETURN 0

IF 種類 == 戦場起動 || 種類 == フリー誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF 発動済_1(決闘者,40076)
		RETURN 0
	SIF ターンプレイヤー == 決闘者
		RETURN 0
	SIF GETVAR(@"%決闘者%_MZ_Ｘ:場所") < 0
		RETURN 0

	CALL FULLRESET
	効果範囲相手戦場 = 1
	効果条件表示 = 表側表示
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 種類 == 攻撃時誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF 戦闘場所(決闘者) != 場所
		RETURN 0
	SIF ターンプレイヤー == 決闘者
		RETURN 0
	SIF GETVAR(@"%決闘者%_MZ_Ｘ:場所") < 0
		RETURN 0

	CALL FULLRESET
	効果条件固名前 = 惑乱魔フレシア
	効果範囲戦場 = 1
	効果条件表示 = 表側表示
	効果条件カテゴリ = 惑乱魔
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 種類 == 攻撃時強制誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF 戦闘場所(決闘者) != 場所
		RETURN 0
	SIF ターンプレイヤー == 決闘者
		RETURN 0
	SIF GETVAR(@"%決闘者%_MZ_Ｘ:場所") < 0
		RETURN 0

	CALL FULLRESET
	効果条件固名前 = 惑乱魔フレシア
	効果範囲戦場 = 1
	効果条件表示 = 表側表示
	効果条件カテゴリ = 惑乱魔
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1		

ELSEIF 種類 == 攻守変動
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1

ELSEIF 種類 == 永続効果
	SIF ゾーン != "戦場"
		RETURN 0
	RETURN 1

ELSEIF 種類 == 短紋章起動
	RETURN 1
ENDIF


@CARDEFFECT_40076(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 守備力修正,2
#DIM DYNAMIC X消費
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 自己卡片
#DIM DYNAMIC 对方卡片
#DIM DYNAMIC 选择卡片
#DIM DYNAMIC 选择卡片_ID
#DIM DYNAMIC 性別判定
#DIM DYNAMIC 调教对象
#DIM DYNAMIC 蟲纹種類
#DIM DYNAMIC 追加蟲纹種類

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 戦場起動 || 種類 == フリー誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,40076,1,X消費1)
	IF RESULT == 0
		FOR カウンタ,0,5
			SIF GETVAR(@"%対面者%_戦場:カウンタ") == -1
				CONTINUE
			SIF GETVAR(@"%対面者%_MZ_リ数:カウンタ") >= 10
				CONTINUE
			SIF GETVAR(@"%対面者%_MZ_表:カウンタ") == 3
				CONTINUE

			CALL SET_FIELD_INFO(対面者,"戦場",カウンタ,"芙莉西亚纹Ｃ",1)
		NEXT

		CALL SEXTEXT_40076_1_1

		CALL CARD_RESERV(決闘者,40076,短紋章予約)
	ENDIF

ELSEIF 種類 == 攻撃時誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,40076,2,X消費1)
	IF RESULT == 0
		自己卡片 = 戦闘場所(決闘者)
		守備力修正:0 = GETVAR(@"%決闘者%_MZ_守:自己卡片")
		对方卡片 = 戦闘場所(決闘者,1)
		攻撃力修正 = GETVAR(@"%対面者%_MZ_攻:对方卡片")
		性別判定 = GETVAR(@"%対面者%_MZ_性:对方卡片")

		CALL FULLRESET
		効果範囲戦場 = 1
		効果条件表示 = 表側表示
		効果条件カテゴリ = 惑乱魔
		効果条件CNT = 1
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		守備力修正:1 = RESULT:3

		IF 性別判定 == 牝性
			调教对象 = GETVAR(@"%対面者%_戦場:对方卡片")
			CALL SEXTEXT_40076_2_1(決闘者,调教对象,性別判定,对方卡片,守備力修正:0,攻撃力修正)

			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(決闘者,"自動処理",对方卡片,"永攻DOWN",守備力修正:1)
			
		ELSEIF (性別判定 == 雄性 || 性別判定 == ふたなり) && 攻撃力修正 - (守備力修正:0 + 守備力修正:1) >= 1
			CALL SET_FIELD_INFO(決闘者,"戦場",場所,"Ｘ",-1)
			调教对象 = GETVAR(@"%対面者%_戦場:对方卡片")
			CALL SEXTEXT_40076_2_1(決闘者,调教对象,性別判定,对方卡片,(守備力修正:0 + 守備力修正:1),攻撃力修正)
			CALL CARD_EROTICS(调教对象)
			IF RESULT != -1
				SIF 魔罠数(対面者) < 5
					CALL CARD_EQUIP_MONSTER(対面者,对方卡片,"相手戦場",自己卡片,1)
			ELSE
				SIF 魔罠数(対面者) < 5
					CALL CARD_EQUIP_MONSTER(対面者,对方卡片,"相手戦場",自己卡片,1)
			ENDIF

			CALL FULLRESET
			効果条件表示 = 表側表示
			効果条件カテゴリ = 惑乱魔
			CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"永攻",-999999)
			CALL FULLRESET
			効果条件表示 = 表側表示
			効果条件カテゴリ = 惑乱魔
			CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"永守",-999999)

		ELSEIF 性別判定 == 雄性 || 性別判定 == ふたなり
			调教对象 = GETVAR(@"%対面者%_戦場:对方卡片")
			CALL SEXTEXT_40076_2_1(決闘者,调教对象,性別判定,对方卡片,守備力修正:0,攻撃力修正)

			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(決闘者,"自動処理",对方卡片,"永攻DOWN",守備力修正)
		ELSE
			CALL FULLRESET
			CALL CARD_REMOVAL_BASIC(決闘者,"自動処理",对方卡片,"永攻DOWN",守備力修正)
		ENDIF
		CALL SET_FIELD_INFO(決闘者,"戦場",場所,"表",2,1)
		CALL SET_FIELD_INFO(対面者,"戦場",对方卡片,"芙莉西亚纹Ｃ",1)
	ENDIF

ELSEIF 種類 == 攻撃時強制誘発
	CALL FULLRESET
	IF RESULT == 0
		IF 戦闘場所(決闘者,1) != 5
			CALL CARD_EROTICS(戦闘カードID(決闘者,1))
			IF RESULT != 0
				调教对象 = RESULT
			ENDIF
		ENDIF
		IF 调教对象 > 0
			PRINTFORML
			SETCOLOR C_PINK 
			PRINTFORMW %CALLNAME:调教对象%は真っ先にフレシアを始末しようとしたが、暗がりに潜む惑乱魔たちに気づかなかった。
			RESETCOLOR
		ENDIF
	ENDIF

ELSEIF 種類 == 攻守変動
	FOR カウンタ,0,5
		SIF GETVAR(@"%対面者%_戦場:カウンタ") == -1
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_リ数:カウンタ") >= 10
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_表:カウンタ") == 3
			CONTINUE

		CALL TRAPSEX_FACETIRON1(対面者,カウンタ)
		蟲纹種類 = RESULT
		IF 蟲纹種類 >= 1
			CALL FULLRESET
			攻撃力修正 = 蟲纹種類 * 100
			CALL STATCHANGE_BASIC(対面者,"自身",カウンタ,-攻撃力修正,0,40076)
			CALL STATCHANGE_EFFECT(対面者,"自身",カウンタ,"表",1)
		ENDIF
	NEXT

ELSEIF 種類 == 永続効果
	IF GETVAR(@"%決闘者%_MZ_Ｘ:場所") >= 0
		CALL FULLRESET
		CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"モ耐")
		CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"魔耐")
		CALL STATCHANGE_EFFECT(決闘者,"自身",場所,"罠耐")
	ENDIF

	IF バトルフェイズ != 1
		CALL FULLRESET
		効果条件カテゴリ = 惑乱魔
		効果条件表示 = 表側表示
		効果条件他所 = 1
		CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"破耐")
		CALL STATCHANGE_EFFECT(決闘者,"戦場",場所,"対耐")
	ENDIF

ELSEIF 種類 == 短紋章起動
	FOR カウンタ,0,5
		SIF GETVAR(@"%対面者%_戦場:カウンタ") == -1
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_リ数:カウンタ") >= 10
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_表:カウンタ") == 3
			CONTINUE

		CALL TRAPSEX_FACETIRON1(対面者,カウンタ)
		蟲纹種類 = RESULT
		SIF 蟲纹種類 >= 1
			CALL STATCHANGE_EFFECT(対面者,"自身",カウンタ,"戦狂")
	NEXT
ENDIF
