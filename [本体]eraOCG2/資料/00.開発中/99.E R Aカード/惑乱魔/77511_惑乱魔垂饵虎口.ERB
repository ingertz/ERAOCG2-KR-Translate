@CARDNAME_77511,参照先
;ココで指定卡片の名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 惑乱魔垂饵虎口
	CASE "略称"
		RESULTS = えさを垂れる虎口
	CASE "カテゴリ"
		RESULTS:0 = 惑乱魔
		RESULTS:1 = E.R.A
ENDSELECT


@CARD_77511(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 速攻魔法
ENDSELECT

RETURN 0

@CARD_EXPLANATION_77511(種類)
#DIM DYNAMIC 種類

CALL TEXT_DECORATION("ROGUE")
PRINTL このカード名の①の効果は１ターンに１度しか使用できない。
CALLFORM CARD_ABLE(1,魔罠起動,手札起動)
PRINTL ①：このカードは、手札から「惑乱魔」モンスター１体を墓地へ送って発動する事もできる。
PRINTL 相手はデッキからモンスター１体を特殊召喚する。
PRINTL 그 후、自分はデッキから「落とし穴」通常罠カードまたは「蜜穴」通常罠カード１枚を手札に加える事ができる。
PRINTL 「惑乱魔」モンスターをリリースしてこのカードを発動した場合、
PRINTL 相手がこの効果で特殊召喚したモンスターの効果はターン終了時まで無効化される。
CALL TEXT_DECORATION("ROGUE")

@CARDCAN_77511(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,77511)
SIF RESULT == 1
	RETURN 0

IF 種類 == 魔罠起動 || 種類 == 手札起動
	CALL CARD_QUICK_M(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	SIF 発動済_1(決闘者,77511)
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_77511(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 魔罠起動 || 種類 == 手札起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,77511,1)
	IF RESULT == 0
		CALL CARD_DISPOSE(決闘者,ゾーン,場所)
		CALL FULLRESET
		効果範囲手札 = 1
		効果条件カテゴリ = 惑乱魔
		効果条件種類 = モン全般
		CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
		IF RESULT != 0 ;检测到手札中有符合条件的卡，如果有则触发选项。
			CALL FULLRESET
			PRINTL 手札から「惑乱魔」モンスター１枚を捨てて、このカードを発動しますか？
			PRINTL [1] - ★YEAH!★
			PRINTL [2] - NO
			BINPUT
			IF RESULT == 1 ;选择是的场合，从手札中将符合条件的卡丢弃。
				CALL FULLRESET
				効果範囲手札 = 1
				効果条件カテゴリ = 惑乱魔
				効果条件種類 = モン全般
				CALL CARD_ADD_GY_BASIC(決闘者,"手札",ゾーン,場所)
				IF RESULT == 1 ;成功将符合条件的卡从手札丢弃的场合。
					CALL FULLRESET
					効果範囲デッキ = 1
					効果条件性別 = 性別在
					効果追加種類 = 22
					CALL CARD_SP_SUMMON_ADV(対面者,ゾーン,場所)
					IF RESULT == 1 ;对方成功把符合条件的卡特殊召唤的场合（追加无效）。
						CALL FULLRESET
						効果条件種類 = 通常罠
						効果条件カテゴリ:0 = 落とし穴
						効果条件カテゴリ:1 = 蜜穴
						CALL CARD_ADD_BASIC(決闘者,"デッキ",ゾーン,場所)
					ENDIF
				ELSE ;选择是却没能成功将符合条件的卡从手札丢弃的场合，对方直接把怪兽特殊召唤。
					CALL FULLRESET
					効果範囲デッキ = 1
					効果条件性別 = 性別在
					効果条件種類 = モン全般
					CALL CARD_SP_SUMMON_ADV(対面者,ゾーン,場所)
					IF RESULT == 1 ;对方成功把符合条件的卡特殊召唤的场合。
						CALL FULLRESET
						効果条件種類 = 通常罠
						効果条件カテゴリ:0 = 落とし穴
						効果条件カテゴリ:1 = 蜜穴
						CALL CARD_ADD_BASIC(決闘者,"デッキ",ゾーン,場所)
					ENDIF
				ENDIF
			ELSE ;选择拒绝的场合，对方直接把怪兽特殊召唤。
				CALL FULLRESET
				効果範囲デッキ = 1
				効果条件性別 = 性別在
				効果条件種類 = モン全般
				CALL CARD_SP_SUMMON_ADV(対面者,ゾーン,場所)
				IF RESULT == 1 ;对方成功把符合条件的卡特殊召唤的场合。
					CALL FULLRESET
					効果条件種類 = 通常罠
					効果条件カテゴリ:0 = 落とし穴
					効果条件カテゴリ:1 = 蜜穴
					CALL CARD_ADD_BASIC(決闘者,"デッキ",ゾーン,場所)
				ENDIF
			ENDIF
		ELSE ;手札中没有符合条件的卡的场合，对方直接从卡组将卡特殊召唤。
			CALL FULLRESET
			効果範囲デッキ = 1
			効果条件性別 = 性別在
			効果条件種類 = モン全般
			CALL CARD_SP_SUMMON_ADV(対面者,ゾーン,場所)
			IF RESULT == 1 ;对方成功把符合条件的卡特殊召唤的场合。
				CALL FULLRESET
				効果条件種類 = 通常罠
				効果条件カテゴリ:0 = 落とし穴
				効果条件カテゴリ:1 = 蜜穴
				CALL CARD_ADD_BASIC(決闘者,"デッキ",ゾーン,場所)
			ENDIF
		ENDIF
	ENDIF
ENDIF
