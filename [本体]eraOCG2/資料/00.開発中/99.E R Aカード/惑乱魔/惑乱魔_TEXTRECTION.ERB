;40070——惑乱魔トリオン
	;3效果判定
		@SEXTEXT_40070_1_1(決闘者,调教对象,性別判定,对方卡片,自己守備力修正,对方攻撃力修正)
		#DIMS DYNAMIC 決闘者
		#DIMS DYNAMIC 対面者
		#DIM DYNAMIC 自己守備力修正
		#DIM DYNAMIC 对方卡片
		#DIM DYNAMIC 对方攻撃力修正
		#DIM DYNAMIC 调教对象
		#DIM DYNAMIC 性別判定

		CALL 対面者判定(決闘者)
		対面者 = %RESULTS%

		IF 性別判定 == 牝性
			CALL CARD_EROTICS(调教对象)
			IF RESULT != -1
				调教对象 = RESULT
				SETCOLOR C_PINK
				PRINTFORML トリオンの指が%CALLNAME:调教对象%の腔内を掻き回しており、快感によって%CALLNAME:调教对象%は攻撃に集中することが困難になっている。
				PRINTFORMW それと同時に、色の異様な花紋がゆっくりと%CALLNAME:调教对象%の身体に這い上がってきた……
				RESETCOLOR
				CALL EROTIC_MOVE("指入れ",调教对象,NO_TO_CHARANUM(1372))
			ENDIF
		ELSEIF (性別判定 == 雄性 || 性別判定 == ふたなり) && 对方攻撃力修正 - 自己守備力修正 >= 1
			CALL CARD_EROTICS(调教对象)
			IF RESULT != -1
				调教对象 = RESULT
				SETCOLOR C_PINK
				PRINTFORMW トリオンは交歓の快感に溺れ、%CALLNAME:调教对象%の肉棒に完全に征服されてしまった……！
				RESETCOLOR
				CALL EROTIC_MOVE("前穴凌辱",NO_TO_CHARANUM(1372),调教对象)
				IF 魔罠数(対面者) < 5
					SETCOLOR C_PINK
					PRINTFORMW そしてそのまま%CALLNAME:调教对象%に肉鎧として連れ去られてしまった……
					RESETCOLOR
				ENDIF
				ELSE
					CALLFORM CARDNAME_{GETVAR(@"%対面者%_戦場:对方卡片")}("名前")
					SETCOLOR C_PINK
					PRINTFORMW トリオンは交歓の快感に溺れ、%RESULTS%の肉棒に完全に征服されてしまった……！
					RESETCOLOR
					CALL EROTIC_MOVE("前穴凌辱",NO_TO_CHARANUM(1372), -1)
					IF 魔罠数(対面者) < 5
						SETCOLOR C_PINK
						PRINTFORMW そしてそのまま%RESULTS%に肉鎧として連れ去られてしまった……
						RESETCOLOR
					ENDIF
				ENDIF
		ELSEIF 性別判定 == 雄性 || 性別判定 == ふたなり
			CALL CARD_EROTICS(调教对象)
			IF RESULT != -1
				调教对象 = RESULT
				SETCOLOR C_PINK
				PRINTFORML トリオンの手が%CALLNAME:调教对象%の肉棒を掴んで高速で扱いており、快感によって%CALLNAME:调教对象%は攻撃に集中することが困難になっている。
				PRINTFORMW それと同時に、色の異様な花紋がゆっくりと%CALLNAME:调教对象%の身体に這い上がってきた……
				RESETCOLOR
				CALL EROTIC_MOVE("全身愛撫",调教对象,NO_TO_CHARANUM(1372))
			ENDIF
		ENDIF

