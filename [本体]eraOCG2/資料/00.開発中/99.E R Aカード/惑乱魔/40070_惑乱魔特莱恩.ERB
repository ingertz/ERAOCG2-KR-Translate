@CARDNAME_40070,参照先
;ココで指定卡片の名前、略称を返す予定「」
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 惑乱魔トリオン
	CASE "略称"
		RESULTS = 惑トリオン
	CASE "カテゴリ"
		RESULTS:0 = 惑乱魔
		RESULTS:1 = E.R.A
ENDSELECT


@CARD_40070(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN 効果モン
	CASE "属性"
		RETURN 地属性
	CASE "種族"
		RETURN 昆虫族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 800
	CASE "守備力"
		RETURN 2000
	CASE "性別"
		RETURN 牝性
	CASE "連動ID"
		RETURN 1372
ENDSELECT

RETURN 0

@CARD_EXPLANATION_40070(種類)
#DIM DYNAMIC 種類

CALL TEXT_DECORATION("ROGUE")
PRINTL このカード名の①②の効果は１ターンに１度、いずれか１つしか使用できない。
CALLFORM CARD_ABLE(1,召喚時,特殊召喚時)
PRINTL ①：このカードが召喚・特殊召喚に成功した場合に発動できる。
PRINTL デッキから「落とし穴」通常罠カードまたは「蜜穴」通常罠カード１枚を手札に加える。
CALLFORM CARD_ABLE(2,戦場起動)
PRINTL ②：このカードが攻撃表示の場合、相手フィールドの魔法・罠カード１枚を対象として発動できる。
PRINTL その相手のカードを破壊し、このカードは守備表示になる。この効果は相手ターンでも発動できる。
CALLFORM CARD_ABLE(3,攻撃時誘発)
SETCOLOR C_PINK
PRINTL ③：攻撃表示のこのカードが攻撃対象として選択された時に発動できる。
PRINTL その攻撃モンスターにこのカードの蟲紋カウンターを１つ置き、このカードは守備表示になる。
RESETCOLOR
CALL TEXT_DECORATION("ROGUE")


@CARDCAN_40070(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,40070)
SIF RESULT == 1
	RETURN 0

IF 種類 == 召喚時 || 種類 == 特殊召喚時
	SIF 発動済_1(決闘者,40070)
		RETURN 0
	SIF 発動済_2(決闘者,40070)
		RETURN 0
	RETURN 1

ELSEIF 種類 == 戦場起動 || 種類 == フリー誘発
	SIF 発動済_1(決闘者,40070)
		RETURN 0
	SIF 発動済_2(決闘者,40070)
		RETURN 0
	SIF ゾーン != "戦場"
		RETURN 0
	SIF GETVAR(@"%決闘者%_MZ_表:場所") != 1
		RETURN 0

	CALL FULLRESET
	効果範囲相手魔罠 = 1
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
	RETURN 1

ELSEIF 種類 == 攻撃時誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF 戦闘場所(決闘者) != 場所
		RETURN 0
	SIF ターンプレイヤー == 決闘者
		RETURN 0
	SIF GETVAR(@"%決闘者%_MZ_表:場所") == 2
		RETURN 0
	RETURN 1

ELSEIF 種類 == 攻撃時強制誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF 戦闘場所(決闘者) != 場所
		RETURN 0
	SIF ターンプレイヤー == 決闘者
		RETURN 0
	SIF GETVAR(@"%決闘者%_MZ_表:場所") == 2
		RETURN 0
	RETURN 1		
ENDIF

@CARDEFFECT_40070(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 自己卡片
#DIM DYNAMIC 自己守備力修正
#DIM DYNAMIC 对方卡片
#DIM DYNAMIC 对方攻撃力修正
#DIM DYNAMIC 调教对象
#DIM DYNAMIC 性別判定

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == 召喚時 || 種類 == 特殊召喚時
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,40070,1)
	IF RESULT == 0
		CALL FULLRESET
		効果条件種類 = 通常罠
		効果条件カテゴリ:0 = 落とし穴
		効果条件カテゴリ:1 = 蜜穴
		CALL CARD_ADD_BASIC(決闘者,"デッキ",ゾーン,場所)
	ENDIF

ELSEIF 種類 == 戦場起動 || 種類 == フリー誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,40070,2)
	IF RESULT == 0
		CALL FULLRESET
		CALL CARD_REMOVAL_BASIC(決闘者,"魔罠単体",場所,"墓地")

		CALL SET_FIELD_INFO(決闘者,"戦場",場所,"表",2,1)
	ENDIF

ELSEIF 種類 == 攻撃時誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,40070,3)
	IF RESULT == 0
		自己卡片 = 戦闘場所(決闘者)
		自己守備力修正 = GETVAR(@"%決闘者%_MZ_守:自己卡片")
		对方卡片 = 戦闘場所(決闘者,1)
		对方攻撃力修正 = GETVAR(@"%対面者%_MZ_攻:对方卡片")
		性別判定 = GETVAR(@"%対面者%_MZ_性:对方卡片")
		IF 性別判定 == 牝性
			调教对象 = GETVAR(@"%対面者%_戦場:对方卡片")
			CALL SEXTEXT_40070_1_1(決闘者,调教对象,性別判定,对方卡片,自己守備力修正,对方攻撃力修正)
		ELSEIF (性別判定 == 雄性 || 性別判定 == ふたなり) && 对方攻撃力修正 - 自己守備力修正 >= 1
			调教对象 = GETVAR(@"%対面者%_戦場:对方卡片")
			CALL SEXTEXT_40070_1_1(決闘者,调教对象,性別判定,对方卡片,自己守備力修正,对方攻撃力修正)
			CALL CARD_EROTICS(调教对象)
			IF RESULT != -1
				SIF 魔罠数(対面者) < 5
					CALL CARD_EQUIP_MONSTER(対面者,对方卡片,"相手戦場",自己卡片,1)
			ELSE
				SIF 魔罠数(対面者) < 5
					CALL CARD_EQUIP_MONSTER(対面者,对方卡片,"相手戦場",自己卡片,1)
			ENDIF
		ELSEIF 性別判定 == 雄性 || 性別判定 == ふたなり
			调教对象 = GETVAR(@"%対面者%_戦場:对方卡片")
			CALL SEXTEXT_40070_1_1(決闘者,调教对象,性別判定,对方卡片,自己守備力修正,对方攻撃力修正)
		ENDIF
		CALL SET_FIELD_INFO(決闘者,"戦場",場所,"表",2,1)
		CALL SET_FIELD_INFO(対面者,"戦場",对方卡片,"特莱恩纹Ｃ",1)
	ENDIF

ELSEIF 種類 == 攻撃時強制誘発
	CALL FULLRESET
	IF RESULT == 0
		IF 戦闘場所(決闘者,1) != 5
			CALL CARD_EROTICS(戦闘カードID(決闘者,1))
			IF RESULT != 0
				调教对象 = RESULT
			ENDIF
		ENDIF
		IF 调教对象 > 0
			PRINTFORML
			SETCOLOR C_PINK 
			PRINTFORML 用意不足の%CALLNAME:调教对象%は足を滑らせ、トリオンに罠穴へと引きずり込まれた。
			RESETCOLOR
		ENDIF
	ENDIF		
ENDIF




