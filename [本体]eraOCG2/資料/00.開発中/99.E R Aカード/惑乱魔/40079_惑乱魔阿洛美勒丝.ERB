@CARDNAME_40079,参照先
;ココで指定卡片の名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 惑乱魔アロメルス
	CASE "略称"
		RESULTS = 惑アロメルス
	CASE "カテゴリ"
		RESULTS:0 = 惑乱魔
		RESULTS:1 = E.R.A
ENDSELECT


@CARD_40079(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "種類"
		RETURN エクシーズ
	CASE "属性"
		RETURN 地属性
	CASE "種族"
		RETURN 昆虫族
	CASE "レベル"
		RETURN 4
	CASE "攻撃力"
		RETURN 1100
	CASE "守備力"
		RETURN 1700
	CASE "性別"
		RETURN 牝性
	CASE "連動ID"
		RETURN 1377
ENDSELECT

RETURN 0

@CARDSUMMON_40079(決闘者,召喚カード,EX参照)
#DIMS DYNAMIC 決闘者
#DIM DYNAMIC 召喚カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 5
素材条件レベル = 4
素材条件カテゴリ:0 = 蟲惑魔
素材条件カテゴリ:1 = 惑乱魔
素材条件数自由 = 1

IF EX参照 == 1
	CALL XYZCAN(決闘者,召喚カード,40079) 
	RETURN RESULT
ENDIF



@CARD_EXPLANATION_40079(種類)
#DIM DYNAMIC 種類

CALL TEXT_DECORATION("ROGUE")
PRINTL レベル４の「蟲惑魔」モンスターまたは「惑乱魔」モンスター×２体以上
PRINTL このカード名の②④の効果は１ターンに１度、いずれか１つしか使用できない。
CALL CARD_ABLE(1,EXデッキ起動)
PRINTL ①：相手フィールドに蟲紋カウンターが４種類以上置かれているモンスターが存在する場合、
PRINTL 「惑乱魔アロメレス」は１ターンに１度、自分フィールドの「惑乱魔」モンスターの上に重ねてエクシーズ召喚する事もできる。
CALLFORM CARD_ABLE(2,戦場起動)
PRINTL ②：自分・相手ターンに、相手フィールドの表側表示モンスター１体を対象として発動できる。
PRINTL このカードをリリースし、対象のモンスターにこのカードの蟲紋カウンターを１つ置き、そのカードのコントロールを得る。
PRINTL この効果でコントロールを得たモンスターはターン終了時に持ち主の手札に戻る。
PRINTL その後、対象のモンスターに置かれている蟲紋カウンターが４種類以上の場合、
PRINTL この効果でコントロールを得たモンスターは持ち主の手札に戻らず、「惑乱魔」モンスターとして扱う。
CALLFORM CARD_ABLE(3,発動誘発)
PRINTL ③：相手がフィールドのモンスターの効果を発動した時、このカードのエクシーズ素材を１つ取り除いて発動できる。
PRINTL そのモンスターにこのカードの蟲紋カウンターを１つ置く。
CALLFORM CARD_ABLE(4,墓地起動)
PRINTL ④：このカードが墓地に存在し、自分フィールドの表側表示モンスター１体を対象として発動できる。
PRINTL このカードを特殊召喚する。対象のモンスターに蟲紋カウンターが置かれている場合、そのカードを“消滅”し、
PRINTL そのモンスターに置かれていた蟲紋カウンターの種類の数だけエクシーズ素材を得る。
PRINTL このカードの攻撃力はターン終了時まで、得たエクシーズ素材の数×４００アップする。
CALL TEXT_DECORATION("ROGUE")



@CARDCAN_40079(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC 対面者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要的卡
#DIM DYNAMIC 蟲纹持有数

CALL 対面者判定(決闘者)
対面者 = %RESULTS%

CALL CARD_NEGATE(決闘者,種類,ゾーン,場所,40079)
SIF RESULT == 1
	RETURN 0
IF 種類 == EXデッキ起動
	SIF 発動済_1(決闘者,40079)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	CALL CARD_EX_CHECK(決闘者,40079)
	SIF RESULT == 1
		RETURN 0

	CALL FULLRESET
	効果範囲戦場 = 1
	効果条件カテゴリ = 惑乱魔
	効果条件表示 = 表側表示
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0

	FOR カウンタ,0,5
		SIF GETVAR(@"%対面者%_戦場:カウンタ") == -1
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_リ数:カウンタ") >= 10
			CONTINUE
		SIF GETVAR(@"%対面者%_MZ_表:カウンタ") == 3
			CONTINUE

		CALL TRAPSEX_FACETIRON1(対面者,カウンタ)
		SIF RESULT >= 4
			RETURN 1
	NEXT

ELSEIF 種類 == 戦場起動
	SIF 発動済_2(決闘者,40079)
		RETURN 0
	SIF 発動済_4(決闘者,40079)
		RETURN 0
	SIF ゾーン != "戦場"
		RETURN 0

	CALL FULLRESET
	効果範囲相手戦場 = 1
	効果条件表示 = 表側表示
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
    RETURN 1

ELSEIF 種類 == 発動誘発
	SIF ゾーン != "戦場"
		RETURN 0
	SIF GETVAR(@"%決闘者%_MZ_Ｘ:場所") < 0
		RETURN 0

	CALL FULLRESET
	効果範囲戦場 = 1
	効果条件種類 = モン全般
	CALL CARD_CHECK_START_DATA(決闘者,1)
	SIF RESULT != 1
		RETURN 0
    RETURN 1

ELSEIF 種類 == 墓地起動
	SIF 発動済_2(決闘者,40079)
		RETURN 0
	SIF 発動済_4(決闘者,40079)
		RETURN 0
	SIF ゾーン != "墓地"
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 決闘者
		RETURN 0
	SIF モンスター数(決闘者) >= 5
		RETURN 0

	CALL FULLRESET
	効果範囲戦場 = 1
	効果条件表示 = 表側表示
	CALL CARD_CHECK_ADV(決闘者,種類,ゾーン,場所)
	SIF RESULT != 1
		RETURN 0
    RETURN 1
ENDIF


@CARDEFFECT_40079(決闘者,種類,ゾーン,場所)
#DIMS DYNAMIC 決闘者
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 種類
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 攻撃力修正
#DIM DYNAMIC 性別判定
#DIM DYNAMIC X素材数
#DIM DYNAMIC 蟲纹種類
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 效果先
#DIM DYNAMIC 选择卡片
#DIM DYNAMIC 调教对象


CALL 対面者判定(決闘者)
対面者 = %RESULTS%

IF 種類 == EXデッキ起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,40079,1)
	IF RESULT == 0
		CALL FULLRESET
		CALL RESETCONDITION_MAT
		必要素材数 = 1
		素材条件カテゴリ = 惑乱魔
		重ねてＸ = 1
		TRYCALLFORM XYZSUMMON(決闘者,場所)
	ENDIF
	
ELSEIF 種類 == 戦場起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,40079,2)
	IF RESULT == 0
		CALL CARD_DISPOSE(決闘者,ゾーン,場所)

		CALL FULLRESET
		効果条件表示 = 表側表示
		CALL CARD_CHOOSE_BASIC(決闘者,"相手戦場",ゾーン,場所)
		选择卡片 = RESULT
		IF 选择卡片 != 9999
			CALL SET_FIELD_INFO(対面者,"戦場",选择卡片,"阿洛美勒丝纹Ｃ",1)
			调教对象 = GETVAR(@"%対面者%_戦場:选择卡片")

			CALL TRAPSEX_FACETIRON1(対面者,选择卡片)
			蟲纹種類 = RESULT
			IF 蟲纹種類 < 4
				CALL FULLRESET
				効果追加種類 = 3
				CALL CARD_REMOVAL_BASIC(決闘者,"自動処理",选择卡片,"強奪")

				CALL SEXTEXT_40079_1_2(決闘者,蟲纹種類,调教对象)
			ELSEIF 蟲纹種類 >= 4
				CALL FULLRESET
				効果追加カテ = 惑乱魔
				CALL CARD_REMOVAL_BASIC(決闘者,"自動処理",选择卡片,"強奪")

				CALL SEXTEXT_40079_1_2(決闘者,蟲纹種類,调教对象)
			ENDIF
		ENDIF
    ENDIF

ELSEIF 種類 == 発動誘発
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,40079,3,X消費1)
	IF RESULT == 0
		选择卡片 = 効後_設場所:(処理中番号 - 1)
		CALL FULLRESET	
		CALL SET_FIELD_INFO(対面者,"戦場",选择卡片,"阿洛美勒丝纹Ｃ",1)
	ENDIF
	
ELSEIF 種類 == 墓地起動
	CALL CARD_CHOICE(決闘者,種類,ゾーン,場所,40079,4)
	IF RESULT == 0
		CALL FULLRESET
		効果範囲戦場 = 1
		効果条件表示 = 表側表示
		CALL CARD_CHOOSE_BASIC(決闘者,"戦場",ゾーン,場所)
		选择卡片 = RESULT
		IF 选择卡片 != 9999
			CALL TRAPSEX_FACETIRON1(決闘者,选择卡片)
			蟲纹種類 = RESULT
			调教对象 = GETVAR(@"%決闘者%_戦場:选择卡片")
			性別判定 = GETVAR(@"%決闘者%_MZ_性:选择卡片")
			攻撃力修正 = 蟲纹種類 * 400

			CALL FULLRESET
			CALL CARD_SP_SUMMON(決闘者,ゾーン,場所)
			效果先 = 最終召喚場所
			IF 效果先 != 5 && 蟲纹種類 >= 1
				CALL SET_FIELD_INFO(決闘者,"戦場",效果先,"Ｘ",蟲纹種類)
				CALL CARD_DISPOSE(決闘者,"戦場",选择卡片,消滅行き)
				CALL SET_FIELD_INFO(決闘者,"戦場",效果先,"一攻",攻撃力修正)
				CALL SEXTEXT_40079_2_1(決闘者,蟲纹種類,调教对象,性別判定)
			ENDIF
		ENDIF
	ENDIF
ENDIF


