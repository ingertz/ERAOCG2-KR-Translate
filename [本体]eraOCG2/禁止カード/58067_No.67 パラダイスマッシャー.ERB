@CARDNAME_58067,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = No.67 パラダイスマッシャー
	CASE "略称"
		RESULTS = #67 パラダイスマッシャー
	CASE "カテゴリ"
		RESULTS:0 = ナンバーズ
		RESULTS:1 = ダイス
ENDSELECT


@CARD_58067(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 엑시즈
	CASE "속성"
		RETURN 빛속성
	CASE "종족"
		RETURN 천사족
	CASE "レベル"
		RETURN 5
	CASE "攻撃力"
		RETURN 2100
	CASE "守備力"
		RETURN 2100
	CASE "성별"
		RETURN 雄性
	CASE "制限"
		RETURN 制限
ENDSELECT

RETURN 0

@CARDSUMMON_58067(듀얼리스트,소환カード,EX参照)
#DIMS DYNAMIC 듀얼리스트
#DIM DYNAMIC 소환カード
#DIM DYNAMIC EX参照
#DIM DYNAMIC カウンタ

CALL RESETCONDITION_MAT
必要素材数 = 5
素材条件レベル = 5
素材条件数自由 = 1
;추가효과用

IF EX参照 == 1
	CALL XYZCAN(듀얼리스트,소환カード,58067) 
	RETURN RESULT
ENDIF


