@CARDCAN_58016(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 必要カード
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 条件달성

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,58016)
SIF RESULT == 1
	RETURN 0

IF 종류 == 필드起動
	SIF 효과발동済(듀얼리스트,場所,ゾーン)
		RETURN 0
	SIF メインフェイズ != 1
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_Ｘ:場所") <= -1
		RETURN 0
	RETURN 1

ELSEIF 종류 == ターン開始時強制
	SIF ゾーン != "필드"
		RETURN 0
	SIF ターンプレイヤー != 듀얼리스트
		RETURN 0
	RETURN 1

ELSEIF 종류 == 지속효과
	SIF ゾーン != "필드"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_MZ_汎数:場所") <= 0
		RETURN 0
	RETURN 1
ENDIF

@CARDEFFECT_58016(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIMS DYNAMIC 対面者
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 選択カード

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 필드起動
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,58016,10,X消費1)
	IF RESULT == 0
		IF 듀얼리스트 == "자신"
			PRINTL 【カードの종류を選択してください】
			PRINTL
			PRINTL [1] - モンスター
			PRINTL [2] - 마법
			PRINTL [3] - 함정
			BINPUT
		ELSE
			RESULT = RAND:2 + 1
		ENDIF
		CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"汎数",RESULT,1)
	ENDIF

ELSEIF 종류 == ターン開始時強制
	CALL SET_FIELD_INFO(듀얼리스트,ゾーン,場所,"汎数",0,1)

ELSEIF 종류 == 지속효과
	SELECTCASE GETVAR(@"%듀얼리스트%_MZ_汎数:場所")
		CASE 1
			CALL SET_PLAYER_INFO(듀얼리스트,"モン효과無効",3)
			CALL SET_PLAYER_INFO(듀얼리스트,"モン효과無効",3,1)
		CASE 2
			CALL SET_PLAYER_INFO(듀얼리스트,"魔無効",3)
			CALL SET_PLAYER_INFO(듀얼리스트,"魔無効",3,1)
		CASE 3
			CALL SET_PLAYER_INFO(듀얼리스트,"함정無効",3)
			CALL SET_PLAYER_INFO(듀얼리스트,"함정無効",3,1)
	ENDSELECT
ENDIF

