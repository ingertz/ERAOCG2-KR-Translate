@CARDNAME_80001,参照先
;ココで지정カードの名前、略称を返す予定
#DIMS DYNAMIC 参照先

VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "名前"
		RESULTS = 第六感
	CASE "略称"
		RESULTS = 第六感
	CASE "カテゴリ"
		RESULTS:0 = なし
ENDSELECT


@CARD_80001(参照先)

#DIMS DYNAMIC 参照先
VARSET RESULT
VARSET RESULTS

SELECTCASE 参照先
	CASE "종류"
		RETURN 通常함정
	CASE "制限"
		RETURN 制限
	CASE "レア度"
		RETURN ULR
ENDSELECT

RETURN 0

@CARD_EXPLANATION_80001(종류)
#DIM DYNAMIC 종류
CALLFORM CARD_ABLE(0,마함起動,フリー誘発)
PRINTL ①：자신은 １から６までの数字を２つ宣言する。
PRINTL サイコロを１回振り、宣言した数字の内どちらか１つが出た場合、その枚数分자신은 ドローする。
PRINTL ハズレの場合、出た目の枚数分덱の上からカードを묘지へ送る。
PRINTL 
PRINTL 

@CARDCAN_80001(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%


CALL CARD_NEGATE(듀얼리스트,종류,ゾーン,場所,80001)
SIF RESULT == 1
	RETURN 0
IF 종류 == 마함起動 || 종류 == フリー誘発
	SIF ゾーン != "마함"
		RETURN 0
	SIF GETVAR(@"%듀얼리스트%_魔_表:場所") == 3
		RETURN 0
	CALL CARD_DRAW_CHECK
	RETURN 1
ENDIF


@CARDEFFECT_80001(듀얼리스트,종류,ゾーン,場所)
#DIMS DYNAMIC 듀얼리스트
#DIMS DYNAMIC ゾーン
#DIM DYNAMIC 종류
#DIM DYNAMIC 場所
#DIM DYNAMIC カウンタ
#DIM DYNAMIC 宣言数字,2
#DIMS DYNAMIC 対面者

CALL 対面者판정(듀얼리스트)
対面者 = %RESULTS%

IF 종류 == 마함起動 || 종류 == フリー誘発
	;カード발동確認
	CALL CARD_CHOICE(듀얼리스트,종류,ゾーン,場所,80001)
	IF RESULT == 0
		CALL CARD_DISPOSE(듀얼리스트,ゾーン,場所)
		IF 듀얼리스트 == "자신"
			PRINTL 【１つ目の数字を宣言してください】
			PRINTL
			FOR カウンタ,1,7
				PRINT [カウンタ]　
			NEXT
			PRINTL
			BINPUT
			宣言数字:0 = RESULT

			PRINTL 【２つ目の数字を宣言してください】
			PRINTL
			FOR カウンタ,1,7
				IF 宣言数字:0 != カウンタ
					PRINT [カウンタ]　
				ELSE
					PRINT 「{カウンタ}」
				ENDIF
			NEXT
			PRINTL
			BINPUT
			宣言数字:1 = RESULT

		ELSE
			宣言数字:0 = 5
			宣言数字:1 = 6
		ENDIF

		PRINTFORMW %듀얼리스트%は{宣言数字:0}と{宣言数字:1}を宣言しました。
		PRINTL
		CALL DICE_ROLL(듀얼리스트,1)
		IF GROUPMATCH(RESULT,宣言数字:0,宣言数字:1)
			PRINTW 大成功！
			CALL CARDDRAW_BASIC(듀얼리스트,RESULT)
		ELSE
			PRINTW 残念！　ハズレ！
			CALL CARD_DECK_DISPOSE(듀얼리스트,"덱",RESULT)
		ENDIF
	ENDIF
ENDIF
